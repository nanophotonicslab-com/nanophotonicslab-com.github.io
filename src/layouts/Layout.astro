---
import Navbar from '../components/Navbar.astro';
import LabToolsBar from '../components/LabToolsBar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Nanophotonics research lab — exploring light-matter interactions at the nanoscale.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | NanophotonicsLab</title>
  </head>
  <body>
    <Navbar />
    <LabToolsBar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
