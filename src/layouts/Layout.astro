---
import Navbar from '../components/Navbar.astro';
import LabToolsBar from '../components/LabToolsBar.astro';
import Footer from '../components/Footer.astro';
import FeedbackButton from '../components/FeedbackButton.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Interactive browser-based tools for nanophotonics, optical scattering, plasmonics, electron microscopy, wave optics and ultrafast laser calculations.' } = Astro.props;
const siteTitle = title === 'Home'
  ? 'NanophotonicsLab \u2014 Browser-Based Nanophotonics Tools'
  : `${title} \u2014 NanophotonicsLab`;
const siteOrigin = Astro.site?.href ?? 'https://nanophotonicslab.com';
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const path = Astro.url.pathname;

// JSON-LD: Organization on homepage, WebApplication on /lab/* tool pages
const isHome = path === '/' || path === '';
const isLabTool = path.startsWith('/lab/') && path !== '/lab/' && path !== '/lab';

const authors = [
  { '@type': 'Person', name: 'Dr. Álvaro Rodríguez Echarri', url: 'https://scholar.google.com/citations?user=Q_EZls8AAAAJ' },
  { '@type': 'Person', name: 'Dr. José Ramón Martínez Saavedra', url: `${siteOrigin}/about/` },
];

const jsonLd = isHome
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'NanophotonicsLab',
      url: siteOrigin,
      description: 'Browser-based nanophotonics simulation tools for optical scattering, plasmonics, electron microscopy, wave optics and ultrafast laser calculations.',
      author: authors,
    })
  : isLabTool
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: title,
        url: canonicalURL.href,
        description,
        applicationCategory: 'ScienceApplication',
        operatingSystem: 'Any',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        creator: authors,
      })
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}icon-192.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.json`} />
    <meta name="theme-color" content="#6366F1" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site ?? 'https://nanophotonicslab.com').href} />
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site ?? 'https://nanophotonicslab.com').href} />
    <title>{siteTitle}</title>
    <style is:inline>
      .card,
      .card:hover,
      .card:focus,
      .card:focus-within,
      .card:active,
      .controls.card,
      .chart-panel.card,
      .results.card,
      .results-panel.card,
      .output-card.card {
        transform: none !important;
        translate: none !important;
        box-shadow: none !important;
        transition: none !important;
      }

    </style>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {import.meta.env.PUBLIC_UMAMI_ID && (
      <script
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={import.meta.env.PUBLIC_UMAMI_ID}
      />
    )}
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefer = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = stored || prefer;
      })();
    </script>
  </head>
  <body>
    <Navbar />
    <LabToolsBar />
    <main>
      <slot />
    </main>
    <Footer />
    <FeedbackButton />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        const isLocal = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname);
        if (isLocal) {
          navigator.serviceWorker.getRegistrations()
            .then((registrations) => registrations.forEach((registration) => registration.unregister()))
            .catch(() => {});

          if ('caches' in window) {
            caches.keys()
              .then((keys) => Promise.all(keys.map((key) => caches.delete(key))))
              .catch(() => {});
          }
        } else {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        }
      }
    </script>
  </body>
</html>
