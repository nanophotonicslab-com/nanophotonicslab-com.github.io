---
const mailtoHref = 'mailto:info@nanophotonicslab.com?subject=Feedback%20%E2%80%94%20NanophotonicsLab';
---

<div class="feedback-widget" data-open="false">
  <button class="feedback-pill" type="button" aria-label="Send feedback">
    <svg class="feedback-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
    <span class="feedback-pill__label">Feedback</span>
  </button>

  <div class="feedback-card">
    <button class="feedback-close" type="button" aria-label="Close feedback">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <p class="feedback-card__title">Got a photon out of place?</p>
    <p class="feedback-card__subtitle">Bug, suggestion, or just want to say hi — we'd love to hear from you.</p>
    <a class="feedback-cta" href={mailtoHref}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="22,7 12,13 2,7"/>
      </svg>
      Send us a message
    </a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const widget = document.querySelector('.feedback-widget');
    if (!widget) return;

    const pill = widget.querySelector('.feedback-pill');
    const close = widget.querySelector('.feedback-close');

    function toggle() {
      const open = widget.getAttribute('data-open') === 'true';
      widget.setAttribute('data-open', String(!open));
    }

    pill?.addEventListener('click', toggle);
    close?.addEventListener('click', toggle);
  });
</script>

<style>
  .feedback-widget {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 1000;
    font-family: var(--font);
  }

  /* --- Pill button --- */
  .feedback-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-full);
    background: var(--bg);
    color: var(--text-soft);
    font-family: var(--font);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, box-shadow 0.3s;
    box-shadow: var(--shadow-sm);
  }

  .feedback-pill:hover {
    color: var(--primary);
    border-color: var(--primary-light);
    box-shadow: var(--shadow-glow);
  }

  .feedback-icon {
    flex-shrink: 0;
  }

  /* Hide pill when card is open */
  .feedback-widget[data-open="true"] .feedback-pill {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.8);
    transition: opacity 0.15s, transform 0.15s;
  }

  /* --- Card --- */
  .feedback-card {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 280px;
    padding: 1.25rem;
    background: var(--bg);
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px) scale(0.95);
    transition: opacity 0.2s, transform 0.2s;
  }

  .feedback-widget[data-open="true"] .feedback-card {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  /* Spectrum accent line at top */
  .feedback-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1rem;
    right: 1rem;
    height: 3px;
    background: var(--spectrum);
    border-radius: var(--radius-full);
  }

  /* --- Close button --- */
  .feedback-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }

  .feedback-close:hover {
    color: var(--text);
    background: var(--bg-muted);
  }

  /* --- Card content --- */
  .feedback-card__title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .feedback-card__subtitle {
    font-size: 0.8125rem;
    color: var(--text-soft);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  /* --- CTA mailto link --- */
  .feedback-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-full);
    background: var(--primary);
    color: white;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, box-shadow 0.2s;
    width: 100%;
    justify-content: center;
  }

  .feedback-cta:hover {
    background: var(--primary-dark);
    color: white;
    box-shadow: var(--shadow-glow);
  }

  /* --- Mobile --- */
  @media (max-width: 480px) {
    .feedback-widget {
      bottom: 1rem;
      right: 1rem;
    }

    .feedback-card {
      width: min(280px, calc(100vw - 2rem));
    }

    .feedback-pill__label {
      display: none;
    }

    .feedback-pill {
      padding: 0.6rem;
    }
  }
</style>
