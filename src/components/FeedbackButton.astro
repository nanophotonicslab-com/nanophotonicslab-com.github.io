---
const feedbackUrl = import.meta.env.PUBLIC_FEEDBACK_URL || '';
---

<div class="feedback-widget" data-open="false" data-state="idle" data-api={feedbackUrl}>
  <button class="feedback-pill" type="button" aria-label="Send feedback">
    <svg class="feedback-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
    <span class="feedback-pill__label">Feedback</span>
  </button>

  <div class="feedback-card">
    <button class="feedback-close" type="button" aria-label="Close feedback">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <p class="feedback-card__title">Got a photon out of place?</p>
    <p class="feedback-card__subtitle">Bug, suggestion, or just want to say hi — we'd love to hear from you.</p>

    <form class="feedback-form">
      <textarea name="message" placeholder="What's on your mind?" required rows="4"></textarea>
      <input type="email" name="email" placeholder="Your email (optional)">
      <input type="text" name="_hp" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px">
      <button class="feedback-submit" type="submit">
        <span class="feedback-submit__text">Send</span>
        <span class="feedback-submit__sending">Sending...</span>
      </button>
    </form>

    <div class="feedback-sent">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--emerald)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><polyline points="9 12 11.5 14.5 16 9.5"/>
      </svg>
      <p>Thanks! We got your message.</p>
    </div>

    <div class="feedback-error">
      <p>Something went wrong.</p>
      <button class="feedback-retry" type="button">Try again</button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const widget = document.querySelector('.feedback-widget');
    if (!widget) return;

    const pill = widget.querySelector('.feedback-pill');
    const close = widget.querySelector('.feedback-close');
    const form = widget.querySelector('.feedback-form') as HTMLFormElement;
    const retry = widget.querySelector('.feedback-retry');
    const apiUrl = widget.getAttribute('data-api');

    function toggle() {
      const open = widget.getAttribute('data-open') === 'true';
      widget.setAttribute('data-open', String(!open));
      if (open) widget.setAttribute('data-state', 'idle');
    }

    pill?.addEventListener('click', toggle);
    close?.addEventListener('click', toggle);
    retry?.addEventListener('click', () => widget.setAttribute('data-state', 'idle'));

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!apiUrl) return;

      widget.setAttribute('data-state', 'sending');

      const data = {
        message: (form.querySelector('[name="message"]') as HTMLTextAreaElement).value,
        email: (form.querySelector('[name="email"]') as HTMLInputElement).value,
        page: window.location.href,
        _hp: (form.querySelector('[name="_hp"]') as HTMLInputElement).value,
      };

      try {
        const res = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (!res.ok) throw new Error();

        widget.setAttribute('data-state', 'sent');
        form.reset();
        setTimeout(() => {
          widget.setAttribute('data-open', 'false');
          widget.setAttribute('data-state', 'idle');
        }, 3000);
      } catch {
        widget.setAttribute('data-state', 'error');
      }
    });
  });
</script>

<style>
  .feedback-widget {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 1000;
    font-family: var(--font);
  }

  /* --- Pill button --- */
  .feedback-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-full);
    background: var(--bg);
    color: var(--text-soft);
    font-family: var(--font);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, box-shadow 0.3s;
    box-shadow: var(--shadow-sm);
  }

  .feedback-pill:hover {
    color: var(--primary);
    border-color: var(--primary-light);
    box-shadow: var(--shadow-glow);
  }

  .feedback-icon {
    flex-shrink: 0;
  }

  .feedback-widget[data-open="true"] .feedback-pill {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.8);
    transition: opacity 0.15s, transform 0.15s;
  }

  /* --- Card --- */
  .feedback-card {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 300px;
    padding: 1.25rem;
    background: var(--bg);
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px) scale(0.95);
    transition: opacity 0.2s, transform 0.2s;
  }

  .feedback-widget[data-open="true"] .feedback-card {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .feedback-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1rem;
    right: 1rem;
    height: 3px;
    background: var(--spectrum);
    border-radius: var(--radius-full);
  }

  /* --- Close button --- */
  .feedback-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }

  .feedback-close:hover {
    color: var(--text);
    background: var(--bg-muted);
  }

  /* --- Card content --- */
  .feedback-card__title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .feedback-card__subtitle {
    font-size: 0.8125rem;
    color: var(--text-soft);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  /* --- Form --- */
  .feedback-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .feedback-form textarea,
  .feedback-form input[type="email"] {
    width: 100%;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    font-family: var(--font);
    font-size: 0.8125rem;
    background: var(--bg);
    color: var(--text);
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .feedback-form textarea {
    resize: vertical;
    min-height: 4.5rem;
  }

  .feedback-form textarea::placeholder,
  .feedback-form input::placeholder {
    color: var(--text-muted);
  }

  .feedback-form textarea:focus,
  .feedback-form input[type="email"]:focus {
    outline: none;
    border-color: var(--primary-light);
    box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.1);
  }

  /* --- Submit button --- */
  .feedback-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.55rem 1rem;
    border: none;
    border-radius: var(--radius-full);
    background: var(--primary);
    color: white;
    font-family: var(--font);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, box-shadow 0.2s;
  }

  .feedback-submit:hover {
    background: var(--primary-dark);
    box-shadow: var(--shadow-glow);
  }

  .feedback-submit__sending {
    display: none;
  }

  [data-state="sending"] .feedback-submit {
    opacity: 0.7;
    pointer-events: none;
  }

  [data-state="sending"] .feedback-submit__text {
    display: none;
  }

  [data-state="sending"] .feedback-submit__sending {
    display: inline;
  }

  /* --- State visibility --- */
  .feedback-sent,
  .feedback-error {
    display: none;
  }

  [data-state="sent"] .feedback-form,
  [data-state="error"] .feedback-form {
    display: none;
  }

  [data-state="sent"] .feedback-sent {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    text-align: center;
  }

  [data-state="sent"] .feedback-sent p {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
  }

  [data-state="error"] .feedback-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    text-align: center;
  }

  [data-state="error"] .feedback-error p {
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .feedback-retry {
    padding: 0.4rem 1rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--primary);
    font-family: var(--font);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }

  .feedback-retry:hover {
    background: var(--bg-soft);
    border-color: var(--primary-light);
  }

  /* --- Mobile --- */
  @media (max-width: 480px) {
    .feedback-widget {
      bottom: 1rem;
      right: 1rem;
    }

    .feedback-card {
      width: min(300px, calc(100vw - 2rem));
    }

    .feedback-pill__label {
      display: none;
    }

    .feedback-pill {
      padding: 0.6rem;
    }
  }
</style>
