---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const tools = [
  { href: `${base}lab/`,               label: 'Lab',          icon: 'home' },
  { href: `${base}lab/mie-scattering/`, label: 'Mie',          icon: 'bolt' },
  { href: `${base}lab/cylinder/`,       label: 'Cylinder',     icon: 'cylinder' },
  { href: `${base}lab/photothermal/`,   label: 'Photothermal', icon: 'flame' },
  { href: `${base}lab/electron/`,       label: 'Electron',     icon: 'electron' },
  { href: `${base}lab/photon/`,         label: 'Photon',       icon: 'photon' },
  { href: `${base}lab/units/`,          label: 'Units',        icon: 'ruler' },
];

function isActive(href: string): boolean {
  const labHome = `${base}lab/`;
  if (href === labHome) {
    return currentPath === labHome || currentPath === `${base}lab`;
  }
  return currentPath.startsWith(href);
}
---

<nav class="lab-bar" aria-label="Quick tools">
  <div class="lab-bar__inner container">
    <span class="lab-bar__label">Quick tools</span>
    {tools.map(t => (
      <a href={t.href} class:list={['lab-tool', { active: isActive(t.href) }]} title={t.label}>
        <span class="lab-tool__icon">
          {t.icon === 'home' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          )}
          {t.icon === 'bolt' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          )}
          {t.icon === 'cylinder' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="12" cy="5" rx="8" ry="2.5"/>
              <path d="M4 5v14"/><path d="M20 5v14"/>
              <ellipse cx="12" cy="19" rx="8" ry="2.5"/>
            </svg>
          )}
          {t.icon === 'flame' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
            </svg>
          )}
          {t.icon === 'electron' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <ellipse cx="12" cy="12" rx="10" ry="4"/>
              <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/>
              <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>
            </svg>
          )}
          {t.icon === 'photon' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12 C 5 6, 9 18, 12 12 S 19 6, 22 12"/>
              <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
            </svg>
          )}
          {t.icon === 'ruler' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.4 2.4 0 0 1 0-3.4l2.6-2.6a2.4 2.4 0 0 1 3.4 0z"/>
              <path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/>
            </svg>
          )}
          {t.icon === 'cube' && (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
          )}
        </span>
        <span class="lab-tool__label">{t.label}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .lab-bar {
    position: sticky;
    top: var(--nav-height);
    z-index: 90;
    background: var(--bg-glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--bg-muted);
  }
  .lab-bar__inner {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.35rem 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .lab-bar__inner::-webkit-scrollbar { display: none; }

  .lab-bar__label {
    flex-shrink: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    padding: 0 0.75rem 0 0;
    border-right: 1px solid var(--bg-muted);
    margin-right: 0.4rem;
  }

  .lab-tool {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
    flex-shrink: 0;
  }
  .lab-tool:hover {
    color: var(--primary);
    background: rgba(99, 102, 241, 0.08);
  }
  .lab-tool.active {
    color: var(--primary);
    background: rgba(99, 102, 241, 0.12);
    font-weight: 600;
  }
  .lab-tool__icon { display: inline-flex; }

  @media (max-width: 640px) {
    .lab-bar__label { display: none; }
    .lab-tool { padding: 0.3rem 0.55rem; }
    .lab-tool__label { display: none; }
    .lab-tool.active .lab-tool__label { display: inline; }
  }
</style>
