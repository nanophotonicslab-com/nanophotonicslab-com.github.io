---
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

type Tool = { href: string; label: string; icon: string };
type Category = { label: string; tools: Tool[] };

const categories: Category[] = [
  {
    label: 'Calculators',
    tools: [
      { href: `${base}lab/units/`, label: 'Units', icon: 'ruler' },
      { href: `${base}lab/electron/`, label: 'Electrons', icon: 'electron' },
      { href: `${base}lab/photon/`, label: 'Photons', icon: 'photon' },
      { href: `${base}lab/laser/`, label: 'Laser', icon: 'laser' },
    ],
  },
  {
    label: 'Photonics Lab',
    tools: [
      { href: `${base}lab/mie-scattering/`, label: 'Spheres (Mie)', icon: 'bolt' },
      { href: `${base}lab/cylinder/`, label: 'Cylinders', icon: 'cylinder' },
      { href: `${base}lab/plasmonic-nanoparticles/`, label: 'Plasmonic NPs', icon: 'plasmon' },
      { href: `${base}lab/photothermal/`, label: 'Thermoplasmonics', icon: 'flame' },
      { href: `${base}lab/heterostructures/`, label: 'Heterostructures', icon: 'layers' },
    ],
  },
  {
    label: 'Toolkit',
    tools: [
      { href: `${base}lab/bem-solver/`, label: 'BEM', icon: 'cube' },
      { href: `${base}lab/rcwa/`, label: 'RCWA', icon: 'grating' },
      { href: `${base}lab/bpm/`, label: 'BPM', icon: 'wave' },
      { href: `${base}lab/assistant/`, label: 'Methods Assistant', icon: 'chat' },
    ],
  },
];

const allTools = categories.flatMap(c =>
  c.tools.map(t => ({ ...t, category: c.label }))
);

function isActive(href: string): boolean {
  const labHome = `${base}lab/`;
  if (href === labHome) return currentPath === labHome || currentPath === `${base}lab`;
  return currentPath.startsWith(href);
}
---

<!-- SVG icon sprite -->
<svg xmlns="http://www.w3.org/2000/svg" style="display:none">
  <symbol id="tb-bolt" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></symbol>
  <symbol id="tb-plasmon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M4 12c2.2-5 4.8-5 8 0s5.8 5 8 0"/><path d="M4 12c2.2 5 4.8 5 8 0s5.8-5 8 0"/></symbol>
  <symbol id="tb-cylinder" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="8" ry="2.5"/><path d="M4 5v14"/><path d="M20 5v14"/><ellipse cx="12" cy="19" rx="8" ry="2.5"/></symbol>
  <symbol id="tb-flame" viewBox="0 0 24 24"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></symbol>
  <symbol id="tb-electron" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/></symbol>
  <symbol id="tb-photon" viewBox="0 0 24 24"><path d="M2 12 C 5 6, 9 18, 12 12 S 19 6, 22 12"/><circle cx="12" cy="12" r="1.5"/></symbol>
  <symbol id="tb-ruler" viewBox="0 0 24 24"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.4 2.4 0 0 1 0-3.4l2.6-2.6a2.4 2.4 0 0 1 3.4 0z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/></symbol>
  <symbol id="tb-cube" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></symbol>
  <symbol id="tb-wave" viewBox="0 0 24 24"><path d="M2 12c2-4 4 4 6 0s4 4 6 0 4 4 6 0 4 4 6 0"/></symbol>
  <symbol id="tb-laser" viewBox="0 0 24 24"><path d="M2 12h8"/><path d="M14 12h8"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="12" r="5" stroke-dasharray="2 2"/></symbol>
  <symbol id="tb-grating" viewBox="0 0 24 24"><path d="M4 4v16"/><path d="M8 4v16"/><path d="M12 4v16"/><path d="M16 4v16"/><path d="M20 4v16"/></symbol>
  <symbol id="tb-chat" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8"/><path d="M8 13h4"/></symbol>
  <symbol id="tb-layers" viewBox="0 0 24 24"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></symbol>
</svg>

<nav class="lab-bar" aria-label="Quick tools">
  <div class="lab-bar__inner container">
    <!-- Search -->
    <div class="lab-bar__search" id="tool-search-wrap">
      <svg class="lab-bar__search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="text"
        class="lab-bar__search-input"
        id="tool-search"
        placeholder="Search tools…"
        autocomplete="off"
        data-tools={JSON.stringify(allTools)}
      />
      <kbd class="lab-bar__kbd" id="search-kbd">/</kbd>
      <div class="lab-bar__search-results" id="search-results"></div>
    </div>

    <span class="lab-bar__sep"></span>

    <!-- Lab home -->
    <a
      href={`${base}lab/`}
      class:list={['lab-bar__home', { active: isActive(`${base}lab/`) }]}
      title="All tools"
      data-umami-event="quick-tool"
      data-umami-event-tool="Lab"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      <span>Lab</span>
    </a>

    <span class="lab-bar__sep"></span>

    <!-- Category dropdowns -->
    {categories.map(cat => (
      <div class:list={['lab-bar__cat', { 'lab-bar__cat--active': cat.tools.some(t => isActive(t.href)) }]}>
        <button class="lab-bar__cat-btn" type="button">
          {cat.label}
          <svg class="lab-bar__chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="lab-bar__dropdown">
          {cat.tools.map(t => (
            <a
              href={t.href}
              class:list={['lab-bar__dropdown-item', { active: isActive(t.href) }]}
              data-umami-event="quick-tool"
              data-umami-event-tool={t.label}
            >
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <use href={`#tb-${t.icon}`}/>
              </svg>
              {t.label}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</nav>

<style>
  .lab-bar {
    position: sticky;
    top: var(--nav-height);
    z-index: 90;
    background: var(--bg-glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--bg-muted);
  }

  .lab-bar__inner {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.35rem 0;
  }

  /* ── Separator ── */
  .lab-bar__sep {
    width: 1px;
    height: 1.25rem;
    background: var(--bg-muted);
    flex-shrink: 0;
    margin: 0 0.25rem;
  }

  /* ── Search ── */
  .lab-bar__search {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .lab-bar__search-icon {
    position: absolute;
    left: 0.5rem;
    pointer-events: none;
    color: var(--text-muted);
  }

  .lab-bar__search-input {
    width: 7.5rem;
    padding: 0.3rem 2rem 0.3rem 1.75rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-family: inherit;
    background: var(--bg);
    color: var(--text);
    outline: none;
    transition: width 0.2s ease, border-color 0.15s;
  }

  .lab-bar__search-input:focus {
    width: 12rem;
    border-color: var(--primary);
  }

  .lab-bar__search-input:focus + .lab-bar__kbd {
    display: none;
  }

  .lab-bar__kbd {
    position: absolute;
    right: 0.4rem;
    font-size: 0.625rem;
    font-family: inherit;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--bg-muted);
    border-radius: 3px;
    color: var(--text-muted);
    background: var(--bg-soft);
    pointer-events: none;
    line-height: 1;
  }

  .lab-bar__search-results {
    display: none;
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    min-width: 240px;
    background: var(--bg);
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    padding: 0.3rem;
    z-index: 110;
  }

  .lab-bar__search-results.open { display: block; }

  .lab-bar__search-results :global(.search-item) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    font-size: 0.8125rem;
    color: var(--text-soft);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background 0.1s;
  }

  .lab-bar__search-results :global(.search-item:hover) {
    background: rgba(99, 102, 241, 0.08);
    color: var(--primary);
  }

  .lab-bar__search-results :global(.search-cat) {
    margin-left: auto;
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .lab-bar__search-results :global(.search-empty) {
    padding: 0.5rem 0.6rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* ── Lab home ── */
  .lab-bar__home {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.15s, background 0.15s;
  }

  .lab-bar__home:hover {
    color: var(--primary);
    background: rgba(99, 102, 241, 0.08);
  }

  .lab-bar__home.active {
    color: var(--primary);
    background: rgba(99, 102, 241, 0.12);
    font-weight: 600;
  }

  /* ── Category buttons ── */
  .lab-bar__cat {
    position: relative;
    flex-shrink: 0;
  }

  .lab-bar__cat-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.65rem;
    border: none;
    background: none;
    border-radius: var(--radius-full);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }

  .lab-bar__cat-btn:hover,
  .lab-bar__cat--active .lab-bar__cat-btn {
    color: var(--primary);
    background: rgba(99, 102, 241, 0.08);
  }

  .lab-bar__cat--active .lab-bar__cat-btn {
    font-weight: 600;
  }

  .lab-bar__chevron {
    transition: transform 0.2s ease;
  }

  .lab-bar__cat.open .lab-bar__chevron {
    transform: rotate(180deg);
  }

  /* ── Dropdown ── */
  .lab-bar__dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
  }
  /* Invisible bridge covering the gap between the button and the menu so the
     pointer stays within the category while moving down to the dropdown. */
  .lab-bar__dropdown::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -0.45rem;
    height: 0.45rem;
  }
  .lab-bar__dropdown {
    min-width: 190px;
    background: var(--bg);
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    padding: 0.3rem;
    z-index: 100;
  }

  .lab-bar__cat.open .lab-bar__dropdown {
    display: block;
  }

  .lab-bar__dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    color: var(--text-soft);
    font-size: 0.8125rem;
    text-decoration: none;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: background 0.1s, color 0.1s;
  }

  .lab-bar__dropdown-item:hover {
    background: rgba(99, 102, 241, 0.08);
    color: var(--primary);
  }

  .lab-bar__dropdown-item.active {
    color: var(--primary);
    font-weight: 600;
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .lab-bar__search-input {
      width: 2rem;
      padding-right: 0.5rem;
      color: transparent;
    }
    .lab-bar__search-input::placeholder { color: transparent; }
    .lab-bar__kbd { display: none; }

    .lab-bar__search-input:focus {
      width: 10rem;
      color: var(--text);
    }
    .lab-bar__search-input:focus::placeholder { color: var(--text-muted); }

    .lab-bar__home span { display: none; }
  }
</style>

<script>
  // ── Search ──
  const searchInput = document.getElementById('tool-search') as HTMLInputElement | null;
  const searchResults = document.getElementById('search-results') as HTMLElement | null;

  if (searchInput && searchResults) {
    const tools: { href: string; label: string; icon: string; category: string }[] =
      JSON.parse(searchInput.dataset.tools || '[]');

    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      if (!q) {
        searchResults.classList.remove('open');
        searchResults.innerHTML = '';
        return;
      }
      const matches = tools.filter(t =>
        t.label.toLowerCase().includes(q) || t.category.toLowerCase().includes(q)
      );
      if (matches.length === 0) {
        searchResults.innerHTML = '<div class="search-empty">No tools found</div>';
        searchResults.classList.add('open');
        return;
      }
      searchResults.innerHTML = matches.map(t =>
        `<a href="${t.href}" class="search-item">` +
          `<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><use href="#tb-${t.icon}"/></svg>` +
          `${t.label}` +
          `<span class="search-cat">${t.category}</span>` +
        `</a>`
      ).join('');
      searchResults.classList.add('open');
    });

    searchInput.addEventListener('blur', () => {
      setTimeout(() => { searchResults.classList.remove('open'); searchResults.innerHTML = ''; }, 150);
    });

    searchInput.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        searchInput.value = '';
        searchResults.classList.remove('open');
        searchResults.innerHTML = '';
        searchInput.blur();
      }
    });

    // "/" shortcut to focus search
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement).tagName)) {
        e.preventDefault();
        searchInput.focus();
      }
    });
  }

  // ── Category hover (desktop) + click (mobile) ──
  const allCats = document.querySelectorAll('.lab-bar__cat');

  let closeTimer: number | undefined;
  allCats.forEach(cat => {
    cat.addEventListener('mouseenter', () => {
      clearTimeout(closeTimer);
      allCats.forEach(c => { if (c !== cat) c.classList.remove('open'); });
      cat.classList.add('open');
    });
    // Delay closing so there's time to move the pointer onto the menu.
    cat.addEventListener('mouseleave', () => {
      clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => cat.classList.remove('open'), 400);
    });
  });

  // Click fallback for touch devices
  document.querySelectorAll('.lab-bar__cat-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const cat = btn.closest('.lab-bar__cat') as HTMLElement | null;
      if (!cat) return;
      const wasOpen = cat.classList.contains('open');
      allCats.forEach(c => c.classList.remove('open'));
      if (!wasOpen) cat.classList.add('open');
    });
  });

  document.addEventListener('click', () => {
    allCats.forEach(c => c.classList.remove('open'));
  });

</script>
