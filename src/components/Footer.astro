---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="spectrum-line"></div>
  <div class="footer__inner container">
    <div class="footer__grid">
      <div class="footer__about">
        <p class="footer__heading">NanophotonicsLab</p>
        <p>Exploring light-matter interactions at the nanoscale.</p>
      </div>
      <div class="footer__nav">
        <p class="footer__heading">Navigate</p>
        <ul>
          <li><a href={`${import.meta.env.BASE_URL}`}>Home</a></li>
          <li><a href={`${import.meta.env.BASE_URL}lab/`}>Lab</a></li>
        </ul>
      </div>
      <div class="footer__contact">
        <p class="footer__heading">Contact</p>
        <p>info@nanophotonicslab.com</p>
      </div>
    </div>
    <div class="footer__bottom">
      <p>&copy; {year} NanophotonicsLab. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-soft);
    margin-top: var(--space-3xl);
  }

  .footer__inner {
    padding: var(--space-xl) var(--space-lg) var(--space-lg);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .footer__heading {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
    color: var(--text);
  }

  .footer p {
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .footer ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer a {
    font-size: 0.875rem;
    color: var(--text-soft);
    transition: color 0.2s;
  }

  .footer a:hover {
    color: var(--primary);
  }

  .footer__bottom {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--bg-muted);
  }

  .footer__bottom p {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
