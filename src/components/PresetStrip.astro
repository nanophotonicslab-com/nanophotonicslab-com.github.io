---
interface Props {
  presets: { label: string; values: Record<string, string | number> }[];
  canvasId?: string;
  showCopy?: boolean;
}
const { presets, canvasId, showCopy = true } = Astro.props;
---

<div class="preset-strip">
  <span class="preset-strip__label">Examples</span>
  {presets.map(p => (
    <button class="preset-strip__btn" type="button" data-preset={JSON.stringify(p.values)}>
      {p.label}
    </button>
  ))}
  {canvasId && (
    <button class="preset-strip__export" type="button" data-export-png={canvasId} title="Save chart as PNG">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      <span>Save PNG</span>
    </button>
  )}
  {showCopy && (
    <button class="preset-strip__copy" type="button" data-copy-link title="Copy shareable link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg>
      <span>Copy link</span>
    </button>
  )}
</div>

<style>
  .preset-strip {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    padding-bottom: var(--space-md);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--bg-muted);
  }

  .preset-strip__label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-right: 0.25rem;
  }

  .preset-strip__export,
  .preset-strip__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
    font-family: inherit;
    font-weight: 500;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-full);
    background: var(--bg);
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s;
  }

  .preset-strip__export:hover,
  .preset-strip__copy:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .preset-strip__btn {
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
    font-family: inherit;
    font-weight: 500;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-full);
    background: var(--bg);
    color: var(--text-soft);
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .preset-strip__btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: rgba(99, 102, 241, 0.06);
  }

  .preset-strip__btn.active {
    border-color: var(--primary);
    color: var(--primary);
    background: rgba(99, 102, 241, 0.1);
    font-weight: 600;
  }
</style>

<script>
  document.querySelectorAll('.preset-strip__btn').forEach(btn => {
    btn.addEventListener('click', () => {
      // Visual feedback
      btn.closest('.preset-strip')
        ?.querySelectorAll('.preset-strip__btn')
        .forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const data: Record<string, string | number> = JSON.parse(
        (btn as HTMLElement).dataset.preset || '{}'
      );
      // Set selects first (they may show/hide dependent fields)
      const selects: [string, string | number][] = [];
      const inputs: [string, string | number][] = [];
      for (const [key, value] of Object.entries(data)) {
        const el = document.getElementById(key);
        if (el instanceof HTMLSelectElement) selects.push([key, value]);
        else inputs.push([key, value]);
      }
      for (const [key, value] of selects) {
        const el = document.getElementById(key) as HTMLSelectElement;
        el.value = String(value);
        el.dispatchEvent(new Event('change', { bubbles: true }));
      }
      // Small delay to let select handlers run (show/hide fields, load data)
      requestAnimationFrame(() => {
        for (const [key, value] of inputs) {
          const el = document.getElementById(key) as HTMLInputElement | null;
          if (!el) continue;
          el.value = String(value);
          el.dispatchEvent(new Event('input', { bubbles: true }));
        }
      });
    });
  });

  // PNG export
  document.querySelectorAll('[data-export-png]').forEach(btn => {
    btn.addEventListener('click', () => {
      const canvasId = (btn as HTMLElement).dataset.exportPng;
      const canvas = document.getElementById(canvasId || '') as HTMLCanvasElement | null;
      if (!canvas) return;
      const link = document.createElement('a');
      link.download = `${canvasId}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
    });
  });
</script>
