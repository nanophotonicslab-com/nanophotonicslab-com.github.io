---
interface Props {
  status: 'Stable' | 'Beta' | 'Experimental';
}
const { status } = Astro.props;
---

<details class="model-info">
  <summary class="model-info__summary">
    Model &amp; Assumptions
    <span class:list={['model-info__status', `model-info__status--${status.toLowerCase()}`]}>
      {status}
    </span>
  </summary>
  <div class="model-info__body">
    <slot />
  </div>
</details>

<style>
  .model-info {
    max-width: 900px;
    margin: var(--space-lg) auto;
    padding: 0 var(--space-md);
  }

  .model-info__summary {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    padding: var(--space-sm) 0;
    color: var(--text-muted);
    user-select: none;
  }

  .model-info__summary::marker {
    color: var(--text-muted);
  }

  .model-info__status {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .model-info__status--stable {
    background: var(--success-soft);
    color: var(--success);
  }

  .model-info__status--beta {
    background: var(--warning-soft);
    color: var(--warning);
  }

  .model-info__status--experimental {
    background: var(--danger-soft);
    color: var(--danger);
  }

  .model-info__body {
    padding: var(--space-md) 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .model-info__body :global(dl) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
  }

  .model-info__body :global(dt) {
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .model-info__body :global(dd) {
    margin: 0;
  }

  .model-info__body :global(ul) {
    margin: 0;
    padding-left: 1.25em;
  }

  .model-info__body :global(li) {
    margin-bottom: 0.25em;
  }

  .model-info__body :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .model-info__body :global(dl) {
      grid-template-columns: 1fr;
    }
  }
</style>
