---
import Layout from '../layouts/Layout.astro';

const pi = {
  name: 'Prof. Name Surname',
  role: 'Principal Investigator',
  bio: 'Brief biography about the PI, their research interests, academic trajectory, and vision for the lab. Include key achievements and current focus areas.',
  links: { email: 'mailto:pi@nanophotonicslab.com' },
};

const members = [
  { name: 'Alice Postdoc', role: 'Postdoctoral Researcher', area: 'Plasmonics & sensing' },
  { name: 'Bob PhDStudent', role: 'PhD Student', area: 'Photonic crystals' },
  { name: 'Carol PhDStudent', role: 'PhD Student', area: 'Quantum nanophotonics' },
  { name: 'David MScStudent', role: 'MSc Student', area: 'Computational photonics' },
  { name: 'Eve PhDStudent', role: 'PhD Student', area: 'Nonlinear nanophotonics' },
  { name: 'Frank Engineer', role: 'Lab Engineer', area: 'Nanofabrication' },
];

const alumni = [
  { name: 'Grace Former', role: 'PhD (2024)', now: 'Postdoc at MIT' },
  { name: 'Hank Former', role: 'MSc (2023)', now: 'Industry — ASML' },
];
---

<Layout title="Team">
  <section class="page-hero">
    <div class="container">
      <h1>Team</h1>
      <p class="page-hero__subtitle">
        The people behind the research.
      </p>
    </div>
  </section>

  <!-- PI -->
  <section class="section">
    <div class="container">
      <div class="pi-card card">
        <div class="pi-avatar">
          <div class="avatar-placeholder avatar-placeholder--large">
            {pi.name.split(' ').slice(0, 2).map(n => n[0]).join('')}
          </div>
        </div>
        <div class="pi-info">
          <h2>{pi.name}</h2>
          <span class="tag">{pi.role}</span>
          <p>{pi.bio}</p>
          <div class="pi-links">
            <!-- TODO: add Google Scholar link -->
            <a href={pi.links.email} class="btn btn--outline">Email</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Current Members -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="section-header">
        <h2>Current members</h2>
      </div>
      <div class="grid grid--3">
        {members.map(member => (
          <div class="card member-card">
            <div class="avatar-placeholder">
              {member.name.split(' ').slice(0, 2).map(n => n[0]).join('')}
            </div>
            <h3>{member.name}</h3>
            <span class="member-role">{member.role}</span>
            <p class="member-area">{member.area}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Alumni -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="section-header">
        <h2>Alumni</h2>
      </div>
      <div class="alumni-list">
        {alumni.map(alum => (
          <div class="alumni-item">
            <strong>{alum.name}</strong>
            <span class="alumni-detail">{alum.role} — now at {alum.now}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: calc(var(--space-3xl) + var(--space-lg)) 0 var(--space-xl);
    background: var(--bg-soft);
  }

  .page-hero h1 {
    margin-bottom: var(--space-md);
  }

  .page-hero__subtitle {
    font-size: 1.25rem;
    max-width: 600px;
  }

  /* PI */
  .pi-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .pi-info h2 {
    margin-bottom: var(--space-sm);
  }

  .pi-info .tag {
    margin-bottom: var(--space-md);
  }

  .pi-info p {
    margin-bottom: var(--space-lg);
  }

  .pi-links {
    display: flex;
    gap: var(--space-sm);
  }

  /* Avatar placeholder */
  .avatar-placeholder {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background: var(--spectrum);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.25rem;
    color: white;
    flex-shrink: 0;
  }

  .avatar-placeholder--large {
    width: 140px;
    height: 140px;
    font-size: 2.5rem;
  }

  /* Member cards */
  .member-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-sm);
    padding: var(--space-xl) var(--space-lg);
  }

  .member-card h3 {
    font-size: 1.0625rem;
  }

  .member-role {
    font-size: 0.875rem;
    color: var(--primary);
    font-weight: 500;
  }

  .member-area {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  /* Alumni */
  .alumni-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .alumni-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--bg-muted);
  }

  .alumni-item strong {
    min-width: 160px;
  }

  .alumni-detail {
    color: var(--text-soft);
    font-size: 0.9375rem;
  }

  @media (max-width: 768px) {
    .pi-card {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .pi-avatar {
      display: flex;
      justify-content: center;
    }

    .pi-links {
      justify-content: center;
    }

    .alumni-item {
      flex-direction: column;
      gap: var(--space-xs);
    }
  }
</style>
