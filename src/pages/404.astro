---
import Layout from '../layouts/Layout.astro';
import { getLocaleFromPath, t } from '../i18n/translations';

const base = import.meta.env.BASE_URL;
const locale = getLocaleFromPath(Astro.url.pathname);
const prefix = locale === 'en' ? '' : '/es';
---

<Layout title={t(locale, '404.title')} description={t(locale, '404.subtitle')}>
  <section class="error-hero">
    <div class="container error-content">
      <span class="error-code">404</span>
      <h1>{t(locale, '404.title')}</h1>
      <p>{t(locale, '404.subtitle')}</p>
      <div class="error-actions">
        <a href={`${prefix}${base}`} class="btn btn--primary">{t(locale, '404.home')}</a>
        <a href={`${prefix}${base}lab/`} class="btn btn--outline">{t(locale, '404.lab')}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .error-hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-3xl) 0;
  }

  .error-content {
    max-width: 480px;
  }

  .error-code {
    font-size: clamp(5rem, 12vw, 8rem);
    font-weight: 900;
    line-height: 1;
    background: var(--spectrum);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .error-hero h1 {
    margin: var(--space-md) 0 var(--space-sm);
    font-size: 1.5rem;
  }

  .error-hero p {
    color: var(--text-soft);
    margin-bottom: var(--space-xl);
  }

  .error-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
