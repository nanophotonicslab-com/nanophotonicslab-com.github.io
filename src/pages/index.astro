---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

const categories = [
  {
    title: 'Scattering & nanoparticles',
    tools: [
      { label: 'Mie Scattering', href: `${base}lab/mie-scattering/` },
      { label: 'Plasmonic Nanoparticles', href: `${base}lab/plasmonic-nanoparticles/` },
      { label: 'Cylinder Dispersion', href: `${base}lab/cylinder/` },
      { label: 'BEM Solver', href: `${base}lab/bem-solver/` },
      { label: 'Photothermal', href: `${base}lab/photothermal/` },
    ],
  },
  {
    title: 'Wave optics & periodic structures',
    tools: [
      { label: 'Beam Propagation (BPM)', href: `${base}lab/bpm/` },
      { label: 'RCWA — 1D Grating', href: `${base}lab/rcwa/` },
    ],
  },
  {
    title: 'Lab calculators',
    tools: [
      { label: 'Photon Calculator', href: `${base}lab/photon/` },
      { label: 'Electron Calculator', href: `${base}lab/electron/` },
      { label: 'Laser Pulse Calculator', href: `${base}lab/laser/` },
      { label: 'Unit Converter', href: `${base}lab/units/` },
    ],
  },
  {
    title: 'Method selection',
    tools: [
      { label: 'Methods Assistant', href: `${base}lab/assistant/` },
    ],
  },
];
---

<Layout title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__orb hero__orb--1"></div>
      <div class="hero__orb hero__orb--2"></div>
      <div class="hero__orb hero__orb--3"></div>
      <div class="hero__orb hero__orb--4"></div>
    </div>
    <div class="container hero__content">
      <h1>
        Browser-based nanophotonics
        <span class="hero__gradient-text">tools</span>
      </h1>
      <p class="hero__subtitle">
        Run scattering, plasmonics, wave-optics, electron and laser calculators
        directly in your browser — no installation, no notebooks, no setup.
      </p>
      <div class="hero__actions">
        <a href={`${base}lab/`} class="btn btn--primary">Browse tools</a>
        <a href={`${base}lab/assistant/`} class="btn btn--outline">Find the right method</a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="section">
    <div class="container">
      <h2 class="section__title">What's available</h2>
      <div class="cat-grid">
        {categories.map(cat => (
          <div class="cat-card card">
            <h3>{cat.title}</h3>
            <ul>
              {cat.tools.map(t => (
                <li><a href={t.href}>{t.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Purpose -->
  <section class="section">
    <div class="container purpose-grid">
      <div class="purpose-block">
        <h2>Built for quick scientific checks</h2>
        <p>
          NanophotonicsLab focuses on interactive, transparent tools for researchers,
          students and engineers who need fast estimates, visual intuition and
          exportable numerical results.
        </p>
      </div>
      <div class="purpose-block">
        <h2>Transparent assumptions</h2>
        <p>
          Each tool documents its numerical model, validity range, limitations and
          references. Where approximations are used, they are stated explicitly.
          Some tools are exact within their model; others are intended for
          exploration and intuition.
        </p>
      </div>
    </div>
  </section>

  <!-- Author -->
  <section class="section section--subtle">
    <div class="container author-block">
      <p>
        Created and maintained by
        <a href={`${base}about/`}>Dr. José Ramón Martínez Saavedra</a> and
        <a href="https://scholar.google.com/citations?user=Q_EZls8AAAAJ" target="_blank" rel="noopener">Dr. Álvaro Rodríguez Echarri</a> —
        theoretical nanophotonics researchers.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: calc(var(--nav-height) + var(--space-3xl) - var(--lab-bar-height)) 0 var(--space-3xl);
    overflow: hidden;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
    animation: orbFloat 8s ease-in-out infinite;
  }

  .hero__orb--1 {
    width: 400px;
    height: 400px;
    background: #C4B5FD;
    top: -10%;
    right: 10%;
    animation-delay: 0s;
  }

  .hero__orb--2 {
    width: 300px;
    height: 300px;
    background: #93C5FD;
    top: 30%;
    right: 30%;
    animation-delay: -2s;
  }

  .hero__orb--3 {
    width: 350px;
    height: 350px;
    background: #6EE7B7;
    bottom: 0%;
    right: 5%;
    animation-delay: -4s;
  }

  .hero__orb--4 {
    width: 250px;
    height: 250px;
    background: #FCD34D;
    top: 10%;
    left: -5%;
    animation-delay: -6s;
  }

  @keyframes orbFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -20px) scale(1.05); }
    66% { transform: translate(-20px, 15px) scale(0.95); }
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  .hero__gradient-text {
    background: var(--spectrum);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200% auto;
    animation: spectrumText 5s ease-in-out infinite;
  }

  @keyframes spectrumText {
    0%, 100% { background-position: 0% center; }
    50% { background-position: 100% center; }
  }

  .hero__subtitle {
    font-size: 1.25rem;
    line-height: 1.8;
    margin: var(--space-lg) 0 var(--space-xl);
    color: var(--text-soft);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* Categories */
  .section__title {
    font-size: 1.5rem;
    margin-bottom: var(--space-xl);
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-lg);
  }

  .cat-card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
    color: var(--text);
  }

  .cat-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .cat-card a {
    font-size: 0.9375rem;
    color: var(--text-soft);
    text-decoration: none;
    transition: color 0.15s;
  }

  .cat-card a:hover {
    color: var(--primary);
  }

  /* Purpose */
  .purpose-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
  }

  .purpose-block h2 {
    font-size: 1.25rem;
    margin-bottom: var(--space-md);
  }

  .purpose-block p {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--text-soft);
  }

  /* Author */
  .section--subtle {
    background: var(--bg-soft);
  }

  .author-block p {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--text-soft);
    max-width: 600px;
  }

  .author-block a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
  }

  .author-block a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: calc(var(--nav-height) + var(--space-xl) - var(--lab-bar-height)) 0 var(--space-xl);
    }

    .hero__subtitle {
      font-size: 1.0625rem;
    }
  }
</style>
