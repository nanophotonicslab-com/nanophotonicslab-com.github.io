---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__orb hero__orb--1"></div>
      <div class="hero__orb hero__orb--2"></div>
      <div class="hero__orb hero__orb--3"></div>
      <div class="hero__orb hero__orb--4"></div>
    </div>
    <div class="container hero__content">
      <h1>
        Light at the
        <span class="hero__gradient-text">nanoscale</span>
      </h1>
      <p class="hero__subtitle">
        We investigate light-matter interactions in nanostructures — from
        plasmonics and photonic crystals to quantum optics. Building the tools
        and knowledge to control photons at their smallest scale.
      </p>
      <div class="hero__actions">
        <a href={`${base}lab/`} class="btn btn--primary">Try our simulators</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: calc(var(--nav-height) + var(--space-3xl) - var(--lab-bar-height)) 0 var(--space-3xl);
    overflow: hidden;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
    animation: orbFloat 8s ease-in-out infinite;
  }

  .hero__orb--1 {
    width: 400px;
    height: 400px;
    background: #C4B5FD;
    top: -10%;
    right: 10%;
    animation-delay: 0s;
  }

  .hero__orb--2 {
    width: 300px;
    height: 300px;
    background: #93C5FD;
    top: 30%;
    right: 30%;
    animation-delay: -2s;
  }

  .hero__orb--3 {
    width: 350px;
    height: 350px;
    background: #6EE7B7;
    bottom: 0%;
    right: 5%;
    animation-delay: -4s;
  }

  .hero__orb--4 {
    width: 250px;
    height: 250px;
    background: #FCD34D;
    top: 10%;
    left: -5%;
    animation-delay: -6s;
  }

  @keyframes orbFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -20px) scale(1.05); }
    66% { transform: translate(-20px, 15px) scale(0.95); }
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  .hero__gradient-text {
    background: var(--spectrum);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200% auto;
    animation: spectrumText 5s ease-in-out infinite;
  }

  @keyframes spectrumText {
    0%, 100% { background-position: 0% center; }
    50% { background-position: 100% center; }
  }

  .hero__subtitle {
    font-size: 1.25rem;
    line-height: 1.8;
    margin: var(--space-lg) 0 var(--space-xl);
    color: var(--text-soft);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: calc(var(--nav-height) + var(--space-xl) - var(--lab-bar-height)) 0 var(--space-xl);
    }

    .hero__subtitle {
      font-size: 1.0625rem;
    }
  }
</style>
