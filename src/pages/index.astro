---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

const news = [
  { date: '2026-03-28', title: 'New paper published in Nature Photonics', summary: 'Our latest work on plasmonic nanostructures has been accepted.' },
  { date: '2026-03-15', title: 'Welcome new PhD students!', summary: 'Three new doctoral students join the lab this semester.' },
  { date: '2026-02-20', title: 'Talk at CLEO 2026', summary: 'Invited talk on nanophotonic simulation methods at CLEO Europe.' },
];
---

<Layout title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__orb hero__orb--1"></div>
      <div class="hero__orb hero__orb--2"></div>
      <div class="hero__orb hero__orb--3"></div>
      <div class="hero__orb hero__orb--4"></div>
    </div>
    <div class="container hero__content">
      <h1>
        Light at the
        <span class="hero__gradient-text">nanoscale</span>
      </h1>
      <p class="hero__subtitle">
        We investigate light-matter interactions in nanostructures — from
        plasmonics and photonic crystals to quantum optics. Building the tools
        and knowledge to control photons at their smallest scale.
      </p>
      <div class="hero__actions">
        <a href={`${base}research/`} class="btn btn--primary">Our research</a>
        <a href={`${base}widgets/`} class="btn btn--outline">Try our simulators</a>
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Latest news</h2>
        <p>What's happening in the lab.</p>
      </div>
      <div class="grid grid--3">
        {news.map(item => (
          <article class="card news-card">
            <time class="tag" datetime={item.date}>
              {new Date(item.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <h2>Get in touch</h2>
          <p>Interested in our work? Looking to collaborate or join the lab?</p>
          <div class="contact-details">
            <div class="contact-item">
              <strong>Email</strong>
              <a href="mailto:email@nanophotonicslab.com">email@nanophotonicslab.com</a>
            </div>
            <div class="contact-item">
              <strong>Location</strong>
              <span>University Name, Building, Office</span>
            </div>
            <div class="contact-item">
              <strong>Social</strong>
              <div class="contact-socials">
                <a href="#" class="btn btn--outline">Google Scholar</a>
                <a href="#" class="btn btn--outline">GitHub</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: calc(var(--nav-height) + var(--space-3xl)) 0 var(--space-3xl);
    overflow: hidden;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
    animation: orbFloat 8s ease-in-out infinite;
  }

  .hero__orb--1 {
    width: 400px;
    height: 400px;
    background: #C4B5FD;
    top: -10%;
    right: 10%;
    animation-delay: 0s;
  }

  .hero__orb--2 {
    width: 300px;
    height: 300px;
    background: #93C5FD;
    top: 30%;
    right: 30%;
    animation-delay: -2s;
  }

  .hero__orb--3 {
    width: 350px;
    height: 350px;
    background: #6EE7B7;
    bottom: 0%;
    right: 5%;
    animation-delay: -4s;
  }

  .hero__orb--4 {
    width: 250px;
    height: 250px;
    background: #FCD34D;
    top: 10%;
    left: -5%;
    animation-delay: -6s;
  }

  @keyframes orbFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -20px) scale(1.05); }
    66% { transform: translate(-20px, 15px) scale(0.95); }
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 720px;
  }

  .hero__gradient-text {
    background: var(--spectrum);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200% auto;
    animation: spectrumText 5s ease-in-out infinite;
  }

  @keyframes spectrumText {
    0%, 100% { background-position: 0% center; }
    50% { background-position: 100% center; }
  }

  .hero__subtitle {
    font-size: 1.25rem;
    line-height: 1.8;
    margin: var(--space-lg) 0 var(--space-xl);
    color: var(--text-soft);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* News cards */
  .news-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .news-card h3 {
    font-size: 1.125rem;
  }

  .news-card p {
    font-size: 0.9375rem;
  }

  /* Contact */
  .contact-section {
    background: var(--bg-soft);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    padding: var(--space-3xl) 0;
  }

  .contact-info h2 {
    margin-bottom: var(--space-sm);
  }

  .contact-info > p {
    font-size: 1.125rem;
    margin-bottom: var(--space-xl);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .contact-item strong {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .contact-item span,
  .contact-item a {
    font-size: 1rem;
    color: var(--text);
  }

  .contact-socials {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: calc(var(--nav-height) + var(--space-xl)) 0 var(--space-xl);
    }

    .hero__subtitle {
      font-size: 1.0625rem;
    }
  }
</style>
