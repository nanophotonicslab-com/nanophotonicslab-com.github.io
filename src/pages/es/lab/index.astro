---
import Layout from '../../../layouts/Layout.astro';
import { getLocaleFromPath, t } from '../../../i18n/translations';

const base = import.meta.env.BASE_URL;
const locale = getLocaleFromPath(Astro.url.pathname);

const widgets = [
  { title: 'Mie Scattering Calculator', description: 'Compute scattering, extinction, and absorption cross-sections for spherical nanoparticles. Supports real materials (Au, Ag, Si, Al, TiO\u2082) and custom dielectrics.', color: '#F59E0B', icon: 'bolt', url: `${base}lab/mie-scattering/` },
  { title: 'Relativistic Electron Calculator', description: 'Convert between velocity, energy, de Broglie wavelength, and Lorentz factor for relativistic electrons.', color: '#7C3AED', icon: 'electron', url: `${base}lab/electron/` },
  { title: 'Photon Calculator', description: 'Convert between wavelength, energy, frequency, angular frequency, wavenumber, and period for photons.', color: '#10B981', icon: 'photon', url: `${base}lab/photon/` },
  { title: 'Cylinder Dispersion', description: 'Guided-mode dispersion \u03C9(q_z) of an infinite dielectric cylinder from exact electromagnetic matching.', color: '#6366F1', icon: 'cylinder', url: `${base}lab/cylinder/` },
  { title: 'Photothermal Calculator', description: 'Laser-driven nanoparticle heating: cross-sections, albedo, and steady-state temperature rise from exact Mie theory.', color: '#EF4444', icon: 'flame', url: `${base}lab/photothermal/` },
  { title: 'Scientific Unit Converter', description: 'Convert between SI, CGS/ESU, and atomic units for 11 physical quantities.', color: '#06B6D4', icon: 'ruler', url: `${base}lab/units/` },
  { title: 'Beam Propagation Method', description: 'Simulate light propagation in step-index waveguides using the Crank\u2013Nicolson paraxial wave equation solver.', color: '#8B5CF6', icon: 'wave', url: `${base}lab/bpm/` },
  { title: 'Laser Pulse Calculator', description: 'Pulse duration \u2194 bandwidth, peak power from average power, and GDD pulse broadening through dispersive media.', color: '#EC4899', icon: 'laser', url: `${base}lab/laser/` },
  { title: 'BEM Solver', description: 'Galerkin boundary element method for plasmonic nanoparticles. Spheres and nanorods with 3D visualization.', color: '#F97316', icon: 'cube', url: `${base}lab/bem-solver/` },
  { title: 'Methods Assistant', description: 'Given a computational photonics problem, find the right numerical method. Semantic retrieval with optional Claude AI.', color: '#64748B', icon: 'chat', url: `${base}lab/assistant/` },
];
---

<Layout title={t(locale, 'lab.title')} description="Interactive simulation tools for nanophotonics.">
  <section class="page-hero">
    <div class="container">
      <h1>
        {t(locale, 'lab.hero.title')}
        <span class="hero__gradient-text">{t(locale, 'lab.hero.gradient')}</span>
      </h1>
      <p class="page-hero__subtitle">
        {t(locale, 'lab.hero.subtitle')}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="widgets-grid">
        {widgets.map(w => (
          <a href={w.url} class="widget-card card">
            <div class="widget-card__header">
              <div class="widget-card__icon" style={`background: ${w.color}15; color: ${w.color}`}>
                {w.icon === 'bolt' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>}
                {w.icon === 'electron' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/></svg>}
                {w.icon === 'photon' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12 C 5 6, 9 18, 12 12 S 19 6, 22 12"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>}
                {w.icon === 'cylinder' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="8" ry="2.5"/><path d="M4 5v14"/><path d="M20 5v14"/><ellipse cx="12" cy="19" rx="8" ry="2.5"/></svg>}
                {w.icon === 'flame' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>}
                {w.icon === 'ruler' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.4 2.4 0 0 1 0-3.4l2.6-2.6a2.4 2.4 0 0 1 3.4 0z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/></svg>}
                {w.icon === 'wave' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12c2-4 4 4 6 0s4 4 6 0 4 4 6 0 4 4 6 0"/></svg>}
                {w.icon === 'laser' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h8"/><path d="M14 12h8"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="12" r="5" stroke-dasharray="2 2"/></svg>}
                {w.icon === 'cube' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>}
                {w.icon === 'chat' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8"/><path d="M8 13h4"/></svg>}
              </div>
              <span class="widget-status widget-status--live">Live</span>
            </div>
            <h3>{w.title}</h3>
            <p>{w.description}</p>
            <span class="widget-cta">{t(locale, 'lab.cta')} &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding: calc(var(--space-3xl) + var(--space-lg)) 0 var(--space-xl); background: var(--bg-soft); }
  .page-hero h1 { margin-bottom: var(--space-md); }
  .page-hero__subtitle { font-size: 1.25rem; max-width: 600px; }
  .hero__gradient-text { background: var(--spectrum); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .widgets-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: var(--space-lg); }
  .widget-card { display: flex; flex-direction: column; gap: var(--space-md); text-decoration: none; color: inherit; cursor: pointer; }
  .widget-card__header { display: flex; justify-content: space-between; align-items: center; }
  .widget-card__icon { width: 48px; height: 48px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; }
  .widget-status { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.25rem 0.75rem; border-radius: var(--radius-full); background: var(--bg-muted); color: var(--text-muted); }
  .widget-status--live { background: #ECFDF5; color: #059669; }
  .widget-card h3 { font-size: 1.125rem; }
  .widget-card p { font-size: 0.9375rem; flex-grow: 1; }
  .widget-cta { font-size: 0.9375rem; font-weight: 600; color: var(--primary); }
  .widget-card:hover .widget-cta { color: var(--primary-dark); }
  @media (max-width: 768px) { .widgets-grid { grid-template-columns: 1fr; } }
</style>
