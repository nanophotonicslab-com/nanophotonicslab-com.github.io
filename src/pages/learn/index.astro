---
import Layout from '../../layouts/Layout.astro';

// Course mode v1: guided lessons built on the tools' own permalinks — every
// step opens a tool pre-configured to show one specific piece of physics.
interface Step {
  n: number;
  title: string;
  body: string;
  look: string;
  href: string;
  tool: string;
}
const plasmonics: Step[] = [
  {
    n: 1,
    title: 'The energy scale of visible light',
    body: 'Plasmons in gold nanoparticles live in the visible. Start by fixing the scale: green light at 532 nm is a ~2.3 eV photon oscillating at ~560 THz.',
    look: 'Note where 532 nm sits between the UV and NIR bands — everything in this lesson happens within ±1 eV of it.',
    href: '/lab/photon/?lam=532',
    tool: 'Photon Calculator',
  },
  {
    n: 2,
    title: 'The plasmon resonance of a gold sphere',
    body: 'A 50 nm gold sphere in water scatters and absorbs light resonantly: the conduction electrons oscillate collectively, driven by the field. Mie theory gives the exact cross-sections.',
    look: 'The extinction peak near ~530 nm — and that σ can exceed the geometric cross-section of the particle. Switch σ_sca ↔ σ_abs: at this size absorption still competes with scattering.',
    href: '/lab/mie-scattering/?material=au&r=50&nh=1.33&lam_min=400&lam_max=800',
    tool: 'Mie Scattering',
  },
  {
    n: 3,
    title: 'Resonant absorption becomes heat',
    body: 'Whatever the particle absorbs, it dissipates. Under a focused CW laser at the resonance, a gold nanoparticle is a nanoscale heater — the basis of photothermal therapy.',
    look: 'ΔT at 532 nm, then move the laser to 800 nm: off resonance the same particle barely warms. Resonance is the switch.',
    href: '/lab/photothermal/?material=au&r=50&nh=1.33&lam=532&pow=5&w0=1',
    tool: 'Photothermal Calculator',
  },
  {
    n: 4,
    title: 'The particle as an antenna for emitters',
    body: 'Put a quantum emitter next to the same sphere: its decay rate is enhanced (Purcell effect), but part of the emission is absorbed by the metal (quenching). The gap distance decides which wins.',
    look: 'Slide the gap d from 50 nm down to 2 nm: F_tot keeps rising while q′ collapses. There is an optimal distance for brightness — that trade-off is the core of nanoantenna design.',
    href: '/lab/purcell/?material=au&r=50&nh=1.33&lam=637&d=10&qy=0.7&tau=12',
    tool: 'Purcell Factor',
  },
  {
    n: 5,
    title: 'Design: compare materials on the workbench',
    body: 'Silver is less lossy than gold — its resonance is sharper and blue-shifted. Wire the comparison yourself on the node workbench: two materials feeding two Mie solvers, side by side.',
    look: 'Load the “Au vs Ag” example. Compare peak positions and widths; then swap one material for the Drude model and see an idealized metal.',
    href: '/lab/workbench/',
    tool: 'Material Workbench',
  },
];
---

<Layout title="Learn" description="Guided interactive lessons in nanophotonics — each step opens a live tool preset to show one specific piece of physics.">
  <section class="widget-hero">
    <div class="container">
      <h1>Learn <span class="gradient-text">by driving</span></h1>
      <p class="widget-hero__subtitle">
        Guided lessons where every step is a live tool, pre-configured to show
        one specific piece of physics. No videos, no screenshots — you drive
        the simulation, the lesson tells you where to look.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="lesson card">
        <div class="lesson-head">
          <h2>Plasmonics of gold nanoparticles</h2>
          <span class="lesson-meta">5 steps &middot; ~20 min &middot; no prerequisites</span>
        </div>
        <p class="lesson-intro">
          From a green photon to a designed nanoantenna: why metal nanoparticles
          have a color, what that color can do, and how to engineer it.
        </p>
        <ol class="steps">
          {plasmonics.map((s) => (
            <li class="step">
              <span class="step-n">{s.n}</span>
              <div class="step-body">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <p class="step-look"><strong>Look for:</strong> {s.look}</p>
                <a class="step-open" href={s.href}>Open {s.tool} &rarr;</a>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <p class="more-note">
        More lessons will land here — the format is cheap on purpose: each step
        is just a tool permalink. Suggest one via the feedback button.
      </p>
    </div>
  </section>
</Layout>

<style>
  .widget-hero { padding: calc(var(--space-3xl) + var(--space-lg)) 0 var(--space-xl); background: var(--bg-soft); }
  .widget-hero h1 { margin-bottom: var(--space-sm); }
  .widget-hero__subtitle { font-size: 1.125rem; max-width: 640px; }
  .gradient-text { background: var(--spectrum); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

  .lesson { padding: var(--space-lg); }
  .lesson-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 0.4rem; }
  .lesson-head h2 { font-size: 1.35rem; }
  .lesson-meta { font-size: 0.8125rem; color: var(--text-muted); font-weight: 500; }
  .lesson-intro { color: var(--text-soft); max-width: 640px; margin: 0.4rem 0 var(--space-lg); }

  .steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-lg); }
  .step { display: flex; gap: var(--space-md); }
  .step-n {
    flex: 0 0 auto; width: 2rem; height: 2rem; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--primary); color: #fff; font-weight: 700; font-size: 0.9rem;
  }
  .step-body h3 { font-size: 1.05rem; margin-bottom: 0.3rem; }
  .step-body p { color: var(--text-soft); max-width: 640px; margin: 0 0 0.4rem; font-size: 0.95rem; }
  .step-look { font-size: 0.875rem; }
  .step-look strong { color: var(--text); }
  .step-open {
    display: inline-block; margin-top: 0.2rem; font-size: 0.875rem; font-weight: 600;
    color: var(--primary);
  }
  .step-open:hover { text-decoration: underline; }

  .more-note { margin-top: var(--space-lg); font-size: 0.875rem; color: var(--text-muted); max-width: 640px; }

  @media (max-width: 640px) {
    .lesson { padding: var(--space-md); }
  }
</style>
