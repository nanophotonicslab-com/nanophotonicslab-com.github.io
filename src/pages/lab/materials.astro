---
import Layout from '../../layouts/Layout.astro';
import ModelInfo from '../../components/ModelInfo.astro';
import ToolMeta from '../../components/ToolMeta.astro';
import { MATERIALS } from '../../data/optical-constants';

const materialOptions = Object.entries(MATERIALS).map(([key, m]) => ({ key, label: m.label, ref: m.ref }));
---

<Layout title="Materials — Optical Constants" description="Optical constants explorer: dielectric function ε(ω) and refractive index n, k of common nanophotonics materials versus photon energy or wavelength, plus an analytic Drude model.">
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Optical <span class="gradient-text">Materials</span></h1>
      <p class="widget-hero__subtitle">
        Explore the complex dielectric function ε(ω) and the refractive index
        n, k of common nanophotonics materials versus photon energy or
        wavelength, plus an analytic Drude model. All curves use the same
        tabulated optical constants as the rest of the Lab.
      </p>
      <ToolMeta slug="materials" name="Materials — Optical Constants" />
    </div>
  </section>

  <ModelInfo status="Beta">
    <dl>
      <dt>Model</dt>
      <dd>Tabulated refractive-index data <em>n(λ), k(λ)</em> interpolated in wavelength; ε = (n + ik)² with the e<sup>−iωt</sup> convention (Im ε &gt; 0 for loss). The Drude module evaluates ε(ω) = ε<sub>∞</sub> − ω<sub>p</sub>² / [ω(ω + iγ)] analytically.</dd>
      <dt>Assumptions</dt>
      <dd>Linear, isotropic, local, non-magnetic media. Values outside a table's measured range are clamped to the nearest endpoint (no extrapolation).</dd>
      <dt>Data sources</dt>
      <dd>refractiveindex.info database — Johnson &amp; Christy 1972 (Au, Ag), Aspnes &amp; Studna 1983 (Si), Rakić 1995 (Al), Sarkar et al. 2019 (TiO₂).</dd>
      <dt>References</dt>
      <dd>E. D. Palik, <em>Handbook of Optical Constants of Solids</em> (1985); M. A. Ordal et al., Appl. Opt. <strong>22</strong>, 1099 (1983).</dd>
    </dl>
  </ModelInfo>

  <section class="section">
    <div class="container">
      <div class="module-bar card" role="radiogroup" aria-label="Materials module">
        <span class="module-bar__label">Module</span>
        <div class="module-bar__grid">
          <button type="button" class="module-card active" id="module-materials" role="radio" aria-checked="true">
            <span class="module-card__name">Materials</span>
            <span class="module-card__desc">n, k &middot; ε(ω) of metals &amp; dielectrics</span>
          </button>
          <button type="button" class="module-card" id="module-drude" role="radio" aria-checked="false">
            <span class="module-card__name">Drude</span>
            <span class="module-card__desc">Free-electron model &middot; ε<sub>∞</sub>, ω<sub>p</sub>, γ</span>
          </button>
          <button type="button" class="module-card" id="module-graphene" role="radio" aria-checked="false">
            <span class="module-card__name">Graphene</span>
            <span class="module-card__desc">Surface conductivity σ(ω,T) &middot; Kubo</span>
          </button>
          <button type="button" class="module-card" id="module-tmdc" role="radio" aria-checked="false">
            <span class="module-card__name">TMDC</span>
            <span class="module-card__desc">ε(ω,T) of MoS₂, MoSe₂, WS₂ &middot; DFPM</span>
          </button>
        </div>
      </div>

      <div class="widget-layout">
        <!-- ===== Controls ===== -->
        <div class="controls card">
          <div class="controls-head">
            <h3 class="controls-title">Parameters</h3>
            <div class="seg controls-head__toggle" id="lin-nl-tabs" hidden role="radiogroup" aria-label="Linear / nonlinear">
              <button type="button" class="seg-btn active" data-linnl="lin" role="radio" aria-checked="true" title="Linear conductivity">LIN</button>
              <button type="button" class="seg-btn" data-linnl="nl" role="radio" aria-checked="false" title="Nonlinear (third-order) conductivity">NL</button>
            </div>
          </div>

          <!-- Materials controls -->
          <div class="ctrl-group" id="ctrl-materials">
            <h3>Material</h3>
            <div class="fields">
              <!-- Material 1 -->
              <div class="field">
                <label for="mat-select" id="mat1-label">Material</label>
                <select class="field-input" id="mat-select">
                  {materialOptions.map(o => (<option value={o.key}>{o.label}</option>))}
                  <option value="file">Upload file&hellip;</option>
                  <option value="rii">Search database&hellip;</option>
                </select>
              </div>
              <div class="mat-extra" id="mat1-rii" hidden>
                <input type="text" class="field-input rii-input" id="mat1-rii-input" placeholder="Search refractiveindex.info&hellip;" autocomplete="off">
                <div class="rii-results" id="mat1-rii-results"></div>
                <span class="ctrl-note rii-status" id="mat1-rii-status"></span>
              </div>
              <div class="mat-extra" id="mat1-file" hidden>
                <input type="file" class="file-input" id="mat1-file-input" accept=".csv,.tsv,.txt,.dat">
                <span class="ctrl-note" id="mat1-file-status">Columns: x, n, k or x, ε′, ε″ (x = nm, µm or eV — auto-detected).</span>
              </div>

              <!-- Material 2 -->
              <div class="field" id="mat2-row" hidden>
                <label for="mat2-select">Material 2</label>
                <select class="field-input" id="mat2-select">
                  {materialOptions.map(o => (<option value={o.key}>{o.label}</option>))}
                  <option value="file">Upload file&hellip;</option>
                  <option value="rii">Search database&hellip;</option>
                </select>
                <button type="button" class="icon-btn" id="mat2-remove" title="Remove material 2" aria-label="Remove material 2">&times;</button>
              </div>
              <div class="mat-extra" id="mat2-rii" hidden>
                <input type="text" class="field-input rii-input" id="mat2-rii-input" placeholder="Search refractiveindex.info&hellip;" autocomplete="off">
                <div class="rii-results" id="mat2-rii-results"></div>
                <span class="ctrl-note rii-status" id="mat2-rii-status"></span>
              </div>
              <div class="mat-extra" id="mat2-file" hidden>
                <input type="file" class="file-input" id="mat2-file-input" accept=".csv,.tsv,.txt,.dat">
                <span class="ctrl-note" id="mat2-file-status">Columns: x, n, k or x, ε′, ε″.</span>
              </div>
            </div>
            <button type="button" class="add-mat-btn" id="mat-add" title="Compare a second material">+ Add material</button>
            <p class="ctrl-note" id="mat-ref"></p>
          </div>

          <!-- Drude controls -->
          <div class="ctrl-group" id="ctrl-drude" hidden>
            <h3>Drude model</h3>
            <p class="drude-formula">ε(ω) = ε<sub>∞</sub> − ω<sub>p</sub><sup>2</sup> / [ω(ω + iγ)]</p>
            <div class="fields">
              <div class="field">
                <label for="drude-epsb">ε<sub>∞</sub></label>
                <input type="text" class="field-input" id="drude-epsb" inputmode="decimal" value="9.5">
              </div>
              <div class="field">
                <label for="drude-wp">&#8463;ω<sub>p</sub> [eV]</label>
                <input type="text" class="field-input" id="drude-wp" inputmode="decimal" value="9.06">
              </div>
              <div class="mini-row">
                <div class="mini-field"><label for="drude-gamma">γ = &#8463;τ<sup>&minus;1</sup> [eV]</label><input type="text" class="field-input" id="drude-gamma" inputmode="decimal" value="0.071"></div>
                <div class="mini-field"><label for="drude-tau">τ [fs]</label><input type="text" class="field-input" id="drude-tau" inputmode="decimal" value="9.27"></div>
              </div>
            </div>
            <div class="preset-row">
              <button type="button" class="preset-btn drude-preset" data-epsb="9.5" data-wp="9.06" data-gamma="0.071">Au</button>
              <button type="button" class="preset-btn drude-preset" data-epsb="4.0" data-wp="9.17" data-gamma="0.021">Ag</button>
              <button type="button" class="preset-btn drude-preset" data-epsb="1.0" data-wp="15.0" data-gamma="0.6">Al</button>
              <button type="button" class="preset-btn drude-preset" data-epsb="8.0" data-wp="8.88" data-gamma="0.103">Cu</button>
            </div>
          </div>

          <!-- Graphene controls -->
          <div class="ctrl-group" id="ctrl-graphene" hidden>
            <div class="fields">
              <div class="field" id="gr-model-field">
                <label>Model</label>
                <div class="seg" id="gr-model-tabs" role="radiogroup" aria-label="Graphene model">
                  <button type="button" class="seg-btn" data-grmodel="drude" role="radio" aria-checked="false">Drude</button>
                  <button type="button" class="seg-btn active" data-grmodel="local" role="radio" aria-checked="true">Local RPA</button>
                  <button type="button" class="seg-btn" data-grmodel="nonlocal" role="radio" aria-checked="false">Nonlocal RPA</button>
                </div>
              </div>
              <div class="field" id="gr-process-field" hidden>
                <label for="gr-process">Process</label>
                <select class="field-input" id="gr-process" aria-label="Nonlinear process">
                  <option value="thg">THG (Cox)</option>
                  <option value="kerr">Kerr (Cox)</option>
                  <option value="mikh">THG (Mikhailov)</option>
                  <option value="shg">SHG (Cox)</option>
                  <option value="or">Optical rectification (Cox)</option>
                </select>
              </div>
              <div class="field gr-ef-field">
                <label for="gr-ef">E<sub>F</sub> [eV]</label>
                <input type="text" class="field-input gr-ef-num" id="gr-ef" inputmode="decimal" value="0.4">
                <input type="range" class="gr-slider" id="gr-ef-slider" min="0" max="1.5" step="0.01" value="0.4" aria-label="Fermi energy">
              </div>
              <div class="mini-row">
                <div class="mini-field"><label for="gr-gamma">γ [eV]</label><input type="text" class="field-input" id="gr-gamma" inputmode="decimal" value="0.0037"></div>
                <div class="mini-field"><label for="gr-tau">τ [fs]</label><input type="text" class="field-input" id="gr-tau" inputmode="decimal" value="177.9"></div>
                <div class="mini-field"><label for="gr-mobility">μ<sup>DC</sup> [cm²/Vs]</label><input type="text" class="field-input" id="gr-mobility" inputmode="decimal" value="4448"></div>
              </div>
              <div class="field gr-ef-field">
                <label for="gr-temp">T [K]</label>
                <input type="text" class="field-input gr-ef-num" id="gr-temp" inputmode="decimal" value="300">
                <input type="range" class="gr-slider" id="gr-temp-slider" min="0" max="1000" step="5" value="300" list="gr-temp-marks" aria-label="Temperature">
                <datalist id="gr-temp-marks"><option value="300" label="300 K"></option></datalist>
              </div>
            </div>
          </div>

          <!-- TMDC controls -->
          <div class="ctrl-group" id="ctrl-tmdc" hidden>
            <div class="fields">
              <div class="field">
                <label for="tmdc-mat">Material</label>
                <select class="field-input" id="tmdc-mat" aria-label="TMDC material">
                  <option value="MoS2">MoS₂</option>
                  <option value="MoSe2">MoSe₂</option>
                  <option value="WS2">WS₂</option>
                </select>
              </div>
              <div class="field gr-ef-field">
                <label for="tmdc-temp">T [K]</label>
                <input type="text" class="field-input gr-ef-num" id="tmdc-temp" inputmode="decimal" value="300">
                <input type="range" class="gr-slider" id="tmdc-temp-slider" min="35" max="350" step="1" value="300" list="tmdc-temp-marks" aria-label="Temperature">
                <datalist id="tmdc-temp-marks"><option value="300" label="300 K"></option></datalist>
              </div>
            </div>
          </div>

          <h3>Display</h3>
          <div class="fields">
            <div class="field" id="qty-field">
              <label>Quantity</label>
              <div class="seg" id="qty-tabs" role="radiogroup" aria-label="Quantity">
                <button type="button" class="seg-btn active" data-qty="eps" role="radio" aria-checked="true">ε (Re, Im)</button>
                <button type="button" class="seg-btn" data-qty="nk" role="radio" aria-checked="false">n, k</button>
              </div>
            </div>
            <div class="field" id="gr-unit-field" hidden>
              <label>Units</label>
              <div class="seg" id="gr-unit-tabs" role="radiogroup" aria-label="Conductivity units">
                <button type="button" class="seg-btn active" data-grunit="sigma0" role="radio" aria-checked="true">σ₀</button>
                <button type="button" class="seg-btn" data-grunit="esu" role="radio" aria-checked="false">esu</button>
                <button type="button" class="seg-btn" data-grunit="au" role="radio" aria-checked="false">a.u.</button>
                <button type="button" class="seg-btn" data-grunit="si" role="radio" aria-checked="false">SI</button>
              </div>
            </div>
            <div class="field">
              <label>X axis</label>
              <div class="seg" id="axis-tabs" role="radiogroup" aria-label="X axis">
                <button type="button" class="seg-btn" data-axis="energy" role="radio" aria-checked="false">Energy</button>
                <button type="button" class="seg-btn active" data-axis="wavelength" role="radio" aria-checked="true">Wavelength</button>
              </div>
            </div>
          </div>

          <h3>Range</h3>
          <div class="fields">
            <div class="field">
              <label for="range-unit">Unit</label>
              <select class="field-input" id="range-unit"></select>
            </div>
            <div class="field">
              <label for="mat-rmin" id="rmin-label">λ min</label>
              <input type="text" class="field-input" id="mat-rmin" inputmode="decimal" value="200">
            </div>
            <div class="field">
              <label for="mat-rmax" id="rmax-label">λ max</label>
              <input type="text" class="field-input" id="mat-rmax" inputmode="decimal" value="2000">
            </div>
            <div class="field" id="gr-qunit-field" hidden>
              <label>Q unit</label>
              <div class="seg" id="gr-qunit-tabs" role="radiogroup" aria-label="Q unit">
                <button type="button" class="seg-btn active" data-grqunit="nm" role="radio" aria-checked="true">nm⁻¹</button>
                <button type="button" class="seg-btn" data-grqunit="kf" role="radio" aria-checked="false">k<sub>F</sub></button>
              </div>
            </div>
            <div class="field" id="gr-qmin-field" hidden>
              <label for="gr-qmin">Q min</label>
              <input type="text" class="field-input" id="gr-qmin" inputmode="decimal" value="0">
            </div>
            <div class="field" id="gr-qmax-field" hidden>
              <label for="gr-qmax">Q max</label>
              <input type="text" class="field-input" id="gr-qmax" inputmode="decimal" value="1.2">
            </div>
            <div class="field gr-ef-field" id="gr-q-field" hidden>
              <label for="gr-q">Q cut</label>
              <input type="text" class="field-input gr-ef-num" id="gr-q" inputmode="decimal" value="0.3">
              <input type="range" class="gr-slider" id="gr-q-slider" min="0" max="1.2" step="0.012" value="0.3" aria-label="Q cut (vertical line on the σ(Q,ω) map)">
            </div>
          </div>
          <p class="ctrl-note" id="range-note"></p>
        </div>

        <!-- ===== Results ===== -->
        <div class="mat-results card">
          <div class="chart-header">
            <span class="chart-title-wrap">
              <span class="chart-title" id="mat-title">Dielectric function ε(ω)</span>
              <button type="button" class="header-toggle" id="gr-decompose" hidden aria-pressed="false" title="Show intraband and interband contributions separately">intra / inter</button>
            </span>
            <span class="chart-header__right">
              <span class="mat-legend" id="mat-legend"></span>
            </span>
          </div>
          <div class="chart-wrap">
            <canvas id="mat-canvas" aria-label="Optical constants plot"></canvas>
          </div>

          <div class="output-card card" id="readout"></div>

          <div class="gr-map-card card" id="gr-map-card" hidden>
            <div class="gr-map-head">
              <span class="gr-map-title">σ(Q, ω) / σ₀ — nonlocal RPA map</span>
              <span class="gr-map-hint">Drag the <b>Q</b> slider (Range) to move the dashed cut</span>
            </div>
            <div class="chart-wrap gr-map-wrap"><canvas id="gr-map" aria-label="Nonlocal conductivity map σ(Q,ω)"></canvas></div>
          </div>

          <div class="mat-export-bar">
            <span class="mat-export-label">Export</span>
            <button id="mat-dl-png" class="share-btn" title="Download plot as PNG">PNG</button>
            <button id="mat-dl-csv" class="share-btn" title="Download data as CSV">CSV</button>
          </div>

          <div class="notes-card card" id="mat-notes"></div>
          <div class="references card" id="mat-refs"></div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .module-bar { margin-bottom: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-sm); }
  .module-bar__label { color: var(--text); font-size: 0.75rem; font-weight: 800; line-height: 1; text-transform: uppercase; letter-spacing: 0.04em; }
  .module-bar__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-sm); align-items: stretch; }
  @media (max-width: 760px) { .module-bar__grid { grid-template-columns: repeat(2, 1fr); } }
  .module-card {
    display: flex; flex-direction: column; justify-content: center; gap: 0.25rem;
    width: 100%; min-height: 66px; text-align: left;
    border: 1px solid var(--bg-muted); border-radius: var(--radius-sm);
    background: var(--bg); color: var(--text); font-family: var(--font);
    padding: 0.6rem 0.7rem; cursor: pointer;
  }
  .module-card__name { display: flex; align-items: center; gap: 0.4rem; font-size: 0.875rem; font-weight: 800; }
  .module-card__desc { color: var(--text-soft); font-size: 0.6875rem; font-weight: 600; line-height: 1.3; }
  .module-card__badge {
    align-self: flex-start; border-radius: var(--radius-full); background: var(--bg-muted);
    color: var(--text-muted); font-size: 0.625rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.04em; padding: 0.1rem 0.4rem;
  }
  .module-card:hover:not(:disabled):not(.active) { border-color: var(--primary-light); background: rgba(99, 102, 241, 0.06); }
  .module-card.active { border-color: var(--primary); background: rgba(99, 102, 241, 0.08); color: var(--primary); }
  .module-card.active .module-card__desc { color: var(--primary); opacity: 0.85; }
  .module-card:disabled { cursor: not-allowed; opacity: 0.5; }

  .widget-layout { display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: var(--space-lg); align-items: start; }
  @media (max-width: 900px) { .widget-layout { grid-template-columns: 1fr; } }

  .controls { padding: var(--space-md); position: relative; }
  .controls h3 {
    font-size: 0.8rem; font-weight: 700; color: var(--text); margin: var(--space-md) 0 0.5rem;
    padding-top: var(--space-md); border-top: 1px solid var(--bg-muted);
  }
  .controls h3:first-of-type, .controls .ctrl-group h3 { }
  .controls-title { margin: 0 0 0.25rem !important; padding-top: 0 !important; border-top: none !important; font-size: 0.95rem !important; }
  .controls-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
  .seg.controls-head__toggle { flex: 0 0 auto; width: 104px; }   /* fixed width, hugs right margin */
  .controls-head__toggle[hidden] { display: none; }
  .controls-head__toggle .seg-btn { flex: 1 1 0; padding: 0.2rem 0; font-weight: 700; font-size: 0.72rem; }  /* equal LIN / NL halves */
  .ctrl-group h3 { margin-top: 0; padding-top: 0; border-top: none; }
  .ctrl-group[hidden] { display: none; }

  .fields { display: flex; flex-direction: column; gap: 0.5rem; }
  .field { display: flex; align-items: center; gap: 0.5rem; }
  .field[hidden] { display: none; }
  .field label { flex: 0 0 auto; min-width: 70px; font-size: 0.8rem; color: var(--text-soft); }
  .field-input {
    flex: 1 1 auto; min-width: 0; width: 100%; padding: 0.4rem 0.55rem;
    border: 1px solid var(--bg-muted); border-radius: var(--radius-sm);
    background: var(--bg); color: var(--text); font-family: var(--font); font-size: 0.85rem;
  }
  .field-input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.15); }
  .field-input:disabled, .gr-slider:disabled { opacity: 0.45; cursor: not-allowed; }
  select.field-input { cursor: pointer; }

  .ctrl-note { font-size: 0.7rem; color: var(--text-muted); margin: 0.4rem 0 0; line-height: 1.4; }
  .drude-formula { font-size: 0.78rem; color: var(--text-soft); margin: 0 0 0.5rem; }

  .preset-row { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.5rem; }
  .preset-btn {
    padding: 0.25rem 0.6rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-full);
    background: var(--bg); color: var(--text-soft); font-family: var(--font); font-size: 0.72rem;
    font-weight: 600; cursor: pointer; transition: border-color 0.15s, color 0.15s;
  }
  .preset-btn:hover { border-color: var(--primary); color: var(--primary); }

  /* Segmented toggle */
  .seg { display: inline-flex; flex: 1 1 auto; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm); overflow: hidden; }
  .seg-btn {
    flex: 1 1 0; padding: 0.35rem 0.3rem; border: none; background: var(--bg);
    color: var(--text-soft); font-family: var(--font); font-size: 0.74rem; font-weight: 600;
    cursor: pointer; transition: background 0.12s, color 0.12s; white-space: nowrap;
  }
  .seg-btn + .seg-btn { border-left: 1px solid var(--bg-muted); }
  .seg-btn:hover:not(.active) { background: rgba(99, 102, 241, 0.06); color: var(--primary); }
  .seg-btn.active { background: var(--primary); color: #fff; }

  .mat-results { padding: var(--space-md); display: flex; flex-direction: column; gap: var(--space-md); min-width: 0; overflow: visible; }
  .chart-header { display: flex; justify-content: space-between; align-items: center; gap: var(--space-sm); flex-wrap: wrap; }
  .chart-title-wrap { display: inline-flex; align-items: center; gap: 0.5rem; }
  .chart-title { font-weight: 600; font-size: 0.95rem; }
  .header-toggle {
    padding: 0.18rem 0.55rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-full);
    background: var(--bg); color: var(--text-soft); font-family: var(--font); font-size: 0.7rem; font-weight: 700; cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .header-toggle[hidden] { display: none; }
  .header-toggle:hover { border-color: var(--primary); color: var(--primary); }
  .header-toggle[aria-pressed="true"] { background: var(--primary); border-color: var(--primary); color: #fff; }
  .gr-slider { width: 100%; accent-color: var(--primary); cursor: pointer; margin: -0.15rem 0 0.1rem; }
  /* E_F: label + number + slider on one line */
  .gr-ef-field { display: flex; align-items: center; gap: 0.5rem; }
