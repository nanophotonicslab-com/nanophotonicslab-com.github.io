<script>
  import { chartTheme, onThemeChange } from '../../lib/chart-theme';
  import { MATERIALS, interpolateNK, nkToEpsilon, epsilonToNK, drudeEpsilon, PHOTON_HC_EV_NM as HC } from '../../lib/materials';
  import { downloadBlob } from '../../lib/download';
  import { loadCatalog, searchCatalog, fetchMaterialNK, type RIIMaterial } from '../../data/refractiveindex';
  import { TMDC, TMDC_LABEL, tmdcEpsilon } from '../../data/tmdc';

  // ── optical-file parser (tabulated x, n, k or x, ε′, ε″ — axis/value auto-detected) ──
  type FileRow = [number, number, number];
  function parseOpticalFile(text: string): { rows: FileRow[] } | { error: string } {
    const lines = text.split(/\r?\n/).map(l => l.trim()).filter(l => l && !l.startsWith('#') && !l.startsWith('%'));
    if (lines.length < 2) return { error: 'File needs at least 2 data rows' };
    let delim: RegExp = /\t/;
    if (lines[0].split(delim).length < 3) delim = /,/;
    if (lines[0].split(delim).length < 3) delim = /\s+/;
    const start = isNaN(parseFloat(lines[0].split(delim)[0])) ? 1 : 0;
    const rows: FileRow[] = [];
    for (let i = start; i < lines.length; i++) {
      const p = lines[i].split(delim).map(Number);
      if (p.length >= 3 && Number.isFinite(p[0]) && Number.isFinite(p[1]) && Number.isFinite(p[2])) rows.push([p[0], p[1], p[2]]);
    }
    return rows.length >= 2 ? { rows } : { error: 'Could not parse ≥2 rows of 3 numeric columns' };
  }
  function inferModes(rows: FileRow[]): { axis: 'nm' | 'um' | 'eV'; values: 'nk' | 'eps' } {
    const xMax = Math.max(...rows.map(r => r[0]));
    const yMaxAbs = Math.max(...rows.flatMap(r => [Math.abs(r[1]), Math.abs(r[2])]));
    const values = rows.some(r => r[1] < 0) || yMaxAbs > 25 ? 'eps' : 'nk';
    const axis = xMax > 50 ? 'nm' : (values === 'eps' || xMax > 8 ? 'eV' : 'um');
    return { axis, values };
  }
  function rowsToData(rows: FileRow[], m: { axis: 'nm' | 'um' | 'eV'; values: 'nk' | 'eps' }): number[][] {
    const data: number[][] = [];
    for (const [x, a, b] of rows) {
      if (x <= 0) continue;
      const lamUm = m.axis === 'nm' ? x / 1000 : m.axis === 'eV' ? HC / x / 1000 : x;
      const [n, k] = m.values === 'eps' ? epsilonToNK(a, b) : [a, Math.abs(b)];
      if (Number.isFinite(lamUm) && Number.isFinite(n) && Number.isFinite(k) && n >= 0) data.push([lamUm, n, k]);
    }
    data.sort((p, q) => p[0] - q[0]);
    return data;
  }

  const COLORS = ['#6366F1', '#F59E0B'];   // one colour per material; solid = real part, dashed = imaginary

  interface Source { label: string; color: string; nk: (lamNm: number) => { re: number; im: number; n: number; k: number }; dataLo: number; dataHi: number; }

  type Mod = 'materials' | 'drude' | 'graphene' | 'tmdc';
  type Quantity = 'eps' | 'nk';
  const isSigma = () => mod === 'graphene';
  type Axis = 'energy' | 'wavelength';
  let mod: Mod = 'materials';
  let quantity: Quantity = 'eps';
  let axis: Axis = 'wavelength';
  let waveUnit: 'nm' | 'um' = 'nm';
  let energyUnit: 'eV' | 'meV' | 'THz' | 'EF' = 'eV';
  let grQUnit: 'nm' | 'kf' = 'nm';   // colormap Q axis: nm⁻¹ or normalized Q/k_F
  let mat2On = false;                       // second material in the Materials module
  // canonical plotting window, always stored as wavelength in nm (lo < hi)
  let rangeLoNm = 200, rangeHiNm = 2000;

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const canvas = $('mat-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const matSelect = $('mat-select') as HTMLSelectElement;
  const mat2Select = $('mat2-select') as HTMLSelectElement;

  // ── a material slot: built-in table, uploaded file, or database (RII) result ──
  interface Slot {
    select: HTMLSelectElement;
    custom: { label: string; ref: string; data: number[][] } | null;
    catalog: RIIMaterial[] | null;
    resolve: () => { label: string; ref: string; data: number[][] } | null;
  }
  function setupSlot(prefix: string, select: HTMLSelectElement): Slot {
    const riiGroup = $(`${prefix}-rii`), fileGroup = $(`${prefix}-file`);
    const riiInput = $(`${prefix}-rii-input`) as HTMLInputElement;
    const riiResults = $(`${prefix}-rii-results`);
    const riiStatus = $(`${prefix}-rii-status`);
    const fileInput = $(`${prefix}-file-input`) as HTMLInputElement;
    const fileStatus = $(`${prefix}-file-status`);
    const slot: Slot = { select, custom: null, catalog: null, resolve: () => null };

    slot.resolve = () => {
      const v = select.value;
      if (MATERIALS[v]) return { label: MATERIALS[v].label, ref: MATERIALS[v].ref, data: MATERIALS[v].data };
      if ((v === 'file' || v === 'rii') && slot.custom) return slot.custom;
      return null;
    };

    select.addEventListener('change', () => {
      riiGroup.hidden = select.value !== 'rii';
      fileGroup.hidden = select.value !== 'file';
      if (select.value === 'rii') runSearch();
      refreshMatRef(); render();
    });

    // database search
    let timer: number | undefined;
    async function runSearch() {
      if (!slot.catalog) {
        riiStatus.textContent = 'Loading database…'; riiStatus.classList.remove('err');
        try { slot.catalog = await loadCatalog(); }
        catch { riiStatus.textContent = 'Failed to load database'; riiStatus.classList.add('err'); return; }
      }
      const hits = searchCatalog(slot.catalog, riiInput.value.trim());
      (riiResults as any)._hits = hits;
      riiResults.innerHTML = hits.length
        ? hits.map((m, i) => `<div class="rii-result" data-i="${i}"><span class="rii-result__book">${m.bookName || m.book}</span> <span class="rii-result__page">${m.pageName}</span></div>`).join('')
        : '<div class="rii-empty">No matches</div>';
      riiStatus.textContent = `${slot.catalog.length} materials in database`;
    }
    riiInput.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(runSearch, 200); });
    riiResults.addEventListener('click', async (e) => {
      const el = (e.target as HTMLElement).closest('.rii-result') as HTMLElement | null;
      if (!el) return;
      const m = ((riiResults as any)._hits as RIIMaterial[])[+el.dataset.i!];
      if (!m) return;
      riiStatus.textContent = 'Loading data…'; riiStatus.classList.remove('err');
      try {
        const data = await fetchMaterialNK(m.dataPath);
        slot.custom = { label: m.bookName || m.book, ref: `refractiveindex.info · ${m.pageName}`, data };
        riiStatus.textContent = `${m.bookName || m.book} · ${m.pageName} (${data.length} pts)`;
        refreshMatRef(); render();
      } catch { riiStatus.textContent = 'Failed to load data'; riiStatus.classList.add('err'); }
    });

    // file upload
    fileInput.addEventListener('change', () => {
      const f = fileInput.files?.[0]; if (!f) return;
      f.text().then(text => {
        const parsed = parseOpticalFile(text);
        if ('error' in parsed) { fileStatus.textContent = parsed.error; fileStatus.classList.add('err'); return; }
        const modes = inferModes(parsed.rows);
        const data = rowsToData(parsed.rows, modes);
        if (data.length < 2) { fileStatus.textContent = 'No valid optical rows'; fileStatus.classList.add('err'); return; }
        slot.custom = { label: f.name.replace(/\.[^.]+$/, ''), ref: `uploaded · ${modes.values === 'eps' ? 'ε' : 'n,k'} vs ${modes.axis}`, data };
        fileStatus.classList.remove('err');
        fileStatus.textContent = `${f.name}: ${data.length} rows · ${modes.values === 'eps' ? 'ε' : 'n,k'} vs ${modes.axis}`;
        refreshMatRef(); render();
      });
    });

    return slot;
  }
  const slot1 = setupSlot('mat1', matSelect);
  const slot2 = setupSlot('mat2', mat2Select);

  const num = (id: string, def: number): number => {
    const v = parseFloat(($(id) as HTMLInputElement).value);
    return Number.isFinite(v) ? v : def;
  };
  const drudeParams = () => ({ epsB: num('drude-epsb', 1), wpEv: num('drude-wp', 9), gammaEv: num('drude-gamma', 0.05) });

  // ── Graphene linear surface conductivity σ(ω), in units of σ₀ = e²/4ħ ──
  // Ported from the MATLAB/C routines (graphene_sigma1.m, graphene.h). In the
  // closed forms the eV→a.u. factors cancel, so we work directly in eV. σ₀ = 1/4.
  const KB_EV = 8.617333262e-5;   // Boltzmann constant in eV/K
  // i·μ / [π (ω + iγ)]  (intraband Drude term, a.u.)
  function grDrude(mu: number, gam: number, w: number): { re: number; im: number } {
    const dr = Math.PI * w, di = Math.PI * gam, d2 = dr * dr + di * di;
    return { re: mu * di / d2, im: mu * dr / d2 };           // i/(dr+idi) = (di + i·dr)/|·|²
  }
  function grMuT(EF: number, T: number): number {
    const KT = KB_EV * Math.max(T, 1e-9);
    return Math.abs(EF) + 2 * KT * Math.log(1 + Math.exp(-Math.abs(EF) / KT));
  }
  // interband, T=0 (exact z-formula of graphene_sigma1.m), a.u.
  function grInterT0(EF: number, gam: number, w: number): { re: number; im: number } {
    const nr = w - 2 * EF, ni = gam, dr = w + 2 * EF, di = gam, dd = dr * dr + di * di;
    const zr = (nr * dr + ni * di) / dd, zi = (ni * dr - nr * di) / dd;
    const r = Math.hypot(zr, zi), th = Math.atan2(zi, zr);
    return { re: 0.25 * (1 - th / Math.PI), im: 0.25 * Math.log(r) / Math.PI };
  }
  // interband, finite T (thermal μ + Hanson smearing), a.u.
  function grInterT(EF: number, gam: number, T: number, w: number): { re: number; im: number } {
    const KT = KB_EV * Math.max(T, 1e-9), mu = grMuT(EF, T), x = w - 2 * mu;
    return {
      re: 0.25 * (0.5 + Math.atan(x / (2 * KT)) / Math.PI),
      im: 0.25 * Math.log((x * x + 4 * KT * KT) / ((w + 2 * mu) * (w + 2 * mu))) / (2 * Math.PI),
    };
  }
  let grModel: 'drude' | 'local' | 'nonlocal' = 'local';
  let grTempSaved = '300';   // T restored when leaving the (T=0) nonlocal RPA model
  let grDecompose = false;
  let grUnit = 'sigma0';
  let grNL = false;                                                // linear vs nonlinear
  let grProcess: 'thg' | 'kerr' | 'mikh' | 'shg' | 'or' = 'thg';   // nonlinear process

  // ── complex helpers (principal branch) ──
  type C = { re: number; im: number };
  const cc = (re: number, im = 0): C => ({ re, im });
  const cAdd = (a: C, b: C): C => ({ re: a.re + b.re, im: a.im + b.im });
  const cSub = (a: C, b: C): C => ({ re: a.re - b.re, im: a.im - b.im });
  const cMul = (a: C, b: C): C => ({ re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re });
  const cDiv = (a: C, b: C): C => { const d = b.re * b.re + b.im * b.im; return { re: (a.re * b.re + a.im * b.im) / d, im: (a.im * b.re - a.re * b.im) / d }; };
  const cScale = (s: number, a: C): C => ({ re: s * a.re, im: s * a.im });
  const cInv = (a: C): C => cDiv(cc(1), a);
  const c2p = (a: C): C => cMul(a, a);
  const c3p = (a: C): C => cMul(c2p(a), a);
  const cMany = (...xs: C[]): C => xs.reduce((p, x) => cMul(p, x));
  const cSqrt = (z: C): C => { const r = Math.hypot(z.re, z.im); const re = Math.sqrt(Math.max(0, (r + z.re) / 2)); let im = Math.sqrt(Math.max(0, (r - z.re) / 2)); if (z.im < 0) im = -im; return { re, im }; };
  const cLog = (z: C): C => ({ re: 0.5 * Math.log(z.re * z.re + z.im * z.im), im: Math.atan2(z.im, z.re) });

  const EV_AU = 1 / 27.2113834;
  const NM_AU = 18.897260;
  const VF_AU = 137.03599971 / 300;   // Fermi velocity in a.u. (c/300)
  const PI = Math.PI;
  const grNLgam = () => Math.max(0, num('gr-gamma', 0.0037)) * EV_AU;

  // ── Linear nonlocal Mermin-RPA, T=0 (Koppens et al., Nano Lett. 11, 3370) → a.u. ──
  const _Gc = (z: C): C => { const s = cSqrt(cSub(cMul(z, z), cc(1))); return cSub(cMul(z, s), cLog(cAdd(z, s))); };
  function grNonlocal(wEv: number, qNm?: number): C {
    const vF = VF_AU, vF2 = vF * vF;
    const EF = num('gr-ef', 0.4) * EV_AU, gam = grNLgam(), w = wEv * EV_AU;
    let Q = Math.max(1e-9, qNm ?? grQcutNm()) / NM_AU, Q2 = Q * Q;
    const wg2 = c2p(cc(w, gam)), kF = EF / vF;
    if (Q / kF <= 1e-10) { Q = 1e-10 * kF; Q2 = Q * Q; }
    const wpE = cScale(1 / (vF * Q), cc(w + 2 * EF, gam));
    const wmE = cScale(1 / (vF * Q), cc(w - 2 * EF, gam));
    const F = cDiv(cc(vF2 * Q2 / (4 * PI)), cSqrt(cSub(wg2, cc(vF2 * Q2))));
    let val = _Gc(wpE);
    val = wmE.re < 0 ? cAdd(cSub(val, _Gc(cScale(-1, wmE))), cc(0, PI)) : cSub(val, _Gc(wmE));
    const P1 = cAdd(cAdd(cScale(-PI / vF2, cMul(cc(0, 1), F)), cc(-2 * EF / (PI * vF2))), cScale(1 / vF2, cMul(F, val)));
    const xi = cScale(-1 / Q2, P1);
    let xi0 = -2 * kF / (PI * vF); const x = 2 * kF / Q;
    if (x < 1) xi0 += Q / (2 * PI * vF) * (x * Math.sqrt(1 - x * x) - Math.acos(x));
    xi0 = -xi0 / Q2;
    const igw = cc(0, gam / w);
    const xit = cDiv(cMul(cAdd(cc(1), igw), xi), cAdd(cc(1), cMul(igw, cScale(1 / xi0, xi))));
    return cMul(cc(0, -w), xit);
  }

  // intra & inter contributions in units of σ₀ (= ×4 from a.u.) at ω [eV]
  function grapheneParts(w: number): { iRe: number; iIm: number; nRe: number; nIm: number } {
    if (grModel === 'nonlocal') { const s = cScale(4, grNonlocal(w)); return { iRe: s.re, iIm: s.im, nRe: 0, nIm: 0 }; }
    const EF = num('gr-ef', 0.4), gam = Math.max(0, num('gr-gamma', 0.0037)), T = Math.max(0, num('gr-temp', 300));
    const intra = T < 1 ? grDrude(EF, gam, w) : grDrude(grMuT(EF, T), gam, w);
    const inter = grModel === 'drude' ? { re: 0, im: 0 } : (T < 1 ? grInterT0(EF, gam, w) : grInterT(EF, gam, T, w));
    return { iRe: intra.re * 4, iIm: intra.im * 4, nRe: inter.re * 4, nIm: inter.im * 4 };
  }
  function grapheneTotal(w: number): { re: number; im: number } {
    const p = grapheneParts(w);
    return { re: p.iRe + p.nRe, im: p.iIm + p.nIm };
  }

  // ── Nonlinear conductivities (a.u.) ──
  // Cox, Silveiro & García de Abajo, PRB 96, 045442 (2017): closed-form harmonics.
  function grTHGcox(wEv: number): C {   // σ⁽³,³⁾ THG
    const w = wEv * EV_AU, g = grNLgam(), fct = VF_AU * VF_AU / (4 * PI) / (num('gr-ef', 0.4) * EV_AU);
    return cDiv(cc(0, 3 * fct), cMany(cc(w, g), cc(2 * w, g), cc(3 * w, g)));
  }
  function grKerrCox(wEv: number): C {  // σ⁽³,¹⁾ Kerr
    const w = wEv * EV_AU, g = grNLgam(), fct = VF_AU * VF_AU / (4 * PI) / (num('gr-ef', 0.4) * EV_AU);
    return cDiv(cc(0, -3 * fct / (w * w + g * g)), cc(2 * w, g));
  }
  function grSHG(name: string, wEv: number): C {   // σ⁽²,²⁾ component A/B/C
    const w = wEv * EV_AU + 1e-16, g = grNLgam();
    const fct = cDiv(cc(0, VF_AU * VF_AU / (4 * PI)), cMul(cc(2 * w, g), cc(w, g)));
    const wg = cc(w, g), wg2 = cc(2 * w, g);
    let sig: C;
    if (name === 'A') sig = cScale(-1, cAdd(cScale(3, cInv(wg)), cScale(4, cInv(wg2))));
    else if (name === 'B') sig = cScale(-1, cSub(cAdd(cScale(-1, cInv(wg)), cScale(4, cInv(wg2))), cc(4 / w)));
    else sig = cSub(cAdd(cScale(0.5, cInv(wg)), cScale(2, cInv(wg2))), cc(2 / w));
    return cMul(sig, fct);
  }
  function grOR(name: string, wEv: number): C {    // σ⁽²,⁰⁾ component A/B/C/D
    const w = wEv * EV_AU, g = grNLgam(), fct = VF_AU * VF_AU / g / (4 * PI);
    const wg = cc(w, -g), wg2 = w * w + g * g, wwg = cc(w * w, w * g);
    let sig: C;
    if (name === 'A') sig = cSub(cScale(3, cInv(c2p(wg))), cc(4 / wg2));
    else if (name === 'B') sig = cSub(cAdd(cInv(c2p(wg)), cc(4 / wg2)), cScale(4, cInv(wwg)));
    else if (name === 'C') sig = cDiv(cc(0, 2 * g), cc(-w, g));
    else sig = cAdd(cInv(c2p(cc(w, g))), cScale(4, cInv(wwg)));
    return cScale(fct, sig);
  }
  // Mikhailov, PRB 93, 085403 (2016): full third-harmonic S⁽³⁾_xxxx(ω,ω,ω) (dimensionless).
  // Appendix-D integrals, general (distinct-argument) branch — valid for ω > 0.
  function fInt(n: number, a: C, b: C, c: C): C {
    const am1 = cAdd(a, cc(1)), bm1 = cAdd(b, cc(1)), cm1 = cAdd(c, cc(1));
    const amb = cSub(a, b), amc = cSub(a, c), bmc = cSub(b, c), cma = cSub(c, a), cmb = cSub(c, b);
    const la = cLog(am1), lb = cLog(bm1), lc = cLog(cm1);
    const ab = cMul(a, b), ac = cMul(a, c), bc = cMul(b, c), abc = cMul(ab, c);
    if (n === 3) return cSub(cAdd(cInv(ab), cMul(cInv(cMul(c2p(a), amb)), la)), cMul(cInv(cMul(c2p(b), amb)), lb));
    if (n === 4) return cAdd(cAdd(cScale(-1, cInv(cMany(b, amb, bm1))), cMul(cInv(cMul(a, c2p(amb))), la)), cMul(cDiv(cSub(a, cScale(2, b)), cMul(c2p(b), c2p(amb))), lb));
    if (n === 5) {
      const apb = cAdd(a, b);
      const La = cLog(cDiv(cSub(cc(1), a), cAdd(cc(1), a))), Lb = cLog(cDiv(cSub(cc(1), b), cAdd(cc(1), b)));
      return cAdd(cSub(cScale(4, cInv(ab)), cMul(cDiv(cScale(2, b), cMany(c2p(a), amb, apb)), La)), cMul(cDiv(cScale(2, a), cMany(c2p(b), amb, apb)), Lb));
    }
    if (n === 1) {
      let z = cInv(abc);
      z = cAdd(z, cDiv(cAdd(cAdd(cScale(-1, ab), cScale(2, ac)), cSub(cScale(3, bc), cScale(4, c2p(c)))), cMany(c, c2p(cma), c2p(bmc), cm1)));
      z = cSub(z, cInv(cMany(amb, c2p(bmc), bm1)));
      z = cSub(z, cInv(cMany(amc, bmc, c2p(cm1))));
      const p4 = cAdd(cAdd(cAdd(cAdd(cScale(-1, c3p(a)), cScale(-2, cMul(c2p(a), c))), cScale(3, abc)), cMul(a, c2p(c))), cScale(-1, cMul(b, c2p(c))));
      z = cSub(z, cMul(cDiv(p4, cMany(c2p(a), c2p(amb), c3p(amc))), la));
      const p5 = cAdd(cAdd(cAdd(cScale(-2, ab), ac), cScale(3, c2p(b))), cScale(-1, bc));
      z = cSub(z, cMul(cDiv(p5, cMany(c2p(b), c2p(amb), c2p(bmc))), lb));
      const p6 = cAdd(cAdd(cAdd(cAdd(c2p(a), ab), cScale(-4, ac)), cScale(-3, bc)), cScale(5, c2p(c)));
      z = cSub(z, cMul(cDiv(p6, cMany(c, c3p(amc), c2p(cmb))), lc));
      return z;
    }
    let z = cInv(cMany(b, amb, bmc, bm1));   // n === 2
    z = cSub(z, cMul(cInv(cMany(a, c2p(amb), amc)), la));
    const q2 = cAdd(cAdd(cSub(cScale(2, ab), ac), cScale(-3, c2p(b))), cScale(2, bc));
    z = cSub(z, cMul(cDiv(q2, cMany(c2p(b), c2p(amb), c2p(bmc))), lb));
    z = cSub(z, cMul(cInv(cMany(c, cma, c2p(bmc))), lc));
    return z;
  }
  function grMikhTHG(wEv: number): C {
    const EF = num('gr-ef', 0.4) * EV_AU, g = grNLgam(), w = Math.max(wEv, 1e-6) * EV_AU, aE = 2 * Math.abs(EF);
    const O1 = cScale(1 / aE, cc(w, g)), O12 = cScale(1 / aE, cc(2 * w, g)), O123 = cScale(1 / aE, cc(3 * w, g));
    const one = cc(1), q = 0.75, oneq = 0.25;   // Dabcd/4 = 3/4 ; (δδ − Dabcd/4) = 1/4
    const S30 = cDiv(cc(0, 3), cScale(8, cMany(O123, O12, O1)));
    // S_2_1
    const I1a = fInt(1, O1, O12, O123), I2a = fInt(2, O1, O12, O123);
    const p123 = cAdd(one, O123), p12 = cAdd(one, O12);
    let rA = cDiv(cAdd(one, cScale(q, O123)), cMany(O1, O12, c2p(p123)));
    rA = cAdd(rA, cDiv(cc(oneq), cMany(O1, p12, p123)));
    rA = cAdd(rA, cDiv(cc(oneq), cMany(O1, p12, c2p(p123))));
    rA = cSub(rA, cScale(oneq, I1a)); rA = cAdd(rA, cScale(oneq, I2a));
    const I1b = fInt(1, cScale(-1, O1), cScale(-1, O12), cScale(-1, O123)), I2b = fInt(2, cScale(-1, O1), cScale(-1, O12), cScale(-1, O123));
    const m123 = cSub(one, O123), m12 = cSub(one, O12);
    let rB = cDiv(cSub(one, cScale(q, O123)), cMany(O1, O12, c2p(m123)));
    rB = cAdd(rB, cDiv(cc(oneq), cMany(cScale(-1, O1), m12, m123)));
    rB = cAdd(rB, cDiv(cc(oneq), cMany(cScale(-1, O1), m12, c2p(m123))));
    rB = cSub(rB, cScale(oneq, I1b)); rB = cAdd(rB, cScale(oneq, I2b));
    const S21 = cAdd(cMul(cc(0, -0.25), rA), cMul(cc(0, 0.25), rB));
    // S_1_2
    const I3a = fInt(3, O1, O12, one), I4a = fInt(4, O1, O12, one);
    let sA = cMul(cDiv(cc(q), cMany(c2p(O1), O123, O12)), cLog(cAdd(one, O1)));
    sA = cSub(sA, cDiv(cc(q), cMany(O123, O12, O1)));
    sA = cAdd(sA, cDiv(cc(oneq), cMany(O123, O1, p12)));
    sA = cSub(sA, cMul(cDiv(cc(oneq), O123), I3a));
    sA = cAdd(sA, cMul(cDiv(cc(oneq), O123), I4a));
    const I3b = fInt(3, cScale(-1, O1), cScale(-1, O12), one), I4b = fInt(4, cScale(-1, O1), cScale(-1, O12), one);
    let sB = cMul(cDiv(cc(q), cMany(c2p(O1), O123, O12)), cLog(cSub(one, O1)));
    sB = cSub(sB, cDiv(cc(q), cMany(cScale(-1, O123), O12, O1)));
    sB = cAdd(sB, cDiv(cc(oneq), cMany(O123, O1, m12)));
    sB = cAdd(sB, cMul(cDiv(cc(oneq), O123), I3b));
    sB = cSub(sB, cMul(cDiv(cc(oneq), O123), I4b));
    const S12 = cAdd(cMul(cc(0, 0.25), sA), cMul(cc(0, -0.25), sB));
    // S_0_3
    const S03 = cMul(cDiv(cc(0, 3), cScale(32, O12)), fInt(5, O1, O123, one));
    return cAdd(cAdd(cAdd(S30, S21), S12), S03);
  }

  const NL_COLORS = ['#2563eb', '#dc2626', '#059669', '#d97706'];
  function grNLSeries(): { label: string; color: string; fn: (w: number) => C }[] {
    switch (grProcess) {
      case 'thg': return [{ label: 'σ⁽³,³⁾', color: '#111827', fn: grTHGcox }];
      case 'kerr': return [{ label: 'σ⁽³,¹⁾', color: '#111827', fn: grKerrCox }];
      case 'mikh': return [{ label: 'S⁽³⁾', color: '#111827', fn: grMikhTHG }];
      case 'shg': return ['A', 'B', 'C'].map((nm, i) => ({ label: `σ⁽²,²⁾ ${nm}`, color: NL_COLORS[i], fn: (w: number) => grSHG(nm, w) }));
      default: return ['A', 'B', 'C', 'D'].map((nm, i) => ({ label: `σ⁽²,⁰⁾ ${nm}`, color: NL_COLORS[i], fn: (w: number) => grOR(nm, w) }));
    }
  }
  const grProcSymbol = (): string => grProcess === 'thg' ? 'σ⁽³,³⁾' : grProcess === 'kerr' ? 'σ⁽³,¹⁾' : grProcess === 'mikh' ? 'S⁽³⁾' : grProcess === 'shg' ? 'σ⁽²,²⁾' : 'σ⁽²,⁰⁾';
  const grProcUnit = (): string => grProcess === 'mikh' ? '' : ' (a.u.)';
  const grProcTitle = (): string => grProcess === 'thg' ? 'Third-harmonic σ⁽³,³⁾ (Cox)' : grProcess === 'kerr' ? 'Kerr σ⁽³,¹⁾ (Cox)' : grProcess === 'mikh' ? 'Third-harmonic S⁽³⁾ (Mikhailov)' : grProcess === 'shg' ? 'Second-harmonic σ⁽²,²⁾' : 'Optical rectification σ⁽²,⁰⁾';
  // σ/σ₀ → selected unit. esu = c·α/4 cm/s (Gaussian 2D); SI = e²/4ħ S; a.u. = σ₀ = 1/4.
  const SIGMA_UNITS: { key: string; label: string; factor: number; axis: string }[] = [
    { key: 'sigma0', label: 'σ₀', factor: 1, axis: 'σ / σ₀' },
    { key: 'au', label: 'a.u.', factor: 0.25, axis: 'σ (a.u.)' },
    { key: 'esu', label: 'esu', factor: 5.46923e7, axis: 'σ (esu · cm/s)' },
    { key: 'si', label: 'S', factor: 6.08528e-5, axis: 'σ (S)' },
  ];
  const sigmaUnit = () => SIGMA_UNITS.find(u => u.key === grUnit) ?? SIGMA_UNITS[0];

  // ── axis/unit conversions (canonical window = wavelength in nm) ──
  const C_NM_THZ = 299792.458;          // λ[nm]·ν[THz] = c
  const KF_FACTOR = 0.6582119569;       // ħ·v_F [eV·nm] (v_F = 1e6 m/s) → k_F[nm⁻¹] = E_F/ħv_F
  const grEFnow = () => Math.max(1e-9, num('gr-ef', 0.4));
  const kFnm = () => grEFnow() / KF_FACTOR;   // Fermi wavevector in nm⁻¹
  const qDispToNm = (d: number) => grQUnit === 'kf' ? d * kFnm() : d;   // Q from display unit → nm⁻¹
  const qNmToDisp = (nm: number) => grQUnit === 'kf' ? nm / kFnm() : nm;
  const grQcutNm = () => qDispToNm(num('gr-q', 0.3));
  const xToLamNm = (x: number): number =>
    axis === 'wavelength' ? (waveUnit === 'um' ? x * 1000 : x)
    : energyUnit === 'THz' ? C_NM_THZ / x
    : energyUnit === 'EF' ? HC / (x * grEFnow())
    : HC / (energyUnit === 'meV' ? x * 1e-3 : x);
  const lamNmToX = (lamNm: number): number => {
    if (axis === 'wavelength') return waveUnit === 'um' ? lamNm / 1000 : lamNm;
    if (energyUnit === 'THz') return C_NM_THZ / lamNm;
    const eEv = HC / lamNm;
    if (energyUnit === 'EF') return eEv / grEFnow();
    return energyUnit === 'meV' ? eEv * 1e3 : eEv;
  };
  const unitLabel = (): string =>
    axis === 'wavelength' ? (waveUnit === 'um' ? 'µm' : 'nm') : (energyUnit === 'EF' ? 'E_F' : energyUnit);
  const xAxisLabel = (): string =>
    axis === 'wavelength' ? `Wavelength (${unitLabel()})`
    : energyUnit === 'EF' ? 'Photon energy ℏω / E_F' : `Photon energy (${unitLabel()})`;

  const rminEl = $('mat-rmin') as HTMLInputElement;
  const rmaxEl = $('mat-rmax') as HTMLInputElement;
  const unitSel = $('range-unit') as HTMLSelectElement;

  function refreshUnitSelect() {
    if (mod !== 'graphene' && energyUnit === 'EF') energyUnit = 'eV';
    unitSel.innerHTML = axis === 'wavelength'
      ? '<option value="nm">nm</option><option value="um">µm</option>'
      : '<option value="eV">eV</option><option value="meV">meV</option><option value="THz">THz</option>'
        + (mod === 'graphene' ? '<option value="EF">E_F</option>' : '');
    unitSel.value = axis === 'wavelength' ? waveUnit : energyUnit;
  }

  // Write the canonical range into the inputs, converted to the current axis/unit.
  function refreshRangeInputs() {
    const a = lamNmToX(rangeLoNm), b = lamNmToX(rangeHiNm);
    const lo = Math.min(a, b), hi = Math.max(a, b);
    const dp = axis === 'wavelength' ? (waveUnit === 'um' ? 3 : 0) : (energyUnit === 'meV' ? 0 : energyUnit === 'THz' ? 1 : 3);
    rminEl.value = lo.toFixed(dp);
    rmaxEl.value = hi.toFixed(dp);
    const q = axis === 'wavelength' ? 'λ' : energyUnit === 'THz' ? 'ν' : 'E';
    $('rmin-label').textContent = `${q} min`;
    $('rmax-label').textContent = `${q} max`;
  }

  // Read the inputs (current axis/unit) back into the canonical nm window.
  function readRangeInputs() {
    const a = parseFloat(rminEl.value), b = parseFloat(rmaxEl.value);
    if (!Number.isFinite(a) || !Number.isFinite(b) || a <= 0 || b <= 0) return;
    const la = xToLamNm(a), lb = xToLamNm(b);
    const lo = Math.min(la, lb), hi = Math.max(la, lb);
    if (hi > lo) { rangeLoNm = lo; rangeHiNm = hi; }
  }

  // Active plot sources: 1–2 tabulated materials, the Drude model, or graphene σ.
  // ── TMDC dielectric function ε(E,T): cache the spectrum per (material, T) ──
  let tmdcMat = 'MoS2';
  let tmdcCache: { key: string; E: Float64Array; e1: Float64Array; e2: Float64Array } | null = null;
  function tmdcSpectrum() {
    const T = Math.max(0, num('tmdc-temp', 300));
    const key = `${tmdcMat}|${T.toFixed(2)}`;
    if (tmdcCache && tmdcCache.key === key) return tmdcCache;
    const [Elo, Ehi] = TMDC[tmdcMat].Erange;
    const N = 216, E = new Float64Array(N);
    for (let i = 0; i < N; i++) E[i] = Elo + (Ehi - Elo) * i / (N - 1);   // dense grid resolves sharp excitons
    const { e1, e2 } = tmdcEpsilon(tmdcMat, T, E, 351);   // 351-pt support: < 0.002 error vs 601, ~2× faster
    tmdcCache = { key, E, e1, e2 };
    return tmdcCache;
  }
  function tmdcNK(lam: number, sp: ReturnType<typeof tmdcSpectrum>) {
    const E = HC / lam, arr = sp.E;
    if (E <= arr[0] || E >= arr[arr.length - 1]) return { re: NaN, im: NaN, n: NaN, k: NaN };
    let a = 0, b = arr.length - 1;
    while (b - a > 1) { const m = (a + b) >> 1; if (arr[m] <= E) a = m; else b = m; }
    const t = (E - arr[a]) / (arr[b] - arr[a]);
    const e1 = sp.e1[a] + t * (sp.e1[b] - sp.e1[a]), e2 = sp.e2[a] + t * (sp.e2[b] - sp.e2[a]);
    const [n, k] = epsilonToNK(e1, e2);
    return { re: e1, im: e2, n, k };
  }

  function sources(): Source[] {
    if (mod === 'tmdc') {
      const sp = tmdcSpectrum();
      const [Elo, Ehi] = TMDC[tmdcMat].Erange;
      return [{ label: TMDC_LABEL[tmdcMat], color: COLORS[0], dataLo: HC / Ehi, dataHi: HC / Elo, nk: (lam) => tmdcNK(lam, sp) }];
    }
    if (mod === 'graphene' && grNL) {
      return grNLSeries().map(s => ({
        label: s.label, color: s.color, dataLo: -Infinity, dataHi: Infinity,
        nk: (lam: number) => { const v = s.fn(HC / lam); return { re: v.re, im: v.im, n: NaN, k: NaN }; },
      }));
    }
    if (mod === 'graphene') {
      const f = sigmaUnit().factor;
      if (grDecompose) {
        return [
          { label: 'Intraband', color: COLORS[0], dataLo: -Infinity, dataHi: Infinity,
            nk: (lam) => { const p = grapheneParts(HC / lam); return { re: p.iRe * f, im: p.iIm * f, n: NaN, k: NaN }; } },
          { label: 'Interband', color: COLORS[1], dataLo: -Infinity, dataHi: Infinity,
            nk: (lam) => { const p = grapheneParts(HC / lam); return { re: p.nRe * f, im: p.nIm * f, n: NaN, k: NaN }; } },
          { label: 'Total', color: '#111827', dataLo: -Infinity, dataHi: Infinity,
            nk: (lam) => { const s = grapheneTotal(HC / lam); return { re: s.re * f, im: s.im * f, n: NaN, k: NaN }; } },
        ];
      }
      return [{
        label: 'Graphene', color: COLORS[0], dataLo: -Infinity, dataHi: Infinity,
        nk: (lam) => { const s = grapheneTotal(HC / lam); return { re: s.re * f, im: s.im * f, n: NaN, k: NaN }; },
      }];
    }
    if (mod === 'drude') {
      return [{
        label: 'Drude', color: COLORS[0],
        nk: (lam) => { const e = drudeEpsilon(lam, drudeParams()); const [n, k] = epsilonToNK(e.re, e.im); return { re: e.re, im: e.im, n, k }; },
        dataLo: -Infinity, dataHi: Infinity,
      }];
    }
    const slots = mat2On ? [slot1, slot2] : [slot1];
    const out: Source[] = [];
    for (const sl of slots) {
      const r = sl.resolve(); if (!r) continue;
      const d = r.data;
      out.push({
        label: r.label, color: COLORS[out.length % COLORS.length],
        nk: (lam) => { const [n, k] = interpolateNK(d, lam); const e = nkToEpsilon(n, k); return { re: e.re, im: e.im, n, k }; },
        dataLo: d[0][0] * 1000, dataHi: d[d.length - 1][0] * 1000,
      });
    }
    return out;
  }

  // Wavelength range [nm]; for tabulated materials clamp to the (common) measured extent.
  function lamRange(src: Source[]): [number, number] {
    let lo = rangeLoNm, hi = rangeHiNm;
    if (hi <= lo) { const a = Math.min(lo, hi); hi = Math.max(lo, hi) + 1; lo = a; }
    let note = '';
    if (mod === 'materials') {
      let dlo = -Infinity, dhi = Infinity;
      for (const s of src) { dlo = Math.max(dlo, s.dataLo); dhi = Math.min(dhi, s.dataHi); }
      const clo = Math.max(lo, dlo), chi = Math.min(hi, dhi);
      if (clo > lo || chi < hi) note = `${src.length > 1 ? 'Common data' : 'Data'} range ${dlo.toFixed(0)}–${dhi.toFixed(0)} nm; plot clamped.`;
      lo = clo; hi = chi;
    }
    $('range-note').textContent = note;
    return [lo, hi];
  }

  let current: { xs: Float64Array; lam: Float64Array; src: Source[]; series: { color: string; real: Float64Array; imag: Float64Array }[] } | null = null;
  let view: { tx: (v: number) => number; PAD: { l: number; r: number; t: number; b: number }; pw: number; ph: number; xMin: number; xMax: number; xStep: number } | null = null;

  function compute() {
    const N = 216;
    const src = sources();
    const [lamLo, lamHi] = lamRange(src);
    const valid = lamHi > lamLo;
    const xs = new Float64Array(N), lam = new Float64Array(N);
    const xa = lamNmToX(lamLo), xb = lamNmToX(lamHi);
    const xMin = Math.min(xa, xb), xMax = Math.max(xa, xb);
    const series = src.map(s => ({ color: s.color, real: new Float64Array(N), imag: new Float64Array(N) }));
    for (let i = 0; i < N; i++) {
      const x = valid ? xMin + (xMax - xMin) * i / (N - 1) : NaN;
      const l = valid ? xToLamNm(x) : NaN;
      lam[i] = l;
      xs[i] = x;
      for (let j = 0; j < src.length; j++) {
        if (!valid) { series[j].real[i] = NaN; series[j].imag[i] = NaN; continue; }
        const o = src[j].nk(l);
        if (isSigma() || quantity === 'eps') { series[j].real[i] = o.re; series[j].imag[i] = o.im; }
        else { series[j].real[i] = o.n; series[j].imag[i] = o.k; }
      }
    }
    current = { xs, lam, src, series };
  }

  function niceScale(min: number, max: number, ticks = 5) {
    if (!Number.isFinite(min) || !Number.isFinite(max) || min === max) { min = (min || 0) - 1; max = (max || 0) + 1; }
    const range = max - min, raw = range / ticks;
    const mag = Math.pow(10, Math.floor(Math.log10(raw)));
    const norm = raw / mag;
    const step = (norm < 1.5 ? 1 : norm < 3 ? 2 : norm < 7 ? 5 : 10) * mag;
    return { min: Math.floor(min / step) * step, max: Math.ceil(max / step) * step, step };
  }

  const fmt = (v: number): string => {
    if (v === 0) return '0';
    const a = Math.abs(v);
    if (a < 1e-3 || a >= 1e5) return v.toExponential(1);
    let s = a >= 100 ? v.toFixed(0) : a >= 1 ? v.toFixed(2) : v.toFixed(3);
    if (s.indexOf('.') >= 0) s = s.replace(/\.?0+$/, '');
    return s;
  };

  function paint(hoverIdx = -1) {
    if (!current) return;
    const t = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const cw = canvas.clientWidth || 600, ch = Math.max(280, Math.round(cw * 0.6));
    canvas.width = cw * dpr; canvas.height = ch * dpr; canvas.style.height = ch + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, cw, ch);

    const xs = current.xs;
    let ymin = Infinity, ymax = -Infinity;
    for (const s of current.series) for (const arr of [s.real, s.imag]) for (const v of arr) { if (Number.isFinite(v)) { if (v < ymin) ymin = v; if (v > ymax) ymax = v; } }
    if (!Number.isFinite(ymin)) { ymin = 0; ymax = 1; }
    let xmin = xs[0], xmax = xs[xs.length - 1];
    if (!Number.isFinite(xmin) || !Number.isFinite(xmax)) { xmin = 0; xmax = 1; }
    if (xmax < xmin) { const tmp = xmin; xmin = xmax; xmax = tmp; }

    const ys = niceScale(ymin, ymax), xsc = niceScale(xmin, xmax);
    // adaptive left margin so wide tick labels (esu ~5e7, SI ~6e-5) clear the y-axis title
    ctx.font = '11px Inter, system-ui, sans-serif';
    let maxYW = 0;
    for (let v = ys.min; v <= ys.max + ys.step * 0.5; v += ys.step) { const w = ctx.measureText(fmt(v)).width; if (w > maxYW) maxYW = w; }
    const PAD = { l: Math.max(56, Math.ceil(maxYW) + 30), r: 16, t: 14, b: 42 };
    const pw = cw - PAD.l - PAD.r, ph = ch - PAD.t - PAD.b;
    const tx = (v: number) => PAD.l + (v - xsc.min) / (xsc.max - xsc.min) * pw;
    const ty = (v: number) => PAD.t + ph - (v - ys.min) / (ys.max - ys.min) * ph;
    view = { tx, PAD, pw, ph, xMin: xsc.min, xMax: xsc.max, xStep: xsc.step };

    // grid + ticks
    ctx.strokeStyle = t.grid; ctx.lineWidth = 1;
    ctx.fillStyle = t.textMuted; ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (let v = ys.min; v <= ys.max + ys.step * 0.5; v += ys.step) {
      const y = ty(v); if (y < PAD.t - 1 || y > PAD.t + ph + 1) continue;
      ctx.beginPath(); ctx.moveTo(PAD.l, y); ctx.lineTo(PAD.l + pw, y); ctx.stroke();
      ctx.fillText(fmt(v), PAD.l - 8, y);
    }
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    for (let v = xsc.min; v <= xsc.max + xsc.step * 0.5; v += xsc.step) {
      const x = tx(v); if (x < PAD.l - 1 || x > PAD.l + pw + 1) continue;
      ctx.beginPath(); ctx.moveTo(x, PAD.t); ctx.lineTo(x, PAD.t + ph); ctx.stroke();
      ctx.fillText(fmt(v), x, PAD.t + ph + 6);
    }
    // zero line
    if (ys.min < 0 && ys.max > 0) {
      const y0 = ty(0); ctx.save(); ctx.setLineDash([3, 3]); ctx.globalAlpha = 0.55; ctx.strokeStyle = t.textMuted;
      ctx.beginPath(); ctx.moveTo(PAD.l, y0); ctx.lineTo(PAD.l + pw, y0); ctx.stroke(); ctx.restore();
    }
    // axes
    ctx.strokeStyle = t.grid; ctx.beginPath(); ctx.moveTo(PAD.l, PAD.t); ctx.lineTo(PAD.l, PAD.t + ph); ctx.lineTo(PAD.l + pw, PAD.t + ph); ctx.stroke();

    // series
    const drawLine = (arr: Float64Array, color: string, dash: number[]) => {
      ctx.strokeStyle = color; ctx.lineWidth = 2.2; ctx.lineJoin = 'round'; ctx.lineCap = 'round';
      ctx.setLineDash(dash); ctx.beginPath();
      let first = true;
      for (let i = 0; i < xs.length; i++) {
        const v = arr[i];
        if (!Number.isFinite(v) || !Number.isFinite(xs[i])) { first = true; continue; }
        const px = tx(xs[i]), py = ty(v);
        if (first) { ctx.moveTo(px, py); first = false; } else ctx.lineTo(px, py);
      }
      ctx.stroke(); ctx.setLineDash([]);
    };
    // each material: real part solid, imaginary part dashed, in the material colour
    for (const s of current.series) { drawLine(s.real, s.color, []); drawLine(s.imag, s.color, [5, 4]); }

    // graphene: mark the E_F and 2E_F energies (interband onset)
    if (isSigma()) {
      const EF = num('gr-ef', 0.4);
      for (const [E, base] of [[EF, 'E'], [2 * EF, '2E']] as [number, string][]) {
        if (E <= 0) continue;
        const vx = lamNmToX(HC / E), px = tx(vx);
        if (px < PAD.l - 0.5 || px > PAD.l + pw + 0.5) continue;
        ctx.save(); ctx.setLineDash([2, 3]); ctx.strokeStyle = t.textMuted; ctx.globalAlpha = 0.75; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(px, PAD.t); ctx.lineTo(px, PAD.t + ph); ctx.stroke();
        ctx.setLineDash([]); ctx.globalAlpha = 1; ctx.fillStyle = t.textMuted;
        ctx.textAlign = 'left'; ctx.textBaseline = 'top';
        const bx = px + 3, by = PAD.t + 2;
        ctx.font = '10px Inter, system-ui, sans-serif'; ctx.fillText(base, bx, by);
        const bw = ctx.measureText(base).width;
        ctx.font = '7px Inter, system-ui, sans-serif'; ctx.fillText('F', bx + bw + 0.5, by + 4);  // subscript F
        ctx.restore();
      }
    }

    // hover crosshair
    if (hoverIdx >= 0 && hoverIdx < xs.length && Number.isFinite(xs[hoverIdx])) {
      const hx = tx(xs[hoverIdx]); ctx.save(); ctx.strokeStyle = t.textMuted; ctx.globalAlpha = 0.6; ctx.setLineDash([4, 3]);
      ctx.beginPath(); ctx.moveTo(hx, PAD.t); ctx.lineTo(hx, PAD.t + ph); ctx.stroke(); ctx.restore();
      for (const s of current.series) for (const arr of [s.real, s.imag]) {
        const v = arr[hoverIdx]; if (!Number.isFinite(v)) continue;
        ctx.fillStyle = s.color; ctx.beginPath(); ctx.arc(hx, ty(v), 3.2, 0, 2 * Math.PI); ctx.fill();
      }
    }

    // axis labels
    ctx.fillStyle = t.text; ctx.font = '12px Inter, system-ui, sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
    if (axis === 'energy' && energyUnit === 'EF') drawSubF(ctx, 'Photon energy ℏω / E', PAD.l + pw / 2, ch - 12, 12);
    else ctx.fillText(xAxisLabel(), PAD.l + pw / 2, ch - 12);
    ctx.save(); ctx.translate(13, PAD.t + ph / 2); ctx.rotate(-Math.PI / 2); ctx.textBaseline = 'top';
    const yLab = !isSigma() ? (quantity === 'eps' ? 'Dielectric function ε' : 'Refractive index')
      : grNL ? `${grProcSymbol()}${grProcUnit()}` : sigmaUnit().axis;
    ctx.fillText(yLab, 0, 0); ctx.restore();
  }

  // ── Nonlocal RPA σ(Q,ω) colormap — 1×2 (Re | Im), Q horizontal, energy vertical.
  //    The top chart is the vertical cut at the selected Q. ──
  const grMap = $('gr-map') as HTMLCanvasElement;
  const grMapCtx = grMap.getContext('2d')!;
  const VIRIDIS = [[68, 1, 84], [59, 82, 139], [33, 145, 140], [94, 201, 98], [253, 231, 37]];
  const DIVMAP = [[33, 102, 172], [247, 247, 247], [178, 24, 43]];
  const lerpC = (a: number[], b: number[], t: number) => `rgb(${Math.round(a[0] + (b[0] - a[0]) * t)},${Math.round(a[1] + (b[1] - a[1]) * t)},${Math.round(a[2] + (b[2] - a[2]) * t)})`;
  const ramp = (stops: number[][], t: number) => { t = Math.max(0, Math.min(1, t)); const s = t * (stops.length - 1); const i = Math.min(stops.length - 2, Math.floor(s)); return lerpC(stops[i], stops[i + 1], s - i); };
  // Draw `base` followed by a subscript "F" (canvas has no HTML <sub>), centered at x.
  function drawSubF(c: CanvasRenderingContext2D, base: string, x: number, y: number, size: number) {
    const baseFont = `${size}px Inter, system-ui, sans-serif`, subFont = `${Math.round(size * 0.72)}px Inter, system-ui, sans-serif`;
    c.font = baseFont; const bw = c.measureText(base).width;
    c.font = subFont; const sw = c.measureText('F').width;
    const sx = x - (bw + sw) / 2, a = c.textAlign; c.textAlign = 'left';
    c.font = baseFont; c.fillText(base, sx, y);
    c.font = subFont; c.fillText('F', sx + bw, y + size * 0.2);
    c.textAlign = a;
  }
  const GR_NQ = 48, GR_NE = 60;   // grid columns (Q) × rows (energy) — kept modest to stay light
  const pctl = (sorted: number[], p: number) => sorted[Math.min(sorted.length - 1, Math.max(0, Math.round(p * (sorted.length - 1))))];
  let grMapCache: { key: string; re: Float64Array; im: Float64Array; reLo: number; reHi: number; imAbs: number; qloD: number; qhiD: number } | null = null;
  function computeGrMap() {
    const qloD = num('gr-qmin', 0), qhiD = Math.max(qloD + 1e-6, num('gr-qmax', 1.2));
    const EF = num('gr-ef', 0.4), gam = num('gr-gamma', 0.0037);
    const key = `${EF}|${gam}|${view!.xMin}|${view!.xMax}|${axis}|${waveUnit}|${energyUnit}|${grQUnit}|${qloD}|${qhiD}`;
    if (grMapCache && grMapCache.key === key) return grMapCache;
    const re = new Float64Array(GR_NQ * GR_NE), im = new Float64Array(GR_NQ * GR_NE);
    for (let j = 0; j < GR_NQ; j++) {
      const qnm = qDispToNm(qloD + (j + 0.5) / GR_NQ * (qhiD - qloD));
      for (let i = 0; i < GR_NE; i++) {
        const yv = view!.xMin + (i + 0.5) / GR_NE * (view!.xMax - view!.xMin);
        const s = grNonlocal(HC / xToLamNm(yv), qnm);
        re[j * GR_NE + i] = s.re * 4; im[j * GR_NE + i] = s.im * 4;   // → σ/σ₀
      }
    }
    const rs = Array.from(re).sort((a, b) => a - b), is = Array.from(im).sort((a, b) => a - b);
    const reLo = Math.max(0, pctl(rs, 0.02)), reHi = pctl(rs, 0.98);
    const imAbs = Math.max(Math.abs(pctl(is, 0.02)), Math.abs(pctl(is, 0.98))) || 1;
    grMapCache = { key, re, im, reLo, reHi: reHi > reLo ? reHi : reLo + 1, imAbs, qloD, qhiD };
    return grMapCache;
  }
  const grMapLayout = (cw: number) => {
    const PADl = 50, PADr = 12, gap = 30, top = 22, bot = 42;
    const panelW = (cw - PADl - PADr - gap) / 2, panelH = 210;
    return { PADl, PADr, gap, top, bot, panelW, panelH, ch: top + panelH + bot, leftX: [PADl, PADl + panelW + gap] };
  };
  let grMapBaked: { key: string; canvas: HTMLCanvasElement } | null = null;
  function bakeGrMap(cw: number, dpr: number, t: ReturnType<typeof chartTheme>, g: NonNullable<typeof grMapCache>) {
    const L = grMapLayout(cw);
    const off = document.createElement('canvas'); off.width = cw * dpr; off.height = L.ch * dpr;
    const c = off.getContext('2d')!; c.setTransform(dpr, 0, 0, dpr, 0, 0);
    const cellW = L.panelW / GR_NQ, cellH = L.panelH / GR_NE;
    const tyE = (v: number) => L.top + L.panelH - (v - view!.xMin) / (view!.xMax - view!.xMin) * L.panelH;
    const panels = [
      { label: 'Re σ/σ₀', val: (k: number) => g.re[k], col: (v: number) => ramp(VIRIDIS, (v - g.reLo) / (g.reHi - g.reLo)) },
      { label: 'Im σ/σ₀', val: (k: number) => g.im[k], col: (v: number) => ramp(DIVMAP, 0.5 + 0.5 * Math.max(-1, Math.min(1, v / g.imAbs))) },
    ];
    panels.forEach((p, pi) => {
      const x0 = L.leftX[pi];
      for (let j = 0; j < GR_NQ; j++) { const x = x0 + j * cellW; for (let i = 0; i < GR_NE; i++) { c.fillStyle = p.col(p.val(j * GR_NE + i)); c.fillRect(x, L.top + L.panelH - (i + 1) * cellH, cellW + 0.6, cellH + 0.6); } }
      c.strokeStyle = t.grid; c.lineWidth = 1; c.strokeRect(x0, L.top, L.panelW, L.panelH);
      // Q (x) ticks
      c.fillStyle = t.textMuted; c.font = '10px Inter, system-ui, sans-serif'; c.textAlign = 'center'; c.textBaseline = 'top';
      const qs = niceScale(g.qloD, g.qhiD);
      for (let v = qs.min; v <= qs.max + qs.step * 0.5; v += qs.step) { if (v < g.qloD - 1e-9 || v > g.qhiD + 1e-9) continue; const x = x0 + (v - g.qloD) / (g.qhiD - g.qloD) * L.panelW; c.fillText(fmt(v), x, L.top + L.panelH + 5); }
      // panel title
      c.fillStyle = 'rgba(255,255,255,0.85)'; c.fillRect(x0 + 3, L.top + 3, c.measureText(p.label).width + 8, 15);
      c.fillStyle = t.text; c.font = '700 11px Inter, system-ui, sans-serif'; c.textAlign = 'left'; c.textBaseline = 'top'; c.fillText(p.label, x0 + 6, L.top + 4);
      // Q axis label
      c.fillStyle = t.text; c.font = '11px Inter, system-ui, sans-serif'; c.textAlign = 'center'; c.textBaseline = 'top';
      if (grQUnit === 'kf') drawSubF(c, 'Q / k', x0 + L.panelW / 2, L.ch - 16, 11);
      else c.fillText('Q [nm⁻¹]', x0 + L.panelW / 2, L.ch - 16);
    });
    // energy (y) ticks + label on the far left (shared)
    c.fillStyle = t.textMuted; c.font = '10px Inter, system-ui, sans-serif'; c.textAlign = 'right'; c.textBaseline = 'middle';
    for (let v = view!.xMin; v <= view!.xMax + view!.xStep * 0.5; v += view!.xStep) { const y = tyE(v); if (y < L.top - 1 || y > L.top + L.panelH + 1) continue; c.fillText(fmt(v), L.PADl - 6, y); }
    c.save(); c.translate(12, L.top + L.panelH / 2); c.rotate(-Math.PI / 2); c.textAlign = 'center'; c.textBaseline = 'top'; c.fillStyle = t.text; c.font = '10px Inter, system-ui, sans-serif';
    if (axis === 'energy' && energyUnit === 'EF') drawSubF(c, 'ℏω / E', 0, 0, 10);
    else c.fillText(axis === 'wavelength' ? `λ (${unitLabel()})` : `ℏω (${unitLabel()})`, 0, 0);
    c.restore();
    return off;
  }
  function paintMap() {
    if ($('gr-map-card').hidden || !view) return;
    const t = chartTheme(), dpr = window.devicePixelRatio || 1;
    const cw = grMap.clientWidth || 600;
    const L = grMapLayout(cw);
    grMap.width = cw * dpr; grMap.height = L.ch * dpr; grMap.style.height = L.ch + 'px';
    const c = grMapCtx; c.setTransform(dpr, 0, 0, dpr, 0, 0); c.clearRect(0, 0, cw, L.ch);
    const g = computeGrMap();
    const bakeKey = `${g.key}|${cw}|${dpr}|${t.bg}`;
    if (!grMapBaked || grMapBaked.key !== bakeKey) grMapBaked = { key: bakeKey, canvas: bakeGrMap(cw, dpr, t, g) };
    c.drawImage(grMapBaked.canvas, 0, 0, cw, L.ch);
    // live Q cut — vertical dashed line on both panels at the selected Q
    const Qd = num('gr-q', 0.3), frac = Math.max(0, Math.min(1, (Qd - g.qloD) / (g.qhiD - g.qloD)));
    c.save(); c.strokeStyle = '#ff3b30'; c.lineWidth = 1.6; c.setLineDash([5, 3]);
    for (const x0 of L.leftX) { const xQ = x0 + frac * L.panelW; c.beginPath(); c.moveTo(xQ, L.top); c.lineTo(xQ, L.top + L.panelH); c.stroke(); }
    c.restore();
    c.fillStyle = '#ff3b30'; c.font = '700 10px Inter, system-ui, sans-serif'; c.textAlign = 'center'; c.textBaseline = 'bottom';
    for (const x0 of L.leftX) c.fillText('Q = ' + Qd.toFixed(3), x0 + frac * L.panelW, L.top - 3);
  }

  const sharedRow = `<div class="readout-row readout-shared">
      <div class="stat"><span class="stat-label">Wavelength (nm)</span><span class="stat-value" id="r-lambda">—</span></div>
      <div class="stat"><span class="stat-label">Wavenumber (µm⁻¹)</span><span class="stat-value" id="r-wavenum">—</span></div>
      <div class="stat"><span class="stat-label">Energy (eV)</span><span class="stat-value" id="r-energy">—</span></div>
    </div>`;

  // Build the readout boxes. Materials/Drude: per-source ε & n,k. Graphene: the
  // total σ shown in every unit (σ₀, a.u., esu, SI).
  function rebuildReadout(src: Source[]) {
    if (isSigma() && grNL) {
      const u = grProcUnit();
      const rows = src.map((s, i) => `<div class="readout-row readout-nl">
        <div class="readout-mat__name" style="color:${s.color}">${s.label}</div>
        <div class="stat"><span class="stat-label">Re${u}</span><span class="stat-value" id="r-re-${i}">—</span></div>
        <div class="stat"><span class="stat-label">Im${u}</span><span class="stat-value" id="r-im-${i}">—</span></div>
      </div>`).join('');
      $('readout').innerHTML = sharedRow + rows;
      return;
    }
    if (isSigma()) {
      const cells = (part: string) => SIGMA_UNITS.map(u => `<div class="stat"><span class="stat-label">${u.label}</span><span class="stat-value" id="r-${part}-${u.key}">—</span></div>`).join('');
      $('readout').innerHTML = sharedRow
        + `<div class="readout-row readout-sig"><div class="readout-mat__name" style="color:${COLORS[0]}">Re σ</div>${cells('re')}</div>`
        + `<div class="readout-row readout-sig"><div class="readout-mat__name" style="color:${COLORS[0]}">Im σ</div>${cells('im')}</div>`;
      return;
    }
    let html = sharedRow;
    src.forEach((s, i) => {
      html += `<div class="readout-row readout-mat">
        <div class="readout-mat__name" style="color:${s.color}"><span class="readout-mat__dot" style="background:${s.color}"></span>${s.label}</div>
        <div class="stat"><span class="stat-label">Re ε</span><span class="stat-value" id="r-re-${i}">—</span></div>
        <div class="stat"><span class="stat-label">Im ε</span><span class="stat-value" id="r-im-${i}">—</span></div>
        <div class="stat"><span class="stat-label">n</span><span class="stat-value" id="r-n-${i}">—</span></div>
        <div class="stat"><span class="stat-label">k</span><span class="stat-value" id="r-k-${i}">—</span></div>
        <div class="stat"><button class="stat-info" type="button" aria-label="Skin depth info">i<span class="stat-tooltip" role="tooltip">Skin depth δ = 1 / (2·(ω/c)·k) = λ / (4π·k) — the 1/e penetration depth of the field intensity (k = Im n). δ → ∞ when k = 0.</span></button><span class="stat-label">δ (nm)</span><span class="stat-value" id="r-d-${i}">—</span></div>
      </div>`;
    });
    $('readout').innerHTML = html;
  }

  function setReadout(idx: number) {
    if (!current) return;
    const setEl = (id: string, txt: string) => { const el = document.getElementById(id); if (el) el.textContent = txt; };
    const invalid = idx < 0 || idx >= current.lam.length || !Number.isFinite(current.lam[idx]);
    if (isSigma() && grNL) {
      if (invalid) { setEl('r-lambda', '—'); setEl('r-wavenum', '—'); setEl('r-energy', '—'); current.series.forEach((_, i) => { setEl(`r-re-${i}`, '—'); setEl(`r-im-${i}`, '—'); }); return; }
      const lam = current.lam[idx];
      setEl('r-lambda', lam.toFixed(1)); setEl('r-wavenum', fmt(2000 * Math.PI / lam)); setEl('r-energy', (HC / lam).toFixed(3));
      current.series.forEach((s, i) => { setEl(`r-re-${i}`, fmt(s.real[idx])); setEl(`r-im-${i}`, fmt(s.imag[idx])); });
      return;
    }
    if (isSigma()) {
      if (invalid) { setEl('r-lambda', '—'); setEl('r-wavenum', '—'); setEl('r-energy', '—'); SIGMA_UNITS.forEach(u => { setEl(`r-re-${u.key}`, '—'); setEl(`r-im-${u.key}`, '—'); }); return; }
      const lam = current.lam[idx], s = grapheneTotal(HC / lam);   // σ/σ₀
      setEl('r-lambda', lam.toFixed(1)); setEl('r-wavenum', fmt(2000 * Math.PI / lam)); setEl('r-energy', (HC / lam).toFixed(3));
      SIGMA_UNITS.forEach(u => { setEl(`r-re-${u.key}`, fmt(s.re * u.factor)); setEl(`r-im-${u.key}`, fmt(s.im * u.factor)); });
      return;
    }
    const src = current.src;
    if (invalid) {
      setEl('r-lambda', '—'); setEl('r-wavenum', '—'); setEl('r-energy', '—');
      src.forEach((_, i) => ['re', 'im', 'n', 'k', 'd'].forEach(q => setEl(`r-${q}-${i}`, '—')));
      return;
    }
    const lam = current.lam[idx];
    setEl('r-lambda', lam.toFixed(1)); setEl('r-wavenum', fmt(2000 * Math.PI / lam)); setEl('r-energy', (HC / lam).toFixed(3));
    src.forEach((s, i) => {
      const o = s.nk(lam);
      setEl(`r-re-${i}`, fmt(o.re)); setEl(`r-im-${i}`, fmt(o.im)); setEl(`r-n-${i}`, fmt(o.n)); setEl(`r-k-${i}`, fmt(o.k));
      // skin depth δ = 1/(2·(ω/c)·k) = λ/(4π·k); ∞ when k = 0
      setEl(`r-d-${i}`, Number.isFinite(o.k) && o.k > 0 ? fmt(lam / (4 * Math.PI * o.k)) : '∞');
    });
  }

  // Legend: a solid/dashed style key + one coloured entry per material.
  function buildLegend(src: Source[]) {
    const realLab = isSigma() ? (grNL ? 'Re' : 'Re σ') : quantity === 'eps' ? 'Re ε' : 'n';
    const imagLab = isSigma() ? (grNL ? 'Im' : 'Im σ') : quantity === 'eps' ? 'Im ε' : 'k';
    let h = `<span class="mat-legend-item"><span class="mat-legend-swatch ml-solid"></span>${realLab}</span>`
          + `<span class="mat-legend-item"><span class="mat-legend-swatch ml-dashed"></span>${imagLab}</span>`;
    // single graphene source needs no name chip (we already know it's graphene)
    const showNames = !(isSigma() && src.length === 1);
    if (showNames) for (const s of src) h += `<span class="mat-legend-item"><span class="mat-legend-swatch" style="border-top-color:${s.color}"></span>${s.label}</span>`;
    $('mat-legend').innerHTML = h;
  }

  function render(hoverIdx = -1) {
    $('mat-title').textContent = isSigma()
      ? (grNL ? grProcTitle() : 'Surface conductivity σ(ω,T)')
      : mod === 'tmdc'
        ? (quantity === 'eps' ? 'Dielectric function ε(ω,T)' : 'Refractive index n, k (ω,T)')
        : quantity === 'eps' ? 'Dielectric function ε(ω)' : 'Refractive index n, k';
    compute();
    buildLegend(current!.src);
    rebuildReadout(current!.src);
    paint(hoverIdx);
    paintMap();
    setReadout(hoverIdx >= 0 ? hoverIdx : Math.floor((current?.lam.length ?? 1) / 2));
  }

  // ── hover ──
  canvas.addEventListener('mousemove', (e) => {
    if (!current || !view) return;
    const rect = canvas.getBoundingClientRect();
    const px = e.clientX - rect.left;
    const frac = (px - view.PAD.l) / view.pw;
    if (frac < 0 || frac > 1) return;
    const xval = view.xMin + frac * (view.xMax - view.xMin);
    // nearest sample by x
    let best = 0, bd = Infinity;
    for (let i = 0; i < current.xs.length; i++) { const d = Math.abs(current.xs[i] - xval); if (d < bd) { bd = d; best = i; } }
    paint(best); setReadout(best);
  });
  canvas.addEventListener('mouseleave', () => render(-1));

  // ── module switch ──
  const moduleBtns: Record<Mod, string> = { materials: 'module-materials', drude: 'module-drude', graphene: 'module-graphene', tmdc: 'module-tmdc' };
  let grSeeded = false, tmdcSeeded = false;
  function selectModule(m: Mod) {
    mod = m;
    (Object.keys(moduleBtns) as Mod[]).forEach(k => {
      const b = $(moduleBtns[k]); const on = k === m;
      b.classList.toggle('active', on); b.setAttribute('aria-checked', String(on));
    });
    $('ctrl-materials').hidden = m !== 'materials';
    $('ctrl-drude').hidden = m !== 'drude';
    $('ctrl-graphene').hidden = m !== 'graphene';
    $('ctrl-tmdc').hidden = m !== 'tmdc';
    $('qty-field').hidden = m === 'graphene';            // ε / n,k (materials, Drude, TMDC)
    $('lin-nl-tabs').hidden = m !== 'graphene';           // LIN / NL (graphene)
    refreshUnitSelect();                                  // add/remove the E_F energy unit
    updateGrapheneUI();
    // first time into graphene, widen the range to show the IR Drude peak + 2EF edge
    if (m === 'graphene' && !grSeeded) { grSeeded = true; rangeLoNm = 600; rangeHiNm = 25000; refreshRangeInputs(); }
    if (m === 'tmdc' && !tmdcSeeded) { tmdcSeeded = true; tmdcApplyMaterial(); }
    updateNotes();
    render();
  }

  // Graphene control visibility: linear (model + units + decompose) vs nonlinear (process).
  function updateGrapheneUI() {
    const g = mod === 'graphene';
    $('gr-model-field').hidden = !g || grNL;
    $('gr-process-field').hidden = !g || !grNL;
    const nl = g && !grNL && grModel === 'nonlocal';                 // Q controls + map — nonlocal RPA only
    for (const id of ['gr-qunit-field', 'gr-qmin-field', 'gr-qmax-field', 'gr-q-field', 'gr-map-card']) $(id).hidden = !nl;
    $('gr-unit-field').hidden = !g || grNL;                          // σ₀/esu/a.u./SI — linear only
    $('gr-decompose').hidden = !g || grNL || grModel === 'nonlocal'; // intra/inter — local/Drude only
    // Nonlocal RPA is a T = 0 model — lock the temperature at 0.
    const tEl = $('gr-temp') as HTMLInputElement, tSl = $('gr-temp-slider') as HTMLInputElement;
    const lockT = g && !grNL && grModel === 'nonlocal';
    if (lockT && !tEl.disabled) { grTempSaved = tEl.value; tEl.value = '0'; tSl.value = '0'; }
    else if (!lockT && tEl.disabled) { tEl.value = grTempSaved; tSl.value = grTempSaved; }
    tEl.disabled = lockT; tSl.disabled = lockT;
  }

  // Notes box — defines the models for the active module.
  function updateNotes() {
    let html = '';
    if (mod === 'graphene' && grNL) {
      const perProc: Record<string, string> = {
        thg: `<li>σ<sup>(3,3)</sup>(ω) = 3i · v<sub>F</sub><sup>2</sup>/(4π E<sub>F</sub>) · 1 / [(ω+iγ)(2ω+iγ)(3ω+iγ)]</li>`,
        kerr: `<li>σ<sup>(3,1)</sup>(ω) = −3i · v<sub>F</sub><sup>2</sup>/(4π E<sub>F</sub>) · 1 / [(2ω+iγ)(ω<sup>2</sup>+γ<sup>2</sup>)]</li>`,
        mikh: `<li>σ<sup>(3)</sup><sub>xxxx</sub>(ω,ω,ω) = σ<sub>0</sub><sup>(3)</sup> · [ S<sup>(3/0)</sup> + S<sup>(2/1)</sup> + S<sup>(1/2)</sup> + S<sup>(0/3)</sup> ],&nbsp; σ<sub>0</sub><sup>(3)</sup> = v<sub>F</sub><sup>2</sup>/(4π E<sub>F</sub><sup>4</sup>)</li>
        <li>plotted as the dimensionless S<sup>(3)</sup> = σ<sup>(3)</sup>/σ<sub>0</sub><sup>(3)</sup>; the four S<sup>(m/n)</sup> are the intra/inter contributions (Mikhailov Appendix-D integrals).</li>`,
        shg: `<li>σ<sup>(2,2)</sup><sub>n</sub>(ω) = P · f<sub>n</sub>,&nbsp; P = i v<sub>F</sub><sup>2</sup> / [4π (2ω+iγ)(ω+iγ)]</li>
        <li>f<sub>A</sub> = −[3/(ω+iγ) + 4/(2ω+iγ)]</li>
        <li>f<sub>B</sub> = −[−1/(ω+iγ) + 4/(2ω+iγ) − 4/ω]</li>
        <li>f<sub>C</sub> = 1/[2(ω+iγ)] + 2/(2ω+iγ) − 2/ω</li>`,
        or: `<li>σ<sup>(2,0)</sup><sub>n</sub>(ω) = P · g<sub>n</sub>,&nbsp; P = v<sub>F</sub><sup>2</sup>/(4π γ)</li>
        <li>g<sub>A</sub> = 3/(ω−iγ)<sup>2</sup> − 4/(ω<sup>2</sup>+γ<sup>2</sup>)</li>
        <li>g<sub>B</sub> = 1/(ω−iγ)<sup>2</sup> + 4/(ω<sup>2</sup>+γ<sup>2</sup>) − 4/[ω(ω+iγ)]</li>
        <li>g<sub>C</sub> = 2iγ/(−ω+iγ)</li>
        <li>g<sub>D</sub> = 1/(ω+iγ)<sup>2</sup> + 4/[ω(ω+iγ)]</li>`,
      };
      html = `<h4>Graphene nonlinear conductivity — ${grProcTitle()}</h4><ul>${perProc[grProcess]}</ul>`;
    } else if (mod === 'graphene') {
      html = `<h4>Graphene surface conductivity</h4><ul>
        <li><b>σ(ω) = σ<sub>intra</sub> + σ<sub>inter</sub></b> — the total is the sum of the intraband (Drude) and interband terms; toggle <b>intra/inter</b> above the plot to see each.</li>
        <li><b>Drude</b> — intraband free-carrier response, σ = iE<sub>F</sub>/[π(ω+iγ)] (T=0, ℏω ≪ 2E<sub>F</sub>).</li>
        <li><b>Local RPA</b> — adds the interband Kubo term with the Pauli-blocking step at <b>ℏω = 2E<sub>F</sub></b>; Re σ → σ<sub>0</sub> above the edge.</li>
        <li><b>Nonlocal RPA</b> — Mermin-corrected σ(Q,ω) retaining the finite in-plane wavevector Q (Landau damping, plasmon dispersion); reduces to Local RPA as Q → 0.</li>
        <li><b>Finite T</b> (T &gt; 0) — thermal chemical potential μ(E<sub>F</sub>,T) smears the intraband weight and the 2E<sub>F</sub> edge.</li>
        <li><b>Damping ⇄ mobility</b> — γ, lifetime τ = ℏ/γ and DC mobility are linked by <b>τ = μ<sup>DC</sup>E<sub>F</sub>/(e v<sub>F</sub><sup>2</sup>)</b> (so γ = ℏ e v<sub>F</sub><sup>2</sup>/(μ<sup>DC</sup>E<sub>F</sub>)), with v<sub>F</sub> ≈ 10<sup>8</sup> cm/s.</li>
        <li>σ<sub>0</sub> = e²/4ℏ ≈ 6.085×10⁻⁵ S (universal optical conductivity) = 1/4 a.u.</li>
      </ul>`;
    } else if (mod === 'drude') {
      html = `<h4>Drude model</h4><ul>
        <li>ε(ω) = ε<sub>∞</sub> − ω<sub>p</sub><sup>2</sup>/[ω(ω+iγ)] — free-electron metal with background ε<sub>∞</sub>, plasma frequency ω<sub>p</sub>, and damping γ = ℏτ<sup>-1</sup>.</li>
        <li>Presets Au/Ag/Al/Cu are Drude fits (a single Lorentzian-free term); accurate in the IR, approximate near interband transitions.</li>
      </ul>`;
    } else if (mod === 'tmdc') {
      const td = TMDC[tmdcMat];
      html = `<h4>TMDC dielectric function — ${TMDC_LABEL[tmdcMat]}</h4><ul>
        <li>Temperature-dependent ε(E,T) from the <b>Dielectric Function Parametric Model</b> (DFPM / PSEMI): each critical point is a polynomial-spline joint density of states broadened by a Kramers–Kronig-consistent Gaussian; ε = (n + ik)².</li>
        <li>Every parameter follows the cubic law f(T) = a + b·x + c·x² + d·x³, with x = T/1000 (T in K).</li>
        <li><b>Validity window:</b> energy <b>${td.Erange[0]}–${td.Erange[1]} eV</b>, temperature <b>${td.Trange[0]}–${td.Trange[1]} K</b>. Outside these ranges the cubic laws and splines extrapolate and are <b>not physically supported</b> (the curve is clamped to the energy window here).</li>
        <li>In-plane (ordinary) response only — not the out-of-plane component.</li>
        ${tmdcMat === 'MoS2'
          ? '<li>MoS₂ is the validated reference; CP energies, widths and temperature trends are exact, but the sharpest excitonic ε₂ peaks are slightly over-estimated (an open PSEMI-normalization issue).</li>'
          : '<li>CP energies, widths and amplitudes reproduce the source paper exactly; the per-CP line-shape (M-type) is assigned by analogy with MoS₂, so absolute ε₂ line shapes are indicative.</li>'}
      </ul>`;
    } else {
      html = `<h4>Tabulated optical constants</h4><ul>
        <li>ε = (n + ik)². Tabulated n(λ), k(λ) are <b>linearly</b> interpolated in wavelength.</li>
        <li>Built-in tables, an uploaded file, or a refractiveindex.info database entry. Values are clamped to each material's measured range (no extrapolation).</li>
        <li>Compare two materials with “+ Add material”: solid = real part, dashed = imaginary part, one colour per material.</li>
      </ul>`;
    }
    $('mat-notes').innerHTML = html;
    updateRefs();
  }

  // References box — papers behind the active module (citations live here, not in the notes).
  function updateRefs() {
    let refs: string[];
    if (mod === 'graphene') {
      refs = [
        `J. D. Cox, R. Yu &amp; F. J. Garc&iacute;a de Abajo, second- and third-order nonlinear conductivity of graphene, Phys. Rev. B <strong>96</strong>, 045442 (2017), <a href="https://doi.org/10.1103/PhysRevB.96.045442" target="_blank" rel="noopener">doi:10.1103/PhysRevB.96.045442</a>.`,
        `S. A. Mikhailov, <em>Quantum theory of the third-order nonlinear electrodynamic effects of graphene</em>, Phys. Rev. B <strong>93</strong>, 085403 (2016), <a href="https://doi.org/10.1103/PhysRevB.93.085403" target="_blank" rel="noopener">doi:10.1103/PhysRevB.93.085403</a>.`,
        `F. H. L. Koppens, D. E. Chang &amp; F. J. Garc&iacute;a de Abajo, <em>Graphene plasmonics: a platform for strong light&ndash;matter interactions</em>, Nano Lett. <strong>11</strong>, 3370 (2011), <a href="https://doi.org/10.1021/nl201771h" target="_blank" rel="noopener">doi:10.1021/nl201771h</a>.`,
      ];
    } else if (mod === 'tmdc') {
      const matRef: Record<string, string> = {
        MoS2: `V. L. Le, T. J. Kim, H. G. Park, H. T. Nguyen, X. A. Nguyen &amp; Y. D. Kim, <em>Temperature dependence of the dielectric function of monolayer MoS₂</em>, Curr. Appl. Phys. <strong>19</strong> (2019) 182, <a href="https://doi.org/10.1016/j.cap.2018.10.007" target="_blank" rel="noopener">doi:10.1016/j.cap.2018.10.007</a>.`,
        MoSe2: `Le / Kim group, <em>Temperature dependence of the dielectric function of monolayer MoSe₂</em> (Dielectric Function Parametric Model).`,
        WS2: `T. J. Kim et al., <em>Modeling of the optical properties of monolayer WS₂</em>, J. Korean Phys. Soc. <strong>77</strong> (2020) 298.`,
      };
      refs = [
        matRef[tmdcMat],
        `B. Johs, C. M. Herzinger, J. H. Dinan, A. Cornfeld &amp; J. D. Benson, <em>Development of a parametric optical constant model</em>, Thin Solid Films <strong>313–314</strong> (1998) 137 (PSEMI / DFPM oscillator).`,
      ];
    } else if (mod === 'drude') {
      refs = [];   // no reference box for the Drude module
    } else {
      refs = [
        `Optical constants from <a href="https://refractiveindex.info" target="_blank" rel="noopener">refractiveindex.info</a>. Built-ins &mdash; Au, Ag, Cu: Johnson &amp; Christy (1972); Si: Aspnes &amp; Studna (1983); Al: Raki&cacute; (1998); TiO<sub>2</sub>: Sarkar et al. (2019).`,
      ];
    }
    $('mat-refs').hidden = refs.length === 0;
    $('mat-refs').innerHTML = refs.length === 0 ? '' : `<h4>References</h4><ul class="reference-list">`
      + refs.map((r, i) => `<li><span class="ref-index">[${i + 1}]</span><span>${r}</span></li>`).join('') + `</ul>`;
  }
  $('module-materials').addEventListener('click', () => selectModule('materials'));
  $('module-drude').addEventListener('click', () => selectModule('drude'));
  $('module-graphene').addEventListener('click', () => selectModule('graphene'));
  $('module-tmdc').addEventListener('click', () => selectModule('tmdc'));

  // ── TMDC controls ──
  const tmdcMatSel = $('tmdc-mat') as HTMLSelectElement;
  const tmdcTempEl = $('tmdc-temp') as HTMLInputElement, tmdcTempSlider = $('tmdc-temp-slider') as HTMLInputElement;
  let tmdcRaf = false;
  const tmdcRender = () => { if (tmdcRaf) return; tmdcRaf = true; requestAnimationFrame(() => { tmdcRaf = false; render(); }); };  // coalesce to one render per frame (live, no debounce lag)
  function tmdcApplyMaterial() {
    const [Tlo, Thi] = TMDC[tmdcMat].Trange, [Elo, Ehi] = TMDC[tmdcMat].Erange;
    tmdcTempSlider.min = String(Tlo); tmdcTempSlider.max = String(Thi);
    let T = parseFloat(tmdcTempEl.value);
    if (!Number.isFinite(T) || T < Tlo || T > Thi) { T = Math.min(Math.max(300, Tlo), Thi); tmdcTempEl.value = String(T); }
    tmdcTempSlider.value = String(T);
    rangeLoNm = HC / Ehi; rangeHiNm = HC / Elo; refreshRangeInputs();   // window = material's valid energy range
    tmdcCache = null;
  }
  tmdcMatSel.addEventListener('change', () => { tmdcMat = tmdcMatSel.value; tmdcApplyMaterial(); updateNotes(); render(); });
  tmdcTempEl.addEventListener('input', () => { const v = parseFloat(tmdcTempEl.value); if (Number.isFinite(v)) tmdcTempSlider.value = String(v); tmdcRender(); });
  tmdcTempSlider.addEventListener('input', () => { tmdcTempEl.value = tmdcTempSlider.value; tmdcRender(); });

  // ── segmented toggles ──
  function wireSeg(groupId: string, apply: (val: string) => void) {
    const group = $(groupId);
    group.querySelectorAll<HTMLButtonElement>('.seg-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        group.querySelectorAll('.seg-btn').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-checked', 'false'); });
        btn.classList.add('active'); btn.setAttribute('aria-checked', 'true');
        apply(btn.dataset.qty ?? btn.dataset.axis ?? btn.dataset.grmodel ?? btn.dataset.grunit ?? btn.dataset.linnl ?? btn.dataset.grproc ?? btn.dataset.grqunit ?? '');
        render();
      });
    });
  }
  wireSeg('qty-tabs', v => { quantity = v as Quantity; });
  // Switching the X axis converts the range inputs to the new axis/unit.
  wireSeg('axis-tabs', v => { axis = v as Axis; refreshUnitSelect(); refreshRangeInputs(); });

  unitSel.addEventListener('change', () => {
    if (axis === 'wavelength') waveUnit = unitSel.value as 'nm' | 'um';
    else energyUnit = unitSel.value as 'eV' | 'meV' | 'THz' | 'EF';
    refreshRangeInputs();
    render();
  });

  // ── inputs ──
  function refreshMatRef() {
    if (mod !== 'materials') { $('mat-ref').textContent = ''; return; }
    const slots = mat2On ? [slot1, slot2] : [slot1];
    const refs = slots.map(s => s.resolve()).filter(Boolean).map(r => `${r!.label} — ${r!.ref}`);
    $('mat-ref').textContent = refs.join('  ·  ');
  }

  // ── add / remove a second material ──
  function setMat2(on: boolean) {
    mat2On = on;
    $('mat2-row').hidden = !on;
    $('mat2-rii').hidden = !on || mat2Select.value !== 'rii';
    $('mat2-file').hidden = !on || mat2Select.value !== 'file';
    $('mat-add').hidden = on;
    $('mat1-label').textContent = on ? 'Material 1' : 'Material';
    refreshMatRef();
    render();
  }
  $('mat-add').addEventListener('click', () => {
    if (mat2Select.value === matSelect.value) {
      const alt = Object.keys(MATERIALS).find(k => k !== matSelect.value);
      if (alt) mat2Select.value = alt;
    }
    setMat2(true);
  });
  $('mat2-remove').addEventListener('click', () => setMat2(false));

  [rminEl, rmaxEl].forEach(el => el.addEventListener('input', () => { readRangeInputs(); render(); }));

  // ── Drude γ [eV] ⇄ τ [fs] (γ = ħ/τ, with ħ = 0.658212 eV·fs) ──
  const HBAR_EV_FS = 0.6582119569;
  const trim = (v: number, dp: number) => { let s = v.toFixed(dp); if (s.indexOf('.') >= 0) s = s.replace(/\.?0+$/, ''); return s; };
  const gammaEl = $('drude-gamma') as HTMLInputElement;
  const tauEl = $('drude-tau') as HTMLInputElement;
  function syncTauFromGamma() { const g = parseFloat(gammaEl.value); if (Number.isFinite(g) && g > 0) tauEl.value = trim(HBAR_EV_FS / g, 2); }
  function syncGammaFromTau() { const t = parseFloat(tauEl.value); if (Number.isFinite(t) && t > 0) gammaEl.value = trim(HBAR_EV_FS / t, 4); }

  ['drude-epsb', 'drude-wp'].forEach(id => $(id).addEventListener('input', () => render()));
  gammaEl.addEventListener('input', () => { syncTauFromGamma(); render(); });
  tauEl.addEventListener('input', () => { syncGammaFromTau(); render(); });

  document.querySelectorAll<HTMLButtonElement>('.drude-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      ($('drude-epsb') as HTMLInputElement).value = btn.dataset.epsb!;
      ($('drude-wp') as HTMLInputElement).value = btn.dataset.wp!;
      gammaEl.value = btn.dataset.gamma!;
      syncTauFromGamma();
      render();
    });
  });

  // ── Graphene controls ──
  const grEfEl = $('gr-ef') as HTMLInputElement;
  const grEfSlider = $('gr-ef-slider') as HTMLInputElement;
  const grGammaEl = $('gr-gamma') as HTMLInputElement;
  const grTauEl = $('gr-tau') as HTMLInputElement;
  const grMobEl = $('gr-mobility') as HTMLInputElement;
  const VF_MS = 1.0e6;                                   // graphene Fermi velocity ≈ 1e8 cm/s
  const HBAR_EVS = 6.582119569e-16;                      // ħ in eV·s
  // mobility ⇄ γ via τ = μ_DC·E_F/(e·v_F²)  (so γ = ħ/τ); γ is the source of truth
  function grGammaFromMob(muCm: number, EF: number): number { const tau = (muCm * 1e-4) * EF / (VF_MS * VF_MS); return HBAR_EVS / tau; }
  function grMobFromGamma(gam: number, EF: number): number { const tau = HBAR_EVS / gam; return tau * VF_MS * VF_MS / EF * 1e4; }
  function grRefreshTauMob() {
    const g = parseFloat(grGammaEl.value), EF = num('gr-ef', 0.4);
    if (Number.isFinite(g) && g > 0) { grTauEl.value = trim(HBAR_EV_FS / g, 1); if (EF > 0) grMobEl.value = trim(grMobFromGamma(g, EF), 0); }
  }
  grEfEl.addEventListener('input', () => { const v = parseFloat(grEfEl.value); if (Number.isFinite(v)) grEfSlider.value = String(v); grRefreshTauMob(); if (energyUnit === 'EF') refreshRangeInputs(); render(); });
  grEfSlider.addEventListener('input', () => { grEfEl.value = grEfSlider.value; grRefreshTauMob(); if (energyUnit === 'EF') refreshRangeInputs(); render(); });
  const grTempEl = $('gr-temp') as HTMLInputElement, grTempSlider = $('gr-temp-slider') as HTMLInputElement;
  grTempEl.addEventListener('input', () => { const v = parseFloat(grTempEl.value); if (Number.isFinite(v)) grTempSlider.value = String(v); render(); });
  grTempSlider.addEventListener('input', () => { grTempEl.value = grTempSlider.value; render(); });
  const grQEl = $('gr-q') as HTMLInputElement, grQSlider = $('gr-q-slider') as HTMLInputElement;
  const grQminEl = $('gr-qmin') as HTMLInputElement, grQmaxEl = $('gr-qmax') as HTMLInputElement;
  // Keep the cut slider bounded by [Q min, Q max] and clamp the cut into range.
  function syncQSlider() {
    const lo = parseFloat(grQminEl.value), hi = parseFloat(grQmaxEl.value);
    if (!Number.isFinite(lo) || !Number.isFinite(hi) || hi <= lo) return;
    grQSlider.min = String(lo); grQSlider.max = String(hi); grQSlider.step = String((hi - lo) / 100);
    let cut = parseFloat(grQEl.value);
    if (!Number.isFinite(cut) || cut < lo || cut > hi) { cut = (lo + hi) / 2; grQEl.value = trim(cut, 3); }
    grQSlider.value = String(cut);
  }
  grQEl.addEventListener('input', () => { const v = parseFloat(grQEl.value); if (Number.isFinite(v)) grQSlider.value = String(v); render(); });
  grQSlider.addEventListener('input', () => { grQEl.value = grQSlider.value; render(); });
  grQminEl.addEventListener('input', () => { syncQSlider(); render(); });
  grQmaxEl.addEventListener('input', () => { syncQSlider(); render(); });
  wireSeg('gr-qunit-tabs', v => {
    const next = v as 'nm' | 'kf'; if (next === grQUnit) return;
    const old = grQUnit; const kf = kFnm();
    const conv = (d: number) => { const nm = old === 'kf' ? d * kf : d; return next === 'kf' ? nm / kf : nm; };
    grQUnit = next;
    for (const el of [grQminEl, grQmaxEl, grQEl]) { const d = parseFloat(el.value); if (Number.isFinite(d)) el.value = trim(conv(d), 3); }
    syncQSlider();
  });
  grGammaEl.addEventListener('input', () => { grRefreshTauMob(); render(); });
  grTauEl.addEventListener('input', () => { const t = parseFloat(grTauEl.value); if (Number.isFinite(t) && t > 0) { grGammaEl.value = trim(HBAR_EV_FS / t, 5); grRefreshTauMob(); } render(); });
  grMobEl.addEventListener('input', () => { const mu = parseFloat(grMobEl.value), EF = num('gr-ef', 0.4); if (Number.isFinite(mu) && mu > 0 && EF > 0) { grGammaEl.value = trim(grGammaFromMob(mu, EF), 5); grTauEl.value = trim(HBAR_EV_FS / parseFloat(grGammaEl.value), 1); } render(); });
  wireSeg('gr-model-tabs', v => { grModel = v as 'drude' | 'local' | 'nonlocal'; updateGrapheneUI(); updateNotes(); });
  wireSeg('gr-unit-tabs', v => { grUnit = v; });
  wireSeg('lin-nl-tabs', v => { grNL = v === 'nl'; updateGrapheneUI(); updateNotes(); });
  ($('gr-process') as HTMLSelectElement).addEventListener('change', e => { grProcess = (e.target as HTMLSelectElement).value as typeof grProcess; updateNotes(); render(); });
  $('gr-decompose').addEventListener('click', () => { grDecompose = !grDecompose; ($('gr-decompose') as HTMLButtonElement).setAttribute('aria-pressed', String(grDecompose)); render(); });

  // ── export ──
  $('mat-dl-csv').addEventListener('click', () => {
    if (!current) return;
    const src = current.src;
    const sig = isSigma();
    const head = ['wavelength_nm', 'energy_eV'];
    for (const s of src) {
      const p = s.label.replace(/[^A-Za-z0-9]+/g, '_');
      if (sig) head.push(`${p}_sigma_re_over_sigma0`, `${p}_sigma_im_over_sigma0`);
      else head.push(`${p}_n`, `${p}_k`, `${p}_eps_re`, `${p}_eps_im`);
    }
    const title = sig
      ? `Graphene surface conductivity σ/σ₀ — EF=${num('gr-ef', 0.4)} eV, γ=${num('gr-gamma', 0.0037)} eV, T=${num('gr-temp', 300)} K, model=${grModel}`
      : `Optical constants — ${src.map(s => s.label).join(', ')}`;
    const lines = [`# ${title}`, '# Generated by NanophotonicsLab (nanophotonicslab.com)', head.join(',')];
    for (let i = 0; i < current.lam.length; i++) {
      const lam = current.lam[i]; if (!Number.isFinite(lam)) continue;
      const row = [lam.toFixed(4), (HC / lam).toFixed(5)];
      for (const s of src) { const o = s.nk(lam); if (sig) row.push(o.re.toFixed(6), o.im.toFixed(6)); else row.push(o.n.toFixed(6), o.k.toFixed(6), o.re.toFixed(6), o.im.toFixed(6)); }
      lines.push(row.join(','));
    }
    const stem = mod === 'drude' ? 'drude' : mod === 'graphene' ? 'graphene' : current.src.map(s => s.label.split(/[\s(]/)[0].toLowerCase()).join('_');
    downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), `materials_${stem}.csv`);
  });
  $('mat-dl-png').addEventListener('click', () => {
    const a = document.createElement('a');
    a.download = `materials_${mod === 'drude' ? 'drude' : mod === 'graphene' ? 'graphene' : matSelect.value}.png`;
    a.href = canvas.toDataURL('image/png');
    a.click();
  });

  // ── init ──
  refreshMatRef();
  refreshUnitSelect();
  refreshRangeInputs();
  updateNotes();
  onThemeChange(() => { paint(); paintMap(); });
  window.addEventListener('resize', () => { paint(); paintMap(); });
  render();
</script>
