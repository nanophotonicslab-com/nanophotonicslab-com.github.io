    position: absolute; top: calc(100% + 0.4rem); right: 0; width: min(220px, 70vw); padding: 0.55rem 0.65rem;
    border: 1px solid var(--bg-muted); border-radius: var(--radius-sm); background: var(--bg); color: var(--text-soft);
    box-shadow: var(--shadow-md); font-size: 0.72rem; font-weight: 500; line-height: 1.35; text-align: left;
    pointer-events: none; opacity: 0; transform: translateY(-3px); transition: opacity 0.15s, transform 0.15s; z-index: 100;
  }
  :global(.stat-info:hover .stat-tooltip), :global(.stat-info:focus-visible .stat-tooltip) { opacity: 1; transform: translateY(0); }
