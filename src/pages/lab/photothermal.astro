---
import Layout from '../../layouts/Layout.astro';
import ModelInfo from '../../components/ModelInfo.astro';
import PresetStrip from '../../components/PresetStrip.astro';
import ToolMeta from '../../components/ToolMeta.astro';

const thermalPresets = [
  { label: 'Au NP, green laser', values: { 'material-select': 'au', 'r-num': 50, 'r-slider': 50, 'nh-num': 1.33, 'nh-slider': 1.33, 'lam-num': 532, 'lam-slider': 532, 'pow-num': 1, 'pow-slider': 1, 'w0-num': 1, 'w0-slider': 1, 'k-num': 0.606 } },
  { label: 'Au NP, NIR laser', values: { 'material-select': 'au', 'r-num': 25, 'r-slider': 25, 'nh-num': 1.33, 'nh-slider': 1.33, 'lam-num': 780, 'lam-slider': 780, 'pow-num': 10, 'pow-slider': 10, 'w0-num': 2, 'w0-slider': 2, 'k-num': 0.606 } },
  { label: 'Ag NP, blue laser, air', values: { 'material-select': 'ag', 'r-num': 40, 'r-slider': 40, 'nh-num': 1.00, 'nh-slider': 1.00, 'lam-num': 405, 'lam-slider': 405, 'pow-num': 5, 'pow-slider': 5, 'w0-num': 0.5, 'w0-slider': 0.5, 'k-num': 0.026 } },
];
---

<Layout title="Photothermal Calculator" description="Laser-driven nanoparticle heating: absorbed power, scattering albedo, and steady-state temperature rise from Mie theory.">
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Photothermal <span class="gradient-text">Calculator</span></h1>
      <p class="widget-hero__subtitle">
        Given a metallic nanoparticle, a host medium, and a focused CW laser,
        compute the power budget (absorption vs scattering) and the steady-state
        temperature rise at the particle surface. Physics: exact Mie theory.
      </p>
      <ToolMeta slug="photothermal" name="Photothermal Calculator" />
    </div>
  </section>

  <ModelInfo status="Beta">
    <dl>
      <dt>Model</dt>
      <dd>Exact Mie theory for absorption and scattering cross-sections, combined with the steady-state heat equation for a point source in a homogeneous medium: &Delta;T(R) = P<sub>abs</sub> / (4&pi;&kappa;R).</dd>
      <dt>Assumptions</dt>
      <dd>CW (continuous-wave) illumination, Gaussian beam profile (peak irradiance I = 2P/&pi;w<sub>0</sub>&sup2;), uniform and infinite host medium, temperature-independent thermal conductivity.</dd>
      <dt>Validity</dt>
      <dd>Accurate for single isolated nanoparticles in a uniform medium with moderate temperature rises (linear thermal regime).</dd>
      <dt>Limitations</dt>
      <dd>No collective heating, no substrate, no pulsed illumination, no temperature-dependent material properties. The point-source thermal model breaks down very close to the particle surface.</dd>
      <dt>References</dt>
      <dd>G. Baffou &amp; R. Quidant, Laser Photonics Rev. <strong>7</strong>, 171 (2013); Bohren &amp; Huffman (1983).</dd>
    </dl>
  </ModelInfo>

  <section class="section">
    <div class="container">
      <div class="widget-layout">
        <!-- ===== Controls ===== -->
        <div class="controls card">
          <h3>Parameters</h3>

          <div class="param">
            <div class="param-header"><label>Material</label></div>
            <select id="material-select" class="param-select">
              <option value="au" selected>Gold (Au)</option>
              <option value="ag">Silver (Ag)</option>
              <option value="al">Aluminum (Al)</option>
              <option value="si">Silicon (Si)</option>
              <option value="tio2">Titanium dioxide (TiO2)</option>
              <option value="custom">Custom dielectric</option>
              <option value="file">Upload file&hellip;</option>
              <option value="rii">Search database&hellip;</option>
            </select>
            <span class="material-ref" id="material-ref"></span>
            <div class="file-upload-row" id="file-upload-group" style="display:none">
              <input type="file" id="file-upload" accept=".csv,.tsv,.txt,.dat" class="file-input">
              <span class="file-name" id="file-name"></span>
            </div>
            <div class="rii-search" id="rii-search-group" style="display:none">
              <input type="text" id="rii-search" class="param-number rii-input" placeholder="Search materials&hellip;">
              <div class="rii-results" id="rii-results"></div>
              <span class="material-ref" id="rii-status"></span>
            </div>
          </div>

          <div class="param hidden" id="eps-group">
            <div class="param-header">
              <label>&epsilon;<sub>r</sub></label>
              <input type="number" class="param-number" id="eps-num" value="10" step="0.5" min="1">
            </div>
          </div>

          <div class="param">
            <div class="param-header">
              <label>Radius (nm)</label>
              <input type="number" class="param-number" id="r-num" value="50" step="5" min="1" max="200">
            </div>
            <input type="range" class="param-slider" id="r-slider" aria-label="Radius (nm)" min="5" max="200" step="1" value="50">
          </div>

          <div class="param">
            <div class="param-header">
              <label>n<sub>host</sub></label>
              <input type="number" class="param-number" id="nh-num" value="1.33" step="0.01" min="1">
            </div>
            <input type="range" class="param-slider" id="nh-slider" aria-label="Host refractive index" min="1.0" max="2.0" step="0.01" value="1.33">
            <div class="param-presets" id="nh-presets">
              <button class="preset-btn" data-val="1.00">Air</button>
              <button class="preset-btn active" data-val="1.33">Water</button>
              <button class="preset-btn" data-val="1.46">Oil</button>
              <button class="preset-btn" data-val="1.50">Glass</button>
            </div>
          </div>

          <div class="param">
            <div class="param-header">
              <label>&lambda; (nm)</label>
              <input type="number" class="param-number" id="lam-num" value="532" step="1" min="300" max="1200">
            </div>
            <input type="range" class="param-slider" id="lam-slider" aria-label="Wavelength λ (nm)" min="300" max="1200" step="1" value="532">
            <div class="param-presets" id="lam-presets">
              <button class="preset-btn" data-val="405">405</button>
              <button class="preset-btn active" data-val="532">532</button>
              <button class="preset-btn" data-val="633">633</button>
              <button class="preset-btn" data-val="780">780</button>
              <button class="preset-btn" data-val="1064">1064</button>
            </div>
          </div>

          <div class="param">
            <div class="param-header">
              <label>P<sub>laser</sub> (mW)</label>
              <input type="number" class="param-number" id="pow-num" value="1" step="0.1" min="0">
            </div>
            <input type="range" class="param-slider" id="pow-slider" aria-label="Laser power (mW)" min="0" max="100" step="0.1" value="1">
          </div>

          <div class="param">
            <div class="param-header">
              <label>1/e field waist w<sub>0</sub> (&mu;m)</label>
              <input type="number" class="param-number" id="w0-num" value="1" step="0.1" min="0.1">
            </div>
            <input type="range" class="param-slider" id="w0-slider" aria-label="1/e field waist w0 (µm)" min="0.1" max="50" step="0.1" value="1">
          </div>

          <div class="param">
            <div class="param-header">
              <label>&kappa; (W/m&middot;K)</label>
              <input type="number" class="param-number" id="k-num" value="0.606" step="0.01" min="0.001">
            </div>
            <div class="param-presets" id="k-presets">
              <button class="preset-btn active" data-val="0.606">Water</button>
              <button class="preset-btn" data-val="0.026">Air</button>
              <button class="preset-btn" data-val="0.17">Oil</button>
              <button class="preset-btn" data-val="1.0">Glass</button>
            </div>
          </div>

        </div>

        <!-- ===== Chart ===== -->
        <div class="chart-panel card">
          <div class="chart-header">
            <span class="chart-title">Cross-sections vs wavelength</span>
            <div class="chart-legend">
              <span class="legend-item"><span class="legend-swatch" style="background:#EF4444"></span>&sigma;<sub>abs</sub></span>
              <span class="legend-item"><span class="legend-swatch" style="background:#3B82F6"></span>&sigma;<sub>sca</sub></span>
              <span class="legend-item"><span class="legend-swatch" style="background:#F43F5E"></span>laser &lambda;</span>
            </div>
            <div class="toolbar-actions">
              <button id="dl-png" class="tool-btn" title="Download spectrum as PNG" data-umami-event="photothermal-export" data-umami-event-format="png">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                PNG
              </button>
              <button id="dl-csv" class="tool-btn" title="Download cross-sections as CSV" data-umami-event="photothermal-export" data-umami-event-format="csv">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                CSV
              </button>
              <button id="share-btn" class="tool-btn" title="Copy shareable link" data-umami-event="share" data-umami-event-page="photothermal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                Share
              </button>
            </div>
          </div>
          <div class="chart-wrap" id="chart-wrap">
            <canvas id="mie-chart" aria-label="Absorption and scattering cross-section spectra"></canvas>
          </div>
          <div class="color-swatches" id="color-swatches">
            <span class="swatch-label">Apparent color</span>
            <div class="swatch-item">
              <div class="swatch-box" id="swatch-sca"></div>
              <span class="swatch-name">scattered</span>
            </div>
            <div class="swatch-item">
              <div class="swatch-box" id="swatch-trans"></div>
              <span class="swatch-name">transmitted</span>
            </div>
          </div>
        </div>

        <!-- ===== Output panel ===== -->
        <div class="output-card card">
          <div class="stats">
            <div class="stat">
              <div class="stat-head">
                <span class="stat-label">&sigma;<sub>abs</sub></span>
                <button class="stat-info" type="button" aria-label="Absorption cross-section info">i<span class="stat-tooltip" role="tooltip">Effective area for converting incident optical power into heat inside the particle at the selected laser wavelength.</span></button>
              </div>
              <span class="stat-value" id="out-cabs">&mdash;</span>
              <span class="stat-unit">nm&sup2;</span>
            </div>
            <div class="stat">
              <div class="stat-head">
                <span class="stat-label">&sigma;<sub>sca</sub></span>
                <button class="stat-info" type="button" aria-label="Scattering cross-section info">i<span class="stat-tooltip" role="tooltip">Effective area for redirecting light away from the incident beam. This contributes to optical loss but not directly to local heating.</span></button>
              </div>
              <span class="stat-value" id="out-csca">&mdash;</span>
              <span class="stat-unit">nm&sup2;</span>
            </div>
            <div class="stat">
              <div class="stat-head">
                <span class="stat-label">&sigma;<sub>ext</sub></span>
                <button class="stat-info" type="button" aria-label="Extinction cross-section info">i<span class="stat-tooltip" role="tooltip">Total optical removal from the incident beam: absorption plus scattering, &sigma;ext = &sigma;abs + &sigma;sca.</span></button>
              </div>
              <span class="stat-value" id="out-cext">&mdash;</span>
              <span class="stat-unit">nm&sup2;</span>
            </div>
            <div class="stat">
              <div class="stat-head">
                <span class="stat-label">Albedo</span>
                <button class="stat-info" type="button" aria-label="Albedo info">i<span class="stat-tooltip" role="tooltip">Scattering fraction of extinction, &sigma;sca / &sigma;ext. Values near 0 are mostly absorptive; values near 1 are mostly scattering.</span></button>
              </div>
              <span class="stat-value" id="out-albedo">&mdash;</span>
              <span class="stat-unit"></span>
            </div>
          </div>

          <div class="budget">
            <div class="budget-header">
              <span class="budget-label">Power at particle</span>
              <span class="budget-i" id="out-i">&mdash;</span>
            </div>
            <div class="budget-bar">
              <div class="budget-abs" id="budget-abs"></div>
              <div class="budget-sca" id="budget-sca"></div>
            </div>
            <div class="budget-rows">
              <div class="budget-row">
                <span class="budget-dot" style="background:#EF4444"></span>
                <span class="budget-name">absorbed</span>
                <span class="budget-value" id="out-pabs">&mdash;</span>
              </div>
              <div class="budget-row">
                <span class="budget-dot" style="background:#3B82F6"></span>
                <span class="budget-name">scattered</span>
                <span class="budget-value" id="out-psca">&mdash;</span>
              </div>
            </div>
          </div>

          <div class="delta-t">
            <button type="button" class="delta-t-trigger" id="profile-open" aria-haspopup="dialog" aria-controls="profile-dialog">
              <span class="delta-t-label">&Delta;T at surface</span>
              <span class="delta-t-value"><span id="out-dt">&mdash;</span><span class="delta-t-unit">K</span></span>
            </button>
            <div class="profile-wrap" id="profile-wrap" role="button" tabindex="0" aria-label="Open enlarged radial temperature profile">
              <canvas id="profile-chart" aria-label="Radial temperature profile T(r)"></canvas>
            </div>
            <span class="profile-label">
              T(r) &minus; T<sub>&infin;</sub> vs. r / R &ensp;&middot;&ensp;
              dots mark 1/e (r = e&middot;R) and 1/e&sup2; (r = e&sup2;&middot;R)
            </span>
          </div>
        </div>

        <!-- ===== Notes ===== -->
        <div class="notes-card card" id="notes-card">
          <h4>Notes</h4>
          <p class="theory-note">
            <strong>Model.</strong>
            I&nbsp;=&nbsp;2P/(&pi;w<sub>0</sub>&sup2;) (Gaussian peak).
            P<sub>abs</sub>&nbsp;=&nbsp;&sigma;<sub>abs</sub>&middot;I.
            &Delta;T&nbsp;=&nbsp;P<sub>abs</sub>/(4&pi;&kappa;R) at the surface;
            T(r)&nbsp;&minus;&nbsp;T<sub>&infin;</sub>&nbsp;=&nbsp;P<sub>abs</sub>/(4&pi;&kappa;r) for r&nbsp;&ge;&nbsp;R.
            &sigma;<sub>abs</sub> from exact Mie theory.
          </p>
          <PresetStrip presets={thermalPresets} showCopy={false} />
        </div>
      </div>

      <dialog class="profile-dialog" id="profile-dialog" aria-labelledby="profile-dialog-title">
        <div class="profile-dialog__panel">
          <div class="profile-dialog__header">
            <div>
              <h3 id="profile-dialog-title">Radial Temperature Profile</h3>
              <p><span id="profile-dialog-dt">&mdash;</span> K at the particle surface</p>
            </div>
            <div class="profile-dialog__actions">
              <button type="button" class="chart-tool-btn" id="profile-export-png">Export PNG</button>
              <button type="button" class="chart-tool-btn" id="profile-export-csv">Export CSV</button>
              <button type="button" class="profile-dialog__close" id="profile-dialog-close" aria-label="Close temperature profile">&times;</button>
            </div>
          </div>
          <div class="profile-dialog__chart">
            <canvas id="profile-chart-large" aria-label="Large radial temperature profile"></canvas>
            <div class="profile-chart-tooltip" id="profile-chart-tooltip" role="status" aria-live="polite"></div>
          </div>
          <p class="profile-dialog__note">
            Steady-state point-source approximation outside the particle: &Delta;T(r) = &Delta;T(R)&middot;R/r for r&nbsp;&ge;&nbsp;R.
          </p>
        </div>
      </dialog>

      <dialog class="material-import-dialog" id="material-import-dialog" aria-labelledby="material-import-title">
        <div class="material-import-dialog__panel">
          <div class="material-import-dialog__header">
            <div>
              <h3 id="material-import-title">Confirm Material Import</h3>
              <p id="material-import-file">No file selected</p>
            </div>
            <button type="button" class="profile-dialog__close" id="material-import-close" aria-label="Cancel material import">&times;</button>
          </div>
          <div class="material-import-dialog__grid">
            <label>
              <span>First column</span>
              <select id="material-import-axis" class="param-select">
                <option value="energy-ev">Photon energy (eV)</option>
                <option value="wavelength-nm">Wavelength (nm)</option>
                <option value="wavelength-um">Wavelength (&micro;m)</option>
              </select>
            </label>
            <label>
              <span>Columns 2 and 3</span>
              <select id="material-import-values" class="param-select">
                <option value="epsilon">Re &epsilon;, Im &epsilon;</option>
                <option value="nk">n, k</option>
              </select>
            </label>
          </div>
          <div class="material-import-dialog__preview">
            <canvas id="material-import-preview" aria-label="Material preview"></canvas>
          </div>
          <div class="material-import-dialog__table-wrap">
            <table class="material-import-dialog__table">
              <thead>
                <tr><th>Column 1</th><th>Column 2</th><th>Column 3</th></tr>
              </thead>
              <tbody id="material-import-rows"></tbody>
            </table>
          </div>
          <p class="material-import-dialog__status" id="material-import-status"></p>
          <div class="material-import-dialog__actions">
            <button type="button" class="chart-tool-btn" id="material-import-cancel">Cancel</button>
            <button type="button" class="chart-tool-btn active" id="material-import-accept">Use material</button>
          </div>
        </div>
      </dialog>

      <div class="references card">
        <h4>References</h4>
        <ul class="reference-list">
          <li><span class="ref-index">[1]</span><span>G. Baffou &amp; R. Quidant, <em>Thermo-plasmonics: using metallic nanostructures as nano-sources of heat</em>, Laser &amp; Photonics Reviews <strong>7</strong>, 171 (2013).</span></li>
          <li><span class="ref-index">[2]</span><span>C. F. Bohren &amp; D. R. Huffman, <em>Absorption and Scattering of Light by Small Particles</em> (Wiley, 1983).</span></li>
          <li><span class="ref-index">[3]</span><span>Optical constants: <a href="https://refractiveindex.info" target="_blank" rel="noopener">refractiveindex.info</a> &mdash; Au/Ag: Johnson &amp; Christy (1972); Al: Raki&cacute; (1995); Si: Aspnes &amp; Studna (1983).</span></li>
        </ul>
      </div>
    </div>
  </section>
<script>
import { initPermalinks } from '../../lib/permalink';
initPermalinks({
  material: 'material-select',
  r: 'r-num',
  nh: 'nh-num',
  lam: 'lam-num',
  pow: 'pow-num',
  w0: 'w0-num',
  k: 'k-num',
});
</script>
</Layout>

<!-- ===== Scoped styles ===== -->
<style>
  .widget-hero { padding: calc(var(--space-3xl) + var(--space-lg)) 0 var(--space-xl); background: var(--bg-soft); }
  .widget-hero h1 { margin-bottom: var(--space-sm); }
  .widget-hero__subtitle { font-size: 1.125rem; max-width: 620px; }
  .gradient-text { background: var(--spectrum); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .back-link { display: inline-block; margin-bottom: var(--space-md); font-size: 0.875rem; font-weight: 500; color: var(--text-soft); }
  .back-link:hover { color: var(--primary); }

  .widget-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: var(--space-lg);
    align-items: start;
  }
  .controls {
    display: flex; flex-direction: column; gap: var(--space-md);
    /* span all right-column rows (chart + output + notes) so the grid places them in col 2;
       not sticky — params scroll together with the results, like the other labs */
    grid-row: 1 / span 3;
  }
  .controls h3 { font-size: 1rem; }

  .param { display: flex; flex-direction: column; gap: 0.4rem; }
  .param-header { display: flex; justify-content: space-between; align-items: center; }
  .param-header label { font-size: 0.875rem; font-weight: 500; color: var(--text); }
  .param-number {
    width: 5rem; padding: 0.2rem 0.4rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm);
    font-family: var(--font); font-size: 0.875rem; font-weight: 600; font-variant-numeric: tabular-nums;
    color: var(--primary); text-align: right; outline: none; background: var(--bg);
  }
  .param-number::-webkit-inner-spin-button,
  .param-number::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .param-number { -moz-appearance: textfield; }
  .param-slider {
    -webkit-appearance: none; appearance: none; width: 100%; height: 6px;
    background: var(--bg-muted); border-radius: 3px; outline: none; cursor: pointer;
  }
  .param-slider::-webkit-slider-thumb {
    -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%;
    background: var(--primary); cursor: pointer; transition: box-shadow 0.15s;
  }
  .param-slider::-webkit-slider-thumb:hover { box-shadow: 0 0 0 5px rgba(99,102,241,0.15); }
  .param-slider::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--primary); border: none; cursor: pointer; }

  .param-select {
    width: 100%; padding: 0.35rem 0.5rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm);
    font-family: var(--font); font-size: 0.8125rem; font-weight: 500; color: var(--text);
    background: var(--bg); outline: none; cursor: pointer;
  }
  .param-select:focus { border-color: var(--primary-light); }
  .hidden { display: none !important; }
  .material-ref { font-size: 0.6875rem; color: var(--text-muted); font-style: italic; }
  .file-upload-row { display: flex; flex-direction: column; gap: 0.25rem; }
  .file-input { font-size: 0.75rem; font-family: var(--font); color: var(--text-soft); }
  .file-input::file-selector-button { padding: 0.2rem 0.5rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-full); background: var(--bg); font-family: var(--font); font-size: 0.6875rem; font-weight: 500; color: var(--text-soft); cursor: pointer; margin-right: 0.4rem; transition: all 0.15s; }
  .file-input::file-selector-button:hover { border-color: var(--primary-light); color: var(--primary); }
  .file-name { font-size: 0.6875rem; color: var(--text-muted); font-style: italic; }
  .file-error { font-size: 0.6875rem; color: var(--rose); }
  .rii-search { display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.25rem; }
  .rii-input { width: 100% !important; text-align: left !important; font-weight: 500 !important; color: var(--text) !important; }
  .rii-results { max-height: 200px; overflow-y: auto; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm); background: var(--bg); }
  .rii-results:empty { display: none; }
  .rii-result { padding: 0.3rem 0.5rem; font-size: 0.75rem; cursor: pointer; line-height: 1.4; border-bottom: 1px solid var(--bg-soft); }
  .rii-result:last-child { border-bottom: none; }
