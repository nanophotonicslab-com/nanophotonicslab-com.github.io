<!-- ===== Script ===== -->
<script>
  import { loadCatalog, fetchMaterialNK, searchCatalog, type RIIMaterial } from '../../data/refractiveindex';
  import { MATERIALS, interpolateNK } from '../../lib/materials';
  import { mieAt } from '../../lib/mie';
  import { spectrumToHex } from '../../lib/colorimetry';
  import { chartTheme, onThemeChange } from '../../lib/chart-theme';

  // ===== State =====

  const state = {
    material: 'au',
    radius: 50,
    nHost: 1.33,
    lambda: 532,
    power_mW: 1,
    w0_um: 1,
    kappa: 0.606,
    eps: 10,
  };

  const LAM_MIN = 300, LAM_MAX = 1200, NPTS = 240;
  const HC_EV_NM = 1239.841984;

  let spectrum: { lambda: Float64Array; csca: Float64Array; cabs: Float64Array; cext: Float64Array } | null = null;
  let uploadedMaterial: number[][] | null = null;
  let uploadedMaterialLabel = '';
  let lastDTSurface = NaN;
  let profileHoverR: number | null = null;

  function parseNKFile(text: string): { data: number[][]; unit: string } | { error: string } {
    const lines = text.split(/\r?\n/).map(l => l.trim()).filter(l => l && !l.startsWith('#') && !l.startsWith('%'));
    if (lines.length < 2) return { error: 'File must have at least 2 data rows' };
    let delim = /\t/;
    if (lines[0].split(delim).length < 3) delim = /,/;
    if (lines[0].split(delim).length < 3) delim = /\s+/;
    let startIdx = 0;
    if (isNaN(parseFloat(lines[0].split(delim)[0]))) startIdx = 1;
    const data: number[][] = [];
    for (let i = startIdx; i < lines.length; i++) {
      const parts = lines[i].split(delim).map(Number);
      if (parts.length < 2 || isNaN(parts[0]) || isNaN(parts[1])) continue;
      data.push([parts[0], parts[1], parts.length >= 3 && !isNaN(parts[2]) ? Math.abs(parts[2]) : 0]);
    }
    if (data.length < 2) return { error: 'Could not parse at least 2 data rows' };
    data.sort((a, b) => a[0] - b[0]);
    const maxLam = data[data.length - 1][0];
    let unit = 'um';
    if (maxLam > 50) {
      unit = 'nm';
      for (const row of data) row[0] /= 1000;
    }
    return { data, unit };
  }

  type ImportAxisMode = 'wavelength-nm' | 'wavelength-um' | 'energy-ev';
  type ImportValueMode = 'nk' | 'epsilon';
  type RawOpticalRow = [number, number, number];
  interface ParsedOpticalFile { rows: RawOpticalRow[]; skipped: number; }
  interface ConvertedOpticalFile { data: number[][]; lambdaMinNm: number; lambdaMaxNm: number; nMin: number; nMax: number; kMin: number; kMax: number; }

  function parseOpticalFile(text: string): ParsedOpticalFile | { error: string } {
    const lines = text.split(/\r?\n/).map(l => l.trim()).filter(l => l && !l.startsWith('#') && !l.startsWith('%'));
    if (lines.length < 2) return { error: 'File must have at least 2 data rows' };
    let delim = /\t/;
    if (lines[0].split(delim).length < 3) delim = /,/;
    if (lines[0].split(delim).length < 3) delim = /\s+/;
    let startIdx = 0;
    if (isNaN(parseFloat(lines[0].split(delim)[0]))) startIdx = 1;

    const rows: RawOpticalRow[] = [];
    let skipped = 0;
    for (let i = startIdx; i < lines.length; i++) {
      const parts = lines[i].split(delim).map(Number);
      if (parts.length < 3 || !Number.isFinite(parts[0]) || !Number.isFinite(parts[1]) || !Number.isFinite(parts[2])) {
        skipped++;
        continue;
      }
      rows.push([parts[0], parts[1], parts[2]]);
    }
    if (rows.length < 2) return { error: 'Could not parse at least 2 data rows with 3 numeric columns' };
    return { rows, skipped };
  }

  function epsilonToNK(epsRe: number, epsIm: number): [number, number] {
    const epsAbs = Math.hypot(epsRe, epsIm);
    const n = Math.sqrt(Math.max(0, (epsAbs + epsRe) / 2));
    const k = Math.sqrt(Math.max(0, (epsAbs - epsRe) / 2));
    return [n, Math.abs(k)];
  }

  function convertOpticalRows(rows: RawOpticalRow[], axisMode: ImportAxisMode, valueMode: ImportValueMode): ConvertedOpticalFile | { error: string } {
    const data: number[][] = [];
    let nMin = Infinity, nMax = -Infinity, kMin = Infinity, kMax = -Infinity;
    for (const [x, a, b] of rows) {
      let lambdaUm: number;
      if (axisMode === 'energy-ev') {
        if (x <= 0) continue;
        lambdaUm = HC_EV_NM / x / 1000;
      } else if (axisMode === 'wavelength-nm') {
        if (x <= 0) continue;
        lambdaUm = x / 1000;
      } else {
        if (x <= 0) continue;
        lambdaUm = x;
      }
      const [n, k] = valueMode === 'epsilon' ? epsilonToNK(a, b) : [a, Math.abs(b)];
      if (!Number.isFinite(lambdaUm) || !Number.isFinite(n) || !Number.isFinite(k) || n < 0) continue;
      data.push([lambdaUm, n, k]);
      nMin = Math.min(nMin, n); nMax = Math.max(nMax, n);
      kMin = Math.min(kMin, k); kMax = Math.max(kMax, k);
    }
    if (data.length < 2) return { error: 'The selected settings do not produce at least 2 valid optical rows' };
    data.sort((a, b) => a[0] - b[0]);
    return {
      data,
      lambdaMinNm: data[0][0] * 1000,
      lambdaMaxNm: data[data.length - 1][0] * 1000,
      nMin, nMax, kMin, kMax,
    };
  }

  function inferImportModes(rows: RawOpticalRow[]): { axis: ImportAxisMode; values: ImportValueMode } {
    const xs = rows.map(r => r[0]).filter(Number.isFinite);
    const ys = rows.flatMap(r => [r[1], r[2]]).filter(Number.isFinite);
    const xMax = Math.max(...xs);
    const yMaxAbs = Math.max(...ys.map(Math.abs));
    const hasNegativeReal = rows.some(r => r[1] < 0);
    const values: ImportValueMode = hasNegativeReal || yMaxAbs > 25 ? 'epsilon' : 'nk';
    let axis: ImportAxisMode = 'wavelength-um';
    if (xMax > 50) axis = 'wavelength-nm';
    else if (values === 'epsilon' || xMax > 8) axis = 'energy-ev';
    return { axis, values };
  }

  function formatCompact(v: number): string {
    if (!Number.isFinite(v)) return '';
    const av = Math.abs(v);
    if (av >= 1000 || (av > 0 && av < 0.01)) return v.toExponential(3);
    return v.toPrecision(5);
  }

  function sampleRows<T>(rows: T[], maxRows: number): T[] {
    if (rows.length <= maxRows) return rows.slice();
    const sampled: T[] = [];
    for (let i = 0; i < maxRows; i++) sampled.push(rows[Math.round(i * (rows.length - 1) / (maxRows - 1))]);
    return sampled;
  }

  function currentMaterialData(): number[][] | null {
    if (state.material === 'custom') return null;
    if (state.material === 'file' || state.material === 'rii') return uploadedMaterial;
    return MATERIALS[state.material]?.data ?? null;
  }

  function currentMaterialRef(): string {
    if (state.material === 'custom') return 'Custom lossless dielectric';
    if (state.material === 'file' || state.material === 'rii') return uploadedMaterialLabel;
    return MATERIALS[state.material]?.ref ?? '';
  }

  function getNK(lambdaNm: number): [number, number] | null {
    if (state.material === 'custom') return [Math.sqrt(Math.max(state.eps, 0)), 0];
    const data = currentMaterialData();
    if (!data) return null;
    return interpolateNK(data, lambdaNm);
  }

  function computeSpectrum() {
    const lambda = new Float64Array(NPTS);
    const csca = new Float64Array(NPTS);
    const cabs = new Float64Array(NPTS);
    const cext = new Float64Array(NPTS);
    for (let i = 0; i < NPTS; i++) {
      const lam = LAM_MIN + (LAM_MAX - LAM_MIN) * i / (NPTS - 1);
      lambda[i] = lam;
      const nk = getNK(lam);
      if (!nk) { csca[i] = 0; cabs[i] = 0; cext[i] = 0; continue; }
      const [n, k] = nk;
      const v = mieAt(n, k, state.nHost, state.radius, lam);
      csca[i] = v.csca; cabs[i] = v.cabs; cext[i] = v.cext;
    }
    spectrum = { lambda, csca, cabs, cext };
  }

  // ===== Formatting =====

  function fmt(v: number, digits = 3): string {
    if (!isFinite(v)) return '—';
    if (v === 0) return '0';
    const a = Math.abs(v);
    if (a < 1e-3 || a >= 1e5) return v.toExponential(digits - 1);
    return parseFloat(v.toPrecision(digits)).toString();
  }

  function fmtPower(watts: number): string {
    if (!isFinite(watts)) return '—';
    const a = Math.abs(watts);
    if (a >= 1e-3) return `${fmt(watts * 1e3)} mW`;
    if (a >= 1e-6) return `${fmt(watts * 1e6)} µW`;
    if (a >= 1e-9) return `${fmt(watts * 1e9)} nW`;
    if (a >= 1e-12) return `${fmt(watts * 1e12)} pW`;
    return `${watts.toExponential(2)} W`;
  }

  function fmtIrradiance(Wm2: number): string {
    if (!isFinite(Wm2)) return '—';
    const Wcm2 = Wm2 * 1e-4;
    if (Wcm2 >= 1e3) return `${fmt(Wcm2 * 1e-3)} kW/cm²`;
    if (Wcm2 >= 1)    return `${fmt(Wcm2)} W/cm²`;
    return `${fmt(Wcm2 * 1e3)} mW/cm²`;
  }

  // ===== Update outputs =====

  function updateOutputs() {
    if (!spectrum) return;
    const nk = getNK(state.lambda);
    if (!nk) return;
    const [n, k] = nk;
    const v = mieAt(n, k, state.nHost, state.radius, state.lambda);

    const albedo = v.cext > 0 ? v.csca / v.cext : 0;

    const P_W = state.power_mW * 1e-3;
    const w0_m = state.w0_um * 1e-6;
    const I_peak = (2 * P_W) / (Math.PI * w0_m * w0_m); // W/m² (Gaussian peak)

    const sigmaAbs_m2 = v.cabs * 1e-18;
    const sigmaSca_m2 = v.csca * 1e-18;
    const P_abs = sigmaAbs_m2 * I_peak;
    const P_sca = sigmaSca_m2 * I_peak;

    const dT = P_abs / (4 * Math.PI * state.kappa * (state.radius * 1e-9));

    (document.getElementById('out-cabs') as HTMLElement).textContent = fmt(v.cabs);
    (document.getElementById('out-csca') as HTMLElement).textContent = fmt(v.csca);
    (document.getElementById('out-cext') as HTMLElement).textContent = fmt(v.cext);
    (document.getElementById('out-albedo') as HTMLElement).textContent = albedo.toFixed(3);

    (document.getElementById('out-i') as HTMLElement).textContent = `I = ${fmtIrradiance(I_peak)}`;
    (document.getElementById('out-pabs') as HTMLElement).textContent = fmtPower(P_abs);
    (document.getElementById('out-psca') as HTMLElement).textContent = fmtPower(P_sca);

    const tot = P_abs + P_sca;
    const pctAbs = tot > 0 ? (P_abs / tot) * 100 : 0;
    const pctSca = tot > 0 ? (P_sca / tot) * 100 : 0;
    (document.getElementById('budget-abs') as HTMLElement).style.flexBasis = pctAbs + '%';
    (document.getElementById('budget-sca') as HTMLElement).style.flexBasis = pctSca + '%';

    (document.getElementById('out-dt') as HTMLElement).textContent = isFinite(dT) ? fmt(dT, 3) : '—';

    (document.getElementById('profile-dialog-dt') as HTMLElement).textContent = isFinite(dT) ? fmt(dT, 4) : '-';
    (document.getElementById('material-ref') as HTMLElement).textContent = currentMaterialRef();

    updateColors();
    drawProfile(dT);
    lastDTSurface = dT;
    if ((document.getElementById('profile-dialog') as HTMLDialogElement | null)?.open) drawProfileLarge(dT);
    drawChart();
  }

  function updateColors() {
    if (!spectrum) return;
    // Scattered color: reflectance = σ_sca(λ) / max(σ_sca)
    const sMax = Math.max(...spectrum.csca);
    const R_sca = new Float64Array(spectrum.csca.length);
    if (sMax > 0) for (let i = 0; i < R_sca.length; i++) R_sca[i] = spectrum.csca[i] / sMax;

    // Transmitted color: same Beer-Lambert normalization used by the Mie lab.
    const eMax = Math.max(...spectrum.cext);
    const R_trans = new Float64Array(spectrum.cext.length);
    if (eMax > 0) {
      for (let i = 0; i < R_trans.length; i++) R_trans[i] = Math.exp(-2 * spectrum.cext[i] / eMax);
    } else {
      R_trans.fill(1);
    }

    const scaHex = spectrumToHex(spectrum.lambda, R_sca);
    const transHex = spectrumToHex(spectrum.lambda, R_trans);
    (document.getElementById('swatch-sca') as HTMLElement).style.background = scaHex;
    (document.getElementById('swatch-trans') as HTMLElement).style.background = transHex;
  }

  // ===== Main chart =====

  function drawChart() {
    if (!spectrum) return;
    const ct = chartTheme();
    const canvas = document.getElementById('mie-chart') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth, h = canvas.clientHeight;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.scale(dpr, dpr);

    const m = { top: 14, right: 18, bottom: 34, left: 54 };
    const pw = w - m.left - m.right;
    const ph = h - m.top - m.bottom;

    // y-max across cabs + csca
    let yMax = 0;
    for (let i = 0; i < NPTS; i++) {
      if (spectrum.cabs[i] > yMax) yMax = spectrum.cabs[i];
      if (spectrum.csca[i] > yMax) yMax = spectrum.csca[i];
    }
    if (yMax <= 0) yMax = 1;
    yMax *= 1.1;

    const xTo = (lam: number) => m.left + pw * (lam - LAM_MIN) / (LAM_MAX - LAM_MIN);
    const yTo = (v: number) => m.top + ph * (1 - v / yMax);

    ctx.fillStyle = ct.bg;
    ctx.fillRect(m.left, m.top, pw, ph);

    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 1;
    for (let lam = 400; lam <= LAM_MAX; lam += 200) {
      const x = xTo(lam);
      ctx.beginPath(); ctx.moveTo(x, m.top); ctx.lineTo(x, m.top + ph); ctx.stroke();
    }
    const yTicks = 5;
    for (let i = 0; i <= yTicks; i++) {
      const y = m.top + ph * i / yTicks;
      ctx.beginPath(); ctx.moveTo(m.left, y); ctx.lineTo(m.left + pw, y); ctx.stroke();
    }

    ctx.strokeStyle = ct.text;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(m.left, m.top);
    ctx.lineTo(m.left, m.top + ph);
    ctx.lineTo(m.left + pw, m.top + ph);
    ctx.stroke();

    // axis labels
    ctx.fillStyle = ct.textSoft;
    ctx.font = '10px Inter, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (let lam = 400; lam <= LAM_MAX; lam += 200) {
      ctx.fillText(String(lam), xTo(lam), m.top + ph + 4);
    }
    ctx.fillStyle = ct.text;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillText('Wavelength λ (nm)', m.left + pw / 2, h - 14);

    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    ctx.fillStyle = ct.textSoft;
    ctx.font = '10px Inter, system-ui, sans-serif';
    for (let i = 0; i <= yTicks; i++) {
      const v = yMax * (1 - i / yTicks);
      const y = m.top + ph * i / yTicks;
      ctx.fillText(fmt(v, 2), m.left - 5, y);
    }
    ctx.save();
    ctx.translate(12, m.top + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = ct.text;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillText('Cross-section σ (nm²)', 0, 0);
    ctx.restore();

    // Clip curves to plot area
    ctx.save();
    ctx.beginPath();
    ctx.rect(m.left, m.top, pw, ph);
    ctx.clip();

    // σ_abs
    ctx.strokeStyle = '#EF4444';
    ctx.lineWidth = 2.2;
    ctx.beginPath();
    for (let i = 0; i < NPTS; i++) {
      const x = xTo(spectrum.lambda[i]);
      const y = yTo(spectrum.cabs[i]);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // σ_sca
    ctx.strokeStyle = '#3B82F6';
    ctx.lineWidth = 2.2;
    ctx.beginPath();
    for (let i = 0; i < NPTS; i++) {
      const x = xTo(spectrum.lambda[i]);
      const y = yTo(spectrum.csca[i]);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    ctx.restore();

    // Laser marker
    const xL = xTo(state.lambda);
    if (xL >= m.left && xL <= m.left + pw) {
      ctx.setLineDash([3, 3]);
      ctx.strokeStyle = '#F43F5E';
      ctx.lineWidth = 1.3;
      ctx.beginPath(); ctx.moveTo(xL, m.top); ctx.lineTo(xL, m.top + ph); ctx.stroke();
      ctx.setLineDash([]);

      ctx.fillStyle = '#F43F5E';
      ctx.font = '600 10px Inter, system-ui, sans-serif';
      ctx.textAlign = xL > m.left + pw - 60 ? 'right' : 'left';
      ctx.textBaseline = 'top';
      ctx.fillText(`${state.lambda} nm`, xL + (xL > m.left + pw - 60 ? -4 : 4), m.top + 2);
    }
  }

  // ===== Profile T(r) mini chart =====

  function drawProfile(dTSurface: number) {
    const ct = chartTheme();
    const canvas = document.getElementById('profile-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth, h = canvas.clientHeight;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.scale(dpr, dpr);

    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, w, h);

    const mL = 8, mR = 34, mT = 10, mB = 22;
    const pw = w - mL - mR;
    const ph = h - mT - mB;

    // r/R range [1, 10]
    const rMin = 1, rMax = 10;
    const xTo = (r: number) => mL + pw * (r - rMin) / (rMax - rMin);
    const yTo = (t: number) => mT + ph * (1 - t);  // t is normalized ΔT (0..1)

    // Axes frame
    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(mL, mT); ctx.lineTo(mL, mT + ph); ctx.lineTo(mL + pw, mT + ph);
    ctx.stroke();

    if (!isFinite(dTSurface) || dTSurface <= 0) {
      ctx.strokeStyle = ct.grid;
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(mL, yTo(0)); ctx.lineTo(mL + pw, yTo(0)); ctx.stroke();
      return;
    }

    // ===== Reference lines at ΔT/e and ΔT/e² =====
    const refs = [
      { y: 1 / Math.E,       label: '1/e',  color: ct.textMuted },
      { y: 1 / (Math.E ** 2), label: '1/e²', color: ct.grid },
    ];
    ctx.font = '9px Inter, system-ui, sans-serif';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    for (const r of refs) {
      const yy = yTo(r.y);
      ctx.strokeStyle = r.color;
      ctx.setLineDash([2, 3]);
      ctx.beginPath(); ctx.moveTo(mL, yy); ctx.lineTo(mL + pw, yy); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = ct.textSoft;
      ctx.fillText(r.label, mL + pw + 3, yy);
    }

    // ===== Curve T(r)/ΔT = R/r =====
    ctx.strokeStyle = '#EF4444';
    ctx.lineWidth = 2;
    ctx.beginPath();
    const N = 120;
    for (let i = 0; i < N; i++) {
      const r = rMin + (rMax - rMin) * i / (N - 1);
      const t = 1 / r;
      const x = xTo(r), y = yTo(t);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // Intersection dots at r/R = e and r/R = e²
    for (const rr of [Math.E, Math.E ** 2]) {
      if (rr >= rMin && rr <= rMax) {
        ctx.fillStyle = '#EF4444';
        ctx.beginPath(); ctx.arc(xTo(rr), yTo(1 / rr), 2.5, 0, Math.PI * 2); ctx.fill();
      }
    }

    // ===== X-axis ticks at r/R = 1, 2, 5, 10 =====
    ctx.fillStyle = ct.textSoft;
    ctx.font = '9px Inter, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (const rr of [1, 2, 5, 10]) {
      const xx = xTo(rr);
      ctx.strokeStyle = ct.grid;
      ctx.beginPath(); ctx.moveTo(xx, mT + ph); ctx.lineTo(xx, mT + ph + 2); ctx.stroke();
      ctx.fillText(String(rr), xx, mT + ph + 4);
    }
  }

  function drawProfileLarge(dTSurface: number) {
    const ct = chartTheme();
    const canvas = document.getElementById('profile-chart-large') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    const w = rect.width, h = rect.height;
    if (w === 0 || h === 0) return;
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    ctx.scale(dpr, dpr);
    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, w, h);

    const m = { left: 64, right: 28, top: 24, bottom: 48 };
    const pw = w - m.left - m.right;
    const ph = h - m.top - m.bottom;
    const rMin = 1, rMax = 12;
    const yMax = isFinite(dTSurface) && dTSurface > 0 ? dTSurface : 1;
    const xTo = (r: number) => m.left + pw * (r - rMin) / (rMax - rMin);
    const yTo = (v: number) => m.top + ph * (1 - v / yMax);

    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 1;
    const xTicks = [1, 2, Math.E, 5, Math.E ** 2, 10, 12];
    for (const r of xTicks) {
      const x = Math.round(xTo(r)) + 0.5;
      ctx.beginPath(); ctx.moveTo(x, m.top); ctx.lineTo(x, m.top + ph); ctx.stroke();
    }
    const yTicks = [0, yMax / (Math.E ** 2), yMax / Math.E, yMax];
    for (const v of yTicks) {
      const y = Math.round(yTo(v)) + 0.5;
      ctx.beginPath(); ctx.moveTo(m.left, y); ctx.lineTo(m.left + pw, y); ctx.stroke();
    }

    ctx.strokeStyle = ct.textSoft;
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(m.left, m.top);
    ctx.lineTo(m.left, m.top + ph);
    ctx.lineTo(m.left + pw, m.top + ph);
    ctx.stroke();

    ctx.fillStyle = ct.textSoft;
    ctx.font = '12px Inter, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (const r of xTicks) {
      const label = Math.abs(r - Math.E) < 0.01 ? 'e' : Math.abs(r - Math.E ** 2) < 0.01 ? 'e^2' : fmt(r, 2);
      ctx.fillText(label, xTo(r), m.top + ph + 8);
    }
    ctx.fillStyle = ct.text;
    ctx.font = '13px Inter, system-ui, sans-serif';
    ctx.fillText('Distance from particle center, r / R', m.left + pw / 2, h - 18);

    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    ctx.font = '12px Inter, system-ui, sans-serif';
    ctx.fillStyle = ct.textSoft;
    for (const v of yTicks) ctx.fillText(fmt(v, 3), m.left - 8, yTo(v));
    ctx.save();
    ctx.translate(18, m.top + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = ct.text;
    ctx.font = '13px Inter, system-ui, sans-serif';
    ctx.fillText('Temperature rise, \u0394T(r) (K)', 0, 0);
    ctx.restore();

    if (!isFinite(dTSurface) || dTSurface <= 0) return;
    const refs = [
      { r: Math.E, value: yMax / Math.E, label: '\u0394T / e', color: ct.textMuted },
      { r: Math.E ** 2, value: yMax / (Math.E ** 2), label: '\u0394T / e^2', color: ct.grid },
    ];
    ctx.font = '12px Inter, system-ui, sans-serif';
    for (const ref of refs) {
      const y = yTo(ref.value);
      ctx.strokeStyle = ref.color;
      ctx.setLineDash([5, 4]);
      ctx.beginPath(); ctx.moveTo(m.left, y); ctx.lineTo(m.left + pw, y); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = ct.textSoft;
      ctx.textAlign = 'left';
      ctx.fillText(ref.label, m.left + 8, y - 16);
    }

    ctx.strokeStyle = '#EF4444';
    ctx.lineWidth = 2.8;
    ctx.beginPath();
    const N = 420;
    for (let i = 0; i < N; i++) {
      const r = rMin + (rMax - rMin) * i / (N - 1);
      const x = xTo(r), y = yTo(yMax / r);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();
    for (const ref of refs) {
      ctx.fillStyle = '#EF4444';
      ctx.beginPath(); ctx.arc(xTo(ref.r), yTo(ref.value), 4, 0, Math.PI * 2); ctx.fill();
    }
    if (profileHoverR !== null) {
      const r = Math.max(rMin, Math.min(rMax, profileHoverR));
      const value = yMax / r;
      const x = xTo(r);
      const y = yTo(value);
      ctx.strokeStyle = '#7C3AED';
      ctx.lineWidth = 1.3;
      ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.moveTo(x, m.top); ctx.lineTo(x, m.top + ph); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(m.left, y); ctx.lineTo(m.left + pw, y); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = '#7C3AED';
      ctx.beginPath(); ctx.arc(x, y, 5, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = ct.bg;
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(x, y, 5, 0, Math.PI * 2); ctx.stroke();
    }
  }

  // ===== Binding helpers =====

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  function syncPair(numId: string, sliderId: string, key: keyof typeof state, recompute: boolean) {
    const num = $<HTMLInputElement>(numId);
    const slider = $<HTMLInputElement>(sliderId);
    const update = (src: 'num' | 'slider') => {
      const raw = src === 'num' ? num.value : slider.value;
      const v = parseFloat(raw);
      if (!isFinite(v)) return;
      (state as any)[key] = v;
      if (src === 'num') slider.value = raw;
      else num.value = raw;
      if (recompute) computeSpectrum();
      updateOutputs();
    };
    num.addEventListener('input', () => update('num'));
    slider.addEventListener('input', () => update('slider'));
  }

  function bindPresets(groupId: string, numId: string, sliderId: string | null, key: keyof typeof state, recompute: boolean) {
    $(groupId).addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.preset-btn') as HTMLElement | null;
      if (!btn) return;
      const v = parseFloat(btn.dataset.val!);
      (state as any)[key] = v;
      $<HTMLInputElement>(numId).value = v.toString();
      if (sliderId) $<HTMLInputElement>(sliderId).value = v.toString();
      $(groupId).querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      if (recompute) computeSpectrum();
      updateOutputs();
    });
  }

  function setupRIISearch(
    searchGroup: HTMLElement, searchInput: HTMLInputElement,
    resultsList: HTMLElement, statusEl: HTMLElement,
    onLoaded: (data: number[][], label: string) => void,
  ) {
    let catalog: RIIMaterial[] | null = null;
    let debounce: ReturnType<typeof setTimeout>;

    function showResults(q: string) {
      if (!catalog) return;
      const hits = searchCatalog(catalog, q);
      resultsList.innerHTML = hits.map((m, i) =>
        `<div class="rii-result" data-idx="${i}"><span class="rii-result-book">${m.bookName}</span><br><span class="rii-result-page">${m.pageName}</span></div>`
      ).join('');
      (resultsList as any)._hits = hits;
    }

    async function ensureCatalog() {
      if (catalog) { showResults(searchInput.value); return; }
      statusEl.textContent = 'Loading catalog...';
      try {
        catalog = await loadCatalog();
        statusEl.textContent = `${catalog.length} materials available`;
        showResults(searchInput.value);
      } catch { statusEl.textContent = 'Failed to load catalog'; }
    }

    searchInput.addEventListener('input', () => { clearTimeout(debounce); debounce = setTimeout(() => showResults(searchInput.value), 150); });
    searchInput.addEventListener('focus', () => { if (catalog) showResults(searchInput.value); });

    resultsList.addEventListener('click', async (e) => {
      const el = (e.target as HTMLElement).closest('.rii-result') as HTMLElement;
      if (!el) return;
      const hits = (resultsList as any)._hits as RIIMaterial[];
      const mat = hits[parseInt(el.dataset.idx!)];
      statusEl.textContent = 'Loading...';
      resultsList.innerHTML = '';
      try {
        const d = await fetchMaterialNK(mat.dataPath);
        statusEl.textContent = `${d.length} points loaded`;
        searchInput.value = mat.bookName;
        onLoaded(d, mat.pageName);
      } catch { statusEl.textContent = 'Failed to load material'; }
    });
    return { ensureCatalog };
  }

  syncPair('r-num', 'r-slider', 'radius', true);
  syncPair('nh-num', 'nh-slider', 'nHost', true);
  syncPair('lam-num', 'lam-slider', 'lambda', false);
  syncPair('pow-num', 'pow-slider', 'power_mW', false);
  syncPair('w0-num', 'w0-slider', 'w0_um', false);

  $<HTMLInputElement>('k-num').addEventListener('input', (e) => {
    const v = parseFloat((e.target as HTMLInputElement).value);
    if (!isFinite(v) || v <= 0) return;
    state.kappa = v;
    $('k-presets').querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    updateOutputs();
  });

  bindPresets('nh-presets', 'nh-num', 'nh-slider', 'nHost', true);
  bindPresets('lam-presets', 'lam-num', 'lam-slider', 'lambda', false);
  bindPresets('k-presets', 'k-num', null, 'kappa', false);

  const materialSelect = $<HTMLSelectElement>('material-select');
  const epsGroup = $('eps-group');
  const fileUploadGroup = $('file-upload-group');
  const fileUpload = $<HTMLInputElement>('file-upload');
  const fileNameEl = $('file-name');
  const riiSearchGroup = $('rii-search-group');
  const riiStatus = $('rii-status');

  const materialImportDialog = $('material-import-dialog') as HTMLDialogElement;
  const materialImportFile = $('material-import-file');
  const materialImportAxis = $<HTMLSelectElement>('material-import-axis');
  const materialImportValues = $<HTMLSelectElement>('material-import-values');
  const materialImportPreview = $<HTMLCanvasElement>('material-import-preview');
  const materialImportRows = $('material-import-rows');
  const materialImportStatus = $('material-import-status');
  const materialImportAccept = $<HTMLButtonElement>('material-import-accept');
  const materialImportCancel = $('material-import-cancel');
  const materialImportClose = $('material-import-close');

  interface MaterialImportTarget {
    fileName: string;
    onAccept: (data: number[][], label: string) => void;
    onCancel?: () => void;
  }
  let pendingMaterialImport: (MaterialImportTarget & { parsed: ParsedOpticalFile }) | null = null;

  function drawMaterialImportPreview(rows: RawOpticalRow[], axisMode: ImportAxisMode, valueMode: ImportValueMode) {
    const ct = chartTheme();
    const rect = materialImportPreview.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    const w = Math.max(1, rect.width);
    const h = Math.max(1, rect.height || rect.width / 3);
    materialImportPreview.width = Math.round(w * dpr);
    materialImportPreview.height = Math.round(h * dpr);
    const ctx = materialImportPreview.getContext('2d')!;
    ctx.scale(dpr, dpr);
    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, w, h);

    const parsed = rows
      .map(([x, a, b]) => Number.isFinite(x) && Number.isFinite(a) && Number.isFinite(b) ? { x, a, b } : null)
      .filter((r): r is { x: number; a: number; b: number } => !!r)
      .sort((a, b) => a.x - b.x);
    if (parsed.length < 2) return;

    const sampled = sampleRows(parsed, 320);
    const values = sampled.flatMap(r => valueMode === 'epsilon' ? [r.a, r.b] : [r.a, Math.abs(r.b)]);
    const xMin = Math.min(...sampled.map(r => r.x));
    const xMax = Math.max(...sampled.map(r => r.x));
    let yMin = Math.min(...values);
    let yMax = Math.max(...values);
    if (yMin === yMax) { yMin -= 1; yMax += 1; }
    const padY = (yMax - yMin) * 0.08;
    yMin -= padY; yMax += padY;

    const m = { left: 48, right: 18, top: 18, bottom: 32 };
    const pw = w - m.left - m.right;
    const ph = h - m.top - m.bottom;
    const xTo = (x: number) => m.left + pw * (x - xMin) / (xMax - xMin || 1);
    const yTo = (y: number) => m.top + ph * (1 - (y - yMin) / (yMax - yMin || 1));

    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const x = m.left + pw * i / 4;
      const y = m.top + ph * i / 4;
      ctx.beginPath(); ctx.moveTo(x, m.top); ctx.lineTo(x, m.top + ph); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(m.left, y); ctx.lineTo(m.left + pw, y); ctx.stroke();
    }
    ctx.strokeStyle = ct.textSoft;
    ctx.beginPath();
    ctx.moveTo(m.left, m.top);
    ctx.lineTo(m.left, m.top + ph);
    ctx.lineTo(m.left + pw, m.top + ph);
    ctx.stroke();

    const drawLine = (pick: (r: { x: number; a: number; b: number }) => number, color: string) => {
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      ctx.lineJoin = 'round';
      ctx.beginPath();
      for (let i = 0; i < sampled.length; i++) {
        const x = xTo(sampled[i].x);
        const y = yTo(pick(sampled[i]));
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.stroke();
    };
    drawLine(r => r.a, '#6366F1');
    drawLine(r => valueMode === 'epsilon' ? r.b : Math.abs(r.b), '#F59E0B');

    ctx.fillStyle = ct.textSoft;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText(valueMode === 'epsilon' ? 'Re eps' : 'n', m.left + 8, m.top + 14);
    ctx.fillStyle = '#F59E0B';
    ctx.fillText(valueMode === 'epsilon' ? 'Im eps' : 'k', m.left + 62, m.top + 14);
    ctx.fillStyle = ct.textSoft;
    ctx.textAlign = 'center';
    const xLabel = axisMode === 'energy-ev' ? 'Photon energy (eV)' : axisMode === 'wavelength-nm' ? 'Wavelength (nm)' : 'Wavelength (um)';
    ctx.fillText(xLabel, m.left + pw / 2, h - 10);
    ctx.textAlign = 'right';
    ctx.fillText(formatCompact(yMax), m.left - 6, m.top + 4);
    ctx.fillText(formatCompact(yMin), m.left - 6, m.top + ph);
  }

  function renderMaterialImportPreview() {
    if (!pendingMaterialImport) return;
    const axisMode = materialImportAxis.value as ImportAxisMode;
    const valueMode = materialImportValues.value as ImportValueMode;
    const converted = convertOpticalRows(pendingMaterialImport.parsed.rows, axisMode, valueMode);
    drawMaterialImportPreview(pendingMaterialImport.parsed.rows, axisMode, valueMode);
    materialImportRows.innerHTML = sampleRows(pendingMaterialImport.parsed.rows, 8)
      .map(row => `<tr><td>${formatCompact(row[0])}</td><td>${formatCompact(row[1])}</td><td>${formatCompact(row[2])}</td></tr>`)
      .join('');
    materialImportStatus.classList.toggle('error', 'error' in converted);
    materialImportAccept.disabled = 'error' in converted;
    if ('error' in converted) {
      materialImportStatus.textContent = converted.error;
      return;
    }
    materialImportStatus.textContent =
      `${converted.data.length} points | ${formatCompact(converted.lambdaMinNm)}-${formatCompact(converted.lambdaMaxNm)} nm | n ${formatCompact(converted.nMin)}-${formatCompact(converted.nMax)} | k ${formatCompact(converted.kMin)}-${formatCompact(converted.kMax)}`;
  }

  function closeMaterialImportDialog(runCancel = false) {
    if (runCancel) pendingMaterialImport?.onCancel?.();
    pendingMaterialImport = null;
    materialImportDialog.close();
  }

  function openMaterialImportDialog(fileName: string, parsed: ParsedOpticalFile, onAccept: (data: number[][], label: string) => void) {
    pendingMaterialImport = { fileName, parsed, onAccept };
    materialImportFile.textContent = fileName;
    const modes = inferImportModes(parsed.rows);
    materialImportAxis.value = modes.axis;
    materialImportValues.value = modes.values;
    if (typeof materialImportDialog.showModal === 'function') materialImportDialog.showModal();
    else materialImportDialog.setAttribute('open', '');
    renderMaterialImportPreview();
  }

  materialImportAxis.addEventListener('change', renderMaterialImportPreview);
  materialImportValues.addEventListener('change', renderMaterialImportPreview);
  materialImportCancel.addEventListener('click', () => closeMaterialImportDialog(true));
  materialImportClose.addEventListener('click', () => closeMaterialImportDialog(true));
  materialImportDialog.addEventListener('click', (e: MouseEvent) => {
    if (e.target === materialImportDialog) closeMaterialImportDialog(true);
  });
  materialImportAccept.addEventListener('click', () => {
    if (!pendingMaterialImport) return;
    const converted = convertOpticalRows(
      pendingMaterialImport.parsed.rows,
      materialImportAxis.value as ImportAxisMode,
      materialImportValues.value as ImportValueMode,
    );
    if ('error' in converted) {
      materialImportStatus.classList.add('error');
      materialImportStatus.textContent = converted.error;
      return;
    }
    const label = `${pendingMaterialImport.fileName} (${converted.data.length} points, ${formatCompact(converted.lambdaMinNm)}-${formatCompact(converted.lambdaMaxNm)} nm)`;
    pendingMaterialImport.onAccept(converted.data, label);
    closeMaterialImportDialog(false);
  });

  function refreshMaterialControls() {
    const v = materialSelect.value;
    epsGroup.classList.toggle('hidden', v !== 'custom');
    fileUploadGroup.style.display = v === 'file' ? '' : 'none';
    riiSearchGroup.style.display = v === 'rii' ? '' : 'none';
    $('material-ref').textContent = currentMaterialRef();
  }

  function recomputeMaterial() {
    computeSpectrum();
    updateOutputs();
  }

  const riiHandle = setupRIISearch(
    riiSearchGroup,
    $<HTMLInputElement>('rii-search'),
    $('rii-results'),
    riiStatus,
    (data, label) => {
      uploadedMaterial = data;
      uploadedMaterialLabel = label;
      $('material-ref').textContent = label;
      recomputeMaterial();
    },
  );

  materialSelect.addEventListener('change', () => {
    state.material = materialSelect.value;
    refreshMaterialControls();
    if (state.material === 'rii') { riiHandle.ensureCatalog(); return; }
    if (state.material === 'file' && !uploadedMaterial) return;
    recomputeMaterial();
  });

  $<HTMLInputElement>('eps-num').addEventListener('input', (e) => {
    const v = parseFloat((e.target as HTMLInputElement).value);
    if (!isFinite(v) || v <= 0) return;
    state.eps = v;
    if (state.material === 'custom') recomputeMaterial();
  });

  fileUpload.addEventListener('change', () => {
    const file = fileUpload.files?.[0];
    if (!file) return;
    fileNameEl.className = 'file-name';
    fileNameEl.textContent = 'Review file mapping...';
    file.text().then(text => {
      const parsed = parseOpticalFile(text);
      if ('error' in parsed) {
        fileNameEl.className = 'file-error';
        fileNameEl.textContent = parsed.error;
        uploadedMaterial = null;
        return;
      }
      openMaterialImportDialog(file.name, parsed, (data, label) => {
        uploadedMaterial = data;
        uploadedMaterialLabel = label;
        fileNameEl.className = 'file-name';
        fileNameEl.textContent = label;
        $('material-ref').textContent = label;
        recomputeMaterial();
      });
    });
  });

  // ===== Export / Share =====
  import { downloadBlob } from '../../lib/download';

  document.getElementById('dl-png')!.addEventListener('click', () => {
    const c = document.getElementById('mie-chart') as HTMLCanvasElement;
    c.toBlob(b => { if (b) downloadBlob(b, `photothermal_${state.material}_R${state.radius}nm.png`); }, 'image/png');
  });

  document.getElementById('dl-csv')!.addEventListener('click', () => {
    if (!spectrum) return;
    const lines = [
      `# Photothermal — material=${state.material}, R=${state.radius} nm, n_host=${state.nHost}, λ_laser=${state.lambda} nm, P=${state.power_mW} mW, w_0=${state.w0_um} µm, κ=${state.kappa} W/m·K`,
      '# Generated by NanophotonicsLab (nanophotonicslab.com)',
      'wavelength_nm,Csca_nm2,Cabs_nm2,Cext_nm2',
    ];
    for (let i = 0; i < spectrum.lambda.length; i++) {
      lines.push(`${spectrum.lambda[i].toFixed(2)},${spectrum.csca[i].toFixed(4)},${spectrum.cabs[i].toFixed(4)},${spectrum.cext[i].toFixed(4)}`);
    }
    downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }),
                 `photothermal_${state.material}_R${state.radius}nm.csv`);
  });

  const shareBtn = document.getElementById('share-btn')!;
  function serializeState(): string {
    const p = new URLSearchParams();
    if (!['file', 'rii'].includes(state.material)) p.set('mat', state.material);
    p.set('r', String(state.radius));
    p.set('nh', String(state.nHost));
    p.set('lam', String(state.lambda));
    p.set('pow', String(state.power_mW));
    p.set('w0', String(state.w0_um));
    p.set('k', String(state.kappa));
    if (state.material === 'custom') p.set('eps', String(state.eps));
    return p.toString();
  }
  shareBtn.addEventListener('click', () => {
    const url = location.origin + location.pathname + '#' + serializeState();
    navigator.clipboard.writeText(url).then(() => {
      shareBtn.textContent = 'Copied!';
      setTimeout(() => {
        shareBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> Share';
      }, 1500);
    });
  });

  function restoreState() {
    const hash = location.hash.slice(1);
    if (!hash) return;
    const p = new URLSearchParams(hash);
    const setInput = (id: string, v: string) => { const el = document.getElementById(id) as HTMLInputElement | null; if (el) el.value = v; };
    if (p.has('mat')) {
      const mat = p.get('mat')!;
      if (!['file', 'rii'].includes(mat)) {
        state.material = mat;
        materialSelect.value = mat;
      }
    }
    if (p.has('eps')) { state.eps = parseFloat(p.get('eps')!); setInput('eps-num', String(state.eps)); }
    if (p.has('r')) { state.radius = parseFloat(p.get('r')!); setInput('r-num', String(state.radius)); setInput('r-slider', String(state.radius)); }
    if (p.has('nh')) { state.nHost = parseFloat(p.get('nh')!); setInput('nh-num', String(state.nHost)); setInput('nh-slider', String(state.nHost)); }
    if (p.has('lam')) { state.lambda = parseFloat(p.get('lam')!); setInput('lam-num', String(state.lambda)); setInput('lam-slider', String(state.lambda)); }
    if (p.has('pow')) { state.power_mW = parseFloat(p.get('pow')!); setInput('pow-num', String(state.power_mW)); setInput('pow-slider', String(state.power_mW)); }
    if (p.has('w0')) { state.w0_um = parseFloat(p.get('w0')!); setInput('w0-num', String(state.w0_um)); setInput('w0-slider', String(state.w0_um)); }
    if (p.has('k')) { state.kappa = parseFloat(p.get('k')!); setInput('k-num', String(state.kappa)); }
  }

  restoreState();
  refreshMaterialControls();

  // Initial
  computeSpectrum();
  updateOutputs();

  const profileDialog = $('profile-dialog') as HTMLDialogElement;
  const profileOpen = $('profile-open') as HTMLButtonElement;
  const profileClose = $('profile-dialog-close') as HTMLButtonElement;
  const profileWrap = $('profile-wrap');
  const profileChartLarge = $<HTMLCanvasElement>('profile-chart-large');
  const profileChartTooltip = $('profile-chart-tooltip');
  function openProfileDialog() {
    if (typeof profileDialog.showModal === 'function') profileDialog.showModal();
    else profileDialog.setAttribute('open', '');
    requestAnimationFrame(() => drawProfileLarge(lastDTSurface));
  }
  profileOpen.addEventListener('click', openProfileDialog);
  profileWrap.addEventListener('click', openProfileDialog);
  profileWrap.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      openProfileDialog();
    }
  });
  profileClose.addEventListener('click', () => profileDialog.close());
  document.getElementById('profile-export-png')!.addEventListener('click', () => {
    const c = document.getElementById('profile-chart-large') as HTMLCanvasElement;
    drawProfileLarge(lastDTSurface);
    c.toBlob(b => {
      if (b) downloadBlob(b, `photothermal_profile_${state.material}_R${state.radius}nm.png`);
    }, 'image/png');
  });
  document.getElementById('profile-export-csv')!.addEventListener('click', () => {
    const lines = [
      `# Photothermal radial temperature profile - material=${state.material}, R=${state.radius} nm, n_host=${state.nHost}, lambda_laser=${state.lambda} nm, P=${state.power_mW} mW, w0=${state.w0_um} um, kappa=${state.kappa} W/mK`,
      '# Generated by NanophotonicsLab (nanophotonicslab.com)',
      '# Steady-state outside-particle model: DeltaT(r) = DeltaT(R) * R / r for r >= R',
      'r_over_R,r_nm,DeltaT_K',
    ];
    const n = 420;
    const rMin = 1;
    const rMax = 12;
    for (let i = 0; i < n; i++) {
      const rOverR = rMin + (rMax - rMin) * i / (n - 1);
      const rNm = rOverR * state.radius;
      const dT = isFinite(lastDTSurface) && lastDTSurface > 0 ? lastDTSurface / rOverR : 0;
      lines.push(`${rOverR.toFixed(6)},${rNm.toFixed(6)},${dT.toFixed(8)}`);
    }
    downloadBlob(
      new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }),
      `photothermal_profile_${state.material}_R${state.radius}nm.csv`,
    );
  });
  function hideProfilePointer() {
    if (profileHoverR === null && profileChartTooltip.style.display === 'none') return;
    profileHoverR = null;
    profileChartTooltip.style.display = 'none';
    drawProfileLarge(lastDTSurface);
  }
  function updateProfilePointer(e: PointerEvent) {
    if (!isFinite(lastDTSurface) || lastDTSurface <= 0) {
      hideProfilePointer();
      return;
    }
    const rect = profileChartLarge.getBoundingClientRect();
    const m = { left: 64, right: 28, top: 24, bottom: 48 };
    const pw = rect.width - m.left - m.right;
    const ph = rect.height - m.top - m.bottom;
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    if (x < m.left || x > m.left + pw || y < m.top || y > m.top + ph) {
      hideProfilePointer();
      return;
    }

    const rMin = 1;
    const rMax = 12;
    const rOverR = rMin + (rMax - rMin) * (x - m.left) / pw;
    const dT = lastDTSurface / rOverR;
    profileHoverR = rOverR;
    profileChartTooltip.innerHTML =
      `<strong>r / R</strong> = ${fmt(rOverR, 4)}<br>` +
      `<strong>r</strong> = ${fmt(rOverR * state.radius, 4)} nm<br>` +
      `<strong>&Delta;T</strong> = ${fmt(dT, 4)} K`;
    profileChartTooltip.style.display = 'block';
    drawProfileLarge(lastDTSurface);

    const tipRect = profileChartTooltip.getBoundingClientRect();
    const chartRect = (profileChartTooltip.parentElement as HTMLElement).getBoundingClientRect();
    const margin = 10;
    let left = x + 14;
    let top = y + 14;
    left = Math.max(margin, Math.min(left, chartRect.width - tipRect.width - margin));
    top = Math.max(margin, Math.min(top, chartRect.height - tipRect.height - margin));
    profileChartTooltip.style.left = `${left}px`;
    profileChartTooltip.style.top = `${top}px`;
  }
  profileChartLarge.addEventListener('pointermove', updateProfilePointer);
  profileChartLarge.addEventListener('pointerleave', hideProfilePointer);
  profileDialog.addEventListener('click', (e: MouseEvent) => {
    if (e.target === profileDialog) profileDialog.close();
  });
  profileDialog.addEventListener('close', () => {
    hideProfilePointer();
    profileOpen.focus();
  });

  new ResizeObserver(() => { drawChart(); }).observe($('chart-wrap'));
  new ResizeObserver(() => { drawProfile(lastDTSurface); }).observe($('profile-wrap'));
  new ResizeObserver(() => { if (profileDialog.open) drawProfileLarge(lastDTSurface); }).observe($('profile-chart-large'));

  function positionStatTooltip(button: HTMLElement) {
    const tooltip = button.querySelector('.stat-tooltip') as HTMLElement | null;
    if (!tooltip) return;
    const margin = 16;
    const width = Math.min(280, Math.max(180, window.innerWidth - margin * 2));
    tooltip.style.width = `${width}px`;

    const buttonRect = button.getBoundingClientRect();
    const tooltipRect = tooltip.getBoundingClientRect();
    let left = buttonRect.right - width;
    let top = buttonRect.top - tooltipRect.height - 8;

    left = Math.max(margin, Math.min(left, window.innerWidth - width - margin));
    if (top < margin) top = buttonRect.bottom + 8;
    top = Math.max(margin, Math.min(top, window.innerHeight - tooltipRect.height - margin));

    tooltip.style.left = `${left}px`;
    tooltip.style.top = `${top}px`;
  }

  const statInfoButtons = Array.from(document.querySelectorAll('.stat-info')) as HTMLElement[];
  for (const button of statInfoButtons) {
    button.addEventListener('mouseenter', () => positionStatTooltip(button));
    button.addEventListener('focus', () => positionStatTooltip(button));
  }
  const repositionActiveTooltip = () => {
    const hovered = document.querySelector('.stat-info:hover') as HTMLElement | null;
    const focused = document.activeElement instanceof HTMLElement && document.activeElement.classList.contains('stat-info')
      ? document.activeElement
      : null;
    const active = hovered ?? focused;
    if (active) positionStatTooltip(active);
  };
  window.addEventListener('resize', repositionActiveTooltip);
  window.addEventListener('scroll', repositionActiveTooltip, { passive: true });

  onThemeChange(() => updateOutputs());
</script>
</content>
