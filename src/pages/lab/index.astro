---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

type Widget = { title: string; description: string; color: string; icon: string; status: string; url: string };
type Category = { name: string; widgets: Widget[] };

const categories: Category[] = [
  {
    name: 'Scattering & nanoparticles',
    widgets: [
      { title: 'Mie Scattering Calculator', description: 'Compute scattering, extinction, and absorption cross-sections for spherical nanoparticles. Supports real materials (Au, Ag, Si, Al, TiO\u2082) and custom dielectrics.', color: '#F59E0B', icon: 'bolt', status: 'Stable', url: `${base}lab/mie-scattering/` },
      { title: 'Plasmonic Nanoparticles', description: 'Analytical spectra for rods, cages, disks, rings, bipyramids, and related plasmonic shapes using geometry-only modal parameters and tabulated n,k data.', color: '#10B981', icon: 'plasmon', status: 'Beta', url: `${base}lab/plasmonic-nanoparticles/` },
      { title: 'Cylinder Dispersion', description: 'Guided-mode dispersion \u03c9(q_z) of an infinite dielectric cylinder from exact electromagnetic matching. Multiple angular orders, light and material lines, in-browser complex Bessel.', color: '#6366F1', icon: 'cylinder', status: 'Beta', url: `${base}lab/cylinder/` },
      { title: 'BEM Solver', description: 'Galerkin boundary element method for plasmonic nanoparticles. Spheres and nanorods with 3D visualization, cross-section spectra, and near-field enhancement. Runs in-browser via Pyodide.', color: '#F97316', icon: 'cube', status: 'Experimental', url: `${base}lab/bem-solver/` },
      { title: 'Photothermal Calculator', description: 'Laser-driven nanoparticle heating: cross-sections, albedo, and steady-state temperature rise from exact Mie theory. For plasmonic and biomedical applications.', color: '#EF4444', icon: 'flame', status: 'Beta', url: `${base}lab/photothermal/` },
      { title: 'Optical Tweezers', description: 'Optical trapping of a sphere: exact Mie radiation pressure and asymmetry parameter, plus Rayleigh-regime trap stiffness and depth for a focused Gaussian beam.', color: '#10B981', icon: 'laser', status: 'Beta', url: `${base}lab/tweezers/` },
      { title: 'Purcell Factor', description: 'Quantum emitter near a nanosphere: Purcell enhancement, quenching, modified quantum yield and lifetime — exact multipole theory with NV, QD and dye presets.', color: '#7C3AED', icon: 'bolt', status: 'Beta', url: `${base}lab/purcell/` },
      { title: 'Heterostructures', description: 'Layered planar-media modules for surface plasmons and thin films. Starts with single-interface Drude dispersion in normalized Economou variables.', color: '#0EA5E9', icon: 'layers', status: 'Beta', url: `${base}lab/heterostructures/` },
    ],
  },
  {
    name: 'Wave optics & periodic structures',
    widgets: [
      { title: 'Beam Propagation Method', description: 'Simulate light propagation in step-index waveguides using the Crank\u2013Nicolson paraxial wave equation solver. Interactive 2D intensity heatmap.', color: '#8B5CF6', icon: 'wave', status: 'Beta', url: `${base}lab/bpm/` },
      { title: 'RCWA \u2014 1D Grating', description: 'Rigorous Coupled Wave Analysis (Fourier modal method) for 1D periodic gratings. Computes R/T spectra for arbitrary materials. Runs in-browser via Pyodide + inkstone.', color: '#0EA5E9', icon: 'grating', status: 'Experimental', url: `${base}lab/rcwa/` },
    ],
  },
  {
    name: 'Lab calculators',
    widgets: [
      { title: 'Photon Calculator', description: 'Convert between wavelength, energy, frequency, angular frequency, wavenumber, and period for photons. Live spectrum chart with common laser lines.', color: '#10B981', icon: 'photon', status: 'Stable', url: `${base}lab/photon/` },
      { title: 'Relativistic Electron Calculator', description: 'Convert between velocity, energy, de Broglie wavelength, and Lorentz factor for relativistic electrons. Live chart with SEM/TEM references.', color: '#7C3AED', icon: 'electron', status: 'Stable', url: `${base}lab/electron/` },
      { title: 'Laser Pulse Calculator', description: 'Pulse duration \u2194 bandwidth, peak power from average power, and GDD pulse broadening through dispersive media. For ultrafast laser labs.', color: '#EC4899', icon: 'laser', status: 'Stable', url: `${base}lab/laser/` },
      { title: 'Scientific Unit Converter', description: 'Convert between SI, CGS/ESU, and atomic units for 11 physical quantities used in nanophotonics, quantum mechanics, and electromagnetism.', color: '#06B6D4', icon: 'ruler', status: 'Stable', url: `${base}lab/units/` },
    ],
  },
  {
    name: 'Method selection',
    widgets: [
      { title: 'Methods Assistant', description: 'Given a computational photonics problem, find the right numerical method. Semantic search over course notes, with optional Claude AI synthesis.', color: '#64748B', icon: 'chat', status: 'Experimental', url: `${base}lab/assistant/` },
    ],
  },
];
---

<Layout title="Lab" description="Interactive nanophotonics simulation tools running entirely in your browser — Mie, BEM, RCWA, BPM, plasmonics, electron and laser calculators.">
  <section class="page-hero">
    <div class="container">
      <h1>
        Nanophotonics Simulation
        <span class="hero__gradient-text">Toolkit</span>
      </h1>
      <p class="page-hero__subtitle">
        Interactive tools running entirely in your browser — no installation required.
      </p>
    </div>
  </section>

  {categories.map(cat => (
  <section class="section">
    <div class="container">
      <h2 class="cat-heading">{cat.name}</h2>
      <div class="widgets-grid">
        {cat.widgets.map(widget => (
          <a href={widget.url} class="widget-card card" data-status={widget.status}>
            <div class="widget-card__header">
              <div class="widget-card__icon" style={`background: ${widget.color}15; color: ${widget.color}`}>
                {widget.icon === 'bolt' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                )}
                {widget.icon === 'plasmon' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M4 12c2.2-5 4.8-5 8 0s5.8 5 8 0"/>
                    <path d="M4 12c2.2 5 4.8 5 8 0s5.8-5 8 0"/>
                    <path d="M12 4v2"/><path d="M12 18v2"/>
                  </svg>
                )}
                {widget.icon === 'electron' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <ellipse cx="12" cy="12" rx="10" ry="4"/>
                    <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/>
                    <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>
                  </svg>
                )}
                {widget.icon === 'cylinder' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <ellipse cx="12" cy="5" rx="8" ry="2.5"/>
                    <path d="M4 5v14"/>
                    <path d="M20 5v14"/>
                    <ellipse cx="12" cy="19" rx="8" ry="2.5"/>
                  </svg>
                )}
                {widget.icon === 'flame' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
                  </svg>
                )}
                {widget.icon === 'photon' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12 C 5 6, 9 18, 12 12 S 19 6, 22 12"/>
                    <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                  </svg>
                )}
                {widget.icon === 'ruler' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.4 2.4 0 0 1 0-3.4l2.6-2.6a2.4 2.4 0 0 1 3.4 0z"/>
                    <path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/>
                  </svg>
                )}
                {widget.icon === 'wave' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12c2-4 4 4 6 0s4 4 6 0 4 4 6 0 4 4 6 0"/>
                  </svg>
                )}
                {widget.icon === 'laser' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12h8"/><path d="M14 12h8"/>
                    <circle cx="12" cy="12" r="2"/>
                    <circle cx="12" cy="12" r="5" stroke-dasharray="2 2"/>
                  </svg>
                )}
                {widget.icon === 'cube' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                  </svg>
                )}
                {widget.icon === 'chat' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    <path d="M8 9h8"/><path d="M8 13h4"/>
                  </svg>
                )}
                {widget.icon === 'grating' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4v16"/><path d="M8 4v16"/><path d="M12 4v16"/><path d="M16 4v16"/><path d="M20 4v16"/>
                  </svg>
                )}
                {widget.icon === 'layers' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                    <polyline points="2 17 12 22 22 17"/>
                    <polyline points="2 12 12 17 22 12"/>
                  </svg>
                )}
              </div>
              <span class:list={['widget-status', {
                'widget-status--stable': widget.status === 'Stable',
                'widget-status--beta': widget.status === 'Beta',
                'widget-status--experimental': widget.status === 'Experimental',
              }]}>
                {widget.status}
              </span>
            </div>
            <h3>{widget.title}</h3>
            <p>{widget.description}</p>
            {widget.status !== 'Coming soon' && (
              <span class="widget-cta">
                Launch simulator &rarr;
              </span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>
  ))}
</Layout>

<style>
  .page-hero {
    padding: calc(var(--space-3xl) + var(--space-lg)) 0 var(--space-xl);
    background: var(--bg-soft);
  }

  .page-hero h1 {
    margin-bottom: var(--space-md);
  }

  .page-hero__subtitle {
    font-size: 1.25rem;
    max-width: 600px;
  }

  .hero__gradient-text {
    background: var(--spectrum);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .cat-heading {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-lg);
  }

  .widgets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-lg);
  }

  .widget-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .widget-card[data-status="Coming soon"] {
    opacity: 0.7;
    cursor: default;
  }

  .widget-card[data-status="Coming soon"]:hover {
    transform: none;
    box-shadow: none;
  }

  .widget-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .widget-card__icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .widget-status {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--bg-muted);
    color: var(--text-muted);
  }

  .widget-status--stable {
    background: #ECFDF5;
    color: #059669;
  }

  .widget-status--beta {
    background: #FEF3C7;
    color: #D97706;
  }

  .widget-status--experimental {
    background: #FEE2E2;
    color: #DC2626;
  }

  .widget-card h3 {
    font-size: 1.125rem;
  }

  .widget-card p {
    font-size: 0.9375rem;
    flex-grow: 1;
  }

  .widget-cta {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--primary);
    transition: gap 0.2s;
  }

  .widget-card:hover .widget-cta {
    color: var(--primary-dark);
  }

  @media (max-width: 768px) {
    .widgets-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
