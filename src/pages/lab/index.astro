---
import Layout from '../../layouts/Layout.astro';

const widgets = [
  {
    title: 'Mie Scattering Calculator',
    description: 'Compute scattering, extinction, and absorption cross-sections for spherical nanoparticles. Supports real materials (Au, Ag, Si, Al, TiO\u2082) and custom dielectrics.',
    color: '#F59E0B',
    icon: 'bolt',
    status: 'Live',
    url: '/lab/mie-scattering/',
  },
  {
    title: 'Relativistic Electron Calculator',
    description: 'Convert between velocity, energy, de Broglie wavelength, and Lorentz factor for relativistic electrons. Live chart with SEM/TEM references.',
    color: '#7C3AED',
    icon: 'electron',
    status: 'Live',
    url: '/lab/electron/',
  },
  {
    title: 'Photon Calculator',
    description: 'Convert between wavelength, energy, frequency, angular frequency, wavenumber, and period for photons. Live spectrum chart with common laser lines.',
    color: '#10B981',
    icon: 'photon',
    status: 'Live',
    url: '/lab/photon/',
  },
  {
    title: 'Scientific Unit Converter',
    description: 'Convert between SI, CGS/ESU, and atomic units for 11 physical quantities used in nanophotonics, quantum mechanics, and electromagnetism.',
    color: '#06B6D4',
    icon: 'ruler',
    status: 'Live',
    url: '/lab/units/',
  },
];
---

<Layout title="Lab" description="Interactive simulation tools for nanophotonics — explore, learn, and play.">
  <section class="page-hero">
    <div class="container">
      <h1>
        Simulation
        <span class="hero__gradient-text">playground</span>
      </h1>
      <p class="page-hero__subtitle">
        Interactive tools built by our lab. Explore nanophotonic phenomena
        right in your browser — no installation required.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="widgets-grid">
        {widgets.map(widget => (
          <a href={widget.url} class="widget-card card" data-status={widget.status}>
            <div class="widget-card__header">
              <div class="widget-card__icon" style={`background: ${widget.color}15; color: ${widget.color}`}>
                {widget.icon === 'bolt' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                  </svg>
                )}
                {widget.icon === 'electron' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <ellipse cx="12" cy="12" rx="10" ry="4"/>
                    <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/>
                    <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>
                  </svg>
                )}
                {widget.icon === 'photon' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12 C 5 6, 9 18, 12 12 S 19 6, 22 12"/>
                    <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                  </svg>
                )}
                {widget.icon === 'ruler' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.4 2.4 0 0 1 0-3.4l2.6-2.6a2.4 2.4 0 0 1 3.4 0z"/>
                    <path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/>
                  </svg>
                )}
              </div>
              <span class:list={['widget-status', { 'widget-status--live': widget.status === 'Live' }]}>
                {widget.status}
              </span>
            </div>
            <h3>{widget.title}</h3>
            <p>{widget.description}</p>
            {widget.status === 'Live' && (
              <span class="widget-cta">
                Launch simulator &rarr;
              </span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: calc(var(--space-3xl) + var(--space-lg)) 0 var(--space-xl);
    background: var(--bg-soft);
  }

  .page-hero h1 {
    margin-bottom: var(--space-md);
  }

  .page-hero__subtitle {
    font-size: 1.25rem;
    max-width: 600px;
  }

  .hero__gradient-text {
    background: var(--spectrum);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .widgets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-lg);
  }

  .widget-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .widget-card[data-status="Coming soon"] {
    opacity: 0.7;
    cursor: default;
  }

  .widget-card[data-status="Coming soon"]:hover {
    transform: none;
    box-shadow: none;
  }

  .widget-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .widget-card__icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .widget-status {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--bg-muted);
    color: var(--text-muted);
  }

  .widget-status--live {
    background: #ECFDF5;
    color: #059669;
  }

  .widget-card h3 {
    font-size: 1.125rem;
  }

  .widget-card p {
    font-size: 0.9375rem;
    flex-grow: 1;
  }

  .widget-cta {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--primary);
    transition: gap 0.2s;
  }

  .widget-card:hover .widget-cta {
    color: var(--primary-dark);
  }

  @media (max-width: 768px) {
    .widgets-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
