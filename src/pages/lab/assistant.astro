---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Methods Assistant" description="Conversational assistant for picking the right numerical method in nanophotonics — Mie, BEM, DGTD, RCWA. Placeholder preview; real knowledge base coming in May 2026.">
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Methods <span class="gradient-text">Assistant</span></h1>
      <p class="widget-hero__subtitle">
        Describe your problem and get a recommendation of the right numerical method
        (Mie, BEM, DGTD, RCWA&hellip;), relevant references, and a direct link to the tool in our Lab.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="warning-banner">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
          <path d="M12 9v4"/><path d="M12 17h.01"/>
        </svg>
        <div>
          <strong>Heavy warning: experimental, and honestly a bit dumb.</strong>
          This assistant does <em>not</em> reason and does <em>not</em> use an LLM.
          It runs semantic search with <code>all-MiniLM-L6-v2</code> over a small
          internal corpus of course notes, and returns the most similar passages verbatim.
          No synthesis, no memory between turns, no guarantee the retrieved passage actually
          answers your question. Treat every answer as a hint, not a statement. More
          material will be added as it is curated.
        </div>
      </div>

      <div class="chat-card card">
        <header class="chat-header">
          <div class="chat-avatar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a10 10 0 1 0 10 10"/>
              <path d="M12 6v6l4 2"/>
              <circle cx="18" cy="6" r="3"/>
            </svg>
          </div>
          <div class="chat-title-wrap">
            <h3 class="chat-title">Methods Assistant</h3>
            <span class="chat-subtitle">Nanophotonics solver recommendations</span>
          </div>
          <span class="chat-badge" title="Semantic retrieval over course script — no LLM, no hallucination">Retrieval</span>
          <button id="clear-btn" class="chat-clear" title="Clear conversation" aria-label="Clear">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6 18 20a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
            </svg>
          </button>
        </header>

        <div class="chat-scroll" id="chat-scroll">
          <div class="empty-state" id="empty-state">
            <div class="empty-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
            </div>
            <h4>Ask the notes</h4>
            <p>
              Semantic search over an internal corpus of computational-photonics course notes.
              Ask a physics or numerical-method question and I return the most relevant
              passages with their section and page.
              <br/><strong>First query downloads the embedding model (~20&nbsp;MB, cached).</strong>
            </p>
            <div class="examples">
              <button class="example" data-prompt="How does the Yee grid work for FDTD in 3D?">
                Yee grid for FDTD in 3D
              </button>
              <button class="example" data-prompt="What is the Crank-Nicolson method used for in BPM?">
                Crank&ndash;Nicolson in BPM
              </button>
              <button class="example" data-prompt="How to implement perfectly matched layer boundaries?">
                PML boundary conditions
              </button>
              <button class="example" data-prompt="Weak formulation for the finite element method in photonics">
                FEM weak formulation
              </button>
            </div>
          </div>
        </div>

        <form class="chat-input-form" id="chat-form">
          <textarea id="chat-input" class="chat-input" rows="1" placeholder="Describe your problem&hellip; (Enter to send, Shift+Enter for newline)" autocomplete="off"></textarea>
          <button type="submit" class="chat-send" id="chat-send" aria-label="Send" data-umami-event="assistant-query">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>
            </svg>
          </button>
        </form>
      </div>

      <p class="chat-disclaimer">
        <strong>How it works:</strong> your query is embedded in the browser with
        <code>all-MiniLM-L6-v2</code> (via <a href="https://huggingface.co/docs/transformers.js" target="_blank" rel="noopener">Transformers.js</a>)
        and matched by cosine similarity against a few hundred pre-computed chunks of internal
        course notes. No LLM, no server, no hallucination &mdash; every passage you see is a
        literal excerpt. More material will be added as it is curated.
      </p>
    </div>
  </section>
</Layout>

<!-- ===== Scoped styles ===== -->
<style>
  .widget-hero { padding: calc(var(--space-3xl) + var(--space-lg)) 0 var(--space-xl); background: var(--bg-soft); }
  .widget-hero h1 { margin-bottom: var(--space-sm); }
  .widget-hero__subtitle { font-size: 1.125rem; max-width: 620px; }
  .gradient-text { background: var(--spectrum); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .back-link { display: inline-block; margin-bottom: var(--space-md); font-size: 0.875rem; font-weight: 500; color: var(--text-soft); }
  .back-link:hover { color: var(--primary); }

  /* Warning banner */
  .warning-banner {
    max-width: 760px;
    margin: 0 auto var(--space-md);
    padding: var(--space-md);
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    border: 1px solid #F59E0B;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #FFFBEB, #FEF3C7);
    color: #78350F;
  }
  .warning-banner svg { color: #D97706; flex-shrink: 0; margin-top: 1px; }
  .warning-banner div { font-size: 0.8125rem; line-height: 1.6; }
  .warning-banner strong { color: #78350F; display: inline; }
  .warning-banner em { color: #92400E; font-style: italic; }
  .warning-banner code {
    font-family: 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.85em;
    background: rgba(217,119,6,0.15);
    color: #92400E;
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
  }

  /* Chat card */
  .chat-card {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    height: 640px;
    padding: 0;
    overflow: hidden;
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-bottom: 1px solid var(--bg-muted);
    background: var(--bg-soft);
  }
  .chat-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #8B5CF6, #6366F1);
    color: white;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .chat-title-wrap { flex: 1; display: flex; flex-direction: column; gap: 0; }
  .chat-title { font-size: 0.9375rem; font-weight: 600; color: var(--text); }
  .chat-subtitle { font-size: 0.75rem; color: var(--text-muted); }
  .chat-badge {
    font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem; border-radius: var(--radius-full);
    background: rgba(139,92,246,0.12); color: #6D28D9;
  }
  .chat-clear {
    width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--bg-muted); border-radius: var(--radius-sm);
    background: var(--bg); color: var(--text-muted); cursor: pointer; transition: all 0.15s;
  }
  .chat-clear:hover { color: var(--rose); border-color: var(--rose); }

  /* Scroll area */
  .chat-scroll {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-lg) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Empty state */
  .empty-state {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    text-align: center;
    padding: var(--space-lg);
  }
  .empty-icon {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: var(--bg-soft);
    color: #8B5CF6;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: var(--space-xs);
  }
  .empty-state h4 { font-size: 1rem; font-weight: 600; }
  .empty-state p {
    font-size: 0.875rem;
    color: var(--text-soft);
    max-width: 480px;
    line-height: 1.55;
  }
  .examples {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs);
    margin-top: var(--space-md);
    width: 100%;
    max-width: 560px;
  }
  .example {
    text-align: left;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-md);
    background: var(--bg);
    font-family: var(--font);
    font-size: 0.8125rem;
    color: var(--text-soft);
    cursor: pointer;
    transition: all 0.15s;
    line-height: 1.4;
  }
  .example:hover {
    border-color: #8B5CF6;
    color: var(--text);
    background: rgba(139,92,246,0.04);
  }

  /* Messages */
  .msg {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    max-width: 100%;
  }
  .msg--user { flex-direction: row-reverse; }
  .msg-bubble {
    max-width: 80%;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    line-height: 1.55;
    word-wrap: break-word;
  }
  .msg--user .msg-bubble {
    background: #6366F1;
    color: white;
    border-top-right-radius: 4px;
  }
  .msg--assistant .msg-bubble {
    background: var(--bg-soft);
    color: var(--text);
    border: 1px solid var(--bg-muted);
    border-top-left-radius: 4px;
  }
  .msg-bubble p { margin: 0 0 0.5rem 0; }
  .msg-bubble p:last-child { margin-bottom: 0; }
  .msg-bubble a { color: #8B5CF6; font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; }
  .msg-bubble a:hover { color: #6D28D9; }
  .msg--user .msg-bubble a { color: #FDE68A; }
  .msg-bubble code {
    background: rgba(139,92,246,0.12);
    color: #6D28D9;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    font-size: 0.85em;
    font-family: 'SF Mono', Menlo, Consolas, monospace;
  }
  .msg--user .msg-bubble code { background: rgba(255,255,255,0.18); color: #FDE68A; }
  .msg-icon {
    width: 28px; height: 28px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    font-size: 0.6875rem;
    font-weight: 700;
  }
  .msg--assistant .msg-icon {
    background: linear-gradient(135deg, #8B5CF6, #6366F1);
    color: white;
  }
  .msg--user .msg-icon {
    background: var(--bg-muted);
    color: var(--text-muted);
  }

  .typing-row { display: inline-flex; align-items: center; gap: 0.6rem; }
  .typing-status { font-size: 0.75rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .typing {
    display: inline-flex; gap: 4px; padding: 0.2rem 0;
  }
  .typing span {
    width: 6px; height: 6px; border-radius: 50%;
    background: #8B5CF6;
    animation: bounce 1.2s infinite ease-in-out;
  }
  .typing span:nth-child(2) { animation-delay: 0.15s; }
  .typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  /* Retrieved passages */
  .passage {
    margin-top: 0.6rem;
    padding: 0.55rem 0.75rem;
    border-left: 2px solid #8B5CF6;
    background: rgba(139,92,246,0.04);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .passage-header {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 0.25rem;
    font-size: 0.6875rem;
  }
  .passage-page { font-weight: 700; color: #6D28D9; text-transform: uppercase; letter-spacing: 0.05em; }
  .passage-score { color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .passage-path {
    display: block;
    font-size: 0.6875rem;
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 0.35rem;
  }
  .passage-text {
    font-size: 0.8125rem;
    color: var(--text-soft);
    line-height: 1.55;
    font-family: 'Iowan Old Style', 'Georgia', serif;
  }
  .passage-text p { margin: 0 0 0.5rem 0 !important; }
  .passage-text p:last-child { margin-bottom: 0 !important; }
  .passage-text .katex { font-size: 1em; }
  .passage-text .katex-display { margin: 0.4rem 0; }

  /* Input form */
  .chat-input-form {
    display: flex;
    gap: var(--space-xs);
    align-items: flex-end;
    padding: var(--space-sm) var(--space-md);
    border-top: 1px solid var(--bg-muted);
    background: var(--bg);
  }
  .chat-input {
    flex: 1;
    resize: none;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-md);
    font-family: var(--font);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text);
    background: var(--bg);
    outline: none;
    transition: border-color 0.15s;
    max-height: 120px;
    overflow-y: auto;
  }
  .chat-input:focus { border-color: #8B5CF6; box-shadow: 0 0 0 3px rgba(139,92,246,0.08); }
  .chat-input::placeholder { color: var(--text-muted); }
  .chat-send {
    width: 36px; height: 36px;
    display: flex; align-items: center; justify-content: center;
    border: none;
    border-radius: var(--radius-md);
    background: #8B5CF6;
    color: white;
    cursor: pointer;
    transition: all 0.15s;
    flex-shrink: 0;
  }
  .chat-send:hover { background: #7C3AED; }
  .chat-send:disabled { background: var(--bg-muted); color: var(--text-muted); cursor: not-allowed; }

  .chat-disclaimer {
    max-width: 760px;
    margin: var(--space-md) auto 0;
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.55;
    text-align: center;
  }
  .chat-disclaimer strong { color: var(--text-soft); }
  .chat-disclaimer code { font-family: 'SF Mono', Menlo, Consolas, monospace; background: rgba(139,92,246,0.1); color: #6D28D9; padding: 0.05rem 0.3rem; border-radius: 3px; font-size: 0.9em; }
  .chat-disclaimer a { color: #8B5CF6; font-weight: 600; }

  @media (max-width: 640px) {
    .chat-card { height: 560px; }
    .examples { grid-template-columns: 1fr; }
    .msg-bubble { max-width: 90%; }
  }
</style>

<!-- ===== Script ===== -->
<script>
  import { pipeline, env } from '@huggingface/transformers';
  import renderMathInElement from 'katex/dist/contrib/auto-render.mjs';
  import 'katex/dist/katex.min.css';

  // Transformers.js: fetch model weights from HF Hub, cache in browser.
  env.allowLocalModels = false;
  env.useBrowserCache = true;

  // ===== Retrieval state =====

  interface CorpusChunk {
    id: number;
    text: string;
    section_path?: string;
    section_title?: string;
    page_start?: number;
    page_end?: number;
  }
  interface Corpus {
    model: string;
    dim: number;
    quantization: string;
    quant_scale: number;
    source: { file: string; title: string; author: string; institution: string; year: number };
    chunks: CorpusChunk[];
    vectors: Float32Array[]; // dequantized at load time
  }

  let corpus: Corpus | null = null;
  let extractor: any = null;
  let readyPromise: Promise<void> | null = null;
  const MIN_SIMILARITY = 0.25;

  async function loadCorpus(): Promise<Corpus> {
    const res = await fetch('/data/cpho16_embeddings.json');
    if (!res.ok) throw new Error(`corpus fetch failed: ${res.status}`);
    const raw = await res.json();
    const scale = raw.quant_scale || 127;
    const vecs: Float32Array[] = raw.vectors.map((v: number[]) => {
      const f = new Float32Array(v.length);
      for (let i = 0; i < v.length; i++) f[i] = v[i] / scale;
      // Renormalize after dequantization (quantization errors slightly perturb unit length)
      let n = 0;
      for (let i = 0; i < f.length; i++) n += f[i] * f[i];
      n = Math.sqrt(n);
      if (n > 0) for (let i = 0; i < f.length; i++) f[i] /= n;
      return f;
    });
    return { ...raw, vectors: vecs };
  }

  async function ensureReady(onProgress?: (msg: string) => void): Promise<void> {
    if (!readyPromise) {
      readyPromise = (async () => {
        onProgress?.('Loading knowledge base…');
        corpus = await loadCorpus();
        onProgress?.('Downloading embedding model (one-time, ~20 MB)…');
        extractor = await pipeline('feature-extraction', 'Xenova/all-MiniLM-L6-v2', {
          progress_callback: (p: any) => {
            if (p?.status === 'progress' && typeof p.progress === 'number') {
              onProgress?.(`Downloading model… ${p.progress.toFixed(0)}%`);
            } else if (p?.status === 'ready') {
              onProgress?.('Model ready.');
            }
          },
        });
      })();
    }
    return readyPromise;
  }

  interface Hit { score: number; chunk: CorpusChunk; }

  async function retrieve(query: string, topK = 3): Promise<Hit[]> {
    if (!corpus || !extractor) return [];
    const out = await extractor(query, { pooling: 'mean', normalize: true });
    const q = out.data as Float32Array;
    const sims = new Float32Array(corpus.vectors.length);
    for (let i = 0; i < corpus.vectors.length; i++) {
      const v = corpus.vectors[i];
      let s = 0;
      for (let k = 0; k < v.length; k++) s += v[k] * q[k];
      sims[i] = s;
    }
    const idx = Array.from(sims.keys()).sort((a, b) => sims[b] - sims[a]).slice(0, topK);
    return idx.map(i => ({ score: sims[i], chunk: corpus!.chunks[i] }));
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function renderHits(hits: Hit[]): string {
    if (!corpus) return `<p>Corpus not loaded.</p>`;
    const good = hits.filter(h => h.score >= MIN_SIMILARITY);
    if (good.length === 0) {
      return `
        <p>I couldn't find anything relevant in my current corpus.</p>
        <p>Try rephrasing with more method/physics terms (e.g. "FDTD boundary conditions",
        "BPM wide-angle Padé", "finite-element weak formulation"), or explore
        <a href="/lab/">the Lab</a> directly.</p>
      `;
    }
    const header = `<p>Relevant passages from the internal course-notes corpus:</p>`;
    const blocks = good.map(h => {
      const c = h.chunk;
      let cite: string;
      if (c.section_title) {
        cite = escapeHtml(c.section_title);
      } else if (c.page_start != null && c.page_end != null) {
        cite = c.page_start === c.page_end ? `p. ${c.page_start}` : `pp. ${c.page_start}–${c.page_end}`;
      } else {
        cite = `chunk #${c.id}`;
      }
      const pathLine = c.section_path ? `<span class="passage-path">${escapeHtml(c.section_path)}</span>` : '';
      const pct = (h.score * 100).toFixed(0);
      return `
        <div class="passage">
          <div class="passage-header">
            <span class="passage-page">${cite}</span>
            <span class="passage-score">similarity ${pct}%</span>
          </div>
          ${pathLine}
          <div class="passage-text">${renderPassageBody(c.text)}</div>
        </div>
      `;
    }).join('');
    return header + blocks;
  }

  /**
   * Convert a raw markdown-ish chunk to safe HTML.
   * Preserves paragraph breaks and inline math delimiters ($...$, $$...$$, \(...\), \[...\])
   * which KaTeX auto-render will replace after insertion.
   */
  function renderPassageBody(text: string): string {
    // Split on blank lines → paragraphs. Preserve math as-is.
    const paras = text.split(/\n\s*\n/).map(p => p.trim()).filter(Boolean);
    return paras.map(p => `<p>${escapeHtml(p).replace(/\n/g, ' ')}</p>`).join('');
  }

  // ===== Chat logic =====

  interface Message { role: 'user' | 'assistant'; html: string; }
  const messages: Message[] = [];

  const scrollEl = document.getElementById('chat-scroll') as HTMLElement;
  const emptyEl = document.getElementById('empty-state') as HTMLElement;
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLTextAreaElement;
  const sendBtn = document.getElementById('chat-send') as HTMLButtonElement;
  const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;

  function scrollToBottom() { scrollEl.scrollTop = scrollEl.scrollHeight; }

  function renderMessage(msg: Message): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = `msg msg--${msg.role}`;
    const icon = document.createElement('div');
    icon.className = 'msg-icon';
    icon.textContent = msg.role === 'user' ? 'You' : 'MA';
    const bubble = document.createElement('div');
    bubble.className = 'msg-bubble';
    bubble.innerHTML = msg.html;
    wrap.appendChild(icon);
    wrap.appendChild(bubble);
    return wrap;
  }

  function addMessage(role: 'user' | 'assistant', html: string): HTMLElement {
    if (emptyEl.parentElement) emptyEl.remove();
    const msg: Message = { role, html };
    messages.push(msg);
    const el = renderMessage(msg);
    scrollEl.appendChild(el);
    scrollToBottom();
    if (role === 'assistant') {
      const bubble = el.querySelector('.msg-bubble') as HTMLElement | null;
      if (bubble) {
        try {
          renderMathInElement(bubble, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '\\[', right: '\\]', display: true },
              { left: '$', right: '$', display: false },
              { left: '\\(', right: '\\)', display: false },
            ],
            throwOnError: false,
          });
        } catch {}
      }
    }
    return el;
  }

  function addTyping(statusText = ''): { el: HTMLElement; setStatus: (s: string) => void } {
    const wrap = document.createElement('div');
    wrap.className = 'msg msg--assistant';
    wrap.id = 'typing-indicator';
    wrap.innerHTML = `
      <div class="msg-icon">MA</div>
      <div class="msg-bubble">
        <div class="typing-row">
          <div class="typing"><span></span><span></span><span></span></div>
          <span class="typing-status" id="typing-status">${statusText}</span>
        </div>
      </div>
    `;
    scrollEl.appendChild(wrap);
    scrollToBottom();
    const setStatus = (s: string) => {
      const el = document.getElementById('typing-status');
      if (el) el.textContent = s;
      scrollToBottom();
    };
    return { el: wrap, setStatus };
  }

  function removeTyping() {
    const el = document.getElementById('typing-indicator');
    if (el) el.remove();
  }

  async function send(text: string) {
    const trimmed = text.trim();
    if (!trimmed) return;
    addMessage('user', `<p>${escapeHtml(trimmed)}</p>`);
    input.value = '';
    autosize();
    sendBtn.disabled = true;

    const typing = addTyping('Thinking…');
    try {
      await ensureReady((msg) => typing.setStatus(msg));
      typing.setStatus('Searching corpus…');
      const hits = await retrieve(trimmed, 3);
      removeTyping();
      addMessage('assistant', renderHits(hits));
    } catch (err) {
      removeTyping();
      addMessage('assistant', `<p>Something went wrong loading the corpus or the embedding model: <code>${escapeHtml((err as Error).message)}</code>. Check your network connection — the model is fetched from the Hugging Face CDN on first use.</p>`);
    } finally {
      sendBtn.disabled = false;
      input.focus();
    }
  }

  function autosize() {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 120) + 'px';
  }

  // ===== Event bindings =====

  form.addEventListener('submit', (e) => { e.preventDefault(); send(input.value); });

  input.addEventListener('input', autosize);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      send(input.value);
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.example').forEach(btn => {
    btn.addEventListener('click', () => {
      const prompt = btn.dataset.prompt || btn.textContent || '';
      send(prompt);
    });
  });

  clearBtn.addEventListener('click', () => {
    messages.length = 0;
    scrollEl.innerHTML = '';
    scrollEl.appendChild(emptyEl);
    input.focus();
  });

  input.focus();

</script>
