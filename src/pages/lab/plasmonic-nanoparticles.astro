  function nlSyncTempField() {
    const g = nl.material === 'graphene';
    ($('nl-temp-field') as HTMLElement).hidden = !g;
    const tEl = $('nl-temp') as HTMLInputElement, tSl = $('nl-temp-slider') as HTMLInputElement;
