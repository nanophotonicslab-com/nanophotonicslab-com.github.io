      return;
    }
    const axisLabel = axisMode === 'energy-ev' ? 'energy eV' : axisMode === 'wavelength-nm' ? 'wavelength nm' : 'wavelength um';
    const valueLabel = valueMode === 'epsilon' ? 'epsilon' : 'n,k';
    const label = `${pendingMaterialImport.fileName} (${converted.data.length} points, ${axisLabel}, ${valueLabel})`;
    pendingMaterialImport.onAccept(converted.data, label);
    pendingMaterialImport = null;
    materialImportDialog.close();
