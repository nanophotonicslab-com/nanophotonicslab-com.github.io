    .shape-strip__header { align-items: flex-start; flex-direction: column; gap: 0.2rem; }
  }
</style>

<script>
  import { MATERIALS } from '../../data/optical-constants';
  import { loadCatalog, fetchMaterialNK, searchCatalog } from '../../data/refractiveindex';
  import type { RIIMaterial } from '../../data/refractiveindex';
  import { chartTheme, onThemeChange } from '../../lib/chart-theme';
  import { spectrumToHex } from '../../lib/colorimetry';
  import {
    SHAPE_OPTIONS,
    availableModeCount,
    computePlasmonSpectrum,
    drudeEpsilon,
    epsilonFromNKData,
    epsilonFromMaterial,
    nearestIndex,
    validityNotes,
  } from '../../lib/plasmonic-nanoparticles';
  import type { Complex, PlasmonShapeId, PlasmonSpectrum } from '../../lib/plasmonic-nanoparticles';

  type TabId = 'spectrum' | 'material' | 'resonance' | 'ldos';
  type ResonanceSweep = 'L' | 'R';

  const colors = {
    ext: '#10B981',
    abs: '#EF4444',
    sca: '#3B82F6',
    re: '#7C3AED',
    im: '#F59E0B',
    peak: '#F43F5E',
    ldos: '#06B6D4',
    fe: '#8B5CF6',
  };
  const LDOS_PROBE_DISTANCE_NM = 5;
  const COLOR_LAMBDA_MIN_NM = 380;
  const COLOR_LAMBDA_MAX_NM = 780;

  const state: {
    materialId: string;
    drudeEpsB: number;
    drudeWpEv: number;
    drudeGammaEv: number;
    shape: PlasmonShapeId;
    lengthNm: number;
    aspectRatio: number;
    hostIndex: number;
    lambdaMinNm: number;
    lambdaMaxNm: number;
    modeCount: number;
    tab: TabId;
    resonanceSweep: ResonanceSweep;
  } = {
    materialId: 'au',
    drudeEpsB: 9.5,
    drudeWpEv: 9.06,
    drudeGammaEv: 0.071,
    shape: 'rod',
    lengthNm: 50,
    aspectRatio: 4,
    hostIndex: 1.33,
    lambdaMinNm: 550,
    lambdaMaxNm: 1250,
    modeCount: 1,
    tab: 'spectrum',
    resonanceSweep: 'L',
  };

  let result: PlasmonSpectrum | null = null;
  let uploadedMaterial: number[][] | null = null;
  let selectedDatabaseMaterial: number[][] | null = null;
  let selectedDatabaseLabel = '';
  let catalogPromise: Promise<RIIMaterial[]> | null = null;
  let lastShapeGalleryShape = '';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  function syncNumberInput(id: string, value: string) {
    const input = $<HTMLInputElement>(id);
    if (document.activeElement !== input) input.value = value;
  }

  function parseNKFile(text: string): { data: number[][]; unit: string } | { error: string } {
    const lines = text.split(/\r?\n/).map(line => line.trim()).filter(line => line && !line.startsWith('#') && !line.startsWith('%'));
    if (lines.length < 2) return { error: 'File must have at least 2 data rows' };

    let delimiter = /\t/;
    if (lines[0].split(delimiter).length < 3) delimiter = /,/;
    if (lines[0].split(delimiter).length < 3) delimiter = /\s+/;

    const first = lines[0].split(delimiter)[0];
    const start = Number.isNaN(Number.parseFloat(first)) ? 1 : 0;
    const data: number[][] = [];
    for (let i = start; i < lines.length; i++) {
      const parts = lines[i].split(delimiter).map(Number);
      if (parts.length < 2 || Number.isNaN(parts[0]) || Number.isNaN(parts[1])) continue;
      data.push([parts[0], parts[1], parts.length >= 3 && !Number.isNaN(parts[2]) ? Math.abs(parts[2]) : 0]);
    }
    if (data.length < 2) return { error: 'Could not parse at least 2 data rows' };

    data.sort((a, b) => a[0] - b[0]);
    const maxLambda = data[data.length - 1][0];
    let unit = 'um';
    if (maxLambda > 50) {
      unit = 'nm';
      for (const row of data) row[0] /= 1000;
    }
    return { data, unit };
  }

  function currentEpsilon(lambdaNm: number): Complex {
    if (state.materialId === 'drude') {
      return drudeEpsilon(lambdaNm, state.drudeEpsB, state.drudeWpEv, state.drudeGammaEv);
    }
    if (state.materialId === 'file' && uploadedMaterial) {
      return epsilonFromNKData(uploadedMaterial, lambdaNm);
    }
    if (state.materialId === 'rii' && selectedDatabaseMaterial) {
      return epsilonFromNKData(selectedDatabaseMaterial, lambdaNm);
    }
    if (!MATERIALS[state.materialId]) {
      return epsilonFromMaterial('au', lambdaNm);
    }
    return epsilonFromMaterial(state.materialId, lambdaNm);
  }

  function fmt(value: number, digits = 3): string {
    if (!Number.isFinite(value)) return '—';
    if (value === 0) return '0';
    const abs = Math.abs(value);
    if (abs < 1e-3 || abs >= 1e5) return value.toExponential(digits - 1);
    return Number.parseFloat(value.toPrecision(digits)).toString();
  }

  function fmtFixed(value: number, digits = 0): string {
    return Number.isFinite(value) ? value.toFixed(digits) : '—';
  }

  function shapeOption(shape: PlasmonShapeId) {
    return SHAPE_OPTIONS.find(option => option.id === shape)!;
  }

  function applyShapeDefaults(shape: PlasmonShapeId) {
    const opt = shapeOption(shape);
    state.shape = shape;
    if (opt.defaultMaterialId) state.materialId = opt.defaultMaterialId;
    state.lengthNm = opt.defaultLengthNm;
    state.aspectRatio = opt.defaultR;
    state.modeCount = availableModeCount(shape);
    if (opt.defaultLambdaMinNm) state.lambdaMinNm = opt.defaultLambdaMinNm;
    if (opt.defaultLambdaMaxNm) state.lambdaMaxNm = opt.defaultLambdaMaxNm;
  }

  function sanitizeState() {
    const opt = shapeOption(state.shape);
    state.lengthNm = clamp(state.lengthNm, 5, 300);
    state.aspectRatio = clamp(state.aspectRatio, opt.minR, opt.maxR);
    state.hostIndex = clamp(state.hostIndex, 0.5, 3);
    state.lambdaMinNm = clamp(state.lambdaMinNm, 250, 2200);
    state.lambdaMaxNm = clamp(state.lambdaMaxNm, 260, 2400);
    if (state.lambdaMaxNm <= state.lambdaMinNm + 20) state.lambdaMaxNm = state.lambdaMinNm + 20;
    state.modeCount = availableModeCount(state.shape);
    state.drudeEpsB = clamp(state.drudeEpsB, -100, 100);
    state.drudeWpEv = clamp(state.drudeWpEv, 0.01, 50);
    state.drudeGammaEv = clamp(state.drudeGammaEv, 0, 10);
  }

  function clamp(value: number, min: number, max: number): number {
    return Math.min(max, Math.max(min, Number.isFinite(value) ? value : min));
  }

  function compute() {
    sanitizeState();
    result = computePlasmonSpectrum({
      shape: state.shape,
      materialId: state.materialId,
      epsilonAt: currentEpsilon,
      lengthNm: state.lengthNm,
      aspectRatio: state.aspectRatio,
      hostIndex: state.hostIndex,
      lambdaMinNm: state.lambdaMinNm,
      lambdaMaxNm: state.lambdaMaxNm,
      points: 420,
      modeCount: state.modeCount,
    });
  }

  function updateControls() {
    const opt = shapeOption(state.shape);
    const fixedAspect = opt.minR === opt.maxR;

    $('material-select').querySelectorAll('option').forEach(option => {
      (option as HTMLOptionElement).selected = (option as HTMLOptionElement).value === state.materialId;
    });
    $('shape-select').querySelectorAll('option').forEach(option => {
      (option as HTMLOptionElement).selected = (option as HTMLOptionElement).value === state.shape;
    });

    const aspectNum = $<HTMLInputElement>('aspect-num');
    const aspectSlider = $<HTMLInputElement>('aspect-slider');
    aspectNum.min = String(opt.minR);
    aspectNum.max = String(opt.maxR);
    aspectSlider.min = String(opt.minR);
    aspectSlider.max = String(opt.maxR);
    syncNumberInput('aspect-num', state.aspectRatio.toFixed(1));
    aspectSlider.value = String(state.aspectRatio);
    aspectNum.disabled = fixedAspect;
    aspectSlider.disabled = fixedAspect;
    $('aspect-param').classList.toggle('is-disabled', fixedAspect);

    syncNumberInput('length-num', String(state.lengthNm));
    $<HTMLInputElement>('length-slider').value = String(state.lengthNm);
    syncNumberInput('host-num', state.hostIndex.toFixed(2));
    $<HTMLInputElement>('host-slider').value = String(state.hostIndex);
    syncNumberInput('lambda-min', String(state.lambdaMinNm));
    syncNumberInput('lambda-max', String(state.lambdaMaxNm));
    syncNumberInput('drude-epsb', String(state.drudeEpsB));
    syncNumberInput('drude-wp', String(state.drudeWpEv));
    syncNumberInput('drude-gamma', String(state.drudeGammaEv));

    if (fixedAspect && state.resonanceSweep === 'R') state.resonanceSweep = 'L';

    $('drude-panel').style.display = state.materialId === 'drude' ? 'flex' : 'none';
    $('file-upload-group').style.display = state.materialId === 'file' ? 'flex' : 'none';
    $('rii-search-group').style.display = state.materialId === 'rii' ? 'flex' : 'none';
    $('material-ref').textContent = materialReferenceText();
    updateShapeGallery();
    updateGeometrySchematic();
    updateResonanceControls();
    updatePresetActives();
  }

  function updateResonanceControls() {
    const controls = $('resonance-controls');
    const opt = shapeOption(state.shape);
    const fixedAspect = opt.minR === opt.maxR;
    controls.style.display = state.tab === 'resonance' ? 'inline-flex' : 'none';
    controls.querySelectorAll<HTMLButtonElement>('.seg-btn').forEach(btn => {
      const sweep = btn.dataset.sweep as ResonanceSweep;
      btn.classList.toggle('active', sweep === state.resonanceSweep);
      btn.disabled = sweep === 'R' && fixedAspect;
    });
  }

  function materialReferenceText(): string {
    if (state.materialId === 'drude') return 'Tunable Drude dielectric function';
    if (state.materialId === 'file') return uploadedMaterial ? 'Uploaded n,k data' : 'Upload a wavelength, n, k table';
    if (state.materialId === 'rii') return selectedDatabaseLabel || 'Search refractiveindex.info database';
    return MATERIALS[state.materialId]?.ref ?? '';
  }

  function updatePresetActives() {
    $('host-presets').querySelectorAll<HTMLButtonElement>('.preset-btn').forEach(btn => {
      btn.classList.toggle('active', Math.abs(Number(btn.dataset.val) - state.hostIndex) < 0.005);
    });
  }

  function updateShapeGallery() {
    if (lastShapeGalleryShape === state.shape) return;
    lastShapeGalleryShape = state.shape;
    const gallery = $('shape-gallery');
    gallery.innerHTML = SHAPE_OPTIONS.map(option => `
      <button class="shape-card ${option.id === state.shape ? 'active' : ''}" type="button" data-shape="${option.id}" title="${option.label}">
        ${shapeIcon(option.id)}
        <span>${option.label}</span>
      </button>
    `).join('');
  }

  function shapeBody(
    shape: PlasmonShapeId,
    stroke = 'currentColor',
    fill = 'rgba(99,102,241,0.12)',
    innerFill = 'var(--bg)'
  ): string {
    if (shape === 'rod') return `<rect x="12" y="33" width="56" height="14" rx="7" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M18 40h44" stroke="${stroke}" stroke-width="2" opacity=".55"/>`;
    if (shape === 'rod transverse') return `<rect x="33" y="12" width="14" height="56" rx="7" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M40 18v44" stroke="${stroke}" stroke-width="2" opacity=".55"/>`;
    if (shape === 'triangle') return `<path d="M20 40 44 10 68 40Z" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M12 34 36 4 44 10 20 40Z" fill="${fill}" stroke="${stroke}" stroke-width="2" opacity=".55"/><path d="M36 4 68 40M12 34h8" stroke="${stroke}" stroke-width="2" opacity=".45"/>`;
    if (shape === 'cage') return `<rect x="18" y="4" width="44" height="44" rx="5" fill="${fill}" fill-rule="evenodd" stroke="${stroke}" stroke-width="3"/><rect x="31" y="17" width="18" height="18" rx="2" fill="${innerFill}" stroke="${stroke}" stroke-width="2.5"/><path d="M18 26h13M49 26h13M40 4v13M40 35v13" stroke="${stroke}" stroke-width="1.8" opacity=".45"/>`;
    if (shape === 'ellipsoid') return `<ellipse cx="40" cy="26" rx="29" ry="14" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M18 26h44" stroke="${stroke}" stroke-width="2" opacity=".45"/>`;
    if (shape === 'bicone') return `<path d="M10 26 38 10v32Z" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M70 26 42 10v32Z" fill="${fill}" stroke="${stroke}" stroke-width="3"/>`;
    if (shape === 'disk') return `<ellipse cx="40" cy="18" rx="26" ry="8" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M14 18v16c0 4.4 11.6 8 26 8s26-3.6 26-8V18" fill="none" stroke="${stroke}" stroke-width="3"/><ellipse cx="40" cy="34" rx="26" ry="8" fill="${fill}" stroke="${stroke}" stroke-width="3"/>`;
    if (shape === 'ring') return `<ellipse cx="40" cy="26" rx="28" ry="18" fill="${fill}" stroke="${stroke}" stroke-width="3"/><ellipse cx="40" cy="26" rx="13" ry="8" fill="${innerFill}" stroke="${stroke}" stroke-width="3"/><path d="M53 26h15" stroke="${stroke}" stroke-width="2" opacity=".5"/>`;
    if (shape === 'bipyramid') return `<path d="M40 6 67 26 40 46 13 26Z" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M13 26h54M40 6v40" stroke="${stroke}" stroke-width="2" opacity=".45"/>`;
    if (shape === 'squared rod') return `<path d="M16 14h48v24H16Z" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M24 20h32v12H24Z" fill="none" stroke="${stroke}" stroke-width="2" opacity=".45"/>`;
    if (shape === 'cylinder') return `<ellipse cx="18" cy="26" rx="8" ry="16" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M18 10h44M18 42h44" stroke="${stroke}" stroke-width="3"/><ellipse cx="62" cy="26" rx="8" ry="16" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M18 14c5 5 5 19 0 24" stroke="${stroke}" stroke-width="1.8" opacity=".45"/>`;
    if (shape === 'tetrahedron') return `<path d="M40 8 64 42H16Z" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M40 8 40 42M40 42 64 42" stroke="${stroke}" stroke-width="2" opacity=".5"/>`;
    if (shape === 'octahedron') return `<path d="M40 5 64 26 40 47 16 26Z" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M16 26h48M40 5v42" stroke="${stroke}" stroke-width="2" opacity=".5"/>`;
    if (shape === 'decahedron') return `<path d="M40 6 64 18 58 44H22L16 18Z" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M16 18h48M40 6v38" stroke="${stroke}" stroke-width="2" opacity=".45"/>`;
    return `<rect x="10" y="18" width="60" height="16" rx="8" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M14 14c9 8 17 8 26 0s17-8 26 0M14 38c9-8 17-8 26 0s17 8 26 0" fill="none" stroke="${stroke}" stroke-width="2"/>`;
  }

  function shapeViewBox(shape: PlasmonShapeId): string {
    return shape === 'rod' || shape === 'rod transverse' ? '0 0 80 80' : '0 0 80 52';
  }

  function shapeIcon(shape: PlasmonShapeId): string {
    return `<svg viewBox="${shapeViewBox(shape)}">${shapeBody(shape)}</svg>`;
  }

  function schematicObject(shape: PlasmonShapeId): string {
    const viewBox = shapeViewBox(shape);
    const face = shapeBody(shape, 'var(--primary)', 'url(#metal-face)', 'var(--bg-soft)');
    const back = shapeBody(shape, 'rgba(79,70,229,0.55)', 'url(#metal-side)', 'var(--bg-soft)');
    return `
      <g transform="translate(112 55)" filter="url(#schematic-shadow)">
        <ellipse cx="52" cy="92" rx="44" ry="7" fill="rgba(79,70,229,0.14)"></ellipse>
