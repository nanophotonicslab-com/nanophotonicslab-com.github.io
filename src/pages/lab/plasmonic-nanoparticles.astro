---
import Layout from '../../layouts/Layout.astro';
import { MATERIALS } from '../../data/optical-constants';
import { PLASMONIC_MATERIAL_IDS, SHAPE_OPTIONS } from '../../lib/plasmonic-nanoparticles';

const materialOptions = PLASMONIC_MATERIAL_IDS
  .filter(id => MATERIALS[id])
  .map(id => ({ id, label: MATERIALS[id].label, ref: MATERIALS[id].ref }));
---

<Layout title="Plasmonic Nanoparticles Lab" description="Analytical spectra for plasmonic nanoparticles using geometry-only modal parameters and tabulated optical constants.">
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Plasmonic <span class="gradient-text">Nanoparticles</span></h1>
      <p class="widget-hero__subtitle">
        Universal analytical modeling for rods, cages, disks, rings, bipyramids,
        and related shapes. Materials use the same tabulated n,k interpolation as
        the Mie scattering lab.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="shape-strip card">
        <div class="shape-strip__header">
          <span>Geometries</span>
          <span id="shape-strip-current">Nanorod</span>
        </div>
        <div class="shape-gallery shape-gallery--strip" id="shape-gallery" aria-label="Available geometries"></div>
      </div>

      <div class="widget-layout">
        <aside class="controls card">
          <h3>Parameters</h3>

          <div class="param">
            <div class="param-header"><label for="material-select">Material</label></div>
            <select id="material-select" class="param-select">
              {materialOptions.map(material => (
                <option value={material.id} selected={material.id === 'au'}>{material.label}</option>
              ))}
              <option value="drude">Drude model</option>
              <option value="file">Upload file&hellip;</option>
              <option value="rii">Search database&hellip;</option>
            </select>
            <span class="material-ref" id="material-ref">{MATERIALS.au.ref}</span>
            <div class="file-upload-row" id="file-upload-group" style="display:none">
              <input type="file" id="file-upload" accept=".csv,.tsv,.txt,.dat" class="file-input">
              <span class="file-name" id="file-name"></span>
            </div>
            <div class="rii-search" id="rii-search-group" style="display:none">
              <input type="text" id="rii-search" class="param-number rii-input" placeholder="Search materials&hellip;">
              <div class="rii-results" id="rii-results"></div>
              <span class="material-ref" id="rii-status"></span>
            </div>
          </div>

          <div class="param drude-panel" id="drude-panel" style="display:none">
            <span class="drude-formula">&epsilon; = &epsilon;<sub>b</sub> - &omega;<sub>p</sub><sup>2</sup> / [&omega;(&omega; + i&gamma;)]</span>
            <div class="drude-grid">
              <label>
                <span>&epsilon;<sub>b</sub></span>
                <input type="number" class="param-number" id="drude-epsb" value="9.5" step="0.1">
              </label>
              <label>
                <span>&omega;<sub>p</sub> (eV)</span>
                <input type="number" class="param-number" id="drude-wp" value="9.06" step="0.01" min="0.01">
              </label>
              <label>
                <span>&gamma; (eV)</span>
                <input type="number" class="param-number" id="drude-gamma" value="0.071" step="0.001" min="0">
              </label>
            </div>
          </div>

          <div class="param">
            <div class="param-header"><label for="shape-select">Shape</label></div>
            <select id="shape-select" class="param-select">
              {SHAPE_OPTIONS.map(shape => (
                <option value={shape.id} selected={shape.id === 'rod'}>{shape.label}</option>
              ))}
            </select>
          </div>

          <div class="param">
            <div class="param-header">
              <label for="length-num">Length L (nm)</label>
              <input type="number" class="param-number" id="length-num" value="50" step="1" min="5" max="250">
            </div>
            <input type="range" class="param-slider" id="length-slider" min="10" max="220" step="1" value="50">
          </div>

          <div class="param" id="aspect-param">
            <div class="param-header">
              <label for="aspect-num">Aspect ratio R</label>
              <input type="number" class="param-number" id="aspect-num" value="4" step="0.1" min="1" max="8">
            </div>
            <input type="range" class="param-slider" id="aspect-slider" min="1.2" max="8" step="0.1" value="4">
          </div>

          <div class="param">
            <div class="param-header">
              <label for="host-num">n<sub>host</sub></label>
              <input type="number" class="param-number" id="host-num" value="1.33" step="0.01" min="1" max="2.5">
            </div>
            <input type="range" class="param-slider" id="host-slider" min="1" max="2.1" step="0.01" value="1.33">
            <div class="param-presets" id="host-presets">
              <button class="preset-btn" data-val="1.00">Air</button>
              <button class="preset-btn active" data-val="1.33">Water</button>
              <button class="preset-btn" data-val="1.46">Oil</button>
              <button class="preset-btn" data-val="1.50">Glass</button>
            </div>
          </div>

          <div class="param-grid">
            <div class="param">
              <div class="param-header"><label for="lambda-min">Min &lambda; (nm)</label></div>
              <input type="text" inputmode="numeric" class="param-number param-number--wide" id="lambda-min" value="550" autocomplete="off">
            </div>
            <div class="param">
              <div class="param-header"><label for="lambda-max">Max &lambda; (nm)</label></div>
              <input type="text" inputmode="numeric" class="param-number param-number--wide" id="lambda-max" value="1250" autocomplete="off">
            </div>
          </div>

          <div class="preset-block">
            <span class="preset-label">Examples</span>
            <div class="param-presets" id="case-presets">
              <button class="preset-btn" data-material="au" data-shape="rod" data-l="50" data-r="4" data-nh="1.33" data-min="550" data-max="1250">Au rod</button>
              <button class="preset-btn" data-material="ag" data-shape="rod transverse" data-l="50" data-r="4" data-nh="1.33" data-min="320" data-max="440">Ag transverse rod</button>
              <button class="preset-btn" data-material="au" data-shape="cage" data-l="90" data-r="3.0" data-nh="1.33" data-min="450" data-max="1500">Au cage</button>
              <button class="preset-btn" data-material="au" data-shape="bipyramid" data-l="200" data-r="5" data-nh="1.33" data-min="500" data-max="1500">Au bipyramid</button>
              <button class="preset-btn" data-material="ag" data-shape="disk" data-l="100" data-r="3.0" data-nh="1.33" data-min="350" data-max="1200">Ag disk</button>
            </div>
          </div>

          <p class="theory-note">
            Model: retarded dipolar polarizability from geometry-only modal
            fits. Cross sections are normalized by particle volume in the main
            spectrum view.
          </p>

          <div class="geometry-schematic" id="geometry-schematic" aria-label="Selected geometry convention"></div>
        </aside>

        <main class="lab-main">
          <div class="tabs" role="tablist" aria-label="Plot views">
            <button class="tab-btn active" data-tab="spectrum" role="tab" aria-selected="true">Spectrum</button>
            <button class="tab-btn" data-tab="resonance" role="tab" aria-selected="false">Resonance</button>
            <button class="tab-btn" data-tab="ldos" role="tab" aria-selected="false">LDOS</button>
            <button class="tab-btn" data-tab="material" role="tab" aria-selected="false">Material</button>
          </div>

          <section class="chart-panel card">
            <div class="chart-header">
              <div>
                <span class="chart-title" id="chart-title">Extinction, absorption, scattering</span>
                <span class="chart-subtitle" id="chart-subtitle">Cross sections per particle volume</span>
              </div>
              <div class="chart-legend" id="chart-legend"></div>
              <div class="resonance-controls" id="resonance-controls" style="display:none" aria-label="Resonance sweep">
                <button class="seg-btn active" type="button" data-sweep="L">Sweep L</button>
                <button class="seg-btn" type="button" data-sweep="R">Sweep R</button>
              </div>
              <div class="toolbar-actions">
                <button id="dl-png" class="tool-btn" title="Download plot as PNG" data-umami-event="plasmonic-export" data-umami-event-format="png">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                  PNG
                </button>
                <button id="dl-csv" class="tool-btn" title="Download current data as CSV" data-umami-event="plasmonic-export" data-umami-event-format="csv">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                  CSV
                </button>
                <button id="share-btn" class="tool-btn" title="Copy shareable link" data-umami-event="share" data-umami-event-page="plasmonic-nanoparticles">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                  Share
                </button>
              </div>
            </div>
            <div class="chart-wrap" id="chart-wrap">
              <canvas id="plasmon-chart" aria-label="Plasmonic nanoparticle analytical model chart"></canvas>
            </div>
            <div class="ldos-probe-note" id="ldos-probe-note" style="display:none"></div>
            <div class="color-swatches" id="color-swatches">
              <span class="swatch-label">Apparent color</span>
              <div class="swatch-item">
                <div class="swatch-box" id="swatch-sca"></div>
                <span class="swatch-name">scattered</span>
              </div>
              <div class="swatch-item">
                <div class="swatch-box" id="swatch-trans"></div>
                <span class="swatch-name">transmitted</span>
              </div>
            </div>
          </section>

          <section class="output-card card">
            <div class="stat">
              <button class="stat-info" type="button" aria-label="Peak wavelength info">i<span class="stat-tooltip" role="tooltip">Wavelength where the extinction spectrum reaches its maximum within the selected range.</span></button>
              <span class="stat-label">Peak &lambda;</span>
              <span class="stat-value" id="out-peak-lambda">&mdash;</span>
              <span class="stat-unit">nm</span>
            </div>
            <div class="stat">
              <button class="stat-info" type="button" aria-label="Q factor info">i<span class="stat-tooltip" role="tooltip">Quality factor estimated as peak wavelength divided by the full width at half maximum of the extinction peak.</span></button>
              <span class="stat-label">Q factor</span>
              <span class="stat-value" id="out-q">&mdash;</span>
              <span class="stat-unit">FWHM</span>
            </div>
            <div class="stat">
              <button class="stat-info" type="button" aria-label="Yield info">i<span class="stat-tooltip" role="tooltip">Radiative quantum yield at the peak, computed as the scattering fraction of total extinction.</span></button>
              <span class="stat-label">Yield Y</span>
              <span class="stat-value" id="out-yield">&mdash;</span>
              <span class="stat-unit">at peak</span>
            </div>
            <div class="stat">
              <button class="stat-info" type="button" aria-label="Extinction per volume info">i<span class="stat-tooltip" role="tooltip">Peak extinction cross section normalized by the analytical particle volume.</span></button>
              <span class="stat-label">&sigma;<sub>ext</sub> / V</span>
              <span class="stat-value" id="out-ext">&mdash;</span>
              <span class="stat-unit">nm<sup>-1</sup></span>
            </div>
            <div class="stat">
              <button class="stat-info" type="button" aria-label="Albedo info">i<span class="stat-tooltip" role="tooltip">Scattering cross section divided by extinction cross section at the extinction peak.</span></button>
              <span class="stat-label">Albedo</span>
              <span class="stat-value" id="out-albedo">&mdash;</span>
              <span class="stat-unit">&sigma;<sub>sca</sub>/&sigma;<sub>ext</sub></span>
            </div>
            <div class="stat">
              <button class="stat-info" type="button" aria-label="Volume info">i<span class="stat-tooltip" role="tooltip">Particle volume from the selected geometry, length, and aspect-ratio convention.</span></button>
              <span class="stat-label">Volume</span>
              <span class="stat-value" id="out-volume">&mdash;</span>
              <span class="stat-unit">nm<sup>3</sup></span>
            </div>
          </section>

          <section class="model-note card">
            <div class="model-note__header">
              <span>Model range</span>
              <span id="mode-summary">Dominant mode</span>
            </div>
            <p id="validity-note">
              Homogeneous local-response particles in a uniform host. The scalar
              modal model does not provide exact near-field or LDOS maps.
            </p>
          </section>
        </main>
      </div>

      <div class="references card">
        <h4>References &amp; data sources</h4>
        <ul>
          <li>R. Yu, L. M. Liz-Marzan, and F. J. Garcia de Abajo, <em>Universal analytical modeling of plasmonic nanoparticles</em>, Chemical Society Reviews 46, 6710-6724 (2017).</li>
          <li>Optical constants reuse the Lab's tabulated n,k interpolation from refractiveindex.info data; Au/Ag: Johnson &amp; Christy (1972), Al: Rakic (1995), Cu: sparse fallback converted from the Yu et al. reference implementation.</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .widget-hero { padding: calc(var(--space-3xl) + var(--space-lg)) 0 var(--space-xl); background: var(--bg-soft); }
  .widget-hero h1 { margin-bottom: var(--space-sm); }
  .widget-hero__subtitle { font-size: 1.125rem; max-width: 760px; }
  .gradient-text { background: var(--spectrum); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .back-link { display: inline-block; margin-bottom: var(--space-md); font-size: 0.875rem; font-weight: 500; color: var(--text-soft); }
  .back-link:hover { color: var(--primary); }

  .widget-layout {
    display: grid;
    grid-template-columns: 310px 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: sticky;
    top: calc(var(--nav-height) + var(--lab-bar-height) + var(--space-lg));
  }
  .controls h3 { font-size: 1rem; }

  .param, .preset-block { display: flex; flex-direction: column; gap: 0.4rem; }
  .param-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); }
  .param-header { display: flex; justify-content: space-between; align-items: center; gap: var(--space-sm); }
  .param-header label, .preset-label { font-size: 0.875rem; font-weight: 500; color: var(--text); }

  .param-number {
    width: 5.4rem;
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    font-family: var(--font);
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--primary);
    text-align: right;
    outline: none;
    background: var(--bg);
  }
  .param-number--wide { width: 100%; text-align: left; }
  .param-number::-webkit-inner-spin-button,
  .param-number::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .param-number { -moz-appearance: textfield; }

  .param-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    background: var(--bg-muted);
    border-radius: 3px;
    outline: none;
    cursor: pointer;
  }
  .param-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--primary);
    cursor: pointer;
    transition: box-shadow 0.15s;
  }
  .param-slider::-webkit-slider-thumb:hover { box-shadow: 0 0 0 5px rgba(99,102,241,0.15); }
  .param-slider::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--primary); border: none; cursor: pointer; }
  .param-slider:disabled, .param-number:disabled { opacity: 0.55; cursor: not-allowed; }

  .param-select {
    width: 100%;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    font-family: var(--font);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text);
    background: var(--bg);
    outline: none;
    cursor: pointer;
  }
  .material-ref { font-size: 0.6875rem; color: var(--text-muted); font-style: italic; }
  .file-upload-row { display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.25rem; }
  .file-input { font-size: 0.75rem; font-family: var(--font); color: var(--text-soft); }
  .file-input::file-selector-button {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-full);
    background: var(--bg);
    font-family: var(--font);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--text-soft);
    cursor: pointer;
    margin-right: 0.4rem;
    transition: all 0.15s;
  }
  .file-input::file-selector-button:hover { border-color: var(--primary-light); color: var(--primary); }
  .file-name { font-size: 0.6875rem; color: var(--text-muted); font-style: italic; }
  .file-error { font-size: 0.6875rem; color: var(--rose); }
  .rii-search { display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.25rem; }
  .rii-input { width: 100% !important; text-align: left !important; font-weight: 500 !important; color: var(--text) !important; }
  .rii-results { max-height: 200px; overflow-y: auto; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm); background: var(--bg); }
  .rii-results:empty { display: none; }
  :global(.rii-result) { padding: 0.3rem 0.5rem; font-size: 0.75rem; cursor: pointer; line-height: 1.4; border-bottom: 1px solid var(--bg-soft); }
  :global(.rii-result:hover) { background: var(--bg-soft); color: var(--primary); }
  :global(.rii-result small) { display: block; color: var(--text-muted); font-size: 0.65rem; }

  .drude-panel {
    padding: var(--space-sm);
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
  }
  .drude-formula { font-size: 0.75rem; color: var(--text-muted); line-height: 1.4; }
  .drude-grid { display: grid; grid-template-columns: 1fr; gap: 0.45rem; }
  .drude-grid label { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); font-size: 0.75rem; color: var(--text-soft); }
  .drude-grid .param-number { width: 5.2rem; }

  .param-presets { display: flex; gap: var(--space-xs); flex-wrap: wrap; }
  .preset-btn {
    padding: 0.22rem 0.58rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-full);
    background: var(--bg);
    font-family: var(--font);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s;
  }
  .preset-btn:hover { border-color: var(--primary-light); color: var(--primary); }
  .preset-btn.active { border-color: var(--primary); background: rgba(99,102,241,0.08); color: var(--primary); }
  .theory-note { font-size: 0.8125rem; color: var(--text-muted); line-height: 1.55; border-top: 1px solid var(--bg-muted); padding-top: var(--space-md); }

  .shape-strip {
    padding: var(--space-md);
    margin-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .shape-strip__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text);
  }
  .shape-strip__header span:last-child {
    color: var(--primary);
    font-weight: 650;
    text-align: right;
  }
  .shape-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(58px, 1fr));
    gap: 0.42rem;
    overflow: visible;
    padding: 0.1rem;
  }
  :global(.shape-card) {
    min-width: 0;
    min-height: 62px;
    padding: 0.32rem 0.24rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text-soft);
    font-family: var(--font);
    font-size: 0.58rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.18rem;
    text-align: center;
    transition: border-color 0.15s, color 0.15s, background 0.15s, box-shadow 0.15s;
  }
  :global(.shape-card span) {
    max-width: 100%;
    line-height: 1.05;
    overflow: hidden;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  :global(.shape-card svg) { width: 34px; height: 34px; display: block; }
  :global(.shape-card:hover) { border-color: var(--primary-light); color: var(--primary); }
  :global(.shape-card.active) {
    border-color: var(--primary);
    background: rgba(99,102,241,0.12);
    color: var(--primary);
    box-shadow: 0 0 0 2px rgba(99,102,241,0.18);
  }

  .geometry-schematic {
    padding: var(--space-sm);
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
  }
  :global(.geometry-schematic__title) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text);
  }
  :global(.geometry-schematic__title span:last-child) {
    color: var(--primary);
    font-weight: 650;
    text-align: right;
  }
  :global(.geometry-schematic svg) {
    width: 100%;
    height: auto;
    display: block;
  }
  :global(.geometry-schematic text) {
    font-family: var(--font);
    fill: var(--text-soft);
    font-size: 11px;
    font-weight: 700;
  }

  .lab-main { display: flex; flex-direction: column; gap: var(--space-md); min-width: 0; }
  .tabs {
    display: inline-flex;
    align-self: flex-start;
    gap: 0.2rem;
    padding: 0.22rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-full);
