    if (shape === 'cage') return `<rect x="18" y="4" width="44" height="44" rx="5" fill="${fill}" fill-rule="evenodd" stroke="${stroke}" stroke-width="3"/><rect x="31" y="17" width="18" height="18" rx="2" fill="${innerFill}" stroke="${stroke}" stroke-width="2.5"/><path d="M18 26h13M49 26h13M40 4v13M40 35v13" stroke="${stroke}" stroke-width="1.8" opacity=".45"/>`;
