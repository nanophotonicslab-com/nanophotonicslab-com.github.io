  function downloadBlob(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
  }

  $('dl-png').addEventListener('click', () => {
    const canvas = $('plasmon-chart') as HTMLCanvasElement;
    const name = `plasmonic_${state.materialId}_${state.shape.replace(/\s+/g, '-')}_${state.tab}.png`;
    canvas.toBlob(blob => { if (blob) downloadBlob(blob, name); }, 'image/png');
  });

  $('dl-csv').addEventListener('click', () => {
    if (!result) return;
    downloadBlob(new Blob([currentCsv()], { type: 'text/csv' }), `plasmonic_${state.materialId}_${state.tab}.csv`);
  });

  function currentCsv(): string {
    const header = [
      `# Plasmonic nanoparticles lab`,
      `# material=${materialLabelForExport()}, shape=${state.shape}, L_nm=${state.lengthNm}, R=${state.aspectRatio}, n_host=${state.hostIndex}, modes=${state.modeCount}`,
    ];
    if (state.tab === 'spectrum' && result) {
      const lines = [...header, 'wavelength_nm,sigma_ext_nm2,sigma_abs_nm2,sigma_sca_nm2,sigma_ext_over_V_nm-1,sigma_abs_over_V_nm-1,sigma_sca_over_V_nm-1,quantum_yield'];
      for (let i = 0; i < result.wavelengthNm.length; i++) {
        lines.push([
          result.wavelengthNm[i],
          result.sigmaExtNm2[i],
          result.sigmaAbsNm2[i],
          result.sigmaScaNm2[i],
          result.sigmaExtOverV[i],
          result.sigmaAbsOverV[i],
          result.sigmaScaOverV[i],
          result.quantumYield[i],
        ].map(v => Number(v).toPrecision(8)).join(','));
      }
      return lines.join('\n') + '\n';
    }
    if (state.tab === 'material') {
      const lines = [...header, 'wavelength_nm,epsilon_re,epsilon_im'];
      for (let i = 0; i < 320; i++) {
        const lambda = state.lambdaMinNm + (state.lambdaMaxNm - state.lambdaMinNm) * i / 319;
        const eps = currentEpsilon(lambda);
        lines.push(`${lambda.toPrecision(8)},${eps.re.toPrecision(8)},${eps.im.toPrecision(8)}`);
      }
      return lines.join('\n') + '\n';
    }
    if (state.tab === 'resonance') {
      const sweep = resonanceSweepData();
      const xName = sweep.sweep === 'L' ? 'length_nm' : 'aspect_ratio';
      const lines = [...header, `${xName},lambda_peak_nm,Q`];
      for (let i = 0; i < sweep.x.length; i++) {
        lines.push([sweep.x[i], sweep.lambdaPeak[i], sweep.q[i]].map(v => Number(v).toPrecision(8)).join(','));
      }
      return lines.join('\n') + '\n';
    }
    if (state.tab === 'ldos' && result) {
      const data = ldosFieldData();
      const lines = [
        ...header,
        `# ${ldosProbeDescription()} distance_nm=${LDOS_PROBE_DISTANCE_NM}`,
        'wavelength_nm,ldos_over_ldos0_modal,field_enhancement',
      ];
      for (let i = 0; i < data.wavelengthNm.length; i++) {
        lines.push([data.wavelengthNm[i], data.ldos[i], data.fieldEnhancement[i]].map(v => Number(v).toPrecision(8)).join(','));
      }
      return lines.join('\n') + '\n';
    }
    return header.join('\n') + '\n';
  }

  function materialLabelForExport(): string {
    if (state.materialId === 'drude') return `drude(eps_b=${state.drudeEpsB},wp_eV=${state.drudeWpEv},gamma_eV=${state.drudeGammaEv})`;
    if (state.materialId === 'file') return uploadedMaterial ? 'uploaded_file' : 'file_unloaded';
    if (state.materialId === 'rii') return selectedDatabaseLabel || 'database_unselected';
    return `${state.materialId} (${MATERIALS[state.materialId]?.ref ?? ''})`;
  }

  const shareBtn = $('share-btn');
  function serializeState(): string {
    const p = new URLSearchParams();
    p.set('mat', state.materialId);
    if (state.materialId === 'drude') {
      p.set('epsb', String(state.drudeEpsB));
      p.set('wp', String(state.drudeWpEv));
      p.set('gamma', String(state.drudeGammaEv));
    }
    p.set('shape', state.shape);
    p.set('L', String(state.lengthNm));
    p.set('R', String(state.aspectRatio));
    p.set('nh', String(state.hostIndex));
    p.set('min', String(state.lambdaMinNm));
    p.set('max', String(state.lambdaMaxNm));
    p.set('modes', String(state.modeCount));
    p.set('view', state.tab);
    p.set('sweep', state.resonanceSweep);
    return p.toString();
  }
  shareBtn.addEventListener('click', () => {
    const url = `${location.origin}${location.pathname}#${serializeState()}`;
    navigator.clipboard.writeText(url).then(() => {
      const old = shareBtn.innerHTML;
      shareBtn.textContent = 'Copied!';
      setTimeout(() => { shareBtn.innerHTML = old; }, 1400);
    });
  });

  function restoreState() {
    const hash = location.hash.slice(1);
    if (!hash) return;
    const p = new URLSearchParams(hash);
    if (p.has('mat')) state.materialId = p.get('mat')!;
    if (p.has('epsb')) state.drudeEpsB = Number.parseFloat(p.get('epsb')!);
    if (p.has('wp')) state.drudeWpEv = Number.parseFloat(p.get('wp')!);
    if (p.has('gamma')) state.drudeGammaEv = Number.parseFloat(p.get('gamma')!);
    if (p.has('shape')) state.shape = p.get('shape') as PlasmonShapeId;
    if (p.has('L')) state.lengthNm = Number.parseFloat(p.get('L')!);
    if (p.has('R')) state.aspectRatio = Number.parseFloat(p.get('R')!);
    if (p.has('nh')) state.hostIndex = Number.parseFloat(p.get('nh')!);
    if (p.has('min')) state.lambdaMinNm = Number.parseFloat(p.get('min')!);
    if (p.has('max')) state.lambdaMaxNm = Number.parseFloat(p.get('max')!);
    if (p.has('modes')) state.modeCount = Number.parseInt(p.get('modes')!, 10);
    if (p.has('view') && ['spectrum', 'material', 'resonance', 'ldos'].includes(p.get('view')!)) state.tab = p.get('view') as TabId;
    if (p.has('sweep') && ['L', 'R'].includes(p.get('sweep')!)) state.resonanceSweep = p.get('sweep') as ResonanceSweep;

    document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(btn => {
      const active = btn.dataset.tab === state.tab;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });
  }

  restoreState();
  render();

  new ResizeObserver(() => drawChart()).observe($('chart-wrap'));
  onThemeChange(() => drawChart());
</script>
