  import type { Complex, PlasmonShapeId, PlasmonSpectrum } from '../../lib/plasmonic-nanoparticles';

  type TabId = 'spectrum' | 'polar' | 'material' | 'resonance' | 'ldos';
  type ResonanceSweep = 'L' | 'R';
  type ChartAxisMode = 'lambda' | 'energy';
  type AlphaUnit = 'esu' | 'si' | 'au';
  // Polarizability α⁽¹⁾ unit conversion from the lab's native nm³ (Gaussian/esu volume).
  // Table 1: 1 cm³ (esu) = 1.113e-16 C²m²J⁻¹ (SI) = 6.748e24 (a.u.).  1 nm³ = 1e-21 cm³.
  const ALPHA_UNITS: Record<AlphaUnit, { factor: number; label: string; axis: string }> = {
    esu: { factor: 1e-21, label: 'esu', axis: 'α (cm³, esu)' },
    si: { factor: 1e-21 * 1.113e-16, label: 'SI', axis: 'α (C² m² J⁻¹)' },
    au: { factor: 1e-21 * 6.748e24, label: 'a.u.', axis: 'α (a.u.)' },
  };
  let alphaUnit: AlphaUnit = 'esu';
  let labMode: 'lin' | 'nl' = 'lin';
  let cursorIdx = -1;   // hovered sample index on the polarizability chart (−1 = none)

  // ── nonlinear-plasmonics state ──
  // material: graphene (Drude σ²ᴰ) | au/ag/cu/al (tabulated ε, thin film) | drude (Drude ε)
  //         | sigma (uploaded σ²ᴰ) | eps (uploaded ε, thin film)
  type NlMatId = 'graphene' | 'au' | 'ag' | 'cu' | 'al' | 'drude' | 'sigma' | 'eps';
  type NlTab = 'spectrum' | 'nonlinear' | 'material';
  type GrapheneModel = 'bte' | 'rpa';
  const nl: { material: NlMatId; thickness: number; drudeEpsInf: number; drudeWp: number; drudeGamma: number; grapheneModel: GrapheneModel; temperature: number; modes: number; geometry: NlGeometryId; order: NlOrder; quantity: 'alpha' | 'chi'; tab: NlTab; EF: number; D: number; gamma: number; epsBar: number; axis: ChartAxisMode; unit: AlphaUnit; rangeUnit: string; eMin: number; eMax: number; log: boolean; specLog: boolean; cursorIdx: number } =
    { material: 'graphene', thickness: 2, drudeEpsInf: 9.5, drudeWp: 9.06, drudeGamma: 0.071, grapheneModel: 'bte', temperature: 300, modes: 1, geometry: 'triangle', order: '33', quantity: 'alpha', tab: 'nonlinear', EF: 1.0, D: 20, gamma: 0.05, epsBar: 1.0, axis: 'energy', unit: 'esu', rangeUnit: 'eV', eMin: 0.1, eMax: 1.0, log: false, specLog: false, cursorIdx: -1 };
  let nlCustomSigma: { E: Float64Array; re: Float64Array; im: Float64Array } | null = null;   // uploaded σ²ᴰ(E)
  let nlCustomEps: { E: Float64Array; re: Float64Array; im: Float64Array } | null = null;     // uploaded ε(E)
  const nlEpsBased = (m: NlMatId) => m === 'au' || m === 'ag' || m === 'cu' || m === 'al' || m === 'drude' || m === 'eps';
  let nlResult: { E: Float64Array; re: Float64Array; im: Float64Array } | null = null;
  let nlSpecData: { E: Float64Array; ext: Float64Array; abs: Float64Array; sca: Float64Array } | null = null;   // Spectrum tab
  let nlMatData: { E: Float64Array; re: Float64Array; im: Float64Array; sym: string; unit: string } | null = null;   // Material tab
  // Per-order conversion. α11 is a true nm³ volume (esu = cm³ = ×1e-21); the nonlinear
  // orders are in the model's internal Gaussian units, scaled by the table's esu→SI/a.u. factors.
  const NL_FACTOR: Record<NlOrder, Record<AlphaUnit, number>> = {
    '11': { esu: 1e-21, si: 1e-21 * 1.113e-16, au: 1e-21 * 6.748e24 },
    '22': { esu: 1, si: 3.711e-21, au: 1.157e32 },
    '31': { esu: 1, si: 1.238e-25, au: 1.985e39 },
    '33': { esu: 1, si: 1.238e-25, au: 1.985e39 },
  };
  const NL_UNIT_LABEL: Record<AlphaUnit, string> = { esu: 'esu', si: 'SI', au: 'a.u.' };
  const NL_ORDER_PAIR: Record<NlOrder, string> = { '11': '1,1', '22': '2,2', '31': '3,1', '33': '3,3' };
  const NL_ORDER_NAME: Record<NlOrder, string> = { '11': 'linear', '22': 'second-harmonic', '31': 'Kerr', '33': 'third-harmonic' };
  const NL_ORDER_SHORT: Record<NlOrder, string> = { '11': 'linear', '22': 'SHG', '31': 'Kerr', '33': 'THG' };
  // α vs χ: effective bulk susceptibility from the per-atom polarizability,
  //   χ⁽ˢ⁾ = α̃⁽ˢ⁾ n_C / d_gr   (Cox & García de Abajo, Nat. Commun. 5, 5725 (2014)),
  // with α̃ = α/(n_C·A) the polarizability per carbon atom, n_C = 3.8×10¹⁵ cm⁻² the areal
  // C density and d_gr ≃ 0.33 nm the effective graphene thickness ⇒ χ = α/(A·d_gr): the
  // polarizability per effective volume V = A·d_gr (in cm³, so χ comes out in esu). Area:
  // ribbon → width D (per length); triangle → √3/4 D²; disk → π(D/2)². Thin-film: d_gr → t.
  //
  // Absolute esu scale (matches the nlgraphene reference, validated in nl-graphene.test.ts):
  // the third-order χ⁽³⁾ has internal units nm³/eV, which converts to Gaussian esu (cm³/erg)
  // by the pure dimensional factor (1e-7 cm/nm)³ / (1.602176634e-12 erg/eV) = 6.2415e-10 —
  // no free parameter. χ = α/V with V = A·d_gr; the linear α is already esu-calibrated
  // (prefactor 1, χ⁽¹⁾ dimensionless). This gives THG χ⁽³,³⁾ ≈ 2×10⁻⁷ esu and Kerr ≈ 6×10⁻⁵
  // esu at E_F = 1 eV, D = 20 nm (ribbon D=50: THG ≈ 5×10⁻⁷, Kerr ≈ 1×10⁻⁴), as in the paper.
  const NL_NC_CM2 = 3.8e15;     // areal density of carbon atoms in graphene [cm⁻²]
  const NL_DGR_NM = 0.33;       // effective graphene thickness d_gr ≃ 3.3×10⁻⁸ cm [nm]
  const NL_CHI_PNL = 6.2415e-31; // nm³/eV → cm³/erg (esu), with V already taken in cm³ (×1e-21)
  const nlQtyLetter = () => nl.quantity === 'chi' ? 'χ' : 'α';
  const nlSym = (ord: NlOrder) => `${nlQtyLetter()}(${NL_ORDER_PAIR[ord]})`;                 // plain text (canvas, <option>)
  const nlSymHtml = (ord: NlOrder) => `${nlQtyLetter()}<sup>(${NL_ORDER_PAIR[ord]})</sup>`;   // HTML (notes) — comma is raised with the digits
  const nlArea = () => { const D = nl.D; return nl.geometry === 'disk' ? Math.PI * (D / 2) ** 2 : nl.geometry === 'triangle' ? Math.sqrt(3) / 4 * D ** 2 : D; };
  const nlEffThk = () => (nl.material === 'graphene' || nl.material === 'sigma') ? NL_DGR_NM : nl.thickness;
  const nlVolumeCm3 = () => nlArea() * nlEffThk() * 1e-21;   // V = A·d_gr in cm³ (A, d in nm)
  const nlChiPrefac = () => nl.order === '11' ? 1 : NL_CHI_PNL;   // linear α is already esu-calibrated
  const nlDispFactor = () => NL_FACTOR[nl.order][nl.unit] * (nl.quantity === 'chi' ? nlChiPrefac() / nlVolumeCm3() : 1);
  const nlUnitLbl = () => NL_UNIT_LABEL[nl.unit];

  const colors = {
    ext: '#10B981',
    abs: '#EF4444',
    sca: '#3B82F6',
    re: '#7C3AED',
    im: '#F59E0B',
    peak: '#F43F5E',
    ldos: '#06B6D4',
    fe: '#8B5CF6',
  };
  const HC_EV_NM = 1239.841984;
  const IMPORT_PREVIEW_ROWS = 320;
  const LDOS_PROBE_DISTANCE_NM = 5;
  const COLOR_LAMBDA_MIN_NM = 380;
  const COLOR_LAMBDA_MAX_NM = 780;

  const state: {
    materialId: string;
    drudeEpsB: number;
    drudeWpEv: number;
    drudeGammaEv: number;
    shape: PlasmonShapeId;
    lengthNm: number;
    aspectRatio: number;
    hostIndex: number;
    lambdaMinNm: number;
    lambdaMaxNm: number;
    modeCount: number;
    tab: TabId;
    xAxis: ChartAxisMode;
    resonanceSweep: ResonanceSweep;
  } = {
    materialId: 'au',
    drudeEpsB: 9.5,
    drudeWpEv: 9.06,
    drudeGammaEv: 0.071,
    shape: 'rod',
    lengthNm: 50,
    aspectRatio: 4,
    hostIndex: 1.33,
    lambdaMinNm: 550,
    lambdaMaxNm: 1250,
    modeCount: 1,
    tab: 'spectrum',
    xAxis: 'lambda',
    resonanceSweep: 'L',
  };

  let result: PlasmonSpectrum | null = null;
  let uploadedMaterial: number[][] | null = null;
  let selectedDatabaseMaterial: number[][] | null = null;
  let selectedDatabaseLabel = '';
  let catalogPromise: Promise<RIIMaterial[]> | null = null;
  let lastShapeGalleryShape = '';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  const materialImportDialog = $<HTMLDialogElement>('material-import-dialog');
  const materialImportFile = $('material-import-file');
  const materialImportAxis = $<HTMLSelectElement>('material-import-axis');
  const materialImportValues = $<HTMLSelectElement>('material-import-values');
  const materialImportPreview = $<HTMLCanvasElement>('material-import-preview');
