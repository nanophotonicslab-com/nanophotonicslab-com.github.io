  function nlMaterialRefText(): string {
    if (nl.material === 'graphene') return '';
    if (nl.material === 'drude') return 'Tunable Drude dielectric function';
    if (nl.material === 'sigma') return nlCustomSigma ? '' : 'Upload σ²ᴰ(E) file';
    if (nl.material === 'eps') return nlCustomEps ? '' : 'Upload ε(E) file';
    return MATERIALS[nl.material]?.ref ?? '';   // au / ag / cu / al → tabulated-data reference
  }
  function parseSigmaFile(text: string): { E: Float64Array; re: Float64Array; im: Float64Array } | null {
    const E: number[] = [], re: number[] = [], im: number[] = [];
    for (const line of text.split(/\r?\n/)) {
      const t = line.trim(); if (!t || /^[#%]/.test(t)) continue;
      const p = t.split(/[\s,;\t]+/).map(Number);
      if (p.length >= 3 && p.slice(0, 3).every(Number.isFinite)) { E.push(p[0]); re.push(p[1]); im.push(p[2]); }
    }
    if (E.length < 2) return null;
    const idx = E.map((_, i) => i).sort((a, b) => E[a] - E[b]);
    return { E: Float64Array.from(idx.map(i => E[i])), re: Float64Array.from(idx.map(i => re[i])), im: Float64Array.from(idx.map(i => im[i])) };
  }
