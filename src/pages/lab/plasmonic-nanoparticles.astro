<script>
  import { MATERIALS } from '../../lib/materials';
  import { loadCatalog, fetchMaterialNK, searchCatalog } from '../../data/refractiveindex';
  import type { RIIMaterial } from '../../data/refractiveindex';
  import { chartTheme, onThemeChange } from '../../lib/chart-theme';
  import { spectrumToHex } from '../../lib/colorimetry';
  import { NL_GEOMETRIES, getNlGeometry, nlSpectrum, nlResonance, nlResonanceEnergyGraphene, grapheneSigma2d, grapheneSigma2dRPA, grapheneSigmaOrder, grapheneR_THG, grapheneR_Kerr, metalSigma2d, geometrySpectrumMulti, type NlOrder, type NlGeometryId, type NlMaterial } from '../../lib/nl-graphene';
  import {
    SHAPE_OPTIONS,
    availableModeCount,
    computePlasmonSpectrum,
    drudeEpsilon,
