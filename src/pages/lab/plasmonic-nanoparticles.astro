  }

  // "10ⁿ" with a unicode-superscript exponent (n is the log₁₀ decade)
  const NL_SUP_DIGITS: Record<string, string> = { '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
  const pow10Label = (n: number) => '10' + String(n).split('').map(ch => NL_SUP_DIGITS[ch] ?? ch).join('');

  function drawAxes(
    ctx: CanvasRenderingContext2D,
    w: number,
    h: number,
    m: { top: number; right: number; bottom: number; left: number },
    xMin: number,
    xMax: number,
    yMin: number,
    yMax: number,
    xLabel: string,
    yLabel: string,
    theme: ReturnType<typeof chartTheme>,
    fonts: { tick?: number; label?: number; yLog?: boolean } = {},
  ) {
    const tickPx = fonts.tick ?? 10, labelPx = fonts.label ?? 11, yLog = fonts.yLog ?? false;
    ctx.fillStyle = theme.bg;
    ctx.fillRect(0, 0, w, h);
    const pw = w - m.left - m.right;
    const ph = h - m.top - m.bottom;
    const xTo = (x: number) => m.left + pw * (x - xMin) / (xMax - xMin);
    const yTo = (y: number) => m.top + ph * (1 - (y - yMin) / (yMax - yMin));

    ctx.fillStyle = theme.bg;
    ctx.fillRect(m.left, m.top, pw, ph);
    ctx.strokeStyle = theme.grid;
    ctx.lineWidth = 1;

    for (let i = 0; i <= 5; i++) {
      const x = m.left + pw * i / 5;
      ctx.beginPath();
      ctx.moveTo(x, m.top);
      ctx.lineTo(x, m.top + ph);
      ctx.stroke();
    }
    if (yLog) {
      // gridlines at integer decades (major) + log₁₀(2..9) subdivisions (minor, faint)
      const lo = Math.floor(yMin), hi = Math.ceil(yMax), minors = hi - lo <= 6;
      for (let nn = lo; nn <= hi; nn++) {
        if (minors) for (let k = 2; k <= 9; k++) { const yv = nn + Math.log10(k); if (yv >= yMin && yv <= yMax) { const y = yTo(yv); ctx.save(); ctx.globalAlpha = 0.45; ctx.beginPath(); ctx.moveTo(m.left, y); ctx.lineTo(m.left + pw, y); ctx.stroke(); ctx.restore(); } }
        if (nn >= yMin && nn <= yMax) { const y = yTo(nn); ctx.beginPath(); ctx.moveTo(m.left, y); ctx.lineTo(m.left + pw, y); ctx.stroke(); }
      }
    } else {
      for (let i = 0; i <= 5; i++) {
        const y = m.top + ph * i / 5;
        ctx.beginPath();
        ctx.moveTo(m.left, y);
        ctx.lineTo(m.left + pw, y);
        ctx.stroke();
      }
    }

    ctx.strokeStyle = theme.text;
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(m.left, m.top);
    ctx.lineTo(m.left, m.top + ph);
    ctx.lineTo(m.left + pw, m.top + ph);
    ctx.stroke();

    ctx.fillStyle = theme.textSoft;
    ctx.font = `${tickPx}px Inter, system-ui, sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (let i = 0; i <= 5; i++) {
      const value = xMin + (xMax - xMin) * i / 5;
      ctx.fillText(fmt(value, 4), m.left + pw * i / 5, m.top + ph + 5);
    }
    ctx.fillStyle = theme.text;
    ctx.font = `${labelPx}px Inter, system-ui, sans-serif`;
    ctx.fillText(xLabel, m.left + pw / 2, h - 16);

    ctx.fillStyle = theme.textSoft;
    ctx.font = `${tickPx}px Inter, system-ui, sans-serif`;
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    if (yLog) {
      const lo = Math.ceil(yMin), hi = Math.floor(yMax);
      for (let nn = lo; nn <= hi; nn++) ctx.fillText(pow10Label(nn), m.left - 6, yTo(nn));
    } else {
      for (let i = 0; i <= 5; i++) {
        const value = yMax - (yMax - yMin) * i / 5;
        ctx.fillText(fmt(value, 2), m.left - 6, m.top + ph * i / 5);
      }
    }
    ctx.save();
    ctx.translate(14, m.top + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = theme.text;
    ctx.font = `${labelPx}px Inter, system-ui, sans-serif`;
    ctx.fillText(yLabel, 0, 0);
    ctx.restore();

    return { xTo, yTo, left: m.left, right: m.left + pw, top: m.top, bottom: m.top + ph };
  }

  function drawLine(
    ctx: CanvasRenderingContext2D,
    xs: ArrayLike<number>,
    ys: ArrayLike<number>,
    plot: { xTo: (x: number) => number; yTo: (y: number) => number; left: number; right: number; top: number; bottom: number },
    color: string,
    width: number,
  ) {
    ctx.save();
    ctx.beginPath();
    ctx.rect(plot.left, plot.top, plot.right - plot.left, plot.bottom - plot.top);
    ctx.clip();
    ctx.strokeStyle = color;
    ctx.lineWidth = width;
    ctx.beginPath();
    let started = false;
    for (let i = 0; i < xs.length; i++) {
      if (!Number.isFinite(xs[i]) || !Number.isFinite(ys[i])) {
        started = false;
        continue;
      }
      const x = plot.xTo(xs[i]);
      const y = plot.yTo(ys[i]);
      if (!Number.isFinite(x) || !Number.isFinite(y)) {
        started = false;
        continue;
      }
      if (!started) {
        ctx.moveTo(x, y);
        started = true;
      } else {
        ctx.lineTo(x, y);
      }
    }
    ctx.stroke();
    ctx.restore();
  }

  function bindPair(numId: string, sliderId: string, key: 'lengthNm' | 'aspectRatio' | 'hostIndex') {
    const num = $<HTMLInputElement>(numId);
    const slider = $<HTMLInputElement>(sliderId);
    const commitNumber = () => {
      const value = Number.parseFloat(num.value);
      if (!Number.isFinite(value)) {
        render();
        return;
      }
      state[key] = value;
      render();
    };
    num.addEventListener('change', commitNumber);
    num.addEventListener('keydown', event => {
      if (event.key === 'Enter') {
        event.preventDefault();
        commitNumber();
      }
      if (event.key === 'Escape') {
        event.preventDefault();
        num.blur();
        render();
      }
    });
    slider.addEventListener('input', () => {
      const value = Number.parseFloat(slider.value);
      if (!Number.isFinite(value)) return;
      state[key] = value;
      render();
    });
  }

  bindPair('length-num', 'length-slider', 'lengthNm');
  bindPair('aspect-num', 'aspect-slider', 'aspectRatio');
  bindPair('host-num', 'host-slider', 'hostIndex');

  function bindNumberCommit(id: string, commit: (value: number) => void) {
    const input = $<HTMLInputElement>(id);
    input.addEventListener('change', () => {
      const value = Number.parseFloat(input.value);
      if (!Number.isFinite(value)) {
        render();
        return;
      }
      commit(value);
      render();
    });
    input.addEventListener('keydown', event => {
      if (event.key === 'Enter') {
        event.preventDefault();
        const value = Number.parseFloat(input.value);
        if (Number.isFinite(value)) commit(value);
        render();
      }
      if (event.key === 'Escape') {
        event.preventDefault();
        input.blur();
        render();
      }
    });
  }

  function bindDrudeInput(id: string, key: 'drudeEpsB' | 'drudeWpEv' | 'drudeGammaEv') {
    bindNumberCommit(id, value => { state[key] = value; });
  }

  bindDrudeInput('drude-epsb', 'drudeEpsB');
  bindDrudeInput('drude-wp', 'drudeWpEv');
  bindDrudeInput('drude-gamma', 'drudeGammaEv');

  bindNumberCommit('lambda-min', value => { state.lambdaMinNm = value; });
  bindNumberCommit('lambda-max', value => { state.lambdaMaxNm = value; });

  function clearMaterialImportCanvas() {
    const rect = materialImportPreview.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    const width = Math.max(320, rect.width || materialImportPreview.clientWidth);
    const height = Math.max(140, rect.height || materialImportPreview.clientHeight);
    materialImportPreview.width = width * dpr;
    materialImportPreview.height = height * dpr;
    const ctx = materialImportPreview.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, width, height);
  }

  function renderMaterialImportPreview() {
    if (!pendingMaterialImport) return;
    const axisMode = materialImportAxis.value as ImportAxisMode;
    const valueMode = materialImportValues.value as ImportValueMode;
    const converted = convertOpticalRows(pendingMaterialImport.parsed.rows, axisMode, valueMode);
    const preview = previewSeries(pendingMaterialImport.parsed.rows, axisMode, valueMode);
    materialImportStatus.classList.toggle('error', 'error' in converted);
    materialImportAccept.disabled = 'error' in converted;
    if (preview) {
      const rect = materialImportPreview.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      const width = Math.max(320, rect.width || materialImportPreview.clientWidth);
      const height = Math.max(140, rect.height || materialImportPreview.clientHeight);
      materialImportPreview.width = width * dpr;
      materialImportPreview.height = height * dpr;
      const ctx = materialImportPreview.getContext('2d')!;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const plot = drawAxes(ctx, width, height, { top: 18, right: 22, bottom: 42, left: 58 }, preview.xRange[0], preview.xRange[1], preview.yRange[0], preview.yRange[1], preview.xLabel, preview.yLabel, chartTheme());
      for (const item of preview.series) drawLine(ctx, preview.xArr, item.y, plot, item.color, 2.1);
    } else {
      clearMaterialImportCanvas();
    }
    if ('error' in converted) {
      materialImportStatus.textContent = converted.error;
      return;
    }
    materialImportStatus.textContent = `${converted.data.length} rows`;
  }

  function openMaterialImportDialog(target: MaterialImportTarget, text: string) {
    const parsed = parseOpticalFile(text);
    if ('error' in parsed) {
      target.statusEl.className = 'file-error';
      target.statusEl.textContent = parsed.error;
      target.inputEl.value = '';
      target.onCancel?.();
      return;
    }
    pendingMaterialImport = { ...target, parsed };
    const inferred = inferImportModes(parsed.rows);
    materialImportAxis.value = inferred.axis;
    materialImportValues.value = inferred.values;
    materialImportFile.textContent = `${target.fileName} (${parsed.rows.length} numeric rows)`;
    materialImportRows.innerHTML = parsed.rows.slice(0, 8).map(row =>
      `<tr><td>${formatCompact(row[0])}</td><td>${formatCompact(row[1])}</td><td>${formatCompact(row[2])}</td></tr>`
    ).join('');
    if (typeof materialImportDialog.showModal === 'function') materialImportDialog.showModal();
    else materialImportDialog.setAttribute('open', '');
    requestAnimationFrame(renderMaterialImportPreview);
  }

  function cancelMaterialImport() {
    if (pendingMaterialImport) {
      pendingMaterialImport.statusEl.className = 'file-name';
      pendingMaterialImport.statusEl.textContent = 'Import cancelled';
      pendingMaterialImport.inputEl.value = '';
      pendingMaterialImport.onCancel?.();
    }
    pendingMaterialImport = null;
    materialImportDialog.close();
  }

