    ($('nl-geo') as HTMLSelectElement).value = nl.geometry;
    renderNlGallery(); nlChanged();
  });
  // Reproduce paper Fig. 2(a/b/c): 40 nm graphene ribbon, E_F = 1 eV, local-RPA, T = 0, j ≤ 3,
  // log scale, 0.2–1.0 eV; order = linear (a) / THG (b) / Kerr (c).
  function applyFig2(panel: 'a' | 'b' | 'c') {
    if (labMode !== 'nl') {   // make sure we're in the 2D view (hides the LIN panels)
      labMode = 'nl';
      $('linnl-tabs').querySelectorAll<HTMLButtonElement>('.seg-btn').forEach(b => { const a = b.dataset.linnl === 'nl'; b.classList.toggle('active', a); b.setAttribute('aria-checked', String(a)); });
      updateLabMode();
    }
    // (a) linear absorption → Spectrum tab; (b) THG & (c) Kerr → |χ⁽³⁾| on the Nonlinear tab
    const order: NlOrder = panel === 'a' ? '11' : panel === 'b' ? '33' : '31';
    const tab: NlTab = panel === 'a' ? 'spectrum' : 'nonlinear';
    Object.assign(nl, {
      material: 'graphene', geometry: 'ribbon', grapheneModel: 'rpa', temperature: 0,
      EF: 1.0, D: 40, gamma: 0.05, epsBar: 1.0, modes: 3, order,
      quantity: 'chi', unit: 'esu', tab, axis: 'energy', rangeUnit: 'eV', eMin: 0.2, eMax: 1.0, log: true, specLog: true, cursorIdx: -1,
    });
    $('nl-unit-controls').querySelectorAll<HTMLButtonElement>('.seg-btn').forEach(b => b.classList.toggle('active', b.dataset.naunit === 'esu'));
    ($('nl-material') as HTMLSelectElement).value = 'graphene';
    ($('nl-gamma') as HTMLInputElement).value = '0.05';   // paper damping (50 meV) — required for the right magnitude
    ($('nl-ef') as HTMLInputElement).value = '1'; ($('nl-ef-slider') as HTMLInputElement).value = '1';
    ($('nl-d') as HTMLInputElement).value = '40'; ($('nl-d-slider') as HTMLInputElement).value = '40';
    ($('nl-temp') as HTMLInputElement).value = '0'; ($('nl-temp-slider') as HTMLInputElement).value = '0';
    ($('nl-order') as HTMLSelectElement).value = nl.order;
    ($('nl-log-btn') as HTMLButtonElement).setAttribute('aria-pressed', 'true');
    ($('nl-spec-log-btn') as HTMLButtonElement).setAttribute('aria-pressed', 'true');
    $('nl-gmodel').querySelectorAll<HTMLButtonElement>('.seg-btn').forEach(b => { const a = b.dataset.gmodel === 'rpa'; b.classList.toggle('active', a); b.setAttribute('aria-checked', String(a)); });
    $('nl-qty-toggle').querySelectorAll<HTMLButtonElement>('.nl-qty-btn').forEach(b => { const a = b.dataset.nlqty === 'chi'; b.classList.toggle('active', a); b.setAttribute('aria-checked', String(a)); });
    updateNlMaterialUI();            // material boxes, order options, material-ref, temp-field, geo options
    ($('nl-geo') as HTMLSelectElement).value = 'ribbon';
    nlUpdateModesUI(); nlUpdateQtyUI(); nlRefreshTauMob(); nlRefreshUnitSelect(); nlRefreshRangeInputs();
    renderNl();
  }
  $('nl-ref-list').addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.nl-fig2-btn');
    if (btn && btn.dataset.fig2) applyFig2(btn.dataset.fig2 as 'a' | 'b' | 'c');
  });
  $('nl-order').addEventListener('change', e => { nl.order = (e.target as HTMLSelectElement).value as NlOrder; updateNlGeoOptions(); nlChanged(); });
  // graphene damping ⇄ lifetime ⇄ DC mobility (γ is the source of truth), as in the Materials/graphene module
  const NL_HBAR_EVS = 6.582119569e-16, NL_VF_MS = 1e6, NL_HBAR_EV_FS = 0.6582119569;
  const nlMobFromGamma = (g: number, EF: number) => (NL_HBAR_EVS / g) * NL_VF_MS * NL_VF_MS / EF * 1e4;
  const nlGammaFromMob = (mu: number, EF: number) => NL_HBAR_EVS / ((mu * 1e-4) * EF / (NL_VF_MS * NL_VF_MS));
  function nlRefreshTauMob() { ($('nl-tau') as HTMLInputElement).value = (NL_HBAR_EV_FS / nl.gamma).toFixed(1); if (nl.EF > 0) ($('nl-mu') as HTMLInputElement).value = nlMobFromGamma(nl.gamma, nl.EF).toFixed(0); }
  $('nl-ef').addEventListener('input', e => { const v = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(v) && v > 0) { nl.EF = v; ($('nl-ef-slider') as HTMLInputElement).value = String(v); nlRefreshTauMob(); nlChanged(); } });
  $('nl-ef-slider').addEventListener('input', e => { const v = parseFloat((e.target as HTMLInputElement).value); nl.EF = v; ($('nl-ef') as HTMLInputElement).value = String(v); nlRefreshTauMob(); nlChanged(); });
  $('nl-d').addEventListener('input', e => { const v = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(v) && v > 0) { nl.D = v; ($('nl-d-slider') as HTMLInputElement).value = String(v); nlChanged(); } });
  $('nl-d-slider').addEventListener('input', e => { const v = parseFloat((e.target as HTMLInputElement).value); nl.D = v; ($('nl-d') as HTMLInputElement).value = String(v); nlChanged(); });
  $('nl-gamma').addEventListener('input', e => { const v = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(v) && v > 0) { nl.gamma = v; nlRefreshTauMob(); nlChanged(); } });
  $('nl-tau').addEventListener('input', e => { const t = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(t) && t > 0) { nl.gamma = NL_HBAR_EV_FS / t; ($('nl-gamma') as HTMLInputElement).value = nl.gamma.toFixed(5); if (nl.EF > 0) ($('nl-mu') as HTMLInputElement).value = nlMobFromGamma(nl.gamma, nl.EF).toFixed(0); nlChanged(); } });
  $('nl-mu').addEventListener('input', e => { const mu = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(mu) && mu > 0 && nl.EF > 0) { nl.gamma = nlGammaFromMob(mu, nl.EF); ($('nl-gamma') as HTMLInputElement).value = nl.gamma.toFixed(5); ($('nl-tau') as HTMLInputElement).value = (NL_HBAR_EV_FS / nl.gamma).toFixed(1); nlChanged(); } });
  nlRefreshTauMob();
  nlSeedRange(); nlRefreshUnitSelect(); nlRefreshRangeInputs();
  // one handler for every 2D panel's E ↔ λ toggle; keep them all in sync, redraw the active tab
  document.querySelectorAll<HTMLElement>('.nl-axis-tabs').forEach(group => group.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.axis-btn'); if (!btn || !btn.dataset.naxis) return;
    nl.axis = btn.dataset.naxis as ChartAxisMode;
    document.querySelectorAll<HTMLButtonElement>('.nl-axis-tabs .axis-btn').forEach(b => { const a = b.dataset.naxis === nl.axis; b.classList.toggle('active', a); b.setAttribute('aria-checked', a ? 'true' : 'false'); });
    nlRefreshUnitSelect(); nlRefreshRangeInputs();
    drawNlActive();
  }));
  // 2D tab bar: Spectrum (cross section) · Nonlinear (polarizability) · Material (σ²ᴰ / ε)
  $('nl-tabs').addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.tab-btn'); if (!btn || !btn.dataset.nltab) return;
    nl.tab = btn.dataset.nltab as NlTab; nl.cursorIdx = -1;
    updateNlTabUI(); drawNlActive(); setNlReadout(-1);
  });
  $('nl-range-unit').addEventListener('change', e => { nl.rangeUnit = (e.target as HTMLSelectElement).value; nlRefreshRangeInputs(); });
  $('nl-range-min').addEventListener('input', () => { nlReadRangeInputs(); nlChanged(); });
  $('nl-range-max').addEventListener('input', () => { nlReadRangeInputs(); nlChanged(); });
  $('nl-unit-controls').addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.seg-btn'); if (!btn || !btn.dataset.naunit) return;
    nl.unit = btn.dataset.naunit as AlphaUnit;
    $('nl-unit-controls').querySelectorAll<HTMLButtonElement>('.seg-btn').forEach(b => b.classList.toggle('active', b.dataset.naunit === nl.unit));
    setNlReadout(nl.cursorIdx); drawNlChart();
  });
  $('nl-log-btn').addEventListener('click', () => { nl.log = !nl.log; ($('nl-log-btn') as HTMLButtonElement).setAttribute('aria-pressed', String(nl.log)); updateNlLegend(); drawNlChart(); });
  function nlUpdateQtyUI() {
    $('nl-title').textContent = nl.quantity === 'chi' ? 'Nonlinear susceptibility' : 'Nonlinear polarizability';
    // Response menu: relabel each option with the active quantity letter (α⁽ⁿ⁾ ↔ χ⁽ⁿ⁾)
    ($('nl-order') as HTMLSelectElement).querySelectorAll('option').forEach(o => {
      const v = (o as HTMLOptionElement).value as NlOrder;
      o.textContent = `${nlSym(v)} ${NL_ORDER_SHORT[v]}`;
    });
    // readout: swap the α/χ symbol on Real/Imaginary/Abs labels (leave the λ alone)
    $('nl-readout').querySelectorAll('.lc').forEach(s => { if (s.textContent === 'α' || s.textContent === 'χ') s.textContent = nlQtyLetter(); });
  }
  $('nl-qty-toggle').addEventListener('click', event => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('.nl-qty-btn');
    if (!btn) return;
    nl.quantity = btn.dataset.nlqty as 'alpha' | 'chi';
    $('nl-qty-toggle').querySelectorAll<HTMLButtonElement>('.nl-qty-btn').forEach(b => { const a = b.dataset.nlqty === nl.quantity; b.classList.toggle('active', a); b.setAttribute('aria-checked', a ? 'true' : 'false'); });
    nlUpdateQtyUI();
    nl.cursorIdx = -1;
    renderNl();
  });
  $('nl-dl-png').addEventListener('click', () => {
    const canvas = $('nl-chart') as HTMLCanvasElement;
    canvas.toBlob(blob => { if (blob) downloadBlob(blob, `nlplasmon_${nl.material}_${nl.geometry}_alpha${nl.order}.png`); }, 'image/png');
  });
  $('nl-dl-csv').addEventListener('click', () => {
    if (!nlResult) computeNl();
    const r = nlResult!, f = nlDispFactor(), u = nlUnitLbl(), q = nl.quantity === 'chi' ? 'chi' : 'alpha';
    const lines = [
      `# Nonlinear-plasmonics ${q === 'chi' ? 'susceptibility' : 'polarizability'}`,
      `# material=${NL_MAT_LABEL[nl.material]}, geometry=${nl.geometry}, order=${q}(${nl.order}), D_nm=${nl.D}, EF_eV=${nl.EF}, gamma_eV=${nl.gamma}, unit=${u}`,
      `energy_eV,wavelength_nm,Re_${q},Im_${q},abs_${q}`,
    ];
    for (let i = 0; i < r.E.length; i++) {
      lines.push([r.E[i], HC_EV_NM / r.E[i], r.re[i] * f, r.im[i] * f, Math.hypot(r.re[i], r.im[i]) * f].map(v => Number(v).toPrecision(8)).join(','));
    }
    downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), `nlplasmon_${nl.material}_${q}${nl.order}.csv`);
  });
  {
    const nlCanvas = $('nl-chart') as HTMLCanvasElement;
    const M_LEFT = 72, M_RIGHT = 22;
    nlCanvas.addEventListener('mousemove', e => {
      if (!nlResult) return;
      const rect = nlCanvas.getBoundingClientRect();
      const frac = (e.clientX - rect.left - M_LEFT) / (rect.width - M_LEFT - M_RIGHT);
      if (frac < 0 || frac > 1) { if (nl.cursorIdx !== -1) { nl.cursorIdx = -1; setNlReadout(-1); drawNlChart(); } return; }
      const E = nlResult.E, n = E.length, Elo = E[0], Ehi = E[n - 1];
      let targetE: number;
      if (nl.axis === 'energy') targetE = Elo + frac * (Ehi - Elo);
      else { const lam = HC_EV_NM / Ehi + frac * (HC_EV_NM / Elo - HC_EV_NM / Ehi); targetE = HC_EV_NM / lam; }
      let idx = 0, best = Infinity; for (let i = 0; i < n; i++) { const d = Math.abs(E[i] - targetE); if (d < best) { best = d; idx = i; } }
      if (idx !== nl.cursorIdx) { nl.cursorIdx = idx; setNlReadout(idx); drawNlChart(); }
    });
    nlCanvas.addEventListener('mouseleave', () => { if (nl.cursorIdx !== -1) { nl.cursorIdx = -1; setNlReadout(-1); drawNlChart(); } });
  }

  // ── cursor + export for the Spectrum and Material charts ──
  function wireNlCursor(canvasId: string, getE: () => Float64Array | null, redraw: () => void) {
    const cv = $(canvasId) as HTMLCanvasElement;
    const M_LEFT = 76, M_RIGHT = 22;
    cv.addEventListener('mousemove', e => {
      const E = getE(); if (!E) return;
      const rect = cv.getBoundingClientRect();
      const frac = (e.clientX - rect.left - M_LEFT) / (rect.width - M_LEFT - M_RIGHT);
      if (frac < 0 || frac > 1) { if (nl.cursorIdx !== -1) { nl.cursorIdx = -1; setNlReadout(-1); redraw(); } return; }
      const n = E.length, Elo = E[0], Ehi = E[n - 1];
      const targetE = nl.axis === 'energy' ? Elo + frac * (Ehi - Elo) : HC_EV_NM / (HC_EV_NM / Ehi + frac * (HC_EV_NM / Elo - HC_EV_NM / Ehi));
      let idx = 0, best = Infinity; for (let i = 0; i < n; i++) { const d = Math.abs(E[i] - targetE); if (d < best) { best = d; idx = i; } }
      if (idx !== nl.cursorIdx) { nl.cursorIdx = idx; setNlReadout(idx); redraw(); }
    });
    cv.addEventListener('mouseleave', () => { if (nl.cursorIdx !== -1) { nl.cursorIdx = -1; setNlReadout(-1); redraw(); } });
  }
  wireNlCursor('nl-spectrum-chart', () => nlSpecData ? nlSpecData.E : null, drawNlSpectrum);
  wireNlCursor('nl-material-chart', () => nlMatData ? nlMatData.E : null, drawNlMaterial);

  $('nl-spec-dl-png').addEventListener('click', () => { ($('nl-spectrum-chart') as HTMLCanvasElement).toBlob(b => { if (b) downloadBlob(b, `nlplasmon_${nl.material}_${nl.geometry}_spectrum.png`); }, 'image/png'); });
  $('nl-spec-dl-csv').addEventListener('click', () => {
    if (!nlSpecData) drawNlSpectrum();
    const d = nlSpecData!;
    const lines = ['# 2D linear cross sections per area, σ = (4πω/c)Im α(1,1)', `# material=${NL_MAT_LABEL[nl.material]}, geometry=${nl.geometry}, D_nm=${nl.D}, EF_eV=${nl.EF}`, 'energy_eV,wavelength_nm,extinction,absorption,scattering'];
    for (let i = 0; i < d.E.length; i++) lines.push([d.E[i], HC_EV_NM / d.E[i], d.ext[i], d.abs[i], d.sca[i]].map(v => Number(v).toPrecision(8)).join(','));
    downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), `nlplasmon_${nl.material}_${nl.geometry}_spectrum.csv`);
  });
  $('nl-mat-dl-png').addEventListener('click', () => { ($('nl-material-chart') as HTMLCanvasElement).toBlob(b => { if (b) downloadBlob(b, `nlplasmon_${nl.material}_material.png`); }, 'image/png'); });
  $('nl-mat-dl-csv').addEventListener('click', () => {
    if (!nlMatData) drawNlMaterial();
    const d = nlMatData!;
    const lines = ['# 2D material response', `# material=${NL_MAT_LABEL[nl.material]}, quantity=${d.sym}${d.unit ? ' [' + d.unit + ']' : ''}`, 'energy_eV,wavelength_nm,Re,Im'];
    for (let i = 0; i < d.E.length; i++) lines.push([d.E[i], HC_EV_NM / d.E[i], d.re[i], d.im[i]].map(v => Number(v).toPrecision(8)).join(','));
    downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), `nlplasmon_${nl.material}_material.csv`);
  });

  // Cursor readout on the polarizability chart.
  {
    const chartCanvas = $('plasmon-chart') as HTMLCanvasElement;
    const POL_M_LEFT = 70, POL_M_RIGHT = 22;
    chartCanvas.addEventListener('mousemove', event => {
      if (state.tab !== 'polar' || !result) return;
      const rect = chartCanvas.getBoundingClientRect();
      const frac = (event.clientX - rect.left - POL_M_LEFT) / (rect.width - POL_M_LEFT - POL_M_RIGHT);
      if (frac < 0 || frac > 1) { if (cursorIdx !== -1) { cursorIdx = -1; setPolarReadout(-1); drawChart(); } return; }
      const [xMin, xMax] = axisRange();
      const axisVal = xMin + frac * (xMax - xMin);
      const lambda = state.xAxis === 'energy' ? HC_EV_NM / axisVal : axisVal;
      const idx = nearestIndex(result.wavelengthNm, lambda);
      if (idx !== cursorIdx) { cursorIdx = idx; setPolarReadout(idx); drawChart(); }
    });
    chartCanvas.addEventListener('mouseleave', () => {
      if (state.tab === 'polar' && cursorIdx !== -1) { cursorIdx = -1; setPolarReadout(-1); drawChart(); }
    });
  }

  import { downloadBlob } from '../../lib/download';

  $('dl-png').addEventListener('click', () => {
    const canvas = $('plasmon-chart') as HTMLCanvasElement;
    const name = `plasmonic_${state.materialId}_${state.shape.replace(/\s+/g, '-')}_${state.tab}.png`;
    canvas.toBlob(blob => { if (blob) downloadBlob(blob, name); }, 'image/png');
  });

  $('dl-csv').addEventListener('click', () => {
    if (!result) return;
    downloadBlob(new Blob([currentCsv()], { type: 'text/csv' }), `plasmonic_${state.materialId}_${state.tab}.csv`);
  });

  function currentCsv(): string {
    const header = [
      `# Plasmonic nanoparticles lab`,
      `# material=${materialLabelForExport()}, shape=${state.shape}, L_nm=${state.lengthNm}, R=${state.aspectRatio}, n_host=${state.hostIndex}, modes=${state.modeCount}`,
    ];
    if (state.tab === 'spectrum' && result) {
      const lines = [...header, 'wavelength_nm,energy_eV,sigma_ext_nm2,sigma_abs_nm2,sigma_sca_nm2,sigma_ext_over_V_nm-1,sigma_abs_over_V_nm-1,sigma_sca_over_V_nm-1,quantum_yield'];
      for (let i = 0; i < result.wavelengthNm.length; i++) {
        lines.push([
          result.wavelengthNm[i],
          HC_EV_NM / result.wavelengthNm[i],
          result.sigmaExtNm2[i],
          result.sigmaAbsNm2[i],
          result.sigmaScaNm2[i],
          result.sigmaExtOverV[i],
          result.sigmaAbsOverV[i],
          result.sigmaScaOverV[i],
          result.quantumYield[i],
        ].map(v => Number(v).toPrecision(8)).join(','));
      }
      return lines.join('\n') + '\n';
    }
    if (state.tab === 'material') {
      const lines = [...header, 'wavelength_nm,energy_eV,epsilon_re,epsilon_im'];
      for (let i = 0; i < 320; i++) {
        const lambda = state.lambdaMinNm + (state.lambdaMaxNm - state.lambdaMinNm) * i / 319;
        const eps = currentEpsilon(lambda);
        lines.push(`${lambda.toPrecision(8)},${(HC_EV_NM / lambda).toPrecision(8)},${eps.re.toPrecision(8)},${eps.im.toPrecision(8)}`);
      }
      return lines.join('\n') + '\n';
    }
    if (state.tab === 'resonance') {
      const sweep = resonanceSweepData();
      const xName = sweep.sweep === 'L' ? 'length_nm' : 'aspect_ratio';
      const lines = [...header, `${xName},lambda_peak_nm,Q`];
      for (let i = 0; i < sweep.x.length; i++) {
        lines.push([sweep.x[i], sweep.lambdaPeak[i], sweep.q[i]].map(v => Number(v).toPrecision(8)).join(','));
      }
      return lines.join('\n') + '\n';
    }
    if (state.tab === 'ldos' && result) {
      const data = ldosFieldData();
      const lines = [
        ...header,
        `# ${ldosProbeDescription()} distance_nm=${LDOS_PROBE_DISTANCE_NM}`,
        'wavelength_nm,ldos_over_ldos0_modal,field_enhancement',
      ];
      for (let i = 0; i < data.wavelengthNm.length; i++) {
        lines.push([data.wavelengthNm[i], data.ldos[i], data.fieldEnhancement[i]].map(v => Number(v).toPrecision(8)).join(','));
      }
      return lines.join('\n') + '\n';
    }
    return header.join('\n') + '\n';
  }

  function materialLabelForExport(): string {
    if (state.materialId === 'drude') return `drude(eps_b=${state.drudeEpsB},wp_eV=${state.drudeWpEv},gamma_eV=${state.drudeGammaEv})`;
    if (state.materialId === 'file') return uploadedMaterial ? 'uploaded_file' : 'file_unloaded';
    if (state.materialId === 'rii') return selectedDatabaseLabel || 'database_unselected';
    return `${state.materialId} (${MATERIALS[state.materialId]?.ref ?? ''})`;
  }

  const shareBtn = $('share-btn');
  function serializeState(): string {
    const p = new URLSearchParams();
    p.set('mat', state.materialId);
    if (state.materialId === 'drude') {
      p.set('epsb', String(state.drudeEpsB));
      p.set('wp', String(state.drudeWpEv));
      p.set('gamma', String(state.drudeGammaEv));
    }
    p.set('shape', state.shape);
    p.set('L', String(state.lengthNm));
    p.set('R', String(state.aspectRatio));
    p.set('nh', String(state.hostIndex));
    p.set('min', String(state.lambdaMinNm));
    p.set('max', String(state.lambdaMaxNm));
    p.set('modes', String(state.modeCount));
    p.set('view', state.tab);
    p.set('axis', state.xAxis);
    p.set('sweep', state.resonanceSweep);
    return p.toString();
  }
  shareBtn.addEventListener('click', () => {
    const url = `${location.origin}${location.pathname}#${serializeState()}`;
    navigator.clipboard.writeText(url).then(() => {
      const old = shareBtn.innerHTML;
      shareBtn.textContent = 'Copied!';
      setTimeout(() => { shareBtn.innerHTML = old; }, 1400);
    });
  });

  function restoreState() {
    const hash = location.hash.slice(1);
    if (!hash) return;
    const p = new URLSearchParams(hash);
    if (p.has('mat')) state.materialId = p.get('mat')!;
    if (p.has('epsb')) state.drudeEpsB = Number.parseFloat(p.get('epsb')!);
    if (p.has('wp')) state.drudeWpEv = Number.parseFloat(p.get('wp')!);
    if (p.has('gamma')) state.drudeGammaEv = Number.parseFloat(p.get('gamma')!);
    if (p.has('shape')) state.shape = p.get('shape') as PlasmonShapeId;
    if (p.has('L')) state.lengthNm = Number.parseFloat(p.get('L')!);
    if (p.has('R')) state.aspectRatio = Number.parseFloat(p.get('R')!);
    if (p.has('nh')) state.hostIndex = Number.parseFloat(p.get('nh')!);
    if (p.has('min')) state.lambdaMinNm = Number.parseFloat(p.get('min')!);
    if (p.has('max')) state.lambdaMaxNm = Number.parseFloat(p.get('max')!);
    if (p.has('modes')) state.modeCount = Number.parseInt(p.get('modes')!, 10);
    if (p.has('view') && ['spectrum', 'polar', 'material', 'resonance', 'ldos'].includes(p.get('view')!)) state.tab = p.get('view') as TabId;
    if (p.has('axis') && ['lambda', 'energy'].includes(p.get('axis')!)) state.xAxis = p.get('axis') as ChartAxisMode;
    if (p.has('sweep') && ['L', 'R'].includes(p.get('sweep')!)) state.resonanceSweep = p.get('sweep') as ResonanceSweep;

    document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(btn => {
      const active = btn.dataset.tab === state.tab;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });
  }

  restoreState();
  render();

  new ResizeObserver(() => drawChart()).observe($('chart-wrap'));
  onThemeChange(() => drawChart());
</script>
