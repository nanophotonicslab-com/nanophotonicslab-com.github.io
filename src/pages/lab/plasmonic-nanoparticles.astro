  function geometryDefinitions(shape: PlasmonShapeId, widthText: string): { l: string; w: string } {
    if (shape === 'rod' || shape === 'rod transverse') {
      return {
        l: 'end-to-end nanorod length, including the hemispherical caps',
        w: `rod diameter / short-axis width (${widthText})`,
      };
    }
    if (shape === 'disk') {
      return {
        l: 'disk diameter in the plane of the disk',
        w: `disk thickness (${widthText})`,
      };
    }
    if (shape === 'ring') {
      return {
        l: 'outer ring diameter',
        w: `tube diameter (${widthText})`,
      };
    }
    if (shape === 'cage') {
      return {
        l: 'outer side length of the cubic nanocage',
        w: `interior cavity side length, drawn inside the cage`,
      };
    }
    if (shape === 'triangle') {
      return {
        l: 'triangle edge length',
        w: 'prism thickness set by the fitted fixed-ratio geometry',
      };
    }
    if (shape === 'cylinder') {
      return {
        l: 'cylinder length along its symmetry axis',
        w: `cylinder diameter (${widthText})`,
      };
    }
    if (shape === 'tetrahedron' || shape === 'octahedron' || shape === 'decahedron') {
      return {
        l: 'outer vertex-to-vertex size used by the fitted shape table',
        w: 'transverse size fixed by the polyhedral geometry',
      };
    }
    return {
      l: 'long-axis or outer characteristic length of the selected shape',
      w: `transverse width (${widthText})`,
    };
  }

  function updateGeometrySchematic() {
    const opt = shapeOption(state.shape);
    $('shape-strip-current').textContent = opt.label;
    const aspectText = opt.minR === opt.maxR ? `R fixed at ${fmt(state.aspectRatio, 2)}` : `R = ${fmt(state.aspectRatio, 2)}`;
    const widthText = opt.minR === opt.maxR ? 'W = L' : 'W = L / R';
    const definitions = geometryDefinitions(state.shape, widthText);
    $('geometry-schematic').innerHTML = `
      <div class="geometry-schematic__title">
        <span>${opt.label}</span>
        <span>L = ${fmtFixed(state.lengthNm, 0)} nm, ${aspectText}</span>
      </div>
      <svg viewBox="0 0 300 220" role="img" aria-label="${opt.label} geometry convention">
        <defs>
          <marker id="schematic-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto-start-reverse" markerUnits="strokeWidth">
            <path d="M0,0 L8,4 L0,8 Z" fill="currentColor"></path>
          </marker>
          <linearGradient id="metal-face" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0%" stop-color="#EEF2FF"></stop>
            <stop offset="52%" stop-color="#A5B4FC"></stop>
            <stop offset="100%" stop-color="#6366F1"></stop>
          </linearGradient>
          <linearGradient id="metal-side" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0%" stop-color="#C7D2FE"></stop>
            <stop offset="100%" stop-color="#4F46E5"></stop>
          </linearGradient>
          <filter id="schematic-shadow" x="-20%" y="-20%" width="140%" height="150%">
            <feDropShadow dx="0" dy="4" stdDeviation="3" flood-color="#312E81" flood-opacity="0.18"></feDropShadow>
          </filter>
        </defs>
        ${electricOscillationArrow(state.shape)}
        ${schematicObject(state.shape)}
        ${splitDimensionArrows(state.shape)}
      </svg>
      <div class="geometry-definitions">
        <span><strong>L</strong> = ${definitions.l}</span>
        <span><strong>W</strong> = ${definitions.w}</span>
      </div>
    `;
  }

  function setPolarReadout(idx: number) {
    if (!result) return;
    const n = result.alpha.length;
    const i = idx >= 0 && idx < n ? idx : nearestIndex(result.wavelengthNm, result.peak.lambdaPeakNm);
    const lam = result.wavelengthNm[i], a = result.alpha[i], f = ALPHA_UNITS[alphaUnit].factor, u = ALPHA_UNITS[alphaUnit].label;
    $('pol-lambda').textContent = fmtFixed(lam, 1);
    $('pol-energy').textContent = fmt(HC_EV_NM / lam, 4);
    $('pol-re').textContent = fmt(a.re * f, 3);
    $('pol-im').textContent = fmt(a.im * f, 3);
    $('pol-abs').textContent = fmt(Math.hypot(a.re, a.im) * f, 3);
    $('pol-unit-re').textContent = u; $('pol-unit-im').textContent = u; $('pol-unit-abs').textContent = u;
  }

  function updateOutputs() {
    const isPolar = state.tab === 'polar';
    $('peak-stats').style.display = isPolar ? 'none' : '';
    $('polar-readout').style.display = isPolar ? '' : 'none';
    if (!result) return;
    if (isPolar) setPolarReadout(cursorIdx);
    const peak = result.peak;
    const idx = nearestIndex(result.wavelengthNm, peak.lambdaPeakNm);
    const cext = result.sigmaExtNm2[idx];
    const csca = result.sigmaScaNm2[idx];
    const albedo = cext > 0 ? csca / cext : Number.NaN;

    $('out-peak-lambda').textContent = fmtFixed(peak.lambdaPeakNm, 0);
    $('out-q').textContent = fmt(peak.q, 3);
    $('out-yield').textContent = fmt(result.quantumYield[idx], 3);
    $('out-ext').textContent = fmt(peak.peakValue, 3);
    $('out-albedo').textContent = fmt(albedo, 3);
    $('out-volume').textContent = fmt(result.volumeNm3, 3);

    const notes = validityNotes({
      shape: state.shape,
      materialId: state.materialId,
      lengthNm: state.lengthNm,
      aspectRatio: state.aspectRatio,
      hostIndex: state.hostIndex,
      lambdaMinNm: state.lambdaMinNm,
      lambdaMaxNm: state.lambdaMaxNm,
      modeCount: state.modeCount,
    });
    $('validity-note').textContent = notes.length
      ? notes.join(' ')
      : 'Homogeneous local-response particles in a uniform host. The scalar modal model does not provide exact near-field or LDOS maps.';
    $('mode-summary').textContent = result.modes.length === 1
      ? `1 fitted mode`
      : `${result.modes.length} fitted modes`;
  }

  function updateSwatches() {
    $('color-swatches').style.display = state.tab === 'polar' ? 'none' : '';   // apparent colour is meaningless for α
    const swatchSca = $('swatch-sca');
    const swatchTrans = $('swatch-trans');
    if (!result) {
      swatchSca.style.background = '#222';
      swatchTrans.style.background = '#222';
      return;
    }

    const colorResult = computePlasmonSpectrum({
      shape: state.shape,
      materialId: state.materialId,
      epsilonAt: currentEpsilon,
      lengthNm: state.lengthNm,
      aspectRatio: state.aspectRatio,
      hostIndex: state.hostIndex,
      lambdaMinNm: COLOR_LAMBDA_MIN_NM,
      lambdaMaxNm: COLOR_LAMBDA_MAX_NM,
      points: COLOR_LAMBDA_MAX_NM - COLOR_LAMBDA_MIN_NM + 1,
      modeCount: state.modeCount,
    });

    const n = colorResult.wavelengthNm.length;
    const scaMax = Math.max(...colorResult.sigmaScaOverV);
    if (scaMax > 0) {
      const scattered = new Float64Array(n);
      for (let i = 0; i < n; i++) scattered[i] = Math.max(0, colorResult.sigmaScaOverV[i] / scaMax);
      swatchSca.style.background = spectrumToHex(colorResult.wavelengthNm, scattered);
    } else {
      swatchSca.style.background = '#222';
    }

    const extMax = Math.max(...colorResult.sigmaExtOverV);
    if (extMax > 0) {
      const transmitted = new Float64Array(n);
      for (let i = 0; i < n; i++) transmitted[i] = Math.exp(-2 * Math.max(0, colorResult.sigmaExtOverV[i]) / extMax);
      swatchTrans.style.background = spectrumToHex(colorResult.wavelengthNm, transmitted);
    } else {
      swatchTrans.style.background = '#222';
    }
  }

  function ldosProbeAxis(): string {
    if (state.shape === 'rod transverse') return 'W, the transverse short-axis mode direction';
    return 'L, the dominant dipole / long-axis direction';
  }

  function ldosProbeSurface(): string {
    if (state.shape === 'rod transverse') return 'the side surface at the +W pole';
    if (state.shape === 'disk' || state.shape === 'ring') return 'the outer rim at the +L pole';
    return 'the +L tip / outer surface';
  }

  function ldosProbeDescription(): string {
    return `Probe orientation: ${ldosProbeAxis()}; position: ${LDOS_PROBE_DISTANCE_NM} nm outside ${ldosProbeSurface()}.`;
  }

  function updateLdosProbeNote() {
    const note = $('ldos-probe-note');
    note.style.display = state.tab === 'ldos' ? 'block' : 'none';
    if (state.tab === 'ldos') {
      note.textContent = `${ldosProbeDescription()} The plotted LDOS is a scalar modal hotspot estimator, not a full spatial near-field map.`;
    }
  }

  function updateAlphaUnitControls() {
    const controls = $('alpha-unit-controls');
    controls.style.display = state.tab === 'polar' ? 'inline-flex' : 'none';
    controls.querySelectorAll<HTMLButtonElement>('.seg-btn').forEach(btn => {
      const active = btn.dataset.aunit === alphaUnit;
      btn.classList.toggle('active', active);
    });
  }

  function updateChartCopy() {
    updateAxisControls();
    updateAlphaUnitControls();
    const title = $('chart-title');
    const subtitle = $('chart-subtitle');
    const legend = $('chart-legend');
    if (state.tab === 'spectrum') {
      title.textContent = 'Extinction, absorption, scattering';
      subtitle.textContent = 'Cross sections per particle volume';
      legend.innerHTML = legendHtml([
        ['Extinction', colors.ext],
        ['Absorption', colors.abs],
        ['Scattering', colors.sca],
      ]);
    } else if (state.tab === 'polar') {
      title.textContent = 'Dipolar polarizability α(ω)';
      subtitle.textContent = `Linear polarizability α⁽¹⁾ in ${ALPHA_UNITS[alphaUnit].label} units · hover the curve for cursor values`;
      legend.innerHTML = legendHtml([
        ['Re α', colors.re],
        ['Im α', colors.im],
        ['|α|', colors.ext],
      ]);
      updateResonanceControls();
      updateLdosProbeNote();
      return;
    } else {
      if (state.tab === 'resonance') {
        title.textContent = 'Resonance sweep';
        subtitle.textContent = state.resonanceSweep === 'L'
          ? `Peak wavelength and Q versus L at fixed R = ${fmt(state.aspectRatio, 3)}; search 350-2200 nm`
          : `Peak wavelength and Q versus R at fixed L = ${fmtFixed(state.lengthNm, 0)} nm; search 350-2200 nm`;
        legend.innerHTML = legendHtml([
          ['Resonance λ', colors.ext],
          ['Q factor', colors.re],
        ]);
        updateResonanceControls();
        updateLdosProbeNote();
        return;
      }
      if (state.tab === 'ldos') {
        title.textContent = 'LDOS and field enhancement';
        subtitle.textContent = ldosProbeDescription();
        legend.innerHTML = legendHtml([
          ['LDOS / LDOS0', colors.ldos],
          ['Field enhancement', colors.fe],
        ]);
        updateResonanceControls();
        updateLdosProbeNote();
        return;
      }
      title.textContent = 'Material dielectric function';
      subtitle.textContent = materialChartSubtitle();
      legend.innerHTML = legendHtml([
        ['Re epsilon', colors.re],
        ['Im epsilon', colors.im],
      ]);
    }
    updateResonanceControls();
    updateLdosProbeNote();
  }

  function materialChartSubtitle(): string {
    if (state.materialId === 'drude') return 'Tunable Drude dielectric function';
    if (state.materialId === 'file') return uploadedMaterial ? 'Computed from uploaded optical constants' : 'Upload optical constants to replace the fallback preview';
    if (state.materialId === 'rii') return selectedDatabaseLabel || 'Search database to replace the fallback preview';
    return 'Computed from tabulated n,k interpolation';
  }

  function legendHtml(items: [string, string][]): string {
    return items.map(([label, color]) => `<span class="legend-item"><span class="legend-swatch" style="background:${color}"></span>${label}</span>`).join('');
  }

  function render() {
    compute();
    updateControls();
    updateOutputs();
    updateSwatches();
    updateChartCopy();
    drawChart();
    // highlight the Notes "Fig. 5a" button when the current config reproduces it
    $('fig5a-btn').classList.toggle('active', state.materialId === 'au' && state.shape === 'rod'
      && Math.abs(state.lengthNm - 50) < 1e-6 && Math.abs(state.aspectRatio - 4) < 1e-6);
  }

  function drawChart() {
    if (!result) return;
    if (state.tab === 'spectrum') drawSpectrumChart();
    else if (state.tab === 'polar') drawPolarizabilityChart();
    else if (state.tab === 'material') drawMaterialChart();
    else if (state.tab === 'ldos') drawLdosChart();
    else drawResonanceChart();
  }

  function hasAxisToggle(): boolean {
    return state.tab === 'spectrum' || state.tab === 'polar' || state.tab === 'material';
  }

  function updateAxisControls() {
    const overlay = $('axis-overlay');
    overlay.style.display = hasAxisToggle() ? 'block' : 'none';
    overlay.querySelectorAll<HTMLButtonElement>('.axis-btn').forEach(btn => {
      const active = btn.dataset.axis === state.xAxis;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
    });
  }

  function axisRange(): [number, number] {
    if (state.xAxis === 'energy') return [HC_EV_NM / state.lambdaMaxNm, HC_EV_NM / state.lambdaMinNm];
    return [state.lambdaMinNm, state.lambdaMaxNm];
  }

  function axisLabel(): string {
    return state.xAxis === 'energy' ? 'Photon energy (eV)' : 'Wavelength \u03BB (nm)';
  }

  function axisValue(lambdaNm: number): number {
    return state.xAxis === 'energy' ? HC_EV_NM / lambdaNm : lambdaNm;
  }

  function axisArray(lambdaNm: Float64Array): ArrayLike<number> {
    if (state.xAxis === 'lambda') return lambdaNm;
    const x = new Float64Array(lambdaNm.length);
    for (let i = 0; i < lambdaNm.length; i++) x[i] = HC_EV_NM / lambdaNm[lambdaNm.length - 1 - i];
    return x;
  }

  function axisSeries(values: Float64Array): ArrayLike<number> {
    if (state.xAxis === 'lambda') return values;
    const y = new Float64Array(values.length);
    for (let i = 0; i < values.length; i++) y[i] = values[values.length - 1 - i];
    return y;
  }

  function peakAxisLabel(lambdaNm: number): string {
    if (state.xAxis === 'energy') return `${fmtFixed(HC_EV_NM / lambdaNm, 2)} eV`;
    return `${fmtFixed(lambdaNm, 0)} nm`;
  }

  function canvasSetup(id = 'plasmon-chart') {
    const canvas = $(id) as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const dpr = window.devicePixelRatio || 1;
    const w = Math.max(320, canvas.clientWidth);
    const h = Math.max(240, canvas.clientHeight);
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    return { canvas, ctx, w, h, theme: chartTheme() };
  }

  function drawSpectrumChart() {
    if (!result) return;
    const { ctx, w, h, theme } = canvasSetup();
    const m = { top: 18, right: 22, bottom: 42, left: 58 };
    const [xMin, xMax] = axisRange();
    const xArr = axisArray(result.wavelengthNm);
    const series = [
      { data: axisSeries(result.sigmaExtOverV), color: colors.ext, label: 'Extinction' },
      { data: axisSeries(result.sigmaAbsOverV), color: colors.abs, label: 'Absorption' },
      { data: axisSeries(result.sigmaScaOverV), color: colors.sca, label: 'Scattering' },
    ];
    let yMin = 0;
    let yMax = 0;
    for (const s of series) {
      for (let i = 0; i < s.data.length; i++) {
        yMax = Math.max(yMax, s.data[i]);
        yMin = Math.min(yMin, s.data[i]);
      }
    }
    if (yMax <= yMin) yMax = yMin + 1;
    yMax *= 1.08;

    const plot = drawAxes(ctx, w, h, m, xMin, xMax, yMin, yMax, axisLabel(), 'sigma / V (nm^-1)', theme);
    for (const s of series) drawLine(ctx, xArr, s.data, plot, s.color, 2.2);

    const xPeak = plot.xTo(axisValue(result.peak.lambdaPeakNm));
    if (xPeak >= m.left && xPeak <= w - m.right) {
      ctx.setLineDash([3, 3]);
      ctx.strokeStyle = colors.peak;
      ctx.lineWidth = 1.3;
      ctx.beginPath();
      ctx.moveTo(xPeak, m.top);
      ctx.lineTo(xPeak, h - m.bottom);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = colors.peak;
      ctx.font = '600 10px Inter, system-ui, sans-serif';
      ctx.textAlign = xPeak > w - m.right - 72 ? 'right' : 'left';
      ctx.textBaseline = 'top';
      ctx.fillText(peakAxisLabel(result.peak.lambdaPeakNm), xPeak + (xPeak > w - m.right - 72 ? -5 : 5), m.top + 3);
    }
  }

  // Polarizability α⁽¹⁾(ω) in the selected unit system (esu / SI / a.u.).
  function drawPolarizabilityChart() {
    if (!result) return;
    const { ctx, w, h, theme } = canvasSetup();
    const m = { top: 18, right: 22, bottom: 42, left: 70 };
    const [xMin, xMax] = axisRange();
    const f = ALPHA_UNITS[alphaUnit].factor;
    const n = result.alpha.length;
    const reN = new Float64Array(n), imN = new Float64Array(n), absN = new Float64Array(n);
    for (let i = 0; i < n; i++) { const a = result.alpha[i]; reN[i] = a.re * f; imN[i] = a.im * f; absN[i] = Math.hypot(a.re, a.im) * f; }
    const xArr = axisArray(result.wavelengthNm);
    const series = [
      { data: axisSeries(reN), color: colors.re, label: 'Re α' },
      { data: axisSeries(imN), color: colors.im, label: 'Im α' },
      { data: axisSeries(absN), color: colors.ext, label: '|α|' },
    ];
    let yMin = 0, yMax = 0;
    for (const s of series) for (let i = 0; i < s.data.length; i++) { const v = s.data[i]; if (Number.isFinite(v)) { yMax = Math.max(yMax, v); yMin = Math.min(yMin, v); } }
    if (yMax <= yMin) yMax = yMin + 1;
    const pad = 0.08 * (yMax - yMin);
    yMax += pad; yMin -= pad;

    const plot = drawAxes(ctx, w, h, m, xMin, xMax, yMin, yMax, axisLabel(), ALPHA_UNITS[alphaUnit].axis, theme);
    if (yMin < 0 && yMax > 0) { ctx.save(); ctx.strokeStyle = theme.grid; ctx.setLineDash([2, 3]); ctx.beginPath(); const y0 = plot.yTo(0); ctx.moveTo(plot.left, y0); ctx.lineTo(plot.right, y0); ctx.stroke(); ctx.restore(); }
    for (const s of series) drawLine(ctx, xArr, s.data, plot, s.color, 2.2);

    // cursor crosshair at the hovered wavelength
    if (cursorIdx >= 0 && cursorIdx < n) {
      const xc = plot.xTo(axisValue(result.wavelengthNm[cursorIdx]));
      if (xc >= plot.left && xc <= plot.right) {
        ctx.save(); ctx.setLineDash([3, 3]); ctx.strokeStyle = colors.peak; ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.moveTo(xc, plot.top); ctx.lineTo(xc, plot.bottom); ctx.stroke(); ctx.restore();
        ctx.fillStyle = colors.peak;
        for (const arr of [reN, imN, absN]) { const yv = plot.yTo(arr[cursorIdx]); if (yv >= plot.top && yv <= plot.bottom) { ctx.beginPath(); ctx.arc(xc, yv, 3, 0, 2 * Math.PI); ctx.fill(); } }
        ctx.fillStyle = colors.peak; ctx.font = '600 10px Inter, system-ui, sans-serif';
        ctx.textAlign = xc > plot.right - 72 ? 'right' : 'left'; ctx.textBaseline = 'top';
        ctx.fillText(peakAxisLabel(result.wavelengthNm[cursorIdx]), xc + (xc > plot.right - 72 ? -5 : 5), plot.top + 3);
      }
    }
  }

  // ── Nonlinear-plasmonics polarizability view ──
  function nlInterp(cs: { E: Float64Array; re: Float64Array; im: Float64Array }, E: number): { re: number; im: number } {
    const arr = cs.E, n = arr.length;
    if (E <= arr[0]) return { re: cs.re[0], im: cs.im[0] };
    if (E >= arr[n - 1]) return { re: cs.re[n - 1], im: cs.im[n - 1] };
    let a = 0, b = n - 1; while (b - a > 1) { const m = (a + b) >> 1; if (arr[m] <= E) a = m; else b = m; }
    const t = (E - arr[a]) / (arr[b] - arr[a]);
    return { re: cs.re[a] + t * (cs.re[b] - cs.re[a]), im: cs.im[a] + t * (cs.im[b] - cs.im[a]) };
  }
  function nlEpsAt(E: number): { re: number; im: number } {
    const lam = HC_EV_NM / E;
    if (nl.material === 'drude') return drudeEpsilon(lam, nl.drudeEpsInf, nl.drudeWp, nl.drudeGamma);
    if (nl.material === 'eps') return nlCustomEps ? nlInterp(nlCustomEps, E) : { re: 1, im: 0 };   // neutral ε until a file is loaded
    return epsilonFromMaterial(nl.material, lam);   // au/ag/cu/al
  }
  // Graphene σ²ᴰ: Drude (BTE) or local-RPA (intra+interband) per the model toggle.
  const grapheneSig = (E: number) => nl.grapheneModel === 'rpa' ? grapheneSigma2dRPA(E, nl.EF, nl.gamma, nl.temperature) : grapheneSigma2d(E, nl.EF, nl.gamma);
  function nlMaterial(): NlMaterial {
    if (nl.material === 'sigma') return { sigma2d: (E) => nlCustomSigma ? nlInterp(nlCustomSigma, E) : grapheneSig(E), nlEF: nl.EF, nlGamma: nl.gamma, doping: 1 };
    if (nlEpsBased(nl.material)) return { sigma2d: (E) => { const e = nlEpsAt(E); return metalSigma2d(E, e.re, e.im, nl.thickness); }, nlEF: nl.EF, nlGamma: nl.gamma, doping: 1 };
    // graphene: Local-RPA upgrades the Drude third order to full RPA via the Mikhailov interband
    // ratios — R_THG for σ³³ (THG) and R_Kerr for σ³¹ (Kerr, self-phase modulation).
    const boost = nl.grapheneModel === 'rpa'
      ? { sigma3Boost: (order: NlOrder, E: number) => order === '33' ? grapheneR_THG(E, nl.EF, nl.gamma) : order === '31' ? grapheneR_Kerr(E, nl.EF, nl.gamma) : { re: 1, im: 0 } }
      : {};
    return { sigma2d: grapheneSig, nlEF: nl.EF, nlGamma: nl.gamma, doping: 1, ...boost };   // graphene
  }
  // higher modes (j ≤ N, Eq. 27) — available for every geometry (Table S2 + SI ξ³ tensors)
  const nlMultimode = () => nl.modes > 1;
  function nlResonanceE(): number {
    if (nl.material === 'graphene') return nlResonanceEnergyGraphene(nl.geometry, nl.EF, nl.D, nl.epsBar);
    const r = nlResonance(nl.geometry, nl.D, nl.epsBar, nlMaterial().sigma2d);
    return Number.isFinite(r) ? r : 1.0;
  }
  function nlEnergyRange(): [number, number] { return [Math.min(nl.eMin, nl.eMax), Math.max(nl.eMin, nl.eMax)]; }
  // Seed the plot range: the file's span for uploads, else around the plasmon resonance.
  function nlSeedRange() {
    if (nl.material === 'sigma' && nlCustomSigma) { nl.eMin = nlCustomSigma.E[0]; nl.eMax = nlCustomSigma.E[nlCustomSigma.E.length - 1]; return; }
    if (nl.material === 'eps' && nlCustomEps) { nl.eMin = nlCustomEps.E[0]; nl.eMax = nlCustomEps.E[nlCustomEps.E.length - 1]; return; }
    const Er = nlResonanceE(); nl.eMin = Math.max(0.02, Er / 6); nl.eMax = Math.max(0.4, 1.3 * Er);
  }
  function nlRefreshUnitSelect() {
    const sel = $('nl-range-unit') as HTMLSelectElement, energy = nl.axis === 'energy';
    sel.innerHTML = energy ? '<option value="eV">eV</option><option value="meV">meV</option>' : '<option value="nm">nm</option><option value="um">µm</option>';
    if (energy && nl.rangeUnit !== 'eV' && nl.rangeUnit !== 'meV') nl.rangeUnit = 'eV';
    if (!energy && nl.rangeUnit !== 'nm' && nl.rangeUnit !== 'um') nl.rangeUnit = 'nm';
    sel.value = nl.rangeUnit;
  }
  function nlRefreshRangeInputs() {
    const energy = nl.axis === 'energy';
    let lo: number, hi: number, q: string, dp: number;
    if (energy) { const f = nl.rangeUnit === 'meV' ? 1000 : 1; lo = nl.eMin * f; hi = nl.eMax * f; q = nl.rangeUnit === 'meV' ? 'E (meV)' : 'E (eV)'; dp = nl.rangeUnit === 'meV' ? 0 : 3; }
    else { const f = nl.rangeUnit === 'um' ? 1e-3 : 1; lo = HC_EV_NM / nl.eMax * f; hi = HC_EV_NM / nl.eMin * f; q = nl.rangeUnit === 'um' ? 'λ (µm)' : 'λ (nm)'; dp = nl.rangeUnit === 'um' ? 3 : 0; }
    ($('nl-range-min') as HTMLInputElement).value = lo.toFixed(dp);
    ($('nl-range-max') as HTMLInputElement).value = hi.toFixed(dp);
    $('nl-range-min-label').textContent = 'Min ' + q; $('nl-range-max-label').textContent = 'Max ' + q;
  }
  function nlReadRangeInputs() {
    const a = parseFloat(($('nl-range-min') as HTMLInputElement).value), b = parseFloat(($('nl-range-max') as HTMLInputElement).value);
    if (!Number.isFinite(a) || !Number.isFinite(b) || a <= 0 || b <= 0) return;
    let eMin: number, eMax: number;
    if (nl.axis === 'energy') { const f = nl.rangeUnit === 'meV' ? 1e-3 : 1; eMin = Math.min(a, b) * f; eMax = Math.max(a, b) * f; }
    else { const f = nl.rangeUnit === 'um' ? 1000 : 1; const l1 = a * f, l2 = b * f; eMin = HC_EV_NM / Math.max(l1, l2); eMax = HC_EV_NM / Math.min(l1, l2); }
    if (eMax > eMin) { nl.eMin = eMin; nl.eMax = eMax; }
  }
  function computeNl() {
    const [Elo, Ehi] = nlEnergyRange();
    const N = 360, E = new Float64Array(N);
    for (let i = 0; i < N; i++) E[i] = Elo + (Ehi - Elo) * i / (N - 1);
    const { re, im } = nlMultimode()
      ? geometrySpectrumMulti(nl.geometry, nl.order, nl.D, nl.epsBar, nlMaterial(), E, nl.modes)
      : nlSpectrum(nl.order, nl.geometry, nl.D, nl.epsBar, nlMaterial(), E);
    nlResult = { E, re, im };
  }
  const nlAxisValue = (E: number) => nl.axis === 'lambda' ? HC_EV_NM / E : E;
  const nlAxisLabel = () => nl.axis === 'lambda' ? 'Wavelength λ (nm)' : 'Photon energy (eV)';

  function drawNlChart() {
    if (!nlResult) computeNl();
    const r = nlResult!;
    const { ctx, w, h, theme } = canvasSetup('nl-chart');
    const m = { top: 18, right: 22, bottom: 48, left: 76 };
    const f = nlDispFactor();
    const n = r.E.length;
    const reN = new Float64Array(n), imN = new Float64Array(n), absN = new Float64Array(n);
    for (let i = 0; i < n; i++) { reN[i] = r.re[i] * f; imN[i] = r.im[i] * f; absN[i] = Math.hypot(r.re[i], r.im[i]) * f; }
    const tr = (v: number) => nl.log ? (Math.abs(v) > 0 ? Math.log10(Math.abs(v)) : NaN) : v;   // log₁₀|·| when log scale is on
    const ord = Array.from({ length: n }, (_, i) => i); if (nl.axis === 'lambda') ord.reverse();
    const xs = ord.map(i => nlAxisValue(r.E[i]));
    const reS = ord.map(i => tr(reN[i])), imS = ord.map(i => tr(imN[i])), absS = ord.map(i => tr(absN[i]));
    // log scale only makes sense for the (positive) magnitude — Re/Im change sign, so plot |·| alone.
    const series = nl.log ? [absS] : [reS, imS, absS];
    let yMin = nl.log ? Infinity : 0, yMax = nl.log ? -Infinity : 0;
    for (const arr of series) for (const v of arr) if (Number.isFinite(v)) { yMax = Math.max(yMax, v); yMin = Math.min(yMin, v); }
    if (!Number.isFinite(yMin) || yMax <= yMin) { yMin = nl.log ? yMin - 1 : 0; yMax = (Number.isFinite(yMax) ? yMax : 0) + 1; }
    const pad = 0.08 * (yMax - yMin); yMax += pad; yMin -= pad;
    const yLabel = `${nlSym(nl.order)} (${nlUnitLbl()})`;   // log scale is conveyed by the 10ⁿ ticks
    const plot = drawAxes(ctx, w, h, m, xs[0], xs[n - 1], yMin, yMax, nlAxisLabel(), yLabel, theme, { tick: 12, label: 14, yLog: nl.log });
    if (!nl.log && yMin < 0 && yMax > 0) { ctx.save(); ctx.strokeStyle = theme.grid; ctx.setLineDash([2, 3]); const y0 = plot.yTo(0); ctx.beginPath(); ctx.moveTo(plot.left, y0); ctx.lineTo(plot.right, y0); ctx.stroke(); ctx.restore(); }
    if (!nl.log) { drawLine(ctx, xs, reS, plot, colors.re, 2.2); drawLine(ctx, xs, imS, plot, colors.im, 2.2); }
    drawLine(ctx, xs, absS, plot, colors.ext, 2.2);
    if (nl.cursorIdx >= 0 && nl.cursorIdx < n) {
      const xc = plot.xTo(nlAxisValue(r.E[nl.cursorIdx]));
      if (xc >= plot.left && xc <= plot.right) {
        ctx.save(); ctx.setLineDash([3, 3]); ctx.strokeStyle = colors.peak; ctx.lineWidth = 1.2; ctx.beginPath(); ctx.moveTo(xc, plot.top); ctx.lineTo(xc, plot.bottom); ctx.stroke(); ctx.restore();
        ctx.fillStyle = colors.peak;
        for (const arr of (nl.log ? [absN] : [reN, imN, absN])) { const vv = tr(arr[nl.cursorIdx]); if (!Number.isFinite(vv)) continue; const yv = plot.yTo(vv); if (yv >= plot.top && yv <= plot.bottom) { ctx.beginPath(); ctx.arc(xc, yv, 3, 0, 2 * Math.PI); ctx.fill(); } }
        ctx.font = '600 10px Inter, system-ui, sans-serif'; ctx.textAlign = xc > plot.right - 72 ? 'right' : 'left'; ctx.textBaseline = 'top';
        ctx.fillText(nl.axis === 'lambda' ? `${fmtFixed(HC_EV_NM / r.E[nl.cursorIdx], 0)} nm` : `${fmt(r.E[nl.cursorIdx], 3)} eV`, xc + (xc > plot.right - 72 ? -5 : 5), plot.top + 3);
      }
    }
  }

  // cursor readout, dispatched to the active 2D tab's box
  function setNlReadout(idx: number) {
    if (nl.tab === 'spectrum') {
      if (!nlSpecData) return;
      const d = nlSpecData, n = d.E.length, i = idx >= 0 && idx < n ? idx : Math.round(n / 2);
      $('nl-s-energy').textContent = fmt(d.E[i], 4); $('nl-s-lambda').textContent = fmtFixed(HC_EV_NM / d.E[i], 1);
      $('nl-s-ext').textContent = fmt(d.ext[i], 3); $('nl-s-abs').textContent = fmt(d.abs[i], 3); $('nl-s-sca').textContent = fmt(d.sca[i], 3);
      return;
    }
    if (nl.tab === 'material') {
      if (!nlMatData) return;
      const d = nlMatData, n = d.E.length, i = idx >= 0 && idx < n ? idx : Math.round(n / 2);
      $('nl-m-energy').textContent = fmt(d.E[i], 4); $('nl-m-lambda').textContent = fmtFixed(HC_EV_NM / d.E[i], 1);
      $('nl-m-re').textContent = fmt(d.re[i], 3); $('nl-m-im').textContent = fmt(d.im[i], 3);
      $('nl-m-abs').textContent = fmt(Math.hypot(d.re[i], d.im[i]), 3);
      $('nl-m-sym-re').textContent = d.sym; $('nl-m-sym-im').textContent = d.sym; $('nl-m-sym-abs').textContent = d.sym;
      $('nl-m-u-re').textContent = d.unit; $('nl-m-u-im').textContent = d.unit; $('nl-m-u-abs').textContent = d.unit;
      return;
    }
    if (!nlResult) return;
    const r = nlResult, n = r.E.length;
    const i = idx >= 0 && idx < n ? idx : Math.round(n / 2);
    const f = nlDispFactor(), u = nlUnitLbl();
    $('nl-r-energy').textContent = fmt(r.E[i], 4);
    $('nl-r-lambda').textContent = fmtFixed(HC_EV_NM / r.E[i], 1);
    $('nl-r-re').textContent = fmt(r.re[i] * f, 3);
    $('nl-r-im').textContent = fmt(r.im[i] * f, 3);
    $('nl-r-abs').textContent = fmt(Math.hypot(r.re[i], r.im[i]) * f, 3);
    $('nl-u-re').textContent = u; $('nl-u-im').textContent = u; $('nl-u-abs').textContent = u;
  }

  const NL_MAT_LABEL: Record<string, string> = { graphene: 'doped graphene', au: 'Au', ag: 'Ag', cu: 'Cu', al: 'Al', drude: 'Drude-metal', sigma: 'custom 2D σ', eps: 'custom ε' };
  function updateNlLegend() {
    const ql = nlQtyLetter();
    // log scale plots only |·|, so the legend shows the magnitude alone
    const items: [string, string][] = nl.log ? [[`|${ql}|`, colors.ext]] : [[`Re ${ql}`, colors.re], [`Im ${ql}`, colors.im], [`|${ql}|`, colors.ext]];
    $('nl-legend').innerHTML = legendHtml(items);
  }
  function updateNlCopy() {
    const geo = getNlGeometry(nl.geometry);
    const tStr = nlEpsBased(nl.material) ? ` film (t = ${fmtFixed(nl.thickness, 0)} nm)` : '';
    const matLabel = `${NL_MAT_LABEL[nl.material]}${tStr}`;
    const paramStr = nl.material === 'graphene' ? `E<sub>F</sub> = ${fmt(nl.EF, 2)} eV, D = ${fmtFixed(nl.D, 0)} nm` : `D = ${fmtFixed(nl.D, 0)} nm`;
    $('nl-subtitle').innerHTML = `${matLabel} · ${geo.label} ${geo.dLabel} · ${NL_ORDER_NAME[nl.order]} · ${paramStr}`;
    updateNlLegend();
    updateNlRefs();
    const setNotes = (summary: string, items: string[]) => { $('nl-mode-summary').innerHTML = summary; $('nl-note-list').innerHTML = items.map(t => `<li>${t}</li>`).join(''); };
    // 2D-system caveat for the file inputs: the model is electrostatic-2D, mapping a bulk response to a sheet.
    const twoDNote = (m: string) => m === 'eps'
      ? `<b>2D approximation:</b> the optical model assumes a two-dimensional system — the effective sheet conductivity is computed from the bulk permittivity, σ²ᴰ = iωt(ε−1)/4π. This is a good approximation when the thickness t is much smaller than the wavelength.`
      : `<b>2D approximation:</b> the optical model assumes a two-dimensional system — the uploaded σ²ᴰ(ω) is used directly as the sheet conductivity, valid when the layer thickness is much smaller than the wavelength.`;
    if (nl.material === 'sigma' && !nlCustomSigma) return setNotes('awaiting input', [`Upload a three-column σ²ᴰ(E) file — E [eV], Re σ, Im σ (nm/fs). The eigenvalue is η(ω) = iσ²ᴰ/(ωDε̄).`, twoDNote('sigma')]);
    if (nl.material === 'eps' && !nlCustomEps) return setNotes('awaiting input', [`Upload a three-column ε(E) file — E [eV], Re ε, Im ε — and set a thickness t. The thin-film eigenvalue is η(ω) = t(ε−1)/(4πDε̄).`, twoDNote('eps')]);
    const ql = nlQtyLetter();
    const chiNote = nl.quantity === 'chi'
      ? (nl.material === 'graphene' || nl.material === 'sigma'
          ? `Effective bulk susceptibility χ<sup>(s)</sup> = α̃<sup>(s)</sup> n<sub>C</sub>/d<sub>gr</sub> = α<sup>(s)</sup>/(A·d<sub>gr</sub>), with n<sub>C</sub> = 3.8×10¹⁵ cm⁻² and d<sub>gr</sub> ≃ 0.33 nm [2].`
          : `Effective bulk susceptibility χ<sup>(s)</sup> = α<sup>(s)</sup>/(A·t), normalised by the film volume V = A·t (t = ${fmt(nl.thickness, 2)} nm).`)
      : '';
    // Optional lead-in (χ-conversion note + non-graphene caveat), then the computed-quantities bullet.
    const leadParts: string[] = [];
    if (chiNote) leadParts.push(chiNote);
    if (nl.material !== 'graphene') leadParts.push(`For non-graphene materials only the linear α<sup>(1,1)</sup> and the resonance position are material-exact; the nonlinear orders carry graphene's nonlinear conductivity (illustrative).`);
    const lead = leadParts.join(' ');
    const computed = (['11', '22', '31', '33'] as NlOrder[]).map(o => {
      const sym = `${ql}<sup>(${NL_ORDER_PAIR[o]})</sup>`;
      const forbidden = o === '22' && !geo.hasShg ? ' (symmetry-forbidden)' : '';
      return `${sym} ${NL_ORDER_NAME[o]}${forbidden}`;
    }).join(', ');
    const orderItems = [`<b>Computed quantities:</b> ${computed}.`];
    const extra: string[] = [];
    if (nl.material === 'sigma' || nl.material === 'eps') extra.push(twoDNote(nl.material));
    if (nl.material === 'graphene') extra.push(
      `<b>Model:</b> <b>BTE</b> is the Boltzmann (Drude / intraband) conductivity — temperature-independent, no interband transitions. <b>Local-RPA</b> adds the interband term, which red-shifts the plasmon resonances${nlMultimode() ? ' — strongly for the higher modes' : ''}; it also replaces the Drude third-order response with Mikhailov's full σ⁽³⁾ (PRB <strong>93</strong>, 085403) whenever the third harmonic (χ<sup>(3,3)</sup>) or Kerr (χ<sup>(3,1)</sup>) is selected, adding the multi-photon interband resonances — 3ℏω = 2E<sub>F</sub> for THG (≈${fmt(2 * nl.EF / 3, 2)} eV) and 2ℏω = 2E<sub>F</sub> for Kerr (≈${fmt(nl.EF, 2)} eV). ${nl.grapheneModel === 'rpa' ? `Currently <em>Local-RPA</em> at T = ${fmtFixed(nl.temperature, 0)} K.` : 'Currently <em>BTE</em>.'}`);
    extra.push(
      `<b>Higher modes (j ≤ ${nl.modes}):</b> ${nl.modes > 1 ? `summing the ${nl.modes} lowest dipole-active ${geo.label.toLowerCase()} modes (full multimode Eq. 27, SM Tables S2 + S4/S5); secondary peaks appear at the higher-mode plasmons η₂, η₃ (paper Fig. 2). The linear α¹¹ is exact for every geometry; the triangle/disk nonlinear orders apply the SI ξ³ tensors directly.` : 'lowest dipole mode only (Eq. 29) — raise “Modes” to add the higher-mode peaks beyond the dipole.'}`);
    const xref = `<span class="nl-xref">The graphene conductivity σ²ᴰ(ω), Fermi energy E<sub>F</sub>, damping γ ⇄ τ and Drude parameters are explained in detail in the <a href="/lab/materials#graphene">Materials / Graphene calculator</a>.</span>`;
    setNotes(`ℏω<sub>p</sub> ≈ ${fmt(nlResonanceE(), 3)} eV`, [...(lead ? [lead] : []), ...orderItems, ...extra, xref]);
  }
  // material-dependent reference list
  const NL_REF_COX = `J. D. Cox, R. Yu &amp; F. J. García de Abajo, <em>Analytical description of the nonlinear plasmonic response in nanographene</em>, Phys. Rev. B <strong>96</strong>, 045442 (2017), <a href="https://doi.org/10.1103/PhysRevB.96.045442" target="_blank" rel="noopener">doi:10.1103/PhysRevB.96.045442</a>. <span class="nl-fig-btns">Reproduce: <button type="button" class="tool-btn nl-fig2-btn" data-fig2="a" title="40 nm graphene ribbon, E_F = 1 eV, local-RPA, j ≤ 3 — linear">Fig. 2a</button> <button type="button" class="tool-btn nl-fig2-btn" data-fig2="b" title="… THG">Fig. 2b</button> <button type="button" class="tool-btn nl-fig2-btn" data-fig2="c" title="… Kerr">Fig. 2c</button></span>`;
  const NL_REF_NATCOMM = `J. D. Cox &amp; F. J. García de Abajo, <em>Electrically tunable nonlinear plasmonics in graphene nanoislands</em>, Nat. Commun. <strong>5</strong>, 5725 (2014), <a href="https://doi.org/10.1038/ncomms6725" target="_blank" rel="noopener">doi:10.1038/ncomms6725</a> — per-atom χ⁽ˢ⁾ = α̃⁽ˢ⁾ n<sub>C</sub>/d<sub>gr</sub> conversion.`;
  const NL_REF_FILM = `Z. M. Abd El-Fattah <em>et al.</em>, <em>Plasmonics in atomically thin crystalline silver films</em>, ACS Nano <strong>13</strong>, 7771 (2019) — thin-film 2D-sheet mapping σ²ᴰ = iωt(1−ε)/4π.`;
  const NL_REF_JC = `Bulk optical constants ε(ω): P. B. Johnson &amp; R. W. Christy, Phys. Rev. B <strong>6</strong>, 4370 (1972) (Au, Ag, Cu); A. D. Rakić (1998) (Al), via the Lab's tabulated n, k.`;
  const NL_REF_MIKH = `S. A. Mikhailov, <em>Quantum theory of the third-order nonlinear electrodynamic effects of graphene</em>, Phys. Rev. B <strong>93</strong>, 085403 (2016), <a href="https://doi.org/10.1103/PhysRevB.93.085403" target="_blank" rel="noopener">doi:10.1103/PhysRevB.93.085403</a> — full third-order conductivity σ⁽³⁾ used for the Local-RPA THG and Kerr response.`;
  // true when the current settings exactly reproduce paper Fig. 2(panel)
  const NL_FIG2_ORDER: Record<string, NlOrder> = { a: '11', b: '33', c: '31' };
  function nlFig2Match(panel: string): boolean {
    const common = nl.material === 'graphene' && nl.geometry === 'ribbon' && nl.grapheneModel === 'rpa'
      && nl.temperature === 0 && Math.abs(nl.EF - 1) < 1e-9 && Math.abs(nl.D - 40) < 1e-9
      && nl.modes === 3 && Math.abs(nl.eMin - 0.2) < 1e-6 && Math.abs(nl.eMax - 1.0) < 1e-6;
    if (!common) return false;
    if (panel === 'a') return nl.tab === 'spectrum' && nl.specLog;
    return nl.tab === 'nonlinear' && nl.quantity === 'chi' && nl.log && nl.order === NL_FIG2_ORDER[panel];
  }
  function updateNlRefs() {
    const refs = [NL_REF_COX, NL_REF_NATCOMM];
    if (nl.material === 'graphene') refs.push(NL_REF_MIKH);   // Mikhailov σ⁽³⁾ — Local-RPA THG/Kerr
    if (nl.material === 'au' || nl.material === 'ag' || nl.material === 'cu' || nl.material === 'al') refs.push(NL_REF_FILM, NL_REF_JC);
    else if (nl.material === 'drude' || nl.material === 'eps') refs.push(NL_REF_FILM);
    $('nl-ref-list').innerHTML = refs.map((r, i) => `<li><span class="ref-index">[${i + 1}]</span><span>${r}</span></li>`).join('');
    $('nl-ref-list').querySelectorAll<HTMLButtonElement>('.nl-fig2-btn').forEach(b => b.classList.toggle('active', nlFig2Match(b.dataset.fig2 ?? '')));
  }

  function renderNl() {
    computeNl();
    nlSyncDrudePreset();
    updateNlCopy();
    updateNlTabUI();
    drawNlActive();                 // sets nlSpecData / nlMatData for the active tab
    setNlReadout(nl.cursorIdx);     // …then fill the readout from it
  }
  // dispatch to the active 2D tab's chart
  function drawNlActive() {
    if (nl.tab === 'spectrum') drawNlSpectrum();
    else if (nl.tab === 'material') drawNlMaterial();
    else drawNlChart();
  }
  // show only the active 2D tab's chart; Notes + References stay under every tab,
  // but the cursor readout and the Response selector are only meaningful for the Nonlinear tab.
  function updateNlTabUI() {
    $('nl-panel').style.display = nl.tab === 'nonlinear' ? '' : 'none';
    $('nl-spectrum-panel').style.display = nl.tab === 'spectrum' ? '' : 'none';
    $('nl-material-panel').style.display = nl.tab === 'material' ? '' : 'none';
    $('nl-results').style.display = '';                                   // Notes + References on all tabs
    $('nl-readout').style.display = nl.tab === 'nonlinear' ? '' : 'none';
    $('nl-spec-readout').style.display = nl.tab === 'spectrum' ? '' : 'none';
    $('nl-mat-readout').style.display = nl.tab === 'material' ? '' : 'none';
    ($('nl-response-param') as HTMLElement).hidden = nl.tab === 'spectrum';   // Response: Nonlinear + Material (sets which σ⁽ⁿ⁾)
    ($('nl-d-param') as HTMLElement).hidden = nl.tab === 'material';          // size D & modes are structure-only — irrelevant to the bare σ(ω)
    ($('nl-modes-param') as HTMLElement).hidden = nl.tab === 'material';
    $('nl-tabs').querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(b => {
      const a = b.dataset.nltab === nl.tab; b.classList.toggle('active', a); b.setAttribute('aria-selected', a ? 'true' : 'false');
    });
  }
  // shared cursor: vertical line + dots + E/λ label on any 2D chart (idx = natural index into E)
  function drawNlCursor(ctx: CanvasRenderingContext2D, plot: ReturnType<typeof drawAxes>, E: Float64Array, idx: number, yVals: number[]) {
    if (idx < 0 || idx >= E.length) return;
    const xc = plot.xTo(nlAxisValue(E[idx]));
    if (xc < plot.left || xc > plot.right) return;
    ctx.save(); ctx.setLineDash([3, 3]); ctx.strokeStyle = colors.peak; ctx.lineWidth = 1.2; ctx.beginPath(); ctx.moveTo(xc, plot.top); ctx.lineTo(xc, plot.bottom); ctx.stroke(); ctx.restore();
    ctx.fillStyle = colors.peak;
    for (const v of yVals) { if (!Number.isFinite(v)) continue; const yv = plot.yTo(v); if (yv >= plot.top && yv <= plot.bottom) { ctx.beginPath(); ctx.arc(xc, yv, 3, 0, 2 * Math.PI); ctx.fill(); } }
    ctx.font = '600 10px Inter, system-ui, sans-serif'; ctx.textAlign = xc > plot.right - 72 ? 'right' : 'left'; ctx.textBaseline = 'top';
    ctx.fillText(nl.axis === 'lambda' ? `${fmtFixed(HC_EV_NM / E[idx], 0)} nm` : `${fmt(E[idx], 3)} eV`, xc + (xc > plot.right - 72 ? -5 : 5), plot.top + 3);
  }
  // ── 2D Spectrum tab: linear extinction / absorption / scattering cross sections ──
  // σ_abs = (4πω/c) Im α¹¹, σ_sca = (8π/3)(ω/c)⁴|α¹¹|², σ_ext = σ_abs + σ_sca, per area.
  function drawNlSpectrum() {
    const HBAR = 0.6582119569, C = 299.792458;   // ħ [eV·fs], c [nm/fs]
    const [Elo, Ehi] = nlEnergyRange();
    const N = 360, E = new Float64Array(N);
    for (let i = 0; i < N; i++) E[i] = Elo + (Ehi - Elo) * i / (N - 1);
    const { re, im } = nlMultimode()
      ? geometrySpectrumMulti(nl.geometry, '11', nl.D, nl.epsBar, nlMaterial(), E, nl.modes)
      : nlSpectrum('11', nl.geometry, nl.D, nl.epsBar, nlMaterial(), E);
    const area = nlArea();
    const ext = new Float64Array(N), abs = new Float64Array(N), sca = new Float64Array(N);
    for (let i = 0; i < N; i++) {
      const wq = E[i] / HBAR, a2 = re[i] * re[i] + im[i] * im[i];
      const sa = (4 * Math.PI * wq / C) * im[i], ss = (8 * Math.PI / 3) * (wq / C) ** 4 * a2;
      abs[i] = sa / area; sca[i] = ss / area; ext[i] = (sa + ss) / area;
    }
    nlSpecData = { E, ext, abs, sca };
    const { ctx, w, h, theme } = canvasSetup('nl-spectrum-chart');
    const m = { top: 18, right: 22, bottom: 48, left: 76 };
    const tr = (v: number) => nl.specLog ? (v > 0 ? Math.log10(v) : NaN) : v;   // log₁₀ when enabled
    const ord = Array.from({ length: N }, (_, i) => i); if (nl.axis === 'lambda') ord.reverse();
    const xs = ord.map(i => nlAxisValue(E[i]));
    const series = [ext, abs, sca].map(arr => ord.map(i => tr(arr[i])));
    let yMin = nl.specLog ? Infinity : 0, yMax = nl.specLog ? -Infinity : 0;
    for (const s of series) for (const v of s) if (Number.isFinite(v)) { yMax = Math.max(yMax, v); yMin = Math.min(yMin, v); }
    if (!Number.isFinite(yMin) || yMax <= yMin) { yMin = nl.specLog ? yMin - 1 : 0; yMax = (Number.isFinite(yMax) ? yMax : 0) + 1; }
    const pad = 0.08 * (yMax - yMin);
    const yLabel = 'σ / A (a.u.)';
    const plot = drawAxes(ctx, w, h, m, xs[0], xs[N - 1], yMin - (nl.specLog ? pad : pad * 0.1), yMax + pad, nlAxisLabel(), yLabel, theme, { tick: 12, label: 14, yLog: nl.specLog });
    drawLine(ctx, xs, series[0], plot, colors.ext, 2.2);
    drawLine(ctx, xs, series[1], plot, colors.abs, 2.2);
    drawLine(ctx, xs, series[2], plot, colors.sca, 2.2);
    if (nl.cursorIdx >= 0) drawNlCursor(ctx, plot, E, nl.cursorIdx, [tr(ext[nl.cursorIdx]), tr(abs[nl.cursorIdx]), tr(sca[nl.cursorIdx])]);
    $('nl-spec-legend').innerHTML = legendHtml([['Extinction', colors.ext], ['Absorption', colors.abs], ['Scattering', colors.sca]]);
  }
  // ── 2D Material tab: the response feeding η(ω) — σ⁽ⁿ⁾ of the chosen Response (graphene / σ file) or ε (metals / Drude / ε file) ──
  function drawNlMaterial() {
    const sigBased = nl.material === 'graphene' || nl.material === 'sigma';
    const mat = nlMaterial(), lin = nl.order === '11';
    const [Elo, Ehi] = nlEnergyRange();
    const N = 280, E = new Float64Array(N);
    for (let i = 0; i < N; i++) E[i] = Elo + (Ehi - Elo) * i / (N - 1);
    const re = new Float64Array(N), im = new Float64Array(N);
    // σ⁽ⁿ⁾ of the chosen response (linear σ¹¹ feeds η; higher orders are graphene's nonlinear σ); ε for ε-based materials
    for (let i = 0; i < N; i++) { const cc = sigBased ? (lin ? mat.sigma2d(E[i]) : grapheneSigmaOrder(nl.order, E[i], nl.EF, nl.gamma)) : nlEpsAt(E[i]); re[i] = cc.re; im[i] = cc.im; }
    const sym = sigBased ? `σ(${NL_ORDER_PAIR[nl.order]})` : 'ε';
    const unit = sigBased ? (lin ? 'nm/fs' : 'a.u.') : '';
    nlMatData = { E, re, im, sym, unit };
    const { ctx, w, h, theme } = canvasSetup('nl-material-chart');
    const m = { top: 18, right: 22, bottom: 48, left: 76 };
    const ord = Array.from({ length: N }, (_, i) => i); if (nl.axis === 'lambda') ord.reverse();
    const xs = ord.map(i => nlAxisValue(E[i]));
    const reS = ord.map(i => re[i]), imS = ord.map(i => im[i]);
    let yMin = Infinity, yMax = -Infinity;
    for (const s of [reS, imS]) for (const v of s) if (Number.isFinite(v)) { yMin = Math.min(yMin, v); yMax = Math.max(yMax, v); }
    if (!Number.isFinite(yMin) || yMax <= yMin) { yMin = 0; yMax = 1; }
    const pad = 0.08 * (yMax - yMin);
    const yLabel = unit ? `${sym} (${unit})` : sym;
    const plot = drawAxes(ctx, w, h, m, xs[0], xs[N - 1], yMin - pad, yMax + pad, nlAxisLabel(), yLabel, theme, { tick: 12, label: 14 });
    if (yMin < 0 && yMax > 0) { ctx.save(); ctx.strokeStyle = theme.grid; ctx.setLineDash([2, 3]); const y0 = plot.yTo(0); ctx.beginPath(); ctx.moveTo(plot.left, y0); ctx.lineTo(plot.right, y0); ctx.stroke(); ctx.restore(); }
    drawLine(ctx, xs, reS, plot, colors.re, 2.2);
    drawLine(ctx, xs, imS, plot, colors.im, 2.2);
    if (nl.cursorIdx >= 0) drawNlCursor(ctx, plot, E, nl.cursorIdx, [re[nl.cursorIdx], im[nl.cursorIdx]]);
    $('nl-material-title').textContent = sigBased ? (lin ? 'Sheet conductivity σ²ᴰ(ω)' : `Nonlinear conductivity ${sym}(ω)`) : 'Dielectric function ε(ω)';
    $('nl-material-subtitle').textContent = sigBased ? (lin ? 'Linear response feeding η(ω) = iσ²ᴰ/(ωDε̄)' : 'Graphene nonlinear sheet conductivity for the selected response (Eq. 10)') : 'Bulk ε(ω); thin-film η(ω) = t(ε−1)/(4πDε̄)';
    $('nl-material-legend').innerHTML = legendHtml([[`Re ${sym}`, colors.re], [`Im ${sym}`, colors.im]]);
  }

  function drawMaterialChart() {
    const { ctx, w, h, theme } = canvasSetup();
    const count = 280;
    const xArr = new Float64Array(count);
    const re = new Float64Array(count);
    const im = new Float64Array(count);
    let yMin = Number.POSITIVE_INFINITY;
    let yMax = Number.NEGATIVE_INFINITY;

    for (let i = 0; i < count; i++) {
      const t = i / (count - 1);
      const l = state.xAxis === 'energy' ? state.lambdaMaxNm - (state.lambdaMaxNm - state.lambdaMinNm) * t : state.lambdaMinNm + (state.lambdaMaxNm - state.lambdaMinNm) * t;
      const eps = currentEpsilon(l);
      xArr[i] = axisValue(l);
      re[i] = eps.re;
      im[i] = eps.im;
      yMin = Math.min(yMin, eps.re, eps.im);
      yMax = Math.max(yMax, eps.re, eps.im);
    }

    if (yMax <= yMin) yMax = yMin + 1;
    const pad = (yMax - yMin) * 0.08;
    const [xMin, xMax] = axisRange();
    const plot = drawAxes(ctx, w, h, { top: 18, right: 22, bottom: 42, left: 58 }, xMin, xMax, yMin - pad, yMax + pad, axisLabel(), 'epsilon', theme);
    drawLine(ctx, xArr, re, plot, colors.re, 2.2);
    drawLine(ctx, xArr, im, plot, colors.im, 2.2);
  }

  function resonanceSweepData() {
    const opt = shapeOption(state.shape);
    const sweep = opt.minR === opt.maxR ? 'L' : state.resonanceSweep;
    const count = 96;
    const x = new Float64Array(count);
    const lambdaPeak = new Float64Array(count);
    const q = new Float64Array(count);
    const xMin = sweep === 'L' ? 20 : opt.minR;
    const xMax = sweep === 'L' ? 180 : opt.maxR;
    const searchMinNm = 350;
    const searchMaxNm = Math.max(2200, state.lambdaMaxNm);

    for (let i = 0; i < count; i++) {
      const value = xMin + (xMax - xMin) * i / (count - 1);
      const lengthNm = sweep === 'L' ? value : state.lengthNm;
      const aspectRatio = sweep === 'L' ? state.aspectRatio : value;
      const sweepResult = computePlasmonSpectrum({
        shape: state.shape,
        materialId: state.materialId,
        epsilonAt: currentEpsilon,
        lengthNm,
        aspectRatio,
        hostIndex: state.hostIndex,
        lambdaMinNm: searchMinNm,
        lambdaMaxNm: searchMaxNm,
        points: 900,
        modeCount: state.modeCount,
      });
      const peakIndex = nearestIndex(sweepResult.wavelengthNm, sweepResult.peak.lambdaPeakNm);
      const interiorPeak = peakIndex > 2 && peakIndex < sweepResult.wavelengthNm.length - 3;
      x[i] = value;
      lambdaPeak[i] = interiorPeak ? sweepResult.peak.lambdaPeakNm : Number.NaN;
      q[i] = interiorPeak ? sweepResult.peak.q : Number.NaN;
    }
    return {
      sweep,
      x,
      lambdaPeak,
      q,
      xLabel: sweep === 'L' ? 'Length L (nm)' : 'Aspect ratio R',
      currentX: sweep === 'L' ? state.lengthNm : state.aspectRatio,
    };
  }

  function finiteRange(values: ArrayLike<number>, padRatio = 0.08) {
    let min = Number.POSITIVE_INFINITY;
    let max = Number.NEGATIVE_INFINITY;
    for (let i = 0; i < values.length; i++) {
      const value = values[i];
      if (!Number.isFinite(value)) continue;
      min = Math.min(min, value);
      max = Math.max(max, value);
    }
    if (!Number.isFinite(min) || !Number.isFinite(max)) return { min: 0, max: 1 };
    if (max <= min) max = min + 1;
    const pad = (max - min) * padRatio;
    return { min: min - pad, max: max + pad };
  }

  function zeroBasedRange(values: ArrayLike<number>, padRatio = 0.08) {
    const range = finiteRange(values, padRatio);
    return { min: 0, max: Math.max(1, range.max) };
  }

  function ldosFieldData() {
    if (!result) throw new Error('No spectrum result available.');
    const count = result.wavelengthNm.length;
    const ldos = new Float64Array(count);
    const fieldEnhancement = new Float64Array(count);
    const epsilonHost = state.hostIndex ** 2;
    const hostIndex = Math.max(1e-6, state.hostIndex);
    const modeVolumeNm3 = Math.max(
      1e-9,
      result.modes.reduce((sum, mode) => sum + Math.abs(mode.vjOverV * mode.vOverL3), 0) * state.lengthNm ** 3,
    );

    for (let i = 0; i < count; i++) {
      const lambda = result.wavelengthNm[i];
      const kh = 2 * Math.PI * hostIndex / lambda;
      const inverseDenominatorIm = Math.max(0, result.alpha[i].im) * 4 * Math.PI / (epsilonHost * modeVolumeNm3);
      const modalPrefactor = 6 * Math.PI * hostIndex / Math.max(1e-12, kh ** 3 * state.lengthNm ** 3);
      const ldosValue = Math.max(0, modalPrefactor * inverseDenominatorIm);
      ldos[i] = ldosValue;
      fieldEnhancement[i] = result.quantumYield[i] * ldosValue / hostIndex;
    }

    return { wavelengthNm: result.wavelengthNm, ldos, fieldEnhancement };
  }

  function drawLdosChart() {
    if (!result) return;
    const { ctx, w, h, theme } = canvasSetup();
    const data = ldosFieldData();
    const m = { top: 18, right: 72, bottom: 44, left: 68 };
    const pw = w - m.left - m.right;
    const ph = h - m.top - m.bottom;
    const xMin = state.lambdaMinNm;
    const xMax = state.lambdaMaxNm;
    const ldosRange = zeroBasedRange(data.ldos, 0.12);
    const feRange = zeroBasedRange(data.fieldEnhancement, 0.12);
    const xTo = (x: number) => m.left + pw * (x - xMin) / (xMax - xMin);
    const yLdosTo = (y: number) => m.top + ph * (1 - (y - ldosRange.min) / (ldosRange.max - ldosRange.min));
    const yFeTo = (y: number) => m.top + ph * (1 - (y - feRange.min) / (feRange.max - feRange.min));

    ctx.fillStyle = theme.bg;
    ctx.fillRect(0, 0, w, h);
    ctx.strokeStyle = theme.grid;
    ctx.lineWidth = 1;
    for (let i = 0; i <= 5; i++) {
      const x = m.left + pw * i / 5;
      const y = m.top + ph * i / 5;
      ctx.beginPath();
      ctx.moveTo(x, m.top);
      ctx.lineTo(x, m.top + ph);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(m.left, y);
      ctx.lineTo(m.left + pw, y);
      ctx.stroke();
    }

    ctx.strokeStyle = theme.text;
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(m.left, m.top);
    ctx.lineTo(m.left, m.top + ph);
    ctx.lineTo(m.left + pw, m.top + ph);
    ctx.lineTo(m.left + pw, m.top);
    ctx.stroke();

    ctx.font = '10px Inter, system-ui, sans-serif';
    ctx.textBaseline = 'top';
    ctx.textAlign = 'center';
    ctx.fillStyle = theme.textSoft;
    for (let i = 0; i <= 5; i++) {
      const value = xMin + (xMax - xMin) * i / 5;
      ctx.fillText(fmt(value, 4), m.left + pw * i / 5, m.top + ph + 5);
    }
    ctx.fillStyle = theme.text;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillText('Wavelength λ (nm)', m.left + pw / 2, h - 16);

    ctx.font = '10px Inter, system-ui, sans-serif';
    ctx.textBaseline = 'middle';
    for (let i = 0; i <= 5; i++) {
      const y = m.top + ph * i / 5;
      ctx.textAlign = 'right';
      ctx.fillStyle = colors.ldos;
      ctx.fillText(fmt(ldosRange.max - (ldosRange.max - ldosRange.min) * i / 5, 3), m.left - 6, y);
      ctx.textAlign = 'left';
      ctx.fillStyle = colors.fe;
      ctx.fillText(fmt(feRange.max - (feRange.max - feRange.min) * i / 5, 3), m.left + pw + 6, y);
    }

    ctx.save();
    ctx.translate(14, m.top + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = colors.ldos;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillText('LDOS / LDOS0', 0, 0);
    ctx.restore();

    ctx.save();
    ctx.translate(w - 14, m.top + ph / 2);
    ctx.rotate(Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = colors.fe;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillText('Field enhancement', 0, 0);
    ctx.restore();

    drawLine(ctx, data.wavelengthNm, data.ldos, { xTo, yTo: yLdosTo, left: m.left, right: m.left + pw, top: m.top, bottom: m.top + ph }, colors.ldos, 2.3);
    drawLine(ctx, data.wavelengthNm, data.fieldEnhancement, { xTo, yTo: yFeTo, left: m.left, right: m.left + pw, top: m.top, bottom: m.top + ph }, colors.fe, 2.3);

    const xPeak = xTo(result.peak.lambdaPeakNm);
    if (xPeak >= m.left && xPeak <= m.left + pw) {
      ctx.setLineDash([3, 3]);
      ctx.strokeStyle = theme.textSoft;
      ctx.lineWidth = 1.1;
      ctx.beginPath();
      ctx.moveTo(xPeak, m.top);
      ctx.lineTo(xPeak, m.top + ph);
      ctx.stroke();
      ctx.setLineDash([]);
    }
  }

  function drawResonanceChart() {
    const { ctx, w, h, theme } = canvasSetup();
    const data = resonanceSweepData();
    const m = { top: 18, right: 62, bottom: 44, left: 64 };
    const pw = w - m.left - m.right;
    const ph = h - m.top - m.bottom;
    const xMin = data.x[0];
    const xMax = data.x[data.x.length - 1];
    const lambdaRange = finiteRange(data.lambdaPeak);
    const qRange = finiteRange(data.q, 0.12);
    const xTo = (x: number) => m.left + pw * (x - xMin) / (xMax - xMin);
    const yLambdaTo = (y: number) => m.top + ph * (1 - (y - lambdaRange.min) / (lambdaRange.max - lambdaRange.min));
    const yQTo = (y: number) => m.top + ph * (1 - (y - qRange.min) / (qRange.max - qRange.min));

    ctx.fillStyle = theme.bg;
    ctx.fillRect(0, 0, w, h);
    ctx.strokeStyle = theme.grid;
    ctx.lineWidth = 1;
    for (let i = 0; i <= 5; i++) {
      const x = m.left + pw * i / 5;
      const y = m.top + ph * i / 5;
      ctx.beginPath();
      ctx.moveTo(x, m.top);
      ctx.lineTo(x, m.top + ph);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(m.left, y);
      ctx.lineTo(m.left + pw, y);
      ctx.stroke();
    }

    ctx.strokeStyle = theme.text;
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(m.left, m.top);
    ctx.lineTo(m.left, m.top + ph);
    ctx.lineTo(m.left + pw, m.top + ph);
    ctx.lineTo(m.left + pw, m.top);
    ctx.stroke();

    ctx.font = '10px Inter, system-ui, sans-serif';
    ctx.textBaseline = 'top';
    ctx.textAlign = 'center';
    ctx.fillStyle = theme.textSoft;
    for (let i = 0; i <= 5; i++) {
      const value = xMin + (xMax - xMin) * i / 5;
      ctx.fillText(fmt(value, 3), m.left + pw * i / 5, m.top + ph + 5);
    }
    ctx.fillStyle = theme.text;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillText(data.xLabel, m.left + pw / 2, h - 16);

    ctx.font = '10px Inter, system-ui, sans-serif';
    ctx.textBaseline = 'middle';
    for (let i = 0; i <= 5; i++) {
      const y = m.top + ph * i / 5;
      ctx.textAlign = 'right';
      ctx.fillStyle = colors.ext;
      ctx.fillText(fmt(lambdaRange.max - (lambdaRange.max - lambdaRange.min) * i / 5, 4), m.left - 6, y);
      ctx.textAlign = 'left';
      ctx.fillStyle = colors.re;
      ctx.fillText(fmt(qRange.max - (qRange.max - qRange.min) * i / 5, 3), m.left + pw + 6, y);
    }

    ctx.save();
    ctx.translate(14, m.top + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = colors.ext;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillText('Resonance λ (nm)', 0, 0);
    ctx.restore();

    ctx.save();
    ctx.translate(w - 14, m.top + ph / 2);
    ctx.rotate(Math.PI / 2);
    ctx.textAlign = 'center';
