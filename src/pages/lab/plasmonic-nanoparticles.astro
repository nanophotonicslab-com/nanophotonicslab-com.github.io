  // SVG icons for the nanographene geometries (ribbon / triangle / disk), drawn like the LIN gallery.
  function nlShapeBody(id: NlGeometryId, stroke = 'currentColor', fill = 'rgba(99,102,241,0.12)'): string {
    // 2D shapes (flat, no 3D extrusion/shadow) — the NL model is for two-dimensional structures
    if (id === 'triangle') return `<path d="M40 8 64 44 16 44Z" fill="${fill}" stroke="${stroke}" stroke-width="3" stroke-linejoin="round"/>`;
    if (id === 'disk') return `<circle cx="40" cy="26" r="18" fill="${fill}" stroke="${stroke}" stroke-width="3"/>`;
    // ribbon: an infinite strip of width D (band spanning the frame)
    return `<rect x="-2" y="20" width="84" height="14" fill="${fill}" stroke="none"/><path d="M-2 20h84M-2 34h84" stroke="${stroke}" stroke-width="3"/><path d="M40 16v22" stroke="${stroke}" stroke-width="1.6" opacity=".4"/>`;
  }
  function renderNlGallery() {
    $('nl-shape-gallery').innerHTML = nlAvailableGeos().map(g =>
      `<button class="shape-card ${g.id === nl.geometry ? 'active' : ''}" type="button" data-nlshape="${g.id}" title="${g.label}"><svg viewBox="0 0 80 52">${nlShapeBody(g.id)}</svg><span>${g.label}</span></button>`).join('');
    $('nl-shape-current').textContent = getNlGeometry(nl.geometry).label;
