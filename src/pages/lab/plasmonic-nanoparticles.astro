    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillText('Q factor', 0, 0);
    ctx.restore();

    drawLine(ctx, data.x, data.lambdaPeak, { xTo, yTo: yLambdaTo, left: m.left, right: m.left + pw, top: m.top, bottom: m.top + ph }, colors.ext, 2.3);
    drawLine(ctx, data.x, data.q, { xTo, yTo: yQTo, left: m.left, right: m.left + pw, top: m.top, bottom: m.top + ph }, colors.re, 2.3);

    if (data.currentX >= xMin && data.currentX <= xMax) {
      const x = xTo(data.currentX);
      ctx.setLineDash([3, 3]);
      ctx.strokeStyle = theme.textSoft;
      ctx.lineWidth = 1.1;
      ctx.beginPath();
      ctx.moveTo(x, m.top);
      ctx.lineTo(x, m.top + ph);
      ctx.stroke();
      ctx.setLineDash([]);
