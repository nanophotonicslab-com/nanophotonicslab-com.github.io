  .param-info:hover, .param-info:focus-visible { border-color: var(--primary-light); color: var(--primary); outline: none; }
  .param-info .stat-tooltip { right: auto; left: 0; }
  .param-info:hover .stat-tooltip, .param-info:focus-visible .stat-tooltip { opacity: 1; transform: translateY(0); }
  .param-number--wide { width: 100%; text-align: left; }
  .param-slider:disabled, .param-number:disabled { opacity: 0.55; cursor: not-allowed; }
  .material-import-close {
    width: 2rem;
