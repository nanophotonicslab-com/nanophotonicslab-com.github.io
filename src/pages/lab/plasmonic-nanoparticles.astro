  let nlGeoSaved: NlGeometryId | null = null;   // geometry stashed while SHG forces a switch to a SHG-capable shape
  function updateNlGeoOptions() {
    const sel = $('nl-geo') as HTMLSelectElement;
    const geos = nlAvailableGeos();
    if (!geos.some(g => g.id === nl.geometry)) {
      // current geometry can't do this order (SHG → triangle only): remember it, switch to the first allowed
      if (nlGeoSaved === null) nlGeoSaved = nl.geometry;
      nl.geometry = geos[0].id;
    } else if (nlGeoSaved !== null) {
      // back to an order that allows the stashed geometry → restore it (don't strand the user on triangle)
      nl.geometry = nlGeoSaved; nlGeoSaved = null;
