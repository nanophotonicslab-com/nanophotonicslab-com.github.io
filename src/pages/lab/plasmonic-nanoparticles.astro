    if (shape === 'disk') return `<ellipse cx="40" cy="18" rx="26" ry="8" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M14 18v16c0 4.4 11.6 8 26 8s26-3.6 26-8V18" fill="none" stroke="${stroke}" stroke-width="3"/><ellipse cx="40" cy="34" rx="26" ry="8" fill="${fill}" stroke="${stroke}" stroke-width="3"/>`;
    if (shape === 'ring') return `<ellipse cx="40" cy="26" rx="28" ry="18" fill="${fill}" stroke="${stroke}" stroke-width="3"/><ellipse cx="40" cy="26" rx="13" ry="8" fill="${innerFill}" stroke="${stroke}" stroke-width="3"/><path d="M53 26h15" stroke="${stroke}" stroke-width="2" opacity=".5"/>`;
