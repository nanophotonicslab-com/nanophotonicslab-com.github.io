    return `<rect x="10" y="18" width="60" height="16" rx="8" fill="${fill}" stroke="${stroke}" stroke-width="3"/><path d="M14 14c9 8 17 8 26 0s17-8 26 0M14 38c9-8 17-8 26 0s17 8 26 0" fill="none" stroke="${stroke}" stroke-width="2"/>`;
