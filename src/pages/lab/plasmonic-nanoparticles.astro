  function electricOscillationArrow(shape: PlasmonShapeId): string {
    const label = shape === 'rod transverse' ? 'E along W' : 'E along L';
    return `
      <g color="var(--primary)" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round">
        <line x1="92" y1="28" x2="216" y2="28" marker-start="url(#schematic-arrow)" marker-end="url(#schematic-arrow)"></line>
        <path d="M98 41 C118 31 136 51 154 41 S190 41 210 41" opacity="0.55"></path>
      </g>
      <text x="128" y="20">${label}</text>
    `;
