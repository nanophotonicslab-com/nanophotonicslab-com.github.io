                <div class="efd-chart-pick" id="efd-nl-scale-wrap" hidden>
                  <div class="plot-tabs plot-tabs--toolbar" id="efd-nl-scale" role="radiogroup" aria-label="Vertical scale">
                    <button class="plot-tab active" type="button" data-nlscale="log" role="radio" aria-checked="true">Log</button>
                    <button class="plot-tab" type="button" data-nlscale="linear" role="radio" aria-checked="false">Linear</button>
                  </div>
                </div>
              </div>
              <div class="chart-wrap">
                <canvas id="efd-chart-main"></canvas>
                <div class="chart-tip" id="efd-chart-main-tip"></div>
                {/* An empty chart is ambiguous: nothing computed yet, or a
                    result that failed to draw? This says which. */}
