                <div class="efd-chart-pick efd-obs-only" data-obs-for="eels" hidden>
                  <div class="plot-tabs plot-tabs--toolbar" id="efd-eels-pick" role="radiogroup" aria-label="Which face of the loss to show">
                    <button class="plot-tab active" type="button" data-eels="spectrum" role="radio" aria-checked="true">&Gamma;(&omega;)</button>
                    <button class="plot-tab" type="button" data-eels="map" role="radio" aria-checked="false">&Gamma;(q, &omega;)</button>
                  </div>
                </div>
                <div
                  class="efd-chart-pick efd-obs-only"
                  data-obs-for="nonlinear"
                  hidden
                >
                  <div class="plot-tabs plot-tabs--toolbar" id="efd-nl-pick" role="radiogroup" aria-label="Which polarizability to show"></div>
                </div>
                {/* Only for the moduli. A single order draws Re and Im, which
                    go negative, and a log axis drops every non-positive sample
