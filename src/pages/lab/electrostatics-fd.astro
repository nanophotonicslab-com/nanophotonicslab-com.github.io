              <span class="toolbar-label">Component</span>
              {/* Plain Ex/Ey/Ez, not subscripts. An <option> holds text and
                  nothing else, and Unicode's Latin subscript block has no y and
                  no z -- only the x. The previous &#8337; and &#8338; were
                  SUBSCRIPT SMALL E and SUBSCRIPT SMALL O, so this menu read
                  "Re E-sub-e" and "Re E-sub-o". The chart title, which can
                  carry markup, sets them properly. */}
              <select id="efd-nf-comp" class="param-select param-select--sm">
                <option value="map" selected>|E|</option>
                <option value="ex_re">Re Ex</option>
                <option value="ex_im">Im Ex</option>
                <option value="ey_re">Re Ey</option>
                <option value="ey_im">Im Ey</option>
                <option value="ez_re">Re Ez</option>
                <option value="ez_im">Im Ez</option>
