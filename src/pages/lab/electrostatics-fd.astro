              <div class="plot-tabs plot-tabs--toolbar" id="efd-nf-scale" role="radiogroup" aria-label="Colour scale">
                <button class="plot-tab active" type="button" data-scale="log" role="radio" aria-checked="true">Log</button>
                <button class="plot-tab" type="button" data-scale="linear" role="radio" aria-checked="false">Linear</button>
