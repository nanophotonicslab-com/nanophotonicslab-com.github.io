                <input type="number" class="param-number param-number--sm" id="efd-nf-energy" value="0.58" step="0.01" min="0.001">
                <span class="angular-label">eV</span>
                <input type="range" class="gr-slider efd-nf-energy-slider" id="efd-nf-energy-slider" min="0.1" max="1.2" step="0.001" value="0.58" aria-label="Field map energy (eV)">
                {/* Typing a wavelength is the same act as typing an energy, so
                    it is an entry too, not a readout. Either one drives the
                    other; the slider and the solver stay on eV. */}
                <label class="angular-label" for="efd-nf-lambda">&lambda; =</label>
                <input type="number" class="param-number param-number--sm efd-nf-lambda efd-mirror" id="efd-nf-lambda" value="2138" step="10" min="0.1" aria-label="Field map wavelength (nm)">
                <span class="angular-label">nm</span>
