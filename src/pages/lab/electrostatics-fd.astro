            </div>

            <button id="efd-reset" class="chart-tool-btn reset-btn" type="button" title="Reset all parameters to defaults">Reset defaults</button>
          </div>
          </ParamsDrawer>
        </div>

        <!-- ===================== Results ===================== -->
        <div class="widget-column widget-column--results">
          <div class="chart-panel card">
            <!-- Near-field controls, top right of the result it governs. -->
