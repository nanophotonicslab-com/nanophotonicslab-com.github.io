            <div class="chart-block" id="efd-chart-aux-block" hidden>
              <div class="chart-header"><span class="chart-title" id="efd-chart-aux-title">Sheet conductivity</span></div>
              <div class="chart-wrap"><canvas id="efd-chart-aux"></canvas><div class="chart-tip" id="efd-chart-aux-tip"></div></div>
              <div class="chart-legend" id="efd-chart-aux-legend"></div>
            </div>

            <!-- Every payload the solver returns carries a notes array, and all
                 of it is shown. They are accuracy caveats, auto-tuning reports
                 and captured library warnings; hiding them would turn a hedged
                 number into a confident one. -->
            <div class="efd-notes" id="efd-notes-block" hidden>
