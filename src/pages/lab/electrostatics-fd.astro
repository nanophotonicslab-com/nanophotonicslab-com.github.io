---
import katex from 'katex';
import Layout from '../../layouts/Layout.astro';
import ModelInfo from '../../components/ModelInfo.astro';
import ToolMeta from '../../components/ToolMeta.astro';
import ParamsDrawer from '../../components/ParamsDrawer.astro';
import PresetStrip from '../../components/PresetStrip.astro';
import '../../styles/lab.css';
import 'katex/dist/katex.min.css';

/* ------------------------------------------------------------------ *
 *  Build-time mathematics for the Notes box, following laser.astro.
 *  The notes are static prose, so every formula is typeset here during
 *  the build and injected with set:html; the only KaTeX asset the browser
 *  downloads is the stylesheet imported above. Injected markup carries no
 *  Astro scope attribute, so every rule aimed at KaTeX output is :global()
 *  in the <style> block below.
 * ------------------------------------------------------------------ */
/** Display equation. */
const eq = (tex: string) => katex.renderToString(tex, { throwOnError: false, displayMode: true });
/** Inline equation. */
const im = (tex: string) => katex.renderToString(tex, { throwOnError: false, displayMode: false });

/* Preset buttons address controls by element id, which is all PresetStrip can
   do (it resolves each key with getElementById and assigns .value). So the
   ribbon controls are a FIXED set of five id-addressed blocks, shown or hidden
   by the count, rather than rows built on demand: that keeps the preset and
   share-link behaviour working unchanged. Five is a UI limit, not a solver one
   — the solver takes any number, bounded only by the node ceiling — and it is
   where the controls column stops being readable. Raising it means adding
   blocks here and nothing else.

   `efd-scene-hint` carries "<excitation>:<observable>", so a preset lands you on
   the excitation and the observable its figure actually shows. The numbers
   mirror web.presets() on the Python side, which holds the per-parameter
   provenance; the labels cite the reference list by number so every example reads the
   same way. Where the only evidence tying parameters to a published figure is a
   comment in the reference MATLAB, that is said at the reference itself. */
const presets: { label: string; values: Record<string, string | number> }[] = [
  {
    label: 'Single 10 nm ribbon',
    values: {
      'efd-scene-hint': 'plane:spectrum',
      'efd-nribbons': 1,
      'efd-w-0': 10, 'efd-x0-0': 0, 'efd-z0-0': 0, 'efd-l-0': 150,
      'efd-ef-0': 0.5, 'efd-gamma-0': 0.0263, 'efd-beta-0': 0,
      'efd-eps-a': 1, 'efd-eps-b': 1, 'efd-sub-eps': 0, 'efd-temp-0': 0,
      'efd-e-min': 0.3, 'efd-e-max': 1.2, 'efd-e-n': 180, 'efd-q': 0,
    },
  },
  {
    label: 'Two ribbons · Ref [5], Fig. 5c',
    values: {
      'efd-scene-hint': 'plane:spectrum',
      'efd-nribbons': 2,
      'efd-w-0': 51, 'efd-x0-0': 0, 'efd-z0-0': 0, 'efd-l-0': 255,
      'efd-ef-0': 1.0, 'efd-gamma-0': 0.02, 'efd-beta-0': 0,
      'efd-w-1': 22, 'efd-x0-1': 39.5, 'efd-z0-1': 0, 'efd-l-1': 110,
      'efd-ef-1': 1.0, 'efd-gamma-1': 0.02, 'efd-beta-1': 0, 'efd-temp-1': 0,
      'efd-eps-a': 1, 'efd-eps-b': 1, 'efd-sub-eps': 0, 'efd-temp-0': 0,
      'efd-e-min': 0.45, 'efd-e-max': 0.65, 'efd-e-n': 120, 'efd-q': 0,
    },
  },
  {
    label: 'Second harmonic · Ref [1], Fig. 1b',
    values: {
      'efd-scene-hint': 'plane:nonlinear',
      'efd-nribbons': 2,
      'efd-w-0': 160, 'efd-x0-0': 0, 'efd-z0-0': 0, 'efd-l-0': 400,
      'efd-ef-0': 0.4, 'efd-gamma-0': 0.01, 'efd-beta-0': 0,
      'efd-w-1': 40, 'efd-x0-1': 102.5, 'efd-z0-1': 0, 'efd-l-1': 250,
      'efd-ef-1': 0.4, 'efd-gamma-1': 0.01, 'efd-beta-1': 0, 'efd-temp-1': 0,
      'efd-eps-a': 1, 'efd-eps-b': 1, 'efd-sub-eps': 0, 'efd-temp-0': 0,
      'efd-e-min': 0.05, 'efd-e-max': 0.3, 'efd-e-n': 60, 'efd-q': 0,
    },
  },
  {
    label: 'Drift LDOS · Ref [3]',
    values: {
      'efd-scene-hint': 'dipole:ldos',
      'efd-nribbons': 1,
      'efd-w-0': 10, 'efd-x0-0': 5, 'efd-z0-0': 0, 'efd-l-0': 150,
      'efd-ef-0': 0.5, 'efd-gamma-0': 0.0263, 'efd-beta-0': 0.2573,
      'efd-eps-a': 1, 'efd-eps-b': 1, 'efd-sub-eps': 0, 'efd-temp-0': 0,
      'efd-e-min': 0.1, 'efd-e-max': 1.0, 'efd-e-n': 40,
      'efd-q-min': 0.02, 'efd-q-max': 0.5, 'efd-q-npos': 16,
      'efd-dip-x': 5, 'efd-dip-z': 5, 'efd-dip-p': 'x', 'efd-npeaks': 3,
    },
  },
  {
    label: 'The same, no drift',
    values: {
      'efd-scene-hint': 'dipole:ldos',
      'efd-nribbons': 1,
      'efd-w-0': 10, 'efd-x0-0': 5, 'efd-z0-0': 0, 'efd-l-0': 150,
      'efd-ef-0': 0.5, 'efd-gamma-0': 0.0263, 'efd-beta-0': 0,
      'efd-eps-a': 1, 'efd-eps-b': 1, 'efd-sub-eps': 0, 'efd-temp-0': 0,
      'efd-e-min': 0.1, 'efd-e-max': 1.0, 'efd-e-n': 80,
      'efd-q-min': 0.02, 'efd-q-max': 0.5, 'efd-q-npos': 24,
      'efd-dip-x': 5, 'efd-dip-z': 5, 'efd-dip-p': 'x', 'efd-npeaks': 3,
    },
  },
];

/** Up to five structures. Index 1 keeps the two-ribbon default that the
 *  coupled-ribbon examples use; 2-4 are staggered so that switching the count
 *  up gives a sane, non-overlapping arrangement rather than a pile at x = 0. */
const RIBBONS = [0, 1, 2, 3, 4];
const RIBBON_DEFAULTS = [
  { W: 10, x0: 0, L: 121 },
  { W: 22, x0: 39.5, L: 61 },
  { W: 10, x0: 65, L: 61 },
  { W: 10, x0: 85, L: 61 },
  { W: 10, x0: 105, L: 61 },
];
---

<Layout
  title="Electrostatics-FD"
  description="Quasistatic finite-difference response of coupled 2D nanostructures: eigenmodes, bands, cross sections, EELS and LDOS, drift-biased and substrate-coupled, solved in the browser."
  noindex
>
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Electrostatics <span class="gradient-text">finite differences</span></h1>
      <p class="widget-hero__subtitle">
        Self-consistent quasistatic response of coupled two-dimensional
        nanostructures, by finite differences. Eigenmodes and bands for any
        geometry; cross sections under a plane wave, the local density of states
        around a dipole, and electron energy loss for a swift electron &mdash;
        drift-biased and substrate-coupled throughout.
      </p>
      <ToolMeta slug="electrostatics-fd" name="Electrostatics-FD" />
    </div>
  </section>

  <ModelInfo status="Experimental">
    <dl>
      <dt>Model</dt>
      <dd>
        Quasistatic self-consistent response, discretised by finite differences.
        A single dimensionless <span set:html={im('\\eta(\\omega)')} /> carries all
        the material and frequency dependence; the geometry enters through a
        Coulomb kernel <span set:html={im('\\mathcal{V}^{(q)}')} /> and a
        second-derivative operator <span set:html={im('\\mathcal{D}^{(q)}')} />, and
        the potential solves
        <span set:html={im('\\vec\\phi=[\\mathbb{1}-(\\mathcal{M}+\\bar{\\mathcal{M}})]^{-1}\\vec\\phi^{\\,\\rm ext}')} />.
        Perturbative orders (SHG, THG with the cascaded contribution) are each
        screened at their own harmonic. Runs this project's Python reference
        library in the browser through Pyodide &mdash; the same code the tests and
        the MATLAB comparison use, not a port.
      </dd>
      <dt>Assumptions</dt>
      <dd>
        Quasistatic: every dimension and separation well below the free-space
        wavelength, retardation entering only through the sources' Lorentz
        factors. Sheets are strictly two-dimensional and carry no thickness.
        <span set:html={im('\\sigma')} /> is local in real space &mdash; nonlocal in
        <span set:html={im('Q')} /> only through the drift tensor &mdash; and is
        evaluated pointwise at the guided <span set:html={im('q')} />. Swift
        electrons are aloof and parallel: there is no penetrating-trajectory
        formalism here.
      </dd>
      <dt>Validity</dt>
      <dd>
        Graphene with <span set:html={im('|E_{\\rm F}|\\gg k_{\\rm B}T')} /> in the
        plasmonic window below the interband edge at
        <span set:html={im('2|E_{\\rm F}|')} />; thin metal films for
        <span set:html={im('t\\ll W')} />. The drift closed forms are
        <span set:html={im('T=0')} /> in the tensor itself, though the Drude weight
        carries temperature. Nonlinear conductivities keep field gradients to
        linear order, valid for optical wave vectors
        <span set:html={im('\\lesssim 1\\,\\mathrm{nm}^{-1}')} />.
      </dd>
      <dt>Limitations</dt>
      <dd>
        Nanoribbons only for now; nanotubes and nanodisks are not wired up.
        Nonlinear orders and drift have never been derived together, and the tool
        refuses the pair rather than guessing. A substrate screens both the
        response and the source through the same reflection coefficient, but it
        has no third-party implementation to have been checked against; what is
        checked is its perfect-mirror limit, which reproduces the textbook image
        construction to 2&times;10<sup>&minus;13</sup>. The LDOS is in
        <strong>arbitrary units</strong>: its
        <span set:html={im('2\\pi^2|\\mathbf{p}|^2')} /> normalisation has no
        external confirmation. Absolute magnitudes carry a 3&ndash;12&nbsp;%
        modelling choice in the edge cell weights, though peak positions do not.
      </dd>
      <dt>References</dt>
      <dd>
        Rasmussen <em>et&nbsp;al.</em>, Nanoscale <strong>15</strong>, 3150 (2023);
        Sci. Adv. <strong>10</strong>, eadn6312 (2024);
        Rodr&iacute;guez Echarri, Garc&iacute;a de Abajo &amp; Cox, Nat. Commun.
        <strong>17</strong>, 1114 (2026). Full list below.
      </dd>
    </dl>
  </ModelInfo>

  <section class="section">
    <div class="container">
      <!-- The system: the same shared module bar as the Mie, Materials and
           Electron labs. Nanotubes and nanodisks are deliberately disabled
           rather than hidden — the formalism carries the same drift split to
           both, so they belong on the map even before they are wired up. -->
      <div class="module-bar card" role="radiogroup" aria-label="Electrostatics-FD system">
        <span class="module-bar__label">System</span>
        <div class="module-bar__grid">
          <button type="button" class="module-card active" id="module-ribbons" role="radio" aria-checked="true">
            <span class="module-card__name">Nanoribbons</span>
            <span class="module-card__desc">Coupled 2D strips &middot; finite differences</span>
          </button>
          <button type="button" class="module-card" id="module-tubes" role="radio" aria-checked="false" aria-disabled="true" disabled title="Coming soon">
            <span class="module-card__name">Nanotubes <span class="module-card__badge">Soon</span></span>
            <span class="module-card__desc">Fully analytic &middot; same drift tensor</span>
          </button>
          <button type="button" class="module-card" id="module-disks" role="radio" aria-checked="false" aria-disabled="true" disabled title="Coming soon">
            <span class="module-card__name">Nanodisks <span class="module-card__badge">Soon</span></span>
            <span class="module-card__desc">Azimuthal kernel &middot; layered substrate</span>
          </button>
        </div>
      </div>

      <!-- The two choices that frame everything else, on one band above the
           work area and on the same grid as it: the excitation over the
           parameters it adds, the observable over the result it selects.
           Excitation decides which observables exist at all, so neither can be
           buried inside the box it governs. -->
      <div class="efd-topbar">
        <div class="param excitation-param">
          <div class="param-header"><label>Excitation</label></div>
          <div class="plot-tabs" id="efd-excitation-tabs" role="radiogroup" aria-label="Excitation">
            <button class="plot-tab active" type="button" data-excitation="plane" role="radio" aria-checked="true">Plane wave</button>
            <button class="plot-tab" type="button" data-excitation="dipole" role="radio" aria-checked="false">Dipole</button>
            <button class="plot-tab" type="button" data-excitation="electron" role="radio" aria-checked="false">Electron</button>
          </div>
          {/* Carries the drive through initPermalinks, which syncs form fields
              and these are buttons. Restored BEFORE the observable below:
              switching drive bounces an observable that drive does not offer,
              which would undo a view restored first. */}
          <input type="hidden" id="efd-src" value="plane">
        </div>
        <div class="param excitation-param">
          <div class="param-header"><label>Observable</label></div>
          <div class="plot-tabs efd-obs-tabs" id="efd-observable-tabs" role="radiogroup" aria-label="Observable">
            <button class="plot-tab active" type="button" data-obs="spectrum" role="radio" aria-checked="true">Cross section</button>
            <button class="plot-tab" type="button" data-obs="nonlinear" role="radio" aria-checked="false">Nonlinear</button>
            <button class="plot-tab" type="button" data-obs="ldos" role="radio" aria-checked="false">LDOS</button>
            <button class="plot-tab" type="button" data-obs="eels" role="radio" aria-checked="false">EELS</button>
            <button class="plot-tab" type="button" data-obs="nearfield" role="radio" aria-checked="false">Near field</button>
            <button class="plot-tab" type="button" data-obs="modes" role="radio" aria-checked="false">Modes</button>
            <button class="plot-tab" type="button" data-obs="dispersion" role="radio" aria-checked="false">Dispersion</button>
            <button class="plot-tab" type="button" data-obs="material" role="radio" aria-checked="false">Material</button>
          </div>
          {/* Same idea as efd-src: which panel you are reading is the first
              thing a shared link has to restore, and it is not a form field. */}
          <input type="hidden" id="efd-view" value="spectrum">
        </div>
      </div>

      <div class="widget-layout">
        <!-- ===================== Controls ===================== -->
        <div class="widget-column widget-column--controls">
          <ParamsDrawer>
          <div class="controls card">
            <div class="params-head">
              <h3>Parameters</h3>
              <button id="efd-run" class="chart-tool-btn efd-run-btn" type="button">Run</button>
            </div>

            <!-- The preset strip writes "<excitation>:<observable>" here. -->
            <input type="hidden" id="efd-scene-hint" value="plane:spectrum">

            <!-- ===== One self-contained block per ribbon =====
                 Every ribbon carries its own geometry AND its own material,
                 because the solver has always taken W, x0, z0, L, EF, gamma and
                 beta per ribbon -- `_build_system` reads them off each ribbon
                 dict and `eta_pair` reads them off each Ribbon object. Splitting
                 them across a Geometry block and a Material block implied a
                 shared material that never existed. -->
            <div class="param-header efd-count-row">
              <label for="efd-nribbons">Number of ribbons</label>
              <select id="efd-nribbons" class="param-select efd-count-select">
                <option value="1" selected>1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
              </select>
            </div>
            {RIBBONS.map((j) => (
              <div class="efd-ribbon-group" data-ribbon={j} hidden={j >= 1}>
                {/* The name shares the Geometry heading's line. On its own row
                    it cost the card a whole line of height for two words, five
                    times over. */}
                <div class="efd-ribbon-head">
                  <span class="efd-sub-title">Geometry</span>
                  <span class="efd-ribbon-name">Ribbon {j + 1}</span>
                </div>
                {/* Label, number and slider on one line, after the graphene
                    calculator's .gr-ef-field (/lab/materials#graphene). Every
                    ribbon gets both sliders now, not just the first: the five
                    cards are meant to read as five of the same thing. */}
                <div class="param efd-slider-row">
                  <label for={`efd-w-${j}`} title="Ribbon width">W (nm)</label>
                  <input type="number" class="param-number efd-slider-num" id={`efd-w-${j}`} value={RIBBON_DEFAULTS[j].W} step="1" min="0.5">
                  <input type="range" class="gr-slider" id={`efd-w-${j}-slider`} aria-label={`Ribbon ${j + 1} width (nm)`} min="2" max="200" step="1" value={RIBBON_DEFAULTS[j].W}>
                </div>
                <div class="param efd-param-pair">
                  <label>
                    <span>Centre x&#8320; (nm)</span>
                    <input type="number" class="param-number" id={`efd-x0-${j}`} value={RIBBON_DEFAULTS[j].x0} step="0.5">
                  </label>
                  <label>
                    <span>Height z&#8320; (nm)</span>
                    <input type="number" class="param-number" id={`efd-z0-${j}`} value="0" step="0.5">
                  </label>
                </div>

                {/* The node count on its own never said what it bought you.
                    The solver lays nodes at x = x0 + W*linspace(-0.5, 0.5, L),
                    so the spacing is W/(L-1) exactly -- not W/L -- and that is
                    the number that decides whether the edge singularity is
                    resolved. It is derived, so it is an <output>: dashed and
                    muted, and nothing reads it back. */}
                <span class="efd-sub-title">Discretization</span>
                <div class="param efd-param-pair">
                  <label>
                    <span>Nodes L</span>
                    <input type="number" class="param-number" id={`efd-l-${j}`} value={RIBBON_DEFAULTS[j].L} step="2" min="5" max="2048">
                  </label>
                  <label>
                    <span>&Delta;x (nm)</span>
                    <output class="efd-derived" id={`efd-dx-${j}`} title="Node spacing W/(L-1), the grid the solver will use">&mdash;</output>
                  </label>
                </div>

                <span class="efd-sub-title">Material</span>
                <div class="param efd-slider-row">
                  <label for={`efd-ef-${j}`} title="Fermi energy; negative is hole doping">E<sub>F</sub> (eV)</label>
                  <input type="number" class="param-number efd-slider-num" id={`efd-ef-${j}`} value="0.5" step="0.05">
                  <input type="range" class="gr-slider" id={`efd-ef-${j}-slider`} aria-label={`Ribbon ${j + 1} Fermi level (eV)`} min="-1.5" max="1.5" step="0.01" value="0.5">
                </div>
                {/* Three short numbers, one row. Temperature is a property of
                    THIS sheet's conductivity, not of the surroundings: it
                    enters through the Drude weight mu_D(mu(T), T), so two
                    ribbons held at different electron temperatures respond
                    differently. It used to sit under Environment, beside the
                    substrate, where it read as a property of the stack. */}
                <div class="param efd-param-trio">
                  <label>
                    <span>&gamma; (eV)</span>
                    <input type="number" class="param-number" id={`efd-gamma-${j}`} value="0.02" step="0.002" min="0">
                  </label>
                  <label>
                    <span>&beta; = v<sub>d</sub>/v<sub>F</sub></span>
                    <input type="number" class="param-number" id={`efd-beta-${j}`} value="0" step="0.02" min="-0.95" max="0.95">
                  </label>
                  <label>
                    <span>T (K)</span>
                    <input type="number" class="param-number" id={`efd-temp-${j}`} value="0" step="25" min="0">
                  </label>
                </div>
              </div>
            ))}

            <!-- ===== Source: only the block for the chosen excitation ===== -->
            <h4 class="efd-group-title efd-src-title">Source</h4>
            <div class="param efd-plane-only">
              <p class="efd-src-note">
                Normal incidence, polarised across the ribbons. That is the
                <span set:html={im('q=0')} /> case.
              </p>
            </div>
            <div class="param efd-dipole-only efd-param-pair" hidden>
              <label>
                <span>Dipole x (nm)</span>
                <input type="number" class="param-number" id="efd-dip-x" value="0" step="0.5">
              </label>
              <label>
                <span>Dipole z (nm)</span>
                <input type="number" class="param-number" id="efd-dip-z" value="5" step="0.5">
              </label>
            </div>
            <div class="param efd-dipole-only" hidden>
              <div class="param-header"><label for="efd-dip-p">Dipole axis</label></div>
              <select id="efd-dip-p" class="param-select">
                <option value="x" selected>x &mdash; across the ribbon</option>
                <option value="y">y &mdash; along the ribbon</option>
                <option value="z">z &mdash; out of plane</option>
              </select>
            </div>
            {/* Speed in either currency. Beam energies are quoted in keV and
                the formalism wants v/c, so both are entries and each writes
                the other; only v/c reaches the solver. And the height is just
                z: for an aloof parallel trajectory the impact parameter IS
                the height above the sheet, and z is the axis the geometry
                drawing and every ribbon's z0 already use. */}
            <div class="param efd-electron-only efd-param-trio" hidden>
              <label>
                <span>v / c</span>
                <input type="number" class="param-number" id="efd-vc" value="0.2" step="0.01" min="0.001" max="0.999">
              </label>
              <label>
                <span>K (keV)</span>
                <input type="number" class="param-number efd-mirror" id="efd-kev" value="10.9" step="1" min="0.01">
              </label>
              <label>
                <span>z (nm)</span>
                <input type="number" class="param-number" id="efd-b" value="5" step="0.5">
              </label>
            </div>
            {/* q belongs to the drive, so it sits under Source for every
                excitation -- a plane wave at normal incidence IS the q = 0
                case, but it is the one to fix, not one that cannot be set.
                The SWEPT q stays in Grid with the energy range, because there
                it is an axis rather than a property of the source. */}
            <div class="param efd-q-scalar">
              <div class="param-header">
                <label for="efd-q">q (nm&#8315;&sup1;)</label>
                <input type="number" class="param-number" id="efd-q" value="0" step="0.01">
              </div>
            </div>

            <!-- ===== Grid ===== -->
            <h4 class="efd-group-title">Grid</h4>
            {/* The layout is the Transition radiation module's .sp-range: the
                unit toggle in the range's own header, "min to max" below it.
                The BEHAVIOUR goes further than electron.astro, which keeps its
                range in nm and moves only the axis. Here the whole block
                follows the toggle -- heading, both numbers, their step and
                their bounds -- so you can type 500 to 900 nm directly. The
                solver only ever sees eV: `energyGrid()` in main.ts is the one
                place that converts, and it hands back the exact numbers that
                were typed rather than a rounded reconstruction.

                The near-field map is at ONE energy, set on the slider above
                the map, so the grid is not a parameter of it at all and
                .efd-e-grid hides there. */}
            <div class="param efd-range efd-e-grid">
              <div class="efd-range__head">
                <label for="efd-e-min" id="efd-range-label">Energy (eV)</label>
                <div class="efd-axis-pick" id="efd-axis-overlay" hidden title="The unit for this range and for the plot's horizontal axis">
                  <div class="plot-tabs plot-tabs--toolbar" id="efd-axis-tabs" role="radiogroup" aria-label="Energy or wavelength">
                    <button class="plot-tab active" type="button" data-axis="energy" role="radio" aria-checked="true">eV</button>
                    <button class="plot-tab" type="button" data-axis="lambda" role="radio" aria-checked="false">nm</button>
                  </div>
                </div>
              </div>
              <div class="efd-range__row">
                <input type="number" class="param-number efd-rnum" id="efd-e-min" value="0.1" step="0.05" min="0" aria-label="Energy range minimum (eV)">
                <span class="efd-range__dash">to</span>
                <input type="number" class="param-number efd-rnum" id="efd-e-max" value="1.2" step="0.05" min="0.002" aria-label="Energy range maximum (eV)">
              </div>
            </div>
            {/* Which unit the two boxes above are in. A hidden input, because
                the permalink maps query keys to element ids and the toggle is a
                pair of buttons: without this a link shared while in nm mode
                would restore nm numbers into an eV page. */}
            <input type="hidden" id="efd-xunit" value="energy">
            <div class="param efd-e-grid">
              <div class="param-header">
                {/* Not "Energy points": the axis can be read in nm, and the
                    count is the same count either way. */}
                <label for="efd-e-n">Number of points</label>
                <input type="number" class="param-number" id="efd-e-n" value="160" step="10" min="2" max="800">
              </div>
            </div>
            {/* The same shape as the energy range above it: a header naming
                the quantity and its unit, then "min to max". The two are the
                page's two swept axes and reading them alike is the point. */}
            <div class="param efd-range efd-q-grid" hidden>
              <div class="efd-range__head">
                <label for="efd-q-min">q (nm&#8315;&sup1;)</label>
              </div>
              <div class="efd-range__row">
                <input type="number" class="param-number efd-rnum" id="efd-q-min" value="0.02" step="0.01" min="0" aria-label="q range minimum (1/nm)">
                <span class="efd-range__dash">to</span>
                <input type="number" class="param-number efd-rnum" id="efd-q-max" value="0.5" step="0.05" min="0.001" aria-label="q range maximum (1/nm)">
              </div>
            </div>
            <div class="param efd-q-grid" hidden>
              <div class="param-header">
                <label for="efd-q-npos">Number of points (each sign)</label>
