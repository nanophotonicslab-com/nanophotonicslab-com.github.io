          <div class="chart-panel card efd-geometry-card">
            <div class="chart-block">
              <div class="chart-header">
                <span class="chart-title">Geometry</span>
                <button type="button" class="chart-tool-btn efd-enlarge-btn" id="efd-enlarge" title="Open a larger view of the geometry">
                  Enlarge
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
                </button>
              </div>
              <div class="chart-wrap efd-wrap--schematic"><canvas id="efd-schematic"></canvas></div>
            </div>

            <!-- The small number boxes describe the run: node count, what it
