  // ── Inspector (big chart for the selected node) ──
  let selectedNode: any = null;
  lcanvas.onNodeSelected = (node: any) => { selectedNode = node; renderInspector(); };
  lcanvas.onNodeDeselected = () => { selectedNode = null; renderInspector(); };

  function niceTicks(min: number, max: number, n = 5): number[] {
    const span = max - min || 1;
    const step0 = span / n;
    const mag = 10 ** Math.floor(Math.log10(step0));
    const step = [1, 2, 5, 10].map((m) => m * mag).find((s) => span / s <= n + 1) || mag * 10;
    const out: number[] = [];
    for (let t = Math.ceil(min / step) * step; t <= max + 1e-9; t += step) out.push(t);
    return out;
  }
  const fmt = (v: number) => {
    const a = Math.abs(v);
    if (a === 0) return '0';
    if (a >= 1e4 || a < 1e-2) return v.toExponential(1).replace('e+', 'e');
    return a >= 100 ? v.toFixed(0) : a >= 1 ? v.toFixed(1) : v.toFixed(2);
  };

  let inspectorHover = -1;
  function drawInspectorChart() {
    const cd: ChartData | undefined = selectedNode?._chart;
    const canvas = $('inspector-chart') as unknown as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const dpr = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = canvas.clientHeight;
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.scale(dpr, dpr);
    ctx.clearRect(0, 0, W, H);
    if (!cd) return;
    const t = chartTheme();
    const PAD = { l: 48, r: 10, t: 8, b: 28 };
    const pw = W - PAD.l - PAD.r, ph = H - PAD.t - PAD.b;
    const { x } = cd.spectrum;
    const xmin = x[0], xmax = x[x.length - 1];
    let ymax = 0;
    for (const s of cd.series) for (const v of cd.spectrum.series[s.key]) if (v > ymax) ymax = v;
    if (ymax <= 0) ymax = 1;
    const tx = (v: number) => PAD.l + ((v - xmin) / (xmax - xmin)) * pw;
    const ty = (v: number) => PAD.t + ph - (v / ymax) * ph;
    ctx.font = '11px ' + getComputedStyle(document.body).fontFamily;
    ctx.strokeStyle = t.grid; ctx.fillStyle = t.textMuted; ctx.lineWidth = 1;
    for (const yt of niceTicks(0, ymax, 4)) {
      ctx.beginPath(); ctx.moveTo(PAD.l, ty(yt)); ctx.lineTo(W - PAD.r, ty(yt)); ctx.stroke();
      ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
      ctx.fillText(fmt(yt), PAD.l - 6, ty(yt));
    }
    for (const xt of niceTicks(xmin, xmax, 6)) {
      ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText(fmt(xt), tx(xt), PAD.t + ph + 7);
    }
    ctx.fillStyle = t.textSoft;
    ctx.fillText(cd.xLabel, PAD.l + pw / 2, H - 13);
    for (const s of cd.series) {
      const ys = cd.spectrum.series[s.key];
      ctx.strokeStyle = s.color; ctx.lineWidth = 2; ctx.lineJoin = 'round';
      ctx.beginPath();
      for (let i = 0; i < x.length; i++) {
        i === 0 ? ctx.moveTo(tx(x[i]), ty(ys[i])) : ctx.lineTo(tx(x[i]), ty(ys[i]));
      }
      ctx.stroke();
    }
    if (inspectorHover >= 0 && inspectorHover < x.length) {
      const hx = tx(x[inspectorHover]);
      ctx.strokeStyle = t.textMuted; ctx.setLineDash([3, 3]);
      ctx.beginPath(); ctx.moveTo(hx, PAD.t); ctx.lineTo(hx, PAD.t + ph); ctx.stroke();
      ctx.setLineDash([]);
      for (const s of cd.series) {
        ctx.fillStyle = s.color;
        ctx.beginPath(); ctx.arc(hx, ty(cd.spectrum.series[s.key][inspectorHover]), 3.2, 0, 2 * Math.PI); ctx.fill();
      }
    }
  }

  function renderInspector() {
    const title = $('inspector-title'), tag = $('inspector-tag'), head = $('inspector-headline'), leg = $('inspector-legend');
    if (!selectedNode) {
      title.textContent = 'Inspector';
      tag.textContent = 'select a node';
      head.textContent = '';
      leg.innerHTML = '';
      ($('btn-png') as unknown as HTMLButtonElement).disabled = true;
      ($('btn-csv') as unknown as HTMLButtonElement).disabled = true;
      drawInspectorChart();
      return;
    }
    title.textContent = selectedNode.title;
    tag.textContent = selectedNode._chart ? 'output' : 'no spectrum output';
    head.textContent = selectedNode._headline || selectedNode._readout || (selectedNode._hex ? `${selectedNode._hex} (${selectedNode._key})` : '') || (selectedNode._lines || []).join('  ·  ');
    leg.innerHTML = (selectedNode._chart?.series || [])
      .map((s: SeriesSpec) => `<span><i style="--c:${s.color}"></i>${s.label}</span>`)
      .join('');
    drawInspectorChart();
    const hasChart = !!selectedNode?._chart;
    ($('btn-png') as unknown as HTMLButtonElement).disabled = !hasChart;
    ($('btn-csv') as unknown as HTMLButtonElement).disabled = !hasChart;
  }

  const inspCanvas = $('inspector-chart') as unknown as HTMLCanvasElement;
  inspCanvas.addEventListener('pointermove', (ev) => {
    const cd: ChartData | undefined = selectedNode?._chart;
    if (!cd) return;
    const rect = inspCanvas.getBoundingClientRect();
    const relX = (ev.clientX - rect.left - 48) / (rect.width - 58);
    inspectorHover = Math.max(0, Math.min(cd.spectrum.x.length - 1, Math.round(relX * (cd.spectrum.x.length - 1))));
    drawInspectorChart();
    const tip = $('inspector-tip');
    tip.style.display = 'block';
    tip.style.left = Math.min(ev.clientX - rect.left + 12, rect.width - 140) + 'px';
    tip.style.top = '8px';
    tip.innerHTML = `${fmt(cd.spectrum.x[inspectorHover])} ${cd.xUnit}<br>` + cd.series
      .map((s) => `${s.label}: ${fmt(cd.spectrum.series[s.key][inspectorHover])}`)
      .join('<br>');
  });
  inspCanvas.addEventListener('pointerleave', () => {
    inspectorHover = -1; $('inspector-tip').style.display = 'none';
    drawInspectorChart();
  });

  // ── RII search dialog (fills a Material node from refractiveindex.info) ──
  let riiCatalog: RIIMaterial[] | null = null;
  let riiTarget: any = null;
  const riiModal = $('rii-modal'), riiQuery = $('rii-query') as unknown as HTMLInputElement;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  function openRiiDialog(node: any) {
    riiTarget = node;
    riiModal.hidden = false;
    riiQuery.value = '';
    $('rii-status').textContent = '';
    if (!riiCatalog) {
      $('rii-status').textContent = 'Loading catalog…';
      loadCatalog()
        .then((c) => { riiCatalog = c; $('rii-status').textContent = `${c.length} materials.`; renderRiiResults(''); })
        .catch((err) => { $('rii-status').textContent = `Catalog failed: ${err?.message || err}`; });
    } else renderRiiResults('');
    riiQuery.focus();
  }
  function closeRiiDialog() {
    riiModal.hidden = true;
    // Cancelled with nothing ever picked → fall back to the last concrete source.
    if (riiTarget && riiTarget.properties.source === RII_OPTION && !riiTarget.properties.riiDataPath) {
      setProp(riiTarget, 'source', riiTarget._lastConcrete || 'au');
      scheduleRun();
    }
    riiTarget = null;
  }
  function renderRiiResults(q: string) {
    if (!riiCatalog) return;
    const hits = searchCatalog(riiCatalog, q, 40);
    $('rii-results').innerHTML = hits
      .map((m, i) => `<button type="button" data-i="${i}"><b>${esc(m.bookName)}</b> — ${esc(m.pageName)}</button>`)
      .join('');
    ($('rii-results') as HTMLElement).querySelectorAll('button').forEach((btn) => {
      btn.addEventListener('click', () => pickRiiMaterial(hits[parseInt(btn.dataset.i!, 10)]));
    });
  }
  function pickRiiMaterial(m: RIIMaterial) {
    const node = riiTarget;
    if (!node) return;
    $('rii-status').textContent = `Fetching ${m.bookName} (${m.pageName})…`;
    fetchMaterialNK(m.dataPath)
      .then((data) => {
        riiNK.set(m.dataPath, data);
        riiErrors.delete(m.dataPath);
        node.properties.riiDataPath = m.dataPath;
        node.properties.riiLabel = `${m.bookName} (${m.pageName})`;
        setProp(node, 'source', RII_OPTION);
        riiTarget = null;
        riiModal.hidden = true;
        scheduleRun();
      })
      .catch((err) => { $('rii-status').textContent = `Fetch failed: ${err?.message || err}`; });
  }
  riiQuery.addEventListener('input', () => renderRiiResults(riiQuery.value));
  riiQuery.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') closeRiiDialog(); });
  $('rii-close').addEventListener('click', closeRiiDialog);
  riiModal.addEventListener('pointerdown', (ev) => { if (ev.target === riiModal) closeRiiDialog(); });

  // ── Export the inspected node (PNG of the chart, CSV of the spectrum) ──
  const exportName = (ext: string) =>
    `workbench_${(selectedNode?.title || 'node').toLowerCase().replace(/[^a-z0-9]+/g, '_')}.${ext}`;
  $('btn-png').addEventListener('click', () => {
    if (!selectedNode?._chart) return;
    (inspCanvas as HTMLCanvasElement).toBlob((b) => { if (b) downloadBlob(b, exportName('png')); }, 'image/png');
  });
  $('btn-csv').addEventListener('click', () => {
    const cd: ChartData | undefined = selectedNode?._chart;
    if (!cd) return;
    const keys = cd.series.map((s) => s.key);
    const header = [cd.xUnit === 'eV' ? 'energy_eV' : 'lambda_nm', ...keys];
    const lines = [header.join(',')];
    for (let i = 0; i < cd.spectrum.x.length; i++) {
      lines.push([cd.spectrum.x[i], ...keys.map((k) => cd.spectrum.series[k][i])].join(','));
    }
    downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv;charset=utf-8' }), exportName('csv'));
  });

  // ── Boot ──
  if (!restoreFromHash()) buildDefaultGraph();
  applyEditorTheme();
  resizeCanvas();
  scheduleRun();
  window.addEventListener('resize', () => { resizeCanvas(); scheduleRun(); });
  onThemeChange(() => { applyEditorTheme(); scheduleRun(); });
</script>
