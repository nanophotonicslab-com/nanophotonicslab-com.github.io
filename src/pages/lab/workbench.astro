---
import Layout from '../../layouts/Layout.astro';
import 'litegraph.js/css/litegraph.css';

// v1 of the node-editor workbench: the real editable graph on litegraph.js
// (decision 2026-07-18: canvas now, all four edit operations). Our node types
// replace the stock library; solver physics stays in src/lib. The graph
// serializes to the URL hash for save/share. Hidden route (no sitemap, noindex).
---

<Layout title="Material Workbench" description="Wire nanophotonics simulations as a node graph: materials, geometries, solvers and derived quantities." noindex>
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Material <span class="gradient-text">Workbench</span></h1>
      <p class="widget-hero__subtitle">
        Wire simulations as a graph: materials, environments and geometries feed
        solvers; solver spectra feed derived quantities. Double-click the canvas
        to add nodes, drag between ports to wire, select a node to inspect it.
        <span class="bench-badge">v1 &middot; node editor &middot; hidden preview</span>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="bench-toolbar">
        <span class="bench-toolbar__label">Examples</span>
        <button id="ex-default" class="tool-btn" type="button" title="One material fanned out to all three solvers">Fan-out</button>
        <button id="ex-compare" class="tool-btn" type="button" title="Two materials, two Mie solvers, two peak readouts">Au vs Ag</button>
        <button id="ex-thermal" class="tool-btn" type="button" title="Chained derivation: σ_abs → ΔT(λ) → peak analysis">Thermal chain</button>
        <span class="bench-toolbar__sep"></span>
        <button id="btn-share" class="tool-btn" type="button" title="Copy a link to this exact graph">Share graph</button>
        <span class="bench-hint" id="share-hint"></span>
      </div>

      <details class="guide">
        <summary>Quick guide — how to drive the graph</summary>
        <ul>
          <li><strong>Add a node:</strong> double-click empty canvas and pick a type (or right-click &rarr; Add Node).</li>
          <li><strong>Wire:</strong> drag from an output port to an input port. Sockets are typed — a material wire only fits a material input.</li>
          <li><strong>Inspect:</strong> click any node; the full-size chart appears in the Inspector below the canvas.</li>
          <li><strong>Edit values:</strong> drag horizontally on a number widget; click a combo to choose.</li>
          <li><strong>Remove:</strong> select a node and press <kbd>Delete</kbd>. Drag the title bar to move it.</li>
          <li><strong>Save:</strong> <em>Share graph</em> copies a URL that restores nodes, wires and values exactly.</li>
          <li><strong>Try this:</strong> the ΔT output of Photothermal is a spectrum too — wire it into Peak analysis to measure the width of the thermal resonance (that is what the <em>Thermal chain</em> example does).</li>
        </ul>
      </details>
      <div class="graph-wrap" id="graph-wrap">
        <canvas id="graph-canvas"></canvas>
        <div class="rii-modal" id="rii-modal" hidden>
          <div class="rii-panel">
            <div class="rii-head">
              <h3>Search refractiveindex.info</h3>
              <button id="rii-close" class="rii-close" type="button" aria-label="Close search">&times;</button>
            </div>
            <input id="rii-query" class="rii-query" type="text" placeholder="e.g. gold Johnson, TiO2, GaAs&hellip;" aria-label="Search materials">
            <div class="rii-results" id="rii-results" role="listbox"></div>
            <p class="rii-status" id="rii-status"></p>
          </div>
        </div>
      </div>

      <div class="inspector card" id="inspector">
        <div class="node-head">
          <span class="port port--in"></span>
          <h3 id="inspector-title">Inspector</h3>
          <span class="node-tag" id="inspector-tag">select a node</span>
          <span class="inspector-actions">
            <button id="btn-png" class="tool-btn" type="button" disabled title="Download the inspected chart as PNG">PNG</button>
            <button id="btn-csv" class="tool-btn" type="button" disabled title="Download the inspected spectrum as CSV">CSV</button>
          </span>
        </div>
        <p class="node-headline" id="inspector-headline"></p>
        <div class="chart-wrap"><canvas id="inspector-chart"></canvas><div class="chart-tip" id="inspector-tip"></div></div>
        <div class="chart-legend" id="inspector-legend"></div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .widget-hero { padding: calc(var(--space-3xl) + var(--space-lg)) 0 var(--space-xl); background: var(--bg-soft); }
  .widget-hero h1 { margin-bottom: var(--space-sm); }
  .widget-hero__subtitle { font-size: 1.125rem; max-width: 680px; }
  .gradient-text { background: var(--spectrum); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .back-link { display: inline-block; margin-bottom: var(--space-md); font-size: 0.875rem; font-weight: 500; color: var(--text-soft); }
  .back-link:hover { color: var(--primary); }
  .bench-badge {
    display: inline-block; margin-left: 0.5rem; padding: 0.1rem 0.55rem;
    background: var(--bg-muted); border-radius: var(--radius-full);
    font-size: 0.75rem; font-weight: 600; color: var(--text-soft); white-space: nowrap;
  }

  .bench-toolbar { display: flex; align-items: center; gap: 0.6rem; margin-bottom: var(--space-sm); flex-wrap: wrap; }
  .bench-toolbar__label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-muted); }
  .bench-toolbar__sep { flex: 0 0 1px; height: 1.4rem; background: var(--bg-muted); }
  .guide { margin-bottom: var(--space-sm); border: 1px solid var(--bg-muted); border-radius: var(--radius-md); background: var(--bg); }
  .guide summary {
    padding: 0.5rem 0.9rem; cursor: pointer; user-select: none;
    font-size: 0.8125rem; font-weight: 600; color: var(--text-soft); list-style: none;
  }
  .guide summary::-webkit-details-marker { display: none; }
  .guide summary::before { content: '▸ '; color: var(--primary); }
  .guide[open] summary::before { content: '▾ '; }
  .guide ul { margin: 0; padding: 0 1.2rem 0.8rem 2rem; }
  .guide li { font-size: 0.8125rem; color: var(--text-soft); margin-bottom: 0.3rem; }
  .guide kbd {
    padding: 0.05rem 0.35rem; border: 1px solid var(--bg-muted); border-bottom-width: 2px;
    border-radius: 4px; font-size: 0.72rem; background: var(--bg-soft);
  }
  .tool-btn {
    padding: 0.35rem 0.8rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm);
    background: var(--bg); color: var(--primary); font-family: var(--font);
    font-size: 0.8125rem; font-weight: 600; cursor: pointer;
  }
  .tool-btn:hover { border-color: var(--primary-light); }
  .tool-btn:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .bench-hint { font-size: 0.75rem; color: var(--text-muted); }

  .graph-wrap {
    position: relative;
    width: 100%; height: 62vh; min-height: 420px;
    border: 1px solid #2A2945; border-radius: var(--radius-lg); overflow: hidden;
    background: #12102B;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.25);
  }
  .rii-modal {
    position: absolute; inset: 0; z-index: 10;
    display: flex; align-items: flex-start; justify-content: center;
    padding-top: 6vh; background: rgba(15, 14, 26, 0.55); backdrop-filter: blur(2px);
  }
  .rii-modal[hidden] { display: none; }
  .rii-panel {
    width: min(440px, 92%); max-height: 80%; display: flex; flex-direction: column;
    background: var(--bg); border: 1px solid var(--bg-muted); border-radius: var(--radius-md);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35); padding: var(--space-md);
  }
  .rii-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-sm); }
  .rii-head h3 { font-size: 0.95rem; }
  .rii-close {
    border: none; background: none; font-size: 1.3rem; line-height: 1; cursor: pointer;
    color: var(--text-muted); padding: 0.1rem 0.4rem; border-radius: var(--radius-sm);
  }
  .rii-close:hover { color: var(--text); background: var(--bg-soft); }
  .rii-query {
    width: 100%; padding: 0.45rem 0.6rem; margin-bottom: var(--space-sm);
    border: 1px solid var(--bg-muted); border-radius: var(--radius-sm);
    font-family: var(--font); font-size: 0.9rem; color: var(--text); background: var(--bg-soft); outline: none;
  }
  .rii-query:focus-visible { border-color: var(--primary-light); }
  .rii-results { overflow-y: auto; min-height: 0; }
  .rii-results :global(button) {
    display: block; width: 100%; text-align: left; padding: 0.4rem 0.55rem;
    border: none; background: none; cursor: pointer; border-radius: var(--radius-sm);
    font-family: var(--font); font-size: 0.8125rem; color: var(--text-soft);
  }
  .rii-results :global(button:hover) { background: var(--bg-soft); color: var(--primary); }
  .rii-results :global(b) { color: var(--text); font-weight: 600; }
  .rii-status { font-size: 0.75rem; color: var(--text-muted); margin: 0.4rem 0 0; min-height: 1em; }

  .inspector-actions { margin-left: auto; display: flex; gap: 0.4rem; }
  .inspector-actions .tool-btn[disabled] { opacity: 0.45; cursor: default; }
  .graph-wrap canvas { display: block; width: 100%; height: 100%; outline: none; }

  .inspector { margin-top: var(--space-lg); padding: var(--space-md); }
  .node-head { display: flex; align-items: center; gap: 0.5rem; margin-bottom: var(--space-sm); }
  .node-head h3 { font-size: 0.95rem; flex: 0 1 auto; }
  .node-tag {
    padding: 0.05rem 0.45rem; background: var(--bg-muted); border-radius: var(--radius-full);
    font-size: 0.65rem; font-weight: 600; letter-spacing: 0.03em; color: var(--text-muted); text-transform: uppercase;
  }
  .port {
    width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto;
    background: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 18%, transparent);
  }
  .node-headline { font-size: 0.85rem; font-weight: 600; color: var(--text); margin: 0 0 0.4rem; font-variant-numeric: tabular-nums; min-height: 1.1em; }

  .chart-wrap { position: relative; width: 100%; max-width: 720px; }
  .chart-wrap canvas { display: block; width: 100%; aspect-ratio: 16 / 9; }
  .chart-tip {
    position: absolute; display: none; pointer-events: none; z-index: 3;
    background: var(--bg-glass); border: 1px solid var(--bg-muted); border-radius: var(--radius-sm);
    padding: 0.3rem 0.5rem; font-size: 0.72rem; font-variant-numeric: tabular-nums;
    color: var(--text); white-space: nowrap; box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }
  .chart-legend { display: flex; flex-wrap: wrap; gap: 0.35rem 0.8rem; margin-top: 0.4rem; }
  .chart-legend :global(span) { display: inline-flex; align-items: center; gap: 0.32rem; font-size: 0.75rem; font-weight: 500; color: var(--text-soft); }
  .chart-legend :global(i) { width: 14px; height: 3px; border-radius: 2px; background: var(--c); }

  @media (max-width: 640px) {
    .graph-wrap { height: 55vh; min-height: 360px; }
  }
</style>

<style is:global>
  /* Restyle litegraph's HTML chrome (context menu, search box, prompts)
     with the site tokens — its stock CSS is dark with !important. */
  .litegraph.litecontextmenu {
    background-color: var(--bg) !important;
    border: 1px solid var(--bg-muted) !important;
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgba(30, 27, 75, 0.14);
    font-family: var(--font) !important;
    padding: 4px;
  }
  .litegraph.litecontextmenu .litemenu-title {
    background-color: var(--bg-soft) !important;
    color: var(--text) !important;
    border-radius: var(--radius-sm);
  }
  .litegraph.litecontextmenu .litemenu-entry {
    background-color: transparent !important;
    color: var(--text-soft) !important;
    border-radius: var(--radius-sm);
    margin: 1px 0;
  }
  .litegraph.litecontextmenu .litemenu-entry:hover:not(.disabled):not(.separator) {
    background-color: var(--bg-soft) !important;
    color: var(--primary) !important;
  }
  .litegraph.litecontextmenu .litemenu-entry.separator {
    border-top: 1px solid var(--bg-muted) !important;
    background: transparent !important;
  }
  .litegraph.litesearchbox {
    background-color: var(--bg-glass) !important;
    border: 1px solid var(--bg-muted) !important;
    border-radius: var(--radius-md);
    box-shadow: 0 8px 24px rgba(30, 27, 75, 0.14);
    font-family: var(--font) !important;
  }
  .litegraph.litesearchbox input,
  .litegraph.litesearchbox select {
    background-color: var(--bg) !important;
    color: var(--text) !important;
    border: 1px solid var(--bg-muted) !important;
    border-radius: var(--radius-sm);
    font-family: var(--font) !important;
  }
  .litegraph.litesearchbox .helper { background: transparent !important; }
  .litegraph .lite-search-item {
    background-color: transparent !important;
    color: var(--text-soft) !important;
    border-radius: var(--radius-sm);
    font-family: var(--font) !important;
  }
  .litegraph .lite-search-item:hover,
  .litegraph .lite-search-item.selected {
    background-color: var(--bg-soft) !important;
    color: var(--primary) !important;
  }
  .graph-wrap .lgraphdialog {
    background-color: var(--bg) !important;
    color: var(--text) !important;
    border: 1px solid var(--bg-muted) !important;
    border-radius: var(--radius-md);
    font-family: var(--font) !important;
  }
  .graph-wrap .lgraphdialog input {
    background-color: var(--bg-soft) !important;
    color: var(--text) !important;
    border: 1px solid var(--bg-muted) !important;
  }
</style>

<script>
  import { LiteGraph, LGraph, LGraphCanvas } from 'litegraph.js';
  import { MATERIALS, interpolateNK, nkToEpsilon, drudeEpsilon } from '../../lib/materials';
  import { csqrtUpper } from '../../lib/complex';
  import { computeMie } from '../../lib/mie';
  import { computePlasmonSpectrum, SHAPE_OPTIONS, type PlasmonShapeId } from '../../lib/plasmonic-nanoparticles';
  import { computeElectronSphereSpectrum } from '../../lib/electron-sphere';
  import { spectrumFromMie, spectrumFromPlasmon, spectrumFromElectron, peakAnalysis, type Spectrum } from '../../lib/spectrum';
  import { spectrumToHex } from '../../lib/colorimetry';
  import { peakIrradianceWm2, deltaTSpectrum } from '../../lib/photothermal';
  import { chartTheme, onThemeChange } from '../../lib/chart-theme';
  import { downloadBlob } from '../../lib/download';
  import { loadCatalog, fetchMaterialNK, searchCatalog, type RIIMaterial } from '../../data/refractiveindex';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const HC = 1239.841984;

  // ── Validated series palettes (dataviz six-checks), per theme ──
  const SIGMA_COLORS = {
    light: { ext: '#6366F1', sca: '#06B6D4', abs: '#F43F5E' },
    dark:  { ext: '#6366F1', sca: '#0891B2', abs: '#F43F5E' },
  };
  const ELECTRON_COLORS = {
    light: { eels: '#7C3AED', cl: '#F59E0B' },
    dark:  { eels: '#7C3AED', cl: '#D97706' },
  };
  const isDark = () => document.documentElement.dataset.theme === 'dark'
    || (!document.documentElement.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
  const sigmaColors = () => (isDark() ? SIGMA_COLORS.dark : SIGMA_COLORS.light);
  const electronColors = () => (isDark() ? ELECTRON_COLORS.dark : ELECTRON_COLORS.light);

  // ── Material descriptor (plain data on the wire; callbacks built at use) ──
  interface MaterialDesc { kind: 'db' | 'drude' | 'rii'; id?: string; dataPath?: string; epsB?: number; wpEv?: number; gammaEv?: number; }
  const riiNK = new Map<string, number[][]>();      // dataPath → tabulated [[µm, n, k]]
  const riiPending = new Set<string>();
  const riiErrors = new Map<string, string>();
  function nkOf(mat: MaterialDesc, lambdaNm: number): [number, number] {
    if (mat.kind === 'drude') {
      const nk = csqrtUpper(drudeEpsilon(lambdaNm, { epsB: mat.epsB!, wpEv: mat.wpEv!, gammaEv: mat.gammaEv! }));
      return [nk.re, nk.im];
    }
    if (mat.kind === 'rii') return interpolateNK(riiNK.get(mat.dataPath!)!, lambdaNm);
    return interpolateNK(MATERIALS[mat.id!].data, lambdaNm);
  }
  // Fetch tabulated data for a graph that references an RII material (e.g. a
  // restored permalink); re-runs the graph when the data lands.
  function ensureRiiData(dataPath: string) {
    if (riiNK.has(dataPath) || riiPending.has(dataPath)) return;
    riiPending.add(dataPath);
    fetchMaterialNK(dataPath)
      .then((data) => { riiNK.set(dataPath, data); riiErrors.delete(dataPath); })
      .catch((err) => { riiErrors.set(dataPath, String(err?.message || err)); })
      .finally(() => { riiPending.delete(dataPath); scheduleRun(); });
  }
  function epsOf(mat: MaterialDesc, lambdaNm: number) {
    if (mat.kind === 'drude') return drudeEpsilon(lambdaNm, { epsB: mat.epsB!, wpEv: mat.wpEv!, gammaEv: mat.gammaEv! });
    const [n, k] = nkOf(mat, lambdaNm);
    return nkToEpsilon(n, k);
  }

  interface SeriesSpec { key: string; label: string; color: string; }
  interface ChartData { spectrum: Spectrum; series: SeriesSpec[]; xLabel: string; xUnit: string; }
  interface ProducerOutput { spectrum: Spectrum; radiusNm: number; }

  // ── Scheduling ──
  let rafId = 0;
  function scheduleRun() {
    if (!rafId) rafId = requestAnimationFrame(() => {
      rafId = 0;
      try { graph.runStep(1); } catch (err) { console.error(err); }
      lcanvas.setDirty(true, true);
      renderInspector();
    });
  }

  const MAT_IDS = [...Object.keys(MATERIALS), 'drude'];
  const POINTS = 240;

  // ── Editor theme: restyle litegraph to the site's design system ──
  type Family = 'source' | 'solver' | 'derived';
  // Header colors: dark enough for white 13px-bold titles.
  const FAMILY_ACCENT: Record<Family, string> = { source: '#4F46E5', solver: '#0E7490', derived: '#B45309' };
  // The canvas is a deliberately dark "instrument" surface in BOTH site themes
  // (like a code block in light docs) — saturated wires and colored headers pop.
  const INSTRUMENT = {
    canvasBg: '#12102B',
    titleText: '#FFFFFF',
    link: '#6D6A9E',
    linkTypes: { material: '#818CF8', env: '#60A5FA', sphere: '#22D3EE', particle: '#22D3EE', spectrum: '#FBBF24' },
    portOff: '#6D6A9E', portOn: '#A5B4FC',
    outline: '#A5B4FC',
    shadow: 'rgba(0, 0, 0, 0.45)',
    gridDot: 'rgba(165, 180, 252, 0.12)',
  };
  const EDITOR_THEME = {
    light: {
      ...INSTRUMENT,
      nodeBg: '#FFFFFF',
      text: '#64648B', ink: '#64648B',
      widgetBg: '#F8F7FF', widgetOutline: '#E4E2F5', widgetText: '#5B5EE0', widgetText2: '#64648B',
      miniBorder: 'rgba(100, 100, 139, 0.25)',
    },
    dark: {
      ...INSTRUMENT,
      canvasBg: '#0B0A16',
      nodeBg: '#232145',
      text: '#B4B2CC', ink: '#B4B2CC',
      widgetBg: '#1A1930', widgetOutline: '#3D3B66', widgetText: '#A5B4FC', widgetText2: '#9896B0',
      miniBorder: 'rgba(165, 180, 252, 0.3)',
    },
  };
  const theme = () => (isDark() ? EDITOR_THEME.dark : EDITOR_THEME.light);
  const GRID_SVG = (dot: string) =>
    'data:image/svg+xml;utf8,' + encodeURIComponent(
      `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"><circle cx="16" cy="16" r="1.2" fill="${dot}"/></svg>`,
    );

  function applyEditorTheme() {
    const t = theme();
    Object.assign(LiteGraph, {
      NODE_TITLE_COLOR: t.titleText,
      NODE_SELECTED_TITLE_COLOR: t.titleText,
      NODE_TEXT_COLOR: t.text,
      NODE_DEFAULT_COLOR: FAMILY_ACCENT.source,
      NODE_DEFAULT_BGCOLOR: t.nodeBg,
      NODE_DEFAULT_BOXCOLOR: 'rgba(255,255,255,0.85)',
      NODE_BOX_OUTLINE_COLOR: t.outline,
      WIDGET_BGCOLOR: t.widgetBg,
      WIDGET_OUTLINE_COLOR: t.widgetOutline,
      WIDGET_TEXT_COLOR: t.widgetText,
      WIDGET_SECONDARY_TEXT_COLOR: t.widgetText2,
      DEFAULT_SHADOW_COLOR: t.shadow,
      LINK_COLOR: t.link,
      CONNECTING_LINK_COLOR: t.outline,
    });
    Object.assign(lcanvas, {
      clear_background_color: t.canvasBg,
      background_image: GRID_SVG(t.gridDot),
      render_shadows: true,
      render_canvas_border: false,
      render_connection_arrows: false,
      connections_width: 3,
      round_radius: 10,
      default_link_color: t.link,
      link_type_colors: t.linkTypes,
      default_connection_color: { input_off: t.portOff, input_on: t.portOn, output_off: t.portOff, output_on: t.portOn },
      title_text_font: `600 13px ${getComputedStyle(document.body).fontFamily}`,
      inner_text_font: `normal 12px ${getComputedStyle(document.body).fontFamily}`,
    });
    for (const node of (graph as any)._nodes || []) applyNodeTheme(node);
    lcanvas.setDirty(true, true);
  }
  function applyNodeTheme(node: any) {
    const t = theme();
    node.color = FAMILY_ACCENT[(node.constructor as any).family as Family] || FAMILY_ACCENT.source;
    node.bgcolor = t.nodeBg;
    node.boxcolor = 'rgba(255,255,255,0.85)';
  }

  // ── Node definitions (replace the stock litegraph node library) ──
  LiteGraph.clearRegisteredTypes();

  function defineNode(
    type: string, title: string, family: Family,
    setup: (node: any) => void, onExecute: (node: any) => void,
    extras: Record<string, any> = {},
  ) {
    function NodeClass(this: any) {
      this.serialize_widgets = true;
      this.onConnectionsChange = () => scheduleRun();
      setup(this);
      applyNodeTheme(this);
    }
    (NodeClass as any).title = title;
    (NodeClass as any).family = family;
    NodeClass.prototype.onExecute = function () { try { onExecute(this); } catch (err) { console.error(title, err); } };
    NodeClass.prototype.onPropertyChanged = function () { scheduleRun(); };
    Object.assign(NodeClass.prototype, extras);
    LiteGraph.registerNodeType(type, NodeClass as any);
  }

  const widget = (node: any, kind: string, name: string, prop: string, options: any = {}) => {
    node.addWidget(kind, name, node.properties[prop], () => scheduleRun(), { ...options, property: prop });
  };

  // Sources -------------------------------------------------------------
  const RII_OPTION = 'database…';
  defineNode('workbench/material', 'Material', 'source', (n) => {
    n.addOutput('material', 'material');
    n.properties = { source: 'au', epsB: 1, wpEv: 9, gammaEv: 0.05, riiDataPath: '', riiLabel: '' };
    n.addWidget('combo', 'source', n.properties.source, (v: string) => {
      if (v === RII_OPTION) openRiiDialog(n);
      scheduleRun();
    }, { values: [...MAT_IDS, RII_OPTION], property: 'source' });
