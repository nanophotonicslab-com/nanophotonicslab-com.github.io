    setProp(matB, 'source', 'ag');
    const env = mkNode('workbench/environment', 40, 420);
    const sph = mkNode('workbench/sphere', 40, 590);
    setProp(sph, 'radiusNm', 60);
    const mieA = mkNode('workbench/mie', 340, 80);
    const mieB = mkNode('workbench/mie', 340, 320);
    const pkA = mkNode('workbench/peak', 650, 90);
    const pkB = mkNode('workbench/peak', 650, 330);
    setProp(pkA, 'channel', 'csca');
    setProp(pkB, 'channel', 'csca');
    for (const [mat, mie, pk] of [[matA, mieA, pkA], [matB, mieB, pkB]] as const) {
      mat.connect(0, mie, 0); env.connect(0, mie, 1); sph.connect(0, mie, 2);
      mie.connect(0, pk, 0);
