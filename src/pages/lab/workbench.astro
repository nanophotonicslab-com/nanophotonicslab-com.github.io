  function buildDefaultGraph() {
    graph.clear();
    const mk = (type: string, x: number, y: number) => {
      const node = LiteGraph.createNode(type);
      node.pos = [x, y];
      graph.add(node);
      return node;
    };
    const mat = mk('workbench/material', 40, 80);
    const env = mk('workbench/environment', 40, 280);
    const sph = mk('workbench/sphere', 40, 450);
    const par = mk('workbench/particle', 40, 560);
    const mie = mk('workbench/mie', 340, 80);
    const pla = mk('workbench/plasmon', 340, 280);
    const ele = mk('workbench/electron', 340, 480);
    const pt = mk('workbench/photothermal', 650, 80);
    const col = mk('workbench/color', 650, 320);
    const pk = mk('workbench/peak', 650, 480);
    for (const s of [mie, pla, ele]) { mat.connect(0, s, 0); env.connect(0, s, 1); }
    sph.connect(0, mie, 2); sph.connect(0, ele, 2);
    par.connect(0, pla, 2);
    mie.connect(0, pt, 0);
    pla.connect(0, col, 0);
    mie.connect(0, pk, 0);
  }

  // ── Save / share via URL hash ──
  function serializeToHash(): string {
    const json = JSON.stringify(graph.serialize());
    return btoa(String.fromCharCode(...new TextEncoder().encode(json)));
  }
  function restoreFromHash(): boolean {
    const m = location.hash.match(/^#g=(.+)$/);
    if (!m) return false;
    try {
      const bytes = Uint8Array.from(atob(m[1]), (c) => c.charCodeAt(0));
      graph.configure(JSON.parse(new TextDecoder().decode(bytes)));
      return true;
    } catch (err) { console.error('bad graph permalink', err); return false; }
  }
  $('btn-share').addEventListener('click', async () => {
    const url = `${location.origin}${location.pathname}#g=${serializeToHash()}`;
    history.replaceState(null, '', url);
    try { await navigator.clipboard.writeText(url); $('share-hint').textContent = 'Link copied to clipboard.'; }
    catch { $('share-hint').textContent = 'Link is in the address bar.'; }
    setTimeout(() => { $('share-hint').textContent = ''; }, 3000);
  });

  // ── Example graphs (the tutorial that teaches by doing) ──
  const mkNode = (type: string, x: number, y: number) => {
    const node = LiteGraph.createNode(type);
    node.pos = [x, y];
    graph.add(node);
    return node;
  };
  // Set a property AND sync its widget display (widgets cache their value).
  function setProp(node: any, key: string, value: unknown) {
    node.properties[key] = value;
    const w = (node.widgets || []).find((w: any) => w.options?.property === key);
    if (w) w.value = value;
  }
  function loadExample(build: () => void) {
    history.replaceState(null, '', location.pathname);
    graph.clear();
    build();
    scheduleRun();
  }

  function buildCompareGraph() {
    const matA = mkNode('workbench/material', 40, 60);
