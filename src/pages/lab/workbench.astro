  }

  function buildThermalGraph() {
    const mat = mkNode('workbench/material', 40, 80);
    const env = mkNode('workbench/environment', 40, 280);
    const sph = mkNode('workbench/sphere', 40, 460);
    setProp(sph, 'radiusNm', 60);
    const mie = mkNode('workbench/mie', 320, 120);
    const pt = mkNode('workbench/photothermal', 600, 100);
    const pk = mkNode('workbench/peak', 880, 130);
    setProp(pk, 'channel', 'dT');
    mat.connect(0, mie, 0); env.connect(0, mie, 1); sph.connect(0, mie, 2);
    mie.connect(0, pt, 0);
    pt.connect(0, pk, 0); // chained derivation: σ_abs → ΔT(λ) → peak width
  }

  $('ex-default').addEventListener('click', () => loadExample(buildDefaultGraph));
