  // Shared mini-plot for solver/derived nodes --------------------------
  function drawMiniPlot(node: any, ctx: CanvasRenderingContext2D, top: number) {
    const cd: ChartData | undefined = node._chart;
    const w = node.size[0] - 20, h = node.size[1] - top - 10;
    if (!cd || w < 40 || h < 24) return;
    ctx.save();
    ctx.strokeStyle = theme().miniBorder;
    ctx.strokeRect(10, top, w, h);
    let ymax = 0;
    for (const s of cd.series) for (const v of cd.spectrum.series[s.key]) if (v > ymax) ymax = v;
    if (ymax <= 0) { ctx.restore(); return; }
    const { x } = cd.spectrum;
    for (const s of cd.series) {
      const ys = cd.spectrum.series[s.key];
      ctx.strokeStyle = s.color; ctx.lineWidth = 1.4;
      ctx.beginPath();
      for (let i = 0; i < x.length; i++) {
        const px = 10 + (w * i) / (x.length - 1);
        const py = top + h - (h * ys[i]) / ymax;
        i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
      }
      ctx.stroke();
    }
    ctx.restore();
  }

