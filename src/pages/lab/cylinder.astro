  // Angular cut selector: the user picks a single photon energy / wavelength.
  // The canonical value is always stored in eV (state.angleEnergyEv); the input
  // can display either E (eV) or λ (nm). λ = hc/E and E = hc/λ, so the same
  // lambdaNmFromEnergy() converts both directions.
  const ANGLE_EV_MIN = 0.5;
  const ANGLE_EV_MAX = 6;
  function applyAngleAxisMode() {
    const num = $<HTMLInputElement>('angle-energy-num');
    const slider = $<HTMLInputElement>('angle-energy-slider');
    const label = $('angle-axis-label');
    const unit = $('angle-axis-unit');
    const sw = $('angle-axis-switch');
    sw.querySelectorAll<HTMLElement>('.angle-axis-switch__opt').forEach(o => o.classList.toggle('active', o.dataset.opt === state.angleAxisMode));
    sw.setAttribute('aria-checked', state.angleAxisMode === 'lambda' ? 'true' : 'false');
    if (state.angleAxisMode === 'lambda') {
      const lamMin = Math.round(lambdaNmFromEnergy(ANGLE_EV_MAX));
      const lamMax = Math.round(lambdaNmFromEnergy(ANGLE_EV_MIN));
      const lam = Math.round(lambdaNmFromEnergy(state.angleEnergyEv));
      label.textContent = 'λ =';
      unit.textContent = 'nm';
      slider.min = String(lamMin); slider.max = String(lamMax); slider.step = '1';
      slider.value = String(lam);
      num.min = String(lamMin); num.max = String(lamMax); num.step = '1';
      num.value = String(lam);
    } else {
      label.textContent = 'E =';
      unit.textContent = 'eV';
      slider.min = String(ANGLE_EV_MIN); slider.max = String(ANGLE_EV_MAX); slider.step = '0.05';
      slider.value = String(state.angleEnergyEv);
      num.min = '0.1'; num.removeAttribute('max'); num.step = '0.1';
      num.value = state.angleEnergyEv.toFixed(2);
    }
  }
