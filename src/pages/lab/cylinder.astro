    $<HTMLInputElement>('r-slider').value = '15';
    $<HTMLInputElement>('eh-num').value = '1.00';
    $<HTMLInputElement>('eh-slider').value = '1';
    $<HTMLInputElement>('e1r-num').value = '10.0';
    $<HTMLInputElement>('e1r-slider').value = '10';
    $<HTMLInputElement>('e1i-num').value = '0.10';
    $<HTMLInputElement>('e1i-slider').value = '0.1';
    $<HTMLInputElement>('w-min').value = String(wMin);
    $<HTMLInputElement>('w-max').value = String(wMax);
    $<HTMLInputElement>('angle-energy-num').value = '2.4';
    $<HTMLInputElement>('angle-energy-slider').value = '2.4';
    $<HTMLInputElement>('b-num').value = '25';
    $<HTMLInputElement>('b-slider').value = '25';
    $<HTMLInputElement>('v-num').value = state.vFrac.toFixed(3);
    $<HTMLInputElement>('v-slider').value = String(state.vFrac);
    syncKeVFromBeta();
    $<HTMLInputElement>('Mmax-num').value = String(mMax);
    qzMaxNum.value = '0.1';
    customSlopeNum.value = '0.30';
    perpGridSelect.value = 'standard';
    materialSelect.value = matId;
    drudeInputs.epsB.value = '1';
    drudeInputs.wpEv.value = '5';
    drudeInputs.gammaEv.value = '0.05';
    syncTabs('axis-tabs', 'axis', state.axisMode);
    syncTabs('quantity-tabs', 'qty', state.spectrumQuantity);
    syncTabs('decomp-tabs', 'decomp', state.spectrumDecomp);
    syncTabs('pol-tabs', 'pol', state.angularPol);
    syncTabs('parallel-geometry-tabs', 'parallelGeometry', state.parallelGeometry);
    syncTabs('phase-axis-tabs', 'phaseAxis', state.phaseAxis);
    updateDecompAvailability();
    applyAngleAxisMode();
    logToggle.classList.remove('active');
    fieldNormalizedToggle.classList.remove('active');
    fieldLogToggle.classList.remove('active');
    syncFieldComponentControls();
    document.querySelectorAll<HTMLButtonElement>('#excitation-tabs .view-tab').forEach(b => {
      const active = b.dataset.excitation === exc;
      b.classList.toggle('active', active);
      b.setAttribute('aria-checked', String(active));
    });
    $('eh-presets').querySelectorAll('.preset-btn').forEach((b, i) => b.classList.toggle('active', i === 0));
    updateMaterialUI();
    updateExcitationUI(true);
    updateBNote();
    recompute();
  });

  updateMaterialUI();
  updateExcitationUI(true);
  syncKeVFromBeta();
  updateBNote();

  new ResizeObserver(drawChart).observe(chartWrap);
  new ResizeObserver(drawPhaseVelocityPlot).observe(phasePlotPanel);
  new ResizeObserver(drawPerpMap).observe($('perp-map-wrap'));
  new ResizeObserver(drawFieldProfile).observe(fieldProfilePanel);

  onThemeChange(() => {
    updateConfigCheck();
    drawChart();
    drawPerpMap();
    drawFieldProfile();
  });

  // ===== Export / Share =====
  const canvas = document.getElementById('cyl-chart') as HTMLCanvasElement;

  import { downloadBlob } from '../../lib/download';

  function selectedFieldProfileForExport(): FieldProfile | null {
    if (!selectedFieldPoint || state.materialId !== 'custom') return null;
    return computeSelectedFieldProfile();
  }

  function exportFieldProfilePng(): void {
    if (!selectedFieldPoint) return;
    const fieldCanvases = [fieldExCanvas, fieldEyCanvas, fieldEzCanvas, fieldMagCanvas];
    const labels = [
      fieldExLabel.textContent || 'E_x',
      fieldEyLabel.textContent || 'E_y',
      fieldEzLabel.textContent || 'E_z',
      fieldMagLabel.textContent || '|E|',
    ];
    const tileW = Math.max(...fieldCanvases.map(c => c.width));
    const tileH = Math.max(...fieldCanvases.map(c => c.height));
    if (!tileW || !tileH) return;
    const dpr = window.devicePixelRatio || 1;
    const gap = Math.round(20 * dpr);
    const titleH = Math.round(82 * dpr);
    const labelH = Math.round(26 * dpr);
    const legendW = fieldColorbarCanvas.width > 0
      ? fieldColorbarCanvas.width + Math.round(16 * dpr)
      : 0;
    const out = document.createElement('canvas');
    out.width = tileW * 2 + gap + legendW;
    out.height = titleH + labelH * 2 + tileH * 2 + gap;
    const ctx = out.getContext('2d')!;
    const ct = chartTheme();
    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, out.width, out.height);
    ctx.fillStyle = ct.text;
    ctx.font = `${18 * dpr}px Inter, system-ui, sans-serif`;
    ctx.textAlign = 'left';
    ctx.textBaseline = 'top';
    ctx.fillText(fieldProfileTitle.textContent || 'Mode field profile', 0, 0);
    ctx.fillStyle = ct.textMuted;
    ctx.font = `${12 * dpr}px Inter, system-ui, sans-serif`;
    ctx.fillText(fieldProfileMeta.textContent || '', 0, Math.round(28 * dpr));

    for (let i = 0; i < fieldCanvases.length; i++) {
      const col = i % 2;
      const row = Math.floor(i / 2);
      const x = col * (tileW + gap);
      const y = titleH + row * (tileH + labelH + gap);
      ctx.fillStyle = ct.textSoft;
      ctx.font = `${12 * dpr}px Inter, system-ui, sans-serif`;
      ctx.fillText(labels[i], x, y);
      ctx.drawImage(fieldCanvases[i], x, y + labelH, tileW, tileH);
    }
    if (legendW > 0) {
      const x = tileW * 2 + gap + Math.round(8 * dpr);
      ctx.drawImage(fieldColorbarCanvas, x, titleH + labelH, fieldColorbarCanvas.width, fieldColorbarCanvas.height);
    }
    out.toBlob(b => { if (b) downloadBlob(b, `cylinder_${selectedFieldPoint!.modeLabel}_fields.png`); }, 'image/png');
  }

  function exportFieldProfileCsv(): void {
    const profile = selectedFieldProfileForExport();
    if (!profile || !selectedFieldPoint) return;
    const header = [
      `# Cylinder field profile`,
      `# mode=${selectedFieldPoint.modeLabel}, omega_eV=${selectedFieldPoint.w}, q_nm-1=${selectedFieldPoint.q}, m=${selectedFieldPoint.m}`,
      `# radius_nm=${state.a_nm}, eps_h=${state.eps_h}, eps1_re=${state.eps1_re}, eps1_im=${state.eps1_im}`,
      'x_nm,y_nm,ex_re,ex_im,ey_re,ey_im,ez_re,ez_im,e_abs',
    ];
    const rows: string[] = [];
    for (let iy = 0; iy < profile.n; iy++) {
      const y = profile.limNm - (2 * profile.limNm * iy) / (profile.n - 1);
      for (let ix = 0; ix < profile.n; ix++) {
        const x = -profile.limNm + (2 * profile.limNm * ix) / (profile.n - 1);
        const idx = iy * profile.n + ix;
        rows.push([
          x.toFixed(6),
          y.toFixed(6),
          profile.components.ex.re[idx].toExponential(8),
          profile.components.ex.im[idx].toExponential(8),
          profile.components.ey.re[idx].toExponential(8),
          profile.components.ey.im[idx].toExponential(8),
          profile.components.ez.re[idx].toExponential(8),
          profile.components.ez.im[idx].toExponential(8),
          profile.mag[idx].toExponential(8),
        ].join(','));
      }
    }
    downloadBlob(new Blob([[...header, ...rows].join('\n') + '\n'], { type: 'text/csv' }),
                 `cylinder_${selectedFieldPoint.modeLabel}_fields.csv`);
  }

  document.getElementById('dl-png')!.addEventListener('click', () => {
    canvas.toBlob(b => { if (b) downloadBlob(b, `cylinder_${state.view}.png`); }, 'image/png');
  });

  fieldPngBtn.addEventListener('click', exportFieldProfilePng);
  fieldCsvBtn.addEventListener('click', exportFieldProfileCsv);

  document.getElementById('dl-csv')!.addEventListener('click', () => {
    const header = [
      `# Cylinder — a=${state.a_nm} nm, eps_h=${state.eps_h}, material=${state.materialId}, excitation=${state.excitation}`,
      `# view=${state.view}`,
      '# Generated by NanophotonicsLab (nanophotonicslab.com)',
    ];
    let body: string[] = [];
    if (state.view === 'cross-section') {
      body.push('omega_eV,lambda_nm,c_ext_nm,c_sca_nm,c_abs_nm,q_ext,q_sca,q_abs,c_ext_Eaxis_nm,c_ext_Haxis_nm,c_sca_Eaxis_nm,c_sca_Haxis_nm,c_abs_Eaxis_nm,c_abs_Haxis_nm,q_sca_parallel_raw,q_sca_perpendicular_raw,q_ext_parallel_raw,q_ext_perpendicular_raw');
      for (const p of planeSpectrum) {
        body.push(`${p.w.toFixed(6)},${lambdaNmFromEnergy(p.w).toFixed(6)},${p.cext.toExponential(8)},${p.csca.toExponential(8)},${p.cabs.toExponential(8)},${p.qext.toExponential(8)},${p.qsca.toExponential(8)},${p.qabs.toExponential(8)},${p.cextE.toExponential(8)},${p.cextM.toExponential(8)},${p.cscaE.toExponential(8)},${p.cscaM.toExponential(8)},${p.cabsE.toExponential(8)},${p.cabsM.toExponential(8)},${p.qscaPar.toExponential(8)},${p.qscaPer.toExponential(8)},${p.qextPar.toExponential(8)},${p.qextPer.toExponential(8)}`);
      }
    } else if (state.view === 'angular') {
      body.push('angle_deg,T11,POL,T33,T34');
      for (const row of angularRows) {
        body.push(`${row.angleDeg.toFixed(4)},${row.t11.toExponential(8)},${row.pol.toExponential(8)},${row.t33.toExponential(8)},${row.t34.toExponential(8)}`);
      }
    } else if (state.view === 'disp-wq' || state.view === 'disp-bV') {
      body.push('m,omega_eV,q_nm-1');
      for (const br of branches) {
        for (const pt of br.points) {
          body.push(`${br.m},${pt.w.toFixed(6)},${pt.q.toFixed(8)}`);
        }
      }
    } else if (eelsCurve) {
      body.push(state.view === 'eels-par'
        ? 'energy_eV,eels_1_per_eV_nm'
        : 'energy_eV,eels_1_per_eV');
      for (let i = 0; i < eelsCurve.w.length; i++) {
        body.push(`${eelsCurve.w[i].toFixed(6)},${eelsCurve.y[i].toExponential(6)}`);
      }
      if (state.view === 'eels-perp' && perpMap) {
        body.push('');
        body.push('qresolved_nm_per_eV_rows_energy_columns_qz_nm-1');
        body.push(['energy_eV', ...perpMap.qz_nm.map(q => q.toFixed(6))].join(','));
        for (let iw = 0; iw < perpMap.w_eV.length; iw++) {
          body.push([perpMap.w_eV[iw].toFixed(6), ...perpMap.values_nm_per_eV[iw].map(v => v.toExponential(6))].join(','));
        }
      }
    } else {
      body.push('# No data for current view');
    }
    downloadBlob(new Blob([[...header, ...body].join('\n') + '\n'], { type: 'text/csv' }),
                 `cylinder_${state.view}.csv`);
  });

  const shareBtn = document.getElementById('share-btn')!;
  function serializeState(): string {
    const p = new URLSearchParams();
    p.set('a', String(state.a_nm));
    p.set('eh', String(state.eps_h));
    p.set('mat', state.materialId);
    p.set('e1r', String(state.eps1_re));
    p.set('e1i', String(state.eps1_im));
    p.set('wmin', String(state.w_min));
    p.set('wmax', String(state.w_max));
    p.set('angle', String(state.angleEnergyEv));
    p.set('angleax', state.angleAxisMode);
    p.set('axis', state.axisMode);
    p.set('qty', state.spectrumQuantity);
    p.set('decomp', state.spectrumDecomp);
    p.set('pol', state.angularPol);
    if (state.logY) p.set('logY', '1');
    p.set('exc', state.excitation);
    p.set('m', Array.from(state.m_active).sort().join(','));
    p.set('v', state.view);
    p.set('pg', state.parallelGeometry);
    p.set('b', String(state.b_nm));
    p.set('vf', String(state.vFrac));
    p.set('mmax', String(state.maxOrderEels));
    p.set('qmax', String(state.qzMaxNm));
    if (state.mapLogColor) p.set('maplog', '1');
    if (!state.mapShowLight) p.set('light', '0');
    if (!state.mapShowElectron) p.set('eline', '0');
    if (state.mapShowCustom) p.set('custom', '1');
    p.set('cslope', String(state.mapCustomSlope));
    p.set('pvx', state.phaseAxis);
    if (state.fieldNormalized) p.set('fnorm', '1');
    if (state.fieldLogMag) p.set('flog', '1');
    p.set('pgrid', state.perpGridQuality);
    if (state.materialId === 'drude') {
      p.set('depsb', String(state.drude.epsB));
      p.set('dwp', String(state.drude.wpEv));
      p.set('dgamma', String(state.drude.gammaEv));
    }
    return p.toString();
  }
  const shareButtonHtml = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> Share';
  function copyShareUrl(button: HTMLElement): void {
    const url = location.origin + location.pathname + '#' + serializeState();
    navigator.clipboard.writeText(url).then(() => {
      button.textContent = 'Copied!';
      setTimeout(() => {
        button.innerHTML = shareButtonHtml;
      }, 1500);
    });
  }
  shareBtn.addEventListener('click', () => copyShareUrl(shareBtn));
  fieldShareBtn.addEventListener('click', () => copyShareUrl(fieldShareBtn));

  function restoreState() {
    const hash = location.hash.slice(1);
    if (!hash) return;
    const p = new URLSearchParams(hash);
    if (p.has('a')) { state.a_nm = parseFloat(p.get('a')!); ($('r-num') as HTMLInputElement).value = String(state.a_nm); ($('r-slider') as HTMLInputElement).value = String(state.a_nm); }
    if (p.has('eh')) { state.eps_h = parseFloat(p.get('eh')!); ($('eh-num') as HTMLInputElement).value = String(state.eps_h); ($('eh-slider') as HTMLInputElement).value = String(state.eps_h); }
    if (p.has('mat')) { state.materialId = p.get('mat')!; materialSelect.value = state.materialId; }
    if (p.has('e1r')) { state.eps1_re = parseFloat(p.get('e1r')!); ($('e1r-num') as HTMLInputElement).value = String(state.eps1_re); ($('e1r-slider') as HTMLInputElement).value = String(state.eps1_re); }
    if (p.has('e1i')) { state.eps1_im = parseFloat(p.get('e1i')!); ($('e1i-num') as HTMLInputElement).value = String(state.eps1_im); ($('e1i-slider') as HTMLInputElement).value = String(state.eps1_im); }
    if (p.has('wmin')) { state.w_min = parseFloat(p.get('wmin')!); ($('w-min') as HTMLInputElement).value = String(state.w_min); }
    if (p.has('wmax')) { state.w_max = parseFloat(p.get('wmax')!); ($('w-max') as HTMLInputElement).value = String(state.w_max); }
    if (p.has('angle')) { state.angleEnergyEv = parseFloat(p.get('angle')!); ($('angle-energy-num') as HTMLInputElement).value = String(state.angleEnergyEv); ($('angle-energy-slider') as HTMLInputElement).value = String(state.angleEnergyEv); }
    if (p.get('angleax') === 'energy' || p.get('angleax') === 'lambda') state.angleAxisMode = p.get('angleax') as AngleAxisMode;
    if (p.get('axis') === 'energy' || p.get('axis') === 'lambda') state.axisMode = p.get('axis') as AxisMode;
    if (['csca', 'cext', 'cabs', 'qsca', 'all'].includes(p.get('qty') ?? '')) state.spectrumQuantity = p.get('qty') as SpectrumQuantity;
    if (p.get('decomp') === 'total' || p.get('decomp') === 'em') state.spectrumDecomp = p.get('decomp') as SpectrumDecomp;
    if (p.get('pol') === 'total' || p.get('pol') === 'perp' || p.get('pol') === 'par') state.angularPol = p.get('pol') as AngularPolMode;
    if (p.get('logY') === '1') state.logY = true;
    if (p.has('exc')) {
      const exc = p.get('exc') as ExcitationMode | null;
      if (exc === 'plane' || exc === 'electron') state.excitation = exc;
      document.querySelectorAll<HTMLButtonElement>('#excitation-tabs .view-tab').forEach(t => {
        t.classList.toggle('active', t.dataset.excitation === state.excitation);
        t.setAttribute('aria-checked', String(t.dataset.excitation === state.excitation));
      });
    }
    if (p.has('m')) {
      state.m_active = new Set(p.get('m')!.split(',').filter(Boolean).map(Number));
    }
    if (p.has('v')) {
      state.view = p.get('v')! as ViewMode;
      document.querySelectorAll<HTMLButtonElement>('#view-tabs .view-tab').forEach(t => {
        t.classList.toggle('active', t.dataset.view === state.view);
        t.setAttribute('aria-checked', String(t.dataset.view === state.view));
      });
    }
    if (p.get('pg') === 'outside' || p.get('pg') === 'inside-hole') state.parallelGeometry = p.get('pg') as ParallelGeometry;
    if (p.has('b')) { state.b_nm = parseFloat(p.get('b')!); ($('b-num') as HTMLInputElement).value = String(state.b_nm); ($('b-slider') as HTMLInputElement).value = String(state.b_nm); }
    if (p.has('vf')) { state.vFrac = parseFloat(p.get('vf')!); ($('v-num') as HTMLInputElement).value = String(state.vFrac); ($('v-slider') as HTMLInputElement).value = String(state.vFrac); }
    if (p.has('mmax')) { state.maxOrderEels = parseInt(p.get('mmax')!); ($('Mmax-num') as HTMLInputElement).value = String(state.maxOrderEels); }
    if (p.has('qmax')) { state.qzMaxNm = Math.max(0.02, parseFloat(p.get('qmax')!)); qzMaxNum.value = String(state.qzMaxNm); }
    if (p.get('maplog') === '1') state.mapLogColor = true;
    if (p.get('light') === '0') state.mapShowLight = false;
    if (p.get('eline') === '0') state.mapShowElectron = false;
    if (p.get('custom') === '1') state.mapShowCustom = true;
    if (p.has('cslope')) { state.mapCustomSlope = parseFloat(p.get('cslope')!); customSlopeNum.value = String(state.mapCustomSlope); }
    if (p.get('pvx') === 'q' || p.get('pvx') === 'energy') state.phaseAxis = p.get('pvx') as PhaseAxis;
    if (p.get('fnorm') === '1') state.fieldNormalized = true;
    if (p.get('flog') === '1') state.fieldLogMag = true;
    if (p.get('pgrid') === 'standard' || p.get('pgrid') === 'fine' || p.get('pgrid') === 'high') {
      state.perpGridQuality = p.get('pgrid') as PerpGridQuality;
      perpGridSelect.value = state.perpGridQuality;
    }
    if (p.has('depsb')) { state.drude.epsB = parseFloat(p.get('depsb')!); drudeInputs.epsB.value = String(state.drude.epsB); }
    if (p.has('dwp')) { state.drude.wpEv = parseFloat(p.get('dwp')!); drudeInputs.wpEv.value = String(state.drude.wpEv); }
    if (p.has('dgamma')) { state.drude.gammaEv = parseFloat(p.get('dgamma')!); drudeInputs.gammaEv.value = String(state.drude.gammaEv); }
    syncTabs('axis-tabs', 'axis', state.axisMode);
    syncTabs('quantity-tabs', 'qty', state.spectrumQuantity);
    syncTabs('decomp-tabs', 'decomp', state.spectrumDecomp);
    syncTabs('pol-tabs', 'pol', state.angularPol);
    syncTabs('parallel-geometry-tabs', 'parallelGeometry', state.parallelGeometry);
    syncTabs('phase-axis-tabs', 'phaseAxis', state.phaseAxis);
    applyAngleAxisMode();
    logToggle.classList.toggle('active', state.logY);
    syncKeVFromBeta();
    updateGeometryMarkers();
    updateMaterialUI();
    updateExcitationUI(true);
  }

  restoreState();
  updateBNote();
  updateDecompAvailability();

  // Initial
  recompute();
</script>
