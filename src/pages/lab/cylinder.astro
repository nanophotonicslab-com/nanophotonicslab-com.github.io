  function bindTabs<T extends string>(
    containerId: string,
    dataKey: string,
    read: () => T,
    write: (value: T) => void,
    afterChange: () => void,
  ) {
    $(containerId).addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.view-tab') as HTMLElement | null;
      if (!btn) return;
      if ((btn as HTMLButtonElement).disabled || btn.getAttribute('aria-disabled') === 'true') return;
      const value = btn.dataset[dataKey] as T | undefined;
      if (!value || value === read()) return;
      write(value);
      syncTabs(containerId, dataKey, value);
      afterChange();
    });
  }

