  function commitKineticEnergy(): void {
    const beta = kineticKeVToBeta(clampFinite(parseFloat(kevInput.value), 0, 1e6, betaToKineticKeV(state.vFrac)));
    state.vFrac = clampFinite(beta, 0.01, 0.99, state.vFrac);
    $<HTMLInputElement>('v-num').value = state.vFrac.toFixed(3);
    $<HTMLInputElement>('v-slider').value = String(state.vFrac);
    syncKeVFromBeta();
    scheduleRecompute();
  }

  function updateGeometryMarkers(): void {
    const showMarkers = state.excitation === 'electron';
    radiusImpactMarker.style.display = showMarkers ? '' : 'none';
    impactRadiusMarker.style.display = showMarkers ? '' : 'none';
    if (!showMarkers) return;
    const rSlider = $<HTMLInputElement>('r-slider');
    const bSlider = $<HTMLInputElement>('b-slider');
    const place = (marker: HTMLElement, slider: HTMLInputElement, value: number, title: string) => {
      const min = parseFloat(slider.min);
      const max = parseFloat(slider.max);
      const pct = max > min ? Math.max(0, Math.min(1, (value - min) / (max - min))) * 100 : 0;
      marker.style.left = `${pct}%`;
      marker.title = title;
      marker.style.opacity = value < min || value > max ? '0.45' : '1';
    };
    place(radiusImpactMarker, rSlider, state.b_nm, `Impact b = ${state.b_nm.toFixed(1)} nm`);
    place(impactRadiusMarker, bSlider, state.a_nm, `Radius a = ${state.a_nm.toFixed(1)} nm`);
  }

  function updateChartControls() {
    const isPlane = state.excitation === 'plane';
    const isSpectrum = isPlane && state.view === 'cross-section';
    const isAngular = isPlane && state.view === 'angular';
    const isElectron = state.excitation === 'electron';
    const isParallel = isElectron && state.view === 'eels-par';
    const isPerp = isElectron && state.view === 'eels-perp';
    const isDispWQ = isElectron && state.view === 'disp-wq';
    spectrumControls.style.display = isSpectrum ? '' : 'none';
    logToggle.style.display = (isSpectrum || isParallel || isPerp) ? '' : 'none';
    perpComputeBtn.style.display = isPerp ? '' : 'none';
    axisOverlay.style.display = isSpectrum ? '' : 'none';
    angularControls.style.display = isAngular ? '' : 'none';
    angularSlider.style.display = 'none';
    angularPolWrap.style.display = isAngular ? '' : 'none';
    parallelGeometryParam.style.display = isParallel ? '' : 'none';
    perpGridControl.style.display = isPerp ? '' : 'none';
    perpMapPanel.style.display = isPerp ? '' : 'none';
    fieldProfilePanel.style.display = isDispWQ ? '' : 'none';
    phasePlotPanel.style.display = isDispWQ ? '' : 'none';
    dispersionPlotToolbar.style.display = isDispWQ ? '' : 'none';
    chartWrap.classList.toggle('is-dispersion-split', isDispWQ);
    angularControls.style.marginLeft = isAngular ? 'auto' : '';
    computeStatus.style.marginLeft = isAngular ? '0' : 'auto';
    logToggle.classList.toggle('active', state.logY);
    mapLogToggle.classList.toggle('active', state.mapLogColor);
    mapLightToggle.classList.toggle('active', state.mapShowLight);
    mapElectronToggle.classList.toggle('active', state.mapShowElectron);
    mapCustomToggle.classList.toggle('active', state.mapShowCustom);
    mapPngBtn.disabled = !perpMap;
    fieldLogToggle.classList.toggle('active', state.fieldLogMag);
    fieldNormalizedToggle.classList.toggle('active', state.fieldNormalized);
  }

  logToggle.addEventListener('click', () => {
    state.logY = !state.logY;
    logToggle.classList.toggle('active', state.logY);
    drawChart();
    drawLegend();
  });

  fieldNormalizedToggle.addEventListener('click', () => {
    state.fieldNormalized = !state.fieldNormalized;
    updateChartControls();
    drawFieldProfile();
  });

  fieldLogToggle.addEventListener('click', () => {
    state.fieldLogMag = !state.fieldLogMag;
    updateChartControls();
    drawFieldProfile();
  });

  fieldProfilePanel.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest('.field-mode-btn') as HTMLButtonElement | null;
    if (!btn) return;
    const component = btn.dataset.fieldComponent as FieldComponent | undefined;
    const part = btn.dataset.fieldPart as FieldPart | undefined;
    if (!component || !part) return;
    state.fieldParts[component] = part;
    syncFieldComponentControls();
    drawFieldProfile();
  });

  perpComputeBtn.addEventListener('click', () => recompute(true));

  kevInput.addEventListener('change', commitKineticEnergy);
  kevInput.addEventListener('keydown', event => {
    if (event.key !== 'Enter') return;
    event.preventDefault();
    commitKineticEnergy();
    kevInput.blur();
  });
  $<HTMLInputElement>('v-num').addEventListener('input', syncKeVFromBeta);
  $<HTMLInputElement>('v-slider').addEventListener('input', syncKeVFromBeta);

  bindTabs<SpectrumQuantity>('quantity-tabs', 'qty', () => state.spectrumQuantity, value => { state.spectrumQuantity = value; }, () => {
    updateDecompAvailability();
    drawChart();
    drawLegend();
  });
  bindTabs<SpectrumDecomp>('decomp-tabs', 'decomp', () => state.spectrumDecomp, value => { state.spectrumDecomp = value; }, () => {
    drawChart();
    drawLegend();
  });
  bindTabs<AxisMode>('axis-tabs', 'axis', () => state.axisMode, value => { state.axisMode = value; }, () => {
    drawChart();
    drawLegend();
  });
  bindTabs<PhaseAxis>('phase-axis-tabs', 'phaseAxis', () => state.phaseAxis, value => { state.phaseAxis = value; }, () => {
    drawPhaseVelocityPlot();
    if (dispModalOpen) { syncTabs('disp-modal-phase-axis', 'phaseAxis', state.phaseAxis); renderDispModal(); }
  });
  bindTabs<AngularPolMode>('pol-tabs', 'pol', () => state.angularPol, value => { state.angularPol = value; }, () => {
    drawChart();
    drawLegend();
  });
  bindTabs<ParallelGeometry>('parallel-geometry-tabs', 'parallelGeometry', () => state.parallelGeometry, value => {
    state.parallelGeometry = value;
  }, () => {
    updateBNote();
    scheduleRecompute();
  });

  mapLogToggle.addEventListener('click', () => {
    state.mapLogColor = !state.mapLogColor;
    updateChartControls();
    drawPerpMap();
  });
  mapLightToggle.addEventListener('click', () => {
    state.mapShowLight = !state.mapShowLight;
    updateChartControls();
    drawPerpMap();
  });
  mapElectronToggle.addEventListener('click', () => {
    state.mapShowElectron = !state.mapShowElectron;
    updateChartControls();
    drawPerpMap();
  });
  mapCustomToggle.addEventListener('click', () => {
    state.mapShowCustom = !state.mapShowCustom;
    updateChartControls();
    drawPerpMap();
  });
  qzMaxNum.addEventListener('input', () => {
    const v = parseFloat(qzMaxNum.value);
    if (Number.isFinite(v) && v > 0) { state.qzMaxNm = v; scheduleRecompute(); }
  });
  customSlopeNum.addEventListener('input', () => {
    const v = parseFloat(customSlopeNum.value);
    if (Number.isFinite(v)) { state.mapCustomSlope = v; drawPerpMap(); }
  });
  perpGridSelect.addEventListener('change', () => {
    const quality = perpGridSelect.value as PerpGridQuality;
    if (quality === 'standard' || quality === 'fine' || quality === 'high') {
      state.perpGridQuality = quality;
      markPerpNeedsCompute();
    }
  });
  mapPngBtn.addEventListener('click', () => {
    if (!perpMap) return;
    perpMapCanvas.toBlob(b => { if (b) downloadBlob(b, 'cylinder_momentum_resolved_eels.png'); }, 'image/png');
  });

  phaseCanvas.addEventListener('mousemove', (e: MouseEvent) => {
    if (state.view !== 'disp-wq') return;
    const hit = nearestGroupVelocityPointHit(e.offsetX, e.offsetY);
    phaseCanvas.style.cursor = hit ? 'pointer' : 'crosshair';
    if (!hit) {
      phaseTooltip.classList.remove('visible');
      return;
    }
    phaseTooltip.innerHTML = `${hit.modeLabel}<br>\u210F\u03C9 = ${hit.w.toFixed(3)} eV<br>q_z = ${hit.q.toFixed(5)} nm^-1<br>v_g/c = ${hit.vg.toFixed(3)}`;
    phaseTooltip.classList.add('visible');
    const panelRect = phasePlotPanel.getBoundingClientRect();
    let tL = e.offsetX + 12;
    let tT = e.offsetY - 30 + phaseCanvas.offsetTop;
    if (tL + phaseTooltip.offsetWidth > panelRect.width - 4) tL = e.offsetX - phaseTooltip.offsetWidth - 12;
    if (tT < 4) tT = e.offsetY + 12 + phaseCanvas.offsetTop;
    phaseTooltip.style.left = `${Math.max(4, Math.min(tL, panelRect.width - phaseTooltip.offsetWidth - 4))}px`;
    phaseTooltip.style.top = `${Math.max(4, Math.min(tT, panelRect.height - phaseTooltip.offsetHeight - 4))}px`;
  });

  phaseCanvas.addEventListener('mouseleave', () => {
    phaseCanvas.style.cursor = '';
    phaseTooltip.classList.remove('visible');
  });

  phaseCanvas.addEventListener('click', (e: MouseEvent) => {
    if (state.view !== 'disp-wq') return;
    const hit = nearestGroupVelocityPointHit(e.offsetX, e.offsetY);
    if (!hit) return;
    selectedFieldPoint = makeFieldSelection(hit.m, hit.w, hit.q);
    phaseTooltip.classList.remove('visible');
    drawChart();
  });

  chartCanvasBox.addEventListener('mousemove', (e: MouseEvent) => {
    if (state.view === 'disp-wq' || state.view === 'disp-bV') {
      const hit = dispersionLegendHits.find(h => e.offsetX >= h.rect.x && e.offsetX <= h.rect.x + h.rect.w && e.offsetY >= h.rect.y && e.offsetY <= h.rect.y + h.rect.h);
      const pointHit = state.view === 'disp-wq' ? nearestDispersionPointHit(e.offsetX, e.offsetY) : null;
      chartCanvasBox.style.cursor = hit || pointHit ? 'pointer' : 'crosshair';
      if (pointHit) {
        const hover = makeFieldSelection(pointHit.m, pointHit.w, pointHit.q);
        const ctx = sizeOverlay();
        ctx.clearRect(0, 0, overlay.width, overlay.height);
        ctx.strokeStyle = 'rgba(17,24,39,0.85)';
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        ctx.arc(pointHit.x, pointHit.y, 6, 0, Math.PI * 2);
        ctx.stroke();
        const vg = groupVelocityForPoint(pointHit);
        const vgLine = Number.isFinite(vg) ? `<br>v_g/c = ${vg.toFixed(3)}` : '';
        tooltip.innerHTML = `${hover.modeLabel}<br>\u210F\u03C9 = ${pointHit.w.toFixed(3)} eV<br>q_z = ${pointHit.q.toFixed(5)} nm^-1${vgLine}`;
        tooltip.classList.add('visible');
        const wrapRect = chartCanvasBox.getBoundingClientRect();
        let tL = pointHit.x + 12;
        let tT = pointHit.y - 30;
        if (tL + tooltip.offsetWidth > wrapRect.width - 4) tL = pointHit.x - tooltip.offsetWidth - 12;
        if (tT < 4) tT = pointHit.y + 12;
        tooltip.style.left = `${Math.max(4, Math.min(tL, wrapRect.width - tooltip.offsetWidth - 4))}px`;
        tooltip.style.top = `${Math.max(4, Math.min(tT, wrapRect.height - tooltip.offsetHeight - 4))}px`;
      } else {
        clearOverlay();
      }
      return;
    }
    const supportsHover = state.view === 'cross-section' || state.view === 'eels-par' || state.view === 'eels-perp';
    if (!chartXforms || !supportsHover || !currentXArr.length || !currentSeries.length) return;
    const { m, pw, ph, invTx, xTo, yTo } = chartXforms;
    const mx = e.offsetX;
    const my = e.offsetY;
    if (mx < m.left || mx > m.left + pw || my < m.top || my > m.top + ph) {
      chartCanvasBox.style.cursor = '';
      clearOverlay();
      return;
    }
    chartCanvasBox.style.cursor = 'crosshair';
    const idx = nearestIdx(currentXArr, invTx(mx));
    const xVal = currentXArr[idx];
    const px = xTo(xVal);
    const ctx = sizeOverlay();
    ctx.clearRect(0, 0, overlay.width, overlay.height);
    ctx.strokeStyle = 'rgba(99,102,241,0.4)';
    ctx.setLineDash([4, 4]);
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(px, m.top);
    ctx.lineTo(px, m.top + ph);
    ctx.stroke();
    ctx.setLineDash([]);
    for (const s of currentSeries) {
      const yVal = s.y[idx];
      if (!Number.isFinite(yVal) || (state.logY && yVal <= 0)) continue;
      const py = yTo(yVal);
      ctx.fillStyle = s.color;
      ctx.beginPath();
      ctx.arc(px, py, 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(px, py, 4, 0, Math.PI * 2);
      ctx.stroke();
    }
    const xText = state.view === 'cross-section'
      ? (state.axisMode === 'lambda'
        ? `\u03BB = ${xVal.toFixed(1)} nm`
        : `E = ${xVal.toFixed(3)} eV`)
      : `E = ${xVal.toFixed(3)} eV`;
    let html = xText;
    for (const s of currentSeries) {
      const unitText = s.unit ? ` ${s.unit}` : '';
      html += `<br><span style="color:${s.color}">\u25CF</span> ${s.label} = ${fmtVal(s.y[idx])}${unitText}`;
    }
    tooltip.innerHTML = html;
    tooltip.classList.add('visible');
    const topPy = Math.min(...currentSeries.map(s => yTo(s.y[idx])).filter(Number.isFinite));
    let tL = px + 12;
    let tT = (Number.isFinite(topPy) ? topPy : m.top + ph / 2) - 36;
    const wrapRect = chartCanvasBox.getBoundingClientRect();
    if (currentLegendBox) {
      const proposed = { x: tL, y: tT, w: tooltip.offsetWidth, h: tooltip.offsetHeight };
      const overlaps = proposed.x < currentLegendBox.x + currentLegendBox.w
        && proposed.x + proposed.w > currentLegendBox.x
        && proposed.y < currentLegendBox.y + currentLegendBox.h
        && proposed.y + proposed.h > currentLegendBox.y;
      if (overlaps) tL = Math.max(4, currentLegendBox.x - tooltip.offsetWidth - 12);
    }
    if (tL + tooltip.offsetWidth > wrapRect.width - 4) tL = px - tooltip.offsetWidth - 12;
    if (tT < 4) tT = (Number.isFinite(topPy) ? topPy : m.top + ph / 2) + 12;
    tL = Math.max(4, Math.min(tL, wrapRect.width - tooltip.offsetWidth - 4));
    tT = Math.max(4, Math.min(tT, wrapRect.height - tooltip.offsetHeight - 4));
    tooltip.style.left = `${tL}px`;
    tooltip.style.top = `${tT}px`;
  });

  chartCanvasBox.addEventListener('mouseleave', () => {
    chartCanvasBox.style.cursor = '';
    clearOverlay();
  });

  chartCanvasBox.addEventListener('click', (e: MouseEvent) => {
    if (state.view !== 'disp-wq' && state.view !== 'disp-bV') return;
    if (state.view === 'disp-wq') {
      const pointHit = nearestDispersionPointHit(e.offsetX, e.offsetY);
      if (pointHit) {
        selectedFieldPoint = makeFieldSelection(pointHit.m, pointHit.w, pointHit.q);
        clearOverlay();
        drawChart();
        return;
      }
    }
    const hit = dispersionLegendHits.find(h => e.offsetX >= h.rect.x && e.offsetX <= h.rect.x + h.rect.w && e.offsetY >= h.rect.y && e.offsetY <= h.rect.y + h.rect.h);
    if (!hit) return;
    if (state.m_active.has(hit.m)) state.m_active.delete(hit.m);
    else state.m_active.add(hit.m);
    recompute();
  });

  function readDrudeInputs() {
    state.drude = {
      epsB: parseFloat(drudeInputs.epsB.value) || 1,
      wpEv: Math.max(0.01, parseFloat(drudeInputs.wpEv.value) || 5),
      gammaEv: Math.max(0, parseFloat(drudeInputs.gammaEv.value) || 0),
    };
  }

  function updateMaterialUI() {
    state.materialId = materialSelect.value;
    epsGroup.style.display = state.materialId === 'custom' ? '' : 'none';
    drudeGroup.style.display = state.materialId === 'drude' ? '' : 'none';
    if (state.materialId === 'custom') materialRef.textContent = 'Constant dielectric function';
    else if (state.materialId === 'drude') materialRef.textContent = `Drude model, ωp=${state.drude.wpEv.toFixed(2)} eV`;
    else materialRef.textContent = MATERIALS[state.materialId]?.ref ?? '';
  }

  const MAT_COLORS: Record<string, string> = {
    au: '#D4AF37',
    ag: '#B8C2CC',
    si: '#7C3AED',
    al: '#93C5FD',
    tio2: '#C084FC',
    drude: '#60A5FA',
    custom: '#34D399',
  };

  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]!));
  }

  function withSvgMarkerId(svg: string, markerId: string): string {
    return svg.replace('id="arr"', `id="${markerId}"`).replace(/url\(#arr\)/g, `url(#${markerId})`);
  }

  function materialLabel(): string {
    if (state.materialId === 'custom') return `custom \u03B5=${state.eps1_re.toFixed(1)}+${state.eps1_im.toFixed(2)}i`;
    if (state.materialId === 'drude') return `Drude \u03C9p=${state.drude.wpEv.toFixed(2)} eV`;
    return MATERIALS[state.materialId]?.label ?? state.materialId;
  }

  function updateConfigCheck() {
    const ct = chartTheme();
    const W = 340;
    const H = 152;
    const cx = 84;
    const cy = 72;
    const r = 42;
    const detailX = 202;
    const matColor = MAT_COLORS[state.materialId] ?? '#CBD5E1';
    const hostLabel = `\u03B5h = ${state.eps_h.toFixed(2)}`;
    const rangeLabel = state.excitation === 'plane'
      ? `${state.w_min.toFixed(1)}\u2013${state.w_max.toFixed(1)} eV`
      : `v/c = ${state.vFrac.toFixed(2)}`;
    const title = state.excitation === 'plane'
      ? 'normal plane wave'
      : state.view === 'eels-perp'
        ? 'perpendicular electron'
        : state.parallelGeometry === 'inside-hole'
          ? 'parallel electron · hole'
          : 'parallel electron · cylinder';
    let s = `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg">`;
    s += `<defs><marker id="arr" markerWidth="5" markerHeight="5" refX="4" refY="2.5" orient="auto"><path d="M0,0 L5,2.5 L0,5" fill="none" stroke="${ct.textMuted}" stroke-width="0.8"/></marker></defs>`;
    s += `<rect width="${W}" height="${H}" fill="${ct.grid}" rx="6"/>`;
    const insideHoleSketch = state.excitation === 'electron' && state.view === 'eels-par' && state.parallelGeometry === 'inside-hole';
    if (insideHoleSketch) {
      s += `<rect x="${cx - r - 8}" y="${cy - r - 8}" width="${2 * r + 16}" height="${2 * r + 16}" rx="8" fill="${matColor}" fill-opacity="0.82"/>`;
      s += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="${ct.grid}" stroke="${ct.text}" stroke-opacity="0.45" stroke-width="1.2"/>`;
    } else {
      s += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="${matColor}" fill-opacity="0.88" stroke="${ct.text}" stroke-opacity="0.35" stroke-width="1"/>`;
    }
    s += `<line x1="${cx}" y1="${cy + r + 10}" x2="${cx + r}" y2="${cy + r + 10}" stroke="${ct.textMuted}" stroke-width="0.8" marker-end="url(#arr)"/>`;
    s += `<line x1="${cx}" y1="${cy + r + 6}" x2="${cx}" y2="${cy + r + 14}" stroke="${ct.textMuted}" stroke-width="0.8"/>`;
    s += `<text x="${cx + r / 2}" y="${cy + r + 24}" text-anchor="middle" fill="${ct.textMuted}" font-size="8" font-family="Inter,system-ui">a=${state.a_nm.toFixed(0)} nm</text>`;
    if (state.excitation === 'plane') {
      // k (propagation) and E (polarization) share a common origin, with the
      // k arrow aligned to the cylinder's cross-section center (y = cy).
      const ox = 17;             // shared origin x
      const oy = cy;             // shared origin y — center of the cross section
      const kEndX = cx - r - 9;  // stop just left of the cylinder
      const eEndY = oy - 30;     // E points up
      // k: horizontal toward the cylinder, label below
      s += `<line x1="${ox}" y1="${oy}" x2="${kEndX}" y2="${oy}" stroke="#6366F1" stroke-width="2" stroke-linecap="round"/>`;
      s += `<path d="M${kEndX},${oy} l-7,-4 v8 z" fill="#6366F1"/>`;
      s += `<text x="${(ox + kEndX) / 2}" y="${oy + 13}" text-anchor="middle" fill="#6366F1" font-size="9" font-weight="700" font-family="Inter,system-ui">k</text>`;
      // E: vertical from the same origin, label to the right
      s += `<line x1="${ox}" y1="${oy}" x2="${ox}" y2="${eEndY}" stroke="#06B6D4" stroke-width="2" stroke-linecap="round"/>`;
      s += `<path d="M${ox},${eEndY} l-4,7 h8 z" fill="#06B6D4"/>`;
      s += `<text x="${ox + 6}" y="${(oy + eEndY) / 2 + 3}" fill="#06B6D4" font-size="9" font-weight="700" font-family="Inter,system-ui">E</text>`;
    } else {
      const ratio = state.b_nm / Math.max(state.a_nm, 1);
      const capped = Math.min(1.45, Math.max(0, ratio));
      const allowed = state.view === 'eels-perp'
        ? state.b_nm > state.a_nm
        : state.parallelGeometry === 'inside-hole'
          ? state.b_nm < state.a_nm
          : state.b_nm > state.a_nm;
      const pathColor = allowed ? '#2563EB' : '#DC2626';
      const radiusDot = state.view === 'eels-perp'
        ? { x: cx, y: cy - r }
        : { x: cx + r, y: cy };
      if (state.view === 'eels-perp') {
        const trajY = cy - capped * r;
        const x2 = cx + r + 36;
        s += `<line x1="14" y1="${trajY}" x2="${x2 - 7}" y2="${trajY}" stroke="${pathColor}" stroke-width="2" stroke-linecap="round"/>`;
        s += `<path d="M${x2},${trajY} l-8,-5 v10 z" fill="${pathColor}"/>`;
        s += `<circle cx="${cx}" cy="${trajY}" r="3.5" fill="#EF4444" stroke="#fff" stroke-width="1"/>`;
        s += `<text x="16" y="${trajY + 16}" fill="${pathColor}" font-size="9" font-weight="700" font-family="Inter,system-ui">e<tspan baseline-shift="super" font-size="7">-</tspan></text>`;
        s += `<text x="${cx + 6}" y="${trajY + 12}" fill="${pathColor}" font-size="8" font-family="Inter,system-ui">b=${state.b_nm.toFixed(0)} nm</text>`;
      } else {
        const trajX = cx + capped * r;
        s += `<circle cx="${trajX}" cy="${cy}" r="6.5" fill="none" stroke="${pathColor}" stroke-width="1.4" stroke-opacity="0.65"/>`;
        s += `<circle cx="${trajX}" cy="${cy}" r="3.5" fill="#EF4444" stroke="#fff" stroke-width="1"/>`;
        s += `<text x="${trajX + 9}" y="${cy - 9}" fill="${pathColor}" font-size="9" font-weight="700" font-family="Inter,system-ui">e<tspan baseline-shift="super" font-size="7">-</tspan></text>`;
        s += `<text x="${trajX + 9}" y="${cy + 9}" fill="${pathColor}" font-size="8" font-family="Inter,system-ui">b=${state.b_nm.toFixed(0)} nm</text>`;
      }
      s += `<circle cx="${radiusDot.x}" cy="${radiusDot.y}" r="3.5" fill="#EF4444" stroke="#fff" stroke-width="1"/>`;
    }
    s += `<text x="${detailX}" y="28" fill="${ct.text}" font-size="10" font-weight="700" font-family="Inter,system-ui">${escapeHtml(title)}</text>`;
    s += `<text x="${detailX}" y="48" fill="${ct.textSoft}" font-size="9" font-family="Inter,system-ui">${escapeHtml(materialLabel())}</text>`;
    s += `<text x="${detailX}" y="67" fill="${ct.textMuted}" font-size="8.5" font-family="Inter,system-ui">${escapeHtml(hostLabel)}</text>`;
    s += `<text x="${detailX}" y="85" fill="${ct.textMuted}" font-size="8.5" font-family="Inter,system-ui">${escapeHtml(rangeLabel)}</text>`;
    s += `<text x="${W - 10}" y="${H - 10}" text-anchor="end" fill="${ct.textMuted}" font-size="8" font-family="Inter,system-ui">infinite cylinder</text>`;
    s += '</svg>';
    configCheckEl.innerHTML = withSvgMarkerId(s, 'cylinder-config-radius-arrow');
    structureDialogArt.innerHTML = withSvgMarkerId(s, 'cylinder-config-radius-arrow-modal');
  }

  configCheckEl.addEventListener('click', () => {
    updateConfigCheck();
    if (typeof structureDialog.showModal === 'function') structureDialog.showModal();
    else structureDialog.setAttribute('open', '');
  });
  structureDialogClose.addEventListener('click', () => structureDialog.close());
  structureDialog.addEventListener('click', (e: MouseEvent) => {
