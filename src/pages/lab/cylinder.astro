    ctx.translate(8, py + plotSize / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText(`y: ${(-limNm).toFixed(0)} ... ${limNm.toFixed(0)} nm`, 0, 0);
    ctx.restore();
  }

