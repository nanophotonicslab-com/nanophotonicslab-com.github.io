  function nearestIdx(xs: number[], xVal: number): number {
    let lo = 0;
    let hi = xs.length - 1;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      if (xs[mid] < xVal) lo = mid + 1;
      else hi = mid;
    }
    if (lo > 0 && Math.abs(xs[lo - 1] - xVal) < Math.abs(xs[lo] - xVal)) lo--;
    return lo;
  }

  function fmtVal(v: number): string {
    const a = Math.abs(v);
    if (a === 0) return '0';
    if (a >= 1e5) return v.toLocaleString('en', { maximumFractionDigits: 0 });
    if (a >= 1) return v.toLocaleString('en', { maximumFractionDigits: 2 });
    if (a >= 0.01) return v.toFixed(4);
    return v.toExponential(2);
  }

  function syncKeVFromBeta(): void {
