---
import Layout from '../../layouts/Layout.astro';
import ModelInfo from '../../components/ModelInfo.astro';
import PresetStrip from '../../components/PresetStrip.astro';
import ToolMeta from '../../components/ToolMeta.astro';

const cylPresets = [
  { label: 'Ag in air', values: { 'material-select': 'ag', 'r-num': 15, 'r-slider': 15, 'eh-num': 1.00, 'eh-slider': 1.00, 'w-min': 0.2, 'w-max': 4 } },
  { label: 'Au in water', values: { 'material-select': 'au', 'r-num': 25, 'r-slider': 25, 'eh-num': 1.77, 'eh-slider': 1.77, 'w-min': 0.5, 'w-max': 4 } },
  { label: 'Si in air', values: { 'material-select': 'si', 'r-num': 50, 'r-slider': 50, 'eh-num': 1.00, 'eh-slider': 1.00, 'w-min': 1, 'w-max': 5 } },
];
---

<Layout title="Cylinder Scattering" description="Plane-wave scattering and electron-loss spectroscopy for infinite cylinders, solved in the browser.">
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Cylinder <span class="gradient-text">Scattering</span></h1>
      <p class="widget-hero__subtitle">
        Compare normally incident plane-wave scattering with electron energy-loss
        spectra for an infinite cylinder in a homogeneous host. Materials use the
        same optical-constants pipeline as the Mie lab.
      </p>
      <ToolMeta slug="cylinder" name="Cylinder Scattering" />
    </div>
  </section>

  <ModelInfo status="Beta">
    <dl>
      <dt>Model</dt>
      <dd>Exact electromagnetic boundary matching for an infinite circular cylinder. Plane-wave scattering uses the classical Mie-type series; EELS uses the non-retarded dielectric formalism.</dd>
      <dt>Assumptions</dt>
      <dd>Infinite cylinder length, circular cross-section, isotropic and local dielectric functions, homogeneous host medium.</dd>
      <dt>Validity</dt>
      <dd>Exact for plane-wave scattering at any cylinder radius. EELS results are non-retarded — accurate for sub-wavelength cylinders and moderate electron energies.</dd>
      <dt>Limitations</dt>
      <dd>No finite-length effects, no substrate, no non-local corrections. Tabulated optical constants limit the spectral range to available data.</dd>
      <dt>References</dt>
      <dd>Bohren &amp; Huffman (1983), Chapter 8; F. J. García de Abajo, Rev. Mod. Phys. <strong>82</strong>, 209 (2010).</dd>
    </dl>
  </ModelInfo>

  <section class="section">
    <div class="container">
      <div class="excitation-bar">
        <div class="param excitation-param excitation-above">
          <div class="param-header"><label>Excitation</label></div>
          <div class="view-tabs" id="excitation-tabs" role="radiogroup">
            <button class="view-tab active" data-excitation="plane" role="radio" aria-checked="true">Plane wave</button>
            <button class="view-tab" data-excitation="electron" role="radio" aria-checked="false">Electrons</button>
          </div>
        </div>
      </div>
      <div class="widget-layout">
        <!-- ===== Controls ===== -->
        <div class="controls card">
          <h3>Parameters</h3>

          <div class="param">
            <div class="param-header">
              <label>Radius a (nm)</label>
              <input type="number" class="param-number" id="r-num" value="15" step="1" min="1" max="200">
            </div>
            <div class="slider-marker-wrap">
              <input type="range" class="param-slider" id="r-slider" aria-label="Radius a (nm)" min="2" max="100" step="1" value="15">
              <span class="threshold-marker" id="radius-impact-marker" title="Impact parameter b"></span>
            </div>
          </div>

          <div class="param">
            <div class="param-header">
              <label>&epsilon;<sub>h</sub> (host)</label>
              <input type="number" class="param-number" id="eh-num" value="1.00" step="0.01" min="1">
            </div>
            <input type="range" class="param-slider" id="eh-slider" aria-label="Host permittivity εh" min="1" max="4" step="0.01" value="1">
            <div class="param-presets" id="eh-presets">
              <button class="preset-btn active" data-val="1.00">Air</button>
              <button class="preset-btn" data-val="1.77">Water</button>
              <button class="preset-btn" data-val="2.25">Glass</button>
            </div>
          </div>

          <div class="param">
            <div class="param-header"><label>Material</label></div>
            <select id="material-select" class="param-select">
              <option value="custom">Custom dielectric</option>
              <option value="drude">Drude model</option>
              <option value="au">Gold (Au)</option>
              <option value="ag" selected>Silver (Ag)</option>
              <option value="si">Silicon (Si)</option>
              <option value="al">Aluminum (Al)</option>
              <option value="tio2">TiO₂</option>
            </select>
            <span class="material-ref" id="material-ref"></span>
          </div>

          <div class="param drude-panel" id="drude-group" style="display:none">
            <span class="drude-formula">&epsilon; = &epsilon;<sub>b</sub> - &omega;<sub>p</sub><sup>2</sup> / [&omega;(&omega; + i&gamma;)]</span>
            <div class="drude-grid">
              <label>
                <span>&epsilon;<sub>b</sub></span>
                <input type="number" class="param-number" id="drude-epsb" value="1" step="0.1">
              </label>
              <label>
                <span>&omega;<sub>p</sub> (eV)</span>
                <input type="number" class="param-number" id="drude-wp" value="5" step="0.01" min="0.01">
              </label>
              <label>
                <span>&gamma; (eV)</span>
                <input type="number" class="param-number" id="drude-gamma" value="0.05" step="0.001" min="0">
              </label>
            </div>
          </div>

          <div class="param custom-epsilon" id="eps-group" style="display:none">
            <div class="param-header">
              <label>Re(&epsilon;<sub>1</sub>)</label>
              <input type="number" class="param-number" id="e1r-num" value="10.0" step="0.1" min="1">
            </div>
            <input type="range" class="param-slider" id="e1r-slider" aria-label="Real part of permittivity Re(ε₁)" min="1" max="30" step="0.1" value="10">
            <div class="param-header">
              <label>Im(&epsilon;<sub>1</sub>)</label>
              <input type="number" class="param-number" id="e1i-num" value="0.10" step="0.01" min="0">
            </div>
            <input type="range" class="param-slider" id="e1i-slider" aria-label="Imaginary part of permittivity Im(ε₁)" min="0" max="2" step="0.01" value="0.1">
          </div>

          <div class="param">
            <div class="param-header"><label>&hbar;&omega; range (eV)</label></div>
            <div class="param-range-row">
              <input type="number" class="param-number param-number--sm" id="w-min" value="0.2" step="0.1" min="0">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-number param-number--sm" id="w-max" value="4" step="0.1" min="0.1">
            </div>
          </div>

          <details class="eels-section electron-only" id="eels-section" style="display:none" open>
            <summary>EELS parameters</summary>
            <div class="param">
              <div class="param-header">
                <label>Impact b (nm)</label>
                <input type="number" class="param-number" id="b-num" value="25" step="1" min="0">
              </div>
              <div class="slider-marker-wrap">
                <input type="range" class="param-slider" id="b-slider" aria-label="Impact parameter b (nm)" min="0" max="100" step="0.5" value="25">
                <span class="threshold-marker" id="impact-radius-marker" title="Cylinder radius a"></span>
              </div>
              <span class="param-note" id="b-note">outside the cylinder</span>
            </div>
            <div class="param" id="parallel-geometry-param">
              <div class="param-header"><label>Parallel geometry</label></div>
              <div class="view-tabs" id="parallel-geometry-tabs" role="radiogroup">
                <button class="view-tab active" data-parallel-geometry="outside" role="radio" aria-checked="true">Outside cylinder</button>
                <button class="view-tab" data-parallel-geometry="inside-hole" role="radio" aria-checked="false">Inside hole</button>
              </div>
            </div>
            <div class="param">
              <div class="param-header"><label>Electron</label></div>
              <div class="param-dual-row">
                <label>
                  <span>v / c</span>
                  <input type="number" class="param-number" id="v-num" value="0.3" step="0.01" min="0.01" max="0.99">
                </label>
                <label>
                  <span>K (keV)</span>
                  <input type="number" class="param-number" id="kev-num" value="24.7" step="0.1" min="0.001">
                </label>
              </div>
              <input type="range" class="param-slider" id="v-slider" aria-label="Electron speed v/c" min="0.05" max="0.99" step="0.01" value="0.3">
              <div class="param-presets" id="v-presets">
                <button class="preset-btn" data-val="0.328">30&thinsp;keV</button>
                <button class="preset-btn" data-val="0.55">100&thinsp;keV</button>
                <button class="preset-btn" data-val="0.70">200&thinsp;keV</button>
              </div>
            </div>
            <div class="param">
              <div class="param-header">
                <label>Max |m|</label>
                <input type="number" class="param-number" id="Mmax-num" value="4" step="1" min="0" max="10">
              </div>
            </div>
          </details>

          <button id="reset-btn" class="reset-btn" title="Reset all parameters">Reset defaults</button>

          <button type="button" class="config-check" id="config-check" aria-haspopup="dialog" aria-controls="structure-dialog" title="Open structure drawing"></button>
        </div>

        <!-- ===== Results ===== -->
        <div class="results-col">
        <!-- ===== Chart ===== -->
        <div class="chart-panel card">
          <div class="chart-toolbar">
            <div class="view-tabs" id="view-tabs" role="radiogroup">
              <button class="view-tab active" data-view="cross-section" data-source="plane" role="radio" aria-checked="true">
                Cross sections
              </button>
              <button class="view-tab" data-view="angular" data-source="plane" role="radio" aria-checked="false">
                Angular
              </button>
              <button class="view-tab" data-view="eels-par" data-source="electron" role="radio" aria-checked="false" style="display:none">
                EELS ∥
              </button>
              <button class="view-tab" data-view="eels-perp" data-source="electron" role="radio" aria-checked="false" style="display:none">
                EELS ⊥
              </button>
              <button class="view-tab" data-view="disp-wq" data-source="electron" role="radio" aria-checked="false" style="display:none">
                &hbar;&omega;&ndash;q<sub>z</sub>
              </button>
              <button class="view-tab" data-view="disp-bV" data-source="electron" role="radio" aria-checked="false" style="display:none">
                b&ndash;V
              </button>
            </div>
            <button id="perp-compute-btn" class="chart-tool-btn chart-tool-btn--primary" type="button" title="Compute perpendicular EELS" style="display:none">Compute</button>
            <label id="perp-grid-control" class="toolbar-control toolbar-control--compact" style="display:none">
              <span class="toolbar-label">Grid</span>
              <select id="perp-grid-select" class="toolbar-select" title="Perpendicular EELS integration grid">
                <option value="standard" selected>Standard</option>
                <option value="fine">Fine</option>
                <option value="high">High</option>
              </select>
            </label>
            <button id="log-toggle" class="chart-tool-btn" title="Toggle logarithmic Y axis">Log Y</button>
            <div class="spectrum-controls" id="spectrum-controls">
              <div class="toolbar-control">
                <span class="toolbar-label">Components</span>
                <div class="view-tabs view-tabs--toolbar" id="quantity-tabs" role="radiogroup">
                  <button class="view-tab active" data-qty="csca" role="radio" aria-checked="true">C<sub>sca</sub></button>
                  <button class="view-tab" data-qty="cext" role="radio" aria-checked="false">C<sub>ext</sub></button>
                  <button class="view-tab" data-qty="cabs" role="radio" aria-checked="false">C<sub>abs</sub></button>
                  <button class="view-tab" data-qty="qsca" role="radio" aria-checked="false">Q<sub>sca</sub></button>
                  <button class="view-tab" data-qty="all" role="radio" aria-checked="false">All</button>
                </div>
              </div>
              <div class="toolbar-control">
                <span class="toolbar-label">Breakdown</span>
                <div class="view-tabs view-tabs--toolbar" id="decomp-tabs" role="radiogroup">
                  <button class="view-tab active" data-decomp="total" role="radio" aria-checked="true">Total</button>
                  <button class="view-tab" data-decomp="em" role="radio" aria-checked="false">E / M</button>
                </div>
              </div>
            </div>
            <span id="angular-controls" class="angular-controls" style="display:none">
              <button type="button" class="angle-axis-switch" id="angle-axis-switch" role="switch" aria-checked="false" title="Switch between energy and wavelength">
                <span class="angle-axis-switch__opt active" data-opt="energy">E</span>
                <span class="angle-axis-switch__opt" data-opt="lambda">&lambda;</span>
              </button>
              <label class="angular-label" id="angle-axis-label">E =</label>
              <input type="number" class="param-number param-number--sm" id="angle-energy-num" value="2.4" step="0.1" min="0.1">
              <span class="angular-label" id="angle-axis-unit">eV</span>
            </span>
            <span id="compute-status" class="compute-status"></span>
          </div>
          <div id="angular-pol-wrap" class="angular-pol-wrap" style="display:none">
            <div class="view-tabs" id="pol-tabs" role="radiogroup">
              <button class="view-tab active" data-pol="total" role="radio" aria-checked="true">Unpolarized</button>
              <button class="view-tab" data-pol="perp" role="radio" aria-checked="false">&perp;</button>
              <button class="view-tab" data-pol="par" role="radio" aria-checked="false">&#x2016;</button>
            </div>
          </div>
          <div class="chart-wrap" id="chart-wrap">
            <div class="dispersion-plot-panel" id="dispersion-plot-panel">
              <div class="plot-panel-toolbar" id="dispersion-plot-toolbar" style="display:none">
                <button type="button" class="plot-panel-title plot-panel-title--btn" id="disp-expand-btn" title="Open full-width view of the dispersion relation and group velocity">
                  Dispersion relation
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
                </button>
              </div>
              <div class="chart-canvas-box" id="chart-canvas-box">
                <canvas id="cyl-chart" aria-label="Cylinder dispersion or EELS chart"></canvas>
                <canvas id="chart-overlay" aria-hidden="true"></canvas>
                <div class="axis-overlay" id="axis-overlay">
                  <div class="view-tabs view-tabs--toolbar" id="axis-tabs" role="radiogroup" aria-label="X axis">
                    <button class="view-tab active" data-axis="lambda" role="radio" aria-checked="true">&lambda; (nm)</button>
                    <button class="view-tab" data-axis="energy" role="radio" aria-checked="false">&hbar;&omega; (eV)</button>
                  </div>
                </div>
                <div class="chart-tooltip" id="chart-tooltip"></div>
              </div>
            </div>
            <div class="phase-plot-panel" id="phase-plot-panel" style="display:none">
              <div class="plot-panel-toolbar">
                <span class="plot-panel-title">Group velocity</span>
                <div class="view-tabs view-tabs--toolbar" id="phase-axis-tabs" role="radiogroup" aria-label="Group velocity vertical axis">
                  <button class="view-tab active" data-phase-axis="q" role="radio" aria-checked="true">q<sub>z</sub></button>
                  <button class="view-tab" data-phase-axis="energy" role="radio" aria-checked="false">&hbar;&omega;</button>
                </div>
              </div>
              <canvas id="phase-chart" aria-label="Cylinder guided-mode group velocity chart"></canvas>
              <div class="chart-tooltip" id="phase-tooltip"></div>
            </div>
          </div>
          <input type="range" class="param-slider angular-slider" id="angle-energy-slider" aria-label="Photon energy ℏω (eV)" min="0.5" max="6" step="0.05" value="2.4" style="display:none">
          <div class="chart-legend" id="chart-legend" style="display:none"></div>
          <div class="download-bar">
            <span class="download-label">Export</span>
            <button id="dl-png" class="dl-btn" title="Download chart as PNG" data-umami-event="cylinder-export" data-umami-event-format="png">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              PNG
            </button>
            <button id="dl-csv" class="dl-btn" title="Download data as CSV" data-umami-event="cylinder-export" data-umami-event-format="csv">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
              CSV
            </button>
            <button id="share-btn" class="dl-btn" title="Copy shareable link" data-umami-event="share" data-umami-event-page="cylinder">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              Share
            </button>
          </div>
          <div class="perp-map-panel" id="perp-map-panel" style="display:none">
            <div class="perp-map-toolbar">
              <span class="perp-map-title">Momentum-resolved EELS</span>
              <button type="button" id="map-dl-png" class="chart-tool-btn" title="Download momentum-resolved EELS as PNG">PNG</button>
              <button type="button" id="map-log-toggle" class="chart-tool-btn" title="Toggle log10 color scale">Log10 color</button>
              <button type="button" id="map-light-toggle" class="chart-tool-btn active" title="Show host light line">Light line</button>
              <button type="button" id="map-electron-toggle" class="chart-tool-btn active" title="Show electron line">Electron line</button>
              <button type="button" id="map-custom-toggle" class="chart-tool-btn" title="Show custom line">Custom line</button>
              <label class="map-inline-control">slope v/c
                <input type="number" class="param-number param-number--sm" id="custom-slope-num" value="0.30" step="0.01" min="0.001">
              </label>
            </div>
            <div class="perp-map-wrap" id="perp-map-wrap">
              <canvas id="perp-map-canvas" aria-label="Perpendicular cylinder momentum-resolved EELS map"></canvas>
            </div>
            <div class="perp-map-footer">
              <label class="map-inline-control">q<sub>max</sub>
                <input type="number" class="param-number param-number--sm" id="qz-max-num" value="0.1" step="0.01" min="0.02">
              </label>
            </div>
          </div>
          <div class="field-profile-panel" id="field-profile-panel" style="display:none">
            <div class="field-profile-toolbar">
              <div>
                <button type="button" class="field-profile-title field-profile-title--btn" id="field-profile-title" title="Open full-width view of all field profiles">Mode field profile</button>
                <span class="field-profile-meta" id="field-profile-meta">Select a point in the dispersion map</span>
              </div>
              <div class="field-profile-actions">
                <button type="button" id="field-normalized-toggle" class="chart-tool-btn" title="Normalize each field panel to its own range">Normalized</button>
                <button type="button" id="field-log-toggle" class="chart-tool-btn" title="Toggle log10 scale for |E|">Log10 |E|</button>
              </div>
            </div>
            <div class="field-profile-body" id="field-profile-body">
              <div class="field-profile-grid">
                <div class="field-tile">
                  <div class="field-tile__header">
                    <span class="field-tile__label" id="field-ex-label">Re E<sub>x</sub></span>
                    <div class="field-component-toggle" role="radiogroup" aria-label="E x component">
                      <button type="button" class="field-mode-btn active" data-field-component="ex" data-field-part="re" aria-checked="true">Re</button>
                      <button type="button" class="field-mode-btn" data-field-component="ex" data-field-part="im" aria-checked="false">Im</button>
                    </div>
                  </div>
                  <canvas id="field-ex-canvas" aria-label="Selected mode Re Ex field"></canvas>
                </div>
                <div class="field-tile">
                  <div class="field-tile__header">
                    <span class="field-tile__label" id="field-ey-label">Re E<sub>y</sub></span>
                    <div class="field-component-toggle" role="radiogroup" aria-label="E y component">
                      <button type="button" class="field-mode-btn active" data-field-component="ey" data-field-part="re" aria-checked="true">Re</button>
                      <button type="button" class="field-mode-btn" data-field-component="ey" data-field-part="im" aria-checked="false">Im</button>
                    </div>
                  </div>
                  <canvas id="field-ey-canvas" aria-label="Selected mode Re Ey field"></canvas>
                </div>
                <div class="field-tile">
                  <div class="field-tile__header">
                    <span class="field-tile__label" id="field-ez-label">Re E<sub>z</sub></span>
                    <div class="field-component-toggle" role="radiogroup" aria-label="E z component">
                      <button type="button" class="field-mode-btn active" data-field-component="ez" data-field-part="re" aria-checked="true">Re</button>
                      <button type="button" class="field-mode-btn" data-field-component="ez" data-field-part="im" aria-checked="false">Im</button>
                    </div>
                  </div>
                  <canvas id="field-ez-canvas" aria-label="Selected mode Re Ez field"></canvas>
                </div>
                <div class="field-tile">
                  <div class="field-tile__header">
                    <span class="field-tile__label" id="field-mag-label">|E|</span>
                  </div>
                  <canvas id="field-mag-canvas" aria-label="Selected mode electric-field magnitude"></canvas>
                </div>
              </div>
              <div class="field-colorbar-rail" id="field-colorbar-rail">
                <canvas id="field-colorbar-canvas" aria-label="Selected mode field color scale"></canvas>
              </div>
            </div>
            <div class="download-bar field-export-bar">
              <span class="download-label">Export fields</span>
              <button id="field-dl-png" class="dl-btn" title="Download selected fields as PNG" data-umami-event="cylinder-field-export" data-umami-event-format="png">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                PNG
              </button>
              <button id="field-dl-csv" class="dl-btn" title="Download selected field data as CSV" data-umami-event="cylinder-field-export" data-umami-event-format="csv">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                CSV
              </button>
              <button id="field-share-btn" class="dl-btn" title="Copy shareable link" data-umami-event="share" data-umami-event-page="cylinder-fields">
