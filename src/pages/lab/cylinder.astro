---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Cylinder Dispersion" description="Guided-mode dispersion of an infinite dielectric cylinder: ω(q_z) branches from exact electromagnetic matching, solved in the browser.">
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Cylinder <span class="gradient-text">Dispersion</span></h1>
      <p class="widget-hero__subtitle">
        Guided-mode dispersion ω(q<sub>z</sub>) of an infinite cylinder in a
        homogeneous host. Roots are found from det&nbsp;M(qa, ka, ε₁, ε<sub>h</sub>, m)&nbsp;=&nbsp;0
        with exact complex-argument Bessel functions.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="widget-layout">
        <!-- ===== Controls ===== -->
        <div class="controls card">
          <h3>Parameters</h3>

          <div class="param">
            <div class="param-header">
              <label>Radius a (nm)</label>
              <input type="number" class="param-number" id="r-num" value="15" step="1" min="1" max="200">
            </div>
            <input type="range" class="param-slider" id="r-slider" min="2" max="100" step="1" value="15">
          </div>

          <div class="param">
            <div class="param-header">
              <label>&epsilon;<sub>h</sub> (host)</label>
              <input type="number" class="param-number" id="eh-num" value="1.00" step="0.01" min="1">
            </div>
            <input type="range" class="param-slider" id="eh-slider" min="1" max="4" step="0.01" value="1">
            <div class="param-presets" id="eh-presets">
              <button class="preset-btn active" data-val="1.00">Air</button>
              <button class="preset-btn" data-val="1.77">Water</button>
              <button class="preset-btn" data-val="2.25">Glass</button>
            </div>
          </div>

          <div class="param">
            <div class="param-header">
              <label>Re(&epsilon;<sub>1</sub>)</label>
              <input type="number" class="param-number" id="e1r-num" value="10.0" step="0.1" min="1">
            </div>
            <input type="range" class="param-slider" id="e1r-slider" min="1" max="30" step="0.1" value="10">
          </div>

          <div class="param">
            <div class="param-header">
              <label>Im(&epsilon;<sub>1</sub>)</label>
              <input type="number" class="param-number" id="e1i-num" value="0.10" step="0.01" min="0">
            </div>
            <input type="range" class="param-slider" id="e1i-slider" min="0" max="2" step="0.01" value="0.1">
          </div>

          <div class="param">
            <div class="param-header"><label>&omega; range (eV)</label></div>
            <div class="param-range-row">
              <input type="number" class="param-number param-number--sm" id="w-min" value="1" step="0.5" min="0">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-number param-number--sm" id="w-max" value="20" step="0.5" min="0.1">
            </div>
          </div>

          <div class="param">
            <div class="param-header"><label>Angular orders m</label></div>
            <div class="m-chips" id="m-chips">
              <button class="m-chip active" data-m="0">0</button>
              <button class="m-chip active" data-m="1">1</button>
              <button class="m-chip active" data-m="2">2</button>
              <button class="m-chip" data-m="3">3</button>
            </div>
          </div>

          <details class="eels-section" id="eels-section">
            <summary>EELS parameters</summary>
            <div class="param">
              <div class="param-header">
                <label>Impact b (nm)</label>
                <input type="number" class="param-number" id="b-num" value="25" step="1" min="0">
              </div>
              <input type="range" class="param-slider" id="b-slider" min="0" max="100" step="0.5" value="25">
              <span class="param-note" id="b-note">outside the cylinder</span>
            </div>
            <div class="param">
              <div class="param-header">
                <label>Electron v / c</label>
                <input type="number" class="param-number" id="v-num" value="0.3" step="0.01" min="0.01" max="0.99">
              </div>
              <input type="range" class="param-slider" id="v-slider" min="0.05" max="0.99" step="0.01" value="0.3">
              <div class="param-presets" id="v-presets">
                <button class="preset-btn" data-val="0.3">slow</button>
                <button class="preset-btn" data-val="0.55">100&thinsp;keV</button>
                <button class="preset-btn" data-val="0.70">200&thinsp;keV</button>
                <button class="preset-btn" data-val="0.78">300&thinsp;keV</button>
              </div>
            </div>
            <div class="param">
              <div class="param-header">
                <label>Max |m| (EELS)</label>
                <input type="number" class="param-number" id="Mmax-num" value="4" step="1" min="0" max="10">
              </div>
            </div>
          </details>

          <button id="reset-btn" class="reset-btn" title="Reset all parameters">Reset defaults</button>

          <p class="theory-note">
            <strong>Model.</strong>
            Tangential <b>E</b>, <b>H</b> matching at r&nbsp;=&nbsp;a gives a 4×4
            system. Guided modes satisfy det&nbsp;M&nbsp;=&nbsp;0 inside the
            window k<sub>h</sub>&nbsp;&lt;&nbsp;q&nbsp;&lt;&nbsp;k<sub>mat</sub>.
            A small Im(ε₁) regularizes the search.
          </p>
        </div>

        <!-- ===== Chart ===== -->
        <div class="chart-panel card">
          <div class="chart-toolbar">
            <div class="view-tabs" id="view-tabs" role="radiogroup">
              <button class="view-tab active" data-view="disp-wq" role="radio" aria-checked="true">
                &omega;&ndash;q<sub>z</sub>
              </button>
              <button class="view-tab" data-view="disp-bV" role="radio" aria-checked="false">
                b&ndash;V
              </button>
              <button class="view-tab" data-view="eels-par" role="radio" aria-checked="false">
                EELS ∥
              </button>
              <button class="view-tab" data-view="eels-perp" role="radio" aria-checked="false">
                EELS ⊥
              </button>
            </div>
            <span id="compute-status" class="compute-status"></span>
          </div>
          <div class="chart-wrap" id="chart-wrap">
            <canvas id="cyl-chart" aria-label="Cylinder dispersion or EELS chart"></canvas>
          </div>
          <div class="chart-legend" id="chart-legend"></div>
        </div>
      </div>

      <div class="references card">
        <h4>References</h4>
        <ul>
          <li>C. F. Bohren &amp; D. R. Huffman, <em>Absorption and Scattering of Light by Small Particles</em> (Wiley, 1983), §8 — infinite cylinder expansion.</li>
          <li>Abramowitz &amp; Stegun, §9.1.11 — integer-order Y<sub>m</sub> series used to compute complex-argument Bessel functions in the browser.</li>
          <li>Internal port of Álvaro Rodríguez Echarri's MATLAB <code>cylinders</code> library (matrix <code>giveM</code>, dispersion root solver).</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .widget-hero { padding: calc(var(--space-3xl) + var(--space-lg)) 0 var(--space-xl); background: var(--bg-soft); }
  .widget-hero h1 { margin-bottom: var(--space-sm); }
  .widget-hero__subtitle { font-size: 1.125rem; max-width: 640px; }
  .gradient-text { background: var(--spectrum); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .back-link { display: inline-block; margin-bottom: var(--space-md); font-size: 0.875rem; font-weight: 500; color: var(--text-soft); }
  .back-link:hover { color: var(--primary); }

  .widget-layout { display: grid; grid-template-columns: 300px 1fr; gap: var(--space-lg); align-items: start; }
  .controls {
    display: flex; flex-direction: column; gap: var(--space-md);
    position: sticky; top: calc(var(--nav-height) + var(--lab-bar-height) + var(--space-lg));
  }
  .controls h3 { font-size: 1rem; }

  .param { display: flex; flex-direction: column; gap: 0.4rem; }
  .param-header { display: flex; justify-content: space-between; align-items: center; }
  .param-header label { font-size: 0.875rem; font-weight: 500; color: var(--text); }
  .param-number {
    width: 5rem; padding: 0.2rem 0.4rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm);
    font-family: var(--font); font-size: 0.875rem; font-weight: 600; font-variant-numeric: tabular-nums;
    color: var(--primary); text-align: right; outline: none; background: var(--bg);
  }
  .param-number::-webkit-inner-spin-button,
  .param-number::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .param-number { -moz-appearance: textfield; }
  .param-number--sm { width: 4.2rem; font-size: 0.8125rem; }
  .param-range-row { display: flex; align-items: center; gap: 0.35rem; }
  .param-limit-dash { color: var(--bg-muted); font-size: 0.75rem; }

  .param-slider {
    -webkit-appearance: none; appearance: none; width: 100%; height: 6px;
    background: var(--bg-muted); border-radius: 3px; outline: none; cursor: pointer;
  }
  .param-slider::-webkit-slider-thumb {
    -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%;
    background: var(--primary); cursor: pointer; transition: box-shadow 0.15s;
  }
  .param-slider::-webkit-slider-thumb:hover { box-shadow: 0 0 0 5px rgba(99,102,241,0.15); }
  .param-slider::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--primary); border: none; cursor: pointer; }

  .param-presets { display: flex; gap: var(--space-xs); flex-wrap: wrap; }
  .preset-btn {
    padding: 0.2rem 0.55rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-full);
    background: var(--bg); font-family: var(--font); font-size: 0.6875rem; font-weight: 500;
    color: var(--text-muted); cursor: pointer; transition: all 0.15s;
  }
  .preset-btn:hover { border-color: var(--primary-light); color: var(--primary); }
  .preset-btn.active { border-color: var(--primary); background: rgba(99,102,241,0.06); color: var(--primary); }

  .m-chips { display: flex; gap: 0.35rem; }
  .m-chip {
    flex: 1; padding: 0.4rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm);
    background: var(--bg); font-family: var(--font); font-size: 0.8125rem; font-weight: 700;
    font-variant-numeric: tabular-nums; color: var(--text-muted); cursor: pointer; transition: all 0.15s;
  }
  .m-chip:hover { border-color: var(--primary-light); color: var(--primary); }
  .m-chip.active { color: white; border-color: transparent; }
  .m-chip[data-m="0"].active { background: #6366F1; }
  .m-chip[data-m="1"].active { background: #06B6D4; }
  .m-chip[data-m="2"].active { background: #10B981; }
  .m-chip[data-m="3"].active { background: #F59E0B; }

  .reset-btn {
    width: 100%; padding: 0.4rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-full);
    background: var(--bg); font-family: var(--font); font-size: 0.8125rem; font-weight: 500;
    color: var(--text-muted); cursor: pointer; transition: all 0.15s;
  }
  .reset-btn:hover { border-color: var(--rose); color: var(--rose); }

  /* EELS subsection */
  .eels-section {
    border-top: 1px solid var(--bg-muted); padding-top: var(--space-xs); margin-top: var(--space-xs);
    display: flex; flex-direction: column; gap: 0.4rem;
  }
  .eels-section summary {
    font-size: 0.8125rem; font-weight: 600; color: var(--text-soft);
    text-transform: uppercase; letter-spacing: 0.04em; cursor: pointer;
    padding: 0.25rem 0; user-select: none; list-style: none;
    display: flex; align-items: center; gap: 0.4rem;
  }
  .eels-section summary::before {
    content: '\25B6'; font-size: 0.5rem; transition: transform 0.15s;
  }
  .eels-section[open] summary::before { transform: rotate(90deg); }
  .eels-section summary::-webkit-details-marker { display: none; }
  .param-note { font-size: 0.6875rem; color: var(--text-muted); font-style: italic; }

  /* View tabs */
  .view-tabs {
    display: flex; background: var(--bg-muted); border-radius: var(--radius-full); padding: 3px;
  }
  .view-tab {
    flex: 1; padding: 0.3rem 0.65rem; border: none; background: none;
    border-radius: var(--radius-full);
    font-family: var(--font); font-size: 0.75rem; font-weight: 500;
    cursor: pointer; color: var(--text-soft); transition: all 0.2s; white-space: nowrap;
  }
  .view-tab.active { background: var(--bg); color: var(--text); box-shadow: var(--shadow-sm); }
  .view-tab:hover:not(.active) { color: var(--text); }

  .theory-note {
    font-size: 0.8125rem; color: var(--text-muted); line-height: 1.55;
    border-top: 1px solid var(--bg-muted); padding-top: var(--space-md);
  }
  .theory-note strong { color: var(--text-soft); }

  .chart-panel { padding: var(--space-md); display: flex; flex-direction: column; gap: var(--space-sm); }
  .chart-toolbar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
  .chart-title { font-size: 0.875rem; font-weight: 600; color: var(--text); }
  .compute-status { font-size: 0.75rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .chart-wrap { position: relative; }
  .chart-wrap canvas { width: 100%; aspect-ratio: 4 / 3; display: block; border-radius: var(--radius-sm); }

  .chart-legend {
    display: flex; gap: var(--space-md); flex-wrap: wrap;
    padding-top: var(--space-sm); border-top: 1px solid var(--bg-muted);
  }
  .legend-item { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; color: var(--text-soft); }
  .legend-swatch {
    display: inline-block; width: 10px; height: 10px; border-radius: 2px;
  }
  .legend-line {
    display: inline-block; width: 18px; height: 0;
    border-top: 2px dashed currentColor;
  }

  .references { margin-top: var(--space-lg); }
  .references h4 { font-size: 0.875rem; margin-bottom: var(--space-sm); }
  .references ul { list-style: none; display: flex; flex-direction: column; gap: var(--space-xs); }
  .references li { font-size: 0.8125rem; color: var(--text-soft); line-height: 1.5; }
  .references code {
    font-family: 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.85em;
    background: var(--bg-muted);
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
  }

  @media (max-width: 900px) {
    .widget-layout { grid-template-columns: 1fr; }
    .controls { position: static; }
    .chart-wrap canvas { aspect-ratio: 4 / 3; }
  }
</style>

<script>
  import { getDispersion, eelsParallel, eelsPerpendicular, HC_EV_NM } from '../../lib/cylinder.ts';
  import type { C } from '../../lib/cylinder.ts';
  import { chartTheme, onThemeChange } from '../../lib/chart-theme';

  type ViewMode = 'disp-wq' | 'disp-bV' | 'eels-par' | 'eels-perp';

  // ===== State =====

  const state = {
    a_nm: 15,
    eps_h: 1.0,
    eps1_re: 10.0,
    eps1_im: 0.1,
    w_min: 1,
    w_max: 20,
    m_active: new Set<number>([0, 1, 2]),
    view: 'disp-wq' as ViewMode,
    b_nm: 25,
    vFrac: 0.3,
    maxOrderEels: 4,
  };

  const M_COLORS: Record<number, string> = {
    0: '#6366F1',
    1: '#06B6D4',
    2: '#10B981',
    3: '#F59E0B',
  };

  interface MBranch {
    m: number;
    points: { w: number; q: number }[];
  }

  let branches: MBranch[] = [];
  let qMaxAuto = 0.5;
  let eelsCurve: { w: number[]; y: number[] } | null = null;
  let computeTimer: number | null = null;

  // ===== Compute =====

  function recompute() {
    const t0 = performance.now();
    if (state.view === 'eels-par') {
      recomputeEELSPar();
    } else if (state.view === 'eels-perp') {
      recomputeEELSPerp();
    } else {
      recomputeDispersion();
    }
    const dt = performance.now() - t0;
    const statusEl = document.getElementById('compute-status')!;
    if (state.view === 'eels-par' || state.view === 'eels-perp') {
      statusEl.textContent = `${eelsCurve?.w.length ?? 0} pts · ${dt.toFixed(0)} ms`;
    } else {
      const totalPts = branches.reduce((s, b) => s + b.points.length, 0);
      statusEl.textContent = `${totalPts} roots · ${dt.toFixed(0)} ms`;
    }
    drawChart();
    drawLegend();
  }

  function recomputeDispersion() {
    const eps_h: C = [state.eps_h, 0];
    const eps1: C = [state.eps1_re, state.eps1_im];

    const Nw = 80;
    const Nq = 240;
    const energies: number[] = [];
    for (let i = 0; i < Nw; i++) {
      energies.push(state.w_min + (state.w_max - state.w_min) * i / (Nw - 1));
    }

    const k0_max = state.w_max / HC_EV_NM;
    const q_upper = Math.sqrt(Math.max(0, state.eps1_re)) * k0_max;
    qMaxAuto = q_upper * 1.05;

    const q_nm: number[] = [];
    for (let i = 0; i < Nq; i++) {
      q_nm.push(0.0001 + (qMaxAuto - 0.0001) * i / (Nq - 1));
    }

    branches = [];
    const ms = Array.from(state.m_active).sort((a, b) => a - b);
    for (const m of ms) {
      const res = getDispersion({
        energies_eV: energies,
        q_nm,
        a_nm: state.a_nm,
        eps_h,
        eps1_of_w: () => eps1,
        m,
      });
      const pts: { w: number; q: number }[] = [];
      for (let i = 0; i < res.energies_eV.length; i++) {
        for (const q of res.roots_nm[i]) pts.push({ w: res.energies_eV[i], q });
      }
      branches.push({ m, points: pts });
    }
  }

  function recomputeEELSPar() {
    const eps_h: C = [state.eps_h, 0];
    const eps1: C = [state.eps1_re, state.eps1_im];
    const Nw = 240;
    const w: number[] = [];
    for (let i = 0; i < Nw; i++) {
      w.push(state.w_min + (state.w_max - state.w_min) * i / (Nw - 1));
    }
    const yRaw = eelsParallel({
      a_nm: state.a_nm,
      b_nm: state.b_nm,
      eps_h,
      eps1_of_w: () => eps1,
      w_eV: w,
      vFrac: state.vFrac,
      maxOrder: state.maxOrderEels,
    });
    // Match MATLAB sign convention: inside trajectory returns negative raw.
    // Report |EELS| for display so users see a positive loss spectrum.
    const y = yRaw.map(v => Math.abs(v));
    eelsCurve = { w, y };
  }

  function recomputeEELSPerp() {
    if (state.b_nm <= state.a_nm) {
      eelsCurve = { w: [], y: [] };
      return;
    }
    const eps_h: C = [state.eps_h, 0];
    const eps1: C = [state.eps1_re, state.eps1_im];
    const Nw = 140;  // perpendicular is more expensive due to qz integration
    const w: number[] = [];
    for (let i = 0; i < Nw; i++) {
      w.push(Math.max(0.05, state.w_min) + (state.w_max - Math.max(0.05, state.w_min)) * i / (Nw - 1));
    }
    // qz grid: finer near zero (most contribution), spans the evanescent regime
    const Nq = 60;
    const qzMax = 1.5;  // nm⁻¹ — well past the effective cutoff for typical radii
    const qz_nm: number[] = [];
    for (let i = 0; i < Nq; i++) {
      const t = i / (Nq - 1);
      // Geometric-ish density: denser near zero
      qz_nm.push(1e-4 + qzMax * t * t);
    }
    const y = eelsPerpendicular({
      a_nm: state.a_nm,
      b_nm: state.b_nm,
      eps_h,
      eps1_of_w: () => eps1,
      w_eV: w,
      vFrac: state.vFrac,
      maxOrder: state.maxOrderEels,
      qz_nm,
    });
    eelsCurve = { w, y: y.map(v => Math.abs(v)) };
  }

  function scheduleRecompute() {
    if (computeTimer !== null) window.clearTimeout(computeTimer);
    computeTimer = window.setTimeout(() => {
      computeTimer = null;
      recompute();
    }, 120);
  }

  // ===== Chart =====

  interface Axes {
    ctx: CanvasRenderingContext2D;
    m: { top: number; right: number; bottom: number; left: number };
    pw: number; ph: number; w: number; h: number;
    xMin: number; xMax: number; yMin: number; yMax: number;
    xTo: (x: number) => number;
    yTo: (y: number) => number;
    xLabel: string; yLabel: string;
  }

  function setupCanvas(): { canvas: HTMLCanvasElement; ctx: CanvasRenderingContext2D; w: number; h: number } {
    const canvas = document.getElementById('cyl-chart') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth, h = canvas.clientHeight;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.scale(dpr, dpr);
    return { canvas, ctx, w, h };
  }

  function makeAxes(
    ctx: CanvasRenderingContext2D, w: number, h: number,
    xMin: number, xMax: number, yMin: number, yMax: number,
    xLabel: string, yLabel: string,
  ): Axes {
    const m = { top: 14, right: 18, bottom: 38, left: 52 };
    const pw = w - m.left - m.right;
    const ph = h - m.top - m.bottom;
    const xTo = (x: number) => m.left + pw * (x - xMin) / (xMax - xMin);
    const yTo = (y: number) => m.top + ph * (1 - (y - yMin) / (yMax - yMin));
    return { ctx, m, pw, ph, w, h, xMin, xMax, yMin, yMax, xTo, yTo, xLabel, yLabel };
  }

  function drawAxesFrame(ax: Axes, xTicks: number, yTicks: number, xFmt: (v: number) => string, yFmt: (v: number) => string) {
    const { ctx, m, pw, ph, w, h, xMin, xMax, yMin, yMax, xLabel, yLabel } = ax;
    const ct = chartTheme();

    ctx.fillStyle = ct.bg;
    ctx.fillRect(m.left, m.top, pw, ph);

    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 1;
    for (let i = 0; i <= xTicks; i++) {
      const x = m.left + pw * i / xTicks;
      ctx.beginPath(); ctx.moveTo(x, m.top); ctx.lineTo(x, m.top + ph); ctx.stroke();
    }
    for (let i = 0; i <= yTicks; i++) {
      const y = m.top + ph * i / yTicks;
      ctx.beginPath(); ctx.moveTo(m.left, y); ctx.lineTo(m.left + pw, y); ctx.stroke();
    }

    ctx.strokeStyle = ct.text;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(m.left, m.top);
    ctx.lineTo(m.left, m.top + ph);
    ctx.lineTo(m.left + pw, m.top + ph);
    ctx.stroke();

    ctx.fillStyle = ct.textSoft;
    ctx.font = '10px Inter, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (let i = 0; i <= xTicks; i++) {
      const v = xMin + (xMax - xMin) * i / xTicks;
      ctx.fillText(xFmt(v), m.left + pw * i / xTicks, m.top + ph + 4);
    }
    ctx.fillStyle = ct.text;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillText(xLabel, m.left + pw / 2, h - 16);

    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    ctx.fillStyle = ct.textSoft;
    ctx.font = '10px Inter, system-ui, sans-serif';
    for (let i = 0; i <= yTicks; i++) {
      const v = yMax - (yMax - yMin) * i / yTicks;
      ctx.fillText(yFmt(v), m.left - 6, m.top + ph * i / yTicks);
    }
    ctx.save();
    ctx.translate(14, m.top + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = ct.text;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillText(yLabel, 0, 0);
    ctx.restore();
  }

  function drawChart() {
    if (state.view === 'disp-wq') drawDispersionWQ();
    else if (state.view === 'disp-bV') drawDispersionBV();
    else drawEELS();  // both par and perp share the same 1D renderer
  }

  function drawDispersionWQ() {
    const { ctx, w, h } = setupCanvas();
    const ax = makeAxes(ctx, w, h, 0, qMaxAuto, state.w_min, state.w_max,
                         'q_z (nm⁻¹)', 'ω (eV)');
    drawAxesFrame(ax, 6, 6, v => v.toFixed(3), v => v.toFixed(1));

    ctx.save();
    ctx.beginPath();
    ctx.rect(ax.m.left, ax.m.top, ax.pw, ax.ph);
    ctx.clip();

    // Light line and material line
    const k0_at = (we: number) => we / HC_EV_NM;
    const qLightMax = Math.sqrt(state.eps_h) * k0_at(state.w_max);
    const qMatMax = Math.sqrt(Math.max(0, state.eps1_re)) * k0_at(state.w_max);

    ctx.setLineDash([5, 4]);
    ctx.lineWidth = 1.4;
    ctx.strokeStyle = '#94A3B8';
    ctx.beginPath();
    ctx.moveTo(ax.xTo(0), ax.yTo(0));
    ctx.lineTo(ax.xTo(qLightMax), ax.yTo(state.w_max));
    ctx.stroke();

    ctx.strokeStyle = '#CBD5E1';
    ctx.beginPath();
    ctx.moveTo(ax.xTo(0), ax.yTo(0));
    ctx.lineTo(ax.xTo(qMatMax), ax.yTo(state.w_max));
    ctx.stroke();
    ctx.setLineDash([]);

    // Shaded guided region
    ctx.fillStyle = 'rgba(99,102,241,0.04)';
    ctx.beginPath();
    ctx.moveTo(ax.xTo(0), ax.yTo(0));
    ctx.lineTo(ax.xTo(qLightMax), ax.yTo(state.w_max));
    ctx.lineTo(ax.xTo(qMatMax), ax.yTo(state.w_max));
    ctx.closePath();
    ctx.fill();

    // Dispersion points
    for (const br of branches) {
      const color = M_COLORS[br.m] ?? '#6366F1';
      ctx.fillStyle = color;
      for (const p of br.points) {
        ctx.beginPath(); ctx.arc(ax.xTo(p.q), ax.yTo(p.w), 2.2, 0, Math.PI * 2); ctx.fill();
      }
    }
    ctx.restore();

    // Line labels
    drawLineLabel(ax, 'light line', qLightMax, '#94A3B8');
    drawLineLabel(ax, 'material line', qMatMax, '#94A3B8');
  }

  function drawDispersionBV() {
    const { ctx, w, h } = setupCanvas();
    // V_max at (ω_max, a) for real(ε₁-ε_h). For ε1_re > eps_h.
    const dEps = state.eps1_re - state.eps_h;
    const k0_max = state.w_max / HC_EV_NM;
    const Vmax = Math.max(0.1, k0_max * state.a_nm * Math.sqrt(Math.max(0, dEps)));
    const ax = makeAxes(ctx, w, h, 0, Vmax * 1.05, 0, 1,
                         'V = k₀ a √(ε₁ − ε_h)', 'b = (n_eff² − ε_h)/(ε₁ − ε_h)');
    drawAxesFrame(ax, 6, 5, v => v.toFixed(2), v => v.toFixed(2));

    ctx.save();
    ctx.beginPath();
    ctx.rect(ax.m.left, ax.m.top, ax.pw, ax.ph);
    ctx.clip();

    // Bounds b=0 (light) and b=1 (material)
    ctx.strokeStyle = '#CBD5E1';
    ctx.setLineDash([5, 4]);
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(ax.xTo(0), ax.yTo(0));
    ctx.lineTo(ax.xTo(Vmax * 1.05), ax.yTo(0));
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(ax.xTo(0), ax.yTo(1));
    ctx.lineTo(ax.xTo(Vmax * 1.05), ax.yTo(1));
    ctx.stroke();
    ctx.setLineDash([]);

    // Shaded bound-mode region
    ctx.fillStyle = 'rgba(99,102,241,0.04)';
    ctx.fillRect(ax.xTo(0), ax.yTo(1), ax.pw, ax.yTo(0) - ax.yTo(1));

    // Points in b-V coordinates
    for (const br of branches) {
      const color = M_COLORS[br.m] ?? '#6366F1';
      ctx.fillStyle = color;
      for (const p of br.points) {
        const k0 = p.w / HC_EV_NM;
        if (k0 <= 0 || dEps <= 0) continue;
        const V = k0 * state.a_nm * Math.sqrt(dEps);
        const n_eff_sq = (p.q / k0) * (p.q / k0);
        const b = (n_eff_sq - state.eps_h) / dEps;
        ctx.beginPath(); ctx.arc(ax.xTo(V), ax.yTo(b), 2.2, 0, Math.PI * 2); ctx.fill();
      }
    }
    ctx.restore();
  }

  function drawEELS() {
    const { ctx, w, h } = setupCanvas();
    if (!eelsCurve || eelsCurve.w.length === 0) {
      // Empty state — typically for perpendicular with b ≤ a
      const ax = makeAxes(ctx, w, h, state.w_min, state.w_max, 0, 1,
                           'ω (eV)', '|dΓ/dω|  (arb.)');
      drawAxesFrame(ax, 6, 5, v => v.toFixed(1), () => '');
      ctx.fillStyle = '#94A3B8';
      ctx.font = '12px Inter, system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('Perpendicular trajectory requires b > a', ax.m.left + ax.pw / 2, ax.m.top + ax.ph / 2);
      return;
    }
    const y = eelsCurve.y;
    let yMax = 0;
    for (const v of y) if (v > yMax) yMax = v;
    if (yMax <= 0) yMax = 1;
    const ax = makeAxes(ctx, w, h, state.w_min, state.w_max, 0, yMax * 1.08,
                         'ω (eV)', '|Γ(ω)|  (arb.)');
    drawAxesFrame(ax, 6, 5, v => v.toFixed(1), v => v.toExponential(1));

    ctx.save();
    ctx.beginPath();
    ctx.rect(ax.m.left, ax.m.top, ax.pw, ax.ph);
    ctx.clip();

    const par = state.view === 'eels-par';
    const inside = par && state.b_nm <= state.a_nm;
    const color = par ? (inside ? '#F59E0B' : '#6366F1') : '#10B981';
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.fillStyle = color + '18';
    ctx.beginPath();
    for (let i = 0; i < eelsCurve.w.length; i++) {
      const x = ax.xTo(eelsCurve.w[i]);
      const yy = ax.yTo(eelsCurve.y[i]);
      if (i === 0) ctx.moveTo(x, yy); else ctx.lineTo(x, yy);
    }
    ctx.stroke();

    // Fill under curve
    ctx.beginPath();
    for (let i = 0; i < eelsCurve.w.length; i++) {
      const x = ax.xTo(eelsCurve.w[i]);
      const yy = ax.yTo(eelsCurve.y[i]);
      if (i === 0) ctx.moveTo(x, yy); else ctx.lineTo(x, yy);
    }
    ctx.lineTo(ax.xTo(eelsCurve.w[eelsCurve.w.length - 1]), ax.yTo(0));
    ctx.lineTo(ax.xTo(eelsCurve.w[0]), ax.yTo(0));
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  function drawLineLabel(ax: Axes, text: string, qLineMax: number, color: string) {
    const { ctx } = ax;
    ctx.fillStyle = color;
    ctx.font = '9px Inter, system-ui, sans-serif';
    const lx = ax.xTo(qLineMax), ly = ax.yTo(state.w_max);
    ctx.save();
    ctx.translate(lx - 4, ly + 8);
    const angle = Math.atan2(ax.yTo(state.w_max) - ax.yTo(0), ax.xTo(qLineMax) - ax.xTo(0));
    ctx.rotate(angle);
    ctx.textAlign = 'right';
    ctx.textBaseline = 'bottom';
    ctx.fillText(text, 0, 0);
    ctx.restore();
  }

  function drawLegend() {
    const el = document.getElementById('chart-legend')!;
    el.innerHTML = '';
    if (state.view === 'eels-par') {
      const inside = state.b_nm <= state.a_nm;
      const item = document.createElement('span');
      item.className = 'legend-item';
      item.innerHTML = `<span class="legend-swatch" style="background:${inside ? '#F59E0B' : '#6366F1'}"></span> parallel trajectory · ${inside ? 'inside (b < a)' : 'outside (b > a)'} · v/c = ${state.vFrac.toFixed(2)}`;
      el.appendChild(item);
      return;
    }
    if (state.view === 'eels-perp') {
      const item = document.createElement('span');
      item.className = 'legend-item';
      item.innerHTML = `<span class="legend-swatch" style="background:#10B981"></span> perpendicular trajectory · b = ${state.b_nm.toFixed(1)} nm · v/c = ${state.vFrac.toFixed(2)} · Γ(ω) = 2 ∫₀^∞ (dΓ/dq_z) dq_z`;
      el.appendChild(item);
      return;
    }
    const ms = Array.from(state.m_active).sort((a, b) => a - b);
    for (const m of ms) {
      const item = document.createElement('span');
      item.className = 'legend-item';
      item.innerHTML = `<span class="legend-swatch" style="background:${M_COLORS[m]}"></span> m = ${m}`;
      el.appendChild(item);
    }
    const light = document.createElement('span');
    light.className = 'legend-item';
    light.style.color = '#94A3B8';
    light.innerHTML = `<span class="legend-line"></span> ${state.view === 'disp-wq' ? 'light / material' : 'b = 0 / b = 1'}`;
    el.appendChild(light);
  }

  // ===== Controls =====

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  function syncPair(numId: string, sliderId: string, key: keyof typeof state) {
    const num = $<HTMLInputElement>(numId);
    const slider = $<HTMLInputElement>(sliderId);
    const update = (src: 'num' | 'slider') => {
      const raw = src === 'num' ? num.value : slider.value;
      const v = parseFloat(raw);
      if (!isFinite(v)) return;
      (state as any)[key] = v;
      if (src === 'num') slider.value = raw;
      else num.value = raw;
      scheduleRecompute();
    };
    num.addEventListener('input', () => update('num'));
    slider.addEventListener('input', () => update('slider'));
  }

  syncPair('r-num', 'r-slider', 'a_nm');
  syncPair('eh-num', 'eh-slider', 'eps_h');
  syncPair('e1r-num', 'e1r-slider', 'eps1_re');
  syncPair('e1i-num', 'e1i-slider', 'eps1_im');
  syncPair('b-num', 'b-slider', 'b_nm');
  syncPair('v-num', 'v-slider', 'vFrac');

  $<HTMLInputElement>('Mmax-num').addEventListener('input', (e) => {
    const v = parseInt((e.target as HTMLInputElement).value, 10);
    if (isFinite(v) && v >= 0 && v <= 10) { state.maxOrderEels = v; scheduleRecompute(); }
  });

  function updateBNote() {
    const note = $('b-note');
    note.textContent = state.b_nm > state.a_nm ? 'outside the cylinder' : 'inside the cylinder';
  }
  $<HTMLInputElement>('b-num').addEventListener('input', updateBNote);
  $<HTMLInputElement>('b-slider').addEventListener('input', updateBNote);
  $<HTMLInputElement>('r-num').addEventListener('input', updateBNote);
  $<HTMLInputElement>('r-slider').addEventListener('input', updateBNote);

  $('v-presets').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.preset-btn') as HTMLElement | null;
    if (!btn) return;
    const v = parseFloat(btn.dataset.val!);
    state.vFrac = v;
    $<HTMLInputElement>('v-num').value = v.toString();
    $<HTMLInputElement>('v-slider').value = v.toString();
    scheduleRecompute();
  });

  $('view-tabs').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.view-tab') as HTMLElement | null;
    if (!btn) return;
    const v = btn.dataset.view as ViewMode;
    if (v === state.view) return;
    state.view = v;
    document.querySelectorAll('.view-tab').forEach(b => {
      const active = (b as HTMLElement).dataset.view === v;
      b.classList.toggle('active', active);
      b.setAttribute('aria-checked', String(active));
    });
    if (v === 'eels-par' || v === 'eels-perp') {
      $('eels-section').setAttribute('open', '');
    }
    recompute();
  });

  $<HTMLInputElement>('w-min').addEventListener('input', (e) => {
    const v = parseFloat((e.target as HTMLInputElement).value);
    if (isFinite(v) && v >= 0) { state.w_min = v; scheduleRecompute(); }
  });
  $<HTMLInputElement>('w-max').addEventListener('input', (e) => {
    const v = parseFloat((e.target as HTMLInputElement).value);
    if (isFinite(v) && v > state.w_min) { state.w_max = v; scheduleRecompute(); }
  });

  $('eh-presets').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.preset-btn') as HTMLElement | null;
    if (!btn) return;
    const v = parseFloat(btn.dataset.val!);
    state.eps_h = v;
    $<HTMLInputElement>('eh-num').value = v.toString();
    $<HTMLInputElement>('eh-slider').value = v.toString();
    $('eh-presets').querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    scheduleRecompute();
  });

  $('m-chips').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.m-chip') as HTMLElement | null;
    if (!btn) return;
    const m = parseInt(btn.dataset.m!, 10);
    if (state.m_active.has(m)) state.m_active.delete(m);
    else state.m_active.add(m);
    btn.classList.toggle('active');
    scheduleRecompute();
  });

  $('reset-btn').addEventListener('click', () => {
    state.a_nm = 15;
    state.eps_h = 1.0;
    state.eps1_re = 10.0;
    state.eps1_im = 0.1;
    state.w_min = 1;
    state.w_max = 20;
    state.m_active = new Set([0, 1, 2]);
    state.b_nm = 25;
    state.vFrac = 0.3;
    state.maxOrderEels = 4;
    $<HTMLInputElement>('r-num').value = '15';
    $<HTMLInputElement>('r-slider').value = '15';
    $<HTMLInputElement>('eh-num').value = '1.00';
    $<HTMLInputElement>('eh-slider').value = '1';
    $<HTMLInputElement>('e1r-num').value = '10.0';
    $<HTMLInputElement>('e1r-slider').value = '10';
    $<HTMLInputElement>('e1i-num').value = '0.10';
    $<HTMLInputElement>('e1i-slider').value = '0.1';
    $<HTMLInputElement>('w-min').value = '1';
    $<HTMLInputElement>('w-max').value = '20';
    $<HTMLInputElement>('b-num').value = '25';
    $<HTMLInputElement>('b-slider').value = '25';
    $<HTMLInputElement>('v-num').value = '0.3';
    $<HTMLInputElement>('v-slider').value = '0.3';
    $<HTMLInputElement>('Mmax-num').value = '4';
    $('eh-presets').querySelectorAll('.preset-btn').forEach((b, i) => b.classList.toggle('active', i === 0));
    document.querySelectorAll('.m-chip').forEach(c => {
      const mm = parseInt((c as HTMLElement).dataset.m!, 10);
      c.classList.toggle('active', mm < 3);
    });
    updateBNote();
    recompute();
  });

  updateBNote();

  new ResizeObserver(drawChart).observe($('chart-wrap'));

  onThemeChange(() => drawChart());

  // Initial
  recompute();
</script>
