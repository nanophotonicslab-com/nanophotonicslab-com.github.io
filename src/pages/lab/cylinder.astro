  const mfieldColorbar = $<HTMLCanvasElement>('mfield-colorbar');
  const mfieldMagColorbar = $<HTMLCanvasElement>('mfield-mag-colorbar');
  function drawColorbar(target: HTMLCanvasElement, mode: 'signed' | 'mag', scale: FieldTileScale, label: string) {
    const { ctx, w, h } = setupFieldColorbarCanvas(target);
    const ct = chartTheme();
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = ct.textSoft;
    ctx.font = '600 11px Inter, system-ui, sans-serif';
    ctx.textAlign = 'left'; ctx.textBaseline = 'top';
    ctx.fillText(label, 2, 2);
    const titleH = 20;
    const barW = 14;
    const barX = 4;
    const barY = titleH;
    const barH = Math.max(40, h - titleH - 6);
    for (let i = 0; i < barH; i++) {
      const t = 1 - i / Math.max(1, barH - 1);
      const rgb = mode === 'signed' ? signedRgb(2 * t - 1) : heatRgb(t);
      ctx.fillStyle = `rgb(${rgb[0]},${rgb[1]},${rgb[2]})`;
      ctx.fillRect(barX, barY + i, barW, 1);
    }
    ctx.strokeStyle = hexToRgba(ct.text, 0.35);
    ctx.lineWidth = 1;
    ctx.strokeRect(barX, barY, barW, barH);
    ctx.fillStyle = ct.textMuted;
    ctx.font = '10px Inter, system-ui, sans-serif';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    const tx = barX + barW + 5;
    if (mode === 'signed') {
      ctx.fillText(formatFieldTick(scale.signedMax), tx, barY + 6);
      ctx.fillText('0', tx, barY + barH / 2);
      ctx.fillText(formatFieldTick(-scale.signedMax), tx, barY + barH - 6);
    } else {
      ctx.fillText(formatFieldTick(scale.max, scale.log), tx, barY + 6);
      ctx.fillText(formatFieldTick(scale.min, scale.log), tx, barY + barH - 6);
    }
  }
  function clearFieldModal(message: string) {
    const ct = chartTheme();
    for (const c of Object.values(mfieldCanvases)) {
      const { ctx, size } = setupFieldCanvas(c);
      ctx.fillStyle = ct.bg; ctx.fillRect(0, 0, size, size);
      ctx.fillStyle = ct.textMuted; ctx.font = '12px Inter, system-ui, sans-serif';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(message, size / 2, size / 2, size - 24);
    }
    for (const cb of [mfieldColorbar, mfieldMagColorbar]) {
      const { ctx, w, h } = setupFieldColorbarCanvas(cb);
      ctx.clearRect(0, 0, w, h);
    }
  }
  function renderFieldModal() {
    $('field-modal-normalized').classList.toggle('active', state.fieldNormalized);
    $('field-modal-log').classList.toggle('active', state.fieldLogMag);
    $('mfield-mag-label').innerHTML = state.fieldLogMag ? 'log<sub>10</sub>|E|' : '|E|';
    if (!selectedFieldPoint) { mfieldMeta.textContent = 'Select a point in the dispersion map'; clearFieldModal('No selected mode'); return; }
    const epsNote = state.materialId === 'custom' && Math.abs(state.eps1_im) > 1e-9 ? ' | using Re(ε₁)' : '';
    mfieldMeta.textContent = `${selectedFieldPoint.modeLabel} · ℏω = ${selectedFieldPoint.w.toFixed(3)} eV | q_z = ${selectedFieldPoint.q.toFixed(5)} nm^-1 | m = ${selectedFieldPoint.m}${epsNote}`;
    if (state.materialId !== 'custom') { clearFieldModal('Custom dielectric only'); return; }
    const profile = computeSelectedFieldProfile();
    if (!profile) { clearFieldModal('No guided field at this point'); return; }
    const { ex, ey, ez } = profile.components;
    const allSigned = [...ex.re, ...ex.im, ...ey.re, ...ey.im, ...ez.re, ...ez.im];
    const sharedMax = state.fieldNormalized ? null : Math.max(1e-18, percentile(allSigned.map(v => Math.abs(v)), 0.995));
    const signedRailScale = makeSignedScale(allSigned, sharedMax, false);
    const magScale = makeMagScale(profile.mag, false);
    const tile = (canvas: HTMLCanvasElement, arr: number[]) => drawFieldTile(canvas, arr, profile.n, profile.limNm, 'signed', makeSignedScale(arr, sharedMax, false));
    tile(mfieldCanvases.reEx, ex.re); tile(mfieldCanvases.reEy, ey.re); tile(mfieldCanvases.reEz, ez.re);
    tile(mfieldCanvases.imEx, ex.im); tile(mfieldCanvases.imEy, ey.im); tile(mfieldCanvases.imEz, ez.im);
    drawFieldTile(mfieldCanvases.mag, profile.mag, profile.n, profile.limNm, 'mag', magScale);
    const signedDisplay = state.fieldNormalized ? { ...signedRailScale, min: -1, max: 1, signedMax: 1, log: false } : signedRailScale;
    const magDisplay = state.fieldNormalized ? { ...magScale, min: 0, max: 1, signedMax: 1, log: false } : magScale;
    drawColorbar(mfieldColorbar, 'signed', signedDisplay, state.fieldNormalized ? 'norm Re/Im' : 'Re/Im E');
