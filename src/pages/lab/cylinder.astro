  function drawFieldProfile(): void {
    if (!fieldProfilePanel || fieldProfilePanel.style.display === 'none') return;
    const title = fieldProfileTitle;
    const meta = fieldProfileMeta;
    fieldLogToggle.classList.toggle('active', state.fieldLogMag);
    fieldNormalizedToggle.classList.toggle('active', state.fieldNormalized);
    syncFieldComponentControls();
    fieldMagLabel.innerHTML = state.fieldLogMag ? 'log<sub>10</sub>|E|' : '|E|';
    fieldProfileBody.classList.remove('is-normalized');
    fieldColorbarRail.style.display = '';
    if (!selectedFieldPoint) {
      title.textContent = 'Mode field profile';
      meta.textContent = 'Select a point in the dispersion map';
      setFieldExportEnabled(false);
      fieldProfileBody.classList.add('is-normalized');
      fieldColorbarRail.style.display = 'none';
      clearFieldCanvases('No selected mode');
      return;
    }
    title.textContent = `${selectedFieldPoint.modeLabel} field profile`;
    const epsNote = state.materialId === 'custom' && Math.abs(state.eps1_im) > 1e-9 ? ' | using Re(\u03B5\u2081)' : '';
    meta.textContent = `\u210F\u03C9 = ${selectedFieldPoint.w.toFixed(3)} eV | q_z = ${selectedFieldPoint.q.toFixed(5)} nm^-1 | m = ${selectedFieldPoint.m}${epsNote}`;
    if (state.materialId !== 'custom') {
      setFieldExportEnabled(false);
      fieldProfileBody.classList.add('is-normalized');
      fieldColorbarRail.style.display = 'none';
      clearFieldCanvases('Custom dielectric only');
      return;
    }
    const profile = computeSelectedFieldProfile();
    if (!profile) {
      setFieldExportEnabled(false);
      fieldProfileBody.classList.add('is-normalized');
      fieldColorbarRail.style.display = 'none';
      clearFieldCanvases('No guided field at this point');
      return;
    }
    setFieldExportEnabled(true);
    fieldProfileBody.classList.remove('is-normalized');
    fieldColorbarRail.style.display = '';
    const ex = profile.components.ex[state.fieldParts.ex];
    const ey = profile.components.ey[state.fieldParts.ey];
    const ez = profile.components.ez[state.fieldParts.ez];
    const sharedSignedMax = state.fieldNormalized
      ? null
      : Math.max(1e-18, percentile([...ex, ...ey, ...ez].map(v => Math.abs(v)), 0.995));
    const signedRailScale = makeSignedScale([...ex, ...ey, ...ez], sharedSignedMax, false);
    const magScale = makeMagScale(profile.mag, false);
    drawFieldTile(fieldExCanvas, ex, profile.n, profile.limNm, 'signed', makeSignedScale(ex, sharedSignedMax, false));
    drawFieldTile(fieldEyCanvas, ey, profile.n, profile.limNm, 'signed', makeSignedScale(ey, sharedSignedMax, false));
    drawFieldTile(fieldEzCanvas, ez, profile.n, profile.limNm, 'signed', makeSignedScale(ez, sharedSignedMax, false));
    drawFieldTile(fieldMagCanvas, profile.mag, profile.n, profile.limNm, 'mag', magScale);
    drawFieldColorbarRail(signedRailScale, magScale);
    if (fieldModalOpen) renderFieldModal();
  }

  function nearestDispersionPointHit(x: number, y: number, radius = 8, hits: DispersionPointHit[] = dispersionPointHits): DispersionPointHit | null {
    let best: DispersionPointHit | null = null;
    let bestD2 = radius * radius;
    for (const hit of hits) {
      const dx = hit.x - x;
      const dy = hit.y - y;
      const d2 = dx * dx + dy * dy;
      if (d2 <= bestD2) {
        best = hit;
        bestD2 = d2;
      }
    }
    return best;
  }

  function nearestGroupVelocityPointHit(x: number, y: number, radius = 8, hits: GroupVelocityPointHit[] = groupVelocityPointHits): GroupVelocityPointHit | null {
    let best: GroupVelocityPointHit | null = null;
    let bestD2 = radius * radius;
    for (const hit of hits) {
      const dx = hit.x - x;
      const dy = hit.y - y;
      const d2 = dx * dx + dy * dy;
      if (d2 <= bestD2) {
        best = hit;
        bestD2 = d2;
      }
    }
    return best;
  }

  function drawMapInset(ax: Axes, minVal: number, maxVal: number) {
    const { ctx } = ax;
    const x = ax.m.left + ax.pw - 148;
    const y = ax.m.top + 12;
    const w = 136;
    const h = 52;
    ctx.save();
    ctx.fillStyle = 'rgba(255,255,255,0.88)';
    ctx.strokeStyle = 'rgba(148,163,184,0.35)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.roundRect(x, y, w, h, 6);
    ctx.fill();
    ctx.stroke();
    for (let i = 0; i < 84; i++) {
      ctx.fillStyle = heatColor(i / 83);
      ctx.fillRect(x + 10 + i, y + 12, 1.3, 8);
    }
    ctx.fillStyle = '#475569';
    ctx.font = '10px Inter, system-ui, sans-serif';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'top';
    const label = state.mapLogColor ? 'log10 d\u0393' : 'd\u0393/dE dqz';
    ctx.fillText(label, x + 10, y + 27);
    ctx.font = '9px Inter, system-ui, sans-serif';
    ctx.fillText(`${minVal.toExponential(1)}`, x + 10, y + 40);
    ctx.textAlign = 'right';
    ctx.fillText(`${maxVal.toExponential(1)}`, x + w - 10, y + 40);
    ctx.restore();
  }

  function strokeMapLine(ax: Axes, color: string, label: string, qOfEnergy: (energyEv: number) => number) {
    const { ctx } = ax;
    ctx.save();
    ctx.beginPath();
    ctx.rect(ax.m.left, ax.m.top, ax.pw, ax.ph);
    ctx.clip();
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.6;
    ctx.setLineDash(label === 'custom' ? [6, 4] : []);
    ctx.beginPath();
    let started = false;
    for (let i = 0; i < 160; i++) {
      const e = state.w_min + (state.w_max - state.w_min) * i / 159;
      const q = qOfEnergy(e);
      if (!Number.isFinite(q) || q < 0) continue;
      const x = ax.xTo(q);
      const y = ax.yTo(e);
      if (!started) { ctx.moveTo(x, y); started = true; }
      else ctx.lineTo(x, y);
    }
    if (started) ctx.stroke();
    ctx.restore();
  }

  function drawPerpMap() {
    if (state.view !== 'eels-perp') return;
    if (!perpMap || perpMap.w_eV.length === 0) {
      clearPerpMapCanvas(perpNeedsCompute ? 'Press Compute to update q-resolved EELS' : '');
      return;
    }
    const { ctx, w, h } = setupPerpMapCanvas();
    const ax = makeAxes(ctx, w, h, 0, Math.max(0.02, state.qzMaxNm), state.w_min, state.w_max,
                         'q_z (nm^-1)', '\u210F\u03C9 (eV)');
    drawAxesFrame(ax, 6, 5, v => v.toFixed(2), v => v.toFixed(1));

    const values = perpMap.values_nm_per_eV.map(row => row.map(v => Math.max(0, v)));
    const flat = values.flat().filter(v => Number.isFinite(v) && v > 0);
    const rawMax = flat.length ? Math.max(...flat) : 1;
    const rawMin = flat.length ? Math.min(...flat) : rawMax * 1e-8;
    const tiny = Math.max(rawMax * 1e-8, 1e-300);
    const minVal = state.mapLogColor ? Math.log10(Math.max(rawMin, tiny)) : 0;
    const maxVal = state.mapLogColor ? Math.log10(Math.max(rawMax, tiny)) : rawMax;
    const span = Math.max(1e-30, maxVal - minVal);

    ctx.save();
    ctx.beginPath();
    ctx.rect(ax.m.left, ax.m.top, ax.pw, ax.ph);
    ctx.clip();
    for (let iw = 0; iw < perpMap.w_eV.length; iw++) {
      const e0 = perpMap.w_eV[iw];
      const e1 = perpMap.w_eV[iw + 1] ?? state.w_max;
      const y0 = ax.yTo(e0);
      const y1 = ax.yTo(e1);
      for (let iq = 0; iq < perpMap.qz_nm.length; iq++) {
        const q0 = perpMap.qz_nm[iq];
        const q1 = perpMap.qz_nm[iq + 1] ?? state.qzMaxNm;
        const v = values[iw][iq];
        const z = state.mapLogColor ? Math.log10(Math.max(v, tiny)) : v;
        ctx.fillStyle = heatColor((z - minVal) / span);
        const x0 = ax.xTo(q0);
        const x1 = ax.xTo(q1);
        ctx.fillRect(Math.min(x0, x1), Math.min(y0, y1), Math.abs(x1 - x0) + 1, Math.abs(y1 - y0) + 1);
      }
    }
    ctx.restore();

    if (state.mapShowLight) {
      strokeMapLine(ax, '#F8FAFC', 'light', energy => Math.sqrt(Math.max(0, state.eps_h)) * energy / HC_EV_NM);
    }
    if (state.mapShowElectron) {
      strokeMapLine(ax, '#EF4444', 'electron', energy => energy / (Math.max(0.01, state.vFrac) * HC_EV_NM));
    }
    if (state.mapShowCustom) {
      const slope = Math.max(1e-6, Math.abs(state.mapCustomSlope));
      strokeMapLine(ax, '#111827', 'custom', energy => energy / (slope * HC_EV_NM));
    }
    drawMapInset(ax, state.mapLogColor ? minVal : rawMin, state.mapLogColor ? maxVal : rawMax);
  }

  function drawLineLabel(ax: Axes, text: string, qLineMax: number, color: string) {
    const { ctx } = ax;
    ctx.fillStyle = color;
    ctx.font = '9px Inter, system-ui, sans-serif';
    const labelEnergy = state.w_min + (state.w_max - state.w_min) * 0.72;
    const qAtLabel = qLineMax * labelEnergy / Math.max(1e-12, state.w_max);
    const lx = ax.xTo(qAtLabel), ly = ax.yTo(labelEnergy);
    ctx.save();
    ctx.translate(lx - 4, ly + 10);
    const angle = Math.atan2(ax.yTo(state.w_max) - ax.yTo(0), ax.xTo(qLineMax) - ax.xTo(0));
    ctx.rotate(angle);
    ctx.textAlign = 'right';
    ctx.textBaseline = 'bottom';
    ctx.fillText(text, 0, 0);
    ctx.restore();
  }

  function drawLegend() {
    const el = document.getElementById('chart-legend')!;
    el.innerHTML = '';
    if (state.view === 'cross-section') {
      el.style.display = 'none';
      return;
    }
    if (state.view === 'angular' || state.view === 'disp-wq' || state.view === 'disp-bV') {
      el.style.display = 'none';
      return;
    }
    el.style.display = '';
    if (state.view === 'eels-par') {
      if (!isParallelGeometryAllowed()) {
        el.style.display = 'none';
        return;
      }
      const inside = state.parallelGeometry === 'inside-hole';
      const item = document.createElement('span');
      item.className = 'legend-item';
      item.innerHTML = `<span class="legend-swatch" style="background:${inside ? '#F59E0B' : '#6366F1'}"></span> parallel trajectory · ${inside ? 'inside hole (b < a)' : 'outside cylinder (b > a)'} · v/c = ${state.vFrac.toFixed(2)}`;
      el.appendChild(item);
      return;
    }
    if (state.view === 'eels-perp') {
      const item = document.createElement('span');
      item.className = 'legend-item';
      item.innerHTML = `<span class="legend-swatch" style="background:#10B981"></span> perpendicular trajectory · b = ${state.b_nm.toFixed(1)} nm · v/c = ${state.vFrac.toFixed(2)} · &Gamma; = 2 integral dq_z`;
      el.appendChild(item);
      return;
    }
    const ms = mOrders().filter(m => state.m_active.has(m));
    for (const m of ms) {
      const item = document.createElement('span');
      item.className = 'legend-item';
      item.innerHTML = `<span class="legend-swatch" style="background:${colorForM(m)}"></span> m = ${m}`;
      el.appendChild(item);
    }
    const light = document.createElement('span');
    light.className = 'legend-item';
    light.style.color = '#94A3B8';
    light.innerHTML = `<span class="legend-line"></span> ${state.view === 'disp-wq' ? 'light / material' : 'b = 0 / b = 1'}`;
    el.appendChild(light);
  }

