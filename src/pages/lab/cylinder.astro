              <div class="field-tile" style="grid-area:rex"><div class="field-tile__header"><span class="field-tile__label">Re E<sub>x</sub></span></div><canvas id="mfield-re-ex" aria-label="Re Ex field"></canvas></div>
              <div class="field-tile" style="grid-area:rey"><div class="field-tile__header"><span class="field-tile__label">Re E<sub>y</sub></span></div><canvas id="mfield-re-ey" aria-label="Re Ey field"></canvas></div>
              <div class="field-tile" style="grid-area:rez"><div class="field-tile__header"><span class="field-tile__label">Re E<sub>z</sub></span></div><canvas id="mfield-re-ez" aria-label="Re Ez field"></canvas></div>
              <div class="field-tile" style="grid-area:imx"><div class="field-tile__header"><span class="field-tile__label">Im E<sub>x</sub></span></div><canvas id="mfield-im-ex" aria-label="Im Ex field"></canvas></div>
              <div class="field-tile" style="grid-area:imy"><div class="field-tile__header"><span class="field-tile__label">Im E<sub>y</sub></span></div><canvas id="mfield-im-ey" aria-label="Im Ey field"></canvas></div>
              <div class="field-tile" style="grid-area:imz"><div class="field-tile__header"><span class="field-tile__label">Im E<sub>z</sub></span></div><canvas id="mfield-im-ez" aria-label="Im Ez field"></canvas></div>
              <div class="field-tile" style="grid-area:mag"><div class="field-tile__header"><span class="field-tile__label" id="mfield-mag-label">|E|</span></div><canvas id="mfield-mag" aria-label="Field magnitude"></canvas></div>
              <canvas id="mfield-colorbar" class="mfield-bar" style="grid-area:sbar" aria-label="Re/Im field color scale"></canvas>
