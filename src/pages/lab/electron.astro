  const DIP_IDS = ['sp-px-re', 'sp-px-im', 'sp-py-re', 'sp-py-im', 'sp-pz-re', 'sp-pz-im'];
  const updateDipoleMag = () => { $('sp-dipole-mag').textContent = '|p| = ' + dipoleMag().toFixed(3); };
  function setDipoleFields(d: Vec3c) {
