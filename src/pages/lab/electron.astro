    const geo = (gv('nl-geo') || 'triangle') as any;
    const material = gv('nl-material') || 'graphene';
    const EF = gnum('nl-ef', 1.0), gamma = gnum('nl-gamma', 0.05), D = gnum('nl-d', 20), thickness = gnum('nl-thickness', 2);
    const modes = Math.max(1, parseInt(activeData('#nl-modes', 'modes', '1')) || 1);
    const gmodel = activeData('#nl-gmodel', 'gmodel', 'bte'), temperature = gnum('nl-temp', 300), epsBar = 1.0;
    let sigma2d: (E: number) => { re: number; im: number };
    if (material === 'graphene') sigma2d = (E) => gmodel === 'rpa' ? grapheneSigma2dRPA(E, EF, gamma, temperature) : grapheneSigma2d(E, EF, gamma);
    else if (material === 'drude') { const ei = gnum('nl-drude-einf', 9.5), wp = gnum('nl-drude-wp', 9.06), dg = gnum('nl-drude-g', 0.071); sigma2d = (E) => { const e = drudeEpsilon(wavelengthNmFromEV(E), ei, wp, dg); return metalSigma2d(E, e.re, e.im, thickness); }; }
    else if (['au', 'ag', 'cu', 'al'].includes(material)) sigma2d = (E) => { const e = epsilonFromMaterial(material, wavelengthNmFromEV(E)); return metalSigma2d(E, e.re, e.im, thickness); };
    else return { error: '2D file-based materials (σ/ε upload) can’t be imported — pick graphene, a metal, or Drude in the lab.' };
