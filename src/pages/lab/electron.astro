  const clipPlot = (ctx: CanvasRenderingContext2D, w: number, h: number, p: Plot) => { ctx.save(); ctx.beginPath(); ctx.rect(p.m.l, p.m.t, w - p.m.l - p.m.r, h - p.m.t - p.m.b); ctx.clip(); };

  // ── colormaps for the spectral density maps (fig3_polarization) ──
  const HEX = (s: string) => [parseInt(s.slice(1, 3), 16), parseInt(s.slice(3, 5), 16), parseInt(s.slice(5, 7), 16)];
  const INT_STOPS = ['#21318a', '#5c8fcf', '#f3f6fb', '#f4a93b', '#b8312a'].map(HEX);
