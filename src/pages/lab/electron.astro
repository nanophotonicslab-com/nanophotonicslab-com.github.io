    ctx.strokeStyle = cvarp('--primary'); ctx.lineWidth = 2; ctx.beginPath();
    for (let i = 0; i < NE; i++) { const X = fr.px(E[i]), Y = fr.py(S[i]); i ? ctx.lineTo(X, Y) : ctx.moveTo(X, Y); } ctx.stroke(); ctx.restore();
    $p('pn-readout').innerHTML = `<span>sideband spacing &#8463;&omega; = <b>${beamPhotonEV(b).toFixed(3)} eV</b></span><span>Lorentzian FWHM Γ = <b>${pn.fwhmEV} eV</b> · grey stems = bare Pₙ</span>`;
  }

  function drawPropagation(withData = true) {
