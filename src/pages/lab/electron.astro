      let s0max = 1e-30;
      for (let ip = 0; ip < NPH; ip++) { const phr = 360 * ip / (NPH - 1) * PI / 180; for (let it = 0; it < NTH; it++) { const t = (1 + 88 * it / (NTH - 1)) * PI / 180; const { fTheta, fPhi } = sphericalComponents(t, phr, farFieldVector(t, phr, vec, aol, beta)); const s0 = stokes(fTheta, fPhi)[0]; if (s0 > s0max) s0max = s0; } }
      const lines = [head, `# Hemisphere polarization rosette at lambda=${wavelengthNmFromEV(sp.E).toFixed(1)} nm (intensity-weighted: Si/max(S0))`, 'phi_deg,theta_deg,S0_over_max,S1_over_max,S2_over_max,S3_over_max'];
      for (let ip = 0; ip < NPH; ip++) {
        const phd = 360 * ip / (NPH - 1), phr = phd * PI / 180;
        for (let it = 0; it < NTH; it++) {
          const thd = 1 + 88 * it / (NTH - 1), t = thd * PI / 180;
          const { fTheta, fPhi } = sphericalComponents(t, phr, farFieldVector(t, phr, vec, aol, beta)); const [s0, s1, s2, s3] = stokes(fTheta, fPhi);
          lines.push(`${phd.toFixed(1)},${thd.toFixed(2)},${p6(s0 / s0max)},${p6(s1 / s0max)},${p6(s2 / s0max)},${p6(s3 / s0max)}`);
        }
      }
      return { name: 'sp_farfield_rosette.csv', csv: lines.join('\n') + '\n' };
    }
    const aol = aOverLambda(), vec = buildDipoles(), which = sp.sub === 'intensity' ? 's0' : sp.stokesSel, NT = 721;
    const lines = [head, `# Far-field at lambda=${wavelengthNmFromEV(sp.E).toFixed(1)} nm, phi=${sp.phi} deg`, `theta_deg,${which === 's0' ? 'intensity_S0' : which.toUpperCase() + '_over_S0'}`];
    for (let i = 0; i < NT; i++) {
      const thd = -180 + 360 * i / (NT - 1), t = thd * PI / 180;
      const { fTheta, fPhi } = sphericalComponents(t, phi, farFieldVector(t, phi, vec, aol, beta)); const [s0, s1, s2, s3] = stokes(fTheta, fPhi);
      const v = which === 's0' ? s0 : (s0 > 1e-12 ? (which === 's1' ? s1 : which === 's2' ? s2 : s3) / s0 : NaN);
      lines.push(`${thd.toFixed(2)},${p6(v)}`);
    }
    return { name: `sp_farfield_${which}.csv`, csv: lines.join('\n') + '\n' };
  }
  $('sp-export-png').addEventListener('click', () => exportPng($('sp-chart') as HTMLCanvasElement, spChartName() + '.png'));
  $('sp-export-csv').addEventListener('click', () => { const { name, csv } = spResultCSV(); downloadBlob(new Blob([csv], { type: 'text/csv' }), name); });

  // ── module switching (Fields / Smith–Purcell / PINEM / Transition radiation) ──
  let spReady = false;
  function setModule(id: string) {
    const isSP = id === 'smith-purcell', isPinem = id === 'pinem', isTr = id === 'tr';
    // current shared electron velocity (Fields' vc, else the SP value)
    const fb = parseFloat(($('vc') as HTMLInputElement).value || ($('vc') as HTMLInputElement).placeholder || '');
    const betaNow = (fb > 0 && fb < 1) ? fb : sp.vc;
    if (isSP) sp.vc = betaNow;
    else if (id === 'fields') (window as any).__electronFieldsSetBeta?.(sp.vc);   // push velocity back into Fields
    ($('panel-fields') as HTMLElement).hidden = isSP || isPinem || isTr;
    ($('panel-sp') as HTMLElement).hidden = !isSP;
    ($('panel-pinem') as HTMLElement).hidden = !isPinem;
    ($('panel-tr') as HTMLElement).hidden = !isTr;
    document.querySelectorAll('.module-card').forEach(b => { const a = b.id === 'module-' + id; b.classList.toggle('active', a); b.setAttribute('aria-checked', a ? 'true' : 'false'); });
    if (isSP) { if (!spReady) { spReady = true; renderSubTabs(); } syncBetaK(sp.vc); renderSP(); }
    if (isPinem) (window as any).__pinemActivate?.(betaNow);
    if (isTr) (window as any).__trActivate?.(betaNow);
    // so the TR module can drop its permalink keys when it is not the one on screen
    (window as any).__trModuleChanged?.(isTr);
  }
  $('module-fields').addEventListener('click', () => setModule('fields'));
  $('module-smith-purcell').addEventListener('click', () => setModule('smith-purcell'));
  $('module-pinem').addEventListener('click', () => setModule('pinem'));
  $('module-tr').addEventListener('click', () => setModule('tr'));
  // the Transition-radiation block restores its own permalink and needs to open its panel
  (window as any).__electronSetModule = setModule;

  // re-render the SP charts on resize when visible
  let rT: number; window.addEventListener('resize', () => { clearTimeout(rT); rT = window.setTimeout(() => { if (!($('panel-sp') as HTMLElement).hidden) renderSP(); }, 120); });
</script>

<!-- ===================== PINEM module ===================== -->
<script>
  import {
    sidebandProbabilities, pinemSpectrum, chargeDensity, analyzeFocus, talbotDistanceM,
    beamPhotonEV, beamPeriodS, beamGamma, betaToEnergyEV, energyEVToBeta,
    eVFromWavelengthNm, wavelengthNmFromEV, type Beam, type DispMethod,
  } from '../../lib/pinem';
  import { downloadBlob as pnDownload } from '../../lib/download';
  import { formatLength, formatLengthText } from '../../lib/format-length';

  const $p = (id: string) => document.getElementById(id) as HTMLElement;
  const PIp = Math.PI;
  const cvarp = (n: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim() || '#888';

  const pn = {
    beta: 0.5867, absg: 5, phaseDeg: 0, wavelengthNm: 800, wlUnit: 'nm' as 'nm' | 'eV',
    nmax: 40, nshow: 15, method: 'exact' as DispMethod,
    view: 'spectrum' as 'spectrum' | 'billiard', sub: 'probability' as 'probability' | 'eels' | 'propagation',
    fwhmEV: 0.5, eMinEV: -20, eMaxEV: 20,
    tauRange: 1.5, zMaxMm: 5, cohNm: 0, fullTalbot: false,
    gMax: 6,
  };
  const pnBeam = (): Beam => ({ energyEV: betaToEnergyEV(pn.beta), wavelengthNm: pn.wavelengthNm });

  // canvas helpers
  function ctx2dP(canvas: HTMLCanvasElement) {
    const r = canvas.getBoundingClientRect();
    if (r.width < 4 || r.height < 4) return null;
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);
    const ctx = canvas.getContext('2d')!; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, r.width, r.height);
    return { ctx, w: r.width, h: r.height };
  }
  type Frame = { px: (x: number) => number; py: (y: number) => number; m: { l: number; r: number; t: number; b: number }; w: number; h: number };
  function frameP(ctx: CanvasRenderingContext2D, w: number, h: number, xmin: number, xmax: number, ymin: number, ymax: number, xlabel: string, ylabel: string, xticks: number[], yticks: number[], fmtX = (v: number) => String(v), fmtY = (v: number) => String(v)): Frame {
    const m = { l: 58, r: 30, t: 14, b: 40 };
    const px = (x: number) => m.l + (x - xmin) / (xmax - xmin) * (w - m.l - m.r);
    const py = (y: number) => h - m.b - (y - ymin) / (ymax - ymin) * (h - m.t - m.b);
    ctx.font = '11px ' + (cvarp('--font') || 'sans-serif'); ctx.fillStyle = cvarp('--text-muted');
    ctx.strokeStyle = cvarp('--bg-muted'); ctx.lineWidth = 1; ctx.strokeRect(m.l, m.t, w - m.l - m.r, h - m.t - m.b);
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (const y of yticks) { const Y = py(y); if (Y < m.t - 1 || Y > h - m.b + 1) continue; ctx.strokeStyle = 'rgba(140,140,150,0.14)'; ctx.beginPath(); ctx.moveTo(m.l, Y); ctx.lineTo(w - m.r, Y); ctx.stroke(); ctx.fillStyle = cvarp('--text-muted'); ctx.fillText(fmtY(y), m.l - 6, Y); }
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    for (const x of xticks) { const X = px(x); if (X < m.l - 1 || X > w - m.r + 1) continue; ctx.fillText(fmtX(x), X, h - m.b + 6); }
    ctx.fillStyle = cvarp('--text-soft'); ctx.fillText(xlabel, (m.l + w - m.r) / 2, h - 13);
    ctx.save(); ctx.translate(13, (m.t + h - m.b) / 2); ctx.rotate(-PIp / 2); ctx.fillText(ylabel, 0, 0); ctx.restore();
    return { px, py, m, w, h };
  }
  function ticksNice(min: number, max: number, n = 6): number[] {
    const span = max - min; if (span <= 0) return [min];
    const raw = span / n, mag = Math.pow(10, Math.floor(Math.log10(raw))), norm = raw / mag;
    const step = (norm < 1.5 ? 1 : norm < 3 ? 2 : norm < 7 ? 5 : 10) * mag;
    const out: number[] = []; for (let v = Math.ceil(min / step) * step; v <= max + step * 0.01; v += step) out.push(Math.abs(v) < step * 1e-6 ? 0 : v);
    return out;
  }
  const HOT = (t: number): number[] => { t = Math.max(0, Math.min(1, t)); const r = Math.min(1, t * 3), g = Math.min(1, Math.max(0, t * 3 - 1)), b = Math.min(1, Math.max(0, t * 3 - 2)); return [r * 255, g * 255, b * 255]; };
  const MAGMA_STOPS = [[0, 0, 4], [40, 11, 84], [101, 21, 110], [159, 42, 99], [212, 72, 66], [245, 125, 21], [250, 193, 39], [252, 253, 191]];
  const MAGMA = (t: number): number[] => { t = Math.max(0, Math.min(1, t)); const x = t * (MAGMA_STOPS.length - 1), i = Math.min(MAGMA_STOPS.length - 2, Math.floor(x)), f = x - i, a = MAGMA_STOPS[i], b = MAGMA_STOPS[i + 1]; return [a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f]; };
  function heatmap(ctx: CanvasRenderingContext2D, fr: Frame, nx: number, ny: number, data: Float64Array, cmap: (t: number) => number[], smooth = true) {
    const off = document.createElement('canvas'); off.width = nx; off.height = ny; const octx = off.getContext('2d')!; const img = octx.createImageData(nx, ny);
    for (let iy = 0; iy < ny; iy++) for (let ix = 0; ix < nx; ix++) {
      const t = data[iy * nx + ix], pi = ((ny - 1 - iy) * nx + ix) * 4; const rgb = Number.isFinite(t) ? cmap(t) : [0, 0, 0];
      img.data[pi] = rgb[0]; img.data[pi + 1] = rgb[1]; img.data[pi + 2] = rgb[2]; img.data[pi + 3] = 255;
    }
    octx.putImageData(img, 0, 0);
    const { m, w, h } = fr; ctx.imageSmoothingEnabled = smooth; ctx.drawImage(off, m.l, m.t, w - m.l - m.r, h - m.t - m.b);
    ctx.strokeStyle = cvarp('--bg-muted'); ctx.lineWidth = 1; ctx.strokeRect(m.l, m.t, w - m.l - m.r, h - m.t - m.b);
  }
  function colorbar(ctx: CanvasRenderingContext2D, fr: Frame, cmap: (t: number) => number[], loLabel: string, hiLabel: string) {
    const { m, w, h } = fr, cbx = w - m.r + 6, cbh = h - m.t - m.b, NB = 48;
    for (let i = 0; i < NB; i++) { const rgb = cmap(i / (NB - 1)); ctx.fillStyle = `rgb(${rgb[0] | 0},${rgb[1] | 0},${rgb[2] | 0})`; ctx.fillRect(cbx, m.t + cbh - (i + 1) / NB * cbh, 8, cbh / NB + 1); }
    ctx.strokeStyle = cvarp('--bg-muted'); ctx.strokeRect(cbx, m.t, 8, cbh);
    ctx.fillStyle = cvarp('--text-muted'); ctx.font = '9px ' + (cvarp('--font') || 'sans-serif'); ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    ctx.fillText(hiLabel, cbx + 11, m.t + 4); ctx.fillText(loLabel, cbx + 11, m.t + cbh - 4);
  }

  // sub-tabs
  const PN_SUBTABS: Record<string, { id: string; label: string }[]> = {
    spectrum: [{ id: 'probability', label: 'Probability' }, { id: 'eels', label: 'EELS' }, { id: 'propagation', label: 'Propagation' }],
    billiard: [],
  };
  function renderPnSubTabs() {
    const box = $p('pn-sub-tabs'); box.innerHTML = '';
    const subs = PN_SUBTABS[pn.view];
    box.style.display = subs.length ? '' : 'none';
    for (const t of subs) {
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'sp-sub-tab' + (pn.sub === t.id ? ' active' : ''); btn.textContent = t.label; btn.dataset.sub = t.id;
      btn.addEventListener('click', () => { pn.sub = t.id as any; renderPnSubTabs(); renderPn(); });
      box.appendChild(btn);
    }
  }

  // render dispatch
  function updatePnControlVis() {
    const isBill = pn.view === 'billiard';
    ($p('pn-range-N') as HTMLElement).hidden = !(pn.sub === 'probability' || isBill);
    ($p('pn-range-eels') as HTMLElement).hidden = isBill || pn.sub !== 'eels';
    ($p('pn-range-prop') as HTMLElement).hidden = isBill || pn.sub !== 'propagation';
    ($p('pn-range-billiard') as HTMLElement).hidden = !isBill;
  }
  let pnPropRaf = 0, pnChart = '';
  const setPnComputing = (on: boolean) => $p('pn-result-card').classList.toggle('is-computing', on);
  function renderPn() {
    updatePnControlVis();
    const title = $p('pn-chart-title');
    const isProp = pn.view !== 'billiard' && pn.sub === 'propagation';
    // navigating away from propagation cancels any pending compute + clears the loading rim
    if (pnPropRaf && !isProp) { cancelAnimationFrame(pnPropRaf); pnPropRaf = 0; setPnComputing(false); }
    if (pn.view === 'billiard') { title.textContent = 'Billiard — Pₙ vs coupling |g| (Rabi / quantum walk)'; drawBilliard(); updateMetrics(); pnChart = 'billiard'; }
    else if (pn.sub === 'probability') { title.textContent = `Sideband probabilities Pₙ = Jₙ(2|g|)²  ·  |g| = ${pn.absg}`; drawProbability(); updateMetrics(); pnChart = 'prob'; }
    else if (pn.sub === 'eels') { title.textContent = `EELS spectrum  ·  |g| = ${pn.absg}, Γ = ${pn.fwhmEV} eV`; drawEELS(); updateMetrics(); pnChart = 'eels'; }
    else {
      // Propagation is expensive — paint an empty frame + spin the loading rim first,
      // then compute the carpet on a later frame so the page stays responsive.
      title.textContent = `Co-moving charge density ρ(z, τ)  ·  |g| = ${pn.absg}`;
      if (pnChart !== 'prop') drawPropagation(false);   // fresh entry → instant empty plot
      updateMetrics(false);                              // cheap tiles now, focus deferred
      setPnComputing(true);
      if (pnPropRaf) cancelAnimationFrame(pnPropRaf);
      pnPropRaf = requestAnimationFrame(() => requestAnimationFrame(() => {
        pnPropRaf = 0;
        drawPropagation(true);
        updateMetrics(true);
        setPnComputing(false);
      }));
      pnChart = 'prop';
    }
  }

  function drawProbability() {
    const c = ctx2dP($p('pn-chart') as HTMLCanvasElement); if (!c) return; const { ctx, w, h } = c;
    const { N, P } = sidebandProbabilities(pn.absg, pn.nmax);
    const ns = pn.nshow; let pmax = 0; for (let i = 0; i < N.length; i++) if (Math.abs(N[i]) <= ns) pmax = Math.max(pmax, P[i]);
    pmax = Math.max(pmax, 1e-6);
    const fr = frameP(ctx, w, h, -ns - 0.6, ns + 0.6, 0, pmax * 1.08, 'photon order N', 'Pₙ', ticksNice(-ns, ns).filter(v => Number.isInteger(v)), ticksNice(0, pmax * 1.08), v => String(Math.round(v)), v => v.toFixed(2));
    const bw = Math.max(2, (fr.px(1) - fr.px(0)) * 0.7);
    for (let i = 0; i < N.length; i++) { if (Math.abs(N[i]) > ns) continue; const X = fr.px(N[i]), y0 = fr.py(0), y1 = fr.py(P[i]); ctx.fillStyle = N[i] === 0 ? cvarp('--primary') : 'rgba(99,102,241,0.6)'; ctx.fillRect(X - bw / 2, y1, bw, y0 - y1); }
    let psum = 0; for (const p of P) psum += p;
    $p('pn-readout').innerHTML = `<span>2|g| (Rabi phase) = <b>${(2 * pn.absg).toFixed(2)}</b></span><span>Σ Pₙ = <b>${psum.toFixed(4)}</b> (nₘₐₓ = ${pn.nmax})</span>`;
  }

  function drawEELS() {
    const c = ctx2dP($p('pn-chart') as HTMLCanvasElement); if (!c) return; const { ctx, w, h } = c;
    const b = pnBeam(), NE = 800, e0 = Math.min(pn.eMinEV, pn.eMaxEV), e1 = Math.max(pn.eMinEV, pn.eMaxEV);
    const E = new Float64Array(NE); for (let i = 0; i < NE; i++) E[i] = e0 + (e1 - e0) * i / (NE - 1);
    const S = pinemSpectrum(pn.absg, E, pn.fwhmEV, beamPhotonEV(b), pn.nmax, true);
    const fr = frameP(ctx, w, h, e0, e1, 0, 1.08, 'electron energy loss / gain (eV)', 'norm. probability', ticksNice(e0, e1), ticksNice(0, 1), v => v.toFixed(0), v => v.toFixed(1));
    const { N, P } = sidebandProbabilities(pn.absg, pn.nmax); let pmax = 0; for (const p of P) pmax = Math.max(pmax, p);
    ctx.strokeStyle = 'rgba(140,140,150,0.5)'; ctx.lineWidth = 1;
    for (let i = 0; i < N.length; i++) { if (P[i] < 1e-4) continue; const Ei = N[i] * beamPhotonEV(b); if (Ei < e0 || Ei > e1) continue; const X = fr.px(Ei); ctx.beginPath(); ctx.moveTo(X, fr.py(0)); ctx.lineTo(X, fr.py(P[i] / pmax)); ctx.stroke(); }
    ctx.save(); ctx.beginPath(); ctx.rect(fr.m.l, fr.m.t, w - fr.m.l - fr.m.r, h - fr.m.t - fr.m.b); ctx.clip();
    ctx.strokeStyle = cvarp('--primary'); ctx.lineWidth = 2; ctx.beginPath();
    for (let i = 0; i < NE; i++) { const X = fr.px(E[i]), Y = fr.py(S[i]); i ? ctx.lineTo(X, Y) : ctx.moveTo(X, Y); } ctx.stroke(); ctx.restore();
    $p('pn-readout').innerHTML = `<span>sideband spacing &#8463;&omega; = <b>${beamPhotonEV(b).toFixed(3)} eV</b></span><span>Lorentzian FWHM Γ = <b>${pn.fwhmEV} eV</b> · grey stems = bare Pₙ</span>`;
  }

  function drawPropagation(withData = true) {
    const c = ctx2dP($p('pn-chart') as HTMLCanvasElement); if (!c) return; const { ctx, w, h } = c;
    const b = pnBeam(), T = beamPeriodS(b);
    const zMaxM = pn.fullTalbot ? talbotDistanceM(b) : pn.zMaxMm * 1e-3;
    const tauHi = pn.tauRange * T, zMm = zMaxM * 1e3, tauFs = tauHi * 1e15;
    const fr = frameP(ctx, w, h, 0, zMm, -tauFs, tauFs, 'propagation distance z (mm)', 'retarded time τ (fs)', ticksNice(0, zMm), ticksNice(-tauFs, tauFs), v => v.toFixed(zMm > 20 ? 0 : 1), v => v.toFixed(0));
    if (!withData) {
      ctx.fillStyle = cvarp('--text-muted'); ctx.font = '12px ' + (cvarp('--font') || 'sans-serif'); ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('computing density…', (fr.m.l + w - fr.m.r) / 2, (fr.m.t + h - fr.m.b) / 2);
      $p('pn-readout').innerHTML = `<span>computing charge density…</span><span>τ: ±${pn.tauRange} T · dispersion: ${pn.method}</span>`;
      return;
    }
    const NZ = 300, NT = 180;
    const zArr = new Float64Array(NZ); for (let i = 0; i < NZ; i++) zArr[i] = zMaxM * i / (NZ - 1);
    const tauArr = new Float64Array(NT); for (let i = 0; i < NT; i++) tauArr[i] = -tauHi + 2 * tauHi * i / (NT - 1);
    const coh = pn.cohNm > 0 ? pn.cohNm * 1e-9 : null;
    const fld = chargeDensity(pn.absg, pn.phaseDeg * PIp / 180, zArr, tauArr, b, pn.nmax, pn.method, coh, true);
    const data = new Float64Array(NZ * NT);
    for (let it = 0; it < NT; it++) for (let iz = 0; iz < NZ; iz++) data[it * NZ + iz] = fld.rho[iz * NT + it];
    heatmap(ctx, fr, NZ, NT, data, HOT);
    colorbar(ctx, fr, HOT, '0', '1');
    $p('pn-readout').innerHTML = `<span>z: 0 → <b>${formatLengthText(zMaxM)}</b>${pn.fullTalbot ? ' (Talbot z_T)' : ''} · τ: ±${pn.tauRange} T</span><span>dispersion: <b>${pn.method}</b>${pn.cohNm > 0 ? ` · coherence ${pn.cohNm} nm` : ''}</span>`;
  }

  function drawBilliard() {
    const c = ctx2dP($p('pn-chart') as HTMLCanvasElement); if (!c) return; const { ctx, w, h } = c;
    const b = pnBeam(), ns = pn.nshow, NX = 240, NY = 2 * ns + 1;
    const data = new Float64Array(NX * NY);
    for (let ix = 0; ix < NX; ix++) {
      const g = pn.gMax * ix / (NX - 1);
      const { N, P } = sidebandProbabilities(g, pn.nmax);
      let cmax = 1e-9; for (let i = 0; i < N.length; i++) if (Math.abs(N[i]) <= ns) cmax = Math.max(cmax, P[i]);
      for (let i = 0; i < N.length; i++) { const n = N[i]; if (Math.abs(n) > ns) continue; const iy = n + ns; data[iy * NX + ix] = P[i] / cmax; }
    }
    const fr = frameP(ctx, w, h, 0, pn.gMax, -ns - 0.5, ns + 0.5, 'coupling |g|', 'photon order N', ticksNice(0, pn.gMax), ticksNice(-ns, ns).filter(Number.isInteger), v => v.toFixed(1), v => String(Math.round(v)));
    heatmap(ctx, fr, NX, NY, data, MAGMA, false);   // discrete photon orders N — no vertical interpolation
    colorbar(ctx, fr, MAGMA, '0', '1');
    $p('pn-readout').innerHTML = `<span>per-column normalized Pₙ · N = ±${ns}</span><span>energy = N·&#8463;&omega; = N·<b>${beamPhotonEV(b).toFixed(2)} eV</b></span>`;
  }

  // attosecond-pulse metrics
  function metric(label: string, val: string): string { return `<div class="pn-metric"><span class="pn-metric__label">${label}</span><span class="pn-metric__val">${val}</span></div>`; }
  function updateMetrics(withFocus = true) {
    // one decimal, at least two significant figures, in nm / µm / mm / m as fits —
    // always millimetres used to print a short z_T as 0.0 mm
    const b = pnBeam(), zT = formatLength(talbotDistanceM(b));
    let html = metric('Talbot distance z_T', `${zT.value} <em>${zT.unit}</em>`)
      + metric('Photon energy &#8463;&omega;', `${beamPhotonEV(b).toFixed(3)} <em>eV</em>`)
      + metric('Optical period T', `${(beamPeriodS(b) * 1e15).toFixed(3)} <em>fs</em>`)
      + metric('Electron v/c', `${pn.beta.toFixed(4)}`);
    if (pn.view === 'spectrum' && pn.sub === 'propagation' && pn.absg > 0.2) {
      if (!withFocus) {   // focus is computed on the deferred frame — show placeholders meanwhile
        html += metric('Attosecond FWHM', `<em>…</em>`) + metric('Temporal focus z', `<em>…</em>`) + metric('Spike position τ', `<em>…</em>`);
      } else {
        const zScanM = pn.fullTalbot ? talbotDistanceM(b) : pn.zMaxMm * 1e-3;
        const f = analyzeFocus(pn.absg, pn.phaseDeg * PIp / 180, b, zScanM, pn.nmax, pn.method);
        html += metric('Attosecond FWHM', `${(f.fwhmS * 1e18).toFixed(0)} <em>as</em>`)
          + metric('Temporal focus z', `${(f.zFocusM * 1e3).toFixed(2)} <em>mm</em>`)
          + metric('Spike position τ', `${(f.spikeTauS * 1e15).toFixed(2)} <em>fs</em>`);
      }
    }
    $p('pn-metrics-grid').innerHTML = html;
  }

  // controls wiring
  const betaToKeV = (be: number) => betaToEnergyEV(be) / 1000;
  const keVToBeta = (K: number) => energyEVToBeta(K * 1000);
  function pnSyncBeta(beta: number, src?: string) {
    pn.beta = Math.max(0.001, Math.min(0.999, beta));
    if (src !== 'vc') ($p('pn-vc') as HTMLInputElement).value = String(+pn.beta.toFixed(4));
    if (src !== 'kev') ($p('pn-kev') as HTMLInputElement).value = String(+betaToKeV(pn.beta).toPrecision(5));
  }
  ($p('pn-vc') as HTMLInputElement).addEventListener('input', e => { const v = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(v) && v > 0 && v < 1) { pnSyncBeta(v, 'vc'); renderPn(); } });
  ($p('pn-kev') as HTMLInputElement).addEventListener('input', e => { const K = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(K) && K > 0) { pnSyncBeta(keVToBeta(K), 'kev'); renderPn(); } });

  function pnBindNum(id: string, key: keyof typeof pn, isInt = false) {
    const num = $p(id) as HTMLInputElement, slider = document.getElementById(id + '-slider') as HTMLInputElement | null;
    const apply = (raw: string, from: HTMLInputElement) => { let v = parseFloat(raw); if (!Number.isFinite(v)) return; if (isInt) v = Math.round(v); (pn as any)[key] = v; const other = from === num ? slider : num; if (other) other.value = String(v); renderPn(); };
    num.addEventListener('input', () => apply(num.value, num));
    if (slider) slider.addEventListener('input', () => apply(slider.value, slider));
  }
  pnBindNum('pn-g', 'absg');

  function pnSetWavelength(nm: number, src: 'nm' | 'ev' | 'slider') {
    pn.wavelengthNm = Math.max(50, nm);
    if (src !== 'nm') ($p('pn-wl-nm') as HTMLInputElement).value = String(Math.round(pn.wavelengthNm));
    if (src !== 'ev') ($p('pn-wl-ev') as HTMLInputElement).value = eVFromWavelengthNm(pn.wavelengthNm).toFixed(3);
    if (src !== 'slider') ($p('pn-wl-slider') as HTMLInputElement).value = pn.wlUnit === 'nm' ? String(Math.round(pn.wavelengthNm)) : eVFromWavelengthNm(pn.wavelengthNm).toFixed(3);
    renderPn();
  }
  ($p('pn-wl-nm') as HTMLInputElement).addEventListener('input', e => { const nm = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(nm) && nm > 0) pnSetWavelength(nm, 'nm'); });
  ($p('pn-wl-ev') as HTMLInputElement).addEventListener('input', e => { const ev = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(ev) && ev > 0) pnSetWavelength(wavelengthNmFromEV(ev), 'ev'); });
  ($p('pn-wl-slider') as HTMLInputElement).addEventListener('input', e => { const v = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(v) && v > 0) pnSetWavelength(pn.wlUnit === 'nm' ? v : wavelengthNmFromEV(v), 'slider'); });
  $p('pn-wl-unit').addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('button[data-wu]') as HTMLButtonElement | null; if (!btn) return;
    const unit = btn.dataset.wu as 'nm' | 'eV'; if (unit === pn.wlUnit) return; pn.wlUnit = unit;
    const sl = $p('pn-wl-slider') as HTMLInputElement;
    if (unit === 'nm') { sl.min = '200'; sl.max = '2000'; sl.step = '5'; sl.value = String(Math.round(pn.wavelengthNm)); }
    else { sl.min = '0.4'; sl.max = '6'; sl.step = '0.01'; sl.value = eVFromWavelengthNm(pn.wavelengthNm).toFixed(3); }
    $p('pn-wl-unit').querySelectorAll('button').forEach(b => { const a = (b as HTMLElement).dataset.wu === unit; b.classList.toggle('active', a); b.setAttribute('aria-pressed', a ? 'true' : 'false'); });
  });

  const pnBindRange = (id: string, key: keyof typeof pn, isInt = false) => ($p(id) as HTMLInputElement).addEventListener('input', e => { let v = parseFloat((e.target as HTMLInputElement).value); if (!Number.isFinite(v)) return; if (isInt) v = Math.round(v); (pn as any)[key] = v; renderPn(); });
  pnBindNum('pn-fwhm', 'fwhmEV');   // number + slider, like Coupling |g|
  pnBindRange('pn-nshow', 'nshow', true); pnBindRange('pn-emin', 'eMinEV'); pnBindRange('pn-emax', 'eMaxEV');
  pnBindRange('pn-taurange', 'tauRange'); pnBindRange('pn-zmax', 'zMaxMm'); pnBindRange('pn-coh', 'cohNm'); pnBindRange('pn-gmax', 'gMax'); pnBindRange('pn-nmax', 'nmax', true);

  $p('pn-zt-btn').addEventListener('click', () => {
    pn.fullTalbot = !pn.fullTalbot;
    $p('pn-zt-btn').setAttribute('aria-pressed', pn.fullTalbot ? 'true' : 'false');
    ($p('pn-zmax') as HTMLInputElement).disabled = pn.fullTalbot;
    ($p('pn-zrange-label') as HTMLElement).textContent = pn.fullTalbot ? 'Distance z — full Talbot carpet' : 'Distance z (mm)';
    renderPn();
  });

  $p('pn-method').addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('button[data-dm]') as HTMLButtonElement | null; if (!btn) return;
    pn.method = btn.dataset.dm as DispMethod;
    $p('pn-method').querySelectorAll('button').forEach(b => { const a = (b as HTMLElement).dataset.dm === pn.method; b.classList.toggle('active', a); b.setAttribute('aria-pressed', a ? 'true' : 'false'); });
    renderPn();
  });

  $p('pn-view-tabs').addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('.sp-view-tab') as HTMLButtonElement | null; if (!btn) return;
    pn.view = btn.dataset.view as any;
    $p('pn-view-tabs').querySelectorAll('.sp-view-tab').forEach(b => { const a = (b as HTMLElement).dataset.view === pn.view; b.classList.toggle('active', a); b.setAttribute('aria-selected', a ? 'true' : 'false'); });
    renderPnSubTabs(); renderPn();
  });

  $p('pn-ex-1').addEventListener('click', () => {
    pnSyncBeta(keVToBeta(120)); pn.absg = 5.7; pn.phaseDeg = 0; pn.zMaxMm = 5; pn.fullTalbot = false; pn.method = 'exact';
    ($p('pn-g') as HTMLInputElement).value = '5.7'; ($p('pn-g-slider') as HTMLInputElement).value = '5.7';
    ($p('pn-zmax') as HTMLInputElement).value = '5'; ($p('pn-zmax') as HTMLInputElement).disabled = false;
    $p('pn-zt-btn').setAttribute('aria-pressed', 'false');
    pnSetWavelength(800, 'slider');
    pn.view = 'spectrum'; pn.sub = 'propagation';
    $p('pn-view-tabs').querySelectorAll('.sp-view-tab').forEach(b => { const a = (b as HTMLElement).dataset.view === 'spectrum'; b.classList.toggle('active', a); b.setAttribute('aria-selected', a ? 'true' : 'false'); });
    renderPnSubTabs(); renderPn();
  });

  function pnChartName(): string { return pn.view === 'billiard' ? 'pinem_billiard' : `pinem_${pn.sub}`; }
  $p('pn-export-png').addEventListener('click', () => { const cv = $p('pn-chart') as HTMLCanvasElement; cv.toBlob(bl => { if (bl) pnDownload(bl, pnChartName() + '.png'); }); });
  $p('pn-export-csv').addEventListener('click', () => {
    const b = pnBeam(); const name = pnChartName() + '.csv'; let csv = '';
    if (pn.view === 'billiard') { const rows = ['g,N,P_N']; for (let ix = 0; ix <= 120; ix++) { const g = pn.gMax * ix / 120; const { N, P } = sidebandProbabilities(g, pn.nmax); for (let i = 0; i < N.length; i++) if (Math.abs(N[i]) <= pn.nshow) rows.push(`${g.toFixed(4)},${N[i]},${P[i].toPrecision(6)}`); } csv = rows.join('\n'); }
    else if (pn.sub === 'probability') { const { N, P } = sidebandProbabilities(pn.absg, pn.nmax); const rows = ['N,P_N']; for (let i = 0; i < N.length; i++) if (Math.abs(N[i]) <= pn.nshow) rows.push(`${N[i]},${P[i].toPrecision(6)}`); csv = rows.join('\n'); }
    else if (pn.sub === 'eels') { const NE = 1000, e0 = Math.min(pn.eMinEV, pn.eMaxEV), e1 = Math.max(pn.eMinEV, pn.eMaxEV); const E = new Float64Array(NE); for (let i = 0; i < NE; i++) E[i] = e0 + (e1 - e0) * i / (NE - 1); const S = pinemSpectrum(pn.absg, E, pn.fwhmEV, beamPhotonEV(b), pn.nmax, true); const rows = ['E_eV,S']; for (let i = 0; i < NE; i++) rows.push(`${E[i].toPrecision(6)},${S[i].toPrecision(6)}`); csv = rows.join('\n'); }
    else { const T = beamPeriodS(b), zMaxM = pn.fullTalbot ? talbotDistanceM(b) : pn.zMaxMm * 1e-3, tauHi = pn.tauRange * T; const NZ = 120, NT = 120; const zArr = new Float64Array(NZ); for (let i = 0; i < NZ; i++) zArr[i] = zMaxM * i / (NZ - 1); const tauArr = new Float64Array(NT); for (let i = 0; i < NT; i++) tauArr[i] = -tauHi + 2 * tauHi * i / (NT - 1); const coh = pn.cohNm > 0 ? pn.cohNm * 1e-9 : null; const fld = chargeDensity(pn.absg, pn.phaseDeg * PIp / 180, zArr, tauArr, b, pn.nmax, pn.method, coh, true); const rows = ['z_mm,tau_fs,rho']; for (let iz = 0; iz < NZ; iz++) for (let it = 0; it < NT; it++) rows.push(`${(zArr[iz] * 1e3).toPrecision(6)},${(tauArr[it] * 1e15).toPrecision(6)},${fld.rho[iz * NT + it].toPrecision(5)}`); csv = rows.join('\n'); }
    pnDownload(new Blob([csv], { type: 'text/csv' }), name);
  });

  let pnRT: number; window.addEventListener('resize', () => { clearTimeout(pnRT); pnRT = window.setTimeout(() => { if (!($p('panel-pinem') as HTMLElement).hidden) renderPn(); }, 120); });

  let pnReady = false;
  (window as any).__pinemActivate = (beta: number) => {
    if (beta > 0 && beta < 1) pnSyncBeta(beta); else pnSyncBeta(pn.beta);
    if (!pnReady) { pnReady = true; renderPnSubTabs(); }
    renderPn();
  };
  pnSyncBeta(pn.beta);
</script>

<!-- ===================== Transition-radiation module ===================== -->
<script>
  /**
   * Transition radiation from a semi-infinite half space or a free-standing
   * film. All physics comes from src/lib/transition-radiation.ts (the port of
   * the validated Python `trlib`); this block only resolves ε, lays out grids,
   * draws and exports. Nothing here re-derives a formula.
   */
  import {
    betaFromKeV, energyFromBeta, gaussLegendre, perNmToPerEv,
    interfaceSpectrum, interfaceSrPerNm,
    filmSpectrum, filmSrPerNm, thicknessMap, thickFilmLimitSrPerNm,
    perfectConductorSrPerNm, resonanceThicknessNm,
    wavelengthToEv, evToWavelength,
    type C, type TrSide, type FilmTerm,
  } from '../../lib/transition-radiation';
  import { MATERIALS, interpolateNK, nkToEpsilon, epsilonToNK, drudeEpsilon } from '../../lib/materials';
  import { setupRIISearch } from '../../lib/material-picker';
  import {
    parseOpticalFile, convertOpticalRows, inferImportModes,
    type ImportAxisMode, type ImportValueMode, type RawOpticalRow,
  } from '../../lib/optical-file';
  import { downloadBlob as trDownload } from '../../lib/download';
  import { chartTheme as trChartTheme, onThemeChange as trOnThemeChange } from '../../lib/chart-theme';

  const $t = (id: string) => document.getElementById(id) as HTMLElement;
  const $ti = (id: string) => document.getElementById(id) as HTMLInputElement;
  const TPI = Math.PI, TDEG = Math.PI / 180;
  const tvar = (n: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim() || '#888';

  type TrView = 'spectrum' | 'angular' | 'thickness' | 'terms' | 'material';

  const tr = {
    beta: 0.5,
    geom: 'half' as 'half' | 'film',
    dNm: 200,
    material: 'ag',
    /** Mirrors the custom-ε handle, so every label, export and share link reads one number. */
    epsRe: -10, epsIm: 0.5,
    /** Degenerate ε = 0: the formulas divide by it, so the kernel gets the ε → 0 limit instead. */
    epsDegenerate: false,
    drudeEpsB: 1, drudeWp: 9, drudeGamma: 0.1,
    /** What the Material view plots — the Mie lab's ε / n,k display switch. */
    matProp: 'eps' as 'eps' | 'nk',
    side: 'backward' as TrSide,
    thMin: 0, thMax: 90,
    lamMin: 300, lamMax: 900,
    unit: 'nm' as 'nm' | 'eV',
    view: 'spectrum' as TrView,
    lamNm: 600,
    dMapMin: 5, dMapMax: 400,
    overlay: true,
  };

  // user-supplied optical constants (uploaded file or refractiveindex.info entry)
  let trTable: number[][] | null = null;
  let trTableKind: 'file' | 'rii' | null = null;
  let trTableLabel = '';
  let trRiiPath: string | null = null;
  let trFileRows: RawOpticalRow[] | null = null;   // raw rows, so axis/values can be re-read without re-opening the file
  let trFileName = '';
  let trSharedRiiMissing = false;

  // ── custom dielectric: the Mie lab's control, mirrored ───────────────────
  //
  // mie-scattering.astro ships setupParamEl / setupTabsEl / setupCustomEps and
  // the markup above reuses its class names so lab.css's tinted .custom-eps
  // panel and the derived-read-out styling apply unchanged. The behaviour is
  // mirrored here rather than lifted into src/lib: hoisting it would mean
  // editing mie-scattering.astro to import it back, and that lab is out of
  // scope for this change. The contract is the same, down to the rounding —
  // see the comments in mie-scattering.astro for why each rule is what it is.

  /**
   * Two decimals, trailing zeros dropped — but five below 0.1, because k is the
   * quantity a mode switch rounds and Im ε = 2nk: at k = 0.002 two decimals turn
   * a weakly absorbing material into a perfectly transparent one.
   */
  const trRoundEps = (v: number) => {
    const dp = Math.abs(v) < 0.1 ? 100000 : 100;
    return Math.round(v * dp) / dp;
  };
  const trFmtEpsVal = (v: number) => String(trRoundEps(v));
  /** Links and exports keep what was typed, not what is shown. */
  const trFmtEpsFull = (v: number) => String(Math.round(v * 100000) / 100000);
  /** One minus glyph throughout: "−10 + 0.5i". */
  function trFmtEpsLabel(re: number, im: number): string {
    const r = trFmtEpsVal(re).replace('-', '−');
    return im === 0 ? r : `${r} ${im < 0 ? '−' : '+'} ${trFmtEpsVal(Math.abs(im))}i`;
  }
  /** n² + k² below this is ε = 0, which the TR formulas divide by. */
  const TR_EPS_DEGENERATE = 1e-18;
  const TR_EPS_ROWS = ['re', 'im', 'n', 'k'] as const;

  interface TrParamHandle {
    readonly value: number;
    /** Take `v`, widening the slider's own window first if `v` falls outside it. */
    fit(v: number): void;
  }
  /**
   * One value driven by a precise number box and a coarse slider. The value is
   * held here, not read back out of the slider: a range input quantises
   * whatever is assigned to it, so routing through `slider.value` would make
   * the step the resolution limit of the whole control.
   */
  function trSetupParamEl(
    num: HTMLInputElement, slider: HTMLInputElement, minIn: HTMLInputElement, maxIn: HTMLInputElement,
    fmt: (v: number) => string, onChange: () => void, floor = -Infinity,
  ): TrParamHandle {
    const clamp = (v: number) => Math.max(Math.max(floor, parseFloat(slider.min)), Math.min(parseFloat(slider.max), v));
    function apply(v: number) {
      num.value = fmt(v);
      current = parseFloat(num.value);      // read back, so the value is exactly what is on screen
      slider.value = String(current);       // thumb only
    }
    let current = clamp(parseFloat(num.value) || 0);
    slider.addEventListener('input', () => { num.value = fmt(parseFloat(slider.value)); current = parseFloat(num.value); onChange(); });
    num.addEventListener('change', () => { apply(clamp(parseFloat(num.value) || 0)); onChange(); });
    function widen() {
      const raw = parseFloat(minIn.value), hi = parseFloat(maxIn.value);
      if (!Number.isFinite(raw) || !Number.isFinite(hi)) return;
      // `min=` in the markup is only a validity hint — the floor is what holds
      // Im ε, n and k at zero when the window itself is widened.
      const lo = Math.max(floor, raw);
      if (lo >= hi) return;
      if (lo !== raw) minIn.value = String(lo);
      slider.min = String(lo); slider.max = String(hi); apply(clamp(current)); onChange();
    }
    minIn.addEventListener('change', widen); maxIn.addEventListener('change', widen);
    return {
      get value() { return current; },
      fit(v: number) {
        if (!Number.isFinite(v)) return;
        v = Math.max(floor, v);
        if (v < parseFloat(slider.min)) { slider.min = String(v); minIn.value = String(v); }
        if (v > parseFloat(slider.max)) { slider.max = String(v); maxIn.value = String(v); }
        apply(v); onChange();
      },
    };
  }

  interface TrTabHandle { readonly value: string; select(v: string, silent?: boolean): void; }
  function trSetupTabsEl(container: HTMLElement, attr: string, init: string, onSel: (v: string) => void): TrTabHandle {
    const tabs = container.querySelectorAll<HTMLButtonElement>('.plot-tab');
    const mark = (hit: HTMLButtonElement) => tabs.forEach(t => {
      const a = t === hit;
      t.classList.toggle('active', a); t.setAttribute('aria-checked', a ? 'true' : 'false');
    });
    let cur = init;
    tabs.forEach(t => t.addEventListener('click', () => {
      if (t.disabled) return;
      mark(t); cur = t.dataset[attr]!; onSel(cur);
    }));
    return {
      get value() { return cur; },
      select(v: string, silent = false) {
        for (const t of tabs) {
          if (t.dataset[attr] === v) { mark(t); cur = v; if (!silent) onSel(v); return; }
        }
      },
    };
  }

  interface TrCustomEpsHandle {
    reParam: TrParamHandle; imParam: TrParamHandle; nParam: TrParamHandle; kParam: TrParamHandle;
    readonly mode: 'eps' | 'nk';
    setMode(m: 'eps' | 'nk'): void;
    /** ε = ε' + iε'', from the pair being typed — exactly as typed. */
    eps(): { re: number; im: number };
    /** True when the typed material is ε = 0, which is not a material. */
    degenerate(): boolean;
  }

  function trSetupCustomEps(root: HTMLElement, onChange: () => void): TrCustomEpsHandle {
    const input = (sel: string) => root.querySelector(sel) as HTMLInputElement;
    // `floor` is 0 for every row but Re ε: a negative Re ε is what a metal is,
    // a negative Im ε or k is gain, and a negative n is the wrong square root.
    const row = (name: string, floor = -Infinity) => trSetupParamEl(
      input(`.eps-${name}-num`), input(`.eps-${name}-slider`),
      input(`.eps-${name}-min`), input(`.eps-${name}-max`),
      trFmtEpsVal, commit, floor,
    );
    const epsPair = root.querySelector('.eps-pair--eps') as HTMLElement;
    const nkPair = root.querySelector('.eps-pair--nk') as HTMLElement;
    const echo = root.querySelector('.eps-echo') as HTMLElement;
    let mode: 'eps' | 'nk' = 'eps';
    // The fit() calls that carry a value across a mode switch must not be seen
    // as edits — the pair they write is only half-updated while they run.
    let adopting = false;

    function state(): { re: number; im: number; n: number; k: number } {
      if (mode === 'nk') {
        const e = nkToEpsilon(nP.value, kP.value);
        return { re: e.re, im: e.im, n: nP.value, k: kP.value };
      }
      const [n, k] = epsilonToNK(reP.value, imP.value);
      return { re: reP.value, im: imP.value, n, k };
    }

    function sync(): void {
      const s = state();
      const derivedNK = mode === 'eps';
      // The derived pair is a read-out, but it is written through its own
      // handles: a raw `.value =` never reaches the handle's `current`, and
      // anything reading it — the share link does — would get a stale number.
      const wasAdopting = adopting;
      adopting = true;
      try {
        if (derivedNK) { nP.fit(trRoundEps(s.n)); kP.fit(trRoundEps(s.k)); }
        else { reP.fit(trRoundEps(s.re)); imP.fit(trRoundEps(s.im)); }
      } finally { adopting = wasAdopting; }
      epsPair.classList.toggle('is-derived', !derivedNK);
      nkPair.classList.toggle('is-derived', derivedNK);
      for (const name of TR_EPS_ROWS) {
        const ro = derivedNK === (name === 'n' || name === 'k');
        const el = input(`.eps-${name}-num`);
        el.readOnly = ro;
        el.setAttribute('aria-readonly', ro ? 'true' : 'false');
        el.title = ro ? 'Computed from the pair being entered' : '';
      }
      const degenerate = s.n * s.n + s.k * s.k < TR_EPS_DEGENERATE;
      echo.textContent = `ε = ${trFmtEpsLabel(s.re, s.im)} · n = ${trFmtEpsVal(s.n)}, k = ${trFmtEpsVal(s.k)}`
        + (degenerate ? ' · ε = 0 is not a material — plotted as the ε → 0 limit' : '');
    }

    function commit(): void { if (adopting) return; sync(); onChange(); }

    const reP = row('re'), imP = row('im', 0), nP = row('n', 0), kP = row('k', 0);
    const modeTabs = trSetupTabsEl(
      root.querySelector('.eps-mode-tabs') as HTMLElement, 'epsMode', 'eps',
      v => setMode(v === 'nk' ? 'nk' : 'eps'),
    );

    function setMode(m: 'eps' | 'nk'): void {
      if (m === mode || adopting) return;
      const s = state();            // the material, read from the pair being left
      mode = m;
      adopting = true;
      try {
        // rounded, so the pair now being typed holds exactly what its box shows
        if (m === 'nk') { nP.fit(trRoundEps(s.n)); kP.fit(trRoundEps(s.k)); }
        else { reP.fit(trRoundEps(s.re)); imP.fit(trRoundEps(s.im)); }
      } finally { adopting = false; }
      modeTabs.select(m, true);
      commit();
    }

    sync();
    return {
      reParam: reP, imParam: imP, nParam: nP, kParam: kP,
      get mode() { return mode; },
      setMode,
      eps() { const s = state(); return { re: s.re, im: s.im }; },
      degenerate() { const s = state(); return s.n * s.n + s.k * s.k < TR_EPS_DEGENERATE; },
    };
  }

  // ── material → ε(λ) ──────────────────────────────────────────────────────
  const trActiveTable = (): number[][] | null =>
    (tr.material === 'file' || tr.material === 'rii') ? trTable : (MATERIALS[tr.material]?.data ?? null);
  const trMaterialReady = (): boolean =>
    tr.material === 'custom' || tr.material === 'drude' || !!trActiveTable();

  /** ε(λ) in the library's convention: Im ε ≥ 0 for an absorbing medium. */
  function epsAt(lambdaNm: number): C {
    if (tr.material === 'custom') {
      // ε = 0 sits one slider stop away and every TR amplitude divides by it
      // (σ + με, 1 − bσ, Δ); the ε → 0 limit is numerically flat, so take that
      // rather than hand the formulas a NaN. The echo line says so.
      if (tr.epsDegenerate) return [1e-18, 0];
      return [tr.epsRe, Math.max(0, tr.epsIm)];
    }
    if (tr.material === 'drude') {
      const e = drudeEpsilon(lambdaNm, { epsB: tr.drudeEpsB, wpEv: tr.drudeWp, gammaEv: tr.drudeGamma });
      return [e.re, Math.max(0, e.im)];
    }
    const data = trActiveTable();
    if (!data) return [1, 0];                       // nothing loaded → vacuum → no emission
    const [n, k] = interpolateNK(data, lambdaNm);
    const e = nkToEpsilon(n, k);
    return [e.re, Math.max(0, e.im)];
  }

  function trMaterialLabel(): string {
    if (tr.material === 'custom') return `ε = ${trFmtEpsLabel(tr.epsRe, tr.epsIm)}`;
    if (tr.material === 'drude') return `Drude (ħω_p = ${tr.drudeWp} eV)`;
    if (tr.material === 'file' || tr.material === 'rii') return trTableLabel || 'no data loaded';
    return MATERIALS[tr.material]?.label ?? tr.material;
  }
  function trMaterialRefText(): string {
    if (tr.material === 'rii' && trSharedRiiMissing) return 'Shared database entry is no longer available';
    if (tr.material === 'file' || tr.material === 'rii') return trTableLabel ? `data: ${trTableLabel}` : 'no data loaded yet';
    if (tr.material === 'custom') return 'non-dispersive ε, constant over the whole range';
    if (tr.material === 'drude') return 'ε = ε_b − ω_p²/[ω(ω + iγ)]';
    return MATERIALS[tr.material]?.ref ?? '';
  }

  // ── grids ────────────────────────────────────────────────────────────────
  const trKeV = () => energyFromBeta(tr.beta);
  const trLamLo = () => Math.max(1, Math.min(tr.lamMin, tr.lamMax));
  const trLamHi = () => Math.max(trLamLo() + 1, Math.max(tr.lamMin, tr.lamMax));
  const trD = () => Math.max(0.1, tr.dNm);

  /** Collected polar band [θ_min, θ_max] in rad, ordered and kept inside (0, π/2]. */
  function trCone(): [number, number] {
    const a = Math.max(0, Math.min(89.9, Math.min(tr.thMin, tr.thMax)));
    const b = Math.max(a + 0.1, Math.min(90, Math.max(tr.thMin, tr.thMax)));
    return [a * TDEG, b * TDEG];
  }

  /**
   * Sample grid, uniform in the *displayed* unit — so the thickness map's pixels
   * stay evenly spaced when the x axis is photon energy, not wavelength.
   */
  function trAxis(n: number): { lam: Float64Array; x: Float64Array } {
    const lo = trLamLo(), hi = trLamHi();
    const lam = new Float64Array(n), x = new Float64Array(n);
    if (tr.unit === 'eV') {
      const e0 = wavelengthToEv(hi), e1 = wavelengthToEv(lo);
      for (let i = 0; i < n; i++) { const e = e0 + (e1 - e0) * i / (n - 1); x[i] = e; lam[i] = evToWavelength(e); }
    } else {
      for (let i = 0; i < n; i++) { const l = lo + (hi - lo) * i / (n - 1); x[i] = l; lam[i] = l; }
    }
    return { lam, x };
  }

  const TR_NSPEC = 240, TR_NTHETA = 96;
  const TR_NANG = 181;
  const TR_NDMAP = 140, TR_NLMAP = 200, TR_NTHMAP = 48;

  /** Angle-integrated spectrum of the active geometry (photons per electron per nm or per eV). */
  function trSpectrumOn(lam: Float64Array, terms?: readonly FilmTerm[]): Float64Array {
    const [t0, t1] = trCone();
    const common = {
      wavelengthNm: lam, eps: epsAt, energyKeV: trKeV(), side: tr.side,
      thetaMinRad: t0, thetaMaxRad: t1, nTheta: TR_NTHETA, per: tr.unit,
    };
    if (tr.geom === 'film') return filmSpectrum({ ...common, thicknessNm: trD(), ...(terms ? { terms } : {}) });
    return interfaceSpectrum({ ...common, side: 'backward' });
  }

  /**
   * The d → ∞ limit of the film formulas, integrated over the same cone —
   * the semi-infinite curve the film tends to. `thickFilmLimitSrPerNm` is the
   * library's closed form; only the quadrature (its own `gaussLegendre`) is here.
   */
  function trThickLimit(lam: Float64Array): Float64Array {
    const [t0, t1] = trCone();
    const { x: th, w: wt } = gaussLegendre(t0, t1, TR_NTHETA);
    const K = trKeV(), out = new Float64Array(lam.length);
    for (let l = 0; l < lam.length; l++) {
      const e = epsAt(lam[l]);
      let acc = 0;
      for (let i = 0; i < th.length; i++) {
        acc += 2 * TPI * wt[i] * Math.sin(th[i]) * thickFilmLimitSrPerNm(th[i], lam[l], K, e, tr.side);
      }
      out[l] = tr.unit === 'eV' ? perNmToPerEv(acc, lam[l]) : acc;
    }
    return out;
  }

  /**
   * Ginzburg–Frank is the *backward* perfect-conductor limit: a perfect mirror
   * transmits nothing, so it has no forward counterpart and must not be drawn
   * beside a film's forward lobe, where it would be a different quantity at a
   * comparable magnitude.
   */
  const trRefShown = () => !(tr.geom === 'film' && tr.side === 'forward');

  /** Emission cone at one wavelength, with the Ginzburg–Frank perfect-conductor reference. */
  function trAngular(): { thDeg: Float64Array; y: Float64Array; ref: Float64Array } {
    const thDeg = new Float64Array(TR_NANG), y = new Float64Array(TR_NANG), ref = new Float64Array(TR_NANG);
    const lam = Math.max(1, tr.lamNm), K = trKeV(), e = epsAt(lam), per = tr.unit;
    const withRef = trRefShown();
    for (let i = 0; i < TR_NANG; i++) {
      const deg = 90 * i / (TR_NANG - 1), t = deg * TDEG;
      thDeg[i] = deg;
      y[i] = tr.geom === 'film'
        ? filmSrPerNm(t, lam, trD(), K, e, tr.side, { per })
        : interfaceSrPerNm(t, lam, K, e, 'backward', per);
      ref[i] = withRef ? perfectConductorSrPerNm(t, lam, K, per) : NaN;   // trLine skips non-finite points
    }
    return { thDeg, y, ref };
  }

  type TrMap = { lam: Float64Array; x: Float64Array; d: Float64Array; g: Float64Array; max: number };
  let trMap: TrMap | null = null;        // cached heavy result, dropped on every state change
  let trMapPending = 0;

  function trComputeMap(): TrMap {
    const { lam, x } = trAxis(TR_NLMAP);
    const lo = Math.max(0.5, Math.min(tr.dMapMin, tr.dMapMax));
    const hi = Math.max(lo + 1, Math.max(tr.dMapMin, tr.dMapMax));
    const d = new Float64Array(TR_NDMAP);
    for (let i = 0; i < TR_NDMAP; i++) d[i] = lo + (hi - lo) * i / (TR_NDMAP - 1);
    const [t0, t1] = trCone();
    const g = thicknessMap({
      wavelengthNm: lam, eps: epsAt, thicknessNm: d, energyKeV: trKeV(), side: tr.side,
      thetaMinRad: t0, thetaMaxRad: t1, nTheta: TR_NTHMAP, per: tr.unit,
    });
    let max = 0;
    for (let i = 0; i < g.length; i++) if (g[i] > max) max = g[i];
    return { lam, x, d, g, max };
  }

  // ── canvas helpers (same idiom as the Smith–Purcell block) ───────────────
  function trCtx(canvas: HTMLCanvasElement) {
    const r = canvas.getBoundingClientRect();
    if (r.width < 4 || r.height < 4) return null;          // hidden panel → zero-size canvas
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);
    const ctx = canvas.getContext('2d')!; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, r.width, r.height);
    return { ctx, w: r.width, h: r.height };
  }
  type TrPlot = { px: (x: number) => number; py: (y: number) => number; m: { l: number; r: number; t: number; b: number } };

  // ── cursor read-out ──────────────────────────────────────────────────────
  // Each 1-D view hands the crosshair its axis mapping and the curves it just
  // drew, so hovering reads values straight out of those arrays: no repaint of
  // the canvas and no recomputation of the physics while the mouse moves.

  /** One plotted curve, as the read-out needs it. */
  type TrHoverSeries = { label: string; color: string; y: ArrayLike<number> };
  /** Set after every 1-D draw; null for the thickness map, which has no x grid. */
  let trHoverPlot: { p: TrPlot; x: ArrayLike<number>; xFmt: (v: number) => string; series: TrHoverSeries[] } | null = null;

  const trHoverVal = (v: number) =>
    v === 0 ? '0'                               // the hollow cone's exact nodes, not 0.000e+0
      : Math.abs(v) >= 1e-3 && Math.abs(v) < 1e4 ? v.toPrecision(4) : v.toExponential(3);

  function trHideHover(): void {
    ($t('tr-cross') as HTMLElement).hidden = true;
    $t('tr-tooltip').classList.remove('visible');
  }

  /** Nearest sample to a pixel x. The search is in pixel space, so the sample order does not matter. */
  function trNearestIx(p: TrPlot, x: ArrayLike<number>, mx: number): number {
    let best = 0, bestD = Infinity;
    for (let i = 0; i < x.length; i++) {
      const d = Math.abs(p.px(x[i]) - mx);
      if (d < bestD) { bestD = d; best = i; }
    }
    return best;
  }

  function trShowHover(ev: MouseEvent): void {
    const cache = trHoverPlot;
    const canvas = $t('tr-chart') as HTMLCanvasElement;
    if (!cache || !cache.x.length) { trHideHover(); return; }
    const r = canvas.getBoundingClientRect();
    const mx = ev.clientX - r.left, my = ev.clientY - r.top;
    const { p } = cache;
    const x0 = p.m.l, x1 = r.width - p.m.r, y0 = p.m.t, y1 = r.height - p.m.b;
    if (mx < x0 || mx > x1 || my < y0 || my > y1) { trHideHover(); return; }
    const i = trNearestIx(p, cache.x, mx);
    const cx = p.px(cache.x[i]);
    const cross = $t('tr-cross') as HTMLElement;
    cross.hidden = false;
    cross.style.left = `${cx.toFixed(1)}px`;
    cross.style.top = `${y0}px`;
    cross.style.height = `${(y1 - y0).toFixed(1)}px`;
    const tip = $t('tr-tooltip');
    tip.innerHTML = cache.xFmt(cache.x[i]) + cache.series
      .filter(s => Number.isFinite(s.y[i]))
      .map(s => `<br><span style="color:${s.color}">&#9679;</span> ${trEsc(s.label)} = ${trHoverVal(s.y[i])}`)
      .join('');
    tip.classList.add('visible');
    let tl = cx + 12;
    if (tl + tip.offsetWidth > r.width - 4) tl = cx - tip.offsetWidth - 12;
    tip.style.left = `${Math.max(4, tl).toFixed(1)}px`;
    tip.style.top = `${Math.max(4, Math.min(my - tip.offsetHeight - 10, r.height - tip.offsetHeight - 4)).toFixed(1)}px`;
  }

  ($t('tr-chart') as HTMLCanvasElement).addEventListener('mousemove', trShowHover);
  ($t('tr-chart') as HTMLCanvasElement).addEventListener('mouseleave', trHideHover);

  const TR_SUP = ['⁰', '¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸', '⁹'];
  const trSup = (p: number) => (p < 0 ? '⁻' : '') + String(Math.abs(p)).split('').map(d => TR_SUP[+d]).join('');
  function trNiceTicks(lo: number, hi: number, n = 5): number[] {
    if (!Number.isFinite(lo) || !Number.isFinite(hi) || hi <= lo) return [];
    const raw = (hi - lo) / n, mag = Math.pow(10, Math.floor(Math.log10(raw)));
    const norm = raw / mag, step = (norm < 1.5 ? 1 : norm < 3 ? 2 : norm < 7 ? 5 : 10) * mag;
    const out: number[] = [];
    for (let v = Math.ceil(lo / step - 1e-9) * step; v <= hi + step * 0.5; v += step) out.push(+v.toPrecision(6));
    return out;
  }
  const trTick = (v: number) => {
    if (v === 0) return '0';
    const a = Math.abs(v);
    return (a >= 1e4 || a < 1e-3) ? v.toExponential(1) : String(+v.toPrecision(4));
  };
  /** Shared power-of-ten so the y tick labels stay short; the exponent moves into the axis title. */
  function trYScale(ymax: number): { div: number; suffix: string } {
    if (!(ymax > 0) || !Number.isFinite(ymax)) return { div: 1, suffix: '' };
    const p = Math.floor(Math.log10(ymax));
    if (p >= -2 && p <= 3) return { div: 1, suffix: '' };
    return { div: 10 ** p, suffix: ` ×10${trSup(p)}` };
  }

  function trAxes(
    ctx: CanvasRenderingContext2D, w: number, h: number,
    xmin: number, xmax: number, ymin: number, ymax: number,
    xlabel: string, ylabel: string, xticks: number[], yticks: number[],
    fmtY: (v: number) => string, marginRight = 18,
  ): TrPlot {
    // 12 px ticks / 13 px axis titles, as in the Mie lab; the left and bottom
    // margins carry the larger glyphs without clipping the tick labels.
    const m = { l: 68, r: marginRight, t: 16, b: 46 };
    const px = (x: number) => m.l + (x - xmin) / (xmax - xmin || 1) * (w - m.l - m.r);
    const py = (y: number) => h - m.b - (y - ymin) / (ymax - ymin || 1) * (h - m.t - m.b);
    const font = tvar('--font') || 'sans-serif';
    ctx.font = '12px ' + font;
    ctx.strokeStyle = tvar('--bg-muted'); ctx.lineWidth = 1;
    ctx.strokeRect(m.l, m.t, w - m.l - m.r, h - m.t - m.b);
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (const y of yticks) {
      const Y = py(y); if (Y < m.t - 1 || Y > h - m.b + 1) continue;
      ctx.strokeStyle = 'rgba(140,140,150,0.18)'; ctx.beginPath(); ctx.moveTo(m.l, Y); ctx.lineTo(w - m.r, Y); ctx.stroke();
      ctx.fillStyle = tvar('--text-muted'); ctx.fillText(fmtY(y), m.l - 6, Y);
    }
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    for (const x of xticks) {
      const X = px(x); if (X < m.l - 1 || X > w - m.r + 1) continue;
      ctx.fillStyle = tvar('--text-muted'); ctx.fillText(trTick(x), X, h - m.b + 6);
    }
    ctx.font = '600 13px ' + font;
    ctx.fillStyle = tvar('--text-soft');
    ctx.fillText(xlabel, (m.l + w - m.r) / 2, h - 17);
    ctx.save(); ctx.translate(16, (m.t + h - m.b) / 2); ctx.rotate(-TPI / 2); ctx.fillText(ylabel, 0, 0); ctx.restore();
    return { px, py, m };
  }
  const trClip = (ctx: CanvasRenderingContext2D, w: number, h: number, p: TrPlot) => {
    ctx.save(); ctx.beginPath(); ctx.rect(p.m.l, p.m.t, w - p.m.l - p.m.r, h - p.m.t - p.m.b); ctx.clip();
  };
  function trLine(ctx: CanvasRenderingContext2D, p: TrPlot, xs: ArrayLike<number>, ys: ArrayLike<number>, color: string, lw: number, dash: number[] = []) {
    ctx.strokeStyle = color; ctx.lineWidth = lw; ctx.setLineDash(dash); ctx.beginPath();
    let started = false;
    for (let i = 0; i < xs.length; i++) {
      const v = ys[i];
      if (!Number.isFinite(v)) { started = false; continue; }
      const X = p.px(xs[i]), Y = p.py(v);
      if (started) ctx.lineTo(X, Y); else { ctx.moveTo(X, Y); started = true; }
    }
    ctx.stroke(); ctx.setLineDash([]);
  }
  /**
   * Right-aligned legend, measured rather than guessed: a material label carries
   * the file name and the table's range, so a fixed offset clipped it off the
   * canvas. The block is pushed as far right as its widest label allows, never
   * past the y axis, and a label too wide even for the full plot is ellipsised.
   */
  function trLegend(ctx: CanvasRenderingContext2D, p: TrPlot, w: number, items: { label: string; color: string; dash: number[] }[]) {
    ctx.font = '12px ' + (tvar('--font') || 'sans-serif'); ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    // inside the plot frame, not merely inside the canvas: p.m.r is the frame's
    // right margin, so the legend can never hang over the axis or off the box
    const swatch = 23, right = w - p.m.r - 8, minX = p.m.l + 8;
    const avail = Math.max(40, right - minX - swatch);
    const fit = (s: string) => {
      if (ctx.measureText(s).width <= avail) return s;
      let t = s;
      while (t.length > 1 && ctx.measureText(t + '…').width > avail) t = t.slice(0, -1);
      return t + '…';
    };
    const labels = items.map(it => fit(it.label));
    let wmax = 0;
    for (const l of labels) wmax = Math.max(wmax, ctx.measureText(l).width);
    const lx = Math.max(minX, right - swatch - wmax);
    let ly = p.m.t + 12;
    items.forEach((it, i) => {
      ctx.strokeStyle = it.color; ctx.lineWidth = 2; ctx.setLineDash(it.dash);
      ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(lx + 18, ly); ctx.stroke(); ctx.setLineDash([]);
      ctx.fillStyle = tvar('--text-soft'); ctx.fillText(labels[i], lx + swatch, ly);
      ly += 15;
    });
  }

  // sequential colormap for the thickness map (RGB stops — the palette lives here, not in CSS)
  const TR_STOPS = [[12, 10, 42], [58, 20, 110], [124, 34, 122], [188, 55, 99], [234, 110, 56], [250, 186, 62], [252, 250, 205]];
  const trCmap = (t: number): number[] => {
    t = Math.max(0, Math.min(1, t));
    const x = t * (TR_STOPS.length - 1), i = Math.min(TR_STOPS.length - 2, Math.floor(x)), f = x - i;
    const a = TR_STOPS[i], b = TR_STOPS[i + 1];
    return [a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f];
  };

  // ── geometry sketch (SVG, redrawn from the live parameters) ──────────────
  const trEsc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  function trGeometrySvg(suffix: string): string {
    const ct = trChartTheme();
    const film = tr.geom === 'film';
    const [t0, t1] = trCone();
    const W = 320, H = 224, cx = 156, R = 60;
    const ySurf = film ? 88 : 108;
    // Thickness drawn on a √ scale against a 1200 nm reference, so a 1 nm film
    // is still visible and a thick one still fits: 300 nm is half the height of
    // 1200 nm, not a quarter, and everything from 1200 nm up draws the same.
    // The caption says "compressed" rather than "to scale" for exactly that reason.
    const dPx = film ? Math.max(7, Math.min(54, 54 * Math.sqrt(Math.min(1, tr.dNm / 1200)))) : 0;
    const yExit = ySurf + dPx;
    const prim = tvar('--primary'), beamCol = tvar('--blue'), matCol = tvar('--amber');
    const arr = 'tr-arr-' + suffix;
    const P = (apexY: number, up: boolean, sign: number, th: number) =>
      [cx + sign * R * Math.sin(th), apexY + (up ? -1 : 1) * R * Math.cos(th)];
    const wedge = (apexY: number, up: boolean, sign: number, on: boolean) => {
      const [x1, y1] = P(apexY, up, sign, t0), [x2, y2] = P(apexY, up, sign, t1);
      const sweep = (sign > 0) === up ? 1 : 0;
      return `<path d="M ${cx} ${apexY} L ${x1.toFixed(1)} ${y1.toFixed(1)} A ${R} ${R} 0 0 ${sweep} ${x2.toFixed(1)} ${y2.toFixed(1)} Z"`
        + ` fill="${on ? prim : ct.textMuted}" fill-opacity="${on ? 0.32 : 0.1}"`
        + ` stroke="${on ? prim : ct.textMuted}" stroke-width="${on ? 1.2 : 0.6}" stroke-opacity="${on ? 0.95 : 0.5}"/>`;
    };

    let s = `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg">`;
    s += `<defs><marker id="${arr}" markerWidth="5" markerHeight="5" refX="4" refY="2.5" orient="auto">`
      + `<path d="M0,0 L5,2.5 L0,5 Z" fill="${beamCol}"/></marker></defs>`;
    s += `<rect width="${W}" height="${H}" fill="${ct.grid}" rx="6"/>`;

    // media
    const matBottom = film ? yExit : H - 22;
    s += `<rect x="10" y="${ySurf}" width="${W - 20}" height="${(matBottom - ySurf).toFixed(1)}" fill="${matCol}" fill-opacity="0.34" stroke="${ct.textSoft}" stroke-width="0.7"/>`;
    s += `<text x="16" y="20" fill="${ct.textMuted}" font-size="8" font-family="Inter,system-ui">vacuum</text>`;
    if (film) s += `<text x="16" y="${H - 8}" fill="${ct.textMuted}" font-size="8" font-family="Inter,system-ui">vacuum</text>`;
    const matY = film ? (ySurf + yExit) / 2 + 3 : ySurf + 14;
    s += `<text x="${W - 16}" y="${matY.toFixed(1)}" text-anchor="end" fill="${ct.text}" font-size="8.5" font-weight="700" font-family="Inter,system-ui">${trEsc(trMaterialLabel())}</text>`;

    // emission cones — the collected side is opaque, the other faint
    const backOn = tr.side === 'backward';
    s += wedge(ySurf, true, 1, backOn) + wedge(ySurf, true, -1, backOn);
    if (film) {
      const fwdOn = tr.side === 'forward';
      s += wedge(yExit, false, 1, fwdOn) + wedge(yExit, false, -1, fwdOn);
    } else {
      s += `<text x="${cx}" y="${H - 8}" text-anchor="middle" fill="${ct.textMuted}" font-size="7.5" font-family="Inter,system-ui">semi-infinite — no forward side</text>`;
    }

    // normal + collection-angle arc on the collected side
    const apex = backOn || !film ? ySurf : yExit, upSide = backOn || !film;
    const nTip = upSide ? apex - R - 6 : apex + R + 6;
    s += `<line x1="${cx}" y1="${apex}" x2="${cx}" y2="${nTip}" stroke="${ct.textMuted}" stroke-width="0.7" stroke-dasharray="3,3"/>`;
    const ra = 30;
    const [ax1, ay1] = P(apex, upSide, 1, t0), [ax2, ay2] = P(apex, upSide, 1, t1);
    const sc = ra / R;
    const a1x = cx + (ax1 - cx) * sc, a1y = apex + (ay1 - apex) * sc;
    const a2x = cx + (ax2 - cx) * sc, a2y = apex + (ay2 - apex) * sc;
    s += `<path d="M ${a1x.toFixed(1)} ${a1y.toFixed(1)} A ${ra} ${ra} 0 0 ${upSide ? 1 : 0} ${a2x.toFixed(1)} ${a2y.toFixed(1)}" fill="none" stroke="${prim}" stroke-width="1.1"/>`;
    const labY = upSide ? apex - 34 : apex + 40;
    s += `<text x="${cx + 40}" y="${labY.toFixed(1)}" fill="${prim}" font-size="8" font-weight="700" font-family="Inter,system-ui">θ = ${(t0 / TDEG).toFixed(0)}–${(t1 / TDEG).toFixed(0)}°</text>`;
    s += `<text x="${cx + 40}" y="${(labY + 10).toFixed(1)}" fill="${ct.textMuted}" font-size="7.5" font-family="Inter,system-ui">${tr.side} (collected)</text>`;

    // electron beam
    const beamEnd = film ? H - 12 : ySurf + 34;
    s += `<line x1="${cx}" y1="8" x2="${cx}" y2="${beamEnd}" stroke="${beamCol}" stroke-width="2" stroke-linecap="round" marker-end="url(#${arr})"/>`;
    // Beam label in the top-right corner. Beside the beam it sat on top of the
    // drawing — over the backward wedges — and was hard to read.
    s += `<text x="${W - 10}" y="16" text-anchor="end" fill="${beamCol}" font-size="8.5" font-weight="700" font-family="Inter,system-ui">e⁻ ${trKeV().toFixed(1)} keV</text>`;
    s += `<text x="${W - 10}" y="26" text-anchor="end" fill="${beamCol}" font-size="7.5" font-family="Inter,system-ui">β = ${tr.beta.toFixed(3)}</text>`;
    if (!film) s += `<text x="${cx + 6}" y="${(ySurf + 46).toFixed(1)}" fill="${ct.textMuted}" font-size="7.5" font-family="Inter,system-ui">absorbed</text>`;

    // thickness dimension
    if (film) {
      const dx = 26;
      s += `<line x1="${dx}" y1="${ySurf}" x2="${dx}" y2="${yExit.toFixed(1)}" stroke="${ct.text}" stroke-width="0.8"/>`;
      s += `<line x1="${dx - 4}" y1="${ySurf}" x2="${dx + 4}" y2="${ySurf}" stroke="${ct.text}" stroke-width="0.8"/>`;
      s += `<line x1="${dx - 4}" y1="${yExit.toFixed(1)}" x2="${dx + 4}" y2="${yExit.toFixed(1)}" stroke="${ct.text}" stroke-width="0.8"/>`;
      s += `<text x="${dx + 7}" y="${((ySurf + yExit) / 2 + 3).toFixed(1)}" fill="${ct.text}" font-size="8" font-weight="700" font-family="Inter,system-ui">d = ${tr.dNm} nm</text>`;
    }
    s += `<text x="${W - 10}" y="${H - 8}" text-anchor="end" fill="${ct.textMuted}" font-size="7" font-family="Inter,system-ui">λ ${trLamLo().toFixed(0)}–${trLamHi().toFixed(0)} nm${film ? ' · thickness shown compressed' : ''}</text>`;
    s += '</svg>';
    return s;
  }

  function trUpdateConfigCheck() {
    $t('tr-config-check').innerHTML = trGeometrySvg('card');
    $t('tr-config-check').setAttribute('aria-label',
      `Open enlarged geometry sketch — ${tr.geom === 'film' ? 'free-standing film' : 'semi-infinite half space'}`);
    $t('tr-structure-dialog-art').innerHTML = trGeometrySvg('modal');
  }

  // ── views ────────────────────────────────────────────────────────────────
  const trXLabel = () => tr.unit === 'eV' ? 'Photon energy (eV)' : 'Wavelength (nm)';
  const trYUnit = () => tr.unit === 'eV' ? 'eV' : 'nm';

  function trDrawSpectrum(terms?: readonly FilmTerm[]) {
    const cc = trCtx($t('tr-chart') as HTMLCanvasElement); if (!cc) return;
    const { ctx, w, h } = cc;
    const { lam, x } = trAxis(TR_NSPEC);
    const main = trSpectrumOn(lam);
    const extra = terms ? trSpectrumOn(lam, terms)
      : (tr.geom === 'film' && tr.overlay ? trThickLimit(lam) : null);
    let ymax = 0;
    for (let i = 0; i < main.length; i++) if (Number.isFinite(main[i]) && main[i] > ymax) ymax = main[i];
    if (extra) for (let i = 0; i < extra.length; i++) if (Number.isFinite(extra[i]) && extra[i] > ymax) ymax = extra[i];
    if (!(ymax > 0)) ymax = 1;
    const sc = trYScale(ymax);
    const xlo = Math.min(x[0], x[x.length - 1]), xhi = Math.max(x[0], x[x.length - 1]);
    const yhi = ymax * 1.08;
    const p = trAxes(ctx, w, h, xlo, xhi, 0, yhi, trXLabel(),
      `photons / (electron ${trYUnit()})${sc.suffix}`,
      trNiceTicks(xlo, xhi), trNiceTicks(0, yhi), v => trTick(v / sc.div));
    trClip(ctx, w, h, p);
    if (extra) trLine(ctx, p, x, extra, terms ? tvar('--rose') : tvar('--text-muted'), 1.6, [6, 4]);
    trLine(ctx, p, x, main, tvar('--primary'), 2);
    ctx.restore();
    const legend = terms
      ? [{ label: 'full (B₁+B₂+B₃)', color: tvar('--primary'), dash: [] }, { label: 'B₁+B₃ interfaces only', color: tvar('--rose'), dash: [6, 4] }]
      : extra
        ? [{ label: `film, d = ${tr.dNm} nm`, color: tvar('--primary'), dash: [] }, { label: 'thick-film limit d → ∞', color: tvar('--text-muted'), dash: [6, 4] }]
        : [{ label: tr.geom === 'film' ? `film, d = ${tr.dNm} nm` : 'semi-infinite', color: tvar('--primary'), dash: [] }];
    trLegend(ctx, p, w, legend);
    // the dashed curve is drawn first but is always the second legend entry
    const hoverSeries = [{ label: legend[0].label, color: legend[0].color, y: main as ArrayLike<number> }];
    if (extra) hoverSeries.push({ label: legend[1].label, color: legend[1].color, y: extra as ArrayLike<number> });
    trHoverPlot = {
      p, x, series: hoverSeries,
      xFmt: v => tr.unit === 'eV' ? `E = ${v.toFixed(3)} eV` : `λ = ${v.toFixed(1)} nm`,
    };
  }

  function trDrawAngular() {
    const cc = trCtx($t('tr-chart') as HTMLCanvasElement); if (!cc) return;
    const { ctx, w, h } = cc;
    const { thDeg, y, ref } = trAngular();
    let ymax = 0;
    for (let i = 0; i < TR_NANG; i++) { if (Number.isFinite(y[i]) && y[i] > ymax) ymax = y[i]; if (Number.isFinite(ref[i]) && ref[i] > ymax) ymax = ref[i]; }
    if (!(ymax > 0)) ymax = 1;
    const sc = trYScale(ymax), yhi = ymax * 1.08;
    const p = trAxes(ctx, w, h, 0, 90, 0, yhi, 'Emission angle θ from the normal (°)',
      `photons / (electron sr ${trYUnit()})${sc.suffix}`,
      [0, 15, 30, 45, 60, 75, 90], trNiceTicks(0, yhi), v => trTick(v / sc.div));
    trClip(ctx, w, h, p);
    // collected band
    const [t0, t1] = trCone();
    ctx.fillStyle = tvar('--primary'); ctx.globalAlpha = 0.1;
    ctx.fillRect(p.px(t0 / TDEG), p.m.t, Math.max(1, p.px(t1 / TDEG) - p.px(t0 / TDEG)), h - p.m.t - p.m.b);
    ctx.globalAlpha = 1;
    if (trRefShown()) trLine(ctx, p, thDeg, ref, tvar('--emerald'), 1.6, [5, 4]);
    trLine(ctx, p, thDeg, y, tvar('--primary'), 2);
    ctx.restore();
    const legend: { label: string; color: string; dash: number[] }[] = [
      { label: `${tr.geom === 'film' ? 'film' : 'half space'}, λ = ${tr.lamNm.toFixed(0)} nm`, color: tvar('--primary'), dash: [] },
    ];
    if (trRefShown()) legend.push({ label: 'Ginzburg–Frank (perfect conductor, backward)', color: tvar('--emerald'), dash: [5, 4] });
    trLegend(ctx, p, w, legend);
    const series: TrHoverSeries[] = [{ label: legend[0].label, color: legend[0].color, y: y as ArrayLike<number> }];
    if (legend.length > 1) series.push({ label: legend[1].label, color: legend[1].color, y: ref as ArrayLike<number> });
    trHoverPlot = { p, x: thDeg, series, xFmt: v => `θ = ${v.toFixed(1)}°` };
  }

  function trDrawMap() {
    const cc = trCtx($t('tr-chart') as HTMLCanvasElement); if (!cc) return;
    const { ctx, w, h } = cc;
    trHoverPlot = null;        // a 2-D map has no x sample grid to read out
    if (!trMap) {
      ctx.fillStyle = tvar('--text-muted'); ctx.font = '12px ' + (tvar('--font') || 'sans-serif');
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('Computing thickness map…', w / 2, h / 2);
      return;
    }
    const { lam: mapLam, x, d, g, max } = trMap;
    const nx = x.length, ny = d.length;
    const xlo = Math.min(x[0], x[nx - 1]), xhi = Math.max(x[0], x[nx - 1]);
    const dlo = d[0], dhi = d[ny - 1];
    const sc = trYScale(max || 1);
    const p = trAxes(ctx, w, h, xlo, xhi, dlo, dhi, trXLabel(), 'Film thickness d (nm)',
      trNiceTicks(xlo, xhi), trNiceTicks(dlo, dhi), v => trTick(v), 74);

    // heat image (row 0 of the image is the largest thickness, so d grows upwards)
    const off = document.createElement('canvas');
    off.width = nx; off.height = ny;
    const octx = off.getContext('2d')!;
    const img = octx.createImageData(nx, ny);
    const norm = max > 0 ? 1 / max : 0;
    // trAxis builds x ascending in both units (eV runs from the long-wavelength
    // end up), so the image columns follow the sample order directly.
    for (let row = 0; row < ny; row++) {
      const di = ny - 1 - row;
      for (let ix = 0; ix < nx; ix++) {
        const c3 = trCmap(g[di * nx + ix] * norm);
        const o = (row * nx + ix) * 4;
        img.data[o] = c3[0]; img.data[o + 1] = c3[1]; img.data[o + 2] = c3[2]; img.data[o + 3] = 255;
      }
    }
    octx.putImageData(img, 0, 0);
    const pl = p.m.l, pt = p.m.t, pw = w - p.m.l - p.m.r, ph = h - p.m.t - p.m.b;
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(off, pl, pt, pw, ph);

    // resonance orders m = 1, 2, 3 at the centre of the collection cone (Eq. 3 of Ebel et al.)
    const [t0, t1] = trCone(), thMid = 0.5 * (t0 + t1);
    const K = trKeV();
    trClip(ctx, w, h, p);
    ctx.strokeStyle = tvar('--bg'); ctx.lineWidth = 1.6;
    ctx.font = '10px ' + (tvar('--font') || 'sans-serif'); ctx.textBaseline = 'bottom';
    for (let m = 1; m <= 3; m++) {
      ctx.beginPath();
      let started = false, lastX = 0, lastY = 0;
      for (let i = 0; i < nx; i++) {
        const dm = resonanceThicknessNm(mapLam[i], K, epsAt(mapLam[i]), m, thMid);
        if (!Number.isFinite(dm)) { started = false; continue; }
        const X = p.px(x[i]), Y = p.py(dm);
        if (started) ctx.lineTo(X, Y); else { ctx.moveTo(X, Y); started = true; }
        lastX = X; lastY = Y;
      }
      ctx.stroke();
      if (started && lastY > pt && lastY < pt + ph) {
        ctx.fillStyle = tvar('--bg'); ctx.textAlign = 'right';
        ctx.fillText('m = ' + m, Math.min(lastX, pl + pw - 4), lastY - 3);
      }
    }
    ctx.restore();
    ctx.strokeStyle = tvar('--bg-muted'); ctx.lineWidth = 1; ctx.strokeRect(pl, pt, pw, ph);

    // colour bar
    const bx = w - p.m.r + 14, bw = 12, by = pt, bh = ph;
    const bar = ctx.createLinearGradient(0, by + bh, 0, by);
    for (let i = 0; i <= 10; i++) { const c3 = trCmap(i / 10); bar.addColorStop(i / 10, `rgb(${c3[0] | 0},${c3[1] | 0},${c3[2] | 0})`); }
    ctx.fillStyle = bar; ctx.fillRect(bx, by, bw, bh);
    ctx.strokeStyle = tvar('--bg-muted'); ctx.strokeRect(bx, by, bw, bh);
    ctx.fillStyle = tvar('--text-muted'); ctx.font = '10px ' + (tvar('--font') || 'sans-serif');
    ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    ctx.fillText(trTick(max / sc.div), bx + bw + 3, by + 5);
    ctx.fillText('0', bx + bw + 3, by + bh - 5);
    ctx.save(); ctx.translate(w - 4, by + bh / 2); ctx.rotate(-TPI / 2);
    ctx.textAlign = 'center'; ctx.fillStyle = tvar('--text-soft');
    ctx.fillText(`photons / (electron ${trYUnit()})${sc.suffix}`, 0, 0);
    ctx.restore();
  }

  /**
   * The optical constants the TR formulas are actually being fed: `epsAt` is
   * the one accessor, so the curve is ε(λ) as the kernels see it — Drude, a
   * custom ε, an uploaded table or a database entry alike, with the custom
   * slot's ε → 0 substitution included rather than hidden.
   */
  function trMaterialCurves(): {
    lam: Float64Array; x: Float64Array; a: Float64Array; b: Float64Array;
    n: Float64Array; k: Float64Array; epsRe: Float64Array; epsIm: Float64Array;
    aLabel: string; bLabel: string; yLabel: string;
  } {
    const { lam, x } = trAxis(TR_NSPEC);
    const m = lam.length;
    const n = new Float64Array(m), k = new Float64Array(m);
    const epsRe = new Float64Array(m), epsIm = new Float64Array(m);
    for (let i = 0; i < m; i++) {
      const e = epsAt(lam[i]);
      epsRe[i] = e[0]; epsIm[i] = e[1];
      const [nn, kk] = epsilonToNK(e[0], e[1]);
      n[i] = nn; k[i] = kk;
    }
    const nk = tr.matProp === 'nk';
    return {
      lam, x, n, k, epsRe, epsIm,
      a: nk ? n : epsRe,
      b: nk ? k : epsIm,
      aLabel: nk ? 'n' : 'Re ε',
      bLabel: nk ? 'k' : 'Im ε',
      yLabel: nk ? 'Refractive index' : 'Dielectric function ε',
    };
  }

  function trMessage(ctx: CanvasRenderingContext2D, w: number, h: number, lines: string[]) {
    ctx.font = '12px ' + (tvar('--font') || 'sans-serif');
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    const y0 = h / 2 - (lines.length - 1) * 9;
    lines.forEach((t, i) => {
      ctx.fillStyle = i === 0 ? tvar('--text-soft') : tvar('--text-muted');
      ctx.fillText(t, w / 2, y0 + i * 18);
    });
  }

  /** Material view — the same ε / n,k plot the Mie and Cylinder labs draw. */
  function trDrawMaterial() {
    const cc = trCtx($t('tr-chart') as HTMLCanvasElement); if (!cc) return;
    const { ctx, w, h } = cc;
    trHoverPlot = null;        // set at the end, once the curves exist; the empty state has none
    if (!trMaterialReady()) {
      // An honest empty state: the fallback ε = 1 would draw a flat vacuum
      // line that looks like a measurement of nothing.
      trMessage(ctx, w, h, [
        tr.material === 'rii' && trSharedRiiMissing
          ? 'That database entry is no longer available.'
          : 'No optical data loaded.',
        tr.material === 'file'
          ? 'Choose a file with λ (or E) and n, k — or ε′, ε″ — columns.'
          : 'Search refractiveindex.info, or pick a built-in material, Drude or a custom ε.',
      ]);
      return;
    }
    const { x, a, b, aLabel, bLabel, yLabel } = trMaterialCurves();
    let ylo = Infinity, yhi = -Infinity;
    for (let i = 0; i < a.length; i++) {
      for (const v of [a[i], b[i]]) {
        if (!Number.isFinite(v)) continue;
        if (v < ylo) ylo = v;
        if (v > yhi) yhi = v;
      }
    }
    if (!Number.isFinite(ylo) || !Number.isFinite(yhi)) { ylo = 0; yhi = 1; }
    const pad = (yhi - ylo) * 0.08 || Math.max(1, Math.abs(yhi) * 0.1);
    ylo -= pad; yhi += pad;
    const xlo = Math.min(x[0], x[x.length - 1]), xhi = Math.max(x[0], x[x.length - 1]);
    const p = trAxes(ctx, w, h, xlo, xhi, ylo, yhi, trXLabel(), yLabel,
      trNiceTicks(xlo, xhi), trNiceTicks(ylo, yhi), trTick);
    trClip(ctx, w, h, p);
    if (ylo < 0 && yhi > 0) {
      // ε′ = 0 is the metal/dielectric line — worth seeing where it is crossed
      ctx.strokeStyle = tvar('--bg-muted'); ctx.lineWidth = 1; ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.moveTo(p.m.l, p.py(0)); ctx.lineTo(w - p.m.r, p.py(0)); ctx.stroke();
      ctx.setLineDash([]);
    }
    trLine(ctx, p, x, b, tvar('--rose'), 1.8, [5, 4]);
    trLine(ctx, p, x, a, tvar('--primary'), 2);
    ctx.restore();
    const legend = [
      { label: `${trMaterialLabel()} — ${aLabel}`, color: tvar('--primary'), dash: [] },
      { label: bLabel, color: tvar('--rose'), dash: [5, 4] },
    ];
    trLegend(ctx, p, w, legend);
    // the same crosshair the 1-D views get: the Mie lab reads this plot out too
    trHoverPlot = {
      p, x,
      series: [
        { label: aLabel, color: legend[0].color, y: a as ArrayLike<number> },
        { label: bLabel, color: legend[1].color, y: b as ArrayLike<number> },
      ],
      xFmt: v => tr.unit === 'eV' ? `E = ${v.toFixed(3)} eV` : `λ = ${v.toFixed(1)} nm`,
    };
  }

  // ── render ───────────────────────────────────────────────────────────────
  const TR_TITLES: Record<TrView, string> = {
    spectrum: 'Spectrum — angle-integrated emission over the collection cone',
    angular: 'Angular — emission cone at a single wavelength',
    thickness: 'Thickness map — wavelength × film thickness',
    terms: 'Terms — full result vs the B₁+B₃ interface-only control',
    material: 'Material — ε(λ) exactly as the transition-radiation formulas receive it',
  };

  function trUpdateControlVis() {
    const film = tr.geom === 'film';
    ($t('tr-d-field') as HTMLElement).hidden = !film;
    // The box reaches 20 µm, the slider only 1 µm. Say so rather than leave the
    // thumb pinned at the end as if it agreed with the number beside it.
    const dSlider = $ti('tr-d-slider'), dSliderMax = parseFloat(dSlider.max);
    dSlider.title = Number.isFinite(dSliderMax) && tr.dNm > dSliderMax
      ? `d = ${tr.dNm} nm is beyond the slider's range (${dSlider.min}–${dSlider.max} nm); moving the slider will reduce it.`
      : '';
    ($t('tr-view-thickness') as HTMLElement).hidden = !film;
    ($t('tr-view-terms') as HTMLElement).hidden = !film;
    ($t('tr-overlay-field') as HTMLElement).hidden = !(film && tr.view === 'spectrum');
    ($t('tr-wl-field') as HTMLElement).hidden = tr.view !== 'angular';
    ($t('tr-dmap-field') as HTMLElement).hidden = tr.view !== 'thickness';
    ($t('tr-mat-prop') as HTMLElement).hidden = tr.view !== 'material';
    ($t('tr-file-group') as HTMLElement).hidden = tr.material !== 'file';
    ($t('tr-rii-group') as HTMLElement).hidden = tr.material !== 'rii';
    ($t('tr-eps-group') as HTMLElement).hidden = tr.material !== 'custom';
    ($t('tr-drude-group') as HTMLElement).hidden = tr.material !== 'drude';
    $t('tr-material-ref').textContent = trMaterialRefText();
    const fwd = $t('tr-side').querySelector('button[data-side="forward"]') as HTMLButtonElement;
    fwd.disabled = !film;
    fwd.title = film
      ? 'Light emitted downstream, on the far side of the film'
      : 'A semi-infinite half space has no exit interface: the electron never comes out, so there is no forward lobe.';
    $t('tr-side-note').textContent = film
      ? (tr.side === 'backward'
        ? 'Backward: light emitted back towards the electron source, through the entrance interface.'
        : 'Forward: light emitted downstream, through the exit interface.')
      : 'Semi-infinite: only the backward lobe exists — there is no exit interface, so Forward is disabled.';
    const markRadio = (groupId: string, pick: (el: HTMLElement) => boolean) =>
      $t(groupId).querySelectorAll('button').forEach(b => {
        const a = pick(b as HTMLElement);
        b.classList.toggle('active', a); b.setAttribute('aria-checked', a ? 'true' : 'false');
      });
    markRadio('tr-geom', el => el.dataset.geom === tr.geom);
    markRadio('tr-side', el => el.dataset.side === tr.side);
    markRadio('tr-overlay', el => (el.dataset.ov === '1') === tr.overlay);
    markRadio('tr-view-tabs', el => el.dataset.view === tr.view);
    markRadio('tr-mat-prop', el => el.dataset.mprop === tr.matProp);
    // the λ/eV switch keeps the .sp-unit-toggle look of the Smith–Purcell one next
    // to it, but is a radiogroup like every other group here: aria-checked, not pressed
    markRadio('tr-unit', el => el.dataset.xu === tr.unit);
  }

  /** One tile of the numerical-results box — the PINEM module's markup. */
  const trMetric = (label: string, val: string) =>
    `<div class="pn-metric"><span class="pn-metric__label">${label}</span><span class="pn-metric__val">${val}</span></div>`;

  /**
   * Numerical results: what the material actually *is* at the wavelength being
   * looked at, in the Materials calculator's own set — Re ε, Im ε, n, k and the
   * skin depth — rather than the parameters, which the controls already show.
   */
  function trReadout() {
    // the angular view fixes one wavelength; every other view sweeps the range
    const lamRef = tr.view === 'angular' ? tr.lamNm : 0.5 * (trLamLo() + trLamHi());
    const e = epsAt(lamRef);
    const [n, k] = epsilonToNK(e[0], e[1]);
    const f = (v: number) => Math.abs(v) >= 1e4 || (v !== 0 && Math.abs(v) < 1e-3) ? v.toExponential(2) : v.toPrecision(4);
    // δ = 1/(2(ω/c)k) = λ/(4πk): the 1/e penetration depth of the field intensity
    const delta = k > 0 ? lamRef / (4 * Math.PI * k) : Infinity;
    let html = trMetric('Wavelength &lambda;', `${lamRef.toFixed(0)} <em>nm</em>`)
      + trMetric('Re &epsilon;', f(e[0]))
      + trMetric('Im &epsilon;', f(e[1]))
      + trMetric('n', f(n))
      + trMetric('k', f(k))
      + trMetric('Skin depth &delta;', Number.isFinite(delta) ? `${f(delta)} <em>nm</em>` : '&infin;');
    const notes = ['&delta; = &lambda;/(4&pi;k) is the 1/e penetration depth of the field intensity; it diverges for a lossless material.'];
    // A table is held at its endpoint outside the measured window (the site-wide
    // convention), which draws a flat tail with nothing on screen to say so.
    const tbl = trActiveTable();
    if (tbl && tbl.length > 1) {
      const tLo = tbl[0][0] * 1000, tHi = tbl[tbl.length - 1][0] * 1000;
      const qLo = tr.view === 'angular' ? lamRef : trLamLo();
      const qHi = tr.view === 'angular' ? lamRef : trLamHi();
      if (qLo < tLo - 1e-6 || qHi > tHi + 1e-6) {
        notes.push(`The table covers ${tLo.toFixed(0)}&ndash;${tHi.toFixed(0)} nm; outside it &epsilon; is held at the endpoint value.`);
      }
    }
    if (tr.geom === 'film') {
      const [c0, c1] = trCone();
      const thMid = 0.5 * (c0 + c1);
      const d1 = resonanceThicknessNm(lamRef, trKeV(), e, 1, thMid);
      html += trMetric('m = 1 resonance', Number.isFinite(d1) ? `${d1.toFixed(0)} <em>nm</em>` : '—')
        + trMetric('d / &delta;', Number.isFinite(delta) && delta > 0 ? f(tr.dNm / delta) : '0');
      notes.push(`The m = 1 resonant thickness is quoted at θ = ${(thMid / TDEG).toFixed(0)}°, the cone centre the resonance overlays use.`);
    }
    if (!trMaterialReady()) notes.push('No optical data loaded — the curve is the vacuum (zero) result.');
    $t('tr-metrics-grid').innerHTML = html;
    const note = $t('tr-metrics-note');
    note.innerHTML = notes.join(' ');
    note.hidden = false;
  }

  let trRenderToken = 0;
  let trUrlPending = 0;
  function renderTR() {
    // Drop any queued map compute *before* anything else. Every other way out of
    // the thickness view — a view tab, the geometry switch, a module change, a
    // slider drag on another view — used to leave the 30 ms timer armed with a
    // token that still matched, so ~1.3M kernel evaluations ran on the main
    // thread and were thrown away, freezing a panel nobody was looking at.
    ++trRenderToken;
    window.clearTimeout(trMapPending);
    trMapPending = 0;
    if (($t('panel-tr') as HTMLElement).hidden) return;
    // a redraw the mouse did not ask for (resize, theme, keyboard, deferred map)
    // would otherwise leave the old crosshair and tooltip over the new plot
    trHideHover();
    trHoverPlot = null;
    trUpdateControlVis();
    trUpdateConfigCheck();
    $t('tr-chart-title').textContent = TR_TITLES[tr.view];
    trReadout();
    ($t('tr-chart') as HTMLElement).classList.toggle('tr-no-readout', tr.view === 'thickness');
    if (tr.view === 'thickness') {
      if (trMap) { $t('tr-result-card').classList.remove('is-computing'); trDrawMap(); }
      else {
        // heavy: paint the busy state first, compute on the next frame
        $t('tr-result-card').classList.add('is-computing');
        trDrawMap();
        const token = trRenderToken;
        trMapPending = window.setTimeout(() => {
          if (token !== trRenderToken) return;
          trMap = trComputeMap();
          $t('tr-result-card').classList.remove('is-computing');
          if (tr.view === 'thickness') trDrawMap();
        }, 30);
      }
    } else {
      $t('tr-result-card').classList.remove('is-computing');
      if (tr.view === 'angular') trDrawAngular();
      else if (tr.view === 'material') trDrawMaterial();
      else if (tr.view === 'terms') trDrawSpectrum(['B1', 'B3']);
      else trDrawSpectrum();
    }
    // Last, and debounced: one slider drag emits hundreds of input events, and
    // WebKit throws SecurityError past 100 replaceState calls in 30 s. Writing
    // the URL after the drawing means such a throw can never suppress the plot.
    trScheduleUrl();
  }
  /** Any state change invalidates the cached map. */
  const trChanged = () => { trMap = null; renderTR(); };

  // ── controls ─────────────────────────────────────────────────────────────
  const trFmt = (v: number) => {
    if (!Number.isFinite(v)) return '';
    const a = Math.abs(v);
    return (a !== 0 && (a < 1e-3 || a >= 1e6)) ? v.toExponential(3) : String(+v.toPrecision(6));
  };
  function trSyncBeta(beta: number, src?: 'vc' | 'kev') {
    tr.beta = Math.max(0.001, Math.min(0.9999, beta));
    if (src !== 'vc') $ti('tr-vc').value = trFmt(tr.beta);
    if (src !== 'kev') $ti('tr-kev').value = trFmt(energyFromBeta(tr.beta));
  }
  $ti('tr-vc').addEventListener('input', e => {
    const v = parseFloat((e.target as HTMLInputElement).value);
    if (Number.isFinite(v) && v > 0 && v < 1) { trSyncBeta(v, 'vc'); trChanged(); }
  });
  $ti('tr-kev').addEventListener('input', e => {
    const k = parseFloat((e.target as HTMLInputElement).value);
    if (Number.isFinite(k) && k > 0) { trSyncBeta(betaFromKeV(k), 'kev'); trChanged(); }
  });
  // trSyncBeta clamps β to [0.001, 0.9999] but deliberately leaves the field being
  // typed in alone, so '0.99995' would stay in the box while the state, the partner
  // field and the share link all held 0.9999. Correct the box once the edit ends
  // (change fires on blur or Enter, so nothing is rewritten mid-keystroke).
  $ti('tr-vc').addEventListener('change', () => { $ti('tr-vc').value = trFmt(tr.beta); });
  $ti('tr-kev').addEventListener('change', () => { $ti('tr-kev').value = trFmt(energyFromBeta(tr.beta)); });

  $t('tr-geom').addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('button[data-geom]') as HTMLButtonElement | null; if (!btn) return;
    const g = btn.dataset.geom as 'half' | 'film'; if (g === tr.geom) return;
    tr.geom = g;
    if (g === 'half') {
      tr.side = 'backward';
      if (tr.view === 'thickness' || tr.view === 'terms') tr.view = 'spectrum';
    }
    trChanged();
  });
  $t('tr-side').addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('button[data-side]') as HTMLButtonElement | null;
    if (!btn || btn.disabled) return;
    const s = btn.dataset.side as TrSide; if (s === tr.side) return;
    tr.side = s; trChanged();
  });
  $t('tr-unit').addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('button[data-xu]') as HTMLButtonElement | null; if (!btn) return;
    const u = btn.dataset.xu as 'nm' | 'eV'; if (u === tr.unit) return;
    tr.unit = u; trChanged();
  });
  $t('tr-overlay').addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('button[data-ov]') as HTMLButtonElement | null; if (!btn) return;
    tr.overlay = btn.dataset.ov === '1'; trChanged();
  });
  $t('tr-view-tabs').addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('.plot-tab') as HTMLButtonElement | null; if (!btn || btn.hidden) return;
    tr.view = btn.dataset.view as TrView;
    renderTR();
  });
  $t('tr-mat-prop').addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('button[data-mprop]') as HTMLButtonElement | null; if (!btn) return;
    const m = btn.dataset.mprop as 'eps' | 'nk'; if (m === tr.matProp) return;
    tr.matProp = m; renderTR();        // a display switch: nothing to recompute
  });

  // thickness: number + slider, value kept in state so the slider's step never truncates it
  function trBindNum(id: string, apply: (v: number) => void, read: () => number, isInt = false) {
    const num = $ti(id), slider = document.getElementById(id + '-slider') as HTMLInputElement | null;
    /** The bounds an input declares. A number box does not enforce its own on a typed value. */
    const clampTo = (el: HTMLInputElement, v: number) => {
      const lo = parseFloat(el.min), hi = parseFloat(el.max);
      if (Number.isFinite(lo)) v = Math.max(lo, v);
      if (Number.isFinite(hi)) v = Math.min(hi, v);
      return v;
    };
    const run = (raw: string, from: HTMLInputElement) => {
      let v = parseFloat(raw); if (!Number.isFinite(v)) return;
      if (isInt) v = Math.round(v);
      // Clamp before anything is written anywhere: the raw value used to reach the
      // partner control unclamped, so typing −5 left the box at −5, the slider at
      // its own min of 1 and the state at 0.1 — three different thicknesses.
      v = clampTo(num, v);
      apply(v);
      if (from !== num) num.value = String(v);
      // a range input silently clamps an assigned value; keep that explicit
      if (slider && from !== slider) slider.value = String(clampTo(slider, v));
      trChanged();
    };
    num.addEventListener('input', () => run(num.value, num));
    if (slider) slider.addEventListener('input', () => run(slider.value, slider));
    // Reconcile the box with the state when the edit finishes rather than
    // mid-keystroke, so a clamp never rewrites digits under the caret.
    num.addEventListener('change', () => { num.value = String(read()); });
  }
  trBindNum('tr-d', v => { tr.dNm = Math.max(0.1, v); }, () => tr.dNm, true);
  /**
   * `bounds`, where given, is the range the control declares: min/max do not stop
   * a number being typed into the box, and an out-of-range cone used to reach the
   * state, the read-out and the CSV header while `trCone()` quietly clamped what
   * the kernels were actually given.
   */
  const trBindRange = (id: string, apply: (v: number) => void, bounds?: [number, number]) => {
    const el = $ti(id);
    const hold = (v: number) => bounds ? Math.min(bounds[1], Math.max(bounds[0], v)) : v;
    el.addEventListener('input', () => {
      const v = parseFloat(el.value);
      if (Number.isFinite(v)) { apply(hold(v)); trChanged(); }
    });
    // correct the box itself once the edit is over, not under the caret
    if (bounds) el.addEventListener('change', () => {
      const v = parseFloat(el.value);
      if (Number.isFinite(v)) el.value = String(hold(v));
    });
  };
  trBindRange('tr-th-min', v => { tr.thMin = v; }, [0, 90]);
  trBindRange('tr-th-max', v => { tr.thMax = v; }, [0, 90]);
  trBindRange('tr-lam-min', v => { tr.lamMin = v; });
  trBindRange('tr-lam-max', v => { tr.lamMax = v; });
  trBindRange('tr-dmap-min', v => { tr.dMapMin = v; });
  trBindRange('tr-dmap-max', v => { tr.dMapMax = v; });
  trBindRange('tr-drude-epsb', v => { tr.drudeEpsB = v; });
  trBindRange('tr-drude-wp', v => { tr.drudeWp = v; });
  trBindRange('tr-drude-gamma', v => { tr.drudeGamma = v; });

  // single wavelength (Angular view): λ ⇄ E ⇄ slider
  function trSetLambda(nm: number, src: 'nm' | 'ev' | 'slider') {
    tr.lamNm = Math.max(1, nm);
    if (src !== 'nm') $ti('tr-wl-nm').value = String(+tr.lamNm.toFixed(1));
    if (src !== 'ev') $ti('tr-wl-ev').value = String(+wavelengthToEv(tr.lamNm).toFixed(4));
    if (src !== 'slider') $ti('tr-wl-slider').value = String(Math.round(tr.lamNm));
    trChanged();
  }
  $ti('tr-wl-nm').addEventListener('input', e => { const v = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(v) && v > 0) trSetLambda(v, 'nm'); });
  $ti('tr-wl-ev').addEventListener('input', e => { const v = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(v) && v > 0) trSetLambda(evToWavelength(v), 'ev'); });
  $ti('tr-wl-slider').addEventListener('input', e => { const v = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(v) && v > 0) trSetLambda(v, 'slider'); });

  // ── material plumbing (shared with the Mie / Cylinder labs) ──────────────
  /**
   * The custom-ε slot. The handle is the authority; `tr.epsRe` / `tr.epsIm`
   * mirror it so the readout, the CSV header, the sketch label and the share
   * link all state the same ε the formulas were given.
   */
  const trCustomEps = trSetupCustomEps($t('tr-eps-group'), () => {
    const e = trCustomEps.eps();
    tr.epsRe = e.re;
    tr.epsIm = Math.max(0, e.im);
    tr.epsDegenerate = trCustomEps.degenerate();
    if (tr.material === 'custom') trChanged();
  });
  /** setupCustomEps's own sync() is silent, so seed the mirror from the handle. */
  function trPullCustomEps() {
    const e = trCustomEps.eps();
    tr.epsRe = e.re;
    tr.epsIm = Math.max(0, e.im);
    tr.epsDegenerate = trCustomEps.degenerate();
  }
  trPullCustomEps();

  const trRiiRefSink = document.createElement('span');
  const trRii = setupRIISearch(
    {
      group: $t('tr-rii-group'),
      input: $ti('tr-rii-search'),
      results: $t('tr-rii-results'),
      status: $t('tr-rii-status'),
      ref: trRiiRefSink,
    },
    (data) => {
      trTable = data; trTableKind = 'rii';
      trTableLabel = trRiiRefSink.textContent?.trim() ?? '';
      trRiiPath = trRii.currentPath();
      trSharedRiiMissing = false;
      trChanged();
    },
  );

  function trApplyFileRows() {
    if (!trFileRows) return;
    const axis = $ti('tr-file-axis').value as ImportAxisMode;
    const values = $ti('tr-file-values').value as ImportValueMode;
    const conv = convertOpticalRows(trFileRows, axis, values);
    const nameEl = $t('tr-file-name');
    if ('error' in conv) {
      nameEl.className = 'file-error'; nameEl.textContent = conv.error;
      // the kind goes with the table: leaving it at 'file' made the next switch
      // to the database clear a table that no longer existed
      trTable = null; trTableLabel = ''; trTableKind = null;
      return;
    }
    trTable = conv.data; trTableKind = 'file';
    trTableLabel = `${trFileName} · ${conv.data.length} pts, ${conv.lambdaMinNm.toFixed(0)}–${conv.lambdaMaxNm.toFixed(0)} nm`;
    nameEl.className = 'file-name'; nameEl.textContent = trTableLabel;
  }
  $ti('tr-file').addEventListener('change', () => {
    const file = $ti('tr-file').files?.[0]; if (!file) return;
    const nameEl = $t('tr-file-name');
    nameEl.className = 'file-name'; nameEl.textContent = 'Reading…';
    file.text().then(text => {
      const parsed = parseOpticalFile(text);
      if ('error' in parsed) {
        nameEl.className = 'file-error'; nameEl.textContent = parsed.error;
        trTable = null; trTableLabel = ''; trFileRows = null;
        $ti('tr-file').value = '';
        trChanged();
        return;
      }
      trFileRows = parsed.rows; trFileName = file.name;
      const guess = inferImportModes(parsed.rows);
      $ti('tr-file-axis').value = guess.axis;
      $ti('tr-file-values').value = guess.values;
      trApplyFileRows();
      trChanged();
    });
  });
  $ti('tr-file-axis').addEventListener('change', () => { trApplyFileRows(); trChanged(); });
  $ti('tr-file-values').addEventListener('change', () => { trApplyFileRows(); trChanged(); });

  $ti('tr-material').addEventListener('change', () => {
    const v = $ti('tr-material').value;
    tr.material = v;
    if (v !== 'rii') trSharedRiiMissing = false;
    // a table belonging to the other user-supplied source would be computed under the new name
    if ((v === 'file' || v === 'rii') && trTableKind && trTableKind !== v) {
      trTable = null; trTableLabel = ''; trTableKind = null; trRiiPath = null; trFileRows = null;
      // clear the native control too, the way the parse-error path does: it kept
      // showing the old filename for data that had just been discarded, and
      // re-picking the same file would not have fired `change`
      $ti('tr-file').value = '';
      $t('tr-file-name').className = 'file-name';
      $t('tr-file-name').textContent = '';
      trRii.clear();
    }
    if (v === 'rii') void trRii.ensureCatalog();
    trChanged();
  });

  // ── geometry dialog ──────────────────────────────────────────────────────
  const trDlg = $t('tr-structure-dialog') as HTMLDialogElement;
  $t('tr-config-check').addEventListener('click', () => {
    trUpdateConfigCheck();
    if (typeof trDlg.showModal === 'function') trDlg.showModal(); else trDlg.setAttribute('open', '');
  });
  $t('tr-structure-dialog-close').addEventListener('click', () => trDlg.close());
  trDlg.addEventListener('click', e => { if (e.target === trDlg) trDlg.close(); });

  function trExportStructurePng() {
    const svg = $t('tr-structure-dialog-art').querySelector('svg') as SVGSVGElement | null;
    if (!svg) return;
    const copy = svg.cloneNode(true) as SVGSVGElement;
    const vb = (copy.getAttribute('viewBox') || '').split(/\s+/).map(Number);
    const width = vb.length === 4 && Number.isFinite(vb[2]) ? vb[2] : 320;
    const height = vb.length === 4 && Number.isFinite(vb[3]) ? vb[3] : 224;
    copy.setAttribute('width', String(width)); copy.setAttribute('height', String(height));
    const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(copy)], { type: 'image/svg+xml;charset=utf-8' }));
    const img = new Image();
    img.onload = () => {
      const scale = 4, canvas = document.createElement('canvas');
      canvas.width = Math.round(width * scale); canvas.height = Math.round(height * scale);
      const c2 = canvas.getContext('2d')!;
      c2.scale(scale, scale);
      c2.fillStyle = trChartTheme().bg; c2.fillRect(0, 0, width, height);
      c2.drawImage(img, 0, 0, width, height);
      URL.revokeObjectURL(url);
      canvas.toBlob(b => { if (b) trDownload(b, trStem() + '_geometry.png'); }, 'image/png');
    };
    img.onerror = () => URL.revokeObjectURL(url);
    img.src = url;
  }
  $t('tr-structure-export-png').addEventListener('click', trExportStructurePng);

  // ── export ───────────────────────────────────────────────────────────────
  const trStem = () => `tr_${tr.geom === 'film' ? `film_d${Math.round(tr.dNm)}nm` : 'halfspace'}_${tr.material}_${Math.round(trKeV())}keV_${tr.side}`;
  const trName = () => `${trStem()}_${tr.view}`;

  function trExportPng() {
    const src = $t('tr-chart') as HTMLCanvasElement;
    if (!src.width) return;
    const off = document.createElement('canvas');
    off.width = src.width; off.height = src.height;
    const o = off.getContext('2d')!;
    o.fillStyle = trChartTheme().bg; o.fillRect(0, 0, off.width, off.height);
    o.drawImage(src, 0, 0);
    off.toBlob(b => { if (b) trDownload(b, trName() + '.png'); }, 'image/png');
  }
  $t('tr-export-png').addEventListener('click', trExportPng);

  function trCsv(): string {
    const p6 = (v: number) => Number.isFinite(v) ? v.toPrecision(6) : 'nan';
    // the cone comes from trCone(), the one the kernels were given: the raw state
    // can hold anything that was typed, and the header must describe the numbers
    const [cone0, cone1] = trCone();
    const head = [
      `# Transition radiation — ${tr.geom === 'film' ? `free-standing film, d=${tr.dNm} nm` : 'semi-infinite half space'}`,
      `# material=${trMaterialLabel()}, K=${trKeV().toFixed(3)} keV, beta=${tr.beta.toFixed(5)}, side=${tr.side}`,
      `# collection cone theta=${+(cone0 / TDEG).toFixed(3)}-${+(cone1 / TDEG).toFixed(3)} deg, lambda=${trLamLo()}-${trLamHi()} nm`,
      '# Generated by NanophotonicsLab (nanophotonicslab.com)',
    ];
    // the plotted x axis, so an eV export says why its rows run backwards in lambda
    if (tr.view !== 'angular') {
      head.splice(head.length - 1, 0,
        `# x axis = ${tr.unit === 'eV' ? 'photon energy (eV); the rows run descending in lambda' : 'wavelength (nm)'}`);
    }
    const xcol = tr.unit === 'eV' ? 'energy_eV' : 'x_nm';
    if (tr.view === 'material') {
      if (!trMaterialReady()) {
        return [...head, '# no optical data loaded — nothing to export', ''].join('\n');
      }
      const { lam, x, n, k, epsRe, epsIm } = trMaterialCurves();
      const rows = [`lambda_nm,${xcol},n,k,epsilon_re,epsilon_im`];
      for (let i = 0; i < lam.length; i++) {
        rows.push(`${p6(lam[i])},${p6(x[i])},${p6(n[i])},${p6(k[i])},${p6(epsRe[i])},${p6(epsIm[i])}`);
      }
      return [...head, '# epsilon(lambda) as the TR formulas receive it', ...rows].join('\n') + '\n';
    }
    if (tr.view === 'angular') {
      const { thDeg, y, ref } = trAngular();
      // the Ginzburg–Frank column is the backward perfect-conductor limit, so it
      // is absent on a film's forward side exactly as it is absent from the plot
      const withRef = trRefShown();
      const rows = [`theta_deg,dGamma_per_sr_per_${trYUnit()}${withRef ? `,ginzburg_frank_backward_per_sr_per_${trYUnit()}` : ''}`];
      for (let i = 0; i < thDeg.length; i++) rows.push(`${thDeg[i].toFixed(2)},${p6(y[i])}${withRef ? ',' + p6(ref[i]) : ''}`);
      return [...head, `# angular cut at lambda=${tr.lamNm} nm`, ...rows].join('\n') + '\n';
    }
    if (tr.view === 'thickness') {
      const map = trMap ?? trComputeMap();
      // keep the provenance line last
      head.splice(head.length - 1, 0, '# the m = 1, 2, 3 resonance curves drawn over the map are not exported');
      const rows = [`lambda_nm,${xcol},d_nm,photons_per_electron_per_${trYUnit()}`];
      for (let di = 0; di < map.d.length; di++) {
        for (let i = 0; i < map.lam.length; i++) {
          rows.push(`${p6(map.lam[i])},${p6(map.x[i])},${p6(map.d[di])},${p6(map.g[di * map.lam.length + i])}`);
        }
      }
      return [...head, ...rows].join('\n') + '\n';
    }
    const { lam, x } = trAxis(TR_NSPEC);
    const main = trSpectrumOn(lam);
    if (tr.view === 'terms') {
      const ctrl = trSpectrumOn(lam, ['B1', 'B3']);
      const rows = [`lambda_nm,${xcol},full_per_${trYUnit()},B1_B3_per_${trYUnit()}`];
      for (let i = 0; i < lam.length; i++) rows.push(`${p6(lam[i])},${p6(x[i])},${p6(main[i])},${p6(ctrl[i])}`);
      return [...head, ...rows].join('\n') + '\n';
    }
    const extra = (tr.geom === 'film' && tr.overlay) ? trThickLimit(lam) : null;
    const rows = [`lambda_nm,${xcol},photons_per_electron_per_${trYUnit()}${extra ? `,thick_limit_per_${trYUnit()}` : ''}`];
    for (let i = 0; i < lam.length; i++) {
      rows.push(`${p6(lam[i])},${p6(x[i])},${p6(main[i])}${extra ? ',' + p6(extra[i]) : ''}`);
    }
    return [...head, ...rows].join('\n') + '\n';
  }
  $t('tr-export-csv').addEventListener('click', () => {
    trDownload(new Blob([trCsv()], { type: 'text/csv' }), trName() + '.csv');
  });

  // Share: the URL write keeps the address bar in step with every control, so the
  // current URL already *is* the permalink — flush the pending write, then copy
  // it, with the Mie lab's feedback. The markup is captured once, not per click:
  // reading it back off the button made a second click within the 1.5 s window
  // adopt 'Copied!' as the thing to restore, destroying the icon for good.
  const trShareBtn = $t('tr-share');
  const TR_SHARE_HTML = trShareBtn.innerHTML;
  let trShareTimer = 0;
  trShareBtn.addEventListener('click', () => {
    trFlushUrl();
    const say = (msg: string) => {
      trShareBtn.textContent = msg;
      window.clearTimeout(trShareTimer);
      trShareTimer = window.setTimeout(() => { trShareBtn.innerHTML = TR_SHARE_HTML; }, 1500);
    };
    // the Clipboard API is absent on insecure origins and in some browsers
    const copy = navigator.clipboard?.writeText(location.href);
    if (copy) copy.then(() => say('Copied!'), () => say('Press Ctrl+C'));
    else say('Press Ctrl+C');
  });

  // ── permalink (additive `tr…` query keys; nothing existing is renamed) ───
  const TR_KEYS = ['tr', 'trgeom', 'trd', 'trmat', 'trrii', 'treps', 'trepsm', 'trepsn', 'trepsk', 'trdrude', 'trkev', 'trside', 'trth', 'trwl', 'trunit', 'trview', 'trmprop', 'trlam', 'trdmap', 'trov'];
  let trRestoring = false;
  function trWriteUrl() {
    if (trRestoring) return;
    if (($t('panel-tr') as HTMLElement).hidden) return;   // another module owns the query string now
    const u = new URL(window.location.href);
    for (const k of TR_KEYS) u.searchParams.delete(k);
    u.searchParams.set('tr', '1');
    u.searchParams.set('trgeom', tr.geom);
    if (tr.geom === 'film') u.searchParams.set('trd', String(tr.dNm));
    u.searchParams.set('trmat', tr.material);
    if (tr.material === 'rii' && trRiiPath) u.searchParams.set('trrii', trRiiPath);
    if (tr.material === 'custom') {
      // 'treps' keeps its meaning (the ε pair). In n, k mode the ε keys are the
      // *derived* pair and cannot carry the link on their own — restoring them
      // rounds twice — so the typed pair rides along at full precision, and is
      // written only in that mode: every ε-mode link is byte-for-byte as before.
      u.searchParams.set('treps', `${trFmtEpsFull(tr.epsRe)},${trFmtEpsFull(tr.epsIm)}`);
      if (trCustomEps.mode === 'nk') {
        u.searchParams.set('trepsm', 'nk');
        u.searchParams.set('trepsn', trFmtEpsFull(trCustomEps.nParam.value));
        u.searchParams.set('trepsk', trFmtEpsFull(trCustomEps.kParam.value));
      }
    }
    if (tr.material === 'drude') u.searchParams.set('trdrude', `${tr.drudeEpsB},${tr.drudeWp},${tr.drudeGamma}`);
    u.searchParams.set('trkev', trKeV().toPrecision(8));
    u.searchParams.set('trside', tr.side);
    u.searchParams.set('trth', `${tr.thMin},${tr.thMax}`);
    u.searchParams.set('trwl', `${tr.lamMin},${tr.lamMax}`);
    u.searchParams.set('trunit', tr.unit);
    u.searchParams.set('trview', tr.view);
    // Scoped to the geometry, like `trov`, not to the view: keys written only
    // while their own view was open dropped the other views' settings, so a link
    // shared from the Spectrum view restored someone else's λ, thickness axis and
    // ε / n,k choice the moment the recipient clicked another tab.
    u.searchParams.set('trmprop', tr.matProp);
    u.searchParams.set('trlam', String(tr.lamNm));
    if (tr.geom === 'film') {
      u.searchParams.set('trdmap', `${tr.dMapMin},${tr.dMapMax}`);
      u.searchParams.set('trov', tr.overlay ? '1' : '0');
    }
    // Safari throws SecurityError past ~100 replaceState calls in 30 s. The URL
    // is a convenience; losing it must not take anything else down with it.
    try { history.replaceState(null, '', u.toString()); } catch { /* throttled: the address bar lags, the plot does not */ }
  }

  /**
   * The URL write is debounced: it used to run on every render, so one drag of a
   * slider emitted several hundred `replaceState` calls. The Share handler
   * flushes it synchronously, so the copied link is never one edit behind.
   */
  function trScheduleUrl() {
    window.clearTimeout(trUrlPending);
    trUrlPending = window.setTimeout(() => { trUrlPending = 0; trWriteUrl(); }, 250);
  }
  function trFlushUrl() {
    window.clearTimeout(trUrlPending);
    trUrlPending = 0;
    trWriteUrl();
  }

  /** Set while a permalink supplied the energy, so the shared velocity does not overwrite it on activation. */
  let trPinnedBeta = false;
  const trPair = (s: string | null): [number, number] | null => {
    if (!s) return null;
    const p = s.split(',').map(Number);
    return p.length === 2 && p.every(Number.isFinite) ? [p[0], p[1]] : null;
  };
  /** A query value is whatever someone put in the link: hold it to what the control allows. */
  const trClamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const trClampPair = (p: [number, number], lo: number, hi: number): [number, number] =>
    [trClamp(p[0], lo, hi), trClamp(p[1], lo, hi)];
  function trRestore(): boolean {
    const q = new URL(window.location.href).searchParams;
    if (q.get('tr') !== '1') return false;
    trRestoring = true;
    const geom = q.get('trgeom'); if (geom === 'film' || geom === 'half') tr.geom = geom;
    const dRaw = Number(q.get('trd'));
    if (Number.isFinite(dRaw) && dRaw > 0) {
      const d = trClamp(dRaw, 1, 20000);                       // the #tr-d bounds
      tr.dNm = d; $ti('tr-d').value = String(d);
      $ti('tr-d-slider').value = String(trClamp(d, 1, 1000));  // the slider's own, narrower range
    }
    const kev = Number(q.get('trkev')); if (Number.isFinite(kev) && kev > 0) { trSyncBeta(betaFromKeV(kev)); trPinnedBeta = true; }
    const side = q.get('trside'); if (side === 'backward' || side === 'forward') tr.side = side;
    // the cone is clamped to 0–90° here as well as in trCone(), so the controls
    // and the CSV header cannot advertise a band the kernels never used
    const th = trPair(q.get('trth'));
    if (th) { const c = trClampPair(th, 0, 90); [tr.thMin, tr.thMax] = c; $ti('tr-th-min').value = String(c[0]); $ti('tr-th-max').value = String(c[1]); }
    const wl = trPair(q.get('trwl'));
    if (wl) { const c = trClampPair(wl, 1, 1e6); [tr.lamMin, tr.lamMax] = c; $ti('tr-lam-min').value = String(c[0]); $ti('tr-lam-max').value = String(c[1]); }
    const unit = q.get('trunit'); if (unit === 'nm' || unit === 'eV') tr.unit = unit;
    const view = q.get('trview');
    if (view === 'spectrum' || view === 'angular' || view === 'thickness' || view === 'terms' || view === 'material') tr.view = view;
    const mprop = q.get('trmprop'); if (mprop === 'eps' || mprop === 'nk') tr.matProp = mprop;
    const lamRaw = Number(q.get('trlam'));
    if (Number.isFinite(lamRaw) && lamRaw > 0) {
      const lam = trClamp(lamRaw, 1, 1e6);
      tr.lamNm = lam; $ti('tr-wl-nm').value = String(lam); $ti('tr-wl-ev').value = String(+wavelengthToEv(lam).toFixed(4)); $ti('tr-wl-slider').value = String(Math.round(lam));
    }
    const dm = trPair(q.get('trdmap'));
    if (dm) { const c = trClampPair(dm, 1, 1e6); [tr.dMapMin, tr.dMapMax] = c; $ti('tr-dmap-min').value = String(c[0]); $ti('tr-dmap-max').value = String(c[1]); }
    const ov = q.get('trov'); if (ov === '0' || ov === '1') tr.overlay = ov === '1';
    const eps = trPair(q.get('treps'));
    if (eps) {
      // The ε keys are the authority; the n, k boxes follow the mode switch,
      // and the typed pair lands *after* it because setMode derives n, k from ε.
      trCustomEps.setMode('eps');
      trCustomEps.reParam.fit(eps[0]);
      trCustomEps.imParam.fit(Math.max(0, eps[1]));
      if (q.get('trepsm') === 'nk') {
        trCustomEps.setMode('nk');
        const tn = Number(q.get('trepsn')); if (Number.isFinite(tn)) trCustomEps.nParam.fit(tn);
        const tk = Number(q.get('trepsk')); if (Number.isFinite(tk)) trCustomEps.kParam.fit(tk);
      }
      trPullCustomEps();
    }
    const dr = q.get('trdrude');
    if (dr) {
      const p = dr.split(',').map(Number);
      if (p.length === 3 && p.every(Number.isFinite)) {
        [tr.drudeEpsB, tr.drudeWp, tr.drudeGamma] = p as [number, number, number];
        $ti('tr-drude-epsb').value = String(p[0]); $ti('tr-drude-wp').value = String(p[1]); $ti('tr-drude-gamma').value = String(p[2]);
      }
    }
    // The one key that used to be taken verbatim: an unmatched value sets the
    // <select> to selectedIndex = -1, which renders blank, hides every material
    // sub-panel, makes epsAt fall back to vacuum and was written straight back
    // into the URL. No UI interaction can produce that state, so refuse it.
    const mat = q.get('trmat');
    const matOk = !!mat && Array.from($ti('tr-material').querySelectorAll('option')).some(o => o.value === mat);
    if (matOk) { tr.material = mat as string; $ti('tr-material').value = mat as string; }
    // consistency: the restored combination must still be a legal one
    if (tr.geom === 'half') {
      tr.side = 'backward';
      if (tr.view === 'thickness' || tr.view === 'terms') tr.view = 'spectrum';
    }
    trRestoring = false;
    const riiPath = q.get('trrii');
    if (tr.material === 'rii' && riiPath) {
      // kept optimistically so a link copied before the fetch resolves still carries the entry
      trRiiPath = riiPath;
      void trRii.selectByPath(riiPath).then(ok => {
        if (!ok) { trSharedRiiMissing = true; trTableLabel = ''; trRiiPath = null; }
        trChanged();
      });
    }
    return true;
  }

  // ── activation / lifecycle ───────────────────────────────────────────────
  (window as any).__trActivate = (beta: number) => {
    // the panel is revealed by setModule before this runs, so the canvas now has a width.
    // A permalink's own energy wins over the page-wide velocity, once.
    if (trPinnedBeta) trPinnedBeta = false;
    else if (beta > 0 && beta < 1) trSyncBeta(beta);
    trMap = null;
    renderTR();
  };

  /** Leaving the module takes the tr… keys back out, so a link shared from another module is that module's. */
  (window as any).__trModuleChanged = (active: boolean) => {
    if (active) return;
    // The panel is already hidden, so renderTR cannot reach its own cancels:
    // drop the queued map compute (it would run a discarded 1.3M-point map on
    // the main thread) and the queued URL write (it would put the keys back).
    ++trRenderToken;
    window.clearTimeout(trMapPending);
    trMapPending = 0;
    window.clearTimeout(trUrlPending);
    trUrlPending = 0;
    const u = new URL(window.location.href);
    let touched = false;
    for (const k of TR_KEYS) if (u.searchParams.has(k)) { u.searchParams.delete(k); touched = true; }
    if (touched) history.replaceState(null, '', u.toString());
  };

  let trRT = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(trRT);
    trRT = window.setTimeout(() => { if (!($t('panel-tr') as HTMLElement).hidden) renderTR(); }, 120);
  });
  trOnThemeChange(() => { if (!($t('panel-tr') as HTMLElement).hidden) renderTR(); });

  trSyncBeta(tr.beta);
  $ti('tr-material').value = tr.material;
  if (trRestore()) {
    (window as any).__electronSetModule?.('tr');
    if (tr.material === 'rii') void trRii.ensureCatalog();
  }
</script>
