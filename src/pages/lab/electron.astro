<!-- ===================== PINEM module ===================== -->
<script>
  import {
    sidebandProbabilities, pinemSpectrum, chargeDensity, analyzeFocus, talbotDistanceM,
    beamPhotonEV, beamPeriodS, beamGamma, betaToEnergyEV, energyEVToBeta,
    eVFromWavelengthNm, wavelengthNmFromEV, type Beam, type DispMethod,
  } from '../../lib/pinem';
  import { downloadBlob as pnDownload } from '../../lib/download';

  const $p = (id: string) => document.getElementById(id) as HTMLElement;
  const PIp = Math.PI;
  const cvarp = (n: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim() || '#888';

  const pn = {
    beta: 0.5867, absg: 5, phaseDeg: 0, wavelengthNm: 800, wlUnit: 'nm' as 'nm' | 'eV',
    nmax: 40, nshow: 15, method: 'exact' as DispMethod,
    view: 'spectrum' as 'spectrum' | 'billiard', sub: 'probability' as 'probability' | 'eels' | 'propagation',
    fwhmEV: 0.5, eMinEV: -20, eMaxEV: 20,
    tauRange: 1.5, zMaxMm: 5, cohNm: 0, fullTalbot: false,
    gMax: 6,
  };
  const pnBeam = (): Beam => ({ energyEV: betaToEnergyEV(pn.beta), wavelengthNm: pn.wavelengthNm });

  // canvas helpers
  function ctx2dP(canvas: HTMLCanvasElement) {
    const r = canvas.getBoundingClientRect();
    if (r.width < 4 || r.height < 4) return null;
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);
    const ctx = canvas.getContext('2d')!; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, r.width, r.height);
    return { ctx, w: r.width, h: r.height };
  }
  type Frame = { px: (x: number) => number; py: (y: number) => number; m: { l: number; r: number; t: number; b: number }; w: number; h: number };
  function frameP(ctx: CanvasRenderingContext2D, w: number, h: number, xmin: number, xmax: number, ymin: number, ymax: number, xlabel: string, ylabel: string, xticks: number[], yticks: number[], fmtX = (v: number) => String(v), fmtY = (v: number) => String(v)): Frame {
    const m = { l: 58, r: 30, t: 14, b: 40 };
    const px = (x: number) => m.l + (x - xmin) / (xmax - xmin) * (w - m.l - m.r);
    const py = (y: number) => h - m.b - (y - ymin) / (ymax - ymin) * (h - m.t - m.b);
    ctx.font = '11px ' + (cvarp('--font') || 'sans-serif'); ctx.fillStyle = cvarp('--text-muted');
    ctx.strokeStyle = cvarp('--bg-muted'); ctx.lineWidth = 1; ctx.strokeRect(m.l, m.t, w - m.l - m.r, h - m.t - m.b);
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (const y of yticks) { const Y = py(y); if (Y < m.t - 1 || Y > h - m.b + 1) continue; ctx.strokeStyle = 'rgba(140,140,150,0.14)'; ctx.beginPath(); ctx.moveTo(m.l, Y); ctx.lineTo(w - m.r, Y); ctx.stroke(); ctx.fillStyle = cvarp('--text-muted'); ctx.fillText(fmtY(y), m.l - 6, Y); }
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    for (const x of xticks) { const X = px(x); if (X < m.l - 1 || X > w - m.r + 1) continue; ctx.fillText(fmtX(x), X, h - m.b + 6); }
    ctx.fillStyle = cvarp('--text-soft'); ctx.fillText(xlabel, (m.l + w - m.r) / 2, h - 13);
    ctx.save(); ctx.translate(13, (m.t + h - m.b) / 2); ctx.rotate(-PIp / 2); ctx.fillText(ylabel, 0, 0); ctx.restore();
    return { px, py, m, w, h };
  }
  function ticksNice(min: number, max: number, n = 6): number[] {
    const span = max - min; if (span <= 0) return [min];
    const raw = span / n, mag = Math.pow(10, Math.floor(Math.log10(raw))), norm = raw / mag;
    const step = (norm < 1.5 ? 1 : norm < 3 ? 2 : norm < 7 ? 5 : 10) * mag;
    const out: number[] = []; for (let v = Math.ceil(min / step) * step; v <= max + step * 0.01; v += step) out.push(Math.abs(v) < step * 1e-6 ? 0 : v);
    return out;
  }
  const HOT = (t: number): number[] => { t = Math.max(0, Math.min(1, t)); const r = Math.min(1, t * 3), g = Math.min(1, Math.max(0, t * 3 - 1)), b = Math.min(1, Math.max(0, t * 3 - 2)); return [r * 255, g * 255, b * 255]; };
  const MAGMA_STOPS = [[0, 0, 4], [40, 11, 84], [101, 21, 110], [159, 42, 99], [212, 72, 66], [245, 125, 21], [250, 193, 39], [252, 253, 191]];
  const MAGMA = (t: number): number[] => { t = Math.max(0, Math.min(1, t)); const x = t * (MAGMA_STOPS.length - 1), i = Math.min(MAGMA_STOPS.length - 2, Math.floor(x)), f = x - i, a = MAGMA_STOPS[i], b = MAGMA_STOPS[i + 1]; return [a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f]; };
  function heatmap(ctx: CanvasRenderingContext2D, fr: Frame, nx: number, ny: number, data: Float64Array, cmap: (t: number) => number[], smooth = true) {
    const off = document.createElement('canvas'); off.width = nx; off.height = ny; const octx = off.getContext('2d')!; const img = octx.createImageData(nx, ny);
    for (let iy = 0; iy < ny; iy++) for (let ix = 0; ix < nx; ix++) {
      const t = data[iy * nx + ix], pi = ((ny - 1 - iy) * nx + ix) * 4; const rgb = Number.isFinite(t) ? cmap(t) : [0, 0, 0];
      img.data[pi] = rgb[0]; img.data[pi + 1] = rgb[1]; img.data[pi + 2] = rgb[2]; img.data[pi + 3] = 255;
    }
    octx.putImageData(img, 0, 0);
    const { m, w, h } = fr; ctx.imageSmoothingEnabled = smooth; ctx.drawImage(off, m.l, m.t, w - m.l - m.r, h - m.t - m.b);
    ctx.strokeStyle = cvarp('--bg-muted'); ctx.lineWidth = 1; ctx.strokeRect(m.l, m.t, w - m.l - m.r, h - m.t - m.b);
  }
  function colorbar(ctx: CanvasRenderingContext2D, fr: Frame, cmap: (t: number) => number[], loLabel: string, hiLabel: string) {
    const { m, w, h } = fr, cbx = w - m.r + 6, cbh = h - m.t - m.b, NB = 48;
    for (let i = 0; i < NB; i++) { const rgb = cmap(i / (NB - 1)); ctx.fillStyle = `rgb(${rgb[0] | 0},${rgb[1] | 0},${rgb[2] | 0})`; ctx.fillRect(cbx, m.t + cbh - (i + 1) / NB * cbh, 8, cbh / NB + 1); }
    ctx.strokeStyle = cvarp('--bg-muted'); ctx.strokeRect(cbx, m.t, 8, cbh);
    ctx.fillStyle = cvarp('--text-muted'); ctx.font = '9px ' + (cvarp('--font') || 'sans-serif'); ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    ctx.fillText(hiLabel, cbx + 11, m.t + 4); ctx.fillText(loLabel, cbx + 11, m.t + cbh - 4);
  }

  // sub-tabs
  const PN_SUBTABS: Record<string, { id: string; label: string }[]> = {
    spectrum: [{ id: 'probability', label: 'Probability' }, { id: 'eels', label: 'EELS' }, { id: 'propagation', label: 'Propagation' }],
    billiard: [],
  };
  function renderPnSubTabs() {
    const box = $p('pn-sub-tabs'); box.innerHTML = '';
    const subs = PN_SUBTABS[pn.view];
    box.style.display = subs.length ? '' : 'none';
    for (const t of subs) {
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'sp-sub-tab' + (pn.sub === t.id ? ' active' : ''); btn.textContent = t.label; btn.dataset.sub = t.id;
      btn.addEventListener('click', () => { pn.sub = t.id as any; renderPnSubTabs(); renderPn(); });
      box.appendChild(btn);
    }
  }

  // render dispatch
  function updatePnControlVis() {
    const isBill = pn.view === 'billiard';
    ($p('pn-range-N') as HTMLElement).hidden = !(pn.sub === 'probability' || isBill);
    ($p('pn-range-eels') as HTMLElement).hidden = isBill || pn.sub !== 'eels';
    ($p('pn-range-prop') as HTMLElement).hidden = isBill || pn.sub !== 'propagation';
    ($p('pn-range-billiard') as HTMLElement).hidden = !isBill;
  }
  let pnPropRaf = 0, pnChart = '';
  const setPnComputing = (on: boolean) => $p('pn-result-card').classList.toggle('is-computing', on);
  function renderPn() {
    updatePnControlVis();
    const title = $p('pn-chart-title');
    const isProp = pn.view !== 'billiard' && pn.sub === 'propagation';
    // navigating away from propagation cancels any pending compute + clears the loading rim
    if (pnPropRaf && !isProp) { cancelAnimationFrame(pnPropRaf); pnPropRaf = 0; setPnComputing(false); }
    if (pn.view === 'billiard') { title.textContent = 'Billiard — Pₙ vs coupling |g| (Rabi / quantum walk)'; drawBilliard(); updateMetrics(); pnChart = 'billiard'; }
    else if (pn.sub === 'probability') { title.textContent = `Sideband probabilities Pₙ = Jₙ(2|g|)²  ·  |g| = ${pn.absg}`; drawProbability(); updateMetrics(); pnChart = 'prob'; }
    else if (pn.sub === 'eels') { title.textContent = `EELS spectrum  ·  |g| = ${pn.absg}, Γ = ${pn.fwhmEV} eV`; drawEELS(); updateMetrics(); pnChart = 'eels'; }
    else {
      // Propagation is expensive — paint an empty frame + spin the loading rim first,
      // then compute the carpet on a later frame so the page stays responsive.
      title.textContent = `Co-moving charge density ρ(z, τ)  ·  |g| = ${pn.absg}`;
      if (pnChart !== 'prop') drawPropagation(false);   // fresh entry → instant empty plot
      updateMetrics(false);                              // cheap tiles now, focus deferred
      setPnComputing(true);
      if (pnPropRaf) cancelAnimationFrame(pnPropRaf);
      pnPropRaf = requestAnimationFrame(() => requestAnimationFrame(() => {
        pnPropRaf = 0;
        drawPropagation(true);
        updateMetrics(true);
        setPnComputing(false);
      }));
      pnChart = 'prop';
    }
  }

  function drawProbability() {
    const c = ctx2dP($p('pn-chart') as HTMLCanvasElement); if (!c) return; const { ctx, w, h } = c;
    const { N, P } = sidebandProbabilities(pn.absg, pn.nmax);
    const ns = pn.nshow; let pmax = 0; for (let i = 0; i < N.length; i++) if (Math.abs(N[i]) <= ns) pmax = Math.max(pmax, P[i]);
    pmax = Math.max(pmax, 1e-6);
    const fr = frameP(ctx, w, h, -ns - 0.6, ns + 0.6, 0, pmax * 1.08, 'photon order N', 'Pₙ', ticksNice(-ns, ns).filter(v => Number.isInteger(v)), ticksNice(0, pmax * 1.08), v => String(Math.round(v)), v => v.toFixed(2));
    const bw = Math.max(2, (fr.px(1) - fr.px(0)) * 0.7);
    for (let i = 0; i < N.length; i++) { if (Math.abs(N[i]) > ns) continue; const X = fr.px(N[i]), y0 = fr.py(0), y1 = fr.py(P[i]); ctx.fillStyle = N[i] === 0 ? cvarp('--primary') : 'rgba(99,102,241,0.6)'; ctx.fillRect(X - bw / 2, y1, bw, y0 - y1); }
    let psum = 0; for (const p of P) psum += p;
    $p('pn-readout').innerHTML = `<span>2|g| (Rabi phase) = <b>${(2 * pn.absg).toFixed(2)}</b></span><span>Σ Pₙ = <b>${psum.toFixed(4)}</b> (nₘₐₓ = ${pn.nmax})</span>`;
  }

  function drawEELS() {
    const c = ctx2dP($p('pn-chart') as HTMLCanvasElement); if (!c) return; const { ctx, w, h } = c;
    const b = pnBeam(), NE = 800, e0 = Math.min(pn.eMinEV, pn.eMaxEV), e1 = Math.max(pn.eMinEV, pn.eMaxEV);
    const E = new Float64Array(NE); for (let i = 0; i < NE; i++) E[i] = e0 + (e1 - e0) * i / (NE - 1);
    const S = pinemSpectrum(pn.absg, E, pn.fwhmEV, beamPhotonEV(b), pn.nmax, true);
    const fr = frameP(ctx, w, h, e0, e1, 0, 1.08, 'electron energy loss / gain (eV)', 'norm. probability', ticksNice(e0, e1), ticksNice(0, 1), v => v.toFixed(0), v => v.toFixed(1));
    const { N, P } = sidebandProbabilities(pn.absg, pn.nmax); let pmax = 0; for (const p of P) pmax = Math.max(pmax, p);
    ctx.strokeStyle = 'rgba(140,140,150,0.5)'; ctx.lineWidth = 1;
    for (let i = 0; i < N.length; i++) { if (P[i] < 1e-4) continue; const Ei = N[i] * beamPhotonEV(b); if (Ei < e0 || Ei > e1) continue; const X = fr.px(Ei); ctx.beginPath(); ctx.moveTo(X, fr.py(0)); ctx.lineTo(X, fr.py(P[i] / pmax)); ctx.stroke(); }
