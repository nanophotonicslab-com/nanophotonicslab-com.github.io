    spMapState = { ml: m.l, mr: m.r, mt: m.t, mb: m.b, w, h, thMin, thMax, y0, y1, isEv, NX, NU, M, S0, mx, which };
    // colorbar
    const cbx = w - m.r + 20, cbh = h - m.t - m.b; const NB = 48;
    for (let i = 0; i < NB; i++) { const t = i / (NB - 1), rgb = which === 'amplitude' ? cmapInt(t) : cmapDiv(t * 2 - 1); ctx.fillStyle = `rgb(${rgb[0] | 0},${rgb[1] | 0},${rgb[2] | 0})`; ctx.fillRect(cbx, m.t + cbh - (i + 1) / NB * cbh, 11, cbh / NB + 1); }
    ctx.strokeStyle = cvar('--bg-muted'); ctx.strokeRect(cbx, m.t, 11, cbh);
    ctx.fillStyle = cvar('--text-muted'); ctx.font = '9px ' + (cvar('--font') || 'sans-serif'); ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    if (which === 'amplitude') { ctx.fillText('1', cbx + 14, m.t); ctx.fillText('0', cbx + 14, m.t + cbh); }
    else { ctx.fillText('+1', cbx + 14, m.t); ctx.fillText('0', cbx + 14, m.t + cbh / 2); ctx.fillText('−1', cbx + 14, m.t + cbh); }
