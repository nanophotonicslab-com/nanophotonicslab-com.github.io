    try { spec = geometrySpectrumMulti(geo, '11', D, epsBar, mat, Eev, modes); }
    catch (err) { return { error: '2D compute failed: ' + (err as Error).message }; }
    const eV: number[] = [], ax: Cpx[] = [];
