  }
  $('sp-export-png').addEventListener('click', () => exportPng($('sp-chart') as HTMLCanvasElement, spChartName() + '.png'));
  $('sp-export-csv').addEventListener('click', () => { const { name, csv } = spResultCSV(); downloadBlob(new Blob([csv], { type: 'text/csv' }), name); });

  // ── module switching (Fields / Smith–Purcell / PINEM) ──
  let spReady = false;
