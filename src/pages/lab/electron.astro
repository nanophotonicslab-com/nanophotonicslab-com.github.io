<!-- ===== Scoped styles ===== -->
<style>  .module-bar { --module-cols: 4; }
  @media (max-width: 1024px) { .module-bar { --module-cols: 2; } }
  @media (max-width: 760px) { .module-bar__grid { grid-template-columns: 1fr; } }
  .param-box {
    padding: var(--space-sm);
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
  }
  /* Results */
  .results-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-md); min-width: 0; }
  .result-panel { min-width: 0; padding: var(--space-md); display: flex; flex-direction: column; gap: var(--space-sm); }
  .chart-stat { font-size: 0.75rem; font-weight: 600; color: var(--text-soft); font-variant-numeric: tabular-nums; }.chart-wrap canvas { --chart-aspect: 4 / 3; }
  #freq-field-chart,
  #time-field-chart { cursor: crosshair; }
  /* ===================== Smith–Purcell module ===================== */
  .sp-param { display: flex; flex-direction: column; gap: 0.3rem; }
  .sp-param[hidden] { display: none; }
  .sp-param__head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-sm); }
  .sp-param__head label { font-size: 0.8125rem; font-weight: 500; color: var(--text); }
  .sp-num { width: 5.2rem; text-align: right; }
  .sp-slider { -webkit-appearance: none; appearance: none; width: 100%; height: 5px; background: var(--bg-muted); border-radius: 3px; outline: none; cursor: pointer; }
  .sp-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%; background: var(--primary); cursor: pointer; }
  .sp-slider::-moz-range-thumb { width: 14px; height: 14px; border-radius: 50%; background: var(--primary); border: none; cursor: pointer; }
  .sp-aol { margin: 0; font-size: 0.72rem; color: var(--text-muted); line-height: 1.4; }

  /* spectral-map axis ranges (emission angle / wavelength) */
  .sp-range { display: flex; flex-direction: column; gap: 0.3rem; }
  .sp-range[hidden] { display: none; }
  .sp-range__head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-sm); }
  .sp-range > label, .sp-range__head label { font-size: 0.8125rem; font-weight: 500; color: var(--text); }
  .sp-range__row { display: flex; align-items: center; gap: 0.4rem; }
  .sp-rnum { flex: 1; min-width: 0; text-align: right; padding: 0.25rem 0.4rem; font-size: 0.8rem; }
  .sp-range__dash { font-size: 0.72rem; color: var(--text-muted); }
  .sp-unit-toggle { display: inline-flex; border: 1px solid var(--bg-muted); border-radius: var(--radius-full); overflow: hidden; }
  .sp-unit-toggle button { padding: 0.15rem 0.55rem; border: none; background: var(--bg); color: var(--text-soft); font-family: var(--font); font-size: 0.72rem; font-weight: 700; cursor: pointer; }
  .sp-unit-toggle button + button { border-left: 1px solid var(--bg-muted); }
  .sp-unit-toggle button.active { background: var(--primary); color: white; }
  /* view-dependent controls: ranges (Spectrum) vs single wavelength (Far-field) — id [hidden] beats the display rule */
  #sp-th-field[hidden], #sp-spec-field[hidden], #sp-wl-field[hidden] { display: none; }
  .sp-wl-slider-row { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.45rem; }
  .sp-wl-slider-row .sp-slider { flex: 1; min-width: 0; }

  /* custom complex dipole p = (pₓ, p_y, p_z) */
  .sp-dipole { display: flex; flex-direction: column; gap: 0.5rem; padding: 0.6rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm); }
  .sp-dipole[hidden] { display: none; }   /* class display: flex would otherwise override the hidden attribute */
  .sp-dipole__cap { font-size: 0.72rem; font-weight: 600; color: var(--text-muted); }
  .sp-dipole--readonly .sp-cnum { background: var(--bg-muted); color: var(--text-soft); cursor: default; }   /* computed (non-editable) values */
  .sp-dipole__row { display: grid; grid-template-columns: 1.8rem 1fr 1fr; gap: 0.4rem; align-items: center; }
  .sp-dipole__head span { font-size: 0.7rem; font-weight: 700; color: var(--text-muted); text-align: center; }
  .sp-dipole__head span:first-child { visibility: hidden; }
  .sp-dipole__row label { font-size: 0.8rem; font-weight: 600; color: var(--text); }
  .sp-cnum { width: 100%; text-align: right; padding: 0.25rem 0.4rem; font-size: 0.8rem; }
  .sp-dipole__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
  .sp-dipole__mag { font-size: 0.72rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .sp-normalize { padding: 0.3rem 0.7rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-full); background: var(--bg); color: var(--text-soft); font-family: var(--font); font-size: 0.72rem; font-weight: 700; cursor: pointer; transition: border-color 0.15s, color 0.15s; }
  .sp-normalize:hover { border-color: var(--primary); color: var(--primary); }

  /* geometry schematic (click to enlarge) */
  .sp-geo { position: relative; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm); background: var(--bg); cursor: zoom-in; overflow: hidden; }
  .sp-geo canvas { width: 100%; aspect-ratio: 3 / 2; display: block; }
  .sp-geo:hover { border-color: var(--primary-light); }
  .sp-geo__hint { position: absolute; bottom: 0.35rem; right: 0.45rem; font-size: 0.66rem; font-weight: 700; color: var(--text-muted); background: color-mix(in srgb, var(--bg) 80%, transparent); padding: 0.05rem 0.35rem; border-radius: var(--radius-full); }
  .sp-geo__png { position: absolute; top: 0.35rem; right: 0.45rem; z-index: 2; padding: 0.08rem 0.42rem; font-size: 0.62rem; font-weight: 700; border: 1px solid var(--bg-muted); border-radius: var(--radius-full); background: color-mix(in srgb, var(--bg) 85%, transparent); color: var(--text-soft); cursor: pointer; font-family: var(--font); }
  .sp-geo__png:hover { border-color: var(--primary); color: var(--primary); }
  .sp-geo-dialog__png { position: absolute; top: 0.45rem; right: 3rem; z-index: 2; }
  /* result-box export bar + shared tool-btn (not defined elsewhere in this file) */
  .sp-export-bar { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: var(--space-xs); padding-top: var(--space-sm); border-top: 1px solid var(--bg-muted); }
  .sp-geo-dialog { border: none; border-radius: var(--radius-md); padding: 0; background: var(--bg); box-shadow: var(--shadow-lg); max-width: 92vw; }
  .sp-geo-dialog::backdrop { background: rgba(15, 18, 30, 0.55); }
  .sp-geo-dialog__panel { position: relative; padding: var(--space-md); }
  .sp-geo-dialog__panel canvas { width: min(760px, 86vw); aspect-ratio: 3 / 2; display: block; }
  .sp-geo-dialog__close { position: absolute; top: 0.4rem; right: 0.5rem; width: 1.9rem; height: 1.9rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-full); background: var(--bg); color: var(--text-soft); font-size: 1.1rem; line-height: 1; cursor: pointer; }
