<script>
  import { chartTheme, onThemeChange } from '../../lib/chart-theme';

  // ===== Physical constants (CODATA 2018) =====
  const AU_EV = 27.2113834;
  const C_AU  = 137.03599971;
  const M_E   = 9.1093837015e-31;
  const C     = 299792458.0;
  const H     = 6.62607015e-34;
  const EV    = 1.602176634e-19;
  const EPS0  = 8.8541878128e-12;
  const E0    = M_E * C * C;
  const AU_NM = 0.05291772083;
  const NM_AU = 1 / AU_NM;

  // ===== Conversion functions (canonical unit: eV) =====

  function keFromV(vc: number): number {
    if (vc < 0 || vc >= 1) return NaN;
    return AU_EV * C_AU * C_AU * (1 / Math.sqrt(1 - vc * vc) - 1);
  }

  function vFromKe(eV: number): number {
    if (eV < 0) return NaN;
    const t = eV / (AU_EV * C_AU * C_AU) + 1;
    return Math.sqrt(1 - 1 / (t * t));
  }

  function lambdaFromK(eV: number): number {
    if (eV <= 0) return NaN;
    const kJ = eV * EV;
    const E = E0 + kJ;
    const pc = Math.sqrt(E * E - E0 * E0);
    if (pc === 0) return Infinity;
    return (H / (pc / C)) * 1e12;
  }

  function kFromLambda(pm: number): number {
    if (pm <= 0) return NaN;
    const p = H / (pm * 1e-12);
    const E = Math.sqrt((p * C) ** 2 + E0 * E0);
    return (E - E0) / EV;
  }

  function vNmFsFromKe(eV: number): number {
    const vc = vFromKe(eV);
    return isNaN(vc) ? NaN : vc * C * 1e-6;
  }

  function keFromVNmFs(v: number): number {
    if (v < 0) return NaN;
    const ms = v * 1e6;
    return ms >= C ? NaN : keFromV(ms / C);
  }

  function joulesFromKe(eV: number): number { return eV < 0 ? NaN : eV * EV; }
  function keFromJoules(j: number): number  { return j < 0 ? NaN : j / EV; }

  function gammaFromKe(eV: number): number  { return eV < 0 ? NaN : (eV * EV) / E0 + 1; }
  function keFromGamma(g: number): number   { return g < 1 ? NaN : ((g - 1) * E0) / EV; }

  // ===== Formatting =====

  function fmt(v: number): string {
    if (!isFinite(v)) return '';
    if (v === 0) return '0';
    const a = Math.abs(v);
    if (a < 1e-3 || a >= 1e6) return v.toExponential(3);
    return parseFloat(v.toPrecision(6)).toString();
  }

  function fmtJ(v: number): string {
    if (!isFinite(v)) return '';
    return v.toExponential(2);
  }

  // ===== DOM =====

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;

  const inputs: Record<string, HTMLInputElement> = {
    vc: $('vc'), kev: $('kev'), lam: $('lam'),
    vnmfs: $('vnmfs'), ej: $('ej'), gamma: $('gamma'),
  };

  const fieldInputs: Record<string, HTMLInputElement> = {
    r: $('field-r'),
    z: $('field-z'),
    wMin: $('field-w-min'),
    wMax: $('field-w-max'),
  };

  const gaugeFill = $('gauge-fill');
  const gaugePct  = document.getElementById('gauge-pct')!;
  const lambdaValue = document.getElementById('lambda-value')!;
  const fwhmValue = document.getElementById('fwhm-value')!;
  const freqFieldNote = document.getElementById('freq-field-note')!;
  const timeFieldNote = document.getElementById('time-field-note')!;

  let activeField: string | null = null;
  let currentEv = NaN;
  let freqHoverX: number | null = null;
  let timeHoverX: number | null = null;

  // ===== Update logic =====

  function updateFrom(eV: number, source: string) {
    if (isNaN(eV) || eV < 0) return;
    currentEv = eV;

    if (source !== 'vc')    inputs.vc.value    = fmt(vFromKe(eV));
    if (source !== 'kev')   inputs.kev.value   = fmt(eV / 1000);
    if (source !== 'lam')   inputs.lam.value   = fmt(lambdaFromK(eV));
    if (source !== 'vnmfs') inputs.vnmfs.value = fmt(vNmFsFromKe(eV));
    if (source !== 'ej')    inputs.ej.value    = fmtJ(joulesFromKe(eV));
    if (source !== 'gamma') inputs.gamma.value = fmt(gammaFromKe(eV));

    updateGauge(vFromKe(eV));
    updatePresets(eV / 1000);
    drawAllCharts();
  }

  function clearAll() {
    for (const inp of Object.values(inputs)) inp.value = '';
    currentEv = NaN;
    gaugeFill.style.width = '0%';
    gaugeFill.style.backgroundPosition = '0% 0';
    gaugePct.innerHTML = '&mdash;';
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    drawAllCharts();
  }

  function updateGauge(vc: number) {
    if (isNaN(vc) || vc < 0) { gaugeFill.style.width = '0%'; gaugePct.innerHTML = '&mdash;'; return; }
    const pct = Math.min(vc * 100, 99.99);
    gaugeFill.style.width = pct + '%';
    gaugeFill.style.backgroundPosition = pct + '% 0';
    gaugePct.textContent = pct.toFixed(2) + '% c';
  }

  function updatePresets(keV: number) {
    document.querySelectorAll('.preset-btn').forEach(b => {
      const pk = parseFloat((b as HTMLElement).dataset.kev!);
      b.classList.toggle('active', Math.abs(keV - pk) / pk < 0.001);
    });
  }

  // ===== Input handlers =====

  function toEv(field: string, val: number): number {
    switch (field) {
      case 'vc':    return keFromV(val);
      case 'kev':   return val * 1000;
      case 'lam':   return kFromLambda(val);
      case 'vnmfs': return keFromVNmFs(val);
      case 'ej':    return keFromJoules(val);
      case 'gamma': return keFromGamma(val);
      default:      return NaN;
    }
  }

  for (const [name, inp] of Object.entries(inputs)) {
    inp.addEventListener('focus', () => { activeField = name; });
    inp.addEventListener('input', () => {
      if (activeField !== name) return;
      const raw = inp.value.trim();
      if (raw === '') { clearAll(); return; }
      const num = parseFloat(raw);
      if (isNaN(num)) return;
      const eV = toEv(name, num);
      if (!isNaN(eV)) updateFrom(eV, name);
    });
  }

  for (const inp of Object.values(fieldInputs)) {
    inp.addEventListener('input', drawAllCharts);
  }

  // Presets
  document.getElementById('presets')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.preset-btn') as HTMLElement | null;
    if (!btn) return;
    const keV = parseFloat(btn.dataset.kev!);
    activeField = 'kev';
    inputs.kev.value = keV.toString();
    updateFrom(keV * 1000, 'kev');
    inputs.kev.focus();
  });

  // Clear
  document.getElementById('clear-btn')!.addEventListener('click', clearAll);

  // ===== Chart =====

  const CHART = {
    kMin: 0.01, kMax: 1000,        // keV
    lMin: 0.1,  lMax: 1000,        // pm
    margin: { top: 28, right: 18, bottom: 58, left: 58 },
    refs: [
      { k: 30,  label: 'SEM 30 kV',  color: '#D97706' },
      { k: 120, label: 'TEM 120 kV', color: '#7C3AED' },
      { k: 200, label: 'TEM 200 kV', color: '#7C3AED' },
    ],
  };

  const logKMin = Math.log10(CHART.kMin);
  const logKMax = Math.log10(CHART.kMax);
  const logLMin = Math.log10(CHART.lMin);
  const logLMax = Math.log10(CHART.lMax);

  type PlotSeries = { x: number[]; y: number[]; color: string; label: string; lineWidth?: number };
  type PlotRef = { x: number; label: string; color: string };
  type PlotMarker = { x: number; y: number; color: string; label?: string };
  type HoverValue = { label: string; value: number; color: string };

  const PLOT_MARGIN = { top: 28, right: 18, bottom: 58, left: 58 };

  function parseFieldValue(name: string, fallback: number): number {
    const v = parseFloat(fieldInputs[name].value);
    return Number.isFinite(v) ? v : fallback;
  }

  function fieldSettings() {
    const rNm = Math.max(0.001, Math.abs(parseFieldValue('r', 2)));
    const zNm = parseFieldValue('z', 2);
    let wMin = Math.max(1e-5, parseFieldValue('wMin', 0.01));
    let wMax = Math.max(1e-5, parseFieldValue('wMax', 10));
    if (wMax < wMin) [wMin, wMax] = [wMax, wMin];
    if (Math.abs(wMax - wMin) < 1e-9) wMax = wMin + 1;
    const points = 240;
    return { rNm, zNm, wMin, wMax, points };
  }

  function setupCanvas(canvas: HTMLCanvasElement) {
    const ct = chartTheme();
    const ctx = canvas.getContext('2d')!;
    const dpr = window.devicePixelRatio || 1;
    const w = Math.max(1, canvas.clientWidth);
    const h = Math.max(1, canvas.clientHeight);
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    ctx.scale(dpr, dpr);
    return { ct, ctx, w, h };
  }

  function drawEmptyChart(canvas: HTMLCanvasElement, message: string) {
    const { ct, ctx, w, h } = setupCanvas(canvas);
    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, w, h);
    ctx.fillStyle = ct.textSoft;
    ctx.font = '600 12px Inter, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(message, w / 2, h / 2);
  }

  function niceStep(rawStep: number): number {
    const exp = Math.floor(Math.log10(rawStep));
    const f = rawStep / 10 ** exp;
    const nf = f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10;
    return nf * 10 ** exp;
  }

  function niceTicks(min: number, max: number, count = 5): number[] {
    if (!Number.isFinite(min) || !Number.isFinite(max)) return [];
    if (min === max) {
      const pad = Math.abs(min) > 0 ? Math.abs(min) * 0.5 : 1;
      min -= pad;
      max += pad;
    }
    const step = niceStep(Math.abs(max - min) / Math.max(1, count - 1));
    const first = Math.ceil(min / step) * step;
    const ticks: number[] = [];
    for (let v = first; v <= max + step * 0.5; v += step) ticks.push(Math.abs(v) < step * 1e-10 ? 0 : v);
    return ticks;
  }

  function logTicks(min: number, max: number): number[] {
    const ticks: number[] = [];
    const a = Math.ceil(Math.log10(min));
    const b = Math.floor(Math.log10(max));
    for (let e = a; e <= b; e++) ticks.push(10 ** e);
    return ticks;
  }

  function axisLabel(v: number): string {
    if (!Number.isFinite(v)) return '';
    if (v === 0) return '0';
    const a = Math.abs(v);
    if (a >= 1e4 || a < 1e-2) return v.toExponential(0);
    if (a >= 100) return v.toFixed(0);
    if (a >= 10) return parseFloat(v.toFixed(1)).toString();
    return parseFloat(v.toFixed(2)).toString();
  }

  function padLinearRange(min: number, max: number, pad = 0.08): [number, number] {
    if (min === max) {
      const d = Math.abs(min) > 0 ? Math.abs(min) * 0.5 : 1;
      return [min - d, max + d];
    }
    const d = (max - min) * pad;
    return [min - d, max + d];
  }

  function interpolateAt(xs: number[], ys: number[], x: number): number {
    if (xs.length === 0 || ys.length === 0) return NaN;
    if (x <= xs[0]) return ys[0];
    const last = Math.min(xs.length, ys.length) - 1;
    if (x >= xs[last]) return ys[last];
    for (let i = 0; i < last; i++) {
      const x1 = xs[i];
      const x2 = xs[i + 1];
      if (x >= x1 && x <= x2) {
        const t = (x - x1) / (x2 - x1 || 1);
        return ys[i] + (ys[i + 1] - ys[i]) * t;
      }
    }
    return NaN;
  }

  function fmtHover(v: number, unit = ''): string {
    if (!Number.isFinite(v)) return '';
    const a = Math.abs(v);
    const s = a > 0 && (a < 1e-2 || a >= 1e4) ? v.toExponential(3) : parseFloat(v.toPrecision(5)).toString();
    return unit ? `${s} ${unit}` : s;
  }

  function drawTooltip(ctx: CanvasRenderingContext2D, lines: string[], x: number, y: number, w: number, h: number, ct: ReturnType<typeof chartTheme>) {
    const padX = 8;
    const padY = 6;
    ctx.save();
    ctx.font = '600 10px Inter, system-ui, sans-serif';
    const boxW = Math.max(...lines.map(line => ctx.measureText(line).width)) + padX * 2;
    const boxH = lines.length * 15 + padY * 2;
    let bx = x + 12;
    let by = y - boxH - 10;
    if (bx + boxW > w - 6) bx = x - boxW - 12;
    if (by < 6) by = y + 12;
    if (by + boxH > h - 6) by = h - boxH - 6;
    ctx.fillStyle = ct.bg;
    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.roundRect(bx, by, boxW, boxH, 6);
    ctx.fill();
    ctx.stroke();
    ctx.textAlign = 'left';
    ctx.textBaseline = 'top';
    lines.forEach((line, i) => {
      ctx.fillStyle = i === 0 ? ct.text : ct.textSoft;
      ctx.fillText(line, bx + padX, by + padY + i * 15);
    });
    ctx.restore();
  }

  function drawPlot(
    canvas: HTMLCanvasElement,
    series: PlotSeries[],
    opts: {
      xLabel: string;
      yLabel: string;
      xScale?: 'linear' | 'log';
      yScale?: 'linear' | 'log';
      xRange?: [number, number];
      yRange?: [number, number];
      refs?: PlotRef[];
      marker?: PlotMarker;
      hoverX?: number | null;
      hoverFormatter?: (x: number, values: HoverValue[]) => string[];
    },
  ) {
    const { ct, ctx, w, h } = setupCanvas(canvas);
    const xScale = opts.xScale ?? 'linear';
    const yScale = opts.yScale ?? 'linear';
    const prepared = series.map(s => {
      const x: number[] = [];
      const y: number[] = [];
      for (let i = 0; i < Math.min(s.x.length, s.y.length); i++) {
        const xi = s.x[i];
        const yi = s.y[i];
        if (!Number.isFinite(xi) || !Number.isFinite(yi)) continue;
        if (xScale === 'log' && xi <= 0) continue;
        if (yScale === 'log' && yi <= 0) continue;
        x.push(xi);
        y.push(yi);
      }
      return { ...s, x, y };
    });
    const allX = prepared.flatMap(s => s.x);
    const allY = prepared.flatMap(s => s.y);
    if (allX.length === 0 || allY.length === 0) {
      drawEmptyChart(canvas, 'No finite values');
      return;
    }

    let xMin = opts.xRange?.[0] ?? Math.min(...allX);
    let xMax = opts.xRange?.[1] ?? Math.max(...allX);
    let yMin = opts.yRange?.[0] ?? Math.min(...allY);
    let yMax = opts.yRange?.[1] ?? Math.max(...allY);
    if (xScale === 'linear') [xMin, xMax] = padLinearRange(xMin, xMax, 0.02);
    if (yScale === 'linear') [yMin, yMax] = padLinearRange(yMin, yMax, 0.1);
    if (yScale === 'log') {
      yMin = Math.max(1e-300, yMin / 1.3);
      yMax *= 1.3;
    }

    const m = PLOT_MARGIN;
    const pw = w - m.left - m.right;
    const ph = h - m.top - m.bottom;
    const tx = xScale === 'log'
      ? (v: number) => m.left + pw * (Math.log10(v) - Math.log10(xMin)) / (Math.log10(xMax) - Math.log10(xMin))
      : (v: number) => m.left + pw * (v - xMin) / (xMax - xMin);
    const ty = yScale === 'log'
      ? (v: number) => m.top + ph * (1 - (Math.log10(v) - Math.log10(yMin)) / (Math.log10(yMax) - Math.log10(yMin)))
      : (v: number) => m.top + ph * (1 - (v - yMin) / (yMax - yMin));

    ctx.fillStyle = ct.bg;
    ctx.fillRect(m.left, m.top, pw, ph);

    const xTicks = xScale === 'log' ? logTicks(xMin, xMax) : niceTicks(xMin, xMax, 6);
    const yTicks = yScale === 'log' ? logTicks(yMin, yMax) : niceTicks(yMin, yMax, 5);
    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 1;
    for (const x of xTicks) {
      const px = tx(x);
      ctx.beginPath(); ctx.moveTo(px, m.top); ctx.lineTo(px, m.top + ph); ctx.stroke();
    }
    for (const y of yTicks) {
      const py = ty(y);
      ctx.beginPath(); ctx.moveTo(m.left, py); ctx.lineTo(m.left + pw, py); ctx.stroke();
    }
    if (yScale === 'linear' && yMin < 0 && yMax > 0) {
      const zy = ty(0);
      ctx.strokeStyle = 'rgba(100, 100, 139, 0.45)';
      ctx.beginPath(); ctx.moveTo(m.left, zy); ctx.lineTo(m.left + pw, zy); ctx.stroke();
    }

    for (const ref of opts.refs ?? []) {
      if (ref.x < xMin || ref.x > xMax) continue;
      const px = tx(ref.x);
      ctx.setLineDash([4, 4]);
      ctx.strokeStyle = ref.color + '70';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(px, m.top); ctx.lineTo(px, m.top + ph); ctx.stroke();
      ctx.setLineDash([]);
      ctx.save();
      ctx.translate(px + 4, m.top + 8);
      ctx.rotate(-Math.PI / 2);
      ctx.fillStyle = ref.color;
      ctx.font = '9px Inter, system-ui, sans-serif';
      ctx.textAlign = 'right';
      ctx.textBaseline = 'middle';
      ctx.fillText(ref.label, 0, 0);
      ctx.restore();
    }

    ctx.strokeStyle = ct.text;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(m.left, m.top);
    ctx.lineTo(m.left, m.top + ph);
    ctx.lineTo(m.left + pw, m.top + ph);
    ctx.stroke();

    ctx.fillStyle = ct.textSoft;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (const x of xTicks) ctx.fillText(axisLabel(x), tx(x), m.top + ph + 6);
    ctx.fillStyle = ct.text;
    ctx.font = '12px Inter, system-ui, sans-serif';
    ctx.textBaseline = 'bottom';
    ctx.fillText(opts.xLabel, m.left + pw / 2, h - 7);

    ctx.fillStyle = ct.textSoft;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    for (const y of yTicks) ctx.fillText(axisLabel(y), m.left - 8, ty(y));
    ctx.save();
    ctx.translate(12, m.top + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillStyle = ct.text;
    ctx.font = '12px Inter, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(opts.yLabel, 0, 0);
    ctx.restore();

    ctx.save();
    ctx.beginPath();
    ctx.rect(m.left, m.top, pw, ph);
    ctx.clip();
    for (const s of prepared) {
      ctx.strokeStyle = s.color;
      ctx.lineWidth = s.lineWidth ?? 2.2;
      ctx.beginPath();
      let started = false;
      for (let i = 0; i < s.x.length; i++) {
        const px = tx(s.x[i]);
        const py = ty(s.y[i]);
        if (!started) { ctx.moveTo(px, py); started = true; }
        else ctx.lineTo(px, py);
      }
      ctx.stroke();
    }
    if (opts.marker && Number.isFinite(opts.marker.x) && Number.isFinite(opts.marker.y)) {
      const px = tx(opts.marker.x);
      const py = ty(opts.marker.y);
      ctx.fillStyle = opts.marker.color + '30';
      ctx.beginPath(); ctx.arc(px, py, 11, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = opts.marker.color;
      ctx.strokeStyle = ct.bg;
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(px, py, 4.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    }

    const hoverX = opts.hoverX;
    if (hoverX !== null && hoverX !== undefined && hoverX >= xMin && hoverX <= xMax) {
      const px = tx(hoverX);
      const values: HoverValue[] = [];
      for (const s of prepared) {
        const y = interpolateAt(s.x, s.y, hoverX);
        if (!Number.isFinite(y)) continue;
        values.push({ label: s.label, value: y, color: s.color });
        const py = ty(y);
        if (Number.isFinite(py)) {
          ctx.fillStyle = s.color;
          ctx.strokeStyle = ct.bg;
          ctx.lineWidth = 2;
          ctx.beginPath(); ctx.arc(px, py, 4, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
        }
      }
      if (values.length > 0) {
        ctx.strokeStyle = 'rgba(100, 100, 139, 0.55)';
        ctx.lineWidth = 1;
        ctx.setLineDash([3, 3]);
        ctx.beginPath(); ctx.moveTo(px, m.top); ctx.lineTo(px, m.top + ph); ctx.stroke();
        ctx.setLineDash([]);
        const primaryY = ty(values[0].value);
        const lines = opts.hoverFormatter
          ? opts.hoverFormatter(hoverX, values)
          : [`x ${fmtHover(hoverX)}`, ...values.map(v => `${v.label}: ${fmtHover(v.value)}`)];
        drawTooltip(ctx, lines, px, Number.isFinite(primaryY) ? primaryY : m.top + 12, w, h, ct);
      }
    }
    ctx.restore();

    let lx = m.left + 8;
    const ly = m.top + 10;
    ctx.font = '600 10px Inter, system-ui, sans-serif';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    for (const s of prepared) {
      ctx.fillStyle = s.color;
      ctx.fillRect(lx, ly - 4, 14, 3);
      lx += 18;
      ctx.fillStyle = ct.textSoft;
      ctx.fillText(s.label, lx, ly);
      lx += ctx.measureText(s.label).width + 14;
    }
  }

  function bessi0(x: number): number {
    const ax = Math.abs(x);
    if (ax < 3.75) {
      const y = (x / 3.75) ** 2;
      return 1 + y * (3.5156229 + y * (3.0899424 + y * (1.2067492 + y * (0.2659732 + y * (0.0360768 + y * 0.0045813)))));
    }
    const y = 3.75 / ax;
    return Math.exp(ax) / Math.sqrt(ax) * (0.39894228 + y * (0.01328592 + y * (0.00225319 + y * (-0.00157565 + y * (0.00916281 + y * (-0.02057706 + y * (0.02635537 + y * (-0.01647633 + y * 0.00392377))))))));
  }

  function bessi1(x: number): number {
    const ax = Math.abs(x);
    let ans: number;
    if (ax < 3.75) {
      const y = (x / 3.75) ** 2;
      ans = ax * (0.5 + y * (0.87890594 + y * (0.51498869 + y * (0.15084934 + y * (0.02658733 + y * (0.00301532 + y * 0.00032411))))));
    } else {
      const y = 3.75 / ax;
      ans = Math.exp(ax) / Math.sqrt(ax) * (0.39894228 + y * (-0.03988024 + y * (-0.00362018 + y * (0.00163801 + y * (-0.01031555 + y * (0.02282967 + y * (-0.02895312 + y * (0.01787654 - y * 0.00420059))))))));
    }
    return x < 0 ? -ans : ans;
  }

  function besselk0(x: number): number {
    x = Math.max(x, 1e-12);
    if (x <= 2) {
      const y = (x * x) / 4;
      return -Math.log(x / 2) * bessi0(x) + (-0.57721566 + y * (0.42278420 + y * (0.23069756 + y * (0.03488590 + y * (0.00262698 + y * (0.00010750 + y * 0.00000740))))));
    }
    const y = 2 / x;
    return Math.exp(-x) / Math.sqrt(x) * (1.25331414 + y * (-0.07832358 + y * (0.02189568 + y * (-0.01062446 + y * (0.00587872 + y * (-0.00251540 + y * 0.00053208))))));
  }

  function besselk1(x: number): number {
    x = Math.max(x, 1e-12);
    if (x <= 2) {
      const y = (x * x) / 4;
      return Math.log(x / 2) * bessi1(x) + (1 / x) * (1 + y * (0.15443144 + y * (-0.67278579 + y * (-0.18156897 + y * (-0.01919402 + y * (-0.00110404 + y * -0.00004686))))));
    }
    const y = 2 / x;
    return Math.exp(-x) / Math.sqrt(x) * (1.25331414 + y * (0.23498619 + y * (-0.03655620 + y * (0.01504268 + y * (-0.00780353 + y * (0.00325614 + y * -0.00068245))))));
  }

  function fwhmRatio(u: number, gamma: number): number {
    const u2 = u * u;
    return Math.sqrt(1 + u2) / Math.pow(1 + u2 / (gamma * gamma), 1.5);
  }

  function fwhmFsFromKeR(eV: number, rNm: number): number {
    const beta = vFromKe(eV);
    const gamma = gammaFromKe(eV);
    if (!Number.isFinite(beta) || beta <= 0 || !Number.isFinite(gamma)) return NaN;
    const rM = Math.max(1e-12, rNm * 1e-9);
    if (gamma < Math.sqrt(3)) {
      let lo = 0;
      let hi = 1;
      while (fwhmRatio(hi, gamma) > 0.5 && hi < 1e6) hi *= 2;
      for (let i = 0; i < 64; i++) {
        const mid = 0.5 * (lo + hi);
        if (fwhmRatio(mid, gamma) > 0.5) lo = mid;
        else hi = mid;
      }
      return (2 * hi * rM / (beta * C)) * 1e15;
    }

    const uMax = Math.max(16, gamma * 10);
    const n = 1601;
    const y: number[] = [];
    let ymax = 0;
    for (let i = 0; i < n; i++) {
      const u = -uMax + (2 * uMax * i) / (n - 1);
      const v = fwhmRatio(u, gamma);
      y.push(v);
      if (v > ymax) ymax = v;
    }
    const half = 0.5 * ymax;
    let bestWidth = 0;
    let openStart: number | null = null;
    for (let i = 0; i < n - 1; i++) {
      const u1 = -uMax + (2 * uMax * i) / (n - 1);
      const u2 = -uMax + (2 * uMax * (i + 1)) / (n - 1);
      const y1 = y[i] - half;
      const y2 = y[i + 1] - half;
      if (openStart === null && y1 >= 0) openStart = u1;
      if (y1 * y2 < 0) {
        const uc = u1 + (u2 - u1) * (-y1) / (y2 - y1);
        if (openStart === null) openStart = uc;
        else {
          bestWidth = Math.max(bestWidth, uc - openStart);
          openStart = null;
        }
      }
    }
    return bestWidth > 0 ? (bestWidth * rM / (beta * C)) * 1e15 : NaN;
  }

  function spectralFieldAu(rNm: number, zNm: number, wEv: number, beta: number) {
    if (wEv <= 0 || beta <= 0 || beta >= 1) return { perp: NaN, par: NaN };
    const rAu = Math.max(1e-9, rNm) * NM_AU;
    const zAu = zNm * NM_AU;
    const omega = wEv / AU_EV;
    const gamma = 1 / Math.sqrt(1 - beta * beta);
    const v = beta * C_AU;
    const arg = Math.max(1e-12, (omega * rAu) / (v * gamma));
    const phase = (omega * zAu) / v;
    const pref = (2 * omega) / (v * v * gamma);
    const erRe = -pref * besselk1(arg) * Math.cos(phase);
    const ezRe = -(pref / gamma) * besselk0(arg) * Math.sin(phase);
    return { perp: Math.abs(erRe), par: Math.abs(ezRe) };
  }

  function timeFieldVm(rNm: number, zNm: number, tFs: number, beta: number) {
    const rM = Math.max(1e-12, rNm * 1e-9);
    const zM = zNm * 1e-9;
    const v = beta * C;
    const s = zM - v * tFs * 1e-15;
    const gammaInv2 = 1 - beta * beta;
    const den = Math.pow(rM * rM + gammaInv2 * s * s, 1.5);
    const pref = (-EV / (4 * Math.PI * EPS0)) * gammaInv2;
    return { perp: pref * rM / den, par: pref * s / den };
  }

  function timeRangeFs(settings = fieldSettings(), beta = Number.isFinite(currentEv) ? vFromKe(currentEv) : NaN): [number, number] | null {
    if (!Number.isFinite(beta) || beta <= 0) return null;
    const v = beta * C;
    const centerFs = (settings.zNm * 1e-9 / v) * 1e15;
    const fwhm = Number.isFinite(currentEv) ? fwhmFsFromKeR(currentEv, settings.rNm) : NaN;
    const halfWindow = Math.max(Number.isFinite(fwhm) ? 3 * fwhm : 0, (settings.rNm * 1e-9 / v) * 1e15 * 8, 0.01);
    return [centerFs - halfWindow, centerFs + halfWindow];
  }

  function dataXFromPointer(canvas: HTMLCanvasElement, e: MouseEvent, xRange: [number, number]): number | null {
    const rect = canvas.getBoundingClientRect();
    const px = e.clientX - rect.left;
    const py = e.clientY - rect.top;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    const m = PLOT_MARGIN;
    const pw = w - m.left - m.right;
    const ph = h - m.top - m.bottom;
    if (pw <= 0 || ph <= 0 || px < m.left || px > m.left + pw || py < m.top || py > m.top + ph) return null;
    return xRange[0] + (xRange[1] - xRange[0]) * (px - m.left) / pw;
  }

  function drawChart() {
    const ct = chartTheme();
    const canvas = document.getElementById('electron-chart') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.scale(dpr, dpr);

    const m = CHART.margin;
    const pw = w - m.left - m.right;
    const ph = h - m.top - m.bottom;

    const kToX = (keV: number) => m.left + pw * (Math.log10(keV) - logKMin) / (logKMax - logKMin);
    const lToY = (pm: number)  => m.top  + ph * (1 - (Math.log10(pm) - logLMin) / (logLMax - logLMin));
    const currentLambda = Number.isFinite(currentEv) && currentEv > 0 ? lambdaFromK(currentEv) : NaN;
    lambdaValue.textContent = Number.isFinite(currentLambda) ? `${fmt(currentLambda)} pm` : '\u2014';

    // Background
    ctx.fillStyle = ct.bg;
    ctx.fillRect(m.left, m.top, pw, ph);

    // Grid
    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 1;
    for (let e = -2; e <= 3; e++) {
      const x = kToX(10 ** e);
      ctx.beginPath(); ctx.moveTo(x, m.top); ctx.lineTo(x, m.top + ph); ctx.stroke();
    }
    for (let e = -1; e <= 3; e++) {
      const y = lToY(10 ** e);
      ctx.beginPath(); ctx.moveTo(m.left, y); ctx.lineTo(m.left + pw, y); ctx.stroke();
    }

    // Axes
    ctx.strokeStyle = ct.text;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(m.left, m.top);
    ctx.lineTo(m.left, m.top + ph);
    ctx.lineTo(m.left + pw, m.top + ph);
    ctx.stroke();

    // X labels
    ctx.fillStyle = ct.textSoft;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    const xLabels: Record<number, string> = { '-2': '0.01', '-1': '0.1', '0': '1', '1': '10', '2': '100', '3': '1k' };
    for (let e = -2; e <= 3; e++) ctx.fillText(xLabels[e], kToX(10 ** e), m.top + ph + 6);
    ctx.font = '12px Inter, system-ui, sans-serif';
    ctx.fillStyle = ct.text;
    ctx.textBaseline = 'bottom';
    ctx.fillText('K (keV)', m.left + pw / 2, h - 7);

    // Y labels
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    ctx.fillStyle = ct.textSoft;
    ctx.font = '11px Inter, system-ui, sans-serif';
    const yLabels: Record<number, string> = { '-1': '0.1', '0': '1', '1': '10', '2': '100', '3': '1k' };
    for (let e = -1; e <= 3; e++) ctx.fillText(yLabels[e], m.left - 8, lToY(10 ** e));
    ctx.save();
    ctx.translate(12, m.top + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = ct.text;
    ctx.font = '12px Inter, system-ui, sans-serif';
    ctx.fillText('\u03BBe (pm)', 0, 0);
    ctx.restore();

    // Curve
    ctx.strokeStyle = '#6366F1';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    const N = 600;
    let started = false;
    for (let i = 0; i < N; i++) {
      const logK = logKMin + (logKMax - logKMin) * i / (N - 1);
      const keV = 10 ** logK;
      const lam = lambdaFromK(keV * 1000);
      if (isNaN(lam) || !isFinite(lam) || lam < CHART.lMin || lam > CHART.lMax) continue;
      const x = kToX(keV), y = lToY(lam);
      if (!started) { ctx.moveTo(x, y); started = true; } else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // Reference lines
    for (const ref of CHART.refs) {
      const x = kToX(ref.k);
      const lam = lambdaFromK(ref.k * 1000);
      const y = lToY(lam);

      ctx.setLineDash([4, 4]);
      ctx.strokeStyle = ref.color + '60';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x, m.top); ctx.lineTo(x, m.top + ph); ctx.stroke();
      ctx.setLineDash([]);

      // Dot on curve
      ctx.fillStyle = ref.color + '30';
      ctx.beginPath(); ctx.arc(x, y, 6, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = ref.color;
      ctx.beginPath(); ctx.arc(x, y, 3, 0, Math.PI * 2); ctx.fill();

      // Label (vertical to avoid overlap)
      ctx.save();
      ctx.fillStyle = ref.color;
      ctx.font = '9px Inter, system-ui, sans-serif';
      ctx.translate(x + 4, m.top + 8);
      ctx.rotate(-Math.PI / 2);
      ctx.textAlign = 'right';
      ctx.textBaseline = 'middle';
      ctx.fillText(ref.label, 0, 0);
      ctx.restore();
    }

    // Operating point
    if (isFinite(currentEv) && currentEv > 0) {
      const keV = currentEv / 1000;
      const lam = currentLambda;
      if (keV >= CHART.kMin && keV <= CHART.kMax && lam >= CHART.lMin && lam <= CHART.lMax) {
        const x = kToX(keV), y = lToY(lam);

        const grad = ctx.createRadialGradient(x, y, 0, x, y, 11);
        grad.addColorStop(0, 'rgba(244,63,94,0.25)');
        grad.addColorStop(1, 'rgba(244,63,94,0)');
        ctx.fillStyle = grad;
        ctx.beginPath(); ctx.arc(x, y, 11, 0, Math.PI * 2); ctx.fill();

        ctx.fillStyle = '#F43F5E';
        ctx.strokeStyle = ct.bg;
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(x, y, 4.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      }
    }
  }

  function referenceGuides(): PlotRef[] {
    return CHART.refs.map(ref => ({ x: ref.k, label: ref.label, color: ref.color }));
  }

  function drawFwhmChart() {
    const canvas = document.getElementById('fwhm-chart') as HTMLCanvasElement;
    const settings = fieldSettings();
    const x: number[] = [];
    const y: number[] = [];
    const n = 320;
    for (let i = 0; i < n; i++) {
      const logK = logKMin + (logKMax - logKMin) * i / (n - 1);
      const keV = 10 ** logK;
      const fwhm = fwhmFsFromKeR(keV * 1000, settings.rNm);
      if (Number.isFinite(fwhm) && fwhm > 0) {
        x.push(keV);
        y.push(fwhm);
      }
    }
    const currentKeV = currentEv / 1000;
    const currentFwhm = Number.isFinite(currentEv) ? fwhmFsFromKeR(currentEv, settings.rNm) : NaN;
    fwhmValue.textContent = Number.isFinite(currentFwhm)
      ? `${fmt(currentFwhm)} fs`
      : `R=${fmt(settings.rNm)} nm`;
    drawPlot(canvas, [
      { x, y, color: '#14B8A6', label: 'FWHM', lineWidth: 2.4 },
    ], {
      xLabel: 'K (keV)',
      yLabel: 'FWHM (fs)',
      xScale: 'log',
      yScale: 'log',
      xRange: [CHART.kMin, CHART.kMax],
      refs: referenceGuides(),
      marker: Number.isFinite(currentFwhm) && currentKeV >= CHART.kMin && currentKeV <= CHART.kMax
        ? { x: currentKeV, y: currentFwhm, color: '#F43F5E' }
        : undefined,
    });
  }

  function drawFrequencyFieldChart() {
    const canvas = document.getElementById('freq-field-chart') as HTMLCanvasElement;
    const settings = fieldSettings();
    const beta = Number.isFinite(currentEv) ? vFromKe(currentEv) : NaN;
    freqFieldNote.textContent = `R=${fmt(settings.rNm)} nm, z=${fmt(settings.zNm)} nm`;
    if (!Number.isFinite(beta) || beta <= 0) {
      drawEmptyChart(canvas, 'Set K to draw fields');
      return;
    }
    const x: number[] = [];
    const perp: number[] = [];
    const par: number[] = [];
    for (let i = 0; i < settings.points; i++) {
      const wEv = settings.wMin + (settings.wMax - settings.wMin) * i / Math.max(1, settings.points - 1);
      const f = spectralFieldAu(settings.rNm, settings.zNm, wEv, beta);
      x.push(wEv);
      perp.push(f.perp);
      par.push(f.par);
    }
    drawPlot(canvas, [
      { x, y: perp, color: '#2563EB', label: 'E_perp' },
      { x, y: par, color: '#D97706', label: 'E_parallel' },
    ], {
      xLabel: 'Photon energy \u210F\u03C9 (eV)',
      yLabel: '|E_omega| (a.u.)',
      yScale: 'log',
      xRange: [settings.wMin, settings.wMax],
      hoverX: freqHoverX,
      hoverFormatter: (omegaEv, values) => [
        `\u210F\u03C9 = ${fmtHover(omegaEv, 'eV')}`,
        ...values.map(v => `${v.label}: ${fmtHover(v.value, 'a.u.')}`),
      ],
    });
  }

  function drawTimeFieldChart() {
    const canvas = document.getElementById('time-field-chart') as HTMLCanvasElement;
    const settings = fieldSettings();
    const beta = Number.isFinite(currentEv) ? vFromKe(currentEv) : NaN;
    timeFieldNote.textContent = `R=${fmt(settings.rNm)} nm, z=${fmt(settings.zNm)} nm`;
    if (!Number.isFinite(beta) || beta <= 0) {
      drawEmptyChart(canvas, 'Set K to draw fields');
      return;
    }
    const range = timeRangeFs(settings, beta);
    if (!range) {
      drawEmptyChart(canvas, 'Set K to draw fields');
      return;
    }
    const n = 520;
    const x: number[] = [];
    const perp: number[] = [];
    const par: number[] = [];
    for (let i = 0; i < n; i++) {
      const tFs = range[0] + (range[1] - range[0]) * i / (n - 1);
      const f = timeFieldVm(settings.rNm, settings.zNm, tFs, beta);
      x.push(tFs);
      perp.push(f.perp);
      par.push(f.par);
    }
    drawPlot(canvas, [
      { x, y: perp, color: '#2563EB', label: 'E_perp' },
      { x, y: par, color: '#D97706', label: 'E_parallel' },
    ], {
      xLabel: 'Time t (fs)',
      yLabel: 'E (V/m)',
      xRange: range,
      hoverX: timeHoverX,
      hoverFormatter: (tFs, values) => [
        `t = ${fmtHover(tFs, 'fs')}`,
        ...values.map(v => `${v.label}: ${fmtHover(v.value, 'V/m')}`),
      ],
    });
  }

  function drawAllCharts() {
    drawChart();
    drawFwhmChart();
    drawFrequencyFieldChart();
    drawTimeFieldChart();
  }

  // Resize handling
  const resizeObserver = new ResizeObserver(drawAllCharts);
  document.querySelectorAll('.chart-wrap').forEach(el => resizeObserver.observe(el));

  const freqFieldCanvas = document.getElementById('freq-field-chart') as HTMLCanvasElement;
  const timeFieldCanvas = document.getElementById('time-field-chart') as HTMLCanvasElement;

  freqFieldCanvas.addEventListener('mousemove', (e) => {
    const settings = fieldSettings();
    freqHoverX = dataXFromPointer(freqFieldCanvas, e, [settings.wMin, settings.wMax]);
    drawAllCharts();
  });
  freqFieldCanvas.addEventListener('mouseleave', () => {
    freqHoverX = null;
    drawAllCharts();
  });

  timeFieldCanvas.addEventListener('mousemove', (e) => {
    const settings = fieldSettings();
    const beta = Number.isFinite(currentEv) ? vFromKe(currentEv) : NaN;
    const range = timeRangeFs(settings, beta);
    timeHoverX = range ? dataXFromPointer(timeFieldCanvas, e, range) : null;
    drawAllCharts();
  });
  timeFieldCanvas.addEventListener('mouseleave', () => {
    timeHoverX = null;
    drawAllCharts();
  });

  onThemeChange(drawAllCharts);

  // Initial state
  updateFrom((parseFloat(inputs.kev.value || inputs.kev.placeholder || '100') || 100) * 1000, 'init');

  // Cross-module velocity sync: let the Smith–Purcell module push v/c back into Fields on switch.
  (window as any).__electronFieldsSetBeta = (beta: number) => {
    if (!(beta > 0 && beta < 1)) return;
    inputs.vc.value = fmt(beta);
    updateFrom(keFromV(beta), 'vc');
  };
</script>

<!-- ===================== Smith–Purcell module ===================== -->
<script>
  import {
    gspCondition, gspAngleDeg, dipoleDistribution, farFieldVector, sphericalComponents,
    stokes, ellipseTrace, dipoleOrientation, externalFieldOnArray, xPolarized, zPolarized, oriented, c,
    wavelengthNmFromEV, eVFromWavelengthNm, omegaFromEV, HBAR_EVS, C_NM_S, cabs, type Vec3c, type Cpx,
  } from '../../lib/smith-purcell';
  import { computePlasmonSpectrum, SHAPE_OPTIONS, drudeEpsilon, epsilonFromMaterial } from '../../lib/plasmonic-nanoparticles';
  import { geometrySpectrumMulti, grapheneSigma2d, grapheneSigma2dRPA, metalSigma2d } from '../../lib/nl-graphene';
  import { downloadBlob } from '../../lib/download';

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const PI = Math.PI, MEC2_KEV = 510.998950;
  const cvar = (n: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim() || '#888';

  const sp = { vc: 0.5, a: 200, b: 50, N: 51, E: 2.0, xi: 0, orient: 'electron', phi: 30,
               thMin: -45, thMax: 225, specUnit: 'nm', specMin: 400, specMax: 800,
               wlUnit: 'nm', stokesSel: 's3', view: 'spectrum', sub: 'spectral', matLog: false,
               plasWx: 1, plasWy: 0, plasWz: 0 };   // Plasmonic-NP response-direction weights: p = α·(px,py,pz)

  // coordinate transform + data of the last-drawn spectral map, for the cursor read-out (null when not shown)
  type SpMapState = { ml: number; mr: number; mt: number; mb: number; w: number; h: number; thMin: number; thMax: number; y0: number; y1: number; isEv: boolean; NX: number; NU: number; M: Float64Array; S0: Float64Array; mx: number; which: string };
  let spMapState: SpMapState | null = null;

  const betaToK = (beta: number) => { const g = 1 / Math.sqrt(1 - beta * beta); return (g - 1) * MEC2_KEV; };
  const kToBeta = (K: number) => { const g = 1 + K / MEC2_KEV; return Math.sqrt(Math.max(0, 1 - 1 / (g * g))); };
  const aOverLambda = () => sp.a / wavelengthNmFromEV(sp.E);
  const NCOL = ['#7c3aed', '#2563eb', '#0d9488', '#f59e0b', '#dc2626'];   // n = −2..+2

  const dnum = (id: string) => parseFloat(($(id) as HTMLInputElement).value) || 0;
  const dipoleMag = () => Math.sqrt(['px', 'py', 'pz'].reduce((a, k) => a + dnum('sp-' + k + '-re') ** 2 + dnum('sp-' + k + '-im') ** 2, 0));

  // ── imported polarizability α(ω): induced dipole direction p = α·E_ext (Methods Eq. 1; E_ext from Eq. 9) ──
  const cmul = (a: Cpx, b: Cpx): Cpx => ({ re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re });
  type AlphaData = { eV: number[]; ax: Cpx[]; ay: Cpx[]; az: Cpx[]; label: string; permalink?: string };
  let spAlpha: AlphaData | null = null;
  let spAlphaSource: 'input' | 'plasmonic' | null = null;        // where the loaded α came from
  const isAlphaSource = () => sp.orient === 'input' || sp.orient === 'plasmonic';
  function alphaAt(omega: number): { x: Cpx; z: Cpx } {
    const E = omega * HBAR_EVS, eV = spAlpha!.eV, n = eV.length;       // ħω in eV
    let i = 0;
    if (E <= eV[0]) i = 0; else if (E >= eV[n - 1]) i = n - 2; else { while (i < n - 2 && eV[i + 1] < E) i++; }
    const t = Math.max(0, Math.min(1, (E - eV[i]) / (eV[i + 1] - eV[i] || 1)));
    const lerp = (arr: Cpx[]) => c(arr[i].re + (arr[i + 1].re - arr[i].re) * t, arr[i].im + (arr[i + 1].im - arr[i].im) * t);
    return { x: lerp(spAlpha!.ax), z: lerp(spAlpha!.az) };             // E_ext has no y-component → α_y inert
  }
  // un-normalized: |p| carries |α(ω)·E_ext(ω)| so the spectral map is weighted by |α(ω)|² (README §α)
  const cw = (z: Cpx, w: number): Cpx => ({ re: z.re * w, im: z.im * w });   // complex × real weight
  function inputDir(omega: number): Vec3c {
    const gamma = 1 / Math.sqrt(1 - sp.vc * sp.vc);
    if (!spAlpha) return dipoleOrientation(omega, sp.b, sp.vc * C_NM_S, gamma, true);   // graceful fallback
    const a = alphaAt(omega);
    // Plasmonic NPs: scalar α(ω) sets the spectral response; the induced dipole points along the chosen weights.
    if (spAlphaSource === 'plasmonic') return [cw(a.x, sp.plasWx), cw(a.x, sp.plasWy), cw(a.x, sp.plasWz)];
    // Input polarizability: tensor α·E_ext (electron near-field has no y-component)
    const { Ex, Ez } = externalFieldOnArray(omega, sp.b, sp.vc * C_NM_S, gamma);
    return [cmul(a.x, Ex), c(0), cmul(a.z, Ez)];
  }

  function buildDipoles(): Vec3c[] {
    const mag = dipoleDistribution(sp.N, sp.xi, 1.0);
    if (sp.orient === 'x') return xPolarized(mag);
    if (sp.orient === 'z') return zPolarized(mag);
    if (isAlphaSource()) return oriented(mag, inputDir(omegaFromEV(sp.E)));
    if (sp.orient === 'custom') {
      let dir: Vec3c = [c(dnum('sp-px-re'), dnum('sp-px-im')), c(dnum('sp-py-re'), dnum('sp-py-im')), c(dnum('sp-pz-re'), dnum('sp-pz-im'))];
      const m = dipoleMag(); if (m > 1e-12) dir = dir.map(z => ({ re: z.re / m, im: z.im / m })) as Vec3c;   // unit orientation
      return oriented(mag, dir);
    }
    const gamma = 1 / Math.sqrt(1 - sp.vc * sp.vc);
    return oriented(mag, dipoleOrientation(omegaFromEV(sp.E), sp.b, sp.vc * C_NM_S, gamma, true));
  }

  // ── canvas helper (DPI-aware) ──
  function ctx2d(canvas: HTMLCanvasElement) {
    const r = canvas.getBoundingClientRect();
    if (r.width < 4 || r.height < 4) return null;
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);
    const ctx = canvas.getContext('2d')!; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, r.width, r.height);
    return { ctx, w: r.width, h: r.height };
  }
  type Plot = { px: (x: number) => number; py: (y: number) => number; m: { l: number; r: number; t: number; b: number } };
  function axes(ctx: CanvasRenderingContext2D, w: number, h: number, xmin: number, xmax: number, ymin: number, ymax: number,
               xlabel: string, ylabel: string, yticks: number[], xticks: number[]): Plot {
    const m = { l: 50, r: 16, t: 14, b: 38 };
    const px = (x: number) => m.l + (x - xmin) / (xmax - xmin) * (w - m.l - m.r);
    const py = (y: number) => h - m.b - (y - ymin) / (ymax - ymin) * (h - m.t - m.b);
    const muted = cvar('--text-muted'), line = cvar('--bg-muted');
    ctx.font = '11px ' + (cvar('--font') || 'sans-serif'); ctx.fillStyle = muted;
    ctx.strokeStyle = line; ctx.lineWidth = 1; ctx.strokeRect(m.l, m.t, w - m.l - m.r, h - m.t - m.b);
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (const y of yticks) { const Y = py(y); ctx.strokeStyle = 'rgba(140,140,150,0.18)'; ctx.beginPath(); ctx.moveTo(m.l, Y); ctx.lineTo(w - m.r, Y); ctx.stroke(); ctx.fillText(String(y), m.l - 6, Y); }
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    for (const x of xticks) { const X = px(x); ctx.fillText(String(x), X, h - m.b + 6); }
    ctx.fillStyle = cvar('--text-soft');
    ctx.fillText(xlabel, (m.l + w - m.r) / 2, h - 14);
    ctx.save(); ctx.translate(13, (m.t + h - m.b) / 2); ctx.rotate(-PI / 2); ctx.fillText(ylabel, 0, 0); ctx.restore();
    return { px, py, m };
  }
  const clipPlot = (ctx: CanvasRenderingContext2D, w: number, h: number, p: Plot) => { ctx.save(); ctx.beginPath(); ctx.rect(p.m.l, p.m.t, w - p.m.l - p.m.r, h - p.m.t - p.m.b); ctx.clip(); };

  // ── colormaps for the spectral density maps (fig3_polarization) ──
  const HEX = (s: string) => [parseInt(s.slice(1, 3), 16), parseInt(s.slice(3, 5), 16), parseInt(s.slice(5, 7), 16)];
  const INT_STOPS = ['#21318a', '#5c8fcf', '#f3f6fb', '#f4a93b', '#b8312a'].map(HEX);
  const cmapInt = (t: number) => { t = Math.max(0, Math.min(1, t)); const x = t * 4, i = Math.min(3, Math.floor(x)), f = x - i, a = INT_STOPS[i], b = INT_STOPS[i + 1]; return [a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f]; };
  const cmapDiv = (v: number) => { const t = (Math.max(-1, Math.min(1, v)) + 1) / 2, lo = t < 0.5, f = lo ? t * 2 : (t - 0.5) * 2, A = lo ? [33, 49, 138] : [243, 246, 251], B = lo ? [243, 246, 251] : [184, 49, 42]; return [A[0] + (B[0] - A[0]) * f, A[1] + (B[1] - A[1]) * f, A[2] + (B[2] - A[2]) * f]; };

  // dipole vectors at angular frequency ω (electron / imported-α orientations are wavelength-dependent; x/z/custom are fixed)
  function dipolesAtOmega(omega: number, mag: number[]): Vec3c[] {
    if (sp.orient === 'x') return xPolarized(mag);
    if (sp.orient === 'z') return zPolarized(mag);
    if (isAlphaSource()) return oriented(mag, inputDir(omega));
    if (sp.orient === 'custom') {
      let dir: Vec3c = [c(dnum('sp-px-re'), dnum('sp-px-im')), c(dnum('sp-py-re'), dnum('sp-py-im')), c(dnum('sp-pz-re'), dnum('sp-pz-im'))];
      const m = dipoleMag(); if (m > 1e-12) dir = dir.map(z => ({ re: z.re / m, im: z.im / m })) as Vec3c;
      return oriented(mag, dir);
    }
    const gamma = 1 / Math.sqrt(1 - sp.vc * sp.vc);
    return oriented(mag, dipoleOrientation(omega, sp.b, sp.vc * C_NM_S, gamma, true));
  }

  // Spectral-dependence map (fig3): total far-field |f|² ('amplitude') or circular degree S₃/S₀ ('s3')
  // over (emission angle θ, wavelength|energy) using the user ranges, with the GSP dispersion overlaid.
  function drawSpectralMap(which: 'amplitude' | 's1' | 's2' | 's3') {
    const cc = ctx2d($('sp-chart') as HTMLCanvasElement); if (!cc) return;
    const { ctx, w, h } = cc, m = { l: 56, r: 66, t: 14, b: 38 };
    const thMin = sp.thMin, thMax = sp.thMax, NX = 150, NU = 78;
    // respect the entered order (first field → bottom, second → top) so swapping reverses the axis
    const y0 = sp.specMin, y1 = sp.specMax, ylo = Math.min(y0, y1), yhi = Math.max(y0, y1), isEv = sp.specUnit === 'eV';
    const toE = (v: number) => isEv ? v : eVFromWavelengthNm(v);
    const phi = sp.phi * PI / 180, mag = dipoleDistribution(sp.N, sp.xi, 1.0);
    const M = new Float64Array(NX * NU), S0 = new Float64Array(NX * NU); let mx = 1e-30;
    for (let iu = 0; iu < NU; iu++) {
      const E = toE(y0 + (y1 - y0) * iu / (NU - 1)), aol = sp.a / wavelengthNmFromEV(E);
      const dip = dipolesAtOmega(omegaFromEV(E), mag);
      for (let ix = 0; ix < NX; ix++) {
        const t = (thMin + (thMax - thMin) * ix / (NX - 1)) * PI / 180;
        const { fTheta, fPhi } = sphericalComponents(t, phi, farFieldVector(t, phi, dip, aol, sp.vc));
        const [s0, s1, s2, s3] = stokes(fTheta, fPhi);
        const sv = which === 's1' ? s1 : which === 's2' ? s2 : s3;
        S0[iu * NX + ix] = s0; if (s0 > mx) mx = s0;
        M[iu * NX + ix] = which === 'amplitude' ? s0 : (s0 > 1e-12 ? sv / s0 : NaN);
      }
    }
    const off = document.createElement('canvas'); off.width = NX; off.height = NU; const octx = off.getContext('2d')!;
    const img = octx.createImageData(NX, NU);
    for (let iu = 0; iu < NU; iu++) for (let ix = 0; ix < NX; ix++) {
      const idx = iu * NX + ix, pi = ((NU - 1 - iu) * NX + ix) * 4; let rgb: number[], al = 255;
      if (which === 'amplitude') rgb = cmapInt(M[idx] / mx);
      else if (!(S0[idx] / mx > 0.02) || Number.isNaN(M[idx])) { rgb = [255, 255, 255]; al = 0; } else rgb = cmapDiv(M[idx]);
      img.data[pi] = rgb[0]; img.data[pi + 1] = rgb[1]; img.data[pi + 2] = rgb[2]; img.data[pi + 3] = al;
    }
    octx.putImageData(img, 0, 0);
    const px = (x: number) => m.l + (x - thMin) / (thMax - thMin) * (w - m.l - m.r);
    const py = (y: number) => h - m.b - (y - y0) / (y1 - y0) * (h - m.t - m.b);
    ctx.imageSmoothingEnabled = true; ctx.drawImage(off, m.l, m.t, w - m.l - m.r, h - m.t - m.b);
    ctx.strokeStyle = cvar('--bg-muted'); ctx.lineWidth = 1; ctx.strokeRect(m.l, m.t, w - m.l - m.r, h - m.t - m.b);
    ctx.font = '11px ' + (cvar('--font') || 'sans-serif'); ctx.fillStyle = cvar('--text-muted');
    const fmtY = (v: number) => isEv ? v.toFixed(2) : String(Math.round(v));
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle'; for (const y of [y0, (y0 + y1) / 2, y1]) ctx.fillText(fmtY(y), m.l - 6, py(y));
    const xt = [...new Set([Math.round(thMin), ...[-90, -45, 0, 45, 90, 135, 180, 225].filter(x => x > thMin + 8 && x < thMax - 8), Math.round(thMax)])];
    ctx.textAlign = 'center'; ctx.textBaseline = 'top'; for (const x of xt) ctx.fillText(x + '°', px(x), h - m.b + 6);
    ctx.fillStyle = cvar('--text-soft'); ctx.fillText('emission angle θ', (m.l + w - m.r) / 2, h - 14);
    ctx.save(); ctx.translate(13, (m.t + h - m.b) / 2); ctx.rotate(-PI / 2); ctx.fillText(isEv ? 'E (eV)' : 'λ (nm)', 0, 0); ctx.restore();
    // analytical SP/GSP dispersion overlay (solid): sin θ_{n,ℓ} = 1/β − (n − ℓ/N) λ/a
    ctx.save(); ctx.beginPath(); ctx.rect(m.l, m.t, w - m.l - m.r, h - m.t - m.b); ctx.clip();
    const curves: { n: number; ell: number; label: string; main: boolean }[] = [];
    for (const n of [1, 2, 3, 4]) curves.push({ n, ell: 0, label: 'n=' + n, main: n === 1 });   // ordinary SP orders
    if (sp.xi > 0) { curves.push({ n: 1, ell: sp.xi, label: 'ℓ=' + sp.xi, main: false }); curves.push({ n: 1, ell: -sp.xi, label: 'ℓ=−' + sp.xi, main: false }); }   // steered GSP channels
    const analytic = which === 'amplitude' ? 'rgba(56,232,225,0.95)' : 'rgba(12,105,120,0.95)';
    ctx.font = '10px ' + (cvar('--font') || 'sans-serif'); ctx.textBaseline = 'middle';
    for (const { n, ell, label, main } of curves) {
      ctx.strokeStyle = analytic; ctx.lineWidth = main ? 2 : (ell === 0 ? 1.5 : 1.2); ctx.setLineDash([]); ctx.beginPath();
      let started = false, lx = 0, ly = 0, drew = false;
      for (let ix = 0; ix <= 300; ix++) {
        const td = thMin + (thMax - thMin) * ix / 300, s = Math.sin(td * PI / 180) * Math.cos(phi);
        const lamNm = sp.a * (1 / sp.vc - s) / (n - ell / sp.N);
        if (lamNm <= 0) { started = false; continue; }
        const yval = isEv ? eVFromWavelengthNm(lamNm) : lamNm;
        if (yval < ylo || yval > yhi) { started = false; continue; }
        const X = px(td), Y = py(yval); started ? ctx.lineTo(X, Y) : (ctx.moveTo(X, Y), started = true);
        lx = X; ly = Y; drew = true;
      }
      ctx.stroke();
      if (drew) { ctx.fillStyle = analytic; ctx.textAlign = lx > w - m.r - 22 ? 'right' : 'left'; ctx.fillText(label, lx > w - m.r - 22 ? lx - 3 : lx + 3, Math.max(m.t + 7, Math.min(h - m.b - 7, ly))); }
    }
    ctx.restore();
    // stash map state for the hover read-out
    spMapState = { ml: m.l, mr: m.r, mt: m.t, mb: m.b, w, h, thMin, thMax, y0, y1, isEv, NX, NU, M, S0, mx, which };
    // colorbar
    const cbx = w - m.r + 20, cbh = h - m.t - m.b; const NB = 48;
    for (let i = 0; i < NB; i++) { const t = i / (NB - 1), rgb = which === 'amplitude' ? cmapInt(t) : cmapDiv(t * 2 - 1); ctx.fillStyle = `rgb(${rgb[0] | 0},${rgb[1] | 0},${rgb[2] | 0})`; ctx.fillRect(cbx, m.t + cbh - (i + 1) / NB * cbh, 11, cbh / NB + 1); }
    ctx.strokeStyle = cvar('--bg-muted'); ctx.strokeRect(cbx, m.t, 11, cbh);
    ctx.fillStyle = cvar('--text-muted'); ctx.font = '9px ' + (cvar('--font') || 'sans-serif'); ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    if (which === 'amplitude') { ctx.fillText('1', cbx + 14, m.t); ctx.fillText('0', cbx + 14, m.t + cbh); }
    else { ctx.fillText('+1', cbx + 14, m.t); ctx.fillText('0', cbx + 14, m.t + cbh / 2); ctx.fillText('−1', cbx + 14, m.t + cbh); }
    const STK = { s1: ['S₁/S₀ (p vs s linear)', 'red = p (θ̂), blue = s (φ̂)'], s2: ['S₂/S₀ (±45° linear)', 'red = +45°, blue = −45°'], s3: ['S₃/S₀ (circular)', 'red = right-handed, blue = left-handed'] } as const;
    $('sp-readout').innerHTML = which === 'amplitude'
      ? `<span>total far-field |f|² vs (θ, ${isEv ? 'E' : 'λ'}) at φ = <b>${sp.phi}°</b></span><span>ξ = <b>${sp.xi}</b>, N = <b>${sp.N}</b></span>`
      : `<span>${STK[which][0]} at φ = <b>${sp.phi}°</b>${sp.phi === 0 ? ' (in-plane → pure p-pol)' : ''}</span><span>${STK[which][1]}</span>`;
  }

  // ── SP-solution diagram (Fig. 1c / 2a): sin θ_{n,ℓ} vs ℓ ──
  function drawEmission() {
    const c = ctx2d($('sp-chart') as HTMLCanvasElement); if (!c) return;
    const { ctx, w, h } = c, N = sp.N, beta = sp.vc, aol = aOverLambda();
    const ymin = -1.6, ymax = 1.6, xmin = -0.5, xmax = N - 0.5;
    const xticks = N <= 21 ? Array.from({ length: N }, (_, i) => i) : [0, Math.round(N / 4), Math.round(N / 2), Math.round(3 * N / 4), N - 1];
    const p = axes(ctx, w, h, xmin, xmax, ymin, ymax, 'Fourier mode index ℓ', 'sin θₙ,ₗ', [-1.5, -1, -0.5, 0, 0.5, 1, 1.5], xticks);
    // forbidden |sin|>1 bands
    ctx.fillStyle = 'rgba(130,130,140,0.13)';
    ctx.fillRect(p.px(xmin), p.py(ymax), p.px(xmax) - p.px(xmin), p.py(1) - p.py(ymax));
    ctx.fillRect(p.px(xmin), p.py(-1), p.px(xmax) - p.px(xmin), p.py(ymin) - p.py(-1));
    ctx.strokeStyle = 'rgba(130,130,140,0.55)'; ctx.lineWidth = 0.8;
    ctx.beginPath(); ctx.moveTo(p.px(xmin), p.py(1)); ctx.lineTo(p.px(xmax), p.py(1)); ctx.moveTo(p.px(xmin), p.py(-1)); ctx.lineTo(p.px(xmax), p.py(-1)); ctx.stroke();
    clipPlot(ctx, w, h, p);
    for (let n = -2; n <= 2; n++) {
      ctx.strokeStyle = NCOL[n + 2]; ctx.lineWidth = 1.4; ctx.beginPath();
      for (let ell = 0; ell < N; ell++) { const s = gspCondition(n, ell, N, beta, aol); const X = p.px(ell), Y = p.py(s); ell ? ctx.lineTo(X, Y) : ctx.moveTo(X, Y); }
      ctx.stroke();
      const dotR = Math.max(1.1, Math.min(2.8, (w - p.m.l - p.m.r) / N * 0.42));   // shrink dots for large N so they don't merge
      for (let ell = 0; ell < N; ell++) { const s = gspCondition(n, ell, N, beta, aol); if (Math.abs(s) <= 1) { ctx.fillStyle = NCOL[n + 2]; ctx.beginPath(); ctx.arc(p.px(ell), p.py(s), dotR, 0, 2 * PI); ctx.fill(); } }
    }
    // highlight steered channel (n=1, ℓ=ξ)
    const sXi = gspCondition(1, sp.xi, N, beta, aol);
    if (sp.xi > 0 && Math.abs(sXi) <= 1) { ctx.strokeStyle = cvar('--text'); ctx.lineWidth = 1.6; ctx.beginPath(); ctx.arc(p.px(sp.xi), p.py(sXi), 5.5, 0, 2 * PI); ctx.stroke(); }
    ctx.restore();
    // legend
    ctx.font = '10px ' + (cvar('--font') || 'sans-serif'); ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    ['n=−2', 'n=−1', 'n=0', 'n=1', 'n=2'].forEach((t, i) => { const X = p.m.l + 8 + i * 52, Y = p.m.t + 10; ctx.fillStyle = NCOL[i]; ctx.fillRect(X, Y - 4, 9, 8); ctx.fillStyle = cvar('--text-soft'); ctx.fillText(t, X + 12, Y); });
    const th = gspAngleDeg(1, sp.xi, N, beta, aol);
    $('sp-readout').innerHTML = `<span>steered channel (n=1, ℓ=ξ): <b>${Number.isFinite(th) ? th.toFixed(1) + '°' : 'forbidden'}</b></span><span>radiative modes ℓ for n=1: <b>${countRadiative(1)}</b></span>`;
  }
  const countRadiative = (n: number) => { let c = 0; for (let ell = 0; ell < sp.N; ell++) if (Math.abs(gspCondition(n, ell, sp.N, sp.vc, aOverLambda())) <= 1) c++; return c; };


  // ── Far-field rosette: semicircle polar plot at azimuth φ, weighted by a Stokes component ──
  function drawRosette(which: string) {
    const c = ctx2d($('sp-chart') as HTMLCanvasElement); if (!c) return;
    const { ctx, w, h } = c, vec = buildDipoles(), aol = aOverLambda(), beta = sp.vc, phi = sp.phi * PI / 180;
    const cbReserve = 48;
    const cx = (w - cbReserve) / 2, cy = h - 26, R = Math.min((w - cbReserve) / 2 - 24, h - 50);
    const M = 721, S0: number[] = [], val: number[] = [], ths: number[] = [];
    let s0max = 1e-30;
    for (let i = 0; i < M; i++) {
      const t = (-90 + 180 * i / (M - 1)) * PI / 180;
      const f = farFieldVector(t, phi, vec, aol, beta);
      const { fTheta, fPhi } = sphericalComponents(t, phi, f);
      const [s0, s1, s2, s3] = stokes(fTheta, fPhi);
      ths.push(t); S0.push(s0); s0max = Math.max(s0max, s0);
      val.push(which === 's0' ? 1 : (which === 's1' ? s1 : which === 's2' ? s2 : s3) / (s0 || 1));
    }
    // grid: semicircle + angle spokes
    ctx.strokeStyle = cvar('--bg-muted'); ctx.lineWidth = 1; ctx.fillStyle = cvar('--text-muted'); ctx.font = '10px ' + (cvar('--font') || 'sans-serif');
    for (const rr of [0.25, 0.5, 0.75, 1]) { ctx.beginPath(); ctx.arc(cx, cy, R * rr, PI, 2 * PI); ctx.stroke(); }
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    for (const adeg of [-90, -60, -30, 0, 30, 60, 90]) { const a = adeg * PI / 180, dx = Math.sin(a), dy = -Math.cos(a); ctx.strokeStyle = 'rgba(140,140,150,0.25)'; ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + dx * R, cy + dy * R); ctx.stroke(); ctx.fillStyle = cvar('--text-muted'); ctx.fillText(adeg + '°', cx + dx * (R + 13), cy + dy * (R + 13)); }
    // emission lobes: radius ∝ amplitude √(S0); colour by chosen Stokes (diverging) or single hue
    const diverge = (v: number) => { const t = Math.max(-1, Math.min(1, v)); return t >= 0 ? `rgba(220,38,38,${0.25 + 0.7 * t})` : `rgba(37,99,235,${0.25 - 0.7 * t})`; };
    ctx.lineWidth = 2;
    for (let i = 1; i < M; i++) {
      const r0 = Math.sqrt(S0[i - 1] / s0max), r1 = Math.sqrt(S0[i] / s0max);
      const a0 = ths[i - 1], a1 = ths[i];
      ctx.strokeStyle = which === 's0' ? cvar('--primary') : diverge((val[i - 1] + val[i]) / 2);
      ctx.beginPath();
      ctx.moveTo(cx + Math.sin(a0) * R * r0, cy - Math.cos(a0) * R * r0);
      ctx.lineTo(cx + Math.sin(a1) * R * r1, cy - Math.cos(a1) * R * r1);
      ctx.stroke();
    }
    // colorbar (right): diverging −1..+1 for the Stokes views, single-hue |f| 0..1 for intensity
    const cbW = 11, cbTop = cy - R, cbH = R, cbx = w - 34, NB = 44;
    for (let i = 0; i < NB; i++) {
      const tt = i / (NB - 1);
      if (which === 's0') { ctx.globalAlpha = 0.15 + 0.85 * tt; ctx.fillStyle = cvar('--primary'); }
      else { ctx.globalAlpha = 1; ctx.fillStyle = diverge(tt * 2 - 1); }
      ctx.fillRect(cbx, cbTop + cbH - (i + 1) / NB * cbH, cbW, cbH / NB + 1);
    }
    ctx.globalAlpha = 1; ctx.strokeStyle = cvar('--bg-muted'); ctx.lineWidth = 1; ctx.strokeRect(cbx, cbTop, cbW, cbH);
    ctx.fillStyle = cvar('--text-muted'); ctx.font = '9px ' + (cvar('--font') || 'sans-serif'); ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    const cbTitle = which === 's0' ? '|f|' : which === 's1' ? 'S₁/S₀' : which === 's2' ? 'S₂/S₀' : 'S₃/S₀';
    if (which === 's0') { ctx.fillText('1', cbx + cbW + 3, cbTop); ctx.fillText('0', cbx + cbW + 3, cbTop + cbH); }
    else { ctx.fillText('+1', cbx + cbW + 3, cbTop); ctx.fillText('0', cbx + cbW + 3, cbTop + cbH / 2); ctx.fillText('−1', cbx + cbW + 3, cbTop + cbH); }
    ctx.textAlign = 'center'; ctx.textBaseline = 'bottom'; ctx.fillText(cbTitle, cbx + cbW / 2, cbTop - 4);
    const peak = ths[S0.indexOf(Math.max(...S0))] * 180 / PI;
    $('sp-readout').innerHTML = `<span>peak emission at θ = <b>${peak.toFixed(1)}°</b></span><span>φ = <b>${sp.phi}°</b> · dipole: <b>${sp.orient}</b></span>`;
  }

  // ── Polarization rosette (README "Rosette plots"): full-hemisphere polar maps of the four
  //    Stokes parameters (θ radial from normal, φ azimuth, φ=0 = beam/plane of incidence = East),
  //    plus polarization-ellipse glyphs on the S₀ panel coloured by handedness. ──
  function drawRosetteHemisphere() {
    const c = ctx2d($('sp-chart') as HTMLCanvasElement); if (!c) return;
    const { ctx, w, h } = c, vec = buildDipoles(), aol = aOverLambda(), beta = sp.vc;
    // hemisphere grid: φ ∈ [0,360], θ ∈ [1,89] (θ=0 removed — φ ill-defined at the pole)
    const NPH = 168, NTH = 60, NG = NPH * NTH;
    const S0g = new Float64Array(NG), S1g = new Float64Array(NG), S2g = new Float64Array(NG), S3g = new Float64Array(NG);
    let s0max = 1e-30;
    for (let ip = 0; ip < NPH; ip++) {
      const phi = 2 * PI * ip / (NPH - 1);
      for (let it = 0; it < NTH; it++) {
        const th = (1 + 88 * it / (NTH - 1)) * PI / 180;
        const { fTheta, fPhi } = sphericalComponents(th, phi, farFieldVector(th, phi, vec, aol, beta));
        const [s0, s1, s2, s3] = stokes(fTheta, fPhi);
        const k = ip * NTH + it; S0g[k] = s0; S1g[k] = s1; S2g[k] = s2; S3g[k] = s3;
        if (s0 > s0max) s0max = s0;
      }
    }
    const sample = (arr: Float64Array, thDeg: number, phiRad: number) => {
      let ph = phiRad % (2 * PI); if (ph < 0) ph += 2 * PI;
      const ip = Math.min(NPH - 1, Math.max(0, Math.round(ph / (2 * PI) * (NPH - 1))));
      const it = Math.min(NTH - 1, Math.max(0, Math.round((thDeg - 1) / 88 * (NTH - 1))));
      return arr[ip * NTH + it];
    };
    // 2×2 layout, one polar disk per panel, colour-bar strip along the bottom
    const pad = 6, gap = 16, legendH = 30, titleH = 15;
    const cellW = (w - 2 * pad - gap) / 2, cellH = (h - 2 * pad - gap - legendH) / 2;
    const PANELS: { key: 'S0' | 'S1' | 'S2' | 'S3'; arr: Float64Array; title: string; div: boolean }[] = [
      { key: 'S0', arr: S0g, title: 'S₀  √intensity + ellipses', div: false },
      { key: 'S1', arr: S1g, title: 'S₁  (p vs s)', div: true },
      { key: 'S2', arr: S2g, title: 'S₂  (±45°)', div: true },
      { key: 'S3', arr: S3g, title: 'S₃  (circular)', div: true },
    ];
    ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
    PANELS.forEach((pan, idx) => {
      const cc = idx % 2, rr = (idx / 2) | 0;
      const cellX = pad + cc * (cellW + gap), cellY = pad + rr * (cellH + gap);
      const Rp = Math.min(cellW, cellH - titleH) / 2 - 6;
      const pcx = cellX + cellW / 2, pcy = cellY + titleH + (cellH - titleH) / 2;
      // panel title
      ctx.font = '10px ' + (cvar('--font') || 'sans-serif'); ctx.fillStyle = cvar('--text-soft');
      ctx.fillText(pan.title, pcx, cellY + 11);
      // rasterize the polar disk into an offscreen buffer, then scale it onto the panel
      const S = Math.max(16, Math.round(2 * Rp)), off = document.createElement('canvas');
      off.width = S; off.height = S; const octx = off.getContext('2d')!, img = octx.createImageData(S, S);
      for (let py = 0; py < S; py++) for (let px = 0; px < S; px++) {
        const dx = px - S / 2 + 0.5, dy = py - S / 2 + 0.5, rrad = Math.hypot(dx, dy) / (S / 2);
        const pi = (py * S + px) * 4;
        if (rrad > 1) { img.data[pi + 3] = 0; continue; }
        let phi = Math.atan2(-dy, dx); if (phi < 0) phi += 2 * PI;   // φ=0 East, CCW
        const thDeg = Math.max(1, rrad * 90), s0 = sample(S0g, thDeg, phi);
        let rgb: number[];
        if (!pan.div) rgb = cmapInt(Math.sqrt(Math.max(0, s0) / s0max));
        // intensity-weighted Stokes: Sᵢ/max(S₀) = (S₀/max)·(Sᵢ/S₀) — component shown only where the array emits
        else rgb = cmapDiv(Math.max(-1, Math.min(1, sample(pan.arr, thDeg, phi) / s0max)));
        img.data[pi] = rgb[0]; img.data[pi + 1] = rgb[1]; img.data[pi + 2] = rgb[2]; img.data[pi + 3] = 255;
      }
      octx.putImageData(img, 0, 0);
      ctx.imageSmoothingEnabled = true; ctx.drawImage(off, pcx - Rp, pcy - Rp, 2 * Rp, 2 * Rp);
      // polar grid: θ rings (30/60/90) + φ spokes (0/90/180/270), φ=0 marked
      ctx.strokeStyle = 'rgba(140,140,150,0.45)'; ctx.lineWidth = 0.8;
      for (const t of [30, 60, 90]) { ctx.beginPath(); ctx.arc(pcx, pcy, Rp * t / 90, 0, 2 * PI); ctx.stroke(); }
      for (const ad of [0, 90, 180, 270]) { const a = ad * PI / 180; ctx.beginPath(); ctx.moveTo(pcx, pcy); ctx.lineTo(pcx + Rp * Math.cos(a), pcy - Rp * Math.sin(a)); ctx.stroke(); }
      ctx.fillStyle = cvar('--text-muted'); ctx.font = '8px ' + (cvar('--font') || 'sans-serif');
      ctx.fillText('φ=0', pcx + Rp + 9, pcy + 3);
      // polarization-ellipse glyphs on the S₀ panel
      if (pan.key === 'S0') {
        for (const th0 of [26, 46, 66, 82]) for (let pd = 0; pd < 360; pd += 30) {
          const phi0 = pd * PI / 180, th0r = th0 * PI / 180;
          const { fTheta, fPhi } = sphericalComponents(th0r, phi0, farFieldVector(th0r, phi0, vec, aol, beta));
          const [s0, , , s3] = stokes(fTheta, fPhi); if (!(s0 / s0max > 0.03)) continue;
          const { u, v } = ellipseTrace(fTheta, fPhi); let mmax = 1e-30;
          for (let i = 0; i < u.length; i++) mmax = Math.max(mmax, Math.hypot(u[i], v[i]));
          const gs = 8, sinth = Math.max(0.25, Math.sin(th0r));
          ctx.strokeStyle = s3 >= 0 ? '#0891b2' : '#c026d3'; ctx.lineWidth = 1; ctx.beginPath();
          for (let i = 0; i < u.length; i++) {
            const thp = th0 + gs * u[i] / mmax, php = phi0 + (gs * v[i] / mmax / sinth) * PI / 180;
            const rad = Rp * Math.max(0, thp) / 90, X = pcx + rad * Math.cos(php), Y = pcy - rad * Math.sin(php);
            i ? ctx.lineTo(X, Y) : ctx.moveTo(X, Y);
          }
          ctx.closePath(); ctx.stroke();
        }
      }
    });
    // bottom legend: diverging bar (S₁₋₃) + sequential note + ellipse handedness swatches
    const ly = h - legendH + 8, barW = 120, bx = pad + 74, NB = 60;
    ctx.textAlign = 'left'; ctx.textBaseline = 'middle'; ctx.font = '9px ' + (cvar('--font') || 'sans-serif');
    ctx.fillStyle = cvar('--text-muted'); ctx.fillText('S₁₋₃ / max S₀', pad, ly + 5);
    for (let i = 0; i < NB; i++) { const rgb = cmapDiv(i / (NB - 1) * 2 - 1); ctx.fillStyle = `rgb(${rgb[0] | 0},${rgb[1] | 0},${rgb[2] | 0})`; ctx.fillRect(bx + i / NB * barW, ly, barW / NB + 1, 9); }
    ctx.strokeStyle = cvar('--bg-muted'); ctx.lineWidth = 1; ctx.strokeRect(bx, ly, barW, 9);
    ctx.fillStyle = cvar('--text-muted'); ctx.textAlign = 'center';
    ctx.fillText('−1', bx, ly + 18); ctx.fillText('0', bx + barW / 2, ly + 18); ctx.fillText('+1', bx + barW, ly + 18);
    // handedness swatches
    let hx = bx + barW + 30; ctx.textAlign = 'left';
    ctx.strokeStyle = '#0891b2'; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(hx, ly + 4); ctx.lineTo(hx + 14, ly + 4); ctx.stroke();
    ctx.fillStyle = cvar('--text-muted'); ctx.fillText('right-handed', hx + 18, ly + 5);
    hx += 100; ctx.strokeStyle = '#c026d3'; ctx.beginPath(); ctx.moveTo(hx, ly + 4); ctx.lineTo(hx + 14, ly + 4); ctx.stroke();
    ctx.fillText('left-handed', hx + 18, ly + 5);
    $('sp-readout').innerHTML = `<span>hemisphere Stokes maps at λ = <b>${wavelengthNmFromEV(sp.E).toFixed(0)} nm</b> · a/λ = <b>${aol.toFixed(3)}</b></span><span>θ radial (centre = normal, edge = 90°), φ = 0 = plane of incidence · dipole: <b>${sp.orient}</b></span>`;
  }

  // ── geometry schematic (oblique projection, port of figures/_geometry.py) ──
  const EX = [-0.82, -0.46], EY = [1.0, -0.10], EZ = [0.0, 1.0];
  function drawGeometry(canvas: HTMLCanvasElement) {
    const cc = ctx2d(canvas); if (!cc) return; const { ctx, w, h } = cc;   // not `c` — that's the complex constructor used below
    const nSide = 3, a = 1.0, bRel = Math.max(0.6, Math.min(2.4, (sp.b / sp.a) * 6 + 0.6));
    const th = 40 * PI / 180, ph = (Number.isFinite(sp.phi) ? sp.phi : 30) * PI / 180;   // φ=0 is valid — don't fall back to 30°
    const proj = (x: number, y: number, z: number) => [x * EX[0] + y * EY[0] + z * EZ[0], x * EX[1] + y * EY[1] + z * EZ[1]];
    // collect for autoscale
    const pts: number[][] = [];
    const xmax = (nSide + 1.4) * a;
    const R = 2.3 * a, r3 = [Math.sin(th) * Math.cos(ph), Math.sin(th) * Math.sin(ph), Math.cos(th)];
    // dipole-oscillation axis: along the (|px|,|py|,|pz|) magnitudes of the active orientation (x/z/electron/α)
    let dvec: Vec3c;
    if (sp.orient === 'x') dvec = [c(1, 0), c(0, 0), c(0, 0)];
    else if (sp.orient === 'z') dvec = [c(0, 0), c(0, 0), c(1, 0)];
    else if (isAlphaSource()) dvec = spAlpha ? inputDir(omegaFromEV(sp.E)) : [c(0, 0), c(0, 0), c(1, 0)];
    else { const g = 1 / Math.sqrt(1 - sp.vc * sp.vc); dvec = dipoleOrientation(omegaFromEV(sp.E), sp.b, sp.vc * C_NM_S, g, true); }
    const dm = [cabs(dvec[0]), cabs(dvec[1]), cabs(dvec[2])], dn = Math.hypot(dm[0], dm[1], dm[2]) || 1;
    const dax = [dm[0] / dn, dm[1] / dn, dm[2] / dn];
    const dl = dax[0] > 0.01 ? Math.min(0.62, 0.42 / dax[0]) : 0.62;   // cap x-extent so neighbouring arrows don't overlap
    const dvx = dl * dax[0], dvy = dl * dax[1], dvz = dl * dax[2];
    [[-xmax * 0.85, 0, bRel], [xmax, 0, 0], [0, 0, 2.5], [0, xmax * 0.62, 0], r3.map(v => v * R) as number[],
     [nSide * a + dvx, dvy, dvz], [nSide * a - dvx, -dvy, -dvz], [-nSide * a + dvx, dvy, dvz], [-nSide * a - dvx, -dvy, -dvz]].forEach(q => pts.push(proj(q[0], q[1], q[2])));
    let minx = 1e9, maxx = -1e9, miny = 1e9, maxy = -1e9;
    for (const q of pts) { minx = Math.min(minx, q[0]); maxx = Math.max(maxx, q[0]); miny = Math.min(miny, q[1]); maxy = Math.max(maxy, q[1]); }
    minx -= 0.4; maxx += 0.5; miny -= 0.5; maxy += 0.4;
    const sc = Math.min((w - 8) / (maxx - minx), (h - 8) / (maxy - miny));
    const ox = (w - sc * (maxx - minx)) / 2, oy = (h - sc * (maxy - miny)) / 2;
    const P = (x: number, y: number, z: number) => { const q = proj(x, y, z); return [ox + (q[0] - minx) * sc, h - (oy + (q[1] - miny) * sc)]; };
    const hs = Math.max(1, w / 280);   // scale arrowheads / strokes / labels up on the enlarged canvas
    const arrow = (x0: number, y0: number, z0: number, x1: number, y1: number, z1: number, col: string, lw: number, head = 6) => {
      const A = P(x0, y0, z0), B = P(x1, y1, z1), hd = head * hs; ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = lw * hs;
      ctx.beginPath(); ctx.moveTo(A[0], A[1]); ctx.lineTo(B[0], B[1]); ctx.stroke();
      const ang = Math.atan2(B[1] - A[1], B[0] - A[0]);   // apex sits ½·head beyond the segment end so the tip clears the line
      const tx = B[0] + hd * 0.5 * Math.cos(ang), ty = B[1] + hd * 0.5 * Math.sin(ang);
      ctx.beginPath(); ctx.moveTo(tx, ty); ctx.lineTo(tx - hd * Math.cos(ang - 0.4), ty - hd * Math.sin(ang - 0.4)); ctx.lineTo(tx - hd * Math.cos(ang + 0.4), ty - hd * Math.sin(ang + 0.4)); ctx.closePath(); ctx.fill();
    };
    // double-headed arrow (heads at both ends) — for the dipole-oscillation indicators
    const dArrow = (x0: number, y0: number, z0: number, x1: number, y1: number, z1: number, col: string, lw: number, head = 6) => {
      const A = P(x0, y0, z0), B = P(x1, y1, z1), hd = head * hs; ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = lw * hs;
      ctx.beginPath(); ctx.moveTo(A[0], A[1]); ctx.lineTo(B[0], B[1]); ctx.stroke();
      const ang = Math.atan2(B[1] - A[1], B[0] - A[0]);
      const headTo = (T: number[], a: number) => { const tx = T[0] + hd * 0.5 * Math.cos(a), ty = T[1] + hd * 0.5 * Math.sin(a); ctx.beginPath(); ctx.moveTo(tx, ty); ctx.lineTo(tx - hd * Math.cos(a - 0.4), ty - hd * Math.sin(a - 0.4)); ctx.lineTo(tx - hd * Math.cos(a + 0.4), ty - hd * Math.sin(a + 0.4)); ctx.closePath(); ctx.fill(); };
      headTo(B, ang); headTo(A, ang + PI);
    };
    const ax = cvar('--text-muted');
    arrow(-xmax * 0.78, 0, 0, xmax, 0, 0, ax, 1.4); arrow(0, 0, 0, 0, xmax * 0.62, 0, ax, 1.4); arrow(0, 0, 0, 0, 0, 2.5, ax, 1.4);
    ctx.font = 'italic ' + Math.round(12 * hs) + 'px ' + (cvar('--font') || 'serif'); ctx.fillStyle = ax; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    let q = P(xmax, 0, 0); ctx.fillText('x', q[0] + 6 * hs, q[1] + 6 * hs); q = P(0, xmax * 0.62, 0); ctx.fillText('y', q[0] + 8 * hs, q[1]); q = P(0, 0, 2.5); ctx.fillText('z', q[0], q[1] - 8 * hs);
    // electron beam — travels toward +x (head at the +x end)
    arrow(-xmax * 0.85, 0, bRel, xmax * 0.95, 0, bRel, '#2b35c8', 2.4, 9);
    q = P(-xmax * 0.8, 0, bRel); ctx.fillStyle = '#2b35c8'; ctx.fillText('e⁻', q[0] + 4 * hs, q[1] - 8 * hs);
    // impact b
    arrow(1.7, 0, 0, 1.7, 0, bRel, ax, 1.2, 5); arrow(1.7, 0, bRel, 1.7, 0, 0, ax, 1.2, 5);
    q = P(1.7, 0, bRel / 2); ctx.fillStyle = ax; ctx.fillText('b', q[0] + 9 * hs, q[1]);
    // array dots + red dipole arrows
    for (let j = -nSide; j <= nSide; j++) {
      dArrow(j * a - dvx, -dvy, -dvz, j * a + dvx, dvy, dvz, '#d11', 2.4, 6.5);   // oscillation along the selected dipole direction
      const cdot = P(j * a, 0, 0); ctx.fillStyle = cvar('--text'); ctx.beginPath(); ctx.arc(cdot[0], cdot[1], 4 * hs, 0, 2 * PI); ctx.fill();
    }
    q = P(2.5, 0, 0); ctx.fillStyle = ax; ctx.fillText('a', q[0], q[1] + 14 * hs);
    // r vector + arcs
    arrow(0, 0, 0, r3[0] * R, r3[1] * R, r3[2] * R, '#0a7d2c', 2.2, 8);
    q = P(r3[0] * R, r3[1] * R, r3[2] * R); ctx.fillStyle = '#0a7d2c'; ctx.font = 'bold italic ' + Math.round(13 * hs) + 'px ' + (cvar('--font') || 'serif'); ctx.fillText('r', q[0] + 7 * hs, q[1] - 6 * hs);
    ctx.strokeStyle = '#0a7d2c'; ctx.lineWidth = 1.2 * hs; const u = [Math.cos(ph), Math.sin(ph), 0];
    ctx.beginPath(); for (let i = 0; i <= 30; i++) { const t = th * i / 30, pp = P(0.85 * (Math.sin(t) * u[0]), 0.85 * (Math.sin(t) * u[1]), 0.85 * Math.cos(t)); i ? ctx.lineTo(pp[0], pp[1]) : ctx.moveTo(pp[0], pp[1]); } ctx.stroke();
    ctx.beginPath(); for (let i = 0; i <= 30; i++) { const s = ph * i / 30, pp = P(Math.cos(s), Math.sin(s), 0); i ? ctx.lineTo(pp[0], pp[1]) : ctx.moveTo(pp[0], pp[1]); } ctx.stroke();
    ctx.font = 'italic ' + Math.round(12 * hs) + 'px ' + (cvar('--font') || 'serif'); ctx.fillStyle = '#0a7d2c';
    let m = P(0.85 * Math.sin(th / 2) * u[0], 0.85 * Math.sin(th / 2) * u[1], 0.85 * Math.cos(th / 2)); ctx.fillText('θ', m[0] + 9 * hs, m[1]);
    m = P(Math.cos(ph / 2), Math.sin(ph / 2), 0); ctx.fillText('φ', m[0], m[1] + 11 * hs);
  }

  // ── steering-mode box: induced-dipole profile |pⱼ|/p₀ = 1 + sin(2πξj/N) (Fig. 2b) ──
  function drawSteer() {
    const c = ctx2d($('sp-steer-chart') as HTMLCanvasElement); if (!c) return;
    const { ctx, w, h } = c, N = sp.N;
    const xticks = N <= 21 ? Array.from({ length: N }, (_, i) => i) : [0, Math.round(N / 4), Math.round(N / 2), Math.round(3 * N / 4), N - 1];
    const mag = dipoleDistribution(N, sp.xi, 1.0);
    const p = axes(ctx, w, h, -0.5, N - 0.5, 0, 2.1, 'array index j', '|pⱼ|/p₀', [0, 1, 2], xticks);
    clipPlot(ctx, w, h, p);
    ctx.strokeStyle = 'rgba(140,140,150,0.45)'; ctx.lineWidth = 0.8; ctx.beginPath(); ctx.moveTo(p.px(-0.5), p.py(1)); ctx.lineTo(p.px(N - 0.5), p.py(1)); ctx.stroke();
    const col = cvar('--primary'); ctx.strokeStyle = col; ctx.lineWidth = 1.8; ctx.beginPath();
    mag.forEach((y, j) => { const X = p.px(j), Y = p.py(y); j ? ctx.lineTo(X, Y) : ctx.moveTo(X, Y); });
    ctx.stroke();
    const dotR = Math.max(1, Math.min(1.9, (w - p.m.l - p.m.r) / N * 0.42));
    ctx.fillStyle = col; mag.forEach((y, j) => { ctx.beginPath(); ctx.arc(p.px(j), p.py(y), dotR, 0, 2 * PI); ctx.fill(); });
    ctx.restore();
  }

  // ── sub-tabs / view dispatch ──
  const SUBTABS: Record<string, { id: string; label: string }[]> = {
    spectrum: [{ id: 'spectral', label: 'Spectral dependence' }, { id: 'polarization', label: 'Polarization' }],
    farfield: [{ id: 'emission', label: 'SP emission' }, { id: 'intensity', label: 'Intensity' }, { id: 'polarization', label: 'Polarization' }, { id: 'rosette', label: 'Rosette' }],
    materials: [{ id: 'alpha', label: 'Polarizability α(ω)' }],
  };
  function renderSubTabs() {
    const box = $('sp-sub-tabs'); box.innerHTML = '';
    for (const t of SUBTABS[sp.view]) {
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'sp-sub-tab' + (sp.sub === t.id ? ' active' : ''); btn.textContent = t.label; btn.dataset.sub = t.id;
      btn.addEventListener('click', () => { sp.sub = t.id; renderSubTabs(); renderSP(); });
      box.appendChild(btn);
    }
  }
  function setViewTabsActive() {
    $('sp-view-tabs').querySelectorAll('.sp-view-tab').forEach(b => { const a = (b as HTMLElement).dataset.view === sp.view; b.classList.toggle('active', a); b.setAttribute('aria-selected', a ? 'true' : 'false'); });
  }
  // Materials view tab only exists while an α-based source (Plasmonic NPs / Input polarizability) is loaded
  function updateMaterialsTabVis() {
    const show = isAlphaSource() && !!spAlpha;
    ($('sp-view-materials') as HTMLElement).hidden = !show;
    if (!show && sp.view === 'materials') { sp.view = 'spectrum'; sp.sub = SUBTABS.spectrum[0].id; setViewTabsActive(); renderSubTabs(); }
  }
  function niceTicks(lo: number, hi: number, n = 5): number[] {
    const span = (hi - lo) || 1, raw = span / n, mag = Math.pow(10, Math.floor(Math.log10(raw)));
    const norm = raw / mag, step = (norm < 1.5 ? 1 : norm < 3 ? 2 : norm < 7 ? 5 : 10) * mag;
    const out: number[] = []; const start = Math.ceil(lo / step - 1e-9) * step;
    for (let v = start; v <= hi + step * 0.5; v += step) out.push(+v.toPrecision(4));
    return out;
  }
  const SUP = ['⁰', '¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸', '⁹'];
  const supStr = (p: number) => (p < 0 ? '⁻' : '') + String(Math.abs(p)).split('').map(d => SUP[+d]).join('');
  // Polarizability viewer over the chosen spectral range (λ or eV). Linear: Re (solid)/Im (dashed)/|·| (faint), normalized.
  // Log: |α| only on a log₁₀ axis with 10ⁿ ticks.
  function drawMaterials() {
    const cc = ctx2d($('sp-chart') as HTMLCanvasElement); if (!cc || !spAlpha) return;
    const { ctx, w, h } = cc, A = spAlpha, n = A.eV.length;
    const nz = (arr: Cpx[]) => arr.some(z => z.re !== 0 || z.im !== 0);
    const eq = (a: Cpx[], b: Cpx[]) => a.every((z, i) => Math.abs(z.re - b[i].re) < 1e-300 && Math.abs(z.im - b[i].im) < 1e-300);
    const comps: { label: string; arr: Cpx[]; color: string }[] = [];
    if (nz(A.ax) && !nz(A.ay) && eq(A.ax, A.az)) comps.push({ label: 'α', arr: A.ax, color: '#2563eb' });   // isotropic scalar
    else { if (nz(A.ax)) comps.push({ label: 'αx', arr: A.ax, color: '#dc2626' }); if (nz(A.ay)) comps.push({ label: 'αy', arr: A.ay, color: '#16a34a' }); if (nz(A.az)) comps.push({ label: 'αz', arr: A.az, color: '#2563eb' }); }
    if (!comps.length) comps.push({ label: 'α', arr: A.ax, color: '#2563eb' });

    // x-axis range = (shared spectral range) ∩ (α data range), in the active unit (λ nm or E eV)
    const unit = sp.specUnit;
    const lo = Math.min(sp.specMin, sp.specMax), hi = Math.max(sp.specMin, sp.specMax);
    const uEvLo = unit === 'nm' ? eVFromWavelengthNm(hi) : lo, uEvHi = unit === 'nm' ? eVFromWavelengthNm(lo) : hi;
    const evLo = Math.max(A.eV[0], uEvLo), evHi = Math.min(A.eV[n - 1], uEvHi);
    const xlabel = unit === 'nm' ? 'Wavelength (nm)' : 'Photon energy (eV)';
    const xOf = (i: number) => unit === 'nm' ? wavelengthNmFromEV(A.eV[i]) : A.eV[i];
    if (!(evHi > evLo)) {
      axes(ctx, w, h, 0, 1, 0, 1, xlabel, 'α', [], []);
      ctx.fillStyle = cvar('--text-muted'); ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('No α data in the selected range', w / 2, h / 2);
      $('sp-readout').innerHTML = '<span>No α(ω) data within the selected range.</span>';
      return;
    }
    let i0 = 0; while (i0 < n - 1 && A.eV[i0] < evLo) i0++;
    let i1 = n - 1; while (i1 > 0 && A.eV[i1] > evHi) i1--;
    if (i1 < i0) i1 = i0;
    const xmin = Math.min(xOf(i0), xOf(i1)), xmax = Math.max(xOf(i0), xOf(i1));
    const drawLine = (p: Plot, val: (i: number) => number, color: string, lw: number, dash: number[], alpha: number) => {
      ctx.strokeStyle = color; ctx.lineWidth = lw; ctx.globalAlpha = alpha; ctx.setLineDash(dash); ctx.beginPath();
      for (let i = i0; i <= i1; i++) { const X = p.px(xOf(i)), Y = p.py(val(i)); i === i0 ? ctx.moveTo(X, Y) : ctx.lineTo(X, Y); } ctx.stroke();
      ctx.globalAlpha = 1; ctx.setLineDash([]);
    };

    if (sp.matLog) {
      // log₁₀ |α| only — vertical axis at powers of ten (10ⁿ)
      let mn = Infinity, mx = 1e-300;
      for (let i = i0; i <= i1; i++) for (const cmp of comps) { const v = cabs(cmp.arr[i]); if (v > 0) { mn = Math.min(mn, v); mx = Math.max(mx, v); } }
      if (!isFinite(mn) || mn <= 0) mn = mx / 10;
      const lyMin = Math.floor(Math.log10(mn) - 1e-9), lyMax = Math.max(lyMin + 1, Math.ceil(Math.log10(mx) + 1e-9));
      const p = axes(ctx, w, h, xmin, xmax, lyMin, lyMax, xlabel, '|α(ω)|', [], niceTicks(xmin, xmax));
      ctx.font = '11px ' + (cvar('--font') || 'sans-serif'); ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
      for (let pw = lyMin; pw <= lyMax; pw++) {
        const Y = p.py(pw); ctx.strokeStyle = 'rgba(140,140,150,0.18)'; ctx.beginPath(); ctx.moveTo(p.m.l, Y); ctx.lineTo(w - p.m.r, Y); ctx.stroke();
        ctx.fillStyle = cvar('--text-muted'); ctx.fillText('10' + supStr(pw), p.m.l - 6, Y);
      }
      clipPlot(ctx, w, h, p);
      for (const cmp of comps) drawLine(p, i => Math.log10(Math.max(1e-300, cabs(cmp.arr[i]))), cmp.color, 1.8, [], 1);
      ctx.restore();
      ctx.font = '11px ' + (cvar('--font') || 'sans-serif'); ctx.textBaseline = 'middle'; ctx.textAlign = 'left';
      const lx = w - p.m.r - 64; let ly = p.m.t + 12;
      for (const cmp of comps) { ctx.strokeStyle = cmp.color; ctx.lineWidth = 1.8; ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(lx + 16, ly); ctx.stroke(); ctx.fillStyle = cmp.color; ctx.fillText(`|${cmp.label}|`, lx + 20, ly); ly += 16; }
    } else {
      // linear: normalized Re/Im/|α| (units arbitrary → divide by peak |α|)
      let scale = 1e-300;
      for (let i = i0; i <= i1; i++) for (const cmp of comps) scale = Math.max(scale, cabs(cmp.arr[i]));
      const sv = (x: number) => x / scale;
      let ymin = 0, ymax = 1e-300;
      for (let i = i0; i <= i1; i++) for (const cmp of comps) { const z = cmp.arr[i]; ymin = Math.min(ymin, sv(z.re), sv(z.im)); ymax = Math.max(ymax, sv(z.re), sv(z.im), sv(cabs(z))); }
      const pad = (ymax - ymin) * 0.06 || 0.1; ymin -= pad; ymax += pad;
      const p = axes(ctx, w, h, xmin, xmax, ymin, ymax, xlabel, 'α(ω) / max |α|', niceTicks(ymin, ymax), niceTicks(xmin, xmax));
