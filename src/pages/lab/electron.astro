        const X = px(td), Y = py(yval); started ? ctx.lineTo(X, Y) : (ctx.moveTo(X, Y), started = true);
        lx = X; ly = Y; drew = true;
      }
      ctx.stroke();
      if (drew) { ctx.fillStyle = analytic; ctx.textAlign = lx > w - m.r - 22 ? 'right' : 'left'; ctx.fillText(label, lx > w - m.r - 22 ? lx - 3 : lx + 3, Math.max(m.t + 7, Math.min(h - m.b - 7, ly))); }
    }
    ctx.restore();
