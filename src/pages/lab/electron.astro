  // ── α(ω) import dialog: map file columns → spectral axis + Re/Im of αx,αy,αz ──
  const alphaDlg = $('sp-alpha-dialog') as HTMLDialogElement;
  const ROLE_DEFS = [
    { key: 'axis', label: 'Spectral axis' }, { key: 'axre', label: 'Re αx' }, { key: 'axim', label: 'Im αx' },
    { key: 'ayre', label: 'Re αy' }, { key: 'ayim', label: 'Im αy' }, { key: 'azre', label: 'Re αz' }, { key: 'azim', label: 'Im αz' },
  ];
  let pendingRows: number[][] = [], pendingName = '';
  const fmtCompact = (x: number) => { if (!Number.isFinite(x)) return '–'; const a = Math.abs(x); return (a !== 0 && (a < 1e-3 || a >= 1e5)) ? x.toExponential(2) : String(+x.toFixed(4)); };
  const ncols = () => pendingRows.reduce((m, r) => Math.max(m, r.length), 0);
  function parseAlphaText(text: string): number[][] {
    const out: number[][] = [];
    for (const raw of text.split(/\r?\n/)) {
      const line = raw.trim(); if (!line || /^[#%;/]/.test(line)) continue;
      const parts = line.split(/[\s,;\t]+/).map(Number);
      if (parts.length >= 2 && parts.every(n => Number.isFinite(n))) out.push(parts);
    }
    return out;
  }
  const axisToEv = (x: number, unit: string): number =>
    unit === 'thz' ? x * 1e12 * 2 * Math.PI * HBAR_EVS : unit === 'nm' ? eVFromWavelengthNm(x) : unit === 'um' ? eVFromWavelengthNm(x * 1000) : x;
  function defaultRoles(n: number): Record<string, number> {
    const r: Record<string, number> = { axis: 0, axre: -1, axim: -1, ayre: -1, ayim: -1, azre: -1, azim: -1 };
    if (n === 5) { r.axre = 1; r.axim = 2; r.azre = 3; r.azim = 4; }
    else if (n >= 7) { r.axre = 1; r.axim = 2; r.ayre = 3; r.ayim = 4; r.azre = 5; r.azim = 6; }
    else { if (n > 1) r.axre = 1; if (n > 2) r.axim = 2; if (n > 3) r.azre = 3; if (n > 4) r.azim = 4; }
