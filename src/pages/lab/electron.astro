    const b = pnBeam(), T = beamPeriodS(b);
    const zMaxM = pn.fullTalbot ? talbotDistanceM(b) : pn.zMaxMm * 1e-3;
    const tauHi = pn.tauRange * T, zMm = zMaxM * 1e3, tauFs = tauHi * 1e15;
