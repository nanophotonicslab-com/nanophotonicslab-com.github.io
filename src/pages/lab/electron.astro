  }
  function currentRoles(): Record<string, number> {
    const m: Record<string, number> = {};
    $('sp-alpha-roles').querySelectorAll('label').forEach(l => { m[(l as HTMLElement).dataset.role!] = parseInt((l.querySelector('select') as HTMLSelectElement).value); });
    return m;
  }
  function buildAlpha(): AlphaData | { error: string } {
    if (!pendingRows.length) return { error: 'No numeric rows — load a file or paste data.' };
    const roles = currentRoles(), unit = ($('sp-alpha-unit') as HTMLSelectElement).value;
    if (roles.axis < 0) return { error: 'Map the spectral-axis column.' };
    if (['axre', 'axim', 'ayre', 'ayim', 'azre', 'azim'].every(k => roles[k] < 0)) return { error: 'Map at least one α component.' };
    const get = (row: number[], col: number) => (col >= 0 && col < row.length && Number.isFinite(row[col])) ? row[col] : 0;
    const recs = pendingRows
      .filter(r => r.length > roles.axis && Number.isFinite(r[roles.axis]))
      .map(r => ({ eV: axisToEv(r[roles.axis], unit), ax: c(get(r, roles.axre), get(r, roles.axim)), ay: c(get(r, roles.ayre), get(r, roles.ayim)), az: c(get(r, roles.azre), get(r, roles.azim)) }))
      .filter(p => Number.isFinite(p.eV) && p.eV > 0)
