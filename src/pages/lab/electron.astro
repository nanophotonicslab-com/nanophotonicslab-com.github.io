    return { eV, ax, ay: ax.map(() => c(0, 0)), az: ax.map(z => c(z.re, z.im)), label: `${material.toUpperCase()} ${geo} (2D), D=${D} nm · ${eV.length} pts` };
  }
  // Read the lab's linear-plasmonic (3D) controls and recompute the matching α(ω) (lib only — the lab itself is never modified)
  function computePlas(): AlphaData | { error: string } {
    const doc = plasDoc();
    if (!doc) return { error: 'Lab still loading — wait a moment, then Use α.' };
    const ncb = doc.getElementById('nl-controls-box') as HTMLElement | null;
    if (ncb && !ncb.hidden) return computePlas2D(doc);       // lab is in 2D (nonlinear) mode
    if (!doc.getElementById('shape-select')) return { error: 'Lab still loading — wait a moment, then Use α.' };
    const gv = (id: string) => { const el = doc.getElementById(id) as HTMLInputElement | HTMLSelectElement | null; return el ? el.value : ''; };
    const shape = gv('shape-select') as any;
    const materialId = gv('material-select') || 'au';
    const lengthNm = parseFloat(gv('length-num')) || 50;
    const aspectRatio = parseFloat(gv('aspect-num')) || 4;
    const hostIndex = parseFloat(gv('host-num')) || 1.33;
    const lmin = parseFloat(gv('lambda-min')) || 550;
    const lmax = parseFloat(gv('lambda-max')) || 1250;
    if (!(lmax > lmin)) return { error: 'Set λ max > λ min in the lab.' };
    // permalink hash to reopen the lab with this exact structure (matches the lab's serializeState keys)
    const hp = new URLSearchParams();
    hp.set('mat', String(materialId));
    let epsilonAt: ((lam: number) => { re: number; im: number }) | undefined;
