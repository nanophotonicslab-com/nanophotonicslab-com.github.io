    }
    if (sp.sub === 'emission') {
      const aol = aOverLambda(), lines = [head, `# SP-solution diagram at lambda=${wavelengthNmFromEV(sp.E).toFixed(1)} nm`, 'n,ell,sin_theta,theta_deg'];
      for (let n = -2; n <= 2; n++) for (let ell = 0; ell < N; ell++) { const s = gspCondition(n, ell, N, beta, aol); if (Math.abs(s) <= 1) lines.push(`${n},${ell},${p6(s)},${(Math.asin(s) * 180 / PI).toFixed(3)}`); }
