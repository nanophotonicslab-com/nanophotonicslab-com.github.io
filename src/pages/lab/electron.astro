  ($('sp-kev') as HTMLInputElement).addEventListener('input', e => { const k = parseFloat((e.target as HTMLInputElement).value); if (Number.isFinite(k) && k > 0) { syncBetaK(kToBeta(k), 'kev'); renderSP(); } });
