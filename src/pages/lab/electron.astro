      const lines = [head, `theta_deg,${isEv ? 'E_eV' : 'lambda_nm'},${which === 'amplitude' ? 'intensity_S0' : which.toUpperCase() + '_over_S0'}`];
      for (let iu = 0; iu < NU; iu++) {
        const yv = yMin + (yMax - yMin) * iu / (NU - 1), E = isEv ? yv : eVFromWavelengthNm(yv), aol = sp.a / wavelengthNmFromEV(E), dip = dipolesAtOmega(omegaFromEV(E), mag);
        for (let ix = 0; ix < NX; ix++) {
          const thd = sp.thMin + (sp.thMax - sp.thMin) * ix / (NX - 1), t = thd * PI / 180;
          const { fTheta, fPhi } = sphericalComponents(t, phi, farFieldVector(t, phi, dip, aol, beta)); const [s0, s1, s2, s3] = stokes(fTheta, fPhi);
          const v = which === 'amplitude' ? s0 : (s0 > 1e-12 ? (which === 's1' ? s1 : which === 's2' ? s2 : s3) / s0 : NaN);
          lines.push(`${thd.toFixed(2)},${p6(yv)},${p6(v)}`);
        }
