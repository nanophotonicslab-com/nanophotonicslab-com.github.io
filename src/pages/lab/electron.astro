---
import Layout from '../../layouts/Layout.astro';
import ModelInfo from '../../components/ModelInfo.astro';
import ToolMeta from '../../components/ToolMeta.astro';
import ParamsDrawer from '../../components/ParamsDrawer.astro';
import '../../styles/lab.css';
---

<Layout title="Relativistic Electron Calculator" description="Convert between velocity, energy, de Broglie wavelength, and Lorentz factor for relativistic electrons — with live chart and microscope references.">
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Relativistic Electron <span class="gradient-text">Calculator</span></h1>
      <p class="widget-hero__subtitle">
        Enter any quantity and all others update in real time.
        The chart shows de&nbsp;Broglie wavelength vs kinetic energy with common
        electron-microscope references.
      </p>
      <ToolMeta slug="electron" name="Relativistic Electron Calculator" />
    </div>
  </section>

  <ModelInfo status="Beta">
    <dl>
      <dt>Model</dt>
      <dd>Special-relativistic kinematics: K = (&gamma; &minus; 1)m<sub>e</sub>c&sup2;, &gamma; = (1 &minus; v&sup2;/c&sup2;)<sup>&minus;1/2</sup>, &lambda;<sub>e</sub> = h/p.</dd>
      <dt>Assumptions</dt>
      <dd>Free electron in vacuum. Constants from CODATA 2018.</dd>
      <dt>Limitations</dt>
      <dd>No potential energy or interaction effects. The de Broglie wavelength is the free-space value — inside a material, effective wavelength differs.</dd>
    </dl>
  </ModelInfo>

  <section class="section">
    <div class="container">
      <div class="module-bar card" role="radiogroup" aria-label="Electron module">
        <span class="module-bar__label">Module</span>
        <div class="module-bar__grid">
          <button type="button" class="module-card active" id="module-fields" role="radio" aria-checked="true">
            <span class="module-card__name">Fields</span>
            <span class="module-card__desc">Relativistic electron &middot; &lambda;<sub>e</sub>, E(t), field spectrum</span>
          </button>
          <button type="button" class="module-card" id="module-smith-purcell" role="radio" aria-checked="false">
            <span class="module-card__name">Smith&ndash;Purcell</span>
            <span class="module-card__desc">Light emission from an electron over a grating</span>
          </button>
          <button type="button" class="module-card" id="module-pinem" role="radio" aria-checked="false">
            <span class="module-card__name">PINEM</span>
            <span class="module-card__desc">Photon-induced near-field electron microscopy</span>
          </button>
        </div>
      </div>

      <!-- ===================== FIELDS module ===================== -->
      <div id="panel-fields">
      <div class="widget-layout">
        <!-- ===== Controls ===== -->
        <ParamsDrawer>
        <div class="controls card">
          <h3>Parameters</h3>

          <div class="fields">
            <div class="field">
              <label for="vc">v / c</label>
              <input type="text" class="field-input" id="vc" inputmode="decimal" placeholder="0.548">
            </div>
            <div class="field">
              <label for="kev">K (keV)</label>
              <input type="text" class="field-input" id="kev" inputmode="decimal" placeholder="100">
            </div>
            <div class="field">
              <label for="lam">&lambda;<sub>e</sub> (pm)</label>
              <input type="text" class="field-input" id="lam" inputmode="decimal" placeholder="3.70">
            </div>
            <div class="field">
              <label for="vnmfs">v (nm/fs)</label>
              <input type="text" class="field-input" id="vnmfs" inputmode="decimal" placeholder="0.164">
            </div>
            <div class="field">
              <label for="ej">E (J)</label>
              <input type="text" class="field-input" id="ej" inputmode="decimal" placeholder="1.60e-14">
            </div>
            <div class="field">
              <label for="gamma">&gamma;</label>
              <input type="text" class="field-input" id="gamma" inputmode="decimal" placeholder="1.196">
            </div>
          </div>

          <div class="param">
            <div class="param-header"><label>Quick set</label></div>
            <div class="preset-row" id="presets">
              <button class="preset-btn" data-kev="30">30&thinsp;kV</button>
              <button class="preset-btn" data-kev="80">80&thinsp;kV</button>
              <button class="preset-btn" data-kev="120">120&thinsp;kV</button>
              <button class="preset-btn" data-kev="200">200&thinsp;kV</button>
            </div>
          </div>

          <div class="param param-box">
            <div class="param-header"><label>Field probe</label></div>
            <div class="fields">
              <div class="field">
                <label for="field-r">R (nm)</label>
                <input type="text" class="field-input" id="field-r" inputmode="decimal" value="2">
              </div>
              <div class="field">
                <label for="field-z">z (nm)</label>
                <input type="text" class="field-input" id="field-z" inputmode="decimal" value="2">
              </div>
            </div>
          </div>

          <div class="param param-box">
            <div class="param-header"><label>Spectral scan</label></div>
            <div class="fields">
              <div class="field">
                <label for="field-w-min">&hbar;&omega;<sub>min</sub> (eV)</label>
                <input type="text" class="field-input" id="field-w-min" inputmode="decimal" value="0.01">
              </div>
              <div class="field">
                <label for="field-w-max">&hbar;&omega;<sub>max</sub> (eV)</label>
                <input type="text" class="field-input" id="field-w-max" inputmode="decimal" value="10">
              </div>
            </div>
          </div>

          <!-- Velocity gauge -->
          <div class="gauge">
            <div class="gauge-header">
              <span class="gauge-label">Velocity</span>
              <span class="gauge-value" id="gauge-pct">&mdash;</span>
            </div>
            <div class="gauge-track">
              <div class="gauge-fill" id="gauge-fill"></div>
            </div>
          </div>

          <button class="clear-btn" id="clear-btn">Clear all</button>

          <p class="theory-note">
            <strong>Relativistic kinematics.</strong>
            K&nbsp;=&nbsp;(&gamma;&nbsp;&minus;&nbsp;1)&thinsp;m<sub>e</sub>c&sup2;, &ensp;
            &gamma;&nbsp;=&nbsp;(1&nbsp;&minus;&nbsp;v&sup2;/c&sup2;)<sup>&minus;&frac12;</sup>, &ensp;
            &lambda;<sub>e</sub>&nbsp;=&nbsp;h&thinsp;/&thinsp;p.
            Constants: CODATA 2018.
          </p>
        </div>
        </ParamsDrawer>

        <!-- ===== Results ===== -->
        <div class="results-grid">
          <div class="result-panel card">
            <div class="chart-header">
              <span class="chart-title">&lambda;<sub>e</sub>&ensp;vs&ensp;K</span>
              <span class="chart-stat" id="lambda-value">&mdash;</span>
            </div>
            <div class="chart-wrap" id="chart-wrap">
              <canvas id="electron-chart" aria-label="De Broglie wavelength versus kinetic energy"></canvas>
            </div>
          </div>

          <div class="result-panel card">
            <div class="chart-header">
              <span class="chart-title">FWHM of |E(t)|</span>
              <span class="chart-stat" id="fwhm-value">&mdash;</span>
            </div>
            <div class="chart-wrap" id="fwhm-chart-wrap">
              <canvas id="fwhm-chart" aria-label="Electron field pulse FWHM versus kinetic energy"></canvas>
            </div>
          </div>

          <div class="result-panel card">
            <div class="chart-header">
              <span class="chart-title">Frequency-domain field</span>
              <span class="chart-stat" id="freq-field-note">&mdash;</span>
            </div>
            <div class="chart-wrap" id="freq-field-wrap">
              <canvas id="freq-field-chart" aria-label="Parallel and perpendicular electron fields in the frequency domain"></canvas>
            </div>
          </div>

          <div class="result-panel card">
            <div class="chart-header">
              <span class="chart-title">Time-domain field</span>
              <span class="chart-stat" id="time-field-note">&mdash;</span>
            </div>
            <div class="chart-wrap" id="time-field-wrap">
              <canvas id="time-field-chart" aria-label="Parallel and perpendicular electron fields in the time domain"></canvas>
            </div>
          </div>
        </div>
      </div>

      <div class="references card">
        <h4>References</h4>
        <ul class="reference-list">
          <li><span class="ref-index">[1]</span><span>F. J. Garc&iacute;a de Abajo, <em>Optical excitations in electron microscopy</em>, Reviews of Modern Physics <strong>82</strong>, 209&ndash;275 (2010), <a href="https://doi.org/10.1103/RevModPhys.82.209" target="_blank" rel="noopener">doi:10.1103/RevModPhys.82.209</a>.</span></li>
          <li><span class="ref-index">[2]</span><span>J. D. Jackson, <em>Classical Electrodynamics</em>, 3rd ed. (Wiley, 1999).</span></li>
        </ul>
      </div>
      </div><!-- /#panel-fields -->

      <!-- ===================== SMITH–PURCELL module ===================== -->
      <div id="panel-sp" hidden>
        <div class="widget-layout">
          <!-- ===== Controls ===== -->
          <ParamsDrawer>
          <div class="controls card">
            <h3>Parameters</h3>

            <div class="fields">
              <div class="field"><label for="sp-vc">v / c</label><input type="text" class="field-input" id="sp-vc" inputmode="decimal" value="0.5"></div>
              <div class="field"><label for="sp-kev">K (keV)</label><input type="text" class="field-input" id="sp-kev" inputmode="decimal"></div>
            </div>

            <div class="sp-param">
              <div class="sp-param__head"><label for="sp-a">Spacing a (nm)</label><input type="number" class="field-input sp-num" id="sp-a" value="200" step="10" min="20" max="2000"></div>
              <input type="range" class="sp-slider" id="sp-a-slider" aria-label="Spacing a (nm)" min="20" max="1000" step="10" value="200">
            </div>
            <div class="sp-param">
              <div class="sp-param__head"><label for="sp-b">Impact para. b (nm)</label><input type="number" class="field-input sp-num" id="sp-b" value="50" step="5" min="1" max="500"></div>
              <input type="range" class="sp-slider" id="sp-b-slider" aria-label="Impact parameter b (nm)" min="1" max="300" step="1" value="50">
            </div>
            <div class="sp-param">
              <div class="sp-param__head"><label for="sp-N">Number of elements N</label><input type="number" class="field-input sp-num" id="sp-N" value="51" step="2" min="3" max="201"></div>
              <input type="range" class="sp-slider" id="sp-N-slider" aria-label="Number of elements N" min="3" max="151" step="2" value="51">
            </div>
            <div class="sp-param">
              <div class="sp-param__head"><label for="sp-xi">Steering mode &xi;</label><input type="number" class="field-input sp-num" id="sp-xi" value="0" step="1" min="0" max="25"></div>
              <input type="range" class="sp-slider" id="sp-xi-slider" aria-label="Steering mode ξ" min="0" max="25" step="1" value="0">
            </div>

            <div class="field"><label for="sp-orient">Dipole orientation</label>
              <select class="field-input" id="sp-orient">
                <option value="electron" selected>Electron (elliptical)</option>
                <option value="x">x &middot; &parallel; v</option>
                <option value="z">z &middot; &perp;</option>
                <option value="custom">Custom&hellip;</option>
                <option value="plasmonic">Plasmonic NPs&hellip;</option>
                <option value="input">Input polarizability &alpha;(&omega;)&hellip;</option>
              </select>
            </div>

            <!-- Imported α(ω): summary chip + re-open button (only shown for the Input source) -->
            <div class="sp-alpha-chip" id="sp-alpha-chip" hidden>
              <span id="sp-alpha-chip-label">No α loaded</span>
              <button type="button" id="sp-alpha-edit" title="Load / edit polarizability data">Edit&hellip;</button>
            </div>

            <!-- Plasmonic NPs: real orientation weights — dipole p(ω) = α(ω)·(pₓ, p_y, p_z) -->
            <div class="sp-plas-dir" id="sp-plas-dir" hidden>
              <span class="sp-plas-dir__cap">Response weights p = (p<sub>x</sub>, p<sub>y</sub>, p<sub>z</sub>)</span>
              <div class="sp-plas-dir__row">
                <label>p<sub>x</sub><input type="text" class="field-input sp-cnum" id="sp-pw-x" inputmode="decimal" value="1"></label>
                <label>p<sub>y</sub><input type="text" class="field-input sp-cnum" id="sp-pw-y" inputmode="decimal" value="0"></label>
                <label>p<sub>z</sub><input type="text" class="field-input sp-cnum" id="sp-pw-z" inputmode="decimal" value="0"></label>
              </div>
            </div>

            <!-- Complex dipole oscillation direction p = (px, py, pz): always shown; editable only for Custom -->
            <div class="sp-dipole" id="sp-dipole">
              <div class="sp-dipole__cap" id="sp-dipole-cap">Induced dipole direction</div>
              <div class="sp-dipole__row sp-dipole__head">
                <span>comp</span>
                <span>Re</span>
                <span>Im</span>
              </div>
              <div class="sp-dipole__row">
                <label for="sp-px-re">p<sub>x</sub></label>
                <input type="text" class="field-input sp-cnum" id="sp-px-re" inputmode="decimal" value="0">
                <input type="text" class="field-input sp-cnum" id="sp-px-im" inputmode="decimal" value="1">
              </div>
              <div class="sp-dipole__row">
                <label for="sp-py-re">p<sub>y</sub></label>
                <input type="text" class="field-input sp-cnum" id="sp-py-re" inputmode="decimal" value="0">
                <input type="text" class="field-input sp-cnum" id="sp-py-im" inputmode="decimal" value="0">
              </div>
              <div class="sp-dipole__row">
                <label for="sp-pz-re">p<sub>z</sub></label>
                <input type="text" class="field-input sp-cnum" id="sp-pz-re" inputmode="decimal" value="1">
                <input type="text" class="field-input sp-cnum" id="sp-pz-im" inputmode="decimal" value="0">
              </div>
              <div class="sp-dipole__foot">
                <span class="sp-dipole__mag" id="sp-dipole-mag">|p| = 1.000</span>
                <button type="button" class="sp-normalize" id="sp-normalize">Normalize |p| = 1</button>
              </div>
            </div>

            <div class="sp-param" id="sp-phi-field">
              <div class="sp-param__head"><label for="sp-phi">Azimuth &phi; (&deg;)</label><input type="number" class="field-input sp-num" id="sp-phi" value="30" step="5" min="0" max="90"></div>
              <input type="range" class="sp-slider" id="sp-phi-slider" aria-label="Azimuth φ (degrees)" min="0" max="90" step="1" value="30">
            </div>

            <!-- Spectral-map axes (Spectrum view only): emission-angle and wavelength ranges -->
            <div class="sp-range" id="sp-th-field">
              <label>Emission angle &theta; (&deg;)</label>
              <div class="sp-range__row">
                <input type="number" class="field-input sp-rnum" id="sp-th-min" value="-45" step="5">
                <span class="sp-range__dash">to</span>
                <input type="number" class="field-input sp-rnum" id="sp-th-max" value="225" step="5">
              </div>
            </div>
            <div class="sp-range" id="sp-spec-field">
              <div class="sp-range__head">
                <label id="sp-spec-label">Wavelength (nm)</label>
                <div class="sp-unit-toggle" id="sp-spec-unit" role="radiogroup" aria-label="Wavelength unit">
                  <button type="button" data-su="nm" class="active" aria-pressed="true">&lambda;</button>
                  <button type="button" data-su="eV" aria-pressed="false">eV</button>
                </div>
              </div>
              <div class="sp-range__row">
                <input type="number" class="field-input sp-rnum" id="sp-spec-min" value="400" step="10">
                <span class="sp-range__dash">to</span>
                <input type="number" class="field-input sp-rnum" id="sp-spec-max" value="800" step="10">
              </div>
            </div>

            <!-- Far-field view only: single wavelength, dual λ ⇄ E entry + slider with a λ/eV switch -->
            <div id="sp-wl-field" hidden>
              <div class="fields">
                <div class="field"><label for="sp-wl-nm">&lambda; (nm)</label><input type="text" class="field-input" id="sp-wl-nm" inputmode="decimal" value="620"></div>
                <div class="field"><label for="sp-wl-ev">E (eV)</label><input type="text" class="field-input" id="sp-wl-ev" inputmode="decimal" value="2.0"></div>
              </div>
              <div class="sp-wl-slider-row">
                <input type="range" class="sp-slider" id="sp-wl-slider" aria-label="Wavelength λ (nm)" min="200" max="2000" step="5" value="620">
                <div class="sp-unit-toggle" id="sp-wl-unit" role="radiogroup" aria-label="Slider unit">
                  <button type="button" data-wu="nm" class="active" aria-pressed="true">&lambda;</button>
                  <button type="button" data-wu="eV" aria-pressed="false">eV</button>
                </div>
              </div>
            </div>

            <p class="sp-aol" id="sp-aol">&mdash;</p>

            <!-- Geometry schematic (click to enlarge — like the Mie-scattering lab) -->
            <div class="sp-geo" id="sp-geo-open" role="button" tabindex="0" aria-label="Open enlarged geometry schematic" title="Click to enlarge">
              <canvas id="sp-geo-canvas" aria-label="Generalized Smith–Purcell geometry schematic"></canvas>
              <button type="button" class="sp-geo__png" id="sp-geo-png" title="Download schematic as PNG">PNG</button>
              <span class="sp-geo__hint">&#10530; enlarge</span>
            </div>
          </div>
          </ParamsDrawer>

          <!-- ===== Results ===== -->
          <div class="sp-results-col">
            <!-- main view selector — sits just above the result box (like the plasmonic lab tabs) -->
            <div class="sp-view-tabs" id="sp-view-tabs" role="tablist" aria-label="View">
              <button type="button" class="sp-view-tab active" data-view="spectrum" role="tab" aria-selected="true">Spectrum</button>
              <button type="button" class="sp-view-tab" data-view="farfield" role="tab" aria-selected="false">Far-field</button>
              <button type="button" class="sp-view-tab" data-view="materials" role="tab" aria-selected="false" id="sp-view-materials" hidden>Materials</button>
            </div>

            <div class="result-panel card sp-result-card">
              <div class="sp-sub-tabs" id="sp-sub-tabs" role="tablist" aria-label="Sub-view"></div>
              <div class="sp-chart-head">
                <div class="sp-title-wrap">
                  <div class="sp-chart-title" id="sp-chart-title">&mdash;</div>
                  <button type="button" class="sp-info-btn" id="sp-rosette-info" aria-label="How to read the rosette" title="How to read the rosette" aria-expanded="false" hidden>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                  </button>
                  <div class="sp-info-pop" id="sp-rosette-pop" role="dialog" aria-label="Rosette coordinate guide" hidden>
                    <div class="sp-info-pop__head">
                      <span>Reading the rosette</span>
                      <button type="button" class="sp-info-pop__close" id="sp-rosette-pop-close" aria-label="Close">&times;</button>
                    </div>
                    <svg class="sp-info-pop__svg" viewBox="0 0 260 236" role="img" aria-label="Empty rosette showing polar angle θ (radial) and azimuth φ (angular) labelling">
                      <g fill="none" stroke="currentColor" stroke-width="1" opacity="0.55">
                        <circle cx="130" cy="118" r="90"/>
                        <circle cx="130" cy="118" r="60"/>
                        <circle cx="130" cy="118" r="30"/>
                        <line x1="40" y1="118" x2="220" y2="118"/>
                        <line x1="130" y1="28" x2="130" y2="208"/>
                      </g>
                      <!-- azimuth φ direction (CCW) -->
                      <path d="M 196 78 A 82 82 0 0 0 182 62" fill="none" stroke="var(--primary)" stroke-width="1.6" marker-end="url(#sp-rose-arr)"/>
                      <defs><marker id="sp-rose-arr" markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="var(--primary)"/></marker></defs>
                      <!-- centre + edge markers -->
                      <circle cx="130" cy="118" r="2.6" fill="currentColor"/>
                      <g font-size="10.5" font-style="italic" fill="currentColor">
                        <text x="130" y="112" text-anchor="middle">θ=0</text>
                        <text x="130" y="132" text-anchor="middle" font-style="normal" font-size="8.5" opacity="0.7">normal</text>
                        <text x="171" y="114" font-size="8.5" font-style="normal" opacity="0.75">30°</text>
                        <text x="201" y="114" font-size="8.5" font-style="normal" opacity="0.75">60°</text>
                      </g>
                      <!-- θ edge label -->
                      <text x="130" y="228" text-anchor="middle" font-size="9.5" fill="currentColor" opacity="0.85">θ = 90° (grazing) at rim &middot; radial = polar angle from normal</text>
                      <!-- azimuth labels -->
                      <g font-size="10" fill="currentColor">
                        <text x="226" y="121" font-weight="600">φ=0</text>
                        <text x="226" y="133" font-size="7.5" opacity="0.7">beam →</text>
                        <text x="130" y="22" text-anchor="middle">φ=90°</text>
                        <text x="34" y="121" text-anchor="end">180°</text>
                        <text x="130" y="220" text-anchor="middle">270°</text>
                      </g>
                    </svg>
                    <p class="sp-info-pop__note"><b>Radial</b> = polar angle θ from the surface normal (centre) out to 90° grazing (rim). <b>Angular</b> = azimuth φ, with φ=0 (East) the plane of incidence / beam direction, increasing counter-clockwise. φ=0 is the pure-p meridian where the ellipses collapse to radial segments.</p>
                  </div>
                </div>
                <div class="sp-stokes-sel" id="sp-stokes-sel" role="radiogroup" aria-label="Stokes parameter" hidden>
                  <button type="button" data-stk="s1" aria-pressed="false">S<sub>1</sub></button>
                  <button type="button" data-stk="s2" aria-pressed="false">S<sub>2</sub></button>
                  <button type="button" data-stk="s3" class="active" aria-pressed="true">S<sub>3</sub></button>
                </div>
                <div class="sp-stokes-sel" id="sp-mat-scale" role="radiogroup" aria-label="Polarizability scale" hidden>
                  <button type="button" data-ms="lin" class="active" aria-pressed="true">linear</button>
                  <button type="button" data-ms="log" aria-pressed="false">log |&alpha;|</button>
                </div>
              </div>
              <div class="chart-wrap sp-chart-wrap"><canvas id="sp-chart" aria-label="Smith–Purcell result plot"></canvas><div class="sp-map-tt" id="sp-map-tt" hidden></div></div>
              <div class="sp-readout" id="sp-readout"></div>
              <div class="sp-export-bar">
                <button type="button" class="tool-btn" id="sp-export-png" title="Download the plot as PNG">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                  PNG
                </button>
                <button type="button" class="tool-btn" id="sp-export-csv" title="Download the plotted data as CSV">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                  CSV
                </button>
              </div>
            </div>

            <!-- Induced-dipole profile for the current steering mode ξ (Fig. 2b of the paper) -->
            <div class="sp-steer-card card">
              <div class="sp-steer-head">
                <span class="sp-steer-title">Steering mode &mdash; induced dipole profile</span>
                <span class="sp-steer-sub" id="sp-steer-sub">&xi; = 0</span>
              </div>
              <div class="chart-wrap sp-steer-wrap"><canvas id="sp-steer-chart" aria-label="Induced dipole magnitude vs array index for the steering mode"></canvas></div>
            </div>

            <div class="notes-card card" id="sp-notes">
              <h4>Notes</h4>
              <p>
                <strong>Generalized Smith&ndash;Purcell.</strong>
                A swift electron (v/c, energy K) flies parallel to a periodic array of N point
                emitters (period a, impact parameter b) and induces a coherent dipole on each.
                Each Fourier mode &#8467; of the (engineered) dipole profile opens an emission
                channel at
                sin&thinsp;&theta;<sub>n,&#8467;</sub>&nbsp;=&nbsp;1/&beta;&nbsp;&minus;&nbsp;(n&nbsp;&minus;&nbsp;&#8467;/N)&thinsp;&lambda;/a (Eq.&nbsp;6);
                &#8467;&nbsp;=&nbsp;0 is the ordinary Smith&ndash;Purcell line. Steering &xi; modulates
                |p<sub>j</sub>|&thinsp;=&thinsp;1&nbsp;+&nbsp;sin(2&pi;&xi;j/N) to select channel &#8467;&nbsp;=&nbsp;&xi;.
              </p>
              <p>
                <strong>Polarization.</strong> The electron field drives an elliptical dipole
                d&nbsp;=&nbsp;(i/&gamma;)K<sub>0</sub>&thinsp;x&#770;&nbsp;+&nbsp;K<sub>1</sub>&thinsp;z&#770; (Eq.&nbsp;9): the i makes
                x and z oscillate 90&deg; out of phase. In the &phi;&nbsp;=&nbsp;0 plane the emission is
                purely p-polarized; off-plane (&phi;&nbsp;&ne;&nbsp;0) it becomes elliptical, with
                wavelength- and angle-dependent handedness (Stokes S<sub>3</sub>).
              </p>
              <div class="sp-examples">
                <button type="button" class="sp-example" id="sp-ex-1" aria-pressed="false">
                  <span class="sp-example__head">Example 1 &mdash; SP dispersion</span>
                  <span class="sp-example__params">K&nbsp;=&nbsp;30&nbsp;keV (v/c&nbsp;=&nbsp;0.328) &middot; a&nbsp;=&nbsp;300&nbsp;nm &middot; b&nbsp;=&nbsp;10&nbsp;nm &middot; N&nbsp;=&nbsp;11 &middot; &xi;&nbsp;=&nbsp;0 &middot; dipole&nbsp;&#8741;&nbsp;x (parallel) &middot; E&nbsp;=&nbsp;3.2&nbsp;&rarr;&nbsp;1.65&nbsp;eV &middot; &theta;&nbsp;=&nbsp;&minus;180&hellip;&minus;55&deg;</span>
                  <span class="sp-example__hint">Click to load these parameters and show the spectral-dependence map &rarr;</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="references card">
          <h4>References</h4>
          <ul class="reference-list">
            <li><span class="ref-index">[1]</span><span>E. J. C. Dias, A. Rodr&iacute;guez Echarri, T. P. Rasmussen, F. J. Garc&iacute;a de Abajo &amp; J. D. Cox, <em>Active steering of cathodoluminescence through a generalized Smith&ndash;Purcell effect</em>, Light: Science &amp; Applications <strong>15</strong>, 218 (2026), <a href="https://doi.org/10.1038/s41377-026-02280-y" target="_blank" rel="noopener">doi:10.1038/s41377-026-02280-y</a>.</span></li>
            <li><span class="ref-index">[2]</span><span>S. J. Smith &amp; E. M. Purcell, <em>Visible Light from Localized Surface Charges Moving across a Grating</em>, Phys. Rev. <strong>92</strong>, 1069 (1953), <a href="https://doi.org/10.1103/PhysRev.92.1069" target="_blank" rel="noopener">doi:10.1103/PhysRev.92.1069</a>.</span></li>
          </ul>
        </div>

        <dialog id="sp-geo-dialog" class="sp-geo-dialog" aria-label="Geometry schematic">
          <div class="sp-geo-dialog__panel">
            <button type="button" class="tool-btn sp-geo-dialog__png" id="sp-geo-png-big" title="Download schematic as PNG">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              PNG
            </button>
            <button type="button" class="sp-geo-dialog__close" id="sp-geo-close" aria-label="Close">&times;</button>
            <canvas id="sp-geo-canvas-big" aria-label="Enlarged generalized Smith–Purcell geometry schematic"></canvas>
          </div>
        </dialog>

        <!-- Confirm imported polarizability α(ω): map file columns → spectral axis + Re/Im of αx,αy,αz -->
        <dialog id="sp-alpha-dialog" class="sp-alpha-dialog" aria-labelledby="sp-alpha-title">
          <div class="sp-alpha-dialog__panel">
            <div class="sp-alpha-dialog__header">
              <div>
                <h3 id="sp-alpha-title">Confirm polarizability input α(ω)</h3>
                <p id="sp-alpha-file">Load a file or paste the data below.</p>
              </div>
              <button type="button" class="sp-geo-dialog__close" id="sp-alpha-x" aria-label="Cancel">&times;</button>
            </div>

            <div class="sp-alpha-dialog__src">
              <input type="file" id="sp-alpha-file-input" accept=".csv,.tsv,.txt,.dat" class="file-input">
              <span class="sp-alpha-dialog__or">or paste</span>
              <textarea id="sp-alpha-paste" rows="3" placeholder="# E_eV   Re_ax   Im_ax   Re_az   Im_az&#10;0.20   1.5   0.3   0.8   0.1 …"></textarea>
              <button type="button" class="chart-tool-btn" id="sp-alpha-parse">Load pasted</button>
            </div>

            <div class="sp-alpha-dialog__grid">
              <label><span>Spectral axis unit</span>
                <select id="sp-alpha-unit" class="param-select">
                  <option value="ev">Photon energy (eV)</option>
                  <option value="thz">Frequency (THz)</option>
                  <option value="nm">Wavelength (nm)</option>
                  <option value="um">Wavelength (µm)</option>
                </select>
              </label>
            </div>

            <p class="sp-alpha-dialog__hint">Map each quantity to a file column (1-based). Unmapped components are taken as zero. The swift electron's near-field has no y-component, so α<sub>y</sub> does not drive emission in this geometry. Only the <em>spectral shape</em> of α matters — its overall magnitude, units, and global phase cancel in the normalized SP outputs.</p>
            <div class="sp-alpha-dialog__roles" id="sp-alpha-roles"><!-- role selects injected here --></div>

            <div class="sp-alpha-dialog__preview"><canvas id="sp-alpha-preview" aria-label="Polarizability preview"></canvas></div>
            <div class="sp-alpha-dialog__table-wrap">
              <table class="sp-alpha-dialog__table"><thead id="sp-alpha-thead"></thead><tbody id="sp-alpha-rows"></tbody></table>
            </div>
            <p class="sp-alpha-dialog__status" id="sp-alpha-status"></p>
            <div class="sp-alpha-dialog__actions">
              <button type="button" class="chart-tool-btn" id="sp-alpha-cancel">Cancel</button>
              <button type="button" class="chart-tool-btn active" id="sp-alpha-accept" disabled>Use α</button>
            </div>
          </div>
        </dialog>

        <!-- Plasmonic NPs: embed the real nanoparticle lab; on "Use α" read its controls and compute the matching α(ω) -->
        <dialog id="sp-plas-dialog" class="sp-plas-frame-dialog" aria-label="Plasmonic nanoparticles lab">
          <div class="sp-plas-frame-wrap">
            <iframe id="sp-plas-iframe" title="Plasmonic nanoparticles lab" src="about:blank"></iframe>
            <div class="sp-plas-frame-bar">
              <span class="sp-plas-frame-status" id="sp-plas-status">Configure the lab, then “Use α”.</span>
              <button type="button" class="chart-tool-btn" id="sp-plas-cancel">Cancel</button>
              <button type="button" class="chart-tool-btn active" id="sp-plas-accept">Use α</button>
            </div>
          </div>
        </dialog>
      </div><!-- /#panel-sp -->

      <div id="panel-pinem" hidden>
        <div class="widget-layout">
          <!-- ===== Controls ===== -->
          <ParamsDrawer>
          <div class="controls card">
            <h3>Parameters</h3>

            <div class="fields">
              <div class="field"><label for="pn-vc">v / c</label><input type="text" class="field-input" id="pn-vc" inputmode="decimal" value="0.5867"></div>
              <div class="field"><label for="pn-kev">K (keV)</label><input type="text" class="field-input" id="pn-kev" inputmode="decimal"></div>
            </div>

            <div class="sp-param">
              <div class="sp-param__head"><label for="pn-g">Coupling |g|</label><input type="number" class="field-input sp-num" id="pn-g" value="5" step="0.1" min="0" max="12"></div>
              <input type="range" class="sp-slider" id="pn-g-slider" aria-label="Coupling strength |g|" min="0" max="10" step="0.05" value="5">
            </div>

            <!-- Excitation wavelength — dual λ ⇄ E entry + slider with a λ/eV switch -->
            <div id="pn-wl-field">
              <label class="pn-sec-label">Excitation</label>
              <div class="fields">
                <div class="field"><label for="pn-wl-nm">&lambda; (nm)</label><input type="text" class="field-input" id="pn-wl-nm" inputmode="decimal" value="800"></div>
                <div class="field"><label for="pn-wl-ev">&#8463;&omega; (eV)</label><input type="text" class="field-input" id="pn-wl-ev" inputmode="decimal" value="1.550"></div>
              </div>
              <div class="sp-wl-slider-row">
                <input type="range" class="sp-slider" id="pn-wl-slider" aria-label="Excitation wavelength λ (nm)" min="200" max="2000" step="5" value="800">
                <div class="sp-unit-toggle" id="pn-wl-unit" role="radiogroup" aria-label="Slider unit">
                  <button type="button" data-wu="nm" class="active" aria-pressed="true">&lambda;</button>
                  <button type="button" data-wu="eV" aria-pressed="false">eV</button>
                </div>
              </div>
            </div>


            <!-- Range controls (context-dependent) -->
            <div class="sp-range" id="pn-range-N">
              <label>Sideband range &plusmn;N</label>
              <div class="sp-range__row"><input type="number" class="field-input sp-rnum" id="pn-nshow" value="15" step="1" min="2" max="60"></div>
            </div>

            <div id="pn-range-eels" hidden>
              <div class="sp-param">
                <div class="sp-param__head"><label for="pn-fwhm">Lorentzian FWHM &Gamma; (eV)</label><input type="number" class="field-input sp-num" id="pn-fwhm" value="0.5" step="0.05" min="0.01" max="3"></div>
                <input type="range" class="sp-slider" id="pn-fwhm-slider" aria-label="Lorentzian FWHM Γ (eV)" min="0.05" max="3" step="0.05" value="0.5">
              </div>
              <div class="sp-range">
                <label>Energy-loss axis (eV)</label>
                <div class="sp-range__row">
                  <input type="number" class="field-input sp-rnum" id="pn-emin" value="-20" step="1">
                  <span class="sp-range__dash">to</span>
                  <input type="number" class="field-input sp-rnum" id="pn-emax" value="20" step="1">
                </div>
              </div>
            </div>

            <div class="sp-range" id="pn-range-prop" hidden>
              <label>Retarded time &tau; (&plusmn; periods T)</label>
              <div class="sp-range__row"><input type="number" class="field-input sp-rnum" id="pn-taurange" value="1.5" step="0.5" min="0.5"></div>
              <div class="sp-range__head" style="margin-top:0.4rem">
                <label id="pn-zrange-label">Distance z (mm)</label>
                <button type="button" class="pn-zt-btn" id="pn-zt-btn" title="Plot up to the Talbot distance to see the whole carpet" aria-pressed="false">z<sub>T</sub></button>
              </div>
              <div class="sp-range__row"><input type="number" class="field-input sp-rnum" id="pn-zmax" value="5" step="0.5" min="0.1"></div>
              <label style="margin-top:0.4rem">Coherence length (nm, 0 = coherent)</label>
              <div class="sp-range__row"><input type="number" class="field-input sp-rnum" id="pn-coh" value="0" step="500" min="0"></div>
            </div>

            <div class="sp-range" id="pn-range-billiard" hidden>
              <label>Coupling axis |g|: 0 to</label>
              <div class="sp-range__row"><input type="number" class="field-input sp-rnum" id="pn-gmax" value="6" step="0.5" min="1"></div>
            </div>

            <details class="pn-adv">
              <summary>Numerics</summary>
              <div class="sp-range">
                <label>Sidebands retained n<sub>max</sub></label>
                <div class="sp-range__row"><input type="number" class="field-input sp-rnum" id="pn-nmax" value="40" step="5" min="10" max="120"></div>
                <label style="margin-top:0.4rem">Dispersion</label>
                <div class="sp-unit-toggle" id="pn-method" role="radiogroup" aria-label="Dispersion model">
                  <button type="button" data-dm="exact" class="active" aria-pressed="true">exact</button>
                  <button type="button" data-dm="talbot" aria-pressed="false">Talbot</button>
                </div>
              </div>
            </details>
          </div>
          </ParamsDrawer>

          <!-- ===== Results ===== -->
          <div class="sp-results-col">
            <div class="sp-view-tabs" id="pn-view-tabs" role="tablist" aria-label="View">
              <button type="button" class="sp-view-tab active" data-view="spectrum" role="tab" aria-selected="true">Spectrum</button>
              <button type="button" class="sp-view-tab" data-view="billiard" role="tab" aria-selected="false">Billiard</button>
            </div>

            <div class="result-panel card sp-result-card" id="pn-result-card">
              <div class="sp-sub-tabs" id="pn-sub-tabs" role="tablist" aria-label="Sub-view"></div>
              <div class="sp-chart-head">
                <div class="sp-chart-title" id="pn-chart-title">&mdash;</div>
              </div>
              <div class="chart-wrap sp-chart-wrap"><canvas id="pn-chart" aria-label="PINEM result plot"></canvas><div class="sp-map-tt" id="pn-map-tt" hidden></div></div>
              <div class="sp-readout" id="pn-readout"></div>
              <div class="sp-export-bar">
                <button type="button" class="tool-btn" id="pn-export-png" title="Download the plot as PNG">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                  PNG
                </button>
                <button type="button" class="tool-btn" id="pn-export-csv" title="Download the plotted data as CSV">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                  CSV
                </button>
              </div>
            </div>

            <!-- Attosecond-pulse metrics -->
            <div class="pn-metrics card" id="pn-metrics">
              <div class="pn-metrics__grid" id="pn-metrics-grid"></div>
            </div>

            <div class="notes-card card" id="pn-notes">
              <h4>Notes</h4>
              <p>
                <strong>PINEM</strong>&nbsp;[1]. An optical near field of amplitude set by the complex coupling
                <em>g</em> imprints a phase on a swift electron, splitting it into a comb of energy
                sidebands spaced by the photon energy &#8463;&omega;. In the quantum treatment&nbsp;[2] the
                populations are Bessel: P<sub>N</sub>&nbsp;=&nbsp;J<sub>N</sub>(2|g|)<sup>2</sup>, with
                2|g| the Rabi phase&nbsp;[3].
              </p>
              <p>
                <strong>Spectrum</strong> selects a single |g|: <em>Probability</em> shows the bare
                P<sub>N</sub>, <em>EELS</em> broadens them by a Lorentzian of width &Gamma;, and
                <em>Propagation</em> shows the co-moving density &rho;(z,&tau;) reshaping into an
                attosecond pulse train.
              </p>
              <p>
                <strong>Billiard</strong> maps P<sub>N</sub> versus the
                coupling |g| (the multilevel Rabi / quantum-walk map).
              </p>
              <div class="sp-examples">
                <button type="button" class="sp-example" id="pn-ex-1" aria-pressed="false">
                  <span class="sp-example__head">Example &mdash; Feist et al. attosecond train</span>
                  <span class="sp-example__params">120&nbsp;keV (v/c&nbsp;=&nbsp;0.587) &middot; &lambda;&nbsp;=&nbsp;800&nbsp;nm (&#8463;&omega;&nbsp;=&nbsp;1.55&nbsp;eV) &middot; |g|&nbsp;=&nbsp;5.7 &middot; Propagation 0&ndash;5&nbsp;mm</span>
                  <span class="sp-example__hint">Click to load and show the pulse-train focus near z&nbsp;&approx;&nbsp;1.8&nbsp;mm &rarr;</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="references card">
          <h4>References</h4>
          <ul class="reference-list">
            <li><span class="ref-index">[1]</span><span>B. Barwick, D. J. Flannigan &amp; A. H. Zewail, <em>Photon-induced near-field electron microscopy</em>, Nature <strong>462</strong>, 902&ndash;906 (2009), <a href="https://doi.org/10.1038/nature08662" target="_blank" rel="noopener">doi:10.1038/nature08662</a>.</span></li>
            <li><span class="ref-index">[2]</span><span>F. J. Garc&iacute;a de Abajo, A. Asenjo-Garcia &amp; M. Kociak, <em>Multiphoton absorption and emission by interaction of swift electrons and photons in a near field</em>, Nano Letters <strong>10</strong>, 1859&ndash;1863 (2010), <a href="https://doi.org/10.1021/nl100613s" target="_blank" rel="noopener">doi:10.1021/nl100613s</a>.</span></li>
            <li><span class="ref-index">[3]</span><span>A. Feist, K. E. Echternkamp, J. Schauss, S. V. Yalunin, S. Sch&auml;fer &amp; C. Ropers, <em>Quantum coherent optical phase modulation in an ultrafast transmission electron microscope</em>, Nature <strong>521</strong>, 200&ndash;203 (2015), <a href="https://doi.org/10.1038/nature14463" target="_blank" rel="noopener">doi:10.1038/nature14463</a>.</span></li>
          </ul>
        </div>
      </div><!-- /#panel-pinem -->
    </div>
  </section>
