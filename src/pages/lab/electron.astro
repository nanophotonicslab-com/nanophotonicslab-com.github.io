            <li><span class="ref-index">[1]</span><span>R. H. Ritchie &amp; H. B. Eldridge, <em>Optical emission from irradiated foils. I</em>, Phys. Rev. <strong>126</strong>, 1935 (1962), <a href="https://doi.org/10.1103/PhysRev.126.1935" target="_blank" rel="noopener">doi:10.1103/PhysRev.126.1935</a>.</span></li>
            <li><span class="ref-index">[2]</span><span>F. J. Garc&iacute;a de Abajo, <em>Optical excitations in electron microscopy</em>, Rev. Mod. Phys. <strong>82</strong>, 209 (2010), <a href="https://doi.org/10.1103/RevModPhys.82.209" target="_blank" rel="noopener">doi:10.1103/RevModPhys.82.209</a>.</span></li>
            <li><span class="ref-index">[3]</span><span>B. J. M. Brenny, <em>Probing light emission at the nanoscale with cathodoluminescence</em>, PhD thesis, University of Amsterdam / AMOLF (2016), ch. 3&ndash;5.</span></li>
            <li><span class="ref-index">[4]</span><span>S. Ebel, M. N&oslash;rgaard, C. Nicolaisen Hansen, N. A. Mortensen &amp; S. Morozov, <em>Velocity-tunable exciton&ndash;photon hybridization in cathodoluminescence</em>, Adv. Funct. Mater. <strong>36</strong>, e76737 (2026), <a href="https://doi.org/10.1002/adfm.76737" target="_blank" rel="noopener">doi:10.1002/adfm.76737</a>.</span></li>
            <li><span class="ref-index">[5]</span><span>V. L. Ginzburg &amp; I. M. Frank, <em>Radiation of a uniformly moving electron due to its transition from one medium into another</em>, J. Phys. USSR <strong>9</strong>, 353 (1945).</span></li>
          </ul>
