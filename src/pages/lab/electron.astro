      const hdr = ['E_eV', 'lambda_nm', ...comps.flatMap(([, l]) => [`Re_${l}`, `Im_${l}`, `abs_${l}`])].join(',');
      const rows = A.eV.map((e, i) => [p6(e), p6(wavelengthNmFromEV(e)), ...comps.flatMap(([k]) => { const z = (A[k] as Cpx[])[i]; return [p6(z.re), p6(z.im), p6(cabs(z))]; })].join(','));
