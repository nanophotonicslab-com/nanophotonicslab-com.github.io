    return { eV: recs.map(p => p.eV), ax: recs.map(p => p.ax), ay: recs.map(p => p.ay), az: recs.map(p => p.az), label: `${pendingName || 'pasted'} · ${recs.length} pts` };
  }
  function drawAlphaPreview(a: AlphaData, canvasId = 'sp-alpha-preview') {
