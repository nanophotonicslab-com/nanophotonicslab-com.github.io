  const unitVec = (v: Vec3c): Vec3c => { const n = Math.sqrt(cabs(v[0]) ** 2 + cabs(v[1]) ** 2 + cabs(v[2]) ** 2); return n > 1e-300 ? (v.map(z => ({ re: z.re / n, im: z.im / n })) as Vec3c) : [c(0, 0), c(0, 0), c(0, 0)]; };
  // Always reflect the dipole in use: editable for Custom, read-only computed value otherwise.
  function updateDipoleDisplay() {
