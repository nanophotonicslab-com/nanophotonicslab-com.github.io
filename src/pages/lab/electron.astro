  // Read the lab's 2D (nonlinear-plasmonics) controls and compute the linear α(1,1) spectrum via the nl-graphene lib
  function computePlas2D(doc: Document): AlphaData | { error: string } {
    const gv = (id: string) => { const el = doc.getElementById(id) as HTMLInputElement | HTMLSelectElement | null; return el ? el.value : ''; };
    const gnum = (id: string, d: number) => { const v = parseFloat(gv(id)); return Number.isFinite(v) ? v : d; };
