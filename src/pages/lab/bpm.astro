---
import Layout from '../../layouts/Layout.astro';
import ModelInfo from '../../components/ModelInfo.astro';
import ToolMeta from '../../components/ToolMeta.astro';
import ParamsDrawer from '../../components/ParamsDrawer.astro';
import '../../styles/lab.css';
---

<Layout title="Beam Propagation Method" description="Simulate light propagation in waveguides using the Crank-Nicolson paraxial wave equation solver. Interactive 2D intensity heatmap with preset demo tasks.">
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Beam Propagation <span class="gradient-text">Method</span></h1>
      <p class="widget-hero__subtitle">
        Paraxial wave equation solved with the Crank&ndash;Nicolson scheme.
        Launch a Gaussian beam into a step-index waveguide and watch the
        intensity evolve along the propagation axis.
      </p>
      <ToolMeta slug="bpm" name="Beam Propagation Method" />
    </div>
  </section>

  <ModelInfo status="Beta">
    <dl>
      <dt>Model</dt>
      <dd>Paraxial scalar beam propagation method (BPM). The paraxial Helmholtz equation is solved with a Crank&ndash;Nicolson finite-difference scheme — unconditionally stable and second-order accurate.</dd>
      <dt>Assumptions</dt>
      <dd>Paraxial approximation (small angles relative to the propagation axis), scalar field (no polarization), 2D cross-section (x&ndash;z plane), step-index waveguide profiles.</dd>
      <dt>Validity</dt>
      <dd>Accurate for weakly guiding structures and beam propagation angles below ~15&deg;. Not valid for high-contrast waveguides, backward reflections, or resonant cavities.</dd>
      <dt>Limitations</dt>
      <dd>No vectorial effects, no backward-propagating waves, no nonlinear media. Absorbing boundary conditions (quadratic imaginary-n ramp) may introduce small artifacts near the window edges.</dd>
      <dt>References</dt>
      <dd>K. Okamoto, <em>Fundamentals of Optical Waveguides</em>, 2nd ed. (Academic Press, 2006), Chapter 7.</dd>
    </dl>
  </ModelInfo>

  <section class="section">
    <div class="container">
      <div class="widget-layout">
        <!-- ===== Controls ===== -->
        <ParamsDrawer>
        <div class="controls card">
          <h3>Parameters</h3>

          <!-- Preset tasks -->
          <div class="param">
            <div class="param-header"><label>Presets</label></div>
            <div class="preset-row" id="presets">
              <button class="preset-btn active" data-task="1">Single-mode</button>
              <button class="preset-btn" data-task="2">Mode beating</button>
              <button class="preset-btn" data-task="3">Multimode</button>
              <button class="preset-btn" data-task="4">Coupler</button>
            </div>
          </div>

          <!-- Propagation -->
          <div class="param-group">
            <span class="param-group__title">Propagation</span>
            <div class="fields">
              <div class="field">
                <label for="p-z">z [&mu;m]</label>
                <input type="text" class="field-input" id="p-z" inputmode="decimal">
              </div>
              <div class="field">
                <label for="p-dz">dz</label>
                <input type="text" class="field-input" id="p-dz" inputmode="decimal">
              </div>
              <div class="field">
                <label for="p-delta">&delta; (subsample)</label>
                <input type="text" class="field-input" id="p-delta" inputmode="decimal">
              </div>
            </div>
          </div>

          <!-- Beam -->
          <div class="param-group">
            <span class="param-group__title">Beam</span>
            <div class="fields">
              <div class="field">
                <label for="p-lambda">&lambda; [&mu;m]</label>
                <input type="text" class="field-input" id="p-lambda" inputmode="decimal">
              </div>
              <div class="field">
                <label for="p-w">w (waist) [&mu;m]</label>
                <input type="text" class="field-input" id="p-w" inputmode="decimal">
              </div>
              <div class="field">
                <label for="p-nd">n<sub>d</sub> (char. index)</label>
                <input type="text" class="field-input" id="p-nd" inputmode="decimal">
              </div>
            </div>
          </div>

          <!-- Grid -->
          <div class="param-group">
            <span class="param-group__title">Grid</span>
            <div class="fields">
              <div class="field">
                <label for="p-Nx">N<sub>x</sub> (intervals)</label>
                <input type="text" class="field-input" id="p-Nx" inputmode="decimal">
              </div>
              <div class="field">
                <label for="p-xa">x<sub>a</sub> (window) [&mu;m]</label>
                <input type="text" class="field-input" id="p-xa" inputmode="decimal">
              </div>
            </div>
          </div>

          <!-- Waveguide -->
          <div class="param-group">
            <span class="param-group__title">Waveguide</span>
            <div class="fields">
              <div class="field">
                <label for="p-xb">x<sub>b</sub> (width) [&mu;m]</label>
                <input type="text" class="field-input" id="p-xb" inputmode="decimal">
              </div>
              <div class="field">
                <label for="p-nclad">n<sub>clad</sub></label>
                <input type="text" class="field-input" id="p-nclad" inputmode="decimal">
              </div>
              <div class="field">
                <label for="p-ncore">n<sub>core</sub></label>
                <input type="text" class="field-input" id="p-ncore" inputmode="decimal">
              </div>
            </div>
          </div>

          <!-- Coupler params (only visible for preset 4) -->
          <div class="param-group" id="group-coupler" style="display:none">
            <span class="param-group__title">Coupler</span>
            <div class="fields">
              <div class="field">
                <label for="p-gap">Gap [&mu;m]</label>
                <input type="text" class="field-input" id="p-gap" inputmode="decimal" value="2">
              </div>
              <div class="field">
                <label for="p-ncore2">n<sub>core,2</sub></label>
                <input type="text" class="field-input" id="p-ncore2" inputmode="decimal" value="1.46" title="Second waveguide core index (leave equal to n_core for symmetric coupler)">
              </div>
              <div class="field">
                <label for="p-xb2">x<sub>b,2</sub> [&mu;m]</label>
                <input type="text" class="field-input" id="p-xb2" inputmode="decimal" value="2" title="Second waveguide width (equal to x_b for symmetric coupler)">
              </div>
            </div>
          </div>

          <!-- Boundary conditions -->
          <div class="param-group">
            <span class="param-group__title">Boundary conditions</span>
            <div class="fields">
              <div class="field">
                <label for="p-bc">Type</label>
                <select class="field-input" id="p-bc">
                  <option value="none">None (reflecting)</option>
                  <option value="absorbing" selected>Absorbing</option>
                </select>
              </div>
              <div class="field" id="field-bc-width">
                <label for="p-bcw">Width [%]</label>
                <input type="text" class="field-input" id="p-bcw" inputmode="decimal" value="10">
              </div>
              <div class="field" id="field-bc-strength">
                <label for="p-bca">&alpha;<sub>max</sub></label>
                <input type="text" class="field-input" id="p-bca" inputmode="decimal" value="0.05">
              </div>
            </div>
          </div>

          <button class="run-btn" id="run-btn" data-umami-event="bpm-run">Run simulation</button>

          <p class="theory-note">
            <strong>Crank&ndash;Nicolson BPM.</strong>
            Solves the paraxial Helmholtz equation
            &part;<sub>z</sub>u&nbsp;=&nbsp;(i/2k<sub>m</sub>)&thinsp;(&part;<sup>2</sup><sub>x</sub>u&nbsp;+&nbsp;(k&sup2;&minus;k<sub>m</sub>&sup2;)&thinsp;u)
            with a second-order implicit scheme that is unconditionally stable.
            Absorbing BCs add a quadratic imaginary-n ramp at the window edges to damp outgoing waves.
          </p>
        </div>
        </ParamsDrawer>

        <!-- ===== Heatmap ===== -->
        <div class="chart-panel card">
          <div class="chart-header">
            <span class="chart-title">Intensity |v(x,z)|&sup2;</span>
            <span class="chart-header__right">
              <button id="dl-png" class="share-btn" title="Download heatmap as PNG" data-umami-event="bpm-export" data-umami-event-format="png">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                PNG
              </button>
              <button id="dl-csv" class="share-btn" title="Download field data as CSV" data-umami-event="bpm-export" data-umami-event-format="csv">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                CSV
              </button>
              <button id="share-btn" class="share-btn" title="Copy shareable link to clipboard" data-umami-event="share" data-umami-event-page="bpm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                Share
              </button>
              <span class="chart-status" id="status"></span>
            </span>
          </div>
          <div class="chart-wrap" id="chart-wrap">
            <canvas id="bpm-canvas" aria-label="BPM intensity heatmap"></canvas>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>  .widget-layout { --sidebar-w: 280px; }
  @media (max-width: 900px) {
    .widget-layout { grid-template-columns: 1fr; }
  }</style>

<script>
  import { beampropCN, type BpmParams } from '../../lib/bpm';
  import { chartTheme, onThemeChange } from '../../lib/chart-theme';

  /* ---- Presets (from Matlab Tasks) ---- */
  const TASKS: Record<string, BpmParams> = {
    '1': { z: 100, dz: 0.005, nd: 1.455, lambda: 1, Nx: 200, w: 4, xa: 50, xb: 2, nCladding: 1.45, nCore: 1.46, delta: 200 },
    '2': { z: 300, dz: 0.005, nd: 1.455, lambda: 1, Nx: 200, w: 4, xa: 50, xb: 2, nCladding: 1.45, nCore: 1.46, delta: 200 },
    '3': { z: 500, dz: 0.005, nd: 1.455, lambda: 1, Nx: 200, w: 2, xa: 50, xb: 8, nCladding: 1.45, nCore: 1.46, delta: 200 },
    '4': { z: 1500, dz: 0.01, nd: 1.455, lambda: 1, Nx: 300, w: 2, xa: 30, xb: 2, nCladding: 1.45, nCore: 1.46, delta: 200 },
  };

  /* ---- DOM refs ---- */
  const ids = ['p-z','p-dz','p-delta','p-lambda','p-w','p-nd','p-Nx','p-xa','p-xb','p-nclad','p-ncore'] as const;
  const inputs = Object.fromEntries(ids.map(id => [id, document.getElementById(id) as HTMLInputElement]));
  const bcSelect = document.getElementById('p-bc') as HTMLSelectElement;
  const bcWidthInput = document.getElementById('p-bcw') as HTMLInputElement;
  const bcStrengthInput = document.getElementById('p-bca') as HTMLInputElement;
  const canvas = document.getElementById('bpm-canvas') as HTMLCanvasElement;
  const statusEl = document.getElementById('status')!;
  const runBtn = document.getElementById('run-btn') as HTMLButtonElement;

  /* ---- Read / write params ---- */
  function readParams(): BpmParams {
    const bcType = (bcSelect.value as 'none' | 'absorbing') || 'absorbing';
    return {
      z:         parseFloat(inputs['p-z'].value)     || 100,
      dz:        parseFloat(inputs['p-dz'].value)    || 0.005,
      delta:     parseInt(inputs['p-delta'].value)    || 200,
      lambda:    parseFloat(inputs['p-lambda'].value) || 1,
      w:         parseFloat(inputs['p-w'].value)      || 4,
      nd:        parseFloat(inputs['p-nd'].value)     || 1.455,
      Nx:        parseInt(inputs['p-Nx'].value)       || 200,
      xa:        parseFloat(inputs['p-xa'].value)     || 50,
      xb:        parseFloat(inputs['p-xb'].value)     || 2,
      nCladding: parseFloat(inputs['p-nclad'].value)  || 1.45,
      nCore:     parseFloat(inputs['p-ncore'].value)  || 1.46,
      bcType,
      bcWidthFrac: (parseFloat(bcWidthInput.value) || 10) / 100,
      bcStrength:  parseFloat(bcStrengthInput.value) || 0.05,
    };
  }

  function writeParams(p: BpmParams) {
    inputs['p-z'].value     = String(p.z);
    inputs['p-dz'].value    = String(p.dz);
    inputs['p-delta'].value = String(p.delta);
    inputs['p-lambda'].value= String(p.lambda);
    inputs['p-w'].value     = String(p.w);
    inputs['p-nd'].value    = String(p.nd);
    inputs['p-Nx'].value    = String(p.Nx);
    inputs['p-xa'].value    = String(p.xa);
    inputs['p-xb'].value    = String(p.xb);
    inputs['p-nclad'].value = String(p.nCladding);
    inputs['p-ncore'].value = String(p.nCore);
  }

  /** Build dual-waveguide coupler profile from UI params. */
  function applyCouplerProfile(p: BpmParams): BpmParams {
    const { xa, xb, Nx, nCladding, nCore } = p;
    const gap = parseFloat((document.getElementById('p-gap') as HTMLInputElement).value) || 2;
    const nCore2 = parseFloat((document.getElementById('p-ncore2') as HTMLInputElement).value) || nCore;
    const xb2 = parseFloat((document.getElementById('p-xb2') as HTMLInputElement).value) || xb;
    // Place each waveguide so their inner edges sit ±gap/2 from the origin.
    const center1 = -(gap / 2 + xb / 2);   // left waveguide, width xb, core nCore
    const center2 =  (gap / 2 + xb2 / 2);  // right waveguide, width xb2, core nCore2
    const nProfile = new Float64Array(Nx);
    for (let i = 0; i < Nx; i++) {
      const x = -xa / 2 + (xa * i) / (Nx - 1);
      if (x >= center1 - xb / 2 && x <= center1 + xb / 2)        nProfile[i] = nCore;
      else if (x >= center2 - xb2 / 2 && x <= center2 + xb2 / 2) nProfile[i] = nCore2;
      else                                                        nProfile[i] = nCladding;
    }
    const boundaries = [center1 - xb / 2, center1 + xb / 2, center2 - xb2 / 2, center2 + xb2 / 2];
    return { ...p, nProfile, beamOffset: center1, boundaries };
  }

  function isCouplerActive(): boolean {
    const active = document.querySelector('#presets .preset-btn.active') as HTMLButtonElement | null;
    return active?.dataset.task === '4';
  }

  function updateCouplerVisibility() {
    const group = document.getElementById('group-coupler') as HTMLElement;
    group.style.display = isCouplerActive() ? '' : 'none';
  }

  /* ---- Presets ---- */
  document.getElementById('presets')!.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('.preset-btn') as HTMLButtonElement | null;
    if (!btn) return;
    document.querySelectorAll('#presets .preset-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const task = btn.dataset.task!;
    writeParams(TASKS[task]);
    updateCouplerVisibility();
    runSimulation();
  });

  // Re-run when any coupler param changes
  ['p-gap', 'p-ncore2', 'p-xb2'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', () => {
      if (isCouplerActive()) runSimulation();
    });
  });

  /* ---- Inferno colormap ---- */
  const INFERNO: [number,number,number][] = [
    [0,0,4],[40,11,84],[101,21,110],[159,42,99],
    [212,72,66],[245,125,21],[250,193,39],[252,255,164],
  ];
  function inferno(t: number): [number,number,number] {
    t = Math.max(0, Math.min(1, t));
    const s = t * (INFERNO.length - 1);
    const i = Math.floor(s), f = s - i;
    const a = INFERNO[i], b = INFERNO[Math.min(i + 1, INFERNO.length - 1)];
    return [a[0]+f*(b[0]-a[0]), a[1]+f*(b[1]-a[1]), a[2]+f*(b[2]-a[2])];
  }

  /* ---- Draw heatmap ---- */
  function drawHeatmap() {
    if (!lastResult) return;
    const res = lastResult;
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    const fs = Math.max(0.7, Math.min(1, W / 600));

    // Clear
    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, W, H);

    // Margins
    const ml = 52 * fs, mr = 60 * fs, mt = 14 * fs, mb = 38 * fs;
    const pw = W - ml - mr;
    const ph = H - mt - mb;
    if (pw < 10 || ph < 10) return;

    // Render field pixels
    const imgW = Math.round(pw * dpr);
    const imgH = Math.round(ph * dpr);
    const imgData = ctx.createImageData(imgW, imgH);
    const invMax = res.maxVal > 0 ? 1 / res.maxVal : 1;

    for (let py = 0; py < imgH; py++) {
      // y-axis: top = xMax, bottom = xMin (like imagesc with 'Normal' Ydir)
      const iy = Math.round((1 - py / (imgH - 1)) * (res.Nx - 1));
      for (let px = 0; px < imgW; px++) {
        const iz = Math.round(px * (res.Nz - 1) / (imgW - 1));
        const val = res.field[iz * res.Nx + iy];
        const t = val * invMax;
        const [r, g, b] = inferno(t);
        const off = (py * imgW + px) * 4;
        imgData.data[off]     = r;
        imgData.data[off + 1] = g;
        imgData.data[off + 2] = b;
        imgData.data[off + 3] = 255;
      }
    }
    ctx.putImageData(imgData, ml * dpr, mt * dpr);

    // Waveguide boundaries (dashed white lines)
    ctx.save();
    ctx.setLineDash([4 * fs, 3 * fs]);
    ctx.strokeStyle = 'rgba(255,255,255,0.7)';
    ctx.lineWidth = 1;
    const xRange = res.xMax - res.xMin;
    const bLines = res.boundaries ?? [-res.xb / 2, res.xb / 2];
    for (const bx of bLines) {
      const y = mt + ph * (1 - (bx - res.xMin) / xRange);
      ctx.beginPath(); ctx.moveTo(ml, y); ctx.lineTo(ml + pw, y); ctx.stroke();
    }
    ctx.restore();

    // Axes
    ctx.font = `${11 * fs}px ${getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif'}`;
    ctx.fillStyle = ct.textSoft;
    ctx.textAlign = 'center';

    // z-axis ticks
    const nzTicks = 5;
    for (let i = 0; i <= nzTicks; i++) {
      const frac = i / nzTicks;
      const xPos = ml + frac * pw;
      const zVal = frac * res.zMax;
      ctx.fillText(zVal.toFixed(0), xPos, mt + ph + 14 * fs);
      ctx.fillStyle = ct.grid;
      ctx.fillRect(xPos, mt, 1, ph);
      ctx.fillStyle = ct.textSoft;
    }
    // z label
    ctx.font = `${12 * fs}px ${getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif'}`;
    ctx.fillText('z [\u00b5m]', ml + pw / 2, mt + ph + 30 * fs);

    // x-axis ticks
    ctx.textAlign = 'right';
    ctx.font = `${11 * fs}px ${getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif'}`;
    const nxTicks = 5;
    for (let i = 0; i <= nxTicks; i++) {
      const frac = i / nxTicks;
      const yPos = mt + frac * ph;
      const xVal = res.xMax - frac * xRange;
      ctx.fillStyle = ct.textSoft;
      ctx.fillText(xVal.toFixed(0), ml - 6 * fs, yPos + 4 * fs);
    }
    // x label
    ctx.save();
    ctx.translate(12 * fs, mt + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.font = `${12 * fs}px ${getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif'}`;
    ctx.fillStyle = ct.textSoft;
    ctx.fillText('x [\u00b5m]', 0, 0);
    ctx.restore();

    // Colorbar
    const cbW = 10 * fs, cbGap = 8 * fs;
    const cbX = ml + pw + cbGap;
    const cbH = ph * 0.8;
    const cbY = mt + (ph - cbH) / 2;
    for (let i = 0; i < cbH; i++) {
      const t = 1 - i / cbH;
      const [r, g, b] = inferno(t);
      ctx.fillStyle = `rgb(${r},${g},${b})`;
      ctx.fillRect(cbX, cbY + i, cbW, 1);
    }
    ctx.strokeStyle = ct.textMuted;
    ctx.lineWidth = 0.5;
    ctx.strokeRect(cbX, cbY, cbW, cbH);

    // Colorbar labels
    ctx.fillStyle = ct.textSoft;
    ctx.textAlign = 'left';
    ctx.font = `${10 * fs}px ${getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif'}`;
    ctx.fillText(res.maxVal.toFixed(2), cbX + cbW + 3 * fs, cbY + 4 * fs);
    ctx.fillText('0', cbX + cbW + 3 * fs, cbY + cbH + 1 * fs);
  }

  /* ---- Simulation runner ---- */
  let lastResult: ReturnType<typeof beampropCN> | null = null;

  function runSimulation() {
    let p = readParams();
    if (isCouplerActive()) p = applyCouplerProfile(p);
    const totalSteps = Math.round(p.z / p.dz);

    // Validate
    if (p.Nx < 10 || p.Nx > 2048) { statusEl.textContent = 'Nx must be 10\u20132048'; return; }
    if (totalSteps > 2_000_000) { statusEl.textContent = 'Too many steps (reduce z or increase dz)'; return; }
    if (totalSteps < 1) { statusEl.textContent = 'z/dz must yield at least 1 step'; return; }

    statusEl.textContent = `Computing ${totalSteps.toLocaleString()} steps\u2026`;
    runBtn.disabled = true;

    // Defer to next frame to let status update render
    requestAnimationFrame(() => {
      const t0 = performance.now();
      lastResult = beampropCN(p);
      const dt = performance.now() - t0;
      statusEl.textContent = `${lastResult.Nz} \u00d7 ${lastResult.Nx} px \u2014 ${dt < 1000 ? dt.toFixed(0) + ' ms' : (dt/1000).toFixed(1) + ' s'}`;
      runBtn.disabled = false;
      drawHeatmap();
    });
  }

  /* ---- Run button ---- */
  runBtn.addEventListener('click', () => {
    runSimulation();
  });

  /* ---- Theme change ---- */
  onThemeChange(drawHeatmap);
  window.addEventListener('resize', drawHeatmap);

  /* ---- Export ---- */
  import { downloadBlob } from '../../lib/download';

  document.getElementById('dl-png')!.addEventListener('click', () => {
    if (!lastResult) return;
    // Render at 2× for high-res export
    const w = 1200, h = 720, s = 2;
    const ec = document.createElement('canvas');
    ec.width = w * s; ec.height = h * s;
    const origGetRect = canvas.getBoundingClientRect.bind(canvas);
    const fakeRect = { width: w, height: h, top: 0, left: 0, right: w, bottom: h, x: 0, y: 0, toJSON() { return this; } };
    canvas.getBoundingClientRect = () => fakeRect as DOMRect;
    const origW = canvas.width, origH = canvas.height;
    canvas.width = w * s; canvas.height = h * s;
    drawHeatmap();
    ec.getContext('2d')!.drawImage(canvas, 0, 0);
    canvas.getBoundingClientRect = origGetRect;
    canvas.width = origW; canvas.height = origH;
    drawHeatmap();
    ec.toBlob(b => { if (b) downloadBlob(b, 'bpm_heatmap.png'); }, 'image/png');
  });

  document.getElementById('dl-csv')!.addEventListener('click', () => {
    if (!lastResult) return;
    const res = lastResult;
    const p = readParams();
    const lines = [
      `# BPM intensity — z=${p.z}µm, λ=${p.lambda}µm, Nx=${p.Nx}, nCore=${p.nCore}, nClad=${p.nCladding}`,
      '# Generated by NanophotonicsLab (nanophotonicslab.com)',
      '# Rows: z positions, Columns: x positions',
      '# First row is x coordinates (µm), first column is z coordinates (µm)',
    ];
    // Header row: x values
    const xVals: number[] = [];
    for (let j = 0; j < res.Nx; j++) xVals.push(res.xMin + j * (res.xMax - res.xMin) / (res.Nx - 1));
    lines.push('z_um,' + xVals.map(x => x.toFixed(4)).join(','));
    // Data rows
    const dzOut = res.zMax / (res.Nz - 1);
    for (let iz = 0; iz < res.Nz; iz++) {
      const zVal = (iz * dzOut).toFixed(4);
      const row = new Array(res.Nx);
      for (let j = 0; j < res.Nx; j++) row[j] = res.field[iz * res.Nx + j].toExponential(6);
      lines.push(zVal + ',' + row.join(','));
    }
    downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), 'bpm_field.csv');
  });

  /* ---- Share / URL State ---- */
  function serializeState(): string {
    const p = new URLSearchParams();
    const activePreset = document.querySelector('#presets .preset-btn.active') as HTMLButtonElement | null;
    if (activePreset?.dataset.task) p.set('task', activePreset.dataset.task);
    const params = readParams();
    p.set('z', String(params.z));
    p.set('dz', String(params.dz));
    p.set('delta', String(params.delta));
    p.set('lam', String(params.lambda));
    p.set('w', String(params.w));
    p.set('nd', String(params.nd));
    p.set('Nx', String(params.Nx));
    p.set('xa', String(params.xa));
    p.set('xb', String(params.xb));
    p.set('nclad', String(params.nCladding));
    p.set('ncore', String(params.nCore));
    p.set('bc', bcSelect.value);
    p.set('bcw', bcWidthInput.value);
    p.set('bca', bcStrengthInput.value);
    if (isCouplerActive()) {
      p.set('gap', (document.getElementById('p-gap') as HTMLInputElement).value);
      p.set('nc2', (document.getElementById('p-ncore2') as HTMLInputElement).value);
      p.set('xb2', (document.getElementById('p-xb2') as HTMLInputElement).value);
    }
    return p.toString();
  }

  function restoreState(): boolean {
    const hash = location.hash.slice(1);
    if (!hash) return false;
    const p = new URLSearchParams(hash);
    if (!p.has('z')) return false;
    const task = p.get('task');
    if (task) {
      const btn = document.querySelector(`#presets .preset-btn[data-task="${task}"]`) as HTMLButtonElement | null;
      if (btn) {
        document.querySelectorAll('#presets .preset-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      }
    } else {
      document.querySelectorAll('#presets .preset-btn').forEach(b => b.classList.remove('active'));
    }
    writeParams({
      z:         parseFloat(p.get('z')!)     || 100,
      dz:        parseFloat(p.get('dz')!)    || 0.005,
      delta:     parseInt(p.get('delta')!)    || 200,
      lambda:    parseFloat(p.get('lam')!)    || 1,
      w:         parseFloat(p.get('w')!)      || 4,
      nd:        parseFloat(p.get('nd')!)     || 1.455,
      Nx:        parseInt(p.get('Nx')!)       || 200,
      xa:        parseFloat(p.get('xa')!)     || 50,
      xb:        parseFloat(p.get('xb')!)     || 2,
      nCladding: parseFloat(p.get('nclad')!)  || 1.45,
      nCore:     parseFloat(p.get('ncore')!)  || 1.46,
    });
    if (p.has('bc')) bcSelect.value = p.get('bc')!;
    if (p.has('bcw')) bcWidthInput.value = p.get('bcw')!;
    if (p.has('bca')) bcStrengthInput.value = p.get('bca')!;
    if (p.has('gap')) (document.getElementById('p-gap') as HTMLInputElement).value = p.get('gap')!;
    if (p.has('nc2')) (document.getElementById('p-ncore2') as HTMLInputElement).value = p.get('nc2')!;
    if (p.has('xb2')) (document.getElementById('p-xb2') as HTMLInputElement).value = p.get('xb2')!;
    updateBcVisibility();
    updateCouplerVisibility();
    return true;
  }

  function updateBcVisibility() {
    const show = bcSelect.value !== 'none';
    (document.getElementById('field-bc-width') as HTMLElement).style.display = show ? '' : 'none';
    (document.getElementById('field-bc-strength') as HTMLElement).style.display = show ? '' : 'none';
  }
  bcSelect.addEventListener('change', updateBcVisibility);

  const shareBtn = document.getElementById('share-btn')!;
  shareBtn.addEventListener('click', () => {
    const url = location.origin + location.pathname + '#' + serializeState();
    navigator.clipboard.writeText(url).then(() => {
      shareBtn.textContent = 'Copied!';
      setTimeout(() => {
        shareBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> Share';
      }, 1500);
    });
  });

  /* ---- Init ---- */
  if (!restoreState()) {
    writeParams(TASKS['1']);
  }
  updateCouplerVisibility();
  runSimulation();
</script>
