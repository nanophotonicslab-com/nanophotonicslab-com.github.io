<script>
  import { chartTheme, onThemeChange } from '../../lib/chart-theme';

  interface SolveResult {
    wavelengths: number[];
    R: number[];
    T: number[];
  }

  const canvas = document.getElementById('rt-canvas') as HTMLCanvasElement;
  const statusEl = document.getElementById('status')!;
  const runBtn = document.getElementById('run-btn') as HTMLButtonElement;
  const progressFill = document.getElementById('progress-fill')!;

  let lastResult: SolveResult | null = null;
  let workerReady = false;

  const getNum = (id: string, def: number): number => {
    const v = parseFloat((document.getElementById(id) as HTMLInputElement).value);
    return isFinite(v) ? v : def;
  };
  const getInt = (id: string, def: number): number => {
    const v = parseInt((document.getElementById(id) as HTMLInputElement).value);
    return isFinite(v) ? v : def;
  };

  function readParams() {
    const lmin = getNum('p-lmin', 400);
    const lmax = getNum('p-lmax', 1200);
    const npts = Math.max(2, getInt('p-npts', 60));
    const wavelengths: number[] = [];
    for (let i = 0; i < npts; i++) wavelengths.push(lmin + (lmax - lmin) * i / (npts - 1));
    return {
      period: getNum('p-period', 700),
      thickness: getNum('p-thickness', 300),
      ridgeWidth: getNum('p-width', 350),
      epsTop: [getNum('p-eps-top-re', 1), getNum('p-eps-top-im', 0)] as [number, number],
      epsRidge: [getNum('p-eps-ridge-re', 5.76), getNum('p-eps-ridge-im', 0)] as [number, number],
      epsGroove: [getNum('p-eps-groove-re', 1), getNum('p-eps-groove-im', 0)] as [number, number],
      epsSub: [getNum('p-eps-sub-re', 2.25), getNum('p-eps-sub-im', 0)] as [number, number],
      theta: getNum('p-theta', 0),
      polarization: (document.getElementById('p-pol') as HTMLSelectElement).value as 's' | 'p',
      numG: Math.max(3, getInt('p-numg', 25)),
      wavelengths,
    };
  }

  // ---- Presets ----
  const PRESETS: Record<string, Record<string, string>> = {
    dielectric: {
      'p-period': '700', 'p-thickness': '300', 'p-width': '350',
      'p-eps-top-re': '1.0', 'p-eps-top-im': '0',
      'p-eps-ridge-re': '12.25', 'p-eps-ridge-im': '0',  // Si ~ 3.5
      'p-eps-groove-re': '1.0', 'p-eps-groove-im': '0',
      'p-eps-sub-re': '2.25', 'p-eps-sub-im': '0',
    },
    metal: {
      'p-period': '500', 'p-thickness': '100', 'p-width': '250',
      'p-eps-top-re': '1.0', 'p-eps-top-im': '0',
      'p-eps-ridge-re': '-10', 'p-eps-ridge-im': '1.2',  // Au ~ 600nm
      'p-eps-groove-re': '1.0', 'p-eps-groove-im': '0',
      'p-eps-sub-re': '2.25', 'p-eps-sub-im': '0',
    },
  };

  document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const preset = PRESETS[btn.dataset.preset!];
      if (!preset) return;
      for (const [id, v] of Object.entries(preset)) {
        (document.getElementById(id) as HTMLInputElement).value = v;
      }
    });
  });

  // ---- Chart drawing ----
  function drawChart() {
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    const fs = Math.max(0.7, Math.min(1, W / 600));

    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, W, H);

    if (!lastResult || lastResult.wavelengths.length === 0) {
      ctx.fillStyle = ct.textMuted;
      ctx.textAlign = 'center';
      ctx.font = `${13 * fs}px ${getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif'}`;
      ctx.fillText('Configure grating parameters and click Solve', W / 2, H / 2);
      return;
    }

    const ml = 55 * fs, mr = 18 * fs, mt = 14 * fs, mb = 38 * fs;
    const pw = W - ml - mr;
    const ph = H - mt - mb;
    if (pw < 10 || ph < 10) return;

    const lams = lastResult.wavelengths;
    const lmin = Math.min(...lams), lmax = Math.max(...lams);
    const yMin = 0, yMax = 1;

    // Grid
    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 1;
    for (let i = 0; i <= 5; i++) {
      const y = mt + (i / 5) * ph;
      ctx.beginPath(); ctx.moveTo(ml, y); ctx.lineTo(ml + pw, y); ctx.stroke();
    }

    // Axes labels (y)
    ctx.fillStyle = ct.textSoft;
    ctx.textAlign = 'right';
    ctx.font = `${11 * fs}px ${getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif'}`;
    for (let i = 0; i <= 5; i++) {
      const y = mt + (i / 5) * ph;
      const val = yMax - (i / 5) * (yMax - yMin);
      ctx.fillText(val.toFixed(1), ml - 6 * fs, y + 4 * fs);
    }
    // y label
    ctx.save();
    ctx.translate(14 * fs, mt + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillText('R, T', 0, 0);
    ctx.restore();

    // x axis labels
    ctx.textAlign = 'center';
    const xTicks = 5;
    for (let i = 0; i <= xTicks; i++) {
      const frac = i / xTicks;
      const xPos = ml + frac * pw;
      const val = lmin + frac * (lmax - lmin);
      ctx.fillText(val.toFixed(0), xPos, mt + ph + 14 * fs);
    }
    ctx.font = `${12 * fs}px ${getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif'}`;
    ctx.fillText('Wavelength (nm)', ml + pw / 2, mt + ph + 30 * fs);

    // Plot R (blue) and T (amber) and R+T (dashed gray)
    const xOf = (l: number) => ml + ((l - lmin) / (lmax - lmin)) * pw;
    const yOf = (v: number) => mt + (1 - (v - yMin) / (yMax - yMin)) * ph;

    const drawLine = (vals: number[], color: string, dash: number[] = []) => {
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      ctx.setLineDash(dash);
      ctx.beginPath();
      for (let i = 0; i < lams.length; i++) {
        const x = xOf(lams[i]), y = yOf(vals[i]);
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.setLineDash([]);
    };

    const sum = lastResult.R.map((r, i) => r + lastResult!.T[i]);
    drawLine(sum, ct.textMuted, [3, 3]);
    drawLine(lastResult.R, '#3B82F6');
    drawLine(lastResult.T, '#F59E0B');

    // Legend
    const legendY = mt + 8 * fs;
    const legendX = ml + 14 * fs;
    ctx.font = `${11 * fs}px ${getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif'}`;
    ctx.textAlign = 'left';
    const lh = 16 * fs;

    ctx.strokeStyle = '#3B82F6'; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(legendX, legendY); ctx.lineTo(legendX + 20 * fs, legendY); ctx.stroke();
    ctx.fillStyle = ct.text;
    ctx.fillText('R (reflection)', legendX + 26 * fs, legendY + 3 * fs);

    ctx.strokeStyle = '#F59E0B';
    ctx.beginPath(); ctx.moveTo(legendX, legendY + lh); ctx.lineTo(legendX + 20 * fs, legendY + lh); ctx.stroke();
    ctx.fillText('T (transmission)', legendX + 26 * fs, legendY + lh + 3 * fs);

    ctx.strokeStyle = ct.textMuted;
    ctx.setLineDash([3, 3]);
    ctx.beginPath(); ctx.moveTo(legendX, legendY + 2 * lh); ctx.lineTo(legendX + 20 * fs, legendY + 2 * lh); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillText('R + T', legendX + 26 * fs, legendY + 2 * lh + 3 * fs);
  }

  // ---- Worker ----
  const worker = new Worker(new URL('../../scripts/rcwa/pyodide-worker.ts', import.meta.url), { type: 'classic' });

  worker.onmessage = (e) => {
    const msg = e.data;
    switch (msg.type) {
      case 'init-progress':
        statusEl.textContent = msg.stage;
        progressFill.style.width = `${msg.pct * 100}%`;
        break;
      case 'init-done':
        statusEl.textContent = 'Ready';
        progressFill.style.width = '0%';
        runBtn.disabled = false;
        runBtn.textContent = 'Solve';
        workerReady = true;
        break;
      case 'init-error':
        statusEl.textContent = `Init error: ${msg.error}`;
        runBtn.textContent = 'Init failed';
        break;
      case 'solve-progress': {
        const pct = msg.index / msg.total;
        progressFill.style.width = `${pct * 100}%`;
        statusEl.textContent = `λ = ${msg.wavelength.toFixed(0)} nm (${msg.index}/${msg.total})`;
        break;
      }
      case 'solve-result':
        lastResult = { wavelengths: msg.wavelengths, R: msg.R, T: msg.T };
        progressFill.style.width = '100%';
        statusEl.textContent = `${msg.wavelengths.length} points computed`;
        runBtn.disabled = false;
        runBtn.textContent = 'Solve';
        drawChart();
        setTimeout(() => { progressFill.style.width = '0%'; }, 800);
        break;
      case 'solve-error':
        statusEl.textContent = `Error: ${msg.error}`;
        runBtn.disabled = false;
        runBtn.textContent = 'Solve';
        break;
    }
  };

  runBtn.addEventListener('click', () => {
    if (!workerReady) return;
    const params = readParams();
    runBtn.disabled = true;
    runBtn.textContent = 'Solving…';
    progressFill.style.width = '0%';
    worker.postMessage({ type: 'solve', params });
  });

  // Export
  function downloadBlob(blob: Blob, fn: string) {
    const u = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = u; a.download = fn; a.click();
    URL.revokeObjectURL(u);
  }

  document.getElementById('dl-png')!.addEventListener('click', () => {
    if (!lastResult) return;
    canvas.toBlob(b => { if (b) downloadBlob(b, 'rcwa_spectrum.png'); }, 'image/png');
  });

  document.getElementById('dl-csv')!.addEventListener('click', () => {
    if (!lastResult) return;
    const p = readParams();
    const lines = [
      `# RCWA 1D grating — period=${p.period} nm, thickness=${p.thickness} nm, ridge width=${p.ridgeWidth} nm`,
      `# θ=${p.theta}°, polarization=${p.polarization}, harmonics=${p.numG}`,
      `# ε_top=${p.epsTop[0]}+${p.epsTop[1]}i, ε_ridge=${p.epsRidge[0]}+${p.epsRidge[1]}i, ε_groove=${p.epsGroove[0]}+${p.epsGroove[1]}i, ε_sub=${p.epsSub[0]}+${p.epsSub[1]}i`,
      '# Generated by NanophotonicsLab (nanophotonicslab.com)',
      'wavelength_nm,R,T,R+T',
    ];
    for (let i = 0; i < lastResult.wavelengths.length; i++) {
      const lam = lastResult.wavelengths[i];
      const R = lastResult.R[i];
      const T = lastResult.T[i];
      lines.push(`${lam.toFixed(4)},${R.toFixed(6)},${T.toFixed(6)},${(R+T).toFixed(6)}`);
    }
    downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), 'rcwa_spectrum.csv');
  });

  // Share button
  const shareBtn = document.getElementById('share-btn')!;
  function serializeState(): string {
    const ids = ['p-period','p-thickness','p-width','p-numg','p-theta','p-pol','p-lmin','p-lmax','p-npts',
      'p-eps-top-re','p-eps-top-im','p-eps-ridge-re','p-eps-ridge-im',
      'p-eps-groove-re','p-eps-groove-im','p-eps-sub-re','p-eps-sub-im'];
    const p = new URLSearchParams();
    for (const id of ids) {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
      if (el && el.value) p.set(id, el.value);
    }
    return p.toString();
  }
  function restoreState(): void {
    const hash = location.hash.slice(1);
    if (!hash) return;
    const p = new URLSearchParams(hash);
    for (const [id, v] of p.entries()) {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
      if (el) el.value = v;
    }
  }
  shareBtn.addEventListener('click', () => {
    const url = location.origin + location.pathname + '#' + serializeState();
    navigator.clipboard.writeText(url).then(() => {
      shareBtn.textContent = 'Copied!';
      setTimeout(() => {
        shareBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> Share';
      }, 1500);
    });
  });

  // Init
  restoreState();
  drawChart();
  new ResizeObserver(drawChart).observe(canvas);
  onThemeChange(drawChart);
  worker.postMessage({ type: 'init' });
</script>

<script>
  // ===== Blazed gratings module (analytic, fully client-side) =====
  import { chartTheme, onThemeChange } from '../../lib/chart-theme';

  const bzCanvas = document.getElementById('bz-canvas') as HTMLCanvasElement | null;
  if (bzCanvas) {
    const ctx = bzCanvas.getContext('2d')!;
    const statusEl = document.getElementById('bz-status')!;
    const setText = (id: string, value: string, muted = false) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.innerHTML = value;
      el.classList.toggle('is-muted', muted);
    };
    const DEG = Math.PI / 180;
    const PARAM_IDS = ['bz-density', 'bz-blaze', 'bz-lambda', 'bz-theta', 'bz-ngrooves'];
    let selOrder = 1;

    const num = (id: string, def: number): number => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      const v = el ? parseFloat(el.value) : NaN;
      return Number.isFinite(v) ? v : def;
    };

    function model() {
      const density = Math.max(1e-6, num('bz-density', 600)); // grooves / mm
      const gammaDeg = num('bz-blaze', 10);
      const gamma = gammaDeg * DEG;
      const lambda = Math.max(1e-6, num('bz-lambda', 550));   // nm
      const thetaIDeg = num('bz-theta', 0);
      const thetaI = thetaIDeg * DEG;
      const N = Math.max(1, Math.round(num('bz-ngrooves', 1200)));
      const d = 1e6 / density;                                // nm
      const sinI = Math.sin(thetaI);

      // Cap the displayed orders: at very low groove density (huge period) the
      // grating supports thousands of propagating orders, which would blow up
      // the DOM/canvas. Report the true count but only build up to MAX_ORDERS.
      const MAX_ORDERS = 20;
      const mMin = Math.ceil((-1 + sinI) * d / lambda);
      const mMax = Math.floor((1 + sinI) * d / lambda);
      const totalOrders = Math.max(0, mMax - mMin + 1);
      const truncated = totalOrders > MAX_ORDERS;
      let dispMin = mMin, dispMax = mMax;
      if (truncated) {                                   // window of MAX_ORDERS lowest-|m| orders, centred on 0
        dispMin = Math.max(mMin, -Math.floor(MAX_ORDERS / 2));
        dispMax = dispMin + MAX_ORDERS - 1;
        if (dispMax > mMax) { dispMax = mMax; dispMin = dispMax - MAX_ORDERS + 1; }
      }
      const orders: { m: number; thetaM: number }[] = [];
      for (let m = dispMin; m <= dispMax; m++) {
        const s = m * lambda / d - sinI;
        if (s >= -1 && s <= 1) orders.push({ m, thetaM: Math.asin(s) });
      }
      // selected order comes from the button group; clamp to a propagating order
      let mSel = selOrder;
      if (orders.length && !orders.some(o => o.m === mSel)) {
        mSel = orders.reduce((b, o) => (Math.abs(o.m - selOrder) < Math.abs(b - selOrder) ? o.m : b), orders[0].m);
        selOrder = mSel;
      }
      const sel = orders.find(o => o.m === mSel) ?? null;

      // facet-specular (blaze) direction via vector reflection off a facet
      // whose normal is tilted by gamma toward the incidence side.
      const din = [-Math.sin(thetaI), -Math.cos(thetaI)];
      const nf = [Math.sin(gamma), Math.cos(gamma)];
      const dt = din[0] * nf[0] + din[1] * nf[1];
      const dout = [din[0] - 2 * dt * nf[0], din[1] - 2 * dt * nf[1]];
      const blazeAngle = Math.atan2(dout[0], dout[1]);
      // Order nearest the blaze direction, computed analytically so it stays
      // correct even when the displayed orders are truncated.
      let blazeOrder: { m: number; thetaM: number } | null = null;
      if (totalOrders > 0) {
        const mB = Math.max(mMin, Math.min(mMax, Math.round((Math.sin(blazeAngle) + sinI) * d / lambda)));
        const sB = mB * lambda / d - sinI;
        if (sB >= -1 && sB <= 1) blazeOrder = { m: mB, thetaM: Math.asin(sB) };
      }

      const sLit = mSel * lambda / (2 * d);
      const littrow = Math.abs(sLit) <= 1 ? Math.asin(sLit) : null;
      const blazeLambda = mSel !== 0 ? 2 * d * Math.sin(gamma) / mSel : null;
      const angDisp = sel ? mSel / (d * Math.cos(sel.thetaM)) : null; // rad / nm
      const fsr = mSel !== 0 ? lambda / Math.abs(mSel) : null;
      const resolving = Math.abs(mSel) * N;
      const echelle = gamma > 45 * DEG;
      return { density, d, gammaDeg, gamma, lambda, thetaIDeg, thetaI, mSel, N, orders, totalOrders, truncated, maxOrders: MAX_ORDERS, sel, blazeAngle, blazeOrder, littrow, blazeLambda, angDisp, fsr, resolving, echelle };
    }

    const fmtDeg = (rad: number | null): string => (rad == null ? '—' : `${(rad / DEG).toFixed(2)}°`);

    function draw(M: ReturnType<typeof model>) {
      const t = chartTheme();
      const dpr = window.devicePixelRatio || 1;
      const cw = bzCanvas.clientWidth || 600;
      const ch = Math.max(215, Math.round(cw * 0.42));
      bzCanvas.width = cw * dpr;
      bzCanvas.height = ch * dpr;
      bzCanvas.style.height = ch + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, cw, ch);

      const ox = cw / 2;
      const oy = ch - 24;                       // grating near the bottom (figure pushed down)
      const L = Math.min(cw * 0.42, oy - 26);   // leave a small top margin

      // grating baseline with blaze teeth
      const gx0 = 24, gx1 = cw - 24, teeth = 14;
      const tp = (gx1 - gx0) / teeth;
      const th = Math.min(18, tp * Math.tan(Math.max(0.05, M.gamma)));
      ctx.fillStyle = t.grid; ctx.globalAlpha = 0.6;
      ctx.fillRect(gx0, oy, gx1 - gx0, Math.min(16, ch - oy - 2));
      ctx.globalAlpha = 1;
      ctx.strokeStyle = t.textMuted; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(gx0, oy);
      for (let i = 0; i < teeth; i++) {
        const x0 = gx0 + i * tp;
        ctx.lineTo(x0 + tp, oy - th);
        ctx.lineTo(x0 + tp, oy);
      }
      ctx.stroke();

      // normal (dashed reference line, no text label)
      ctx.strokeStyle = t.textMuted; ctx.setLineDash([4, 4]); ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(ox, oy); ctx.lineTo(ox, oy - L - 6); ctx.stroke();
      ctx.setLineDash([]);

      const ray = (angle: number, len: number, color: string, width: number, outgoing: boolean, dash: number[] = []) => {
        const dx = Math.sin(angle), dy = -Math.cos(angle);
        const ex = ox + len * dx, ey = oy + len * dy;
        ctx.strokeStyle = color; ctx.lineWidth = width; ctx.setLineDash(dash);
        ctx.beginPath(); ctx.moveTo(ox, oy); ctx.lineTo(ex, ey); ctx.stroke();
        ctx.setLineDash([]);
        const s = outgoing ? 1 : -1;
        const hx = outgoing ? ex : ox + 14 * dx;
        const hy = outgoing ? ey : oy + 14 * dy;
        const ang = Math.atan2(s * dy, s * dx);
        ctx.fillStyle = color; ctx.beginPath();
        ctx.moveTo(hx, hy);
        ctx.lineTo(hx - 8 * Math.cos(ang - 0.4), hy - 8 * Math.sin(ang - 0.4));
        ctx.lineTo(hx - 8 * Math.cos(ang + 0.4), hy - 8 * Math.sin(ang + 0.4));
        ctx.closePath(); ctx.fill();
        return { ex, ey, dx };
      };

      // incident ray (incoming) — see the legend for colour key
      ray(M.thetaI, L, t.text, 2.2, false);

      // blaze direction
      ray(M.blazeAngle, L * 0.97, '#F59E0B', 1.6, true, [5, 4]);

      // diffracted orders
      for (const o of M.orders) {
        const isSel = o.m === M.mSel;
        const color = isSel ? t.primary : (o.m === 0 ? t.textMuted : t.textSoft);
        const r = ray(o.thetaM, isSel ? L : L * 0.9, color, isSel ? 2.6 : 1.6, true);
        const right = Math.sin(o.thetaM) >= 0;
        ctx.fillStyle = isSel ? t.primary : t.textSoft;
        ctx.font = (isSel ? '700 ' : '') + '11px Inter, system-ui, sans-serif';
        ctx.textAlign = right ? 'left' : 'right';
        ctx.textBaseline = 'bottom';
        ctx.fillText(`m=${o.m}`, r.ex + (right ? 5 : -5), r.ey - 2);
      }
      statusEl.textContent = M.truncated
        ? `${M.totalOrders} orders (showing ${M.orders.length})`
        : `${M.orders.length} order${M.orders.length === 1 ? '' : 's'}`;
    }

    function renderReadout(M: ReturnType<typeof model>) {
      setText('bz-v-d', M.d.toFixed(1));
      setText('bz-v-thetam', M.sel ? fmtDeg(M.sel.thetaM) : 'evanescent', !M.sel);
      setText('bz-u-thetam', `order m = ${M.mSel}`);
      setText('bz-v-littrow', M.littrow == null ? 'no solution' : fmtDeg(M.littrow), M.littrow == null);
      setText('bz-u-littrow', `order m = ${M.mSel}`);
      const blz = M.blazeLambda != null && M.blazeLambda > 0;
      setText('bz-v-blaze', blz ? M.blazeLambda!.toFixed(1) : '—', !blz);
      setText('bz-v-disp', M.angDisp == null ? '—' : (M.angDisp * 1000).toFixed(3), M.angDisp == null);
      setText('bz-v-fsr', M.fsr == null ? '—' : M.fsr.toFixed(1), M.fsr == null);
      setText('bz-v-r', M.resolving.toLocaleString());
      setText('bz-v-echelle', M.echelle ? 'yes' : 'no', !M.echelle);
      setText('bz-v-norders', String(M.totalOrders));
    }

    function renderOrderButtons(M: ReturnType<typeof model>) {
      const c = document.getElementById('bz-order-btns');
      if (!c) return;
      c.innerHTML = M.orders.length
        ? M.orders.map(o => {
            const sel = o.m === M.mSel ? ' is-selected' : '';
            const bl = (M.blazeOrder && o.m === M.blazeOrder.m) ? ' is-blaze' : '';
            return `<button type="button" class="bz-order-btn${sel}${bl}" data-m="${o.m}" role="radio" aria-checked="${o.m === M.mSel}" title="${o.m === (M.blazeOrder?.m ?? NaN) ? 'Nearest to the blaze direction' : ''}">${o.m > 0 ? '+' + o.m : o.m}</button>`;
          }).join('')
        : '<span class="bz-order-empty">no propagating orders</span>';
    }

    function updateLegendWarning(M: ReturnType<typeof model>) {
      const w = document.getElementById('bz-legend-warning');
      if (!w) return;
      if (M.truncated) { w.textContent = `⚠ ${M.totalOrders} orders — showing ${M.orders.length}`; w.hidden = false; }
      else w.hidden = true;
    }

    let raf = 0;
    const update = () => { const M = model(); draw(M); renderReadout(M); renderOrderButtons(M); updateLegendWarning(M); };
    const schedule = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); };

    PARAM_IDS.forEach(id => document.getElementById(id)?.addEventListener('input', schedule));

    // Order selection via buttons
    document.getElementById('bz-order-btns')?.addEventListener('click', (e: Event) => {
      const btn = (e.target as HTMLElement).closest('.bz-order-btn') as HTMLElement | null;
      if (!btn) return;
      const m = parseInt(btn.dataset.m || '', 10);
      if (Number.isFinite(m)) { selOrder = m; schedule(); }
    });

    // Two-way link a number input with a range slider.
    const linkSlider = (numId: string, sliderId: string) => {
      const n = document.getElementById(numId) as HTMLInputElement | null;
      const s = document.getElementById(sliderId) as HTMLInputElement | null;
      if (!n || !s) return;
      s.addEventListener('input', () => { n.value = s.value; schedule(); });
      n.addEventListener('input', () => { const v = parseFloat(n.value); if (Number.isFinite(v)) s.value = String(v); });
    };
    linkSlider('bz-lambda', 'bz-lambda-slider');
    linkSlider('bz-theta', 'bz-theta-slider');

    document.getElementById('bz-dl-png')?.addEventListener('click', () => {
      const a = document.createElement('a');
      a.download = 'blazed_grating.png';
      a.href = bzCanvas.toDataURL('image/png');
      a.click();
    });
    document.getElementById('bz-dl-csv')?.addEventListener('click', () => {
      const M = model();
      const lines: string[] = [];
      lines.push('# Blazed grating — diffraction orders');
      lines.push(`# groove_density_per_mm,${M.density}`);
      lines.push(`# line_spacing_d_nm,${M.d.toFixed(4)}`);
      lines.push(`# blaze_angle_gamma_deg,${M.gammaDeg}`);
      lines.push(`# wavelength_nm,${M.lambda}`);
      lines.push(`# incidence_theta_i_deg,${M.thetaIDeg}`);
      lines.push(`# grooves_N,${M.N}`);
      lines.push(`# blaze_direction_deg,${(M.blazeAngle / DEG).toFixed(4)}`);
      lines.push('m,theta_m_deg,sin_theta_m,angular_dispersion_mrad_per_nm,free_spectral_range_nm,littrow_blaze_deg,blaze_wavelength_nm,resolving_power,is_selected,nearest_blaze');
      for (const o of M.orders) {
        const sinM = Math.sin(o.thetaM);
        const disp = (o.m / (M.d * Math.cos(o.thetaM)) * 1000).toFixed(4);
        const fsr = o.m !== 0 ? (M.lambda / Math.abs(o.m)).toFixed(3) : '';
        const sLit = o.m * M.lambda / (2 * M.d);
        const lit = Math.abs(sLit) <= 1 ? (Math.asin(sLit) / DEG).toFixed(4) : '';
        const blz = o.m !== 0 ? (2 * M.d * Math.sin(M.gamma) / o.m).toFixed(3) : '';
        const R = Math.abs(o.m) * M.N;
        lines.push([o.m, (o.thetaM / DEG).toFixed(4), sinM.toFixed(5), disp, fsr, lit, blz, R,
          o.m === M.mSel ? 'yes' : 'no', (M.blazeOrder && o.m === M.blazeOrder.m) ? 'yes' : 'no'].join(','));
      }
      const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = 'blazed_grating_orders.csv'; a.click();
      URL.revokeObjectURL(url);
    });
    window.addEventListener('rcwa:module-shown', (e: Event) => {
      if ((e as CustomEvent).detail === 'module-blazed') schedule();
    });
    onThemeChange(schedule);
    new ResizeObserver(() => {
      const p = document.getElementById('module-panel-blazed');
      if (p && !p.hidden) schedule();
    }).observe(bzCanvas);
    update();
  }
</script>

<script>
  // ===== Module switcher =====
  (() => {
    const panels: Record<string, string> = {
      'module-rcwa-1d': 'module-panel-rcwa-1d',
      'module-blazed': 'module-panel-blazed',
    };
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.module-card')];
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.disabled || !panels[btn.id]) return;
        buttons.forEach(b => {
          const active = b.id === btn.id;
          b.classList.toggle('active', active);
          b.setAttribute('aria-checked', active ? 'true' : 'false');
        });
        Object.entries(panels).forEach(([id, panelId]) => {
          const panel = document.getElementById(panelId);
          if (panel) panel.hidden = id !== btn.id;
        });
        window.dispatchEvent(new CustomEvent('rcwa:module-shown', { detail: btn.id }));
      });
    });
  })();
</script>
