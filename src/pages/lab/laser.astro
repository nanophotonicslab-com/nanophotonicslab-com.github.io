---
import Layout from '../../layouts/Layout.astro';
import ModelInfo from '../../components/ModelInfo.astro';
import PresetStrip from '../../components/PresetStrip.astro';
import ToolMeta from '../../components/ToolMeta.astro';
import ParamsDrawer from '../../components/ParamsDrawer.astro';
import '../../styles/lab.css';

const laserPresets = [
  { label: 'Ti:sapphire (100 fs)', values: { 'tbp-lam': 800, 'tbp-dt': 100, 'peak-pavg': 1, 'peak-frep': 80, 'peak-dt': 100, 'gdd-wl': 800, 'gdd-dt': 100 } },
  { label: 'Er:fiber (200 fs)', values: { 'tbp-lam': 1550, 'tbp-dt': 200, 'peak-pavg': 0.1, 'peak-frep': 100, 'peak-dt': 200, 'gdd-wl': 1550, 'gdd-dt': 200 } },
  { label: 'Nd:YAG (10 ps)', values: { 'tbp-lam': 1064, 'tbp-dt': 10000, 'peak-pavg': 0.5, 'peak-frep': 10, 'peak-dt': 10000, 'gdd-wl': 1064, 'gdd-dt': 10000 } },
];
---

<Layout title="Laser Pulse Calculator" description="Pulse duration, bandwidth, peak power, and dispersion for ultrafast laser pulses. Time-bandwidth product, GDD broadening, and peak power from average power.">
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Laser Pulse <span class="gradient-text">Calculator</span></h1>
      <p class="widget-hero__subtitle">
        Essential calculations for ultrafast laser labs: time-bandwidth product,
        peak power from average power, and pulse broadening through dispersive media.
      </p>
      <ToolMeta slug="laser" name="Laser Pulse Calculator" />
    </div>
  </section>

  <ModelInfo status="Stable">
    <dl>
      <dt>Model</dt>
      <dd>Standard ultrafast-optics relations: time&ndash;bandwidth product (&Delta;t&middot;&Delta;&nu; &ge; TBP), peak power from average power and duty cycle, GDD-induced pulse broadening for transform-limited input pulses.</dd>
      <dt>Assumptions</dt>
      <dd>Transform-limited input pulses (Gaussian, sech&sup2;, or Lorentzian). Second-order dispersion only (GDD); higher-order dispersion neglected. Linear propagation — no self-phase modulation or nonlinear effects.</dd>
      <dt>Limitations</dt>
      <dd>No higher-order dispersion (TOD, FOD). No chirped input pulses. Gaussian-beam calculator assumes TEM<sub>00</sub> mode only.</dd>
    </dl>
  </ModelInfo>

  <section class="section">
    <div class="container">
      <!-- Tabs -->
      <div class="calc-tabs-row">
        <div class="calc-tabs" id="calc-tabs">
          <button class="calc-tab active" data-tab="tbp">Pulse &harr; Bandwidth</button>
          <button class="calc-tab" data-tab="peak">Peak Power</button>
          <button class="calc-tab" data-tab="gdd">Dispersion</button>
          <button class="calc-tab" data-tab="beam">Gaussian Beam</button>
          <button class="calc-tab" data-tab="focus">Focus &amp; Fluence</button>
          <button class="calc-tab" data-tab="chirp">Chirp</button>
          <button class="calc-tab" data-tab="nlc">Nonlinear Conversion</button>
          <button class="calc-tab" data-tab="bright">Brightness</button>
          <button class="calc-tab" data-tab="modes">Beam Modes</button>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- TAB 1: Pulse ↔ Bandwidth                                     -->
      <!-- ============================================================ -->
      <div class="tab-panel active" id="panel-tbp">
        <div class="widget-layout">
          <ParamsDrawer>
          <div class="controls card">
            <h3>Time-Bandwidth Product</h3>

            <div class="param-group">
              <span class="param-group__title">Pulse shape</span>
              <div class="shape-row" id="tbp-shape">
                <button class="preset-btn active" data-shape="gaussian">Gaussian</button>
                <button class="preset-btn" data-shape="sech2">sech&sup2;</button>
                <button class="preset-btn" data-shape="lorentzian">Lorentzian</button>
              </div>
            </div>

            <div class="param-group">
              <span class="param-group__title">Input (edit either)</span>
              <div class="fields">
                <div class="field">
                  <label for="tbp-lam">&lambda;<sub>0</sub> (nm)</label>
                  <input type="text" class="field-input" id="tbp-lam" inputmode="decimal" value="800">
                </div>
                <div class="field">
                  <label for="tbp-dlam">&Delta;&lambda; (nm)</label>
                  <input type="text" class="field-input" id="tbp-dlam" inputmode="decimal" placeholder="10">
                </div>
                <div class="field">
                  <label for="tbp-dt">&Delta;t (fs)</label>
                  <input type="text" class="field-input" id="tbp-dt" inputmode="decimal" placeholder="auto">
                </div>
              </div>
            </div>

            <p class="theory-note">
              <strong>Time-bandwidth product.</strong>
              &Delta;t&thinsp;&middot;&thinsp;&Delta;&nu;&nbsp;&ge;&nbsp;TBP.
              Gaussian:&nbsp;0.4413, sech&sup2;:&nbsp;0.3148, Lorentzian:&nbsp;0.2206.
              &Delta;&nu;&nbsp;=&nbsp;c&thinsp;&Delta;&lambda;/&lambda;&sup2;.
            </p>
          </div>
          </ParamsDrawer>

          <div class="results card">
            <h3>Results</h3>
            <div class="result-grid">
              <div class="result-item">
                <span class="result-label">Transform-limited &Delta;t</span>
                <span class="result-value" id="tbp-out-dt">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Frequency bandwidth &Delta;&nu;</span>
                <span class="result-value" id="tbp-out-dnu">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Optical cycles</span>
                <span class="result-value" id="tbp-out-cycles">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">TBP (actual / minimum)</span>
                <span class="result-value" id="tbp-out-ratio">&mdash;</span>
              </div>
            </div>
            <div class="chart-wrap dual-chart">
              <canvas id="tbp-chart-time" aria-label="Temporal pulse profile"></canvas>
              <canvas id="tbp-chart-spec" aria-label="Spectral profile"></canvas>
            </div>
            <div class="download-bar">
              <span class="download-label">Export</span>
              <button id="dl-png" class="dl-btn" title="Download chart as PNG" data-umami-event="laser-export" data-umami-event-format="png">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                PNG
              </button>
              <button id="dl-csv" class="dl-btn" title="Download results as CSV" data-umami-event="laser-export" data-umami-event-format="csv">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                CSV
              </button>
              <button id="dl-share" class="dl-btn" title="Copy shareable link to clipboard" data-umami-event="share" data-umami-event-page="laser">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                Share
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- TAB 2: Peak Power                                             -->
      <!-- ============================================================ -->
      <div class="tab-panel" id="panel-peak">
        <div class="widget-layout">
          <ParamsDrawer>
          <div class="controls card">
            <h3>Peak Power</h3>

            <div class="param-group">
              <span class="param-group__title">Pulse shape</span>
              <div class="shape-row" id="peak-shape">
                <button class="preset-btn active" data-shape="gaussian">Gaussian</button>
                <button class="preset-btn" data-shape="sech2">sech&sup2;</button>
                <button class="preset-btn" data-shape="rect">Rectangular</button>
              </div>
            </div>

            <div class="param-group">
              <span class="param-group__title">Parameters</span>
              <div class="fields">
                <div class="field">
                  <label for="peak-pavg">P<sub>avg</sub></label>
                  <div class="input-with-unit">
                    <input type="text" class="field-input" id="peak-pavg" inputmode="decimal" value="1">
                    <select class="unit-sel" id="peak-pavg-u">
                      <option value="1">W</option>
                      <option value="1e-3">mW</option>
                      <option value="1e-6">&mu;W</option>
                    </select>
                  </div>
                </div>
                <div class="field">
                  <label for="peak-frep">f<sub>rep</sub></label>
                  <div class="input-with-unit">
                    <input type="text" class="field-input" id="peak-frep" inputmode="decimal" value="80">
                    <select class="unit-sel" id="peak-frep-u">
                      <option value="1e6" selected>MHz</option>
                      <option value="1e3">kHz</option>
                      <option value="1e9">GHz</option>
                      <option value="1">Hz</option>
                    </select>
                  </div>
                </div>
                <div class="field">
                  <label for="peak-dt">&Delta;t</label>
                  <div class="input-with-unit">
                    <input type="text" class="field-input" id="peak-dt" inputmode="decimal" value="100">
                    <select class="unit-sel" id="peak-dt-u">
                      <option value="1e-15" selected>fs</option>
                      <option value="1e-12">ps</option>
                      <option value="1e-9">ns</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <p class="theory-note">
              <strong>Peak power.</strong>
              E&nbsp;=&nbsp;P<sub>avg</sub>/f<sub>rep</sub>, &ensp;
              P<sub>peak</sub>&nbsp;=&nbsp;k&thinsp;E/&Delta;t.
              k: Gaussian&nbsp;0.94, sech&sup2;&nbsp;0.88, rect&nbsp;1.0.
            </p>
          </div>
          </ParamsDrawer>

          <div class="results card">
            <h3>Results</h3>
            <div class="result-grid">
              <div class="result-item">
                <span class="result-label">Pulse energy</span>
                <span class="result-value" id="peak-out-energy">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Peak power</span>
                <span class="result-value" id="peak-out-ppeak">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Duty cycle</span>
                <span class="result-value" id="peak-out-duty">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Peak / Average ratio</span>
                <span class="result-value" id="peak-out-ratio">&mdash;</span>
              </div>
            </div>
            <div class="chart-wrap">
              <canvas id="peak-chart" aria-label="Pulse train and peak power diagram"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- TAB 3: Dispersion                                             -->
      <!-- ============================================================ -->
      <div class="tab-panel" id="panel-gdd">
        <div class="widget-layout">
          <ParamsDrawer>
          <div class="controls card">
            <h3>GDD Pulse Broadening</h3>

            <div class="param-group">
              <span class="param-group__title">Input pulse</span>
              <div class="fields">
                <div class="field">
                  <label for="gdd-dt">&Delta;t<sub>in</sub> (fs)</label>
                  <input type="text" class="field-input" id="gdd-dt" inputmode="decimal" value="100">
                </div>
              </div>
            </div>

            <div class="param-group">
              <span class="param-group__title">Material</span>
              <div class="fields">
                <div class="field">
                  <label for="gdd-mat">Material</label>
                  <select class="field-input" id="gdd-mat">
                    <option value="sio2">Fused silica</option>
                    <option value="bk7">BK7</option>
                    <option value="caf2">CaF&sub2;</option>
                    <option value="sapphire">Sapphire</option>
                    <option value="sf10">SF10</option>
                    <option value="custom">Custom GVD</option>
                  </select>
                </div>
                <div class="field">
                  <label for="gdd-wl">&lambda; (nm)</label>
                  <input type="text" class="field-input" id="gdd-wl" inputmode="decimal" value="800">
                </div>
                <div class="field">
                  <label for="gdd-gvd">GVD (fs&sup2;/mm)</label>
                  <input type="text" class="field-input" id="gdd-gvd" inputmode="decimal" readonly>
                </div>
                <div class="field">
                  <label for="gdd-L">Thickness (mm)</label>
                  <input type="text" class="field-input" id="gdd-L" inputmode="decimal" value="10">
                </div>
                <div class="field">
                  <label for="gdd-passes">Passes</label>
                  <input type="text" class="field-input" id="gdd-passes" inputmode="decimal" value="1">
                </div>
              </div>
            </div>

            <p class="theory-note">
              <strong>GDD broadening (Gaussian).</strong>
              &Delta;t<sub>out</sub>&nbsp;=&nbsp;&Delta;t<sub>in</sub>&thinsp;&radic;(1&nbsp;+&nbsp;(4&thinsp;ln2&thinsp;&middot;&thinsp;GDD/&Delta;t<sub>in</sub>&sup2;)&sup2;).
              GDD&nbsp;=&nbsp;GVD&thinsp;&times;&thinsp;L&thinsp;&times;&thinsp;passes.
            </p>
          </div>
          </ParamsDrawer>

          <div class="results card">
            <h3>Results</h3>
            <div class="result-grid">
              <div class="result-item">
                <span class="result-label">Total GDD</span>
                <span class="result-value" id="gdd-out-gdd">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Output &Delta;t</span>
                <span class="result-value" id="gdd-out-dt">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Broadening factor</span>
                <span class="result-value" id="gdd-out-factor">&mdash;</span>
              </div>
            </div>
            <div class="chart-wrap" id="gdd-chart-wrap">
              <canvas id="gdd-chart" aria-label="Pulse duration vs material thickness"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- TAB 4: Gaussian Beam                                          -->
      <!-- ============================================================ -->
      <div class="tab-panel" id="panel-beam">
        <div class="widget-layout">
          <div class="controls card">
            <h3>Gaussian Beam</h3>

            <div class="param-group">
              <span class="param-group__title">Parameters</span>
              <div class="fields">
                <div class="field">
                  <label for="beam-lam">&lambda; (nm)</label>
                  <input type="text" class="field-input" id="beam-lam" inputmode="decimal" value="800">
                </div>
                <div class="field">
                  <div class="field-label-with-info">
                    <label for="beam-M2">M&sup2;</label>
                    <button class="field-info" type="button" aria-label="M squared definition" aria-describedby="beam-m2-tooltip">i</button>
                    <span class="field-tooltip" id="beam-m2-tooltip" role="tooltip">Beam quality factor. M^2 = 1 is a diffraction-limited Gaussian; larger values increase divergence and focused spot size.</span>
                  </div>
                  <input type="text" class="field-input" id="beam-M2" inputmode="decimal" value="1">
                </div>
              </div>
            </div>

            <div class="param-group">
              <span class="param-group__title">Waist size (edit any)</span>
              <div class="fields waist-fields">
                <div class="field">
                  <label for="beam-w1e">1/e intensity radius (&mu;m)</label>
                  <input type="text" class="field-input" id="beam-w1e" inputmode="decimal" value="7.07">
                </div>
                <div class="field">
                  <label for="beam-w0">1/e<sup>2</sup> intensity radius w<sub>0</sub> (&mu;m)</label>
                  <input type="text" class="field-input" id="beam-w0" inputmode="decimal" value="10">
                </div>
                <div class="field">
                  <label for="beam-fwhm">FWHM intensity &empty; (&mu;m)</label>
                  <input type="text" class="field-input" id="beam-fwhm" inputmode="decimal" value="11.77">
                </div>
              </div>
            </div>

            <div class="param-group">
              <span class="param-group__title">Evaluate at distance</span>
              <div class="fields">
                <div class="field">
                  <label for="beam-z">z (mm)</label>
                  <input type="text" class="field-input" id="beam-z" inputmode="decimal" value="1">
                </div>
              </div>
            </div>

            <p class="theory-note">
              <strong>Gaussian beam.</strong>
              z<sub>R</sub>&nbsp;=&nbsp;&pi;w<sub>0</sub>&sup2;/(M&sup2;&lambda;), &ensp;
              w(z)&nbsp;=&nbsp;w<sub>0</sub>&radic;(1+(z/z<sub>R</sub>)&sup2;), &ensp;
              &theta;&nbsp;=&nbsp;M&sup2;&lambda;/(&pi;w<sub>0</sub>).
            </p>
          </div>

          <div class="results card">
            <h3>Results</h3>
            <div class="result-grid">
              <div class="result-item">
                <span class="result-label">Rayleigh range z<sub>R</sub></span>
                <span class="result-value" id="beam-out-zr">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Divergence &theta; (half-angle)</span>
                <span class="result-value" id="beam-out-div">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Confocal parameter 2z<sub>R</sub></span>
                <span class="result-value" id="beam-out-conf">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">w(z) at selected z</span>
                <span class="result-value" id="beam-out-wz">&mdash;</span>
              </div>
            </div>
            <div class="chart-wrap">
              <canvas id="beam-chart" aria-label="Beam radius vs propagation distance"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- TAB 5: Focus & Fluence                                        -->
      <!-- ============================================================ -->
      <div class="tab-panel" id="panel-focus">
        <div class="widget-layout">
          <div class="controls card">
            <h3>Focus &amp; Fluence</h3>

            <div class="param-group">
              <span class="param-group__title">Beam before lens</span>
              <div class="fields">
                <div class="field">
                  <label for="foc-lam">&lambda; (nm)</label>
                  <input type="text" class="field-input" id="foc-lam" inputmode="decimal" value="800">
                </div>
                <div class="field">
                  <label for="foc-d">Beam &empty; (mm)</label>
                  <input type="text" class="field-input" id="foc-d" inputmode="decimal" value="5">
                </div>
                <div class="field">
                  <label for="foc-M2">M&sup2;</label>
                  <input type="text" class="field-input" id="foc-M2" inputmode="decimal" value="1">
                </div>
              </div>
            </div>

            <div class="param-group">
              <span class="param-group__title">Focusing optic</span>
              <div class="fields">
                <div class="field">
                  <label for="foc-f">f (mm)</label>
                  <input type="text" class="field-input" id="foc-f" inputmode="decimal" value="100">
                </div>
              </div>
            </div>

            <div class="param-group">
              <span class="param-group__title">Pulse</span>
              <div class="fields">
                <div class="field">
                  <label for="foc-energy">Energy</label>
                  <div class="input-with-unit">
                    <input type="text" class="field-input" id="foc-energy" inputmode="decimal" value="1">
                    <select class="unit-sel" id="foc-energy-u">
                      <option value="1e-3">mJ</option>
                      <option value="1e-6" selected>&mu;J</option>
                      <option value="1e-9">nJ</option>
                    </select>
                  </div>
                </div>
                <div class="field">
                  <label for="foc-dt">&Delta;t (fs)</label>
                  <input type="text" class="field-input" id="foc-dt" inputmode="decimal" value="100">
                </div>
              </div>
            </div>

            <p class="theory-note">
              <strong>Focus.</strong>
              w<sub>0</sub>&nbsp;&approx;&nbsp;M&sup2;&thinsp;&lambda;&thinsp;f/(&pi;&thinsp;w<sub>in</sub>).
              I&nbsp;=&nbsp;P<sub>peak</sub>/(&pi;w<sub>0</sub>&sup2;).
              F&nbsp;=&nbsp;E/(&pi;w<sub>0</sub>&sup2;).
            </p>
          </div>

          <div class="results card">
            <h3>Results</h3>
            <div class="result-grid">
              <div class="result-item">
                <span class="result-label">Spot radius w<sub>0</sub></span>
                <span class="result-value" id="foc-out-w0">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Spot diameter 2w<sub>0</sub></span>
                <span class="result-value" id="foc-out-2w0">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Peak intensity</span>
                <span class="result-value" id="foc-out-I">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Fluence</span>
                <span class="result-value" id="foc-out-F">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Rayleigh range z<sub>R</sub></span>
                <span class="result-value" id="foc-out-zr">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Depth of focus 2z<sub>R</sub></span>
                <span class="result-value" id="foc-out-dof">&mdash;</span>
              </div>
            </div>
            <div class="chart-wrap">
              <canvas id="foc-chart" aria-label="Focused beam profile and intensity"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- TAB 6: Chirp / Compressor                                     -->
      <!-- ============================================================ -->
      <div class="tab-panel" id="panel-chirp">
        <div class="widget-layout">
          <div class="controls card">
            <h3>Chirp &amp; Compressor</h3>

            <div class="param-group">
              <span class="param-group__title">Measured pulse</span>
              <div class="fields">
                <div class="field">
                  <label for="chirp-dt">&Delta;t<sub>actual</sub> (fs)</label>
                  <input type="text" class="field-input" id="chirp-dt" inputmode="decimal" value="500">
                </div>
              </div>
            </div>

            <div class="param-group">
              <span class="param-group__title">Transform limit</span>
              <div class="fields">
                <div class="field">
                  <label for="chirp-lam">&lambda;<sub>0</sub> (nm)</label>
                  <input type="text" class="field-input" id="chirp-lam" inputmode="decimal" value="800">
                </div>
                <div class="field">
                  <label for="chirp-dlam">&Delta;&lambda; (nm)</label>
                  <input type="text" class="field-input" id="chirp-dlam" inputmode="decimal" value="30">
                </div>
                <div class="field">
                  <label for="chirp-dtTL">&Delta;t<sub>TL</sub> (fs)</label>
                  <input type="text" class="field-input" id="chirp-dtTL" inputmode="decimal" readonly>
                </div>
              </div>
            </div>

            <div class="param-group">
              <span class="param-group__title">Compressor material</span>
              <div class="fields">
                <div class="field">
                  <label for="chirp-mat">Material</label>
                  <select class="field-input" id="chirp-mat">
                    <option value="sio2">Fused silica</option>
                    <option value="bk7">BK7</option>
                    <option value="caf2">CaF&sub2;</option>
                    <option value="sapphire">Sapphire</option>
                    <option value="sf10">SF10</option>
                  </select>
                </div>
              </div>
            </div>

            <p class="theory-note">
              <strong>Chirp compensation.</strong>
              GDD&nbsp;=&nbsp;&plusmn;&Delta;t<sub>in</sub>&thinsp;&radic;((&Delta;t<sub>actual</sub>/&Delta;t<sub>TL</sub>)&sup2;&minus;1)/(4&thinsp;ln2).
              L&nbsp;=&nbsp;|GDD|/GVD.
              Sign of GDD tells you if pulse has positive or negative chirp.
            </p>
          </div>

          <div class="results card">
            <h3>Results</h3>
            <div class="result-grid">
              <div class="result-item">
                <span class="result-label">Chirp ratio &Delta;t/&Delta;t<sub>TL</sub></span>
                <span class="result-value" id="chirp-out-ratio">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">GDD on the pulse</span>
                <span class="result-value" id="chirp-out-gdd">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Compensating GDD</span>
                <span class="result-value" id="chirp-out-comp">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Material needed</span>
                <span class="result-value" id="chirp-out-mat">&mdash;</span>
              </div>
            </div>
            <div class="chart-wrap">
              <canvas id="chirp-chart" aria-label="Pulse duration vs GDD"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- TAB 7: Nonlinear Conversion                                   -->
      <!-- ============================================================ -->
      <div class="tab-panel" id="panel-nlc">
        <div class="widget-layout">
          <div class="controls card">
            <h3>Nonlinear Conversion</h3>

            <div class="param-group">
              <span class="param-group__title">Process</span>
              <div class="shape-row" id="nlc-process">
                <button class="preset-btn active" data-shape="shg">SHG</button>
                <button class="preset-btn" data-shape="thg">THG</button>
                <button class="preset-btn" data-shape="sfg">SFG</button>
                <button class="preset-btn" data-shape="dfg">DFG</button>
                <button class="preset-btn" data-shape="opa">OPA</button>
              </div>
            </div>

            <div class="param-group">
              <span class="param-group__title">Input wavelengths</span>
              <div class="fields">
                <div class="field">
                  <label for="nlc-lam1">&lambda;<sub>1</sub> (nm)</label>
                  <input type="text" class="field-input" id="nlc-lam1" inputmode="decimal" value="800">
                </div>
                <div class="field" id="nlc-lam2-field">
                  <label for="nlc-lam2">&lambda;<sub>2</sub> (nm)</label>
                  <input type="text" class="field-input" id="nlc-lam2" inputmode="decimal" value="1064" placeholder="(for SFG/DFG/OPA)">
                </div>
              </div>
            </div>

            <p class="theory-note" id="nlc-note">
              <strong>SHG.</strong>
              &omega; + &omega; &rarr; 2&omega;.
              &lambda;<sub>out</sub> = &lambda;/2.
            </p>
          </div>

          <div class="results card">
            <h3>Results</h3>
            <div class="result-grid" id="nlc-results">
              <div class="result-item">
                <span class="result-label">Output wavelength</span>
                <span class="result-value" id="nlc-out-lam">&mdash;</span>
              </div>
              <div class="result-item">
                <span class="result-label">Output energy</span>
                <span class="result-value" id="nlc-out-ev">&mdash;</span>
              </div>
              <div class="result-item" id="nlc-sig-item" style="display:none">
                <span class="result-label">Signal &lambda;<sub>s</sub></span>
                <span class="result-value" id="nlc-out-sig">&mdash;</span>
              </div>
              <div class="result-item" id="nlc-idl-item" style="display:none">
                <span class="result-label">Idler &lambda;<sub>i</sub></span>
                <span class="result-value" id="nlc-out-idl">&mdash;</span>
              </div>
            </div>
            <div class="chart-wrap">
              <canvas id="nlc-chart" aria-label="Nonlinear conversion energy diagram"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- TAB 7: Brightness                                             -->
      <!-- ============================================================ -->
      <div class="tab-panel" id="panel-bright">
        <div class="widget-layout">
          <div class="controls card">
            <h3>Spectral Brightness</h3>

            <div class="param-group">
              <span class="param-group__title">Source</span>
              <div class="fields">
                <div class="field">
                  <label for="brt-pavg">P<sub>avg</sub></label>
                  <div class="input-with-unit">
                    <input type="text" class="field-input" id="brt-pavg" inputmode="decimal" value="2.3">
                    <select class="unit-sel" id="brt-pavg-u">
                      <option value="1" selected>W</option>
                      <option value="1e-3">mW</option>
                      <option value="1e-6">&mu;W</option>
                    </select>
                  </div>
                </div>
                <div class="field">
                  <label for="brt-frep">f<sub>rep</sub></label>
                  <div class="input-with-unit">
                    <input type="text" class="field-input" id="brt-frep" inputmode="decimal" value="160">
                    <select class="unit-sel" id="brt-frep-u">
                      <option value="1e3" selected>kHz</option>
