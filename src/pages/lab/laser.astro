<style>
  .widget-layout { --sidebar-w: 280px; }
  /* ---- Tabs ---- */
  .calc-tabs-row {
    margin-bottom: var(--space-lg);
  }
  .calc-tabs {
    display: flex; gap: 0.25rem; min-width: 0;
    border-bottom: 2px solid var(--bg-muted); padding-bottom: 0;
    overflow-x: auto; scrollbar-width: none;
  }
  .calc-tabs::-webkit-scrollbar { display: none; }
  .calc-tab {
    padding: 0.6rem 1.2rem; font-size: 0.875rem; font-weight: 500;
    background: none; border: none; border-bottom: 2px solid transparent;
    margin-bottom: -2px; color: var(--text-muted); cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .calc-tab:hover { color: var(--text); }
  .calc-tab.active { color: var(--primary); border-bottom-color: var(--primary); font-weight: 600; }

  .tab-panel { display: none; }
  .tab-panel.active { display: block; }
  @media (max-width: 900px) { .widget-layout { grid-template-columns: 1fr; } }

  /* ---- Notes boxes ----
     Same type scale as the other labs' notes cards (electron.astro keeps these
     local too, so nothing shared is needed). The KaTeX markup is injected with
     set:html and therefore carries no scope attribute: every rule that reaches
     into it has to be :global(). */
  .notes-card p { font-size: 0.8125rem; line-height: 1.55; color: var(--text-soft); margin: 0; max-width: none; }
  /* The second selector catches a paragraph that follows a .note-eq or one of
     the per-process/per-family wrappers instead of another paragraph. */
  .notes-card p + p,
  .notes-card div + p { margin-top: var(--space-sm); }
  /* The itemised assumptions are the body of the "Assumptions." line above them,
     so the list takes the same gap every other block in the card gets. The
     shared .notes-card ul rule (lab.css) zeroes the margin for lists that open a
     card, and this is two classes to its one, so it wins. */
  .notes-card .theory-note + ul { margin-top: var(--space-sm); }
  /* Only the colour is ours: KaTeX's own 1.21em compensates for a much smaller
     x-height than Inter's, so forcing 1em would make every inline symbol read
     smaller than the prose around it. */
  .notes-card :global(.katex) { color: var(--text); }
  /* A formula wider than the column scrolls inside its own box rather than
     widening the page. The box itself is the scroll container and is focusable
     (see eqAttrs), and the line is left-aligned inside it: KaTeX centres
     display math, and a centred nowrap line overflows the inline-start edge
     too, which in LTR is not part of the scrollable region and so would be
     clipped with no way to scroll it back. */
  .note-eq { margin: var(--space-sm) 0; overflow-x: auto; overflow-y: hidden; padding: 0.15rem 0; }
  .note-eq :global(.katex-display) { margin: 0; }
  .note-eq :global(.katex-display) > :global(.katex) { text-align: left; }
  .note-eq:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: var(--radius-sm); }
  /* Glossary as a two-column list: symbol beside its meaning, so the reader can
     scan for a symbol instead of parsing a run-on sentence. One column when the
     notes column is narrow. */
  .notes-card :global(.note-defs) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 0.7rem;
    margin: var(--space-sm) 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .notes-card :global(.note-defs dt) {
    color: var(--text);
    text-align: right;
    white-space: nowrap;
  }
  .notes-card :global(.note-defs dd) { margin: 0; color: var(--text-soft); }
  /* Keep a multi-atom symbol (e.g. a comma-separated pair) from wrapping in the
     middle of itself in the narrow <dt> column. */
  .notes-card :global(.note-defs .katex) { white-space: nowrap; }
  @media (max-width: 560px) {
    .notes-card :global(.note-defs) { grid-template-columns: 1fr; gap: 0.15rem; }
    .notes-card :global(.note-defs dt) { text-align: left; margin-top: 0.3rem; }
  }

  /* Examples strip — sits below and matches the width of the result box */
  .examples-row :global(.preset-strip) {
    margin: 0; padding: 0; border-bottom: none;
  }
  .waist-fields {
    gap: 0.65rem;
  }
  .waist-fields .field {
    align-items: stretch;
    flex-direction: column;
    gap: 0.25rem;
  }
  .waist-fields label {
    max-width: none; min-width: 0;
