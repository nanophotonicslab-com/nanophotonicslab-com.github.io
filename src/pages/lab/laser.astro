  }
  .unit-sel {
    padding: 0.35rem 0.3rem; font-size: 0.8rem;
    border: 1px solid var(--bg-muted); border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--bg-soft); color: var(--text-soft); cursor: pointer;
    font-family: var(--font);
  }

  .shape-row { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  /* ---- Results ---- */
  .results h3 { margin-bottom: var(--space-md); }
  .result-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  @media (max-width: 600px) { .result-grid { grid-template-columns: 1fr; } }
