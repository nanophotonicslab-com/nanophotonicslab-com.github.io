  .result-value { font-size: 1.4rem; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; }.chart-wrap canvas { --chart-aspect: 5 / 2; }
  .dual-chart { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); }
  .dual-chart canvas { aspect-ratio: 4 / 3; }
  @media (max-width: 600px) { .dual-chart { grid-template-columns: 1fr; } }

  /* Keyboard focus visibility (a11y) */
  .calc-tab:focus-visible,
  .field-input:focus-visible,
  .unit-sel:focus-visible,
  .preset-btn:focus-visible,
  .dl-btn:focus-visible {
    outline: 2px solid var(--primary);
