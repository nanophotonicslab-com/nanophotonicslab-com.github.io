  }
  .waist-fields .field-input { flex: none; width: 100%; }
  .field-input[readonly] { opacity: 0.7; cursor: default; }
  .input-with-unit { flex: 1; display: flex; gap: 0; min-width: 0; }
  .input-with-unit .field-input {
