<script>
  import { chartTheme, onThemeChange } from '../../lib/chart-theme';

  /* ================================================================ */
  /*  Tab switching                                                    */
  /* ================================================================ */
  const tabs = document.querySelectorAll<HTMLButtonElement>('.calc-tab');
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel');
  const downloadBar = document.querySelector<HTMLElement>('.download-bar');

  function moveDownloadBarToActivePanel() {
    const activePanel = document.querySelector<HTMLElement>('.tab-panel.active');
    const activeResults = activePanel?.querySelector<HTMLElement>('.results.card');
    if (downloadBar && activeResults && downloadBar.parentElement !== activeResults) {
      activeResults.appendChild(downloadBar);
    }
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById(`panel-${tab.dataset.tab}`)!.classList.add('active');
      moveDownloadBarToActivePanel();
      // Redraw charts now that the panel is visible
      requestAnimationFrame(() => {
        if (tab.dataset.tab === 'tbp') calcTBP();
        else if (tab.dataset.tab === 'peak') calcPeak();
        else if (tab.dataset.tab === 'gdd') calcGDD();
        else if (tab.dataset.tab === 'beam') calcBeam();
        else if (tab.dataset.tab === 'focus') calcFocus();
        else if (tab.dataset.tab === 'chirp') calcChirp();
        else if (tab.dataset.tab === 'nlc') calcNLC();
        else if (tab.dataset.tab === 'bright') calcBrightness();
        else if (tab.dataset.tab === 'modes') calcModes();
      });
    });
  });

  /* ================================================================ */
  /*  Constants                                                        */
  /* ================================================================ */
  const c_nm_fs = 299.792458;  // speed of light in nm/fs
  const c_m_s = 299792458;     // speed of light in m/s
  const ln2 = Math.log(2);

  const TBP: Record<string, number> = { gaussian: 0.4413, sech2: 0.3148, lorentzian: 0.2206 };
  const SHAPE_K: Record<string, number> = { gaussian: 0.9394, sech2: 0.8813, rect: 1.0 };

  // Sellmeier coefficients: n²(λ) = 1 + Σ Bᵢλ²/(λ²-Cᵢ)  where λ in µm
  const SELLMEIER: Record<string, { B: number[]; C: number[] }> = {
    sio2:     { B: [0.6961663, 0.4079426, 0.8974794], C: [0.0684043*0.0684043, 0.1162414*0.1162414, 9.896161*9.896161] },
    bk7:      { B: [1.03961212, 0.231792344, 1.01046945], C: [0.00600069867, 0.0200179144, 103.560653] },
    caf2:     { B: [0.5675888, 0.4710914, 3.8484723], C: [0.050263605*0.050263605, 0.1003909*0.1003909, 34.649040*34.649040] },
    sapphire: { B: [1.4313493, 0.65054713, 5.3414021], C: [0.0726631*0.0726631, 0.1193242*0.1193242, 18.028251*18.028251] },
    sf10:     { B: [1.62153902, 0.256287842, 1.64447552], C: [0.0122241457, 0.0595736775, 147.468793] },
  };

  /** Compute GVD (fs²/mm) from Sellmeier coefficients at wavelength λ (nm). */
  function sellmeierGVD(mat: string, lam_nm: number): number {
    const s = SELLMEIER[mat];
    if (!s) return NaN;
    const lam = lam_nm / 1000;  // µm
    const lam2 = lam * lam;
    // n(λ) and derivatives via finite differences (robust and simple)
    const dl = 0.0001; // µm step
    function nAtLam(l: number): number {
      const l2 = l * l;
      let n2 = 1;
      for (let i = 0; i < s.B.length; i++) n2 += s.B[i] * l2 / (l2 - s.C[i]);
      return Math.sqrt(n2);
    }
    const n0 = nAtLam(lam);
    const np = nAtLam(lam + dl);
    const nm = nAtLam(lam - dl);
    const d2n = (np - 2 * n0 + nm) / (dl * dl);  // d²n/dλ² in 1/µm²
    // GVD = (λ³/(2πc²)) × d²n/dλ²  — but we want fs²/mm
    // c = 299792.458 µm/ps = 0.299792458 µm/fs
    const c_um_fs = 0.299792458;
    const gvd = (lam * lam * lam) / (2 * Math.PI * c_um_fs * c_um_fs) * d2n;  // fs²/µm
    return gvd * 1000;  // fs²/mm
  }

  /* ================================================================ */
  /*  Helpers                                                          */
  /* ================================================================ */
  function el<T extends HTMLElement>(id: string) { return document.getElementById(id) as T; }

  function autoScale(val: number, units: [number, string][]): string {
    for (let i = units.length - 1; i >= 0; i--) {
      if (Math.abs(val) >= units[i][0] * 0.999) {
        return (val / units[i][0]).toPrecision(4) + ' ' + units[i][1];
      }
    }
    return val.toExponential(3) + ' ' + units[0][1];
  }

  const powerUnits: [number, string][] = [[1, 'W'], [1e3, 'kW'], [1e6, 'MW'], [1e9, 'GW'], [1e12, 'TW']];
  const energyUnits: [number, string][] = [[1e-15, 'fJ'], [1e-12, 'pJ'], [1e-9, 'nJ'], [1e-6, '\u00b5J'], [1e-3, 'mJ'], [1, 'J']];
  const timeUnits: [number, string][] = [[1e-15, 'fs'], [1e-12, 'ps'], [1e-9, 'ns']];

  function getActiveShape(containerId: string): string {
    const active = document.querySelector(`#${containerId} .preset-btn.active`) as HTMLElement | null;
    return active?.dataset.shape || 'gaussian';
  }

  function setupShapeButtons(containerId: string, onChange: () => void) {
    document.getElementById(containerId)!.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest('.preset-btn') as HTMLButtonElement | null;
      if (!btn) return;
      document.querySelectorAll(`#${containerId} .preset-btn`).forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      onChange();
    });
  }

  /* ================================================================ */
  /*  Calculator 1: Pulse ↔ Bandwidth                                 */
  /* ================================================================ */
  const tbpLam = el<HTMLInputElement>('tbp-lam');
  const tbpDlam = el<HTMLInputElement>('tbp-dlam');
  const tbpDt = el<HTMLInputElement>('tbp-dt');
  let tbpLastEdited: 'dlam' | 'dt' = 'dlam';

  function calcTBP() {
    const lam0 = parseFloat(tbpLam.value);
    const shape = getActiveShape('tbp-shape');
    const tbp = TBP[shape];
    if (!lam0 || lam0 <= 0) return;

    if (tbpLastEdited === 'dlam') {
      const dlam = parseFloat(tbpDlam.value);
      if (!dlam || dlam <= 0) return;
      // Δν = c · Δλ / λ²  (all in nm & fs → THz)
      const dnu_THz = c_nm_fs * dlam / (lam0 * lam0) * 1e3;  // ×1e3: nm/fs→THz
      const dt_TL_fs = tbp / (dnu_THz * 1e-3);  // TBP / (Δν in 1/fs) = TBP / (dnu_THz × 1e-3)
      tbpDt.value = dt_TL_fs.toFixed(1);
      el<HTMLElement>('tbp-out-dt').textContent = dt_TL_fs.toFixed(2) + ' fs';
      el<HTMLElement>('tbp-out-dnu').textContent = dnu_THz.toFixed(2) + ' THz';
      const cycles = dt_TL_fs / (lam0 / c_nm_fs);
      el<HTMLElement>('tbp-out-cycles').textContent = cycles.toFixed(1);
      el<HTMLElement>('tbp-out-ratio').textContent = `${tbp.toFixed(4)} (transform-limited)`;
      drawTBPCharts(lam0, dlam, dt_TL_fs, dnu_THz, shape);
    } else {
      const dt = parseFloat(tbpDt.value);
      if (!dt || dt <= 0) return;
      // Minimum Δν for this dt
      const dnu_min = tbp / (dt * 1e-3);  // dnu in THz: TBP / (dt_fs × 1e-3)
      const dlam = dnu_min * 1e-3 * lam0 * lam0 / c_nm_fs;
      tbpDlam.value = dlam.toFixed(2);
      el<HTMLElement>('tbp-out-dt').textContent = dt.toFixed(2) + ' fs (input)';
      el<HTMLElement>('tbp-out-dnu').textContent = dnu_min.toFixed(2) + ' THz (minimum)';
      const cycles = dt / (lam0 / c_nm_fs);
      el<HTMLElement>('tbp-out-cycles').textContent = cycles.toFixed(1);
      const actualTBP = dt * 1e-3 * dnu_min;
      el<HTMLElement>('tbp-out-ratio').textContent = `${actualTBP.toFixed(4)} / ${tbp.toFixed(4)} = 1.00`;
      drawTBPCharts(lam0, dlam, dt, dnu_min, shape);
    }
  }

  tbpDlam.addEventListener('input', () => { tbpLastEdited = 'dlam'; calcTBP(); });
  tbpDt.addEventListener('input', () => { tbpLastEdited = 'dt'; calcTBP(); });
  tbpLam.addEventListener('input', calcTBP);
  setupShapeButtons('tbp-shape', calcTBP);

  /* ================================================================ */
  /*  Calculator 2: Peak Power                                         */
  /* ================================================================ */
  function calcPeak() {
    const shape = getActiveShape('peak-shape');
    const k = SHAPE_K[shape];

    const pavg_raw = parseFloat(el<HTMLInputElement>('peak-pavg').value);
    const pavg_mul = parseFloat(el<HTMLSelectElement>('peak-pavg-u').value);
    const frep_raw = parseFloat(el<HTMLInputElement>('peak-frep').value);
    const frep_mul = parseFloat(el<HTMLSelectElement>('peak-frep-u').value);
    const dt_raw = parseFloat(el<HTMLInputElement>('peak-dt').value);
    const dt_mul = parseFloat(el<HTMLSelectElement>('peak-dt-u').value);

    if (!pavg_raw || !frep_raw || !dt_raw) return;

    const P_avg = pavg_raw * pavg_mul;    // W
    const f_rep = frep_raw * frep_mul;    // Hz
    const dt = dt_raw * dt_mul;           // s

    const E = P_avg / f_rep;              // J
    const P_peak = k * E / dt;            // W
    const duty = dt * f_rep;

    el<HTMLElement>('peak-out-energy').textContent = autoScale(E, energyUnits);
    el<HTMLElement>('peak-out-ppeak').textContent = autoScale(P_peak, powerUnits);
    el<HTMLElement>('peak-out-duty').textContent = duty.toExponential(2);
    el<HTMLElement>('peak-out-ratio').textContent = (P_peak / P_avg).toExponential(3) + '\u00d7';
    drawPeakChart(P_avg, P_peak, f_rep, dt, shape);
  }

  ['peak-pavg', 'peak-frep', 'peak-dt'].forEach(id => el<HTMLInputElement>(id).addEventListener('input', calcPeak));
  ['peak-pavg-u', 'peak-frep-u', 'peak-dt-u'].forEach(id => el<HTMLSelectElement>(id).addEventListener('change', calcPeak));
  setupShapeButtons('peak-shape', calcPeak);

  /* ================================================================ */
  /*  Calculator 3: Dispersion (GDD)                                   */
  /* ================================================================ */
  const gddMat = el<HTMLSelectElement>('gdd-mat');
  const gddWl = el<HTMLInputElement>('gdd-wl');
  const gddGvd = el<HTMLInputElement>('gdd-gvd');

  function updateGVD() {
    const mat = gddMat.value;
    if (mat === 'custom') {
      gddGvd.readOnly = false;
      gddGvd.style.opacity = '1';
    } else {
      gddGvd.readOnly = true;
      gddGvd.style.opacity = '0.7';
      const wl = parseFloat(gddWl.value);
      if (!wl || wl <= 0) return;
      const val = sellmeierGVD(mat, wl);
      gddGvd.value = isNaN(val) ? '\u2014' : val.toFixed(2);
    }
    calcGDD();
  }

  function calcGDD() {
    const dt_in = parseFloat(el<HTMLInputElement>('gdd-dt').value);
    const gvd = parseFloat(gddGvd.value);
    const L = parseFloat(el<HTMLInputElement>('gdd-L').value);
    const passes = parseInt(el<HTMLInputElement>('gdd-passes').value) || 1;

    if (!dt_in || isNaN(gvd) || !L) return;

    const GDD = gvd * L * passes;  // fs²
    const ratio = 4 * ln2 * GDD / (dt_in * dt_in);
    const dt_out = dt_in * Math.sqrt(1 + ratio * ratio);
    const factor = dt_out / dt_in;

    el<HTMLElement>('gdd-out-gdd').textContent = GDD.toFixed(1) + ' fs\u00b2';
    el<HTMLElement>('gdd-out-dt').textContent = dt_out.toFixed(2) + ' fs';
    el<HTMLElement>('gdd-out-factor').textContent = factor.toFixed(3) + '\u00d7';

    drawGDDChart(dt_in, gvd, passes);
  }

  gddMat.addEventListener('change', updateGVD);
  gddWl.addEventListener('input', updateGVD);
  gddGvd.addEventListener('input', calcGDD);
  el<HTMLInputElement>('gdd-dt').addEventListener('input', calcGDD);
  el<HTMLInputElement>('gdd-L').addEventListener('input', calcGDD);
  el<HTMLInputElement>('gdd-passes').addEventListener('input', calcGDD);

  /* ---- GDD chart ---- */
  function drawGDDChart(dt_in: number, gvd: number, passes: number) {
    const canvas = el<HTMLCanvasElement>('gdd-chart');
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    const fs = Math.max(0.7, Math.min(1, W / 500));

    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, W, H);

    const ml = 50 * fs, mr = 16 * fs, mt = 12 * fs, mb = 36 * fs;
    const pw = W - ml - mr, ph = H - mt - mb;
    if (pw < 10 || ph < 10) return;

    const L_input = parseFloat(el<HTMLInputElement>('gdd-L').value) || 10;
    const L_max = Math.max(L_input * 2, 1);
    const nPts = 200;

    // Compute curve
    const xs = new Float64Array(nPts);
    const ys = new Float64Array(nPts);
    let yMax = dt_in;
    for (let i = 0; i < nPts; i++) {
      const L = (i / (nPts - 1)) * L_max;
      const GDD = gvd * L * passes;
      const r = 4 * ln2 * GDD / (dt_in * dt_in);
      xs[i] = L;
      ys[i] = dt_in * Math.sqrt(1 + r * r);
      if (ys[i] > yMax) yMax = ys[i];
    }
    yMax *= 1.15;

    const font = getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif';

    // Grid
    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 0.5;
    for (let i = 0; i <= 4; i++) {
      const y = mt + (i / 4) * ph;
      ctx.beginPath(); ctx.moveTo(ml, y); ctx.lineTo(ml + pw, y); ctx.stroke();
    }

    // Curve
    ctx.beginPath();
    ctx.strokeStyle = ct.primary;
    ctx.lineWidth = 2;
    for (let i = 0; i < nPts; i++) {
      const x = ml + (xs[i] / L_max) * pw;
      const y = mt + ph - (ys[i] / yMax) * ph;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.stroke();

    // Operating point
    const opX = ml + (L_input / L_max) * pw;
    const GDD_op = gvd * L_input * passes;
    const r_op = 4 * ln2 * GDD_op / (dt_in * dt_in);
    const dt_op = dt_in * Math.sqrt(1 + r_op * r_op);
    const opY = mt + ph - (dt_op / yMax) * ph;
    ctx.beginPath();
    ctx.arc(opX, opY, 4, 0, 2 * Math.PI);
    ctx.fillStyle = ct.primary;
    ctx.fill();

    // Dashed vertical from operating point
    ctx.save();
    ctx.setLineDash([3, 3]);
    ctx.strokeStyle = ct.textMuted;
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(opX, opY); ctx.lineTo(opX, mt + ph); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(opX, opY); ctx.lineTo(ml, opY); ctx.stroke();
    ctx.restore();

    // Axis labels
    ctx.fillStyle = ct.textSoft;
    ctx.font = `${11 * fs}px ${font}`;
    ctx.textAlign = 'center';

    // x-axis
    for (let i = 0; i <= 4; i++) {
      const v = (i / 4) * L_max;
      ctx.fillText(v.toFixed(1), ml + (i / 4) * pw, mt + ph + 14 * fs);
    }
    ctx.font = `${12 * fs}px ${font}`;
    ctx.fillText('Thickness (mm)', ml + pw / 2, mt + ph + 30 * fs);

    // y-axis
    ctx.textAlign = 'right';
    ctx.font = `${11 * fs}px ${font}`;
    for (let i = 0; i <= 4; i++) {
      const v = yMax * (1 - i / 4);
      ctx.fillText(v.toFixed(0), ml - 6 * fs, mt + (i / 4) * ph + 4 * fs);
    }
    ctx.save();
    ctx.translate(12 * fs, mt + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.font = `${12 * fs}px ${font}`;
    ctx.fillText('\u0394t (fs)', 0, 0);
    ctx.restore();
  }

  function redrawAll() { calcTBP(); calcPeak(); calcGDD(); calcBeam(); calcFocus(); calcChirp(); calcNLC(); calcBrightness(); calcModes(); }
  onThemeChange(redrawAll);
  window.addEventListener('resize', redrawAll);

  /* ================================================================ */
  /*  Chart: TBP — dual temporal + spectral profiles                   */
  /* ================================================================ */
  const PULSE_FN: Record<string, (t: number) => number> = {
    gaussian:   (t) => Math.exp(-4 * ln2 * t * t),
    sech2:      (t) => 1 / Math.pow(Math.cosh(1.7627 * t), 2),
    lorentzian: (t) => 1 / (1 + 4 * t * t),
  };

  function drawProfileChart(
    canvasId: string, label: string, xLabel: string, hw: number, unit: string,
    shape: string, color: string
  ) {
    const canvas = el<HTMLCanvasElement>(canvasId);
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    const fs = Math.max(0.65, Math.min(1, W / 300));
    const font = getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif';

    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, W, H);

    const ml = 10 * fs, mr = 10 * fs, mt = 20 * fs, mb = 32 * fs;
    const pw = W - ml - mr, ph = H - mt - mb;
    if (pw < 10 || ph < 10) return;

    const fn = PULSE_FN[shape] || PULSE_FN.gaussian;
    const xRange = 3; // in units of FWHM

    // Filled profile
    ctx.beginPath();
    ctx.moveTo(ml, mt + ph);
    const nPts = 150;
    for (let i = 0; i <= nPts; i++) {
      const t = -xRange + (2 * xRange * i) / nPts;
      const y = fn(t);
      const px = ml + (i / nPts) * pw;
      const py = mt + ph - y * ph;
      ctx.lineTo(px, py);
    }
    ctx.lineTo(ml + pw, mt + ph);
    ctx.closePath();
    ctx.fillStyle = color + '20';
    ctx.fill();

    // Curve outline
    ctx.beginPath();
    for (let i = 0; i <= nPts; i++) {
      const t = -xRange + (2 * xRange * i) / nPts;
      const y = fn(t);
      const px = ml + (i / nPts) * pw;
      const py = mt + ph - y * ph;
      i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
    }
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.stroke();

    // FWHM arrow at 0.5 height
    const halfY = mt + ph - 0.5 * ph;
    const leftX = ml + ((xRange - 0.5) / (2 * xRange)) * pw;
    const rightX = ml + ((xRange + 0.5) / (2 * xRange)) * pw;
    ctx.strokeStyle = ct.textSoft;
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 2]);
    ctx.beginPath(); ctx.moveTo(ml, halfY); ctx.lineTo(ml + pw, halfY); ctx.stroke();
    ctx.setLineDash([]);

    // Arrow heads
    ctx.fillStyle = color;
    ctx.beginPath(); ctx.moveTo(leftX, halfY); ctx.lineTo(leftX + 5, halfY - 3); ctx.lineTo(leftX + 5, halfY + 3); ctx.fill();
    ctx.beginPath(); ctx.moveTo(rightX, halfY); ctx.lineTo(rightX - 5, halfY - 3); ctx.lineTo(rightX - 5, halfY + 3); ctx.fill();
    ctx.strokeStyle = color; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(leftX, halfY); ctx.lineTo(rightX, halfY); ctx.stroke();

    // FWHM label
    ctx.fillStyle = color;
    ctx.font = `bold ${11 * fs}px ${font}`;
    ctx.textAlign = 'center';
    ctx.fillText(`${hw.toFixed(1)} ${unit}`, (leftX + rightX) / 2, halfY - 6 * fs);

    // Title
    ctx.fillStyle = ct.text;
    ctx.font = `600 ${12 * fs}px ${font}`;
    ctx.textAlign = 'left';
    ctx.fillText(label, ml + 4, mt - 6 * fs);

    // X-axis label
    ctx.fillStyle = ct.textMuted;
    ctx.font = `${10 * fs}px ${font}`;
    ctx.textAlign = 'center';
    ctx.fillText(xLabel, ml + pw / 2, mt + ph + 22 * fs);

    // Baseline
    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 0.5;
    ctx.beginPath(); ctx.moveTo(ml, mt + ph); ctx.lineTo(ml + pw, mt + ph); ctx.stroke();
  }

  function drawTBPCharts(lam0: number, dlam: number, dt_fs: number, dnu_THz: number, shape: string) {
    const ct = chartTheme();
    drawProfileChart('tbp-chart-time', 'Temporal', 'Time (fs)', dt_fs, 'fs', shape, ct.primary);
    drawProfileChart('tbp-chart-spec', 'Spectral', `Wavelength around ${lam0.toFixed(0)} nm`, dlam, 'nm', shape, '#EC4899');
  }

  /* ================================================================ */
  /*  Chart: Peak Power — pulse train diagram                          */
  /* ================================================================ */
  function drawPeakChart(P_avg: number, P_peak: number, f_rep: number, dt_s: number, shape: string) {
    const canvas = el<HTMLCanvasElement>('peak-chart');
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    const fs = Math.max(0.65, Math.min(1, W / 500));
    const font = getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif';

    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, W, H);

    const ml = 60 * fs, mr = 16 * fs, mt = 20 * fs, mb = 32 * fs;
    const pw = W - ml - mr, ph = H - mt - mb;
    if (pw < 10 || ph < 10) return;

    // Show 4 pulses
    const T_rep = 1 / f_rep;
    const nPulses = 4;
    const tTotal = T_rep * nPulses;
    const pulseWidthPx = Math.max(2, (dt_s / tTotal) * pw * 6); // exaggerate for visibility

    const fn = PULSE_FN[shape] || PULSE_FN.gaussian;

    // Baseline
    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 0.5;
    ctx.beginPath(); ctx.moveTo(ml, mt + ph); ctx.lineTo(ml + pw, mt + ph); ctx.stroke();

    // P_avg dashed line
    const avgY = mt + ph - (P_avg / P_peak) * ph;
    ctx.save();
    ctx.setLineDash([5, 4]);
    ctx.strokeStyle = '#EC4899';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(ml, avgY); ctx.lineTo(ml + pw, avgY); ctx.stroke();
    ctx.restore();

    // P_avg label
    ctx.fillStyle = '#EC4899';
    ctx.font = `${10 * fs}px ${font}`;
    ctx.textAlign = 'right';
    ctx.fillText('P\u2090\u1D65\u1D4D', ml - 4 * fs, avgY + 3 * fs);

    // Draw pulses
    for (let p = 0; p < nPulses; p++) {
      const centerX = ml + ((p + 0.5) / nPulses) * pw;
      const halfW = pulseWidthPx * 3;

      // Filled pulse
      ctx.beginPath();
      ctx.moveTo(centerX - halfW, mt + ph);
      const steps = 60;
      for (let i = 0; i <= steps; i++) {
        const frac = -1 + (2 * i) / steps;
        const t = frac * 3;
        const y = fn(t);
        const px = centerX + frac * halfW;
        const py = mt + ph - y * ph;
        ctx.lineTo(px, py);
      }
      ctx.lineTo(centerX + halfW, mt + ph);
      ctx.closePath();
      ctx.fillStyle = ct.primary + '25';
      ctx.fill();

      // Outline
      ctx.beginPath();
      for (let i = 0; i <= steps; i++) {
        const frac = -1 + (2 * i) / steps;
        const t = frac * 3;
        const y = fn(t);
        const px = centerX + frac * halfW;
        const py = mt + ph - y * ph;
        i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
      }
      ctx.strokeStyle = ct.primary;
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    // P_peak label
    ctx.fillStyle = ct.primary;
    ctx.font = `bold ${10 * fs}px ${font}`;
    ctx.textAlign = 'right';
    ctx.fillText('P\u209A\u2091\u2090\u2096', ml - 4 * fs, mt + 10 * fs);

    // Rep rate arrow between pulse 1 and 2
    const c1 = ml + (0.5 / nPulses) * pw;
    const c2 = ml + (1.5 / nPulses) * pw;
    const arrowY = mt + ph + 14 * fs;
    ctx.strokeStyle = ct.textSoft;
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(c1, arrowY); ctx.lineTo(c2, arrowY); ctx.stroke();
    // Arrow heads
    ctx.fillStyle = ct.textSoft;
    ctx.beginPath(); ctx.moveTo(c1, arrowY); ctx.lineTo(c1 + 5, arrowY - 3); ctx.lineTo(c1 + 5, arrowY + 3); ctx.fill();
    ctx.beginPath(); ctx.moveTo(c2, arrowY); ctx.lineTo(c2 - 5, arrowY - 3); ctx.lineTo(c2 - 5, arrowY + 3); ctx.fill();

    ctx.fillStyle = ct.textSoft;
    ctx.font = `${10 * fs}px ${font}`;
    ctx.textAlign = 'center';
    const repLabel = f_rep >= 1e9 ? `${(f_rep/1e9).toPrecision(3)} GHz`
                   : f_rep >= 1e6 ? `${(f_rep/1e6).toPrecision(3)} MHz`
                   : f_rep >= 1e3 ? `${(f_rep/1e3).toPrecision(3)} kHz`
                   : `${f_rep.toPrecision(3)} Hz`;
    ctx.fillText(`1/f\u1D63\u2091\u209A = ${repLabel}`, (c1 + c2) / 2, arrowY + 12 * fs);

    // Y-axis: P_peak and 0
    ctx.fillStyle = ct.textSoft;
    ctx.font = `${10 * fs}px ${font}`;
    ctx.textAlign = 'right';
    ctx.fillText(autoScale(P_peak, powerUnits), ml - 4 * fs, mt + 3 * fs);
    ctx.fillText('0', ml - 4 * fs, mt + ph + 3 * fs);
  }

  /* ================================================================ */
  /*  Calculator 4: Gaussian Beam                                      */
  /* ================================================================ */
  const BEAM_FWHM_DIAMETER_PER_W0 = Math.sqrt(2 * ln2);
  const BEAM_1E_INTENSITY_RADIUS_PER_W0 = 1 / Math.sqrt(2);
  const beamW1eInput = el<HTMLInputElement>('beam-w1e');
  const beamW0Input = el<HTMLInputElement>('beam-w0');
  const beamFwhmInput = el<HTMLInputElement>('beam-fwhm');
  let beamWaistLastEdited: 'w1e' | 'w0' | 'fwhm' = 'w0';

  function formatBeamWaist(value: number): string {
    if (!Number.isFinite(value)) return '';
    const digits = value >= 10 ? 2 : value >= 1 ? 3 : 4;
    return value.toFixed(digits).replace(/\.?0+$/, '');
  }

  function getBeamW0(): number {
    if (beamWaistLastEdited === 'fwhm') {
      return parseFloat(beamFwhmInput.value) / BEAM_FWHM_DIAMETER_PER_W0;
    }
    if (beamWaistLastEdited === 'w1e') {
      return parseFloat(beamW1eInput.value) / BEAM_1E_INTENSITY_RADIUS_PER_W0;
    }
    return parseFloat(beamW0Input.value);
  }

  function syncBeamWaistFields(w0_um: number) {
    if (!Number.isFinite(w0_um) || w0_um <= 0) return;
    if (beamWaistLastEdited !== 'w1e') beamW1eInput.value = formatBeamWaist(w0_um * BEAM_1E_INTENSITY_RADIUS_PER_W0);
    if (beamWaistLastEdited !== 'w0') beamW0Input.value = formatBeamWaist(w0_um);
    if (beamWaistLastEdited !== 'fwhm') beamFwhmInput.value = formatBeamWaist(w0_um * BEAM_FWHM_DIAMETER_PER_W0);
  }

  function calcBeam() {
    const lam_nm = parseFloat(el<HTMLInputElement>('beam-lam').value);
    const w0_um = getBeamW0();
    const M2 = parseFloat(el<HTMLInputElement>('beam-M2').value) || 1;
    const z_mm = parseFloat(el<HTMLInputElement>('beam-z').value);

    if (!lam_nm || !w0_um || !z_mm) return;
    syncBeamWaistFields(w0_um);

    const lam_um = lam_nm / 1000;
    const zR_um = Math.PI * w0_um * w0_um / (M2 * lam_um);
    const zR_mm = zR_um / 1000;
    const theta_rad = M2 * lam_um / (Math.PI * w0_um);  // half-angle
    const theta_mrad = theta_rad * 1000;
    const wz_um = w0_um * Math.sqrt(1 + (z_mm / zR_mm) * (z_mm / zR_mm));

    // Format zR
    const zrStr = zR_mm >= 1 ? zR_mm.toFixed(2) + ' mm' : (zR_um).toFixed(1) + ' \u00b5m';
    el<HTMLElement>('beam-out-zr').textContent = zrStr;
    el<HTMLElement>('beam-out-div').textContent = theta_mrad < 1 ? theta_mrad.toFixed(3) + ' mrad' : theta_mrad.toFixed(2) + ' mrad';
    const confStr = zR_mm * 2 >= 1 ? (zR_mm * 2).toFixed(2) + ' mm' : (zR_um * 2).toFixed(1) + ' \u00b5m';
    el<HTMLElement>('beam-out-conf').textContent = confStr;
    el<HTMLElement>('beam-out-wz').textContent = wz_um >= 1000 ? (wz_um / 1000).toFixed(3) + ' mm' : wz_um.toFixed(2) + ' \u00b5m';

    drawBeamChart(w0_um, zR_mm, z_mm, M2);
  }

  let beamChartState = { ml: 0, pw: 0, mt: 0, ph: 0, zMax: 1, fs: 1 };

  function drawBeamChart(w0_um: number, zR_mm: number, z_eval_mm: number, M2: number) {
    const canvas = el<HTMLCanvasElement>('beam-chart');
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    if (rect.width === 0) return;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    const fs = Math.max(0.65, Math.min(1, W / 500));
    const font = getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif';

    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, W, H);

    const ml = 50 * fs, mr = 16 * fs, mt = 12 * fs, mb = 32 * fs;
    const pw = W - ml - mr, ph = H - mt - mb;
    if (pw < 10 || ph < 10) return;

    const zMax = Math.max(z_eval_mm * 1.5, zR_mm * 4);
    beamChartState = { ml, pw, mt, ph, zMax, fs };
    const nPts = 200;

    // Compute w(z) for positive z and mirror
    let wMax = w0_um;
    const ws = new Float64Array(nPts);
    for (let i = 0; i < nPts; i++) {
      const z = (i / (nPts - 1)) * zMax;
      const w = w0_um * Math.sqrt(1 + (z / zR_mm / 1000 * 1000) * (z / zR_mm) * 1);
      // recalculate properly: z in mm, zR in mm
      const ratio = z / zR_mm;
      ws[i] = w0_um * Math.sqrt(1 + ratio * ratio);
      if (ws[i] > wMax) wMax = ws[i];
    }
    wMax *= 1.15;

    // Draw symmetric beam envelope (top and bottom)
    const toX = (z: number) => ml + (z / zMax) * pw;
    const toY = (w: number) => mt + ph / 2 - (w / wMax) * (ph / 2);
    const toYn = (w: number) => mt + ph / 2 + (w / wMax) * (ph / 2);

    // Filled beam
    ctx.beginPath();
    for (let i = 0; i < nPts; i++) {
      const x = toX((i / (nPts - 1)) * zMax);
      const y = toY(ws[i]);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    for (let i = nPts - 1; i >= 0; i--) {
      const x = toX((i / (nPts - 1)) * zMax);
      const y = toYn(ws[i]);
      ctx.lineTo(x, y);
    }
    ctx.closePath();
    ctx.fillStyle = ct.primary + '18';
    ctx.fill();

    // Upper and lower envelope
    ctx.strokeStyle = ct.primary;
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let i = 0; i < nPts; i++) {
      const x = toX((i / (nPts - 1)) * zMax);
      i === 0 ? ctx.moveTo(x, toY(ws[i])) : ctx.lineTo(x, toY(ws[i]));
    }
    ctx.stroke();
    ctx.beginPath();
    for (let i = 0; i < nPts; i++) {
      const x = toX((i / (nPts - 1)) * zMax);
      i === 0 ? ctx.moveTo(x, toYn(ws[i])) : ctx.lineTo(x, toYn(ws[i]));
    }
    ctx.stroke();

    // Axis line (beam center)
    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 0.5;
    ctx.beginPath(); ctx.moveTo(ml, mt + ph / 2); ctx.lineTo(ml + pw, mt + ph / 2); ctx.stroke();

    // z_R marker
    const zrX = toX(zR_mm);
    if (zrX < ml + pw) {
      ctx.save();
      ctx.setLineDash([4, 3]);
      ctx.strokeStyle = '#EC4899';
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(zrX, mt); ctx.lineTo(zrX, mt + ph); ctx.stroke();
      ctx.restore();
      ctx.fillStyle = '#EC4899';
      ctx.font = `${10 * fs}px ${font}`;
      ctx.textAlign = 'center';
      ctx.fillText('z\u1D63', zrX, mt + ph + 14 * fs);
    }

    // Evaluation point
    const evalX = toX(z_eval_mm);
    if (evalX <= ml + pw) {
      const ratio = z_eval_mm / zR_mm;
      const wEval = w0_um * Math.sqrt(1 + ratio * ratio);
      ctx.save();
      ctx.setLineDash([3, 3]);
      ctx.strokeStyle = ct.textMuted;
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(evalX, mt); ctx.lineTo(evalX, mt + ph); ctx.stroke();
      ctx.restore();
      // w(z) arrow
      ctx.fillStyle = ct.primary;
      ctx.font = `bold ${10 * fs}px ${font}`;
      ctx.textAlign = 'left';
      ctx.fillText(`w = ${wEval >= 1000 ? (wEval/1000).toFixed(2) + ' mm' : wEval.toFixed(1) + ' \u00b5m'}`, evalX + 4 * fs, toY(wEval) - 4 * fs);
    }

    // w₀ label at z=0
    ctx.fillStyle = ct.primary;
    ctx.font = `bold ${10 * fs}px ${font}`;
    ctx.textAlign = 'right';
    ctx.fillText(`w\u2080 = ${w0_um.toFixed(1)} \u00b5m`, ml - 4 * fs, mt + ph / 2 - 4 * fs);

    // X-axis labels
    ctx.fillStyle = ct.textSoft;
    ctx.font = `${11 * fs}px ${font}`;
    ctx.textAlign = 'center';
    for (let i = 0; i <= 4; i++) {
      const v = (i / 4) * zMax;
      ctx.fillText(v.toFixed(1), ml + (i / 4) * pw, mt + ph + 14 * fs);
    }
    ctx.font = `${12 * fs}px ${font}`;
    ctx.fillText('z (mm)', ml + pw / 2, mt + ph + 28 * fs);
  }

  beamW1eInput.addEventListener('input', () => { beamWaistLastEdited = 'w1e'; calcBeam(); });
  beamW0Input.addEventListener('input', () => { beamWaistLastEdited = 'w0'; calcBeam(); });
  beamFwhmInput.addEventListener('input', () => { beamWaistLastEdited = 'fwhm'; calcBeam(); });
  beamW1eInput.addEventListener('blur', () => syncBeamWaistFields(getBeamW0()));
  beamW0Input.addEventListener('blur', () => syncBeamWaistFields(getBeamW0()));
  beamFwhmInput.addEventListener('blur', () => syncBeamWaistFields(getBeamW0()));
  ['beam-lam', 'beam-M2', 'beam-z'].forEach(id =>
    el<HTMLInputElement>(id).addEventListener('input', calcBeam)
  );

  // Click on beam chart to set evaluation distance
  el<HTMLCanvasElement>('beam-chart').style.cursor = 'crosshair';
  el<HTMLCanvasElement>('beam-chart').addEventListener('click', (e) => {
    const rect = el<HTMLCanvasElement>('beam-chart').getBoundingClientRect();
    const x = e.clientX - rect.left;
    const { ml, pw, zMax } = beamChartState;
    const frac = (x - ml) / pw;
    if (frac < 0 || frac > 1) return;
    const z_mm = frac * zMax;
    el<HTMLInputElement>('beam-z').value = z_mm.toFixed(3);
    calcBeam();
  });

  /* ================================================================ */
  /*  Calculator 5: Focus & Fluence                                    */
  /* ================================================================ */
  function calcFocus() {
    const lam_nm = parseFloat(el<HTMLInputElement>('foc-lam').value);
    const d_mm = parseFloat(el<HTMLInputElement>('foc-d').value);
    const M2 = parseFloat(el<HTMLInputElement>('foc-M2').value) || 1;
    const f_mm = parseFloat(el<HTMLInputElement>('foc-f').value);
    const E_raw = parseFloat(el<HTMLInputElement>('foc-energy').value);
    const E_mul = parseFloat(el<HTMLSelectElement>('foc-energy-u').value);
    const dt_fs = parseFloat(el<HTMLInputElement>('foc-dt').value);

    if (!lam_nm || !d_mm || !f_mm || !E_raw || !dt_fs) return;

    const lam_m = lam_nm * 1e-9;
    const w_in_m = (d_mm / 2) * 1e-3;         // input beam radius
    const f_m = f_mm * 1e-3;
    const E_J = E_raw * E_mul;
    const dt_s = dt_fs * 1e-15;

    // Focused spot: w0 = M² · λ · f / (π · w_in)
    const w0_m = M2 * lam_m * f_m / (Math.PI * w_in_m);
    const w0_um = w0_m * 1e6;
    const zR_m = Math.PI * w0_m * w0_m / (M2 * lam_m);
    const zR_um = zR_m * 1e6;

    // Peak power (assume Gaussian)
    const P_peak = 0.9394 * E_J / dt_s;

    // Intensity: I = P_peak / (π · w0²)
    const area_m2 = Math.PI * w0_m * w0_m;
    const area_cm2 = area_m2 * 1e4;
    const I_W_cm2 = P_peak / area_cm2;

    // Fluence: F = E / (π · w0²)
    const F_J_cm2 = E_J / area_cm2;

    // Display
    el<HTMLElement>('foc-out-w0').textContent = w0_um >= 1 ? w0_um.toFixed(2) + ' \u00b5m' : (w0_um * 1000).toFixed(1) + ' nm';
    el<HTMLElement>('foc-out-2w0').textContent = (w0_um * 2) >= 1 ? (w0_um * 2).toFixed(2) + ' \u00b5m' : (w0_um * 2000).toFixed(1) + ' nm';

    // Intensity formatting
    if (I_W_cm2 >= 1e15) el<HTMLElement>('foc-out-I').textContent = (I_W_cm2 / 1e15).toPrecision(3) + ' PW/cm\u00b2';
    else if (I_W_cm2 >= 1e12) el<HTMLElement>('foc-out-I').textContent = (I_W_cm2 / 1e12).toPrecision(3) + ' TW/cm\u00b2';
    else if (I_W_cm2 >= 1e9) el<HTMLElement>('foc-out-I').textContent = (I_W_cm2 / 1e9).toPrecision(3) + ' GW/cm\u00b2';
    else if (I_W_cm2 >= 1e6) el<HTMLElement>('foc-out-I').textContent = (I_W_cm2 / 1e6).toPrecision(3) + ' MW/cm\u00b2';
    else if (I_W_cm2 >= 1e3) el<HTMLElement>('foc-out-I').textContent = (I_W_cm2 / 1e3).toPrecision(3) + ' kW/cm\u00b2';
    else el<HTMLElement>('foc-out-I').textContent = I_W_cm2.toPrecision(3) + ' W/cm\u00b2';

    // Fluence formatting
    if (F_J_cm2 >= 1) el<HTMLElement>('foc-out-F').textContent = F_J_cm2.toPrecision(3) + ' J/cm\u00b2';
    else if (F_J_cm2 >= 1e-3) el<HTMLElement>('foc-out-F').textContent = (F_J_cm2 * 1e3).toPrecision(3) + ' mJ/cm\u00b2';
    else el<HTMLElement>('foc-out-F').textContent = (F_J_cm2 * 1e6).toPrecision(3) + ' \u00b5J/cm\u00b2';

    const zrStr = zR_um >= 1000 ? (zR_um / 1000).toFixed(2) + ' mm' : zR_um.toFixed(1) + ' \u00b5m';
    el<HTMLElement>('foc-out-zr').textContent = zrStr;
    el<HTMLElement>('foc-out-dof').textContent = zR_um * 2 >= 1000 ? (zR_um * 2 / 1000).toFixed(2) + ' mm' : (zR_um * 2).toFixed(1) + ' \u00b5m';

    drawFocusChart(w0_um, zR_um, I_W_cm2);
  }

  function drawFocusChart(w0_um: number, zR_um: number, I_peak: number) {
    const canvas = el<HTMLCanvasElement>('foc-chart');
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    if (rect.width === 0) return;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    const fs = Math.max(0.65, Math.min(1, W / 500));
    const font = getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif';

    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, W, H);

    const ml = 16 * fs, mr = 16 * fs, mt = 12 * fs, mb = 32 * fs;
    const pw = W - ml - mr, ph = H - mt - mb;
    if (pw < 10 || ph < 10) return;

    // Draw symmetric focused beam envelope: z from -3zR to +3zR
    const zRange = zR_um * 3;
    const nPts = 200;
    const wMax = w0_um * Math.sqrt(1 + 9) * 1.1;  // w at 3*zR

    const toX = (z: number) => ml + ((z + zRange) / (2 * zRange)) * pw;
    const toY = (w: number) => mt + ph / 2 - (w / wMax) * (ph / 2);
    const toYn = (w: number) => mt + ph / 2 + (w / wMax) * (ph / 2);

    // Intensity color gradient fill
    ctx.beginPath();
    for (let i = 0; i < nPts; i++) {
      const z = -zRange + (2 * zRange * i) / (nPts - 1);
      const ratio = z / zR_um;
      const w = w0_um * Math.sqrt(1 + ratio * ratio);
      const x = toX(z);
      i === 0 ? ctx.moveTo(x, toY(w)) : ctx.lineTo(x, toY(w));
    }
    for (let i = nPts - 1; i >= 0; i--) {
      const z = -zRange + (2 * zRange * i) / (nPts - 1);
      const ratio = z / zR_um;
      const w = w0_um * Math.sqrt(1 + ratio * ratio);
      ctx.lineTo(toX(z), toYn(w));
    }
    ctx.closePath();

    // Gradient: bright at center, fading at edges
    const grad = ctx.createRadialGradient(
      toX(0), mt + ph / 2, 0,
      toX(0), mt + ph / 2, pw / 2
    );
    grad.addColorStop(0, ct.primary + '40');
    grad.addColorStop(1, ct.primary + '08');
    ctx.fillStyle = grad;
    ctx.fill();

    // Envelope lines
    ctx.strokeStyle = ct.primary;
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let i = 0; i < nPts; i++) {
      const z = -zRange + (2 * zRange * i) / (nPts - 1);
      const w = w0_um * Math.sqrt(1 + (z / zR_um) * (z / zR_um));
      const x = toX(z);
      i === 0 ? ctx.moveTo(x, toY(w)) : ctx.lineTo(x, toY(w));
    }
    ctx.stroke();
    ctx.beginPath();
    for (let i = 0; i < nPts; i++) {
      const z = -zRange + (2 * zRange * i) / (nPts - 1);
      const w = w0_um * Math.sqrt(1 + (z / zR_um) * (z / zR_um));
      ctx.lineTo(toX(z), toYn(w));
    }
    ctx.stroke();

    // Center axis
    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 0.5;
    ctx.beginPath(); ctx.moveTo(ml, mt + ph / 2); ctx.lineTo(ml + pw, mt + ph / 2); ctx.stroke();

    // z_R markers (both sides)
    ctx.save();
    ctx.setLineDash([4, 3]);
    ctx.strokeStyle = '#EC4899';
    ctx.lineWidth = 1.5;
    const zrXp = toX(zR_um), zrXn = toX(-zR_um);
    ctx.beginPath(); ctx.moveTo(zrXp, mt); ctx.lineTo(zrXp, mt + ph); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(zrXn, mt); ctx.lineTo(zrXn, mt + ph); ctx.stroke();
    ctx.restore();

    // z_R labels
    ctx.fillStyle = '#EC4899';
    ctx.font = `${10 * fs}px ${font}`;
    ctx.textAlign = 'center';
    ctx.fillText('+z\u1D63', zrXp, mt + ph + 14 * fs);
    ctx.fillText('\u2212z\u1D63', zrXn, mt + ph + 14 * fs);

    // w₀ and 2w₀ labels at focus
    const focX = toX(0);
    ctx.fillStyle = ct.primary;
    ctx.font = `bold ${10 * fs}px ${font}`;
    ctx.textAlign = 'center';
    const w0Label = w0_um >= 1 ? `w\u2080 = ${w0_um.toFixed(1)} \u00b5m` : `w\u2080 = ${(w0_um * 1000).toFixed(0)} nm`;
    ctx.fillText(w0Label, focX, toY(w0_um) - 6 * fs);

    // DOF arrow
    ctx.strokeStyle = ct.textSoft;
    ctx.lineWidth = 1;
    const dofY = mt + ph + 22 * fs;
    ctx.beginPath(); ctx.moveTo(zrXn, dofY); ctx.lineTo(zrXp, dofY); ctx.stroke();
    ctx.fillStyle = ct.textSoft;
    ctx.beginPath(); ctx.moveTo(zrXn, dofY); ctx.lineTo(zrXn + 5, dofY - 3); ctx.lineTo(zrXn + 5, dofY + 3); ctx.fill();
    ctx.beginPath(); ctx.moveTo(zrXp, dofY); ctx.lineTo(zrXp - 5, dofY - 3); ctx.lineTo(zrXp - 5, dofY + 3); ctx.fill();
    ctx.font = `${10 * fs}px ${font}`;
    ctx.textAlign = 'center';
    const dofLabel = zR_um * 2 >= 1000 ? `DOF = ${(zR_um * 2 / 1000).toFixed(1)} mm` : `DOF = ${(zR_um * 2).toFixed(0)} \u00b5m`;
    ctx.fillText(dofLabel, focX, dofY - 6 * fs);
  }

  ['foc-lam', 'foc-d', 'foc-M2', 'foc-f', 'foc-energy', 'foc-dt'].forEach(id =>
    el<HTMLInputElement>(id).addEventListener('input', calcFocus)
  );
  ['foc-energy-u'].forEach(id =>
    el<HTMLSelectElement>(id).addEventListener('change', calcFocus)
  );

  /* ================================================================ */
  /*  Calculator 6: Nonlinear Conversion                               */
  /* ================================================================ */
  const hc_eV_nm = 1239.84193;  // h·c in eV·nm

  function nlcProcess(): string { return getActiveShape('nlc-process'); }

  function calcNLC() {
    const proc = nlcProcess();
    const lam1 = parseFloat(el<HTMLInputElement>('nlc-lam1').value);
    if (!lam1 || lam1 <= 0) return;
    const lam2 = parseFloat(el<HTMLInputElement>('nlc-lam2').value);

    const lam2Field = el<HTMLElement>('nlc-lam2-field');
    const sigItem = el<HTMLElement>('nlc-sig-item');
    const idlItem = el<HTMLElement>('nlc-idl-item');
    const noteEl = el<HTMLElement>('nlc-note');

    // Hide/show λ₂ and signal/idler fields based on process
    const needsLam2 = proc === 'sfg' || proc === 'dfg' || proc === 'opa';
    lam2Field.style.display = needsLam2 ? 'flex' : 'none';
    sigItem.style.display = proc === 'opa' ? '' : 'none';
    idlItem.style.display = proc === 'opa' ? '' : 'none';

    let lamOut = 0;
    let lamSig = 0, lamIdl = 0;

    switch (proc) {
      case 'shg':
        lamOut = lam1 / 2;
        noteEl.innerHTML = '<strong>SHG.</strong> \u03c9 + \u03c9 \u2192 2\u03c9. \u03bb<sub>out</sub> = \u03bb/2.';
        break;
      case 'thg':
        lamOut = lam1 / 3;
        noteEl.innerHTML = '<strong>THG.</strong> \u03c9 + \u03c9 + \u03c9 \u2192 3\u03c9. \u03bb<sub>out</sub> = \u03bb/3.';
        break;
      case 'sfg':
        if (!lam2 || lam2 <= 0) return;
        lamOut = 1 / (1 / lam1 + 1 / lam2);
        noteEl.innerHTML = '<strong>SFG.</strong> 1/\u03bb<sub>out</sub> = 1/\u03bb<sub>1</sub> + 1/\u03bb<sub>2</sub>.';
        break;
      case 'dfg':
        if (!lam2 || lam2 <= 0) return;
        lamOut = 1 / Math.abs(1 / lam1 - 1 / lam2);
        noteEl.innerHTML = '<strong>DFG.</strong> 1/\u03bb<sub>out</sub> = |1/\u03bb<sub>1</sub> \u2212 1/\u03bb<sub>2</sub>|.';
        break;
      case 'opa':
        if (!lam2 || lam2 <= 0) return;
        if (lam2 <= lam1) {
          el<HTMLElement>('nlc-out-lam').textContent = '\u2014';
          el<HTMLElement>('nlc-out-ev').textContent = 'Signal must be longer than pump';
          return;
        }
        // λ1 = pump, λ2 = signal → idler from energy conservation
        // 1/λ_pump = 1/λ_signal + 1/λ_idler
        lamSig = lam2;
        lamIdl = 1 / (1 / lam1 - 1 / lam2);
        lamOut = lamIdl;
        noteEl.innerHTML = '<strong>OPA.</strong> \u03bb<sub>1</sub> = pump, \u03bb<sub>2</sub> = signal (\u03bb<sub>s</sub> > \u03bb<sub>p</sub>). 1/\u03bb<sub>p</sub> = 1/\u03bb<sub>s</sub> + 1/\u03bb<sub>i</sub>.';
        break;
    }

    if (lamOut <= 0 || !isFinite(lamOut)) {
      el<HTMLElement>('nlc-out-lam').textContent = 'Invalid';
      el<HTMLElement>('nlc-out-ev').textContent = '\u2014';
      return;
    }

    const evOut = hc_eV_nm / lamOut;
    el<HTMLElement>('nlc-out-lam').textContent = lamOut >= 100 ? lamOut.toFixed(1) + ' nm' : lamOut.toFixed(3) + ' nm';
    el<HTMLElement>('nlc-out-ev').textContent = evOut.toFixed(4) + ' eV';

    if (proc === 'opa') {
      el<HTMLElement>('nlc-out-sig').textContent = lamSig.toFixed(1) + ' nm (' + (hc_eV_nm / lamSig).toFixed(3) + ' eV)';
      if (lamIdl > 0 && isFinite(lamIdl))
        el<HTMLElement>('nlc-out-idl').textContent = lamIdl.toFixed(1) + ' nm (' + (hc_eV_nm / lamIdl).toFixed(3) + ' eV)';
      else
        el<HTMLElement>('nlc-out-idl').textContent = 'Signal must be longer than pump';
    }

    drawNLCChart(proc, lam1, lam2, lamOut, lamSig, lamIdl);
  }

  // Wavelength to visible color (approximate)
  function wlToColor(nm: number): string {
    if (nm < 380) return '#7F00FF';      // UV → violet
    if (nm < 440) return `hsl(${270 - (nm - 380) / 60 * 30}, 100%, 50%)`;
    if (nm < 490) return `hsl(${240 - (nm - 440) / 50 * 60}, 100%, 50%)`;
    if (nm < 510) return `hsl(${180 - (nm - 490) / 20 * 60}, 100%, 45%)`;
    if (nm < 580) return `hsl(${120 - (nm - 510) / 70 * 60}, 100%, 45%)`;
    if (nm < 645) return `hsl(${60 - (nm - 580) / 65 * 60}, 100%, 50%)`;
    if (nm < 780) return `hsl(0, 100%, ${50 - (nm - 645) / 135 * 20}%)`;
    return '#880000';  // IR → dark red
  }

  function drawNLCChart(proc: string, lam1: number, lam2: number, lamOut: number, lamSig: number, lamIdl: number) {
    const canvas = el<HTMLCanvasElement>('nlc-chart');
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    if (rect.width === 0) return;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    const fs = Math.max(0.65, Math.min(1, W / 500));
    const font = getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif';

    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, W, H);

    // Spectral axis layout
    const ml = 50 * fs, mr = 16 * fs, mt = 16 * fs, mb = 38 * fs;
    const pw = W - ml - mr, ph = H - mt - mb;
    if (pw < 10 || ph < 10) return;

    // Collect wavelengths
    const photons: { lam: number; label: string; kind: 'in' | 'out' }[] = [];
    if (proc === 'shg') {
      photons.push({ lam: lam1, label: '\u03c9', kind: 'in' });
      photons.push({ lam: lamOut, label: '2\u03c9', kind: 'out' });
    } else if (proc === 'thg') {
      photons.push({ lam: lam1, label: '\u03c9', kind: 'in' });
      photons.push({ lam: lamOut, label: '3\u03c9', kind: 'out' });
    } else if (proc === 'sfg') {
      photons.push({ lam: lam1, label: '\u03c9\u2081', kind: 'in' });
      if (lam2 > 0) photons.push({ lam: lam2, label: '\u03c9\u2082', kind: 'in' });
      if (lamOut > 0 && isFinite(lamOut)) photons.push({ lam: lamOut, label: '\u03c9\u2081+\u03c9\u2082', kind: 'out' });
    } else if (proc === 'dfg') {
      photons.push({ lam: lam1, label: '\u03c9\u2081', kind: 'in' });
      if (lam2 > 0) photons.push({ lam: lam2, label: '\u03c9\u2082', kind: 'in' });
      if (lamOut > 0 && isFinite(lamOut)) photons.push({ lam: lamOut, label: '\u0394\u03c9', kind: 'out' });
    } else if (proc === 'opa') {
      photons.push({ lam: lam1, label: 'pump', kind: 'in' });
      if (lamSig > 0) photons.push({ lam: lamSig, label: 'signal', kind: 'out' });
      if (lamIdl > 0 && isFinite(lamIdl)) photons.push({ lam: lamIdl, label: 'idler', kind: 'out' });
    }

    const allLam = photons.map(p => p.lam).filter(l => l > 0 && isFinite(l));
    if (allLam.length === 0) return;
    const lamMin = Math.min(...allLam) * 0.7;
    const lamMax = Math.max(...allLam) * 1.4;

    // Log scale for wavelength axis
    const logMin = Math.log10(lamMin);
    const logMax = Math.log10(lamMax);
    const toX = (lam: number) => ml + ((Math.log10(lam) - logMin) / (logMax - logMin)) * pw;

    // Visible spectrum background band (380–780 nm)
    const visL = Math.max(380, lamMin);
    const visR = Math.min(780, lamMax);
    if (visR > visL) {
      const x1 = toX(visL), x2 = toX(visR);
      const grad = ctx.createLinearGradient(x1, 0, x2, 0);
      const visStops = [380, 440, 490, 510, 580, 645, 780];
      const visColors = ['#7F00FF', '#0000FF', '#00BFFF', '#00FF00', '#FFFF00', '#FF0000', '#880000'];
      for (let i = 0; i < visStops.length; i++) {
        const s = visStops[i];
        if (s >= visL && s <= visR) {
          grad.addColorStop((s - visL) / (visR - visL), visColors[i] + '25');
        }
      }
      ctx.fillStyle = grad;
      ctx.fillRect(x1, mt, x2 - x1, ph);
    }

    // Axis baseline
    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(ml, mt + ph); ctx.lineTo(ml + pw, mt + ph); ctx.stroke();

    // Wavelength ticks (log scale)
    ctx.fillStyle = ct.textSoft;
    ctx.font = `${10 * fs}px ${font}`;
    ctx.textAlign = 'center';
    const tickValues = [100, 200, 300, 400, 500, 600, 800, 1000, 1500, 2000, 3000, 5000, 10000];
    for (const tv of tickValues) {
      if (tv >= lamMin && tv <= lamMax) {
        const x = toX(tv);
        ctx.fillStyle = ct.grid;
        ctx.fillRect(x, mt + ph, 1, 4);
        ctx.fillStyle = ct.textSoft;
        ctx.fillText(tv >= 1000 ? (tv / 1000).toFixed(1) + ' \u00b5m' : tv + '', x, mt + ph + 16 * fs);
      }
    }
    ctx.font = `${12 * fs}px ${font}`;
    ctx.fillText('Wavelength', ml + pw / 2, mt + ph + 32 * fs);

    // Draw photon bars
    const barW = Math.max(6, 16 * fs);
    for (const p of photons) {
      const x = toX(p.lam);
      const color = wlToColor(p.lam);
      const isOut = p.kind === 'out';
      const barH = isOut ? ph * 0.85 : ph * 0.6;
      const barY = mt + ph - barH;

      // Bar with glow
      ctx.fillStyle = color + '30';
      ctx.fillRect(x - barW / 2 - 2, barY, barW + 4, barH);
      ctx.fillStyle = color;
      ctx.fillRect(x - barW / 2, barY, barW, barH);

      // Output bars get a highlight
      if (isOut) {
        ctx.strokeStyle = color;
        ctx.lineWidth = 2;
        ctx.strokeRect(x - barW / 2 - 1, barY - 1, barW + 2, barH + 2);
      }

      // Label above bar
      ctx.fillStyle = ct.text;
      ctx.font = `bold ${11 * fs}px ${font}`;
      ctx.textAlign = 'center';
      ctx.fillText(p.label, x, barY - 14 * fs);

      // Wavelength value
      ctx.font = `${10 * fs}px ${font}`;
      ctx.fillStyle = ct.textSoft;
      const lamStr = p.lam >= 1000 ? (p.lam / 1000).toFixed(2) + ' \u00b5m' : p.lam.toFixed(0) + ' nm';
      ctx.fillText(lamStr, x, barY - 3 * fs);

      // "in"/"out" tag
      ctx.font = `${8 * fs}px ${font}`;
      ctx.fillStyle = isOut ? '#059669' : ct.textMuted;
      ctx.fillText(isOut ? 'OUT' : 'IN', x, mt + ph - 4 * fs);
    }

    // Arrow from input centroid to each output
    const ins = photons.filter(p => p.kind === 'in');
    const outs = photons.filter(p => p.kind === 'out');
    if (ins.length > 0 && outs.length > 0) {
      const inCx = ins.reduce((s, p) => s + toX(p.lam), 0) / ins.length;
      const arrowY = mt + ph * 0.5;
      for (const o of outs) {
        const outX = toX(o.lam);
        const dir = outX > inCx ? 1 : -1;
        const aStart = inCx + dir * (barW + 4);
        const aEnd = outX - dir * (barW + 4);
        if (Math.abs(aEnd - aStart) < 10) continue;
        ctx.strokeStyle = ct.textMuted;
        ctx.lineWidth = 1.5;
        ctx.setLineDash([4, 3]);
        ctx.beginPath(); ctx.moveTo(aStart, arrowY); ctx.lineTo(aEnd, arrowY); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = ct.textMuted;
        ctx.beginPath();
        ctx.moveTo(aEnd, arrowY);
        ctx.lineTo(aEnd - dir * 8, arrowY - 4);
        ctx.lineTo(aEnd - dir * 8, arrowY + 4);
        ctx.fill();
      }
    }
  }

  el<HTMLInputElement>('nlc-lam1').addEventListener('input', calcNLC);
  el<HTMLInputElement>('nlc-lam2').addEventListener('input', calcNLC);
  setupShapeButtons('nlc-process', calcNLC);

  /* ================================================================ */
  /*  Calculator 7: Brightness                                         */
  /* ================================================================ */

  // Reference sources for comparison (peak spectral brightness in ph/s/mm²/mrad²/0.1%BW)
  // We'll show a log-scale bar chart comparing the user's source to known references.
  const BRIGHTNESS_REFS: { name: string; bpeak: number; color: string }[] = [
    { name: 'Thermal (lamp)',    bpeak: 1e10,  color: '#9CA3AF' },
    { name: 'Synchrotron (3rd gen)', bpeak: 1e20, color: '#60A5FA' },
    { name: 'HHG table-top',    bpeak: 1e22,  color: '#A78BFA' },
    { name: 'XFEL',             bpeak: 1e33,  color: '#F87171' },
  ];

  function calcBrightness() {
    const pavg_raw = parseFloat(el<HTMLInputElement>('brt-pavg').value);
    const pavg_mul = parseFloat(el<HTMLSelectElement>('brt-pavg-u').value);
    const frep_raw = parseFloat(el<HTMLInputElement>('brt-frep').value);
    const frep_mul = parseFloat(el<HTMLSelectElement>('brt-frep-u').value);
    const dt_fs = parseFloat(el<HTMLInputElement>('brt-dt').value);
    const lam_nm = parseFloat(el<HTMLInputElement>('brt-lam').value);
    const dlam_nm = parseFloat(el<HTMLInputElement>('brt-dlam').value);
    const w0_um = parseFloat(el<HTMLInputElement>('brt-w0').value);
    const M2 = parseFloat(el<HTMLInputElement>('brt-M2').value) || 1;

    if (!pavg_raw || !frep_raw || !dt_fs || !lam_nm || !dlam_nm || !w0_um) return;

    const P_avg = pavg_raw * pavg_mul;
    const f_rep = frep_raw * frep_mul;
    const dt_s = dt_fs * 1e-15;
    const E_J = P_avg / f_rep;
    const P_peak = 0.9394 * E_J / dt_s;

    // Spectral power density (W/nm)
    const S_avg = P_avg / dlam_nm;
    const S_peak = P_peak / dlam_nm;

    // Spectral brightness: B = P / (Δλ × M⁴ × λ²)
    // With λ in mm, Δλ in mm → B in W/(mm² × mrad²) per nm bandwidth
    // Actually let's use consistent units:
    // A·Ω = M⁴λ² where λ in m → A·Ω in m²·sr
    // B = P/(Δλ × A·Ω) with Δλ in nm → need to convert
    // Let's compute in SI then display nicely

    const lam_m = lam_nm * 1e-9;
    const AO = M2 * M2 * M2 * M2 * lam_m * lam_m;  // m²·sr

    // Convert Δλ to Δν for "per 0.1% bandwidth" comparison
    // 0.1% BW at λ₀: Δλ_01 = λ₀ × 0.001
    // Spectral density per 0.1%BW = S × (λ₀ × 0.001)
    const dlam_01 = lam_nm * 0.001;  // 0.1% bandwidth in nm

    // Brightness in W/(m²·sr) per 0.1%BW
    const B_avg_01 = (P_avg / (AO)) * (dlam_01 / dlam_nm);
    const B_peak_01 = (P_peak / (AO)) * (dlam_01 / dlam_nm);

    // Convert to photons/s: divide by photon energy
    const hc = 6.626e-34 * 2.998e8;
    const E_photon = hc / lam_m;
    const B_avg_ph = B_avg_01 / E_photon;    // ph/s/mm²/mrad² (per 0.1%BW) — need to convert m²·sr → mm²·mrad²
    // 1 m² = 1e6 mm², 1 sr = 1e6 mrad² → 1 m²·sr = 1e12 mm²·mrad²
    // So B in ph/s/(m²·sr)/0.1%BW → B in ph/s/(mm²·mrad²)/0.1%BW = B / 1e12
    const B_avg_ph_display = B_avg_01 / E_photon / 1e12;
    const B_peak_ph_display = B_peak_01 / E_photon / 1e12;

    // Display
    el<HTMLElement>('brt-out-energy').textContent = autoScale(E_J, energyUnits);
    el<HTMLElement>('brt-out-ppeak').textContent = autoScale(P_peak, powerUnits);

    // Spectral density
    if (S_avg >= 1) el<HTMLElement>('brt-out-savg').textContent = S_avg.toPrecision(3) + ' W/nm';
    else if (S_avg >= 1e-3) el<HTMLElement>('brt-out-savg').textContent = (S_avg * 1e3).toPrecision(3) + ' mW/nm';
    else el<HTMLElement>('brt-out-savg').textContent = (S_avg * 1e6).toPrecision(3) + ' \u00b5W/nm';

    if (S_peak >= 1e6) el<HTMLElement>('brt-out-speak').textContent = (S_peak / 1e6).toPrecision(3) + ' MW/nm';
    else if (S_peak >= 1e3) el<HTMLElement>('brt-out-speak').textContent = (S_peak / 1e3).toPrecision(3) + ' kW/nm';
    else el<HTMLElement>('brt-out-speak').textContent = S_peak.toPrecision(3) + ' W/nm';

    // Brightness
    el<HTMLElement>('brt-out-bavg').textContent = B_avg_ph_display.toExponential(2) + ' ph/s/mm\u00b2/mrad\u00b2/0.1%BW';
    el<HTMLElement>('brt-out-bpeak').textContent = B_peak_ph_display.toExponential(2) + ' ph/s/mm\u00b2/mrad\u00b2/0.1%BW';

    drawBrightnessChart(B_peak_ph_display);
  }

  function drawBrightnessChart(userBpeak: number) {
    const canvas = el<HTMLCanvasElement>('brt-chart');
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    if (rect.width === 0) return;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    const fs = Math.max(0.65, Math.min(1, W / 500));
    const font = getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif';

    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, W, H);

    const ml = 110 * fs, mr = 50 * fs, mt = 16 * fs, mb = 36 * fs;
    const pw = W - ml - mr, ph = H - mt - mb;
    if (pw < 10 || ph < 10) return;

    // All entries: references + user
    const entries = [
      ...BRIGHTNESS_REFS.map(r => ({ name: r.name, val: r.bpeak, color: r.color })),
      { name: 'Your source', val: userBpeak, color: ct.primary },
    ];

    // Log scale range
    const allVals = entries.map(e => e.val).filter(v => v > 0);
    const logMin = Math.floor(Math.log10(Math.min(...allVals))) - 1;
    const logMax = Math.ceil(Math.log10(Math.max(...allVals))) + 1;
    const logRange = logMax - logMin;

    const barH = Math.min(24 * fs, ph / entries.length - 6 * fs);
    const gap = (ph - barH * entries.length) / (entries.length + 1);

    // Grid lines (powers of 10)
    ctx.strokeStyle = ct.grid;
    ctx.lineWidth = 0.5;
    ctx.fillStyle = ct.textMuted;
    ctx.font = `${9 * fs}px ${font}`;
    ctx.textAlign = 'center';
    for (let p = logMin; p <= logMax; p += 3) {
      const x = ml + ((p - logMin) / logRange) * pw;
      ctx.beginPath(); ctx.moveTo(x, mt); ctx.lineTo(x, mt + ph); ctx.stroke();
      ctx.fillText(`10${superscript(p)}`, x, mt + ph + 14 * fs);
    }

    // X-axis label
    ctx.font = `${10 * fs}px ${font}`;
    ctx.fillText('Peak brightness (ph/s/mm\u00b2/mrad\u00b2/0.1%BW)', ml + pw / 2, mt + ph + 30 * fs);

    // Bars
    for (let i = 0; i < entries.length; i++) {
      const e = entries[i];
      const y = mt + gap + i * (barH + gap);
      const logVal = e.val > 0 ? Math.log10(e.val) : logMin;
      const barW = Math.max(2, ((logVal - logMin) / logRange) * pw);

      // Bar
      ctx.fillStyle = e.color + '30';
      ctx.fillRect(ml, y, barW, barH);
      ctx.fillStyle = e.color;
      ctx.fillRect(ml, y, barW, barH);
      ctx.globalAlpha = 0.3;
      ctx.fillRect(ml, y, barW, barH);
      ctx.globalAlpha = 1;

      // Solid left edge
      ctx.fillStyle = e.color;
      ctx.fillRect(ml + barW - 3, y, 3, barH);

      // Label
      ctx.fillStyle = ct.text;
      ctx.font = `${10 * fs}px ${font}`;
      ctx.textAlign = 'right';
      ctx.fillText(e.name, ml - 6 * fs, y + barH / 2 + 3 * fs);

      // Value at end of bar
      ctx.fillStyle = ct.textSoft;
      ctx.font = `${9 * fs}px ${font}`;
      ctx.textAlign = 'left';
      ctx.fillText(e.val.toExponential(1), ml + barW + 4 * fs, y + barH / 2 + 3 * fs);
    }
  }

  // Unicode superscript digits for axis labels
  function superscript(n: number): string {
    const sup: Record<string, string> = { '-': '\u207B', '0': '\u2070', '1': '\u00B9', '2': '\u00B2', '3': '\u00B3', '4': '\u2074', '5': '\u2075', '6': '\u2076', '7': '\u2077', '8': '\u2078', '9': '\u2079' };
    return String(n).split('').map(c => sup[c] || c).join('');
  }

  ['brt-pavg', 'brt-frep', 'brt-dt', 'brt-lam', 'brt-dlam', 'brt-w0', 'brt-M2'].forEach(id =>
    el<HTMLInputElement>(id).addEventListener('input', calcBrightness)
  );
  ['brt-pavg-u', 'brt-frep-u'].forEach(id =>
    el<HTMLSelectElement>(id).addEventListener('change', calcBrightness)
  );

  /* ================================================================ */
  /*  Calculator: Chirp / Compressor                                   */
  /* ================================================================ */
  function calcChirp() {
    const dt_actual = parseFloat(el<HTMLInputElement>('chirp-dt').value);
    const lam0 = parseFloat(el<HTMLInputElement>('chirp-lam').value);
    const dlam = parseFloat(el<HTMLInputElement>('chirp-dlam').value);
    const mat = el<HTMLSelectElement>('chirp-mat').value;

    if (!dt_actual || !lam0 || !dlam) return;

    // TL duration (Gaussian TBP)
    const dnu_THz = c_nm_fs * dlam / (lam0 * lam0) * 1e3;
    const dt_TL = TBP.gaussian / (dnu_THz * 1e-3);
    el<HTMLInputElement>('chirp-dtTL').value = dt_TL.toFixed(1);

    if (dt_actual < dt_TL) {
      el<HTMLElement>('chirp-out-ratio').textContent = 'Actual < TL (check inputs)';
      return;
    }

    const ratio = dt_actual / dt_TL;
    el<HTMLElement>('chirp-out-ratio').textContent = ratio.toFixed(2) + '\u00d7';

    // GDD from: dt_out = dt_TL * sqrt(1 + (4ln2 * GDD / dt_TL²)²)
    // → (dt_out/dt_TL)² = 1 + (4ln2 * GDD / dt_TL²)²
    // → GDD = ± dt_TL² * sqrt((dt_out/dt_TL)² - 1) / (4ln2)
    const gddAbs = dt_TL * dt_TL * Math.sqrt(ratio * ratio - 1) / (4 * ln2);
    el<HTMLElement>('chirp-out-gdd').textContent = '\u00b1' + gddAbs.toFixed(0) + ' fs\u00b2';
    el<HTMLElement>('chirp-out-comp').textContent = '\u2213' + gddAbs.toFixed(0) + ' fs\u00b2';

    // Material needed
    const gvd = sellmeierGVD(mat, lam0);
    if (!isNaN(gvd) && gvd !== 0) {
      const L_mm = Math.abs(gddAbs / gvd);
      const matNames: Record<string, string> = { sio2: 'fused silica', bk7: 'BK7', caf2: 'CaF\u2082', sapphire: 'sapphire', sf10: 'SF10' };
      el<HTMLElement>('chirp-out-mat').textContent = L_mm.toFixed(1) + ' mm ' + (matNames[mat] || mat) + ` (GVD = ${gvd.toFixed(1)} fs\u00b2/mm)`;
    }

    drawChirpChart(dt_TL, gddAbs);
  }

  function drawChirpChart(dt_TL: number, gdd_current: number) {
    const canvas = el<HTMLCanvasElement>('chirp-chart');
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    if (rect.width === 0) return;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    const fs = Math.max(0.65, Math.min(1, W / 500));
    const font = getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif';

    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, W, H);

    const ml = 50 * fs, mr = 16 * fs, mt = 12 * fs, mb = 36 * fs;
    const pw = W - ml - mr, ph = H - mt - mb;
    if (pw < 10 || ph < 10) return;

    // Plot: Δt vs GDD, symmetric around 0
    const gddMax = Math.max(gdd_current * 1.5, 100);
    const nPts = 200;
    let yMax = dt_TL;
    const xs = new Float64Array(nPts);
    const ys = new Float64Array(nPts);
    for (let i = 0; i < nPts; i++) {
      const gdd = -gddMax + (2 * gddMax * i) / (nPts - 1);
      const r = 4 * ln2 * gdd / (dt_TL * dt_TL);
      xs[i] = gdd;
      ys[i] = dt_TL * Math.sqrt(1 + r * r);
      if (ys[i] > yMax) yMax = ys[i];
    }
    yMax *= 1.15;

    // Grid
    ctx.strokeStyle = ct.grid; ctx.lineWidth = 0.5;
    for (let i = 0; i <= 4; i++) {
      const y = mt + (i / 4) * ph;
      ctx.beginPath(); ctx.moveTo(ml, y); ctx.lineTo(ml + pw, y); ctx.stroke();
    }
    // Zero GDD line
    const zeroX = ml + pw / 2;
    ctx.setLineDash([3, 3]); ctx.strokeStyle = ct.textMuted; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(zeroX, mt); ctx.lineTo(zeroX, mt + ph); ctx.stroke();
    ctx.setLineDash([]);

    // Curve
    ctx.beginPath(); ctx.strokeStyle = ct.primary; ctx.lineWidth = 2;
    for (let i = 0; i < nPts; i++) {
      const x = ml + ((xs[i] + gddMax) / (2 * gddMax)) * pw;
      const y = mt + ph - (ys[i] / yMax) * ph;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.stroke();

    // Operating points (±GDD)
    for (const sign of [-1, 1]) {
      const gdd = sign * gdd_current;
      const r = 4 * ln2 * gdd / (dt_TL * dt_TL);
      const dt = dt_TL * Math.sqrt(1 + r * r);
      const x = ml + ((gdd + gddMax) / (2 * gddMax)) * pw;
      const y = mt + ph - (dt / yMax) * ph;
      ctx.beginPath(); ctx.arc(x, y, 4, 0, 2 * Math.PI);
      ctx.fillStyle = sign > 0 ? '#EC4899' : '#10B981';
      ctx.fill();
    }

    // TL point at center
    const tlY = mt + ph - (dt_TL / yMax) * ph;
    ctx.beginPath(); ctx.arc(zeroX, tlY, 5, 0, 2 * Math.PI);
    ctx.fillStyle = ct.primary; ctx.fill();
    ctx.fillStyle = ct.primary; ctx.font = `bold ${10 * fs}px ${font}`;
    ctx.textAlign = 'left';
    ctx.fillText('TL', zeroX + 8 * fs, tlY + 3 * fs);

    // Axes
    ctx.fillStyle = ct.textSoft; ctx.font = `${11 * fs}px ${font}`; ctx.textAlign = 'center';
    for (let i = 0; i <= 4; i++) {
      const v = -gddMax + (i / 4) * 2 * gddMax;
      ctx.fillText(v.toFixed(0), ml + (i / 4) * pw, mt + ph + 14 * fs);
    }
    ctx.font = `${12 * fs}px ${font}`;
    ctx.fillText('GDD (fs\u00b2)', ml + pw / 2, mt + ph + 30 * fs);

    ctx.textAlign = 'right'; ctx.font = `${11 * fs}px ${font}`;
    for (let i = 0; i <= 4; i++) {
      const v = yMax * (1 - i / 4);
      ctx.fillText(v.toFixed(0), ml - 6 * fs, mt + (i / 4) * ph + 4 * fs);
    }
    ctx.save(); ctx.translate(12 * fs, mt + ph / 2); ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center'; ctx.font = `${12 * fs}px ${font}`;
    ctx.fillText('\u0394t (fs)', 0, 0); ctx.restore();
  }

  ['chirp-dt', 'chirp-lam', 'chirp-dlam'].forEach(id =>
    el<HTMLInputElement>(id).addEventListener('input', calcChirp)
  );
  el<HTMLSelectElement>('chirp-mat').addEventListener('change', calcChirp);

  /* ================================================================ */
  /*  Calculator: Beam Modes (LG / HG)                                 */
  /* ================================================================ */
  function modesFamily(): string { return getActiveShape('modes-family'); }

  // Generalized Laguerre polynomial L_p^|l|(x)
  function laguerreL(p: number, absL: number, x: number): number {
    if (p === 0) return 1;
    if (p === 1) return 1 + absL - x;
    let prev2 = 1, prev1 = 1 + absL - x;
    for (let k = 2; k <= p; k++) {
      const curr = ((2 * k - 1 + absL - x) * prev1 - (k - 1 + absL) * prev2) / k;
      prev2 = prev1; prev1 = curr;
    }
    return prev1;
  }

  // Hermite polynomial H_n(x)
  function hermiteH(n: number, x: number): number {
    if (n === 0) return 1;
    if (n === 1) return 2 * x;
    let prev2 = 1, prev1 = 2 * x;
    for (let k = 2; k <= n; k++) {
      const curr = 2 * x * prev1 - 2 * (k - 1) * prev2;
      prev2 = prev1; prev1 = curr;
    }
    return prev1;
  }

  function calcModes() {
    const family = modesFamily();
    const w0 = parseFloat(el<HTMLInputElement>('modes-w0').value) || 100;

    el<HTMLElement>('modes-lg-params').style.display = family === 'lg' ? '' : 'none';
    el<HTMLElement>('modes-hg-params').style.display = family === 'hg' ? '' : 'none';

    if (family === 'lg') {
      const l = parseInt(el<HTMLInputElement>('modes-l').value) || 0;
      const p = parseInt(el<HTMLInputElement>('modes-p').value) || 0;
      el<HTMLElement>('modes-out-label').textContent = `LG\u2097\u209A = LG${l},${p}`;
      el<HTMLElement>('modes-out-oam').textContent = l === 0 ? '0 (no OAM)' : `${l}\u210f per photon`;
      el<HTMLElement>('modes-note').innerHTML = `<strong>LG<sub>${l},${p}</sub>.</strong> ` +
        (l === 0 && p === 0 ? 'Fundamental Gaussian (TEM\u2080\u2080).' :
         l !== 0 && p === 0 ? `Donut mode with ${Math.abs(l)}\u210f OAM. Central null from phase singularity.` :
         `${p} radial node${p > 1 ? 's' : ''}, ${Math.abs(l)}\u210f OAM.`);
    } else {
      const m = parseInt(el<HTMLInputElement>('modes-m').value) || 0;
      const n = parseInt(el<HTMLInputElement>('modes-n').value) || 0;
      el<HTMLElement>('modes-out-label').textContent = `HG${m},${n} (TEM${m}${n})`;
      el<HTMLElement>('modes-out-oam').textContent = 'N/A (no OAM)';
      el<HTMLElement>('modes-note').innerHTML = `<strong>HG<sub>${m},${n}</sub>.</strong> ` +
        `${m} horizontal node${m !== 1 ? 's' : ''}, ${n} vertical node${n !== 1 ? 's' : ''}. ` +
        (m === 0 && n === 0 ? 'Fundamental Gaussian.' : `${(m + 1) * (n + 1)} lobes.`);
    }

    drawModesChart(family, w0);
  }

  function drawModesChart(family: string, w0: number) {
    const canvas = el<HTMLCanvasElement>('modes-chart');
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    if (rect.width === 0) return;
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    const fs = Math.max(0.65, Math.min(1, W / 500));

    ctx.fillStyle = ct.bg;
    ctx.fillRect(0, 0, W, H);

    const ml = 16 * fs, mr = 50 * fs, mt = 8 * fs, mb = 8 * fs;
    const side = Math.min(W - ml - mr, H - mt - mb);
    if (side < 10) return;
    const ox = ml + (W - ml - mr - side) / 2;
    const oy = mt + (H - mt - mb - side) / 2;

    const N = 200;
    const extent = 3; // in units of w0
    const imgData = ctx.createImageData(Math.round(side * dpr), Math.round(side * dpr));
    const pxW = imgData.width, pxH = imgData.height;

    // Inferno colormap
    const INFERNO: [number,number,number][] = [
      [0,0,4],[40,11,84],[101,21,110],[159,42,99],
      [212,72,66],[245,125,21],[250,193,39],[252,255,164],
    ];
    function inferno(t: number): [number,number,number] {
      t = Math.max(0, Math.min(1, t));
      const s = t * (INFERNO.length - 1);
      const i = Math.floor(s), f = s - i;
      const a = INFERNO[i], b = INFERNO[Math.min(i+1, INFERNO.length-1)];
      return [a[0]+f*(b[0]-a[0]), a[1]+f*(b[1]-a[1]), a[2]+f*(b[2]-a[2])];
    }

    let maxI = 0;

    // Precompute intensity
    const intensity = new Float64Array(pxW * pxH);
    for (let py = 0; py < pxH; py++) {
      const y = (1 - py / (pxH - 1)) * 2 * extent - extent; // in w0 units
      for (let px = 0; px < pxW; px++) {
        const x = (px / (pxW - 1)) * 2 * extent - extent;
        let I = 0;
        if (family === 'lg') {
          const l = parseInt(el<HTMLInputElement>('modes-l').value) || 0;
          const p = parseInt(el<HTMLInputElement>('modes-p').value) || 0;
          const r = Math.sqrt(x * x + y * y);
          const rho = r * Math.SQRT2;
          const rho2 = rho * rho;
          const L = laguerreL(p, Math.abs(l), rho2);
          I = Math.pow(rho, 2 * Math.abs(l)) * L * L * Math.exp(-rho2);
        } else {
          const m = parseInt(el<HTMLInputElement>('modes-m').value) || 0;
          const n = parseInt(el<HTMLInputElement>('modes-n').value) || 0;
          const hm = hermiteH(m, x * Math.SQRT2);
          const hn = hermiteH(n, y * Math.SQRT2);
          I = hm * hm * hn * hn * Math.exp(-2 * (x * x + y * y));
        }
        intensity[py * pxW + px] = I;
        if (I > maxI) maxI = I;
      }
    }

    // Render
    const invMax = maxI > 0 ? 1 / maxI : 1;
    for (let py = 0; py < pxH; py++) {
      for (let px = 0; px < pxW; px++) {
        const t = intensity[py * pxW + px] * invMax;
        const [r, g, b] = inferno(t);
        const off = (py * pxW + px) * 4;
        imgData.data[off] = r; imgData.data[off+1] = g; imgData.data[off+2] = b; imgData.data[off+3] = 255;
      }
    }
    ctx.putImageData(imgData, ox * dpr, oy * dpr);

    // Colorbar
    const cbW = 10 * fs, cbGap = 10 * fs;
    const cbX = ox + side + cbGap;
    const cbH = side * 0.7;
    const cbY = oy + (side - cbH) / 2;
    for (let i = 0; i < cbH; i++) {
      const t = 1 - i / cbH;
      const [r, g, b] = inferno(t);
      ctx.fillStyle = `rgb(${r},${g},${b})`;
      ctx.fillRect(cbX, cbY + i, cbW, 1);
    }
    ctx.strokeStyle = ct.textMuted; ctx.lineWidth = 0.5;
    ctx.strokeRect(cbX, cbY, cbW, cbH);

    const font = getComputedStyle(document.documentElement).getPropertyValue('--font').trim() || 'Inter, sans-serif';
    ctx.fillStyle = ct.textSoft; ctx.font = `${9 * fs}px ${font}`; ctx.textAlign = 'left';
    ctx.fillText('max', cbX + cbW + 3 * fs, cbY + 4 * fs);
    ctx.fillText('0', cbX + cbW + 3 * fs, cbY + cbH + 1 * fs);
  }

  setupShapeButtons('modes-family', calcModes);
  ['modes-l', 'modes-p', 'modes-m', 'modes-n', 'modes-w0'].forEach(id =>
    el<HTMLInputElement>(id).addEventListener('input', calcModes)
  );

  /* ================================================================ */
  /*  Export                                                           */
  /* ================================================================ */
  import { downloadBlob } from '../../lib/download';

  function getActiveTab(): string {
    return (document.querySelector('.calc-tab.active') as HTMLElement)?.dataset.tab || 'tbp';
  }

  document.getElementById('dl-png')!.addEventListener('click', () => {
    const tab = getActiveTab();
    const panel = document.getElementById(`panel-${tab}`);
    if (!panel) return;
    const canvases = panel.querySelectorAll<HTMLCanvasElement>('canvas');
    if (canvases.length === 0) return;

    // If single canvas, export directly. If dual (TBP), combine side by side.
    if (canvases.length === 1) {
      canvases[0].toBlob(b => { if (b) downloadBlob(b, `laser_${tab}.png`); }, 'image/png');
    } else {
      const totalW = Array.from(canvases).reduce((s, c) => s + c.width, 0);
      const maxH = Math.max(...Array.from(canvases).map(c => c.height));
      const ec = document.createElement('canvas');
      ec.width = totalW; ec.height = maxH;
      const ctx = ec.getContext('2d')!;
      let x = 0;
      for (const c of canvases) { ctx.drawImage(c, x, 0); x += c.width; }
      ec.toBlob(b => { if (b) downloadBlob(b, `laser_${tab}.png`); }, 'image/png');
    }
  });

  document.getElementById('dl-csv')!.addEventListener('click', () => {
    const tab = getActiveTab();
    const panel = document.getElementById(`panel-${tab}`);
    if (!panel) return;

    // Collect all result-value pairs from the active panel
    const items = panel.querySelectorAll('.result-item');
    const lines = [
      `# Laser Calculator — ${tab} tab`,
      '# Generated by NanophotonicsLab (nanophotonicslab.com)',
      'parameter,value',
    ];

    // Add input parameters
    const inputs = panel.querySelectorAll<HTMLInputElement | HTMLSelectElement>('.field-input');
    for (const inp of inputs) {
      const label = inp.closest('.field')?.querySelector('label')?.textContent?.trim() || inp.id;
      if (inp.value && !inp.readOnly) lines.push(`${label},${inp.value}`);
    }

    lines.push(''); // separator
    lines.push('# Results');

    for (const item of items) {
      const label = item.querySelector('.result-label')?.textContent?.trim() || '';
      const value = item.querySelector('.result-value')?.textContent?.trim() || '';
      if (value && value !== '—') lines.push(`${label},${value}`);
    }

    downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), `laser_${tab}.csv`);
  });

  /* ================================================================ */
  /*  Share / URL State                                                */
  /* ================================================================ */
  const SHARE_INPUTS = [
    'tbp-lam','tbp-dlam','tbp-dt',
    'peak-pavg','peak-frep','peak-dt',
    'gdd-dt','gdd-mat','gdd-wl','gdd-L','gdd-passes',
    'beam-lam','beam-w1e','beam-w0','beam-fwhm','beam-M2','beam-z',
    'foc-lam','foc-d','foc-M2','foc-f','foc-energy','foc-dt',
    'chirp-dt','chirp-lam','chirp-dlam','chirp-mat',
    'nlc-lam1','nlc-lam2',
    'brt-pavg','brt-frep','brt-dt','brt-lam','brt-dlam','brt-w0','brt-M2',
    'modes-l','modes-p','modes-m','modes-n','modes-w0',
  ];
  const SHARE_UNITS = [
    'peak-pavg-u','peak-frep-u','peak-dt-u',
    'foc-energy-u',
    'brt-pavg-u','brt-frep-u',
  ];
  const SHARE_SHAPES = ['tbp-shape','peak-shape','nlc-process','modes-family'];

  function serializeState(): string {
    const p = new URLSearchParams();
    const activeTab = document.querySelector('.calc-tab.active') as HTMLElement;
    if (activeTab?.dataset.tab) p.set('tab', activeTab.dataset.tab);
    for (const id of SHARE_INPUTS) {
      const inp = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
      if (inp && inp.value) p.set(id, inp.value);
    }
    for (const id of SHARE_UNITS) {
      const sel = document.getElementById(id) as HTMLSelectElement | null;
      if (sel) p.set(id, sel.value);
    }
    for (const id of SHARE_SHAPES) {
      const active = document.querySelector(`#${id} .preset-btn.active`) as HTMLElement | null;
      if (active?.dataset.shape) p.set(id, active.dataset.shape);
    }
    return p.toString();
  }

  function restoreState(): boolean {
    const hash = location.hash.slice(1);
    if (!hash) return false;
    const p = new URLSearchParams(hash);
    if (!p.has('tab')) return false;
    // Restore inputs
    for (const id of SHARE_INPUTS) {
      if (!p.has(id)) continue;
      const inp = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
      if (inp) inp.value = p.get(id)!;
    }
    // Restore unit selectors
    for (const id of SHARE_UNITS) {
      if (!p.has(id)) continue;
      const sel = document.getElementById(id) as HTMLSelectElement | null;
      if (sel) sel.value = p.get(id)!;
    }
    // Restore shape buttons
    for (const id of SHARE_SHAPES) {
      if (!p.has(id)) continue;
      const shape = p.get(id)!;
      const btn = document.querySelector(`#${id} .preset-btn[data-shape="${shape}"]`) as HTMLButtonElement | null;
      if (btn) {
        document.querySelectorAll(`#${id} .preset-btn`).forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      }
    }
    // Activate tab
    const tab = p.get('tab')!;
    const tabBtn = document.querySelector(`.calc-tab[data-tab="${tab}"]`) as HTMLButtonElement | null;
    if (tabBtn) tabBtn.click();
    return true;
  }

  const shareBtn = document.getElementById('dl-share')!;
  shareBtn.addEventListener('click', () => {
    const url = location.origin + location.pathname + '#' + serializeState();
    navigator.clipboard.writeText(url).then(() => {
      shareBtn.textContent = 'Copied!';
      setTimeout(() => {
        shareBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> Share';
      }, 1500);
    });
  });

  /* ================================================================ */
  /*  Init                                                             */
  /* ================================================================ */
  if (!restoreState()) {
    tbpDlam.value = '10';
    calcTBP();
  }
  moveDownloadBarToActivePanel();
  calcPeak();
  updateGVD();
</script>
