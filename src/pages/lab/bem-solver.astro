---
import Layout from '../../layouts/Layout.astro';
import ModelInfo from '../../components/ModelInfo.astro';
import PresetStrip from '../../components/PresetStrip.astro';
import ToolMeta from '../../components/ToolMeta.astro';
import ParamsDrawer from '../../components/ParamsDrawer.astro';
import '../../styles/lab.css';

const bemPresets = [
  { label: 'Au sphere in water', values: { 'shape-select': 'sphere', 'material-select': 'au', 'radius-input': 25, 'eps-medium-input': 1.77, 'wl-min-input': 400, 'wl-max-input': 800, 'wl-npoints-input': 20 } },
  { label: 'Ag nanorod in air', values: { 'shape-select': 'rod', 'material-select': 'ag', 'radius-input': 15, 'length-input': 100, 'eps-medium-input': 1.00, 'wl-min-input': 300, 'wl-max-input': 600, 'wl-npoints-input': 20 } },
  { label: 'Au nanorod in water', values: { 'shape-select': 'rod', 'material-select': 'au', 'radius-input': 20, 'length-input': 80, 'eps-medium-input': 1.77, 'wl-min-input': 400, 'wl-max-input': 900, 'wl-npoints-input': 25 } },
];
---

<Layout title="BEM Solver" description="Full-wave electromagnetic solver for nanoparticles — retarded BEM with 3D visualization, powered by Pyodide.">
  <section class="widget-hero">
    <div class="container">
      <a href={`${import.meta.env.BASE_URL}lab/`} class="back-link">&larr; Back to Lab</a>
      <h1>BEM <span class="gradient-text">Solver</span></h1>
      <p class="widget-hero__subtitle">
        Solve Maxwell's equations for metallic nanoparticles using Galerkin BEM with
        Raviart-Thomas elements. Compute cross-sections, near-field enhancement, and more
        — all in your browser.
      </p>
      <ToolMeta slug="bem-solver" name="BEM Solver" />
    </div>
  </section>

  <ModelInfo status="Experimental">
    <dl>
      <dt>Model</dt>
      <dd>Full-wave retarded boundary element method (BEM). Surface currents are expanded in Raviart&ndash;Thomas basis functions on a triangular mesh; Maxwell's equations are solved via surface integral equations.</dd>
      <dt>Assumptions</dt>
      <dd>Piecewise-homogeneous media (sharp interfaces), local and isotropic dielectric response, no spatial dispersion.</dd>
      <dt>Validity</dt>
      <dd>Applicable to arbitrary particle shapes and sizes. Accuracy depends on mesh quality — finer meshes improve convergence but increase computation time (runs in-browser via Pyodide).</dd>
      <dt>Limitations</dt>
      <dd>Browser memory limits mesh resolution (~1000 triangles practical). No periodic boundaries, no substrate, no non-local corrections. First load downloads ~35 MB (Pyodide + dependencies).</dd>
      <dt>References</dt>
      <dd>F. J. García de Abajo &amp; A. Howie, Phys. Rev. B <strong>65</strong>, 115418 (2002); U. Hohenester &amp; A. Trügler, Comp. Phys. Comm. <strong>183</strong>, 370 (2012).</dd>
    </dl>
  </ModelInfo>

  <section class="section">
    <div class="container">
      <div class="bem-layout">

        <!-- Left: Controls -->
        <ParamsDrawer>
        <div class="controls card">
          <PresetStrip presets={bemPresets} canvasId="spectrum-canvas" />
          <h3>Geometry</h3>
          <div class="param">
            <div class="param-header"><label>Shape</label></div>
            <select id="shape-select" class="param-select">
              <option value="sphere" selected>Sphere</option>
              <option value="rod">Nanorod</option>
            </select>
          </div>
          <div class="param">
            <div class="param-header">
              <label>Radius (nm)</label>
              <input type="number" class="param-number" id="radius-input" value="25" step="5" min="5" max="100">
            </div>
          </div>
          <div class="param" id="length-param" style="display:none">
            <div class="param-header">
              <label>Length (nm)</label>
              <input type="number" class="param-number" id="length-input" value="150" step="10" min="20" max="500">
            </div>
          </div>
          <div class="param">
            <div class="param-header">
              <label>Mesh density</label>
              <select id="subdivisions-input" class="param-select">
                <option value="1" selected>Low (80 faces) — fast</option>
                <option value="2">Medium (320 faces) — slow</option>
              </select>
            </div>
          </div>

          <h3>Material</h3>
          <div class="param">
            <div class="param-header"><label>Particle</label></div>
            <select id="material-select" class="param-select">
              <option value="au" selected>Gold (Au)</option>
              <option value="ag">Silver (Ag)</option>
            </select>
          </div>
          <div class="param">
            <div class="param-header">
              <label>Medium &epsilon;<sub>m</sub></label>
              <input type="number" class="param-number" id="eps-medium-input" value="1.77" step="0.01" min="1">
            </div>
            <div class="preset-row">
              <button class="preset-btn" data-eps="1.00">Air</button>
              <button class="preset-btn" data-eps="1.77">Water</button>
              <button class="preset-btn" data-eps="2.10">Oil</button>
              <button class="preset-btn" data-eps="2.25">Glass</button>
            </div>
          </div>

          <h3>Wavelength</h3>
          <div class="param">
            <div class="param-header">
              <label>&lambda; range (nm)</label>
            </div>
            <div class="range-row">
              <input type="number" class="param-number" id="wl-min-input" value="400" step="10" min="300">
              <span>&mdash;</span>
              <input type="number" class="param-number" id="wl-max-input" value="800" step="10" max="1000">
            </div>
          </div>
          <div class="param">
            <div class="param-header">
              <label>Points</label>
              <input type="number" class="param-number" id="wl-npoints-input" value="20" step="5" min="5" max="50">
            </div>
          </div>

          <div class="solve-row">
            <button id="solve-btn" class="btn btn--primary solve-btn" disabled data-umami-event="bem-solve">Solve</button>
            <button id="cancel-btn" class="btn btn--outline cancel-btn" style="display:none">Stop</button>
          </div>

          <div class="progress-bar">
            <div class="progress-fill" id="progress-fill"></div>
          </div>
          <p class="progress-text" id="progress-text">Loading solver...</p>
        </div>
        </ParamsDrawer>

        <!-- Center: 3D Viewport -->
        <div class="viewport-panel card">
          <div class="viewport-toolbar">
            <button id="wireframe-btn" class="toolbar-btn" title="Toggle wireframe">&#9634;</button>
            <button id="reset-view-btn" class="toolbar-btn" title="Reset camera">&#8634;</button>
          </div>
          <div id="viewport-container" class="viewport-canvas"></div>
          <canvas id="colorbar" class="colorbar-canvas" width="80" height="300" aria-label="Near-field intensity color scale"></canvas>
        </div>

        <!-- Right: Summary -->
        <div class="results-panel card">
          <h3>Summary</h3>
          <div id="summary-table" class="summary-table">
            <p class="text-muted">Run a solve to see results.</p>
          </div>
        </div>

      </div>

      <!-- Spectrum: full width below -->
      <div class="spectrum-panel card">
        <h3>Spectrum</h3>
        <canvas id="spectrum-canvas" class="spectrum-canvas" width="1200" height="400" aria-label="Cross-section spectrum"></canvas>
        <p class="hint">Click on the chart to select a wavelength for 3D field view.</p>
      </div>

      <!-- Status bar -->
      <div class="status-bar">
        <span id="status-text">Loading solver...</span>
      </div>
    </div>
  </section>
<script>
import { initPermalinks } from '../../lib/permalink';
initPermalinks({
  shape: 'shape-select',
  material: 'material-select',
  radius: 'radius-input',
  length: 'length-input',
  eps: 'eps-medium-input',
  wl_min: 'wl-min-input',
  wl_max: 'wl-max-input',
});
</script>
</Layout>

<script>
  import { initBEMSolver } from '../../scripts/bem/main';
  initBEMSolver();
</script>

<style>
  /* Three-column layout */
  .bem-layout {
    display: grid;
    grid-template-columns: 280px 1fr 240px;
    gap: var(--space-md);
    min-height: 500px;
  }
  @media (max-width: 1100px) {
    .bem-layout { grid-template-columns: 260px 1fr; }
    .results-panel { grid-column: 1 / -1; }
  }
  @media (max-width: 768px) {
    .bem-layout { grid-template-columns: 1fr; }
  }
  .spectrum-panel {
    margin-top: var(--space-md);
    padding: var(--space-md);
  }
  .spectrum-panel h3 {
    font-size: 0.85rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--text-soft);
    margin: 0 0 var(--space-sm);
  }
  .range-row {
    display: flex; align-items: center; gap: var(--space-xs);
  }
  .range-row .param-number { flex: 1; }
  .range-row span { color: var(--text-muted); }
  /* Solve / Cancel buttons */
  .solve-row {
    display: flex; gap: var(--space-sm); margin-top: var(--space-md);
  }
  .solve-btn {
    flex: 1; padding: 10px; font-size: 1rem; font-weight: 600;
  }
  .cancel-btn {
    padding: 10px 16px; font-size: 1rem; font-weight: 600;
    color: var(--rose); border-color: var(--rose);
  }
  .cancel-btn:hover {
    background: var(--rose); color: white;
  }
  .progress-text {
    font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;
    min-height: 1.2em;
  }

  /* Viewport */
  .viewport-panel {
    position: relative; padding: 0; overflow: hidden;
    display: flex; flex-direction: column;
  }
  .viewport-toolbar {
    position: absolute; top: 8px; right: 8px; z-index: 10;
    display: flex; gap: 4px;
  }
  .toolbar-btn {
    width: 32px; height: 32px; border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm); background: var(--bg-glass);
    color: var(--text-soft); cursor: pointer; font-size: 1rem;
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(4px); transition: all 0.15s;
  }
  .toolbar-btn:hover { background: var(--primary-light); color: var(--primary-dark); }

  .viewport-canvas {
    flex: 1; min-height: 400px;
  }
  .colorbar-canvas {
    position: absolute; bottom: 16px; left: 16px;
  }

  /* Results */
  .results-panel {
    padding: var(--space-md);
    overflow-y: auto;
    max-height: 80vh;
  }
  .results-panel h3 {
    font-size: 0.85rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--text-soft);
    margin: var(--space-md) 0 var(--space-sm);
  }
  .results-panel h3:first-child { margin-top: 0; }

  .spectrum-canvas {
    width: 100%; height: auto; border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
  }
  .hint {
    font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;
    font-style: italic;
  }
  .summary-table {
    font-size: 0.85rem;
  }
  .data-table {
    width: 100%; border-collapse: collapse;
  }
  .data-table td {
    padding: 4px 0; border-bottom: 1px solid var(--bg-muted);
  }
  .data-table td:last-child {
    text-align: right; font-variant-numeric: tabular-nums;
  }
  .text-muted { color: var(--text-muted); }

  /* Status bar */
  .status-bar {
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background: var(--bg-soft);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    color: var(--text-soft);
    border: 1px solid var(--bg-muted);
  }
  /* behaviour this widget needs on top of the shared component in lab.css */
  .controls { overflow-y: auto; }
</style>
