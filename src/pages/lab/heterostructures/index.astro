    gap: 0.45rem;
  }

  .param[hidden],
  .chart-options[hidden],
  .segmented[hidden] {
    display: none;
  }

  .param-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
  }

  .param-header label,
  .range-grid span,
  .layer-field span {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-soft);
  }

  /* Symbol subscripts — n_s, n_c, κ_s, κ_c, ε_∞ and the layer indices.
     The browser default for <sub> is `vertical-align: sub` at `font-size:
     smaller`, which drops the glyph below the baseline while keeping it in the
     line box: here that put 18.4px of leading inside a 22.1px line, so rows
     carrying a subscript sat taller than rows without one and the labels lost
     their alignment. Pulling it out of the line box with `line-height: 0` and
     offsetting it geometrically keeps the subscript tied to the glyph it
     modifies, at a size that still reads at 13px. */
  sub {
    font-size: 0.72em;
    line-height: 0;
    vertical-align: baseline;
    position: relative;
    bottom: -0.28em;
  }

  /* The same treatment for the labels the script injects. Astro scopes the rule
     above to elements that exist in the template; innerHTML content carries no
     scope attribute, so those subscripts need an explicit :global to match. */
  :global(.pr-stack-half sub),
  :global(.tmm-stack__end sub),
  :global(.output-card sub) {
    font-size: 0.72em;
    line-height: 0;
    vertical-align: baseline;
    position: relative;
    bottom: -0.28em;
  }

