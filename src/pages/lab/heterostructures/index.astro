---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Heterostructures | Lab" description="Interactive stacking solver for the electromagnetic modes of layered heterostructures: surface plasmons at planar Drude interfaces, with normalized Economou axes and physical unit controls.">
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Hetero<span class="gradient-text">structures</span></h1>
      <p class="widget-hero__subtitle">
        An interactive stacking solver for the electromagnetic modes of layered
        heterostructures. Pick a module below, build your stack, and explore its
        response with normalized Economou axes and physical unit controls.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="module-bar card" role="radiogroup" aria-label="Heterostructure module">
        <span class="module-bar__label">Module</span>
        <div class="module-bar__grid">
          <button type="button" class="module-card active" id="module-surface-plasmons" role="radio" aria-checked="true">
            <span class="module-card__name">Surface plasmons</span>
            <span class="module-card__desc">Planar Drude interfaces &amp; thin films</span>
          </button>
          <button type="button" class="module-card" id="module-layered-structure" role="radio" aria-checked="false" aria-disabled="true" disabled>
            <span class="module-card__name">Layered structure</span>
            <span class="module-card__badge">Soon</span>
          </button>
          <button type="button" class="module-card" id="module-graphene" role="radio" aria-checked="false" aria-disabled="true" disabled>
            <span class="module-card__name">Graphene</span>
            <span class="module-card__badge">Soon</span>
          </button>
        </div>
      </div>

      <div class="widget-layout">
        <aside class="controls card">
          <div class="panel-title-row">
            <h3>Parameters</h3>
            <div class="preset-actions" aria-label="Quick layer presets">
              <button type="button" class="preset-chip" id="preset-dmd" title="Dielectric-metal-dielectric">DMD</button>
              <button type="button" class="preset-chip" id="preset-mdm" title="Metal-dielectric-metal">MDM</button>
            </div>
          </div>

          <div class="param">
            <div class="param-header">
              <label>Layers</label>
              <span class="param-readout" id="layer-count">2</span>
            </div>
            <div class="stepper-row">
              <button type="button" class="icon-btn" id="remove-layer" title="Remove layer" aria-label="Remove layer">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14"/></svg>
              </button>
              <button type="button" class="icon-btn" id="add-layer" title="Add layer" aria-label="Add layer">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
              </button>
            </div>
          </div>

          <div class="stack-preview" id="stack-preview" aria-label="Layer stack preview"></div>

          <div class="layer-editor" id="layer-editor"></div>

          <h3>Plot range</h3>
          <div class="param">
            <span class="axis-section-label">Vertical axis</span>
            <div class="axis-control-row axis-control-row--vertical">
              <div class="segmented segmented--compact axis-kind-tabs" id="y-axis-kind-tabs" role="radiogroup" aria-label="Vertical axis quantity">
                <button type="button" class="seg-btn active" data-y-kind="energy" role="radio" aria-checked="true" aria-label="Photon energy" title="Photon energy">Energy</button>
                <button type="button" class="seg-btn" data-y-kind="frequency" role="radio" aria-checked="false" aria-label="Frequency" title="Frequency">Freq.</button>
                <button type="button" class="seg-btn" data-y-kind="wavelength" role="radio" aria-checked="false" aria-label="Photon wavelength" title="Photon wavelength">&lambda;</button>
              </div>
              <div class="segmented segmented--compact unit-tabs" id="y-unit-tabs" role="radiogroup" aria-label="Vertical axis unit">
                <button type="button" class="seg-btn active" data-y-kind="energy" data-y-unit="ev" role="radio" aria-checked="true">eV</button>
                <button type="button" class="seg-btn" data-y-kind="energy" data-y-unit="wp" role="radio" aria-checked="false">&omega;/&omega;<sub>p</sub></button>
                <button type="button" class="seg-btn" data-y-kind="frequency" data-y-unit="hz" role="radio" aria-checked="false" hidden>Hz</button>
                <button type="button" class="seg-btn" data-y-kind="wavelength" data-y-unit="lambda-nm" role="radio" aria-checked="false" hidden>nm</button>
                <button type="button" class="seg-btn" data-y-kind="wavelength" data-y-unit="lambda-um" role="radio" aria-checked="false" hidden>&mu;m</button>
                <button type="button" class="seg-btn" data-y-kind="wavelength" data-y-unit="lambda-lp" role="radio" aria-checked="false" hidden>&lambda;/&lambda;<sub>p</sub></button>
              </div>
              <select class="wp-reference-select" id="wp-reference-select" aria-label="Plasma frequency reference" hidden></select>
            </div>
            <div class="range-grid range-grid--compact">
              <label>
                <span id="y-min-label">Photon energy min</span>
                <input type="number" class="param-number" id="y-min" step="0.01">
              </label>
              <label>
                <span id="y-max-label">Photon energy max</span>
                <input type="number" class="param-number" id="y-max" step="0.01">
              </label>
            </div>
          </div>

          <div class="param">
            <span class="axis-section-label">Horizontal axis</span>
            <div class="axis-control-row">
              <span>Parallel momentum</span>
              <div class="segmented segmented--compact unit-tabs" id="x-unit-tabs" role="radiogroup" aria-label="Horizontal axis unit">
                <button type="button" class="seg-btn active" data-x-unit="nm" role="radio" aria-checked="true">nm<sup>-1</sup></button>
                <button type="button" class="seg-btn" data-x-unit="cm" role="radio" aria-checked="false">cm<sup>-1</sup></button>
                <button type="button" class="seg-btn" data-x-unit="kp" role="radio" aria-checked="false">k/k<sub>p</sub></button>
              </div>
            </div>
            <div class="range-grid">
              <label>
                <span id="x-min-label">Parallel momentum min</span>
                <input type="number" class="param-number" id="x-min" step="0.001">
              </label>
              <label>
                <span id="x-max-label">Parallel momentum max</span>
                <input type="number" class="param-number" id="x-max" step="0.001">
              </label>
            </div>
          </div>

          <p class="theory-note">
            Single-boundary TM pole:
            k = (&omega;/c) [ &epsilon;<sub>1</sub>&epsilon;<sub>2</sub> /
            (&epsilon;<sub>1</sub> + &epsilon;<sub>2</sub>) ]<sup>1/2</sup>.
            Drude layers use &epsilon;(E) = &epsilon;<sub>&infin;</sub> -
            (&omega;<sub>p</sub>/E)<sup>2</sup> for the lossless dispersion branch.
          </p>

          <button type="button" class="reset-btn" id="reset-parameters">Reset</button>
        </aside>

        <main class="lab-main">
          <section class="chart-panel card">
            <div class="chart-header">
              <div>
                <span class="chart-title" id="chart-title">Surface plasmons dispersion relation</span>
              </div>
              <div class="toolbar-actions">
                <button type="button" id="dl-png" class="tool-btn" title="Download plot as PNG">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                  PNG
                </button>
                <button type="button" id="dl-csv" class="tool-btn" title="Download current curve as CSV">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                  CSV
                </button>
              </div>
            </div>
            <div class="chart-options" aria-label="Reference lines">
              <label class="check-row check-row--compact">
                <input type="checkbox" id="show-light" checked>
                <span>Light line</span>
              </label>
            <label class="slope-control">
              <input type="checkbox" id="show-tailored" checked>
              <span>Slope / c</span>
              <input type="range" class="slope-slider" id="tailored-slope-slider" value="0.35" step="0.01" min="0" max="2">
              <input type="number" class="param-number param-number--sm" id="tailored-slope" value="0.35" step="0.01" min="0">
            </label>
            </div>
            <div class="chart-wrap" id="chart-wrap">
              <canvas id="dispersion-chart" aria-label="Surface plasmon dispersion chart"></canvas>
              <div class="chart-tooltip" id="chart-tooltip" hidden></div>
          </div>
          <div class="chart-interface-control">
            <span>Layers</span>
            <div class="interface-tabs" id="interface-tabs" role="group" aria-label="Displayed layers"></div>
          </div>
          <div class="chart-legend" id="chart-legend"></div>
          </section>

          <section class="model-note card">
            <div class="model-note__header">
              <span>Notes</span>
              <span id="model-summary">single interface</span>
          </div>
          <p>
            <strong>Selected layer branch:</strong> TM surface-plasmon pole.
            The plotted branch is the real, lossless single-interface mode for
            the currently selected adjacent layers.
          </p>
          <p>
            Symmetric DMD and MDM presets use the coupled thin-film branches
            when the whole film layer is displayed. DMD means
            Dielectric-Metal-Dielectric; MDM means Metal-Dielectric-Metal.
          </p>
          </section>

          <section class="references-card card">
            <div class="references-card__header">
              <h3>References</h3>
              <div class="figure-preset-actions" aria-label="Economou figure presets">
                <button type="button" class="preset-chip" id="preset-fig1" title="Economou Fig. 1 single interface">Fig. 1</button>
                <button type="button" class="preset-chip" id="preset-fig2" title="Economou Fig. 2 retardation guide">Fig. 2</button>
                <button type="button" class="preset-chip" id="preset-fig3" title="Economou Fig. 3 insulating film between metals">Fig. 3</button>
                <button type="button" class="preset-chip" id="preset-fig4" title="Economou Fig. 4 metal film in vacuum">Fig. 4</button>
                <button type="button" class="preset-chip" id="preset-fig5" title="Economou Fig. 5 Swihart geometry">Fig. 5</button>
                <button type="button" class="preset-chip" id="preset-fig6" title="Economou Fig. 6 two metal films">Fig. 6</button>
                <button type="button" class="preset-chip" id="preset-fig7" title="Economou Fig. 7 two dielectric films">Fig. 7</button>
                <button type="button" class="preset-chip" id="preset-fig8" title="Economou Fig. 8 three metal films">Fig. 8</button>
              </div>
            </div>
            <p>
              E. N. Economou, <em>Surface Plasmons in Thin Films</em>,
              Phys. Rev. 182, 539, published 10 June 1969.
              DOI: <a href="https://doi.org/10.1103/PhysRev.182.539" target="_blank" rel="noopener">10.1103/PhysRev.182.539</a>.
            </p>
          </section>
        </main>
      </div>
    </div>
  </section>
</Layout>

<style>
  .widget-hero {
    padding: calc(var(--space-3xl) + var(--space-lg)) 0 var(--space-xl);
    background: var(--bg-soft);
  }

  .widget-hero h1 {
    margin-bottom: var(--space-sm);
  }

  .widget-hero__subtitle {
    font-size: 1.125rem;
    max-width: 800px;
  }

  .gradient-text {
    background: var(--spectrum);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-md);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-soft);
  }

  .back-link:hover {
    color: var(--primary);
  }

  .widget-layout {
    display: grid;
    grid-template-columns: 330px minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
    min-width: 0;
  }

  .controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-width: 0;
  }

  .controls h3 {
    font-size: 1rem;
  }

  .module-bar {
    margin-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .module-bar__label {
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .module-bar__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    align-items: stretch;
  }

  .module-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    width: 100%;
    min-height: 66px;
    text-align: left;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    padding: 0.6rem 0.7rem;
    cursor: pointer;
  }

  .module-card__name {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 800;
  }

  .module-card__desc {
    color: var(--text-soft);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .module-card__badge {
    align-self: flex-start;
    border-radius: var(--radius-full);
    background: var(--bg-muted);
    color: var(--text-muted);
    font-size: 0.625rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.4rem;
  }

  .module-card:hover:not(:disabled):not(.active) {
    border-color: var(--primary-light);
    background: rgba(99, 102, 241, 0.06);
  }

  .module-card.active {
    border-color: var(--primary);
    background: rgba(99, 102, 241, 0.08);
    color: var(--primary);
  }

  .module-card.active .module-card__desc {
    color: var(--primary);
    opacity: 0.85;
  }

  .module-card:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .panel-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .panel-title-row h3 {
    margin: 0;
  }

  .preset-actions {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.35rem;
  }

  .param {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .param-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
  }

  .param-header label,
  .range-grid span,
  .layer-field span {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-soft);
  }

  .axis-section-label {
    display: block;
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1;
  }

  .axis-control-row,
  .axis-range-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
  }

  .axis-control-row > span,
  .axis-range-header > span {
    min-width: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-soft);
  }

  .axis-kind-tabs {
    min-width: 0;
  }

  .axis-kind-tabs .seg-btn,
  .unit-tabs .seg-btn {
    padding: 0.24rem 0.34rem;
    font-size: 0.6875rem;
  }

  .wp-reference-select {
    min-height: 28px;
    min-width: 6.4rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text-soft);
    font: 700 0.6875rem var(--font);
    padding: 0.2rem 0.35rem;
  }

  .param-readout {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--primary);
    font-variant-numeric: tabular-nums;
  }

  .stepper-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .icon-btn {
    min-height: 36px;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    color: var(--text-soft);
    cursor: pointer;
  }

  .icon-btn:hover:not(:disabled) {
    color: var(--primary);
    border-color: var(--primary-light);
    background: rgba(99, 102, 241, 0.06);
  }

  .icon-btn:disabled {
    cursor: default;
    color: var(--text-muted);
    opacity: 0.5;
  }

  .stack-preview {
    display: grid;
    grid-template-columns: repeat(var(--stack-count, 2), minmax(26px, 1fr));
    min-height: 76px;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
  }

  .stack-layer {
    display: grid;
    grid-template-rows: 18px 1fr auto;
    place-items: center;
    row-gap: 0.12rem;
    padding: 0.28rem 0.12rem 0.32rem;
    color: white;
    font-size: 0.625rem;
    font-weight: 700;
    text-align: center;
    min-width: 0;
    position: relative;
  }

  :global(.stack-layer) {
    display: grid;
    grid-template-rows: 18px 1fr auto;
    place-items: center;
    row-gap: 0.12rem;
    padding: 0.28rem 0.12rem 0.32rem;
    color: white;
    font-size: 0.625rem;
    font-weight: 700;
    text-align: center;
    min-width: 0;
    position: relative;
  }

  :global(.stack-layer__index) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--text);
    font-size: 0.625rem;
    font-weight: 850;
    line-height: 1;
    box-shadow: 0 1px 4px rgba(15, 23, 42, 0.14);
  }

  :global(.stack-layer__kind) {
    align-self: center;
    color: rgba(255, 255, 255, 0.96);
    font-size: 0.82rem;
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 1px 3px rgba(15, 23, 42, 0.25);
  }

  :global(.stack-layer__label) {
    align-self: end;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stack-layer + .stack-layer {
    border-left: 1px solid rgba(255, 255, 255, 0.55);
  }

  :global(.stack-layer + .stack-layer) {
    border-left: 1px solid rgba(255, 255, 255, 0.55);
  }

  .interface-tabs,
  .segmented {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .segmented--wrap {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .segmented--compact {
    flex-wrap: nowrap;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .segmented--multi {
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .seg-btn,
  .interface-btn,
  .tool-btn,
  .preset-chip,
  .reset-btn {
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text-soft);
    font-family: var(--font);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.4rem 0.6rem;
    cursor: pointer;
    min-height: 34px;
  }

  .preset-chip {
    flex: 0 0 auto;
    min-height: 28px;
    padding: 0.22rem 0.5rem;
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .reset-btn {
    width: 100%;
    min-height: 36px;
    color: var(--text);
  }

  .preset-chip:hover,
  .reset-btn:hover {
    border-color: var(--primary-light);
    color: var(--primary);
    background: rgba(99, 102, 241, 0.06);
  }

  .preset-chip.is-active {
    border-color: var(--primary);
    background: rgba(99, 102, 241, 0.14);
    color: var(--primary);
    font-weight: 800;
    box-shadow: inset 0 0 0 1px var(--primary);
  }

  .segmented--compact .seg-btn {
    min-height: 28px;
    padding: 0.22rem 0.45rem;
    font-size: 0.6875rem;
  }

  .seg-btn.active,
  .interface-btn.active {
    border-color: var(--primary);
    background: rgba(99, 102, 241, 0.08);
    color: var(--primary);
  }

  .interface-btn {
    flex: 1 1 74px;
  }

  :global(.interface-btn) {
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text-soft);
    font-family: var(--font);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.4rem 0.6rem;
    cursor: pointer;
    min-height: 34px;
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    line-height: 1.25;
    flex: 1 1 74px;
  }

  :global(.interface-btn.active) {
    border-color: var(--primary);
    background: rgba(99, 102, 241, 0.08);
    color: var(--primary);
  }

  :global(.interface-btn:not(.interface-btn--all)) {
    border-color: color-mix(in srgb, var(--layer-color, var(--bg-muted)) 68%, var(--bg-muted));
    box-shadow: inset 0 3px 0 var(--layer-color, var(--bg-muted));
  }

  :global(.interface-btn:not(.interface-btn--all).active) {
    border-color: var(--layer-color, var(--primary));
    background: color-mix(in srgb, var(--layer-color, var(--primary)) 12%, transparent);
    color: var(--layer-color, var(--primary));
  }

  .layer-editor {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-height: 420px;
    overflow-y: auto;
    padding-right: 0.15rem;
  }

  .layer-row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.55rem;
    border: 1px solid var(--bg-muted);
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
  }

  :global(.layer-row) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
