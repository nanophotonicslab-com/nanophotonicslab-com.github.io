</style>

<script>
  import { chartTheme, onThemeChange } from '../../../lib/chart-theme';

  const HC_EV_NM = 1239.8419843320026;
  const HBARC_EV_NM = HC_EV_NM / (2 * Math.PI);
  const H_EV_S = 4.135667696e-15;
  const SQRT2 = Math.sqrt(2);
  const MIN_LAYERS = 2;
  const MAX_LAYERS = 7;

  type AxisX = 'nm' | 'cm' | 'kp';
  type AxisY = 'ev' | 'wp' | 'hz' | 'lambda-nm' | 'lambda-um' | 'lambda-lp';
  type AxisYKind = 'energy' | 'frequency' | 'wavelength';

  type Layer = {
    name: string;
    epsInf: number;
    wpEv: number;
    gammaEv: number;
    thicknessNm: number;
    finite: boolean;
    color: string;
  };

  type BranchPoint = {
    q: number;
    u: number;
    kNm: number;
    energyEv: number;
    epsA: number;
    epsB: number;
  };

  type BranchCurve = {
    interfaceIndex: number;
    layerIndex: number;
    label: string;
    color: string;
    referenceWpEv?: number;
    dash?: number[];
    points: BranchPoint[];
  };

  type LayerLegendEntry = {
    layerIndex: number;
    label: string;
    color: string;
    referenceWpEv: number;
  };

  type LayerSolution = {
    layerIndex: number;
    solutionNumber: number;
    solutionCount: number;
  };

  type HoveredPoint = {
    curve: BranchCurve;
    point: BranchPoint;
    px: number;
    py: number;
  };

  const palette = ['#38BDF8', '#F59E0B', '#10B981', '#7C3AED', '#EF4444', '#0EA5E9', '#64748B'];
  const ECONOMOU_WP_EV = 9.0;

  function filmName(thicknessNm: number): string {
    return `${fmt(thicknessNm, 3)} nm film`;
  }

  function dimensionlessThicknessToNm(d: number, wpEv = ECONOMOU_WP_EV): number {
    return d * HBARC_EV_NM / wpEv;
  }

  function dielectricLayer(name: string, colorIndex: number, thicknessD = 0, finite = false): Layer {
    const thicknessNm = finite ? dimensionlessThicknessToNm(thicknessD) : 0;
    return {
      name: finite ? filmName(thicknessNm) : name,
      epsInf: 1.0,
      wpEv: 0.0,
      gammaEv: 0.0,
      thicknessNm,
      finite,
      color: palette[colorIndex % palette.length],
    };
  }

  function metalLayer(name: string, colorIndex: number, thicknessD = 0, finite = false): Layer {
    const thicknessNm = finite ? dimensionlessThicknessToNm(thicknessD) : 0;
    return {
      name: finite ? filmName(thicknessNm) : name,
      epsInf: 1.0,
      wpEv: ECONOMOU_WP_EV,
      gammaEv: 0.05,
      thicknessNm,
      finite,
      color: palette[colorIndex % palette.length],
    };
  }

  function makeDefaultLayers(): Layer[] {
    return [
      { name: 'Top dielectric', epsInf: 1.0, wpEv: 0.0, gammaEv: 0.0, thicknessNm: 0, finite: false, color: palette[0] },
      { name: 'Drude metal', epsInf: 1.0, wpEv: 9.0, gammaEv: 0.05, thicknessNm: 0, finite: false, color: palette[1] },
    ];
  }

  function makeDmdLayers(): Layer[] {
    return [
      { name: 'Top dielectric', epsInf: 1.0, wpEv: 0.0, gammaEv: 0.0, thicknessNm: 0, finite: false, color: palette[0] },
      { name: filmName(25), epsInf: 1.0, wpEv: 9.0, gammaEv: 0.05, thicknessNm: 25, finite: true, color: palette[1] },
      { name: 'Bottom dielectric', epsInf: 1.0, wpEv: 0.0, gammaEv: 0.0, thicknessNm: 0, finite: false, color: palette[2] },
    ];
  }

  function makeMdmLayers(): Layer[] {
    return [
      { name: 'Top Drude metal', epsInf: 1.0, wpEv: 9.0, gammaEv: 0.05, thicknessNm: 0, finite: false, color: palette[1] },
      { name: filmName(25), epsInf: 2.25, wpEv: 0.0, gammaEv: 0.0, thicknessNm: 25, finite: true, color: palette[0] },
      { name: 'Bottom Drude metal', epsInf: 1.0, wpEv: 9.0, gammaEv: 0.05, thicknessNm: 0, finite: false, color: palette[3] },
    ];
  }

  function makeFigure5Layers(): Layer[] {
    return [
      dielectricLayer('Top dielectric', 0),
      metalLayer('0.25 d metal film', 1, 0.25, true),
      dielectricLayer('0.25 d dielectric film', 2, 0.25, true),
      metalLayer('Bottom Drude metal', 3),
    ];
  }

  function makeFigure6Layers(): Layer[] {
    return [
      dielectricLayer('Top dielectric', 0),
      metalLayer('0.22 d metal film', 1, 0.22, true),
      dielectricLayer('0.18 d dielectric film', 2, 0.18, true),
      metalLayer('0.42 d metal film', 3, 0.42, true),
      dielectricLayer('Bottom dielectric', 4),
    ];
  }

  function makeFigure7Layers(): Layer[] {
    return [
      metalLayer('Top Drude metal', 1),
      dielectricLayer('0.16 d dielectric film', 0, 0.16, true),
      metalLayer('0.25 d metal film', 3, 0.25, true),
      dielectricLayer('0.30 d dielectric film', 2, 0.30, true),
      metalLayer('Bottom Drude metal', 5),
    ];
  }

  function makeFigure8Layers(): Layer[] {
    return [
      dielectricLayer('Top dielectric', 0),
      metalLayer('0.20 d metal film', 1, 0.20, true),
      dielectricLayer('0.05 d dielectric film', 2, 0.05, true),
      metalLayer('0.35 d metal film', 3, 0.35, true),
      dielectricLayer('0.05 d dielectric film', 4, 0.05, true),
      metalLayer('0.20 d metal film', 5, 0.20, true),
      dielectricLayer('Bottom dielectric', 6),
    ];
  }

  const state = {
    layers: makeDefaultLayers(),
    activeInterface: 0,
    selectedLayerIndices: [1],
    previousSelectedLayerIndices: [1],
    xUnit: 'nm' as AxisX,
    yUnit: 'ev' as AxisY,
    qMin: 0.0,
    qMax: 3.0,
    uMin: 0.0,
    uMax: 1.18,
    wpAxisLayerIndex: -1,
    tailoredSlope: 0.35,
    showLight: true,
    showSurfaceLimit: true,
    surfaceLimitDenominators: {} as Record<string, number>,
    surfaceLimitKeys: [] as string[],
    showTailored: true,
    showAllLayers: false,
  };

  let currentBranch: BranchPoint[] = [];
  let solvedBranches: BranchCurve[] = [];
  let currentBranches: BranchCurve[] = [];
  let branchesDirty = true;
  let solveCounter = 0;
  let hoveredPoint: HoveredPoint | null = null;
  let lastPlot: { left: number; top: number; width: number; height: number; xMin: number; xMax: number; yMin: number; yMax: number } | null = null;

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  const stackPreview = $('stack-preview');
  const interfaceTabs = $('interface-tabs');
  const layerEditor = $('layer-editor');
  const chartLegend = $('chart-legend');
  const chartWrap = $('chart-wrap');
  const chartTooltip = $('chart-tooltip');
  const canvas = $('dispersion-chart') as HTMLCanvasElement;

  function invalidateBranches() {
    branchesDirty = true;
  }

  function clamp(value: number, min: number, max: number): number {
    return Math.min(max, Math.max(min, value));
  }

  function finiteNumber(value: number, fallback: number): number {
    return Number.isFinite(value) ? value : fallback;
  }

  function fmt(value: number, digits = 4): string {
    if (!Number.isFinite(value)) return '--';
    const abs = Math.abs(value);
    if (abs > 0 && (abs < 1e-3 || abs >= 1e5)) return value.toExponential(2);
    return Number.parseFloat(value.toPrecision(digits)).toString();
  }

  function interfacePair(interfaceIndex = state.activeInterface): [Layer, Layer] {
    const index = clamp(interfaceIndex, 0, state.layers.length - 2);
    return [state.layers[index], state.layers[index + 1]];
  }

  function activePair(): [Layer, Layer] {
    state.activeInterface = clamp(state.activeInterface, 0, state.layers.length - 2);
    return interfacePair(state.activeInterface);
  }

  function interfaceIndices(): number[] {
    return state.layers.slice(0, -1).map((_, index) => index);
  }

  function interfaceIndexForLayer(layerIndex: number): number {
    const matched = interfaceIndices().find(index => plasmonLayerIndex(index) === layerIndex);
    if (matched !== undefined) return matched;
    return clamp(layerIndex - 1, 0, Math.max(0, state.layers.length - 2));
  }

  function plottableLayerIndices(): number[] {
    let indices: number[];
    if (hasSymmetricDmdFilm() || hasSymmetricMdmFilm()) {
      indices = [1];
    } else if (hasSwihartStack()) {
      const dFirst = hasLayerPattern(['D', 'M', 'D', 'M']);
      indices = [dFirst ? 1 : 2, dFirst ? 2 : 1];
    } else if (hasCaseEStack()) {
      indices = [1, 2, 3];
    } else if (hasCaseFStack()) {
      indices = [1, 2, 3];
    } else if (hasCaseGStack()) {
      indices = [1, 3, 5];
    } else {
      indices = interfaceIndices().map(index => plasmonLayerIndex(index));
    }
    return Array.from(new Set(indices.filter(index => index >= 0 && index < state.layers.length))).sort((a, b) => a - b);
  }

  function normalizeLayerSelection(indices: number[]): number[] {
    const available = new Set(plottableLayerIndices());
    return Array.from(new Set(indices
      .map(index => Math.round(index))
      .filter(index => Number.isFinite(index) && available.has(index))))
      .sort((a, b) => a - b);
  }

  function selectedLayerIndices(): number[] {
    const available = plottableLayerIndices();
    if (state.showAllLayers) {
      state.selectedLayerIndices = available;
      state.activeInterface = interfaceIndexForLayer(available[0] ?? 0);
      state.previousSelectedLayerIndices = normalizeLayerSelection(state.previousSelectedLayerIndices);
      return available;
    }
    let unique = normalizeLayerSelection(state.selectedLayerIndices);
    if (!unique.length && available.length && !state.selectedLayerIndices.length) {
      unique = [];
    } else if (!unique.length && available.length) {
      unique = [available[0]];
    }
    state.selectedLayerIndices = unique;
    if (unique.length) {
      state.previousSelectedLayerIndices = unique;
      state.activeInterface = interfaceIndexForLayer(unique[0]);
    }
    return unique;
  }

  function selectLayer(index: number) {
    const selected = new Set(state.showAllLayers ? selectedLayerIndices() : state.selectedLayerIndices);
    state.showAllLayers = false;
    if (selected.has(index)) {
      selected.delete(index);
    } else {
      selected.add(index);
    }
    state.selectedLayerIndices = Array.from(selected).sort((a, b) => a - b);
    selectedLayerIndices();
  }

  function selectAllLayers() {
    if (state.showAllLayers) {
      state.showAllLayers = false;
      state.selectedLayerIndices = normalizeLayerSelection(state.previousSelectedLayerIndices);
    } else {
      state.previousSelectedLayerIndices = selectedLayerIndices();
      state.showAllLayers = true;
      state.selectedLayerIndices = plottableLayerIndices();
    }
    selectedLayerIndices();
  }

  function wpReferenceEv(interfaceIndex = state.activeInterface): number {
    const [a, b] = interfacePair(interfaceIndex);
    const pairWps = [a.wpEv, b.wpEv].filter(wp => wp > 0);
    if (pairWps.length) return Math.max(...pairWps);
    const stackWps = state.layers.map(layer => layer.wpEv).filter(wp => wp > 0);
    return stackWps.length ? Math.max(...stackWps) : 9.0;
  }

  function metalLayerIndices(): number[] {
    return state.layers
      .map((layer, index) => (layer.wpEv > 0 ? index : -1))
      .filter(index => index >= 0);
  }

  function wpAxisReferenceEv(): number {
    const index = state.wpAxisLayerIndex;
    if (index >= 0 && index < state.layers.length && state.layers[index].wpEv > 0) {
      return state.layers[index].wpEv;
    }
    return wpReferenceEv();
  }

  function wpAxisLabel(): string {
    const index = state.wpAxisLayerIndex;
    if (index >= 0 && index < state.layers.length && state.layers[index].wpEv > 0) {
      return `Layer ${index + 1}`;
    }
    return 'selected layer';
  }

  function kpReferenceNm(interfaceIndex = state.activeInterface): number {
    return wpReferenceEv(interfaceIndex) / HBARC_EV_NM;
  }

  function qToX(q: number): number {
    const kp = kpReferenceNm();
    if (state.xUnit === 'nm') return q * kp;
    if (state.xUnit === 'cm') return q * kp * 1e7;
    return q;
  }

  function xToQ(x: number): number {
    const kp = kpReferenceNm();
    if (state.xUnit === 'nm') return x / kp;
    if (state.xUnit === 'cm') return x / (kp * 1e7);
    return x;
  }

  function isWavelengthUnit(): boolean {
    return state.yUnit === 'lambda-nm' || state.yUnit === 'lambda-um' || state.yUnit === 'lambda-lp';
  }

  function yAxisKind(unit = state.yUnit): AxisYKind {
    if (unit === 'hz') return 'frequency';
    if (unit === 'lambda-nm' || unit === 'lambda-um' || unit === 'lambda-lp') return 'wavelength';
    return 'energy';
  }

  function defaultYUnitForKind(kind: AxisYKind): AxisY {
    if (kind === 'frequency') return 'hz';
    if (kind === 'wavelength') return 'lambda-nm';
    return 'ev';
  }

  function energyToY(energyEv: number): number {
    if (state.yUnit === 'ev') return energyEv;
    if (state.yUnit === 'hz') return energyEv / H_EV_S / 1e15;
    if (state.yUnit === 'lambda-nm') return HC_EV_NM / Math.max(energyEv, 1e-12);
    if (state.yUnit === 'lambda-um') return HC_EV_NM / Math.max(energyEv, 1e-12) / 1000;
    if (state.yUnit === 'lambda-lp') return wpReferenceEv() / Math.max(energyEv, 1e-12);
    return energyEv / wpAxisReferenceEv();
  }

  function yToEnergyEv(y: number): number {
    if (state.yUnit === 'ev') return y;
    if (state.yUnit === 'hz') return y * 1e15 * H_EV_S;
    if (state.yUnit === 'lambda-nm') return HC_EV_NM / Math.max(y, 1e-12);
    if (state.yUnit === 'lambda-um') return HC_EV_NM / Math.max(y * 1000, 1e-12);
    if (state.yUnit === 'lambda-lp') return wpReferenceEv() / Math.max(y, 1e-12);
    return y * wpAxisReferenceEv();
  }

  function uToY(u: number): number {
    return energyToY(u * wpReferenceEv());
  }

  function yToU(y: number): number {
    return yToEnergyEv(y) / wpReferenceEv();
  }

  function xLabel(): string {
    if (state.xUnit === 'nm') return 'Parallel momentum k (1/nm)';
    if (state.xUnit === 'cm') return 'Parallel momentum k (1/cm)';
    return 'Parallel momentum k / k_p';
  }

  function yLabel(): string {
    if (state.yUnit === 'ev') return 'Photon energy \u210F\u03C9 (eV)';
    if (state.yUnit === 'hz') return 'Frequency x 10^15 (Hz)';
    if (state.yUnit === 'lambda-nm') return 'Photon wavelength \u03BB (nm)';
    if (state.yUnit === 'lambda-um') return 'Photon wavelength \u03BB (\u03BCm)';
    if (state.yUnit === 'lambda-lp') return 'Photon wavelength \u03BB / \u03BB_p';
    return `omega / omega_p (${wpAxisLabel()})`;
  }

  function epsilonLossless(layer: Layer, energyEv: number): number {
    if (layer.wpEv <= 0) return layer.epsInf;
    if (energyEv <= 0) return Number.NaN;
    return layer.epsInf - (layer.wpEv * layer.wpEv) / (energyEv * energyEv);
  }

  function interfaceAsymptoteEv(): number {
    const [a, b] = activePair();
    const numerator = a.wpEv * a.wpEv + b.wpEv * b.wpEv;
    const denominator = a.epsInf + b.epsInf;
    if (numerator <= 0 || denominator <= 0) return Number.NaN;
    return Math.sqrt(numerator / denominator);
  }

  function interfaceColor(interfaceIndex: number): string {
    const [a, b] = interfacePair(interfaceIndex);
    if (a.finite && isMetalLayer(a)) return a.color;
    if (b.finite && isMetalLayer(b)) return b.color;
    if (a.wpEv <= 0 && b.wpEv <= 0) return b.color;
    return b.wpEv >= a.wpEv ? b.color : a.color;
  }

  function interfaceLabel(interfaceIndex: number): string {
    const [a, b] = interfacePair(interfaceIndex);
    return `${interfaceIndex + 1}: ${a.name} / ${b.name}`;
  }

  function plasmonLayerIndex(interfaceIndex: number): number {
    const [a, b] = interfacePair(interfaceIndex);
    const leftIndex = interfaceIndex;
    const rightIndex = interfaceIndex + 1;
    if (a.finite && isMetalLayer(a)) return leftIndex;
    if (b.finite && isMetalLayer(b)) return rightIndex;
    if (a.finite && b.finite) return b.wpEv >= a.wpEv ? rightIndex : leftIndex;
    if (a.finite) return leftIndex;
    if (b.finite) return rightIndex;
    return b.wpEv >= a.wpEv ? rightIndex : leftIndex;
  }

  function layerBranchLabel(interfaceIndex: number): string {
    const layerIndex = plasmonLayerIndex(interfaceIndex);
    const layer = state.layers[layerIndex];
    return `Layer ${layerIndex + 1}: ${layer.name}`;
  }

  function layerSolutionsFor(indices: number[]): Map<number, LayerSolution> {
    const layerCounts = new Map<number, number>();
    indices.forEach(interfaceIndex => {
      const layerIndex = plasmonLayerIndex(interfaceIndex);
      layerCounts.set(layerIndex, (layerCounts.get(layerIndex) ?? 0) + 1);
    });

    const layerSeen = new Map<number, number>();
    const solutions = new Map<number, LayerSolution>();
    indices.forEach(interfaceIndex => {
      const layerIndex = plasmonLayerIndex(interfaceIndex);
      const solutionNumber = (layerSeen.get(layerIndex) ?? 0) + 1;
      layerSeen.set(layerIndex, solutionNumber);
      solutions.set(interfaceIndex, {
        layerIndex,
        solutionNumber,
        solutionCount: layerCounts.get(layerIndex) ?? 1,
      });
    });
    return solutions;
  }

  function layerSolutionLabel(interfaceIndex: number, solution: LayerSolution): string {
    return solution.solutionCount > 1
      ? `Layer ${solution.layerIndex + 1} solution ${solution.solutionNumber}`
      : layerBranchLabel(interfaceIndex);
  }

  function layerSolutionButtonText(solution: LayerSolution): string {
    return solution.solutionCount > 1
      ? `${solution.layerIndex + 1}-${solution.solutionNumber}`
      : `${solution.layerIndex + 1}`;
  }

  function isDielectricLayer(layer: Layer): boolean {
    return layer.wpEv <= 1e-9;
  }

  function isMetalLayer(layer: Layer): boolean {
    return layer.wpEv > 1e-9;
  }

  function matchingDielectrics(a: Layer, b: Layer): boolean {
    return isDielectricLayer(a)
      && isDielectricLayer(b)
      && Math.abs(a.epsInf - b.epsInf) < 1e-6;
  }

  function matchingMetals(a: Layer, b: Layer): boolean {
    return isMetalLayer(a)
      && isMetalLayer(b)
      && Math.abs(a.epsInf - b.epsInf) < 1e-6
      && Math.abs(a.wpEv - b.wpEv) < 1e-6;
  }

  function stackReferenceWpEv(): number {
    const stackWps = state.layers.map(layer => layer.wpEv).filter(wp => wp > 0);
    return stackWps.length ? Math.max(...stackWps) : ECONOMOU_WP_EV;
  }

  function layerKind(layer: Layer): 'D' | 'M' {
    return isMetalLayer(layer) ? 'M' : 'D';
  }

  function hasLayerPattern(pattern: ('D' | 'M')[]): boolean {
    return state.layers.length === pattern.length
      && pattern.every((kind, index) => layerKind(state.layers[index]) === kind);
  }

  function matchingLayerGroup(indices: number[], matcher: (a: Layer, b: Layer) => boolean): boolean {
    if (indices.length < 2) return true;
    const first = state.layers[indices[0]];
    return indices.slice(1).every(index => matcher(first, state.layers[index]));
  }

  function normalizedThickness(layer: Layer, wp = stackReferenceWpEv()): number {
    return Math.max(1e-9, layer.thicknessNm * (wp / HBARC_EV_NM));
  }

  function sameNormalizedThickness(a: Layer, b: Layer, wp = stackReferenceWpEv()): boolean {
    return Math.abs(normalizedThickness(a, wp) - normalizedThickness(b, wp)) < 2e-4;
  }

  function representativeMetalLayer(): Layer {
    return state.layers.find(layer => isMetalLayer(layer)) ?? state.layers[0];
  }

  function representativeDielectricLayer(): Layer {
    return state.layers.find(layer => isDielectricLayer(layer)) ?? state.layers[0];
  }

  function hasSymmetricDmdFilm(): boolean {
    return state.layers.length === 3
      && state.layers[1].finite
      && isMetalLayer(state.layers[1])
      && matchingDielectrics(state.layers[0], state.layers[2]);
  }

  function hasSymmetricMdmFilm(): boolean {
    return state.layers.length === 3
      && state.layers[1].finite
      && isDielectricLayer(state.layers[1])
      && matchingMetals(state.layers[0], state.layers[2]);
  }

  function hasSwihartStack(): boolean {
    if (hasLayerPattern(['D', 'M', 'D', 'M'])) {
      return matchingDielectrics(state.layers[0], state.layers[2])
        && matchingMetals(state.layers[1], state.layers[3]);
    }
    if (hasLayerPattern(['M', 'D', 'M', 'D'])) {
      return matchingDielectrics(state.layers[1], state.layers[3])
        && matchingMetals(state.layers[0], state.layers[2]);
    }
    return false;
  }

  function hasCaseEStack(): boolean {
    return hasLayerPattern(['D', 'M', 'D', 'M', 'D'])
      && matchingLayerGroup([0, 2, 4], matchingDielectrics)
      && matchingLayerGroup([1, 3], matchingMetals);
  }

  function hasCaseFStack(): boolean {
    return hasLayerPattern(['M', 'D', 'M', 'D', 'M'])
      && matchingLayerGroup([0, 2, 4], matchingMetals)
      && matchingLayerGroup([1, 3], matchingDielectrics);
  }

  function hasCaseGStack(): boolean {
    const wp = stackReferenceWpEv();
    return hasLayerPattern(['D', 'M', 'D', 'M', 'D', 'M', 'D'])
      && matchingLayerGroup([0, 2, 4, 6], matchingDielectrics)
      && matchingLayerGroup([1, 3, 5], matchingMetals)
      && sameNormalizedThickness(state.layers[1], state.layers[5], wp)
      && sameNormalizedThickness(state.layers[2], state.layers[4], wp);
  }

  function layerKappa(q: number, u: number, layer: Layer, wp: number): number | null {
    const energyEv = u * wp;
    const epsilon = epsilonLossless(layer, energyEv);
    const value = q * q - epsilon * u * u;
    if (!Number.isFinite(value) || value <= 0) return null;
    return Math.sqrt(value);
  }

  function xRatioForPair(q: number, u: number, metal: Layer, dielectric: Layer, wp: number): number | null {
    const energyEv = u * wp;
    const epsMetal = epsilonLossless(metal, energyEv);
    const epsDielectric = epsilonLossless(dielectric, energyEv);
    const kappaMetal = layerKappa(q, u, metal, wp);
    const kappaDielectric = layerKappa(q, u, dielectric, wp);
    if (
      kappaMetal === null
      || kappaDielectric === null
      || !Number.isFinite(epsMetal)
      || !Number.isFinite(epsDielectric)
      || Math.abs(epsMetal) < 1e-10
      || Math.abs(epsDielectric) < 1e-10
    ) {
      return null;
    }
    const reflection = -((kappaMetal / epsMetal) / (kappaDielectric / epsDielectric));
    const denominator = 1 + reflection;
    if (!Number.isFinite(reflection) || Math.abs(denominator) < 1e-10) return null;
    return (1 - reflection) / denominator;
  }

  function solveScalarRoots(
    residual: (u: number) => number | null,
    uMin: number,
    uMax: number,
    samples = 260,
  ): number[] {
    if (!Number.isFinite(uMin) || !Number.isFinite(uMax) || uMax <= uMin) return [];
    const roots: number[] = [];
    let previousU = uMin;
    let previousValue = residual(previousU);

    for (let i = 1; i <= samples; i++) {
      const u = uMin + (uMax - uMin) * i / samples;
      const value = residual(u);
      if (value === null || !Number.isFinite(value)) {
        previousU = u;
        previousValue = null;
        continue;
      }
      if (Math.abs(value) < 1e-7) {
        roots.push(u);
      } else if (previousValue !== null && Number.isFinite(previousValue) && previousValue * value < 0) {
        let lo = previousU;
        let hi = u;
        let flo = previousValue;
        for (let j = 0; j < 44; j++) {
          const mid = 0.5 * (lo + hi);
          const fmid = residual(mid);
          if (fmid === null || !Number.isFinite(fmid)) break;
          if (Math.abs(fmid) < 1e-9) {
            lo = mid;
            hi = mid;
            break;
          }
          if (flo * fmid <= 0) {
            hi = mid;
          } else {
            lo = mid;
            flo = fmid;
          }
        }
        roots.push(0.5 * (lo + hi));
      }
      previousU = u;
      previousValue = value;
    }

    return roots
      .sort((a, b) => a - b)
      .filter((root, index, sorted) => index === 0 || Math.abs(root - sorted[index - 1]) > 1e-4);
  }

  function median(values: number[]): number {
    if (!values.length) return 0;
    const sorted = [...values].sort((a, b) => a - b);
    const middle = Math.floor(sorted.length / 2);
    return sorted.length % 2 === 0
      ? 0.5 * (sorted[middle - 1] + sorted[middle])
      : sorted[middle];
  }

  function drawableSegments(points: BranchPoint[]): BranchPoint[][] {
    const finitePoints = points.filter(point => (
      Number.isFinite(point.q)
      && Number.isFinite(point.u)
      && Number.isFinite(point.energyEv)
    ));
    const qGaps = finitePoints
      .slice(1)
      .map((point, index) => point.q - finitePoints[index].q)
      .filter(gap => Number.isFinite(gap) && gap > 0);
    const typicalQGap = median(qGaps);
    const maxQGap = typicalQGap > 0 ? typicalQGap * 2.75 : Number.POSITIVE_INFINITY;
    const maxUJump = 0.06;
    const segments: BranchPoint[][] = [];
    let segment: BranchPoint[] = [];
    let previous: BranchPoint | null = null;

    for (const point of finitePoints) {
      const breaksCurve = previous !== null
        && (
          point.q - previous.q > maxQGap
          || Math.abs(point.u - previous.u) > maxUJump
        );
      if (breaksCurve && segment.length) {
        segments.push(segment);
        segment = [];
      }
      segment.push(point);
      previous = point;
    }
    if (segment.length) segments.push(segment);
    return segments.filter(item => item.length > 1);
  }

  function filmBranchPoint(q: number, u: number, metal: Layer, dielectric: Layer, wp: number): BranchPoint {
    const energyEv = u * wp;
    return {
      q,
      u,
      kNm: q * (wp / HBARC_EV_NM),
      energyEv,
      epsA: epsilonLossless(dielectric, energyEv),
      epsB: epsilonLossless(metal, energyEv),
    };
  }

  function formulaBranchPoint(q: number, u: number, wp: number): BranchPoint {
    return filmBranchPoint(q, u, representativeMetalLayer(), representativeDielectricLayer(), wp);
  }

  function coth(value: number): number {
    const tanh = Math.tanh(value);
    if (Math.abs(tanh) < 1e-12) return value < 0 ? -1e12 : 1e12;
    return 1 / tanh;
  }

  function singleInterfaceU(q: number): number {
    if (q <= 0) return 0;
    return (1 + 1 / (2 * q * q) + Math.sqrt(1 + 1 / (4 * q ** 4))) ** -0.5;
  }

  function caseBElectrostatic(q: number, thickness: number, sign: 1 | -1): number {
    return Math.sqrt(Math.max(0, 0.5 * (1 + sign * Math.exp(-q * thickness))));
  }

  function quadraticBranchNearOne(q: number, a: number): number {
    const b = 1 + a + q * q;
    const disc = Math.max(0, b * b - 4 * a);
    const y1 = 0.5 * (b - Math.sqrt(disc));
    const y2 = 0.5 * (b + Math.sqrt(disc));
    const y = Math.abs(y1 - 1) <= Math.abs(y2 - 1) ? y1 : y2;
    return Math.sqrt(Math.max(0, y));
  }

  function swihartLowBranch(q: number, dielectricThickness: number, metalThickness: number): number {
    return q * Math.sqrt(dielectricThickness / (dielectricThickness + 1 + coth(metalThickness)));
  }

  function swihartBranchIII(q: number, dielectricThickness: number, metalThickness: number): number {
    return quadraticBranchNearOne(q, 1 / (dielectricThickness * metalThickness));
  }

  function caseELowBranch(q: number, dielectricThickness: number, metalThickness1: number, metalThickness2: number): number {
    const denominator = dielectricThickness + coth(q * metalThickness1) + coth(q * metalThickness2);
    return q * Math.sqrt(dielectricThickness / denominator);
  }

  function caseEBranchIV(q: number, dielectricThickness: number, metalThickness1: number, metalThickness2: number): number {
    return quadraticBranchNearOne(q, (metalThickness1 + metalThickness2) / (dielectricThickness * metalThickness1 * metalThickness2));
  }

  function caseEResidual(q: number, u: number, dielectricThickness: number, metalThickness1: number, metalThickness2: number): number | null {
    const wp = stackReferenceWpEv();
    const metal = state.layers[1];
    const dielectric = state.layers[2];
    const x = xRatioForPair(q, u, metal, dielectric, wp);
    const kI = layerKappa(q, u, dielectric, wp);
    const kM = layerKappa(q, u, metal, wp);
    if (x === null || kI === null || kM === null) return null;
    const a2 = Math.exp(-2 * kM * metalThickness1)
      + Math.exp(-2 * kM * metalThickness2)
      + Math.exp(-2 * kI * dielectricThickness)
        * (1 - Math.exp(-2 * kM * metalThickness1))
        * (1 - Math.exp(-2 * kM * metalThickness2));
    return x ** 4 - a2 * x * x + Math.exp(-2 * kM * metalThickness1 - 2 * kM * metalThickness2);
  }

  function caseFLowBranches(q: number, dielectricThickness1: number, dielectricThickness2: number, metalThickness: number): [number, number] {
    const gamma = dielectricThickness1 ** 2
      + dielectricThickness2 ** 2
      + 2 * (2 * Math.exp(-2 * q * metalThickness) - 1) * dielectricThickness1 * dielectricThickness2;
    const root = Math.sqrt(Math.max(0, gamma));
    const uI = q * Math.sqrt((dielectricThickness1 + dielectricThickness2 - root) / (dielectricThickness1 + dielectricThickness2 + 4 - root));
    const uII = q * Math.sqrt((dielectricThickness1 + dielectricThickness2 + root) / (dielectricThickness1 + dielectricThickness2 + 4 + root));
    return [uI, uII];
  }

  function caseFBranchIII(q: number, dielectricThickness1: number, dielectricThickness2: number): number {
    return quadraticBranchNearOne(q, 4 / (dielectricThickness1 + dielectricThickness2) ** 2);
  }

  function caseFBranchIV(q: number, dielectricThickness1: number, dielectricThickness2: number, metalThickness: number): number {
    return quadraticBranchNearOne(q, (dielectricThickness1 + dielectricThickness2) / (metalThickness * dielectricThickness1 * dielectricThickness2));
  }

  function formulaBranch(
    label: string,
    color: string,
    uForQ: (q: number) => number,
    dash?: number[],
    interfaceIndex = 0,
    layerIndex = plasmonLayerIndex(interfaceIndex),
    samples = 500,
  ): BranchCurve {
    const wp = stackReferenceWpEv();
    const qStart = Math.max(0.001, state.qMin);
    const qEnd = Math.max(qStart + 0.001, state.qMax);
    const points: BranchPoint[] = [];
    for (let i = 0; i < samples; i++) {
      const q = qStart + (qEnd - qStart) * i / (samples - 1);
      const u = uForQ(q);
      if (!Number.isFinite(u) || u <= 0) continue;
      points.push(formulaBranchPoint(q, u, wp));
    }
    return { interfaceIndex, layerIndex, label, color, referenceWpEv: wp, dash, points };
  }

  function computeSwihartBranches(): BranchCurve[] {
    const dFirst = hasLayerPattern(['D', 'M', 'D', 'M']);
    const metalLayerIndex = dFirst ? 1 : 2;
    const dielectricLayerIndex = dFirst ? 2 : 1;
    const dM = normalizedThickness(state.layers[metalLayerIndex]);
    const dI = normalizedThickness(state.layers[dielectricLayerIndex]);
    return [
      formulaBranch('Fig. 5 branch I', state.layers[dielectricLayerIndex].color, q => swihartLowBranch(q, dI, dM), [7, 5], dielectricLayerIndex - 1, dielectricLayerIndex),
      formulaBranch('Fig. 5 branch II', state.layers[metalLayerIndex].color, q => singleInterfaceU(q), undefined, metalLayerIndex, metalLayerIndex),
      formulaBranch('Fig. 5 branch III', state.layers[metalLayerIndex].color, q => swihartBranchIII(q, dI, dM), [2, 4], metalLayerIndex, metalLayerIndex),
    ];
  }

  // Shared continuity tracker: follows each physical mode across q so every branch
  // stays on a single mode (smooth, no jumps between modes at a crossing) and
  // connects through avoided crossings. `rootsAt` returns the modes present at q,
  // each as { u, key } where key is a symmetry-family tag so modes of different
  // families are never matched to each other. Returns up to `maxModes` point
  // arrays, ordered low-to-high mean energy for stable colour assignment.
  function trackModes(
    qStart: number,
    qEnd: number,
    steps: number,
    maxModes: number,
    rootsAt: (q: number) => Array<{ u: number; key: number }>,
    makePoint: (q: number, u: number) => BranchPoint,
  ): BranchPoint[][] {
    type Track = { pts: BranchPoint[]; lastU: number; lastQ: number; key: number; miss: number; dead: boolean };
    const tracks: Track[] = [];
    for (let s = 0; s < steps; s++) {
      const q = qStart + (qEnd - qStart) * s / (steps - 1);
      const roots = rootsAt(q);
      const used = new Array(roots.length).fill(false);
      const live = tracks.filter(t => !t.dead).sort((x, y) => x.miss - y.miss);
      for (const t of live) {
        const m = t.pts.length;
        const slope = m >= 2
          ? (t.pts[m - 1].u - t.pts[m - 2].u) / (t.pts[m - 1].q - t.pts[m - 2].q)
          : 0;
        const predicted = t.lastU + slope * (q - t.lastQ);
        let best = -1;
        let bestDist = Infinity;
        for (let j = 0; j < roots.length; j++) {
          if (used[j] || roots[j].key !== t.key) continue;
          const dist = Math.abs(roots[j].u - predicted);
          const tol = 0.03 + 0.8 * Math.abs(q - t.lastQ);
          if (dist < bestDist && dist < tol) { bestDist = dist; best = j; }
        }
        if (best >= 0) {
          used[best] = true;
          t.pts.push(makePoint(q, roots[best].u));
          t.lastU = roots[best].u;
          t.lastQ = q;
          t.miss = 0;
        } else if (++t.miss > 2) {
          t.dead = true;
        }
      }
      for (let j = 0; j < roots.length; j++) {
        if (used[j]) continue;
        tracks.push({ pts: [makePoint(q, roots[j].u)], lastU: roots[j].u, lastQ: q, key: roots[j].key, miss: 0, dead: false });
      }
    }
    return tracks
      .filter(t => t.pts.length >= 5)
      .map(t => ({ track: t, meanU: t.pts.reduce((sum, p) => sum + p.u, 0) / t.pts.length }))
      .sort((p1, p2) => p1.meanU - p2.meanU)
      .map(p => p.track.pts)
      .slice(0, maxModes);
  }

  // Find every bound mode at q for the quartic case-E residual: sign-change roots
  // plus avoided-crossing merge points, all within the physical window u < q.
  function caseERootsAt(q: number, dI: number, dM1: number, dM2: number): Array<{ u: number; key: number }> {
    const found: Array<{ u: number; key: number }> = [];
    const lo0 = 1e-5;
    const hi0 = q * (1 - 1e-6); // bound modes live below the light line (u < q)
    if (hi0 <= lo0) return found;
    const n = 1500;
    const us: number[] = [];
    const vs: Array<number | null> = [];
    for (let i = 0; i <= n; i++) {
      const u = lo0 + (hi0 - lo0) * i / n;
      us.push(u);
      vs.push(caseEResidual(q, u, dI, dM1, dM2));
    }
    for (let i = 1; i <= n; i++) {
      const prev = vs[i - 1];
      const cur = vs[i];
      if (prev === null || cur === null) continue;
      if (prev * cur < 0) {
        let lo = us[i - 1];
        let hi = us[i];
        let flo = prev;
        for (let k = 0; k < 60; k++) {
          const mid = 0.5 * (lo + hi);
          const fmid = caseEResidual(q, mid, dI, dM1, dM2);
          if (fmid === null) break;
          if (flo * fmid < 0) hi = mid; else { lo = mid; flo = fmid; }
        }
        found.push({ u: 0.5 * (lo + hi), key: 0 });
      }
    }
    for (let i = 2; i < n - 1; i++) {
      const v = vs[i];
      const vm = vs[i - 1];
      const vp = vs[i + 1];
      if (v === null || vm === null || vp === null) continue;
      if (Math.abs(v) < Math.abs(vm) && Math.abs(v) < Math.abs(vp) && Math.abs(v) < 6e-4) {
        if (!found.some(r => Math.abs(r.u - us[i]) < 3e-3)) {
          found.push({ u: us[i], key: 0 });
          found.push({ u: us[i], key: 0 });
        }
      }
    }
    return found.sort((r1, r2) => r1.u - r2.u);
  }

  function computeCaseEBranches(): BranchCurve[] {
    const wp = stackReferenceWpEv();
    const dM1 = normalizedThickness(state.layers[1]);
    const dI = normalizedThickness(state.layers[2]);
    const dM2 = normalizedThickness(state.layers[3]);
    const qStart = Math.max(0.03, state.qMin);
    const qEnd = Math.max(qStart + 0.001, state.qMax);

    const tracks = trackModes(
      qStart, qEnd, 200, 4,
      q => caseERootsAt(q, dI, dM1, dM2),
      (q, u) => formulaBranchPoint(q, u, wp),
    );

    const branchMeta = [
      { label: 'Fig. 6 branch I', color: state.layers[2].color, dash: [7, 5], interfaceIndex: 1, layerIndex: 2 },
      { label: 'Fig. 6 branch II', color: state.layers[1].color, dash: [7, 5], interfaceIndex: 0, layerIndex: 1 },
      { label: 'Fig. 6 branch III', color: state.layers[3].color, dash: undefined, interfaceIndex: 2, layerIndex: 3 },
      { label: 'Fig. 6 branch IV', color: state.layers[2].color, dash: undefined, interfaceIndex: 1, layerIndex: 2 },
    ] satisfies Array<{ label: string; color: string; dash?: number[]; interfaceIndex: number; layerIndex: number }>;

    return tracks.map((pts, index) => ({
      ...branchMeta[Math.min(index, branchMeta.length - 1)],
      referenceWpEv: wp,
      points: pts,
    }));
  }

  function computeCaseFBranches(): BranchCurve[] {
    const dI1 = normalizedThickness(state.layers[1]);
    const dM = normalizedThickness(state.layers[2]);
    const dI2 = normalizedThickness(state.layers[3]);
    return [
      formulaBranch('Fig. 7 branch I', state.layers[1].color, q => caseFLowBranches(q, dI1, dI2, dM)[0], [7, 5], 0, 1),
      formulaBranch('Fig. 7 branch II', state.layers[3].color, q => caseFLowBranches(q, dI1, dI2, dM)[1], undefined, 2, 3),
      formulaBranch('Fig. 7 branch III', state.layers[2].color, q => caseFBranchIII(q, dI1, dI2), [7, 5], 1, 2),
      formulaBranch('Fig. 7 branch IV', state.layers[2].color, q => caseFBranchIV(q, dI1, dI2, dM), undefined, 1, 2),
    ];
  }

  function caseGCubicResidual(q: number, u: number, dI: number, dM: number, dMPrime: number, sign: 1 | -1): number | null {
    const wp = stackReferenceWpEv();
    const metal = state.layers[3];
    const dielectric = state.layers[2];
    const x = xRatioForPair(q, u, metal, dielectric, wp);
    const kI = layerKappa(q, u, dielectric, wp);
    const kM = layerKappa(q, u, metal, wp);
    if (x === null || kI === null || kM === null) return null;
    const b2 = Math.exp(-kM * dM)
      + Math.exp(-2 * kI * dI - kM * (dM + 2 * dMPrime))
      - Math.exp(-kM * dM - 2 * kI * dI);
    const b1 = Math.exp(-2 * kM * (dM + dMPrime))
      + Math.exp(-2 * kI * dI)
      - Math.exp(-2 * kM * dM - 2 * kI * dI);
    const b0 = Math.exp(-kM * (dM + 2 * dMPrime));
    return x ** 3 + sign * b2 * x * x - b1 * x - sign * b0;
  }

  function computeCaseGBranches(): BranchCurve[] {
    const wp = stackReferenceWpEv();
    const dMPrime = normalizedThickness(state.layers[1], wp);
    const dI = normalizedThickness(state.layers[2], wp);
    const dM = normalizedThickness(state.layers[3], wp);
    const qStart = Math.max(0.03, state.qMin);
    const qEnd = Math.max(qStart + 0.001, state.qMax);
    const STEPS = 200;

    // All modes at one q: sign-change roots of each symmetry family, plus "merge"
    // points at avoided crossings -- a non-crossing minimum of the residual where
    // two same-family modes momentarily coincide (briefly a complex pair in the
    // lossless model). Emitting a degenerate pair there lets both branches pinch
    // together and stay connected through the anticrossing instead of dropping out.
    type SignedRoot = { u: number; sign: 1 | -1 };
    const rootsAt = (q: number): SignedRoot[] => {
      const found: SignedRoot[] = [];
      const lo0 = 1e-5;
      const hi0 = q * (1 - 1e-6); // bound modes live below the light line (u < q)
      if (hi0 <= lo0) return found;
      const n = 1500;
      for (const sign of [1, -1] as const) {
        const us: number[] = [];
        const vs: Array<number | null> = [];
        for (let i = 0; i <= n; i++) {
          const u = lo0 + (hi0 - lo0) * i / n;
          us.push(u);
          vs.push(caseGCubicResidual(q, u, dI, dM, dMPrime, sign));
        }
        for (let i = 1; i <= n; i++) {
          const prev = vs[i - 1];
          const cur = vs[i];
          if (prev === null || cur === null) continue;
          if (prev * cur < 0) {
            let lo = us[i - 1];
            let hi = us[i];
            let flo = prev;
            for (let k = 0; k < 60; k++) {
              const mid = 0.5 * (lo + hi);
              const fmid = caseGCubicResidual(q, mid, dI, dM, dMPrime, sign);
              if (fmid === null) break;
              if (flo * fmid < 0) hi = mid; else { lo = mid; flo = fmid; }
            }
            found.push({ u: 0.5 * (lo + hi), sign });
          }
        }
        for (let i = 2; i < n - 1; i++) {
          const v = vs[i];
          const vm = vs[i - 1];
          const vp = vs[i + 1];
          if (v === null || vm === null || vp === null) continue;
          if (Math.abs(v) < Math.abs(vm) && Math.abs(v) < Math.abs(vp) && Math.abs(v) < 6e-4) {
            if (!found.some(r => r.sign === sign && Math.abs(r.u - us[i]) < 3e-3)) {
              found.push({ u: us[i], sign });
              found.push({ u: us[i], sign });
            }
          }
        }
      }
      return found.sort((r1, r2) => r1.u - r2.u);
    };

    // Track each physical mode across q by continuity (predicted-slope nearest
    // match within the same symmetry family). This keeps every coloured curve on
    // one mode -- so it stays smooth and never jumps between modes at a crossing,
    // which previously produced kinks and made the renderer break the line.
    type Track = { pts: BranchPoint[]; lastU: number; lastQ: number; sign: 1 | -1; miss: number; dead: boolean };
    const tracks: Track[] = [];
    for (let s = 0; s < STEPS; s++) {
      const q = qStart + (qEnd - qStart) * s / (STEPS - 1);
      const roots = rootsAt(q);
      const used = new Array(roots.length).fill(false);
      const live = tracks.filter(t => !t.dead).sort((x, y) => x.miss - y.miss);
      for (const t of live) {
        const m = t.pts.length;
        const slope = m >= 2
          ? (t.pts[m - 1].u - t.pts[m - 2].u) / (t.pts[m - 1].q - t.pts[m - 2].q)
          : 0;
        const predicted = t.lastU + slope * (q - t.lastQ);
        let best = -1;
        let bestDist = Infinity;
        for (let j = 0; j < roots.length; j++) {
          if (used[j] || roots[j].sign !== t.sign) continue;
          const dist = Math.abs(roots[j].u - predicted);
          const tol = 0.03 + 0.8 * Math.abs(q - t.lastQ);
          if (dist < bestDist && dist < tol) { bestDist = dist; best = j; }
        }
        if (best >= 0) {
          used[best] = true;
          t.pts.push(formulaBranchPoint(q, roots[best].u, wp));
          t.lastU = roots[best].u;
          t.lastQ = q;
          t.miss = 0;
        } else if (++t.miss > 2) {
          t.dead = true;
        }
      }
      for (let j = 0; j < roots.length; j++) {
        if (used[j]) continue;
        tracks.push({
          pts: [formulaBranchPoint(q, roots[j].u, wp)],
          lastU: roots[j].u,
          lastQ: q,
          sign: roots[j].sign,
          miss: 0,
          dead: false,
        });
      }
    }

    // Keep the substantial tracks, ordered low-to-high energy so the Layer 2/4/6
    // colours and solid/dashed pairing stay consistent run to run.
    const ordered = tracks
      .filter(t => t.pts.length >= 5)
      .map(t => ({ track: t, meanU: t.pts.reduce((sum, p) => sum + p.u, 0) / t.pts.length }))
      .sort((p1, p2) => p1.meanU - p2.meanU)
      .map(p => p.track)
      .slice(0, 6);

    const branchMeta = [
      { label: 'Layer 2 solution 1', color: state.layers[1].color, dash: [7, 5], interfaceIndex: 0, layerIndex: 1 },
      { label: 'Layer 2 solution 2', color: state.layers[1].color, dash: undefined, interfaceIndex: 1, layerIndex: 1 },
      { label: 'Layer 4 solution 1', color: state.layers[3].color, dash: [7, 5], interfaceIndex: 2, layerIndex: 3 },
      { label: 'Layer 4 solution 2', color: state.layers[3].color, dash: undefined, interfaceIndex: 3, layerIndex: 3 },
      { label: 'Layer 6 solution 1', color: state.layers[5].color, dash: [7, 5], interfaceIndex: 4, layerIndex: 5 },
      { label: 'Layer 6 solution 2', color: state.layers[5].color, dash: undefined, interfaceIndex: 5, layerIndex: 5 },
    ] satisfies Array<{ label: string; color: string; dash?: number[]; interfaceIndex: number; layerIndex: number }>;

    return ordered.map((track, index) => ({
      ...branchMeta[Math.min(index, branchMeta.length - 1)],
      referenceWpEv: wp,
      points: track.pts,
    }));
  }

  function computeDmdFilmBranch(sign: 1 | -1, mode: string, dash?: number[]): BranchCurve {
    const dielectric = state.layers[0];
    const metal = state.layers[1];
    const wp = Math.max(metal.wpEv, wpReferenceEv());
    const thickness = Math.max(1e-6, metal.thicknessNm * (wp / HBARC_EV_NM));
    const qStart = Math.max(0.001, state.qMin);
    const qEnd = Math.max(qStart + 0.001, state.qMax);
    const points: BranchPoint[] = [];

    for (let i = 0; i < 460; i++) {
      const q = qStart + (qEnd - qStart) * i / 459;
      const roots = solveScalarRoots(u => {
        const x = xRatioForPair(q, u, metal, dielectric, wp);
        const km = layerKappa(q, u, metal, wp);
        if (x === null || km === null) return null;
        return x - sign * Math.exp(-km * thickness);
      // Bound modes of this vacuum-clad metal film sit below the light line
      // (u < q); scan only that window, densely, so both branches stay gap-free.
      }, 1e-5, q * (1 - 1e-6), 1500);
      if (roots.length) {
        const u = sign > 0 ? roots[roots.length - 1] : roots[0];
        points.push(filmBranchPoint(q, u, metal, dielectric, wp));
      }
    }

    return {
      interfaceIndex: 0,
      layerIndex: 1,
      label: mode,
      color: metal.color,
      referenceWpEv: wp,
      dash,
      points,
    };
  }

  function computeMdmFilmBranch(sign: 1 | -1, mode: string, dash?: number[]): BranchCurve {
    const metal = state.layers[0];
    const dielectric = state.layers[1];
    const wp = Math.max(metal.wpEv, wpReferenceEv());
    const thickness = Math.max(1e-6, dielectric.thicknessNm * (wp / HBARC_EV_NM));
    const qStart = Math.max(0.001, state.qMin);
    const qEnd = Math.max(qStart + 0.001, state.qMax);
    const uMin = Math.max(1e-4, state.uMin);
    const uMax = Math.max(uMin + 1e-4, state.uMax);
    const points: BranchPoint[] = [];

    for (let i = 0; i < 460; i++) {
      const q = qStart + (qEnd - qStart) * i / 459;
      const roots = solveScalarRoots(u => {
        const energyEv = u * wp;
        const epsMetal = epsilonLossless(metal, energyEv);
        const epsDielectric = epsilonLossless(dielectric, energyEv);
        const kappaMetal = layerKappa(q, u, metal, wp);
        if (
          kappaMetal === null
          || !Number.isFinite(epsMetal)
          || !Number.isFinite(epsDielectric)
          || epsMetal >= 0
        ) {
          // A bound surface mode requires a metallic cladding (eps_metal < 0).
          // Above the plasma frequency the Drude metal is transparent, so reject
          // those (spurious, u > 1) roots that would otherwise break the branch.
          return null;
        }
        // Symmetric metal/insulator/metal dispersion in the half-thickness tanh form.
        // When the field inside the insulating film is evanescent (q^2 > eps_d*u^2)
        // this is the usual relation and matches the previous exp(-kd*d) formulation
        // exactly. When the film field turns oscillatory (q^2 < eps_d*u^2) the analytic
        // continuation kappa_d -> i*beta_d sends tanh -> tan, which lets the lower
        // (solid) branch continue below the film light line down toward q -> 0 instead
        // of stopping where the old evanescent-only solver ran out of real roots.
        const filmTransverse = q * q - epsDielectric * u * u;
        if (filmTransverse >= 0) {
          const kappaD = Math.sqrt(filmTransverse);
          const th = Math.tanh(kappaD * thickness / 2);
          return sign > 0
            ? epsMetal * kappaD * th + kappaMetal * epsDielectric
            : epsMetal * kappaD + kappaMetal * epsDielectric * th;
        }
        const betaD = Math.sqrt(-filmTransverse);
        // Stay on the fundamental oscillatory branch (below the first tan pole).
        if (betaD * thickness / 2 > Math.PI / 2 - 1e-3) return null;
        const tn = Math.tan(betaD * thickness / 2);
        return sign > 0
          ? -epsMetal * betaD * tn + kappaMetal * epsDielectric
          : epsMetal * betaD + kappaMetal * epsDielectric * tn;
      }, uMin, uMax);
      if (roots.length) {
        const u = sign > 0 ? roots[roots.length - 1] : roots[0];
        points.push(filmBranchPoint(q, u, metal, dielectric, wp));
      }
    }

    return {
      interfaceIndex: 0,
      layerIndex: 1,
      label: mode,
      color: dielectric.color,
      referenceWpEv: wp,
      dash,
      points,
    };
  }

  function computeCoupledFilmBranches(): BranchCurve[] | null {
    if (hasSymmetricDmdFilm()) {
      return [
        computeDmdFilmBranch(+1, 'Layer 2 solution 1', [7, 5]),
        computeDmdFilmBranch(-1, 'Layer 2 solution 2'),
      ].filter(curve => curve.points.length);
    }
    if (hasSymmetricMdmFilm()) {
      return [
        computeMdmFilmBranch(+1, 'Layer 2 solution 1', [7, 5]),
        computeMdmFilmBranch(-1, 'Layer 2 solution 2'),
      ].filter(curve => curve.points.length);
    }
    if (hasSwihartStack()) {
      return computeSwihartBranches().filter(curve => curve.points.length);
    }
    if (hasCaseEStack()) {
      return computeCaseEBranches().filter(curve => curve.points.length);
    }
    if (hasCaseFStack()) {
      return computeCaseFBranches().filter(curve => curve.points.length);
    }
    if (hasCaseGStack()) {
      return computeCaseGBranches().filter(curve => curve.points.length);
    }
    return null;
  }

  function computeBranchFor(interfaceIndex: number): BranchPoint[] {
    const [a, b] = interfacePair(interfaceIndex);
    const wp = wpReferenceEv();
    const kp = kpReferenceNm();
    const eMin = Math.max(0.001, state.uMin * wp);
    const eMax = Math.max(eMin + 0.001, state.uMax * wp);

    const sampleAt = (energyEv: number): BranchPoint | null => {
      const epsA = epsilonLossless(a, energyEv);
      const epsB = epsilonLossless(b, energyEv);
      const denom = epsA + epsB;
      const contrast = epsA * epsB < 0;
      if (!Number.isFinite(epsA) || !Number.isFinite(epsB) || Math.abs(denom) < 1e-10 || !contrast) return null;
      const ratio = epsA * epsB / denom;
      if (!Number.isFinite(ratio) || ratio <= 0) return null;
      const kNm = (energyEv / HBARC_EV_NM) * Math.sqrt(ratio);
      const q = kNm / kp;
      const u = energyEv / wp;
      if (!Number.isFinite(q) || !Number.isFinite(u)) return null;
      return { q, u, kNm, energyEv, epsA, epsB };
    };

    // Sample uniformly in energy, then adaptively refine intervals where the
    // momentum q changes too fast. Near the surface-plasmon asymptote q -> infinity
    // as the energy approaches omega_sp, so a plain uniform-energy grid leaves huge
    // q-gaps in the tail; drawableSegments then treats those gaps as breaks and
    // chops off the high-q part of the curve before it reaches the plotted range.
    // Bisecting on energy until adjacent q-gaps are small keeps the branch a single
    // continuous segment all the way to the right edge of the plot.
    const coarse = 600;
    const qSpan = Math.max(1e-9, state.qMax - state.qMin);
    const targetQGap = qSpan / 280;
    const refineCeil = state.qMin + qSpan * 1.12; // stop chasing the asymptote past the edge
    const maxDepth = 22;
    const points: BranchPoint[] = [];

    const refine = (eL: number, pL: BranchPoint | null, eR: number, pR: BranchPoint | null, depth: number): void => {
      if (pL) points.push(pL);
      if (depth >= maxDepth || !pL || !pR) return;
      const gap = Math.abs(pR.q - pL.q);
      const within = Math.min(pL.q, pR.q) <= refineCeil;
      if (gap > targetQGap && within) {
        const eM = 0.5 * (eL + eR);
        const pM = sampleAt(eM);
        refine(eL, pL, eM, pM, depth + 1);
        refine(eM, pM, eR, pR, depth + 1);
      }
    };

    let prevE = eMin;
    let prevP = sampleAt(eMin);
    for (let i = 1; i < coarse; i++) {
      const energyEv = eMin + (eMax - eMin) * i / (coarse - 1);
      const p = sampleAt(energyEv);
      refine(prevE, prevP, energyEv, p, 0);
      prevE = energyEv;
      prevP = p;
    }
    if (prevP) points.push(prevP);

    points.sort((p1, p2) => p1.q - p2.q);
    return points;
  }

  function computeBranches(): BranchCurve[] {
    const coupledFilmBranches = computeCoupledFilmBranches();
    if (coupledFilmBranches) return coupledFilmBranches;

    const indices = interfaceIndices();
    const layerSolutions = layerSolutionsFor(indices);
    return indices.map(interfaceIndex => {
      const solution = layerSolutions.get(interfaceIndex) ?? {
        layerIndex: plasmonLayerIndex(interfaceIndex),
        solutionNumber: 1,
        solutionCount: 1,
      };
      return {
        interfaceIndex,
        layerIndex: solution.layerIndex,
        label: layerSolutionLabel(interfaceIndex, solution),
        color: interfaceColor(interfaceIndex),
        referenceWpEv: state.layers[solution.layerIndex]?.wpEv > 0
          ? state.layers[solution.layerIndex].wpEv
          : wpReferenceEv(interfaceIndex),
        dash: solution.solutionCount > 1 && solution.solutionNumber === 1 ? [7, 5] : undefined,
        points: computeBranchFor(interfaceIndex),
      };
    });
  }

  function niceTicks(min: number, max: number, count = 6): number[] {
    if (!Number.isFinite(min) || !Number.isFinite(max) || max <= min) return [];
    const span = max - min;
    const raw = span / Math.max(1, count);
    const power = Math.pow(10, Math.floor(Math.log10(raw)));
    const scaled = raw / power;
    const step = (scaled <= 1 ? 1 : scaled <= 2 ? 2 : scaled <= 5 ? 5 : 10) * power;
    const start = Math.ceil(min / step) * step;
    const ticks: number[] = [];
    for (let value = start; value <= max + step * 0.25; value += step) {
      if (value >= min - step * 0.25) ticks.push(Math.abs(value) < step * 1e-9 ? 0 : value);
    }
    return ticks.slice(0, 10);
  }

  function rangeDisplay() {
    const xMin = qToX(state.qMin);
    const xMax = qToX(state.qMax);
    if (isWavelengthUnit()) {
      const wp = wpReferenceEv();
      const lowU = state.uMin > 0 ? state.uMin : 0.08;
      const lowEnergy = Math.max(0.001, lowU * wp);
      const highEnergy = Math.max(lowEnergy + 0.001, state.uMax * wp);
      return { xMin, xMax, yMin: energyToY(highEnergy), yMax: energyToY(lowEnergy) };
    }
    const yMin = energyToY(state.uMin * wpReferenceEv());
    const yMax = energyToY(state.uMax * wpReferenceEv());
    return { xMin, xMax, yMin, yMax };
  }

  function xRangeLabelHtml(bound: 'min' | 'max'): string {
    const label = bound === 'min' ? 'Min' : 'Max';
    if (state.xUnit === 'nm') return `${label} (nm<sup>-1</sup>)`;
    if (state.xUnit === 'cm') return `${label} (cm<sup>-1</sup>)`;
    return label;
  }

  function yRangeLabelHtml(bound: 'min' | 'max'): string {
    const label = bound === 'min' ? 'Min' : 'Max';
    if (state.yUnit === 'ev') return `${label} (eV)`;
    if (state.yUnit === 'hz') return `${label} (10<sup>15</sup> Hz)`;
    if (state.yUnit === 'lambda-nm') return `${label} (nm)`;
    if (state.yUnit === 'lambda-um') return `${label} (&mu;m)`;
    return label;
  }

  function syncRangeInputs() {
    const ranges = rangeDisplay();
    const xStep = state.xUnit === 'cm' ? '1000' : state.xUnit === 'kp' ? '0.01' : '0.001';
    const yStep = state.yUnit === 'hz'
      ? '0.01'
      : state.yUnit === 'wp' || state.yUnit === 'lambda-lp'
        ? '0.01'
        : state.yUnit === 'lambda-um'
          ? '0.01'
          : state.yUnit === 'lambda-nm'
            ? '10'
            : '0.05';
    $('x-min-label').innerHTML = xRangeLabelHtml('min');
    $('x-max-label').innerHTML = xRangeLabelHtml('max');
    $('y-min-label').innerHTML = yRangeLabelHtml('min');
    $('y-max-label').innerHTML = yRangeLabelHtml('max');
    const xMin = $('x-min') as HTMLInputElement;
    const xMax = $('x-max') as HTMLInputElement;
    const yMin = $('y-min') as HTMLInputElement;
    const yMax = $('y-max') as HTMLInputElement;
    xMin.step = xStep;
    xMax.step = xStep;
    yMin.step = yStep;
    yMax.step = yStep;
    xMin.value = fmt(ranges.xMin, 6);
    xMax.value = fmt(ranges.xMax, 6);
    yMin.value = fmt(ranges.yMin, 5);
    yMax.value = fmt(ranges.yMax, 5);
  }

  function syncUnitButtons() {
    const activeYKind = yAxisKind();
    document.querySelectorAll<HTMLButtonElement>('#y-axis-kind-tabs [data-y-kind]').forEach(btn => {
      const active = btn.dataset.yKind === activeYKind;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
    });
    document.querySelectorAll<HTMLButtonElement>('[data-x-unit]').forEach(btn => {
      const active = btn.dataset.xUnit === state.xUnit;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
    });
    document.querySelectorAll<HTMLButtonElement>('[data-y-unit]').forEach(btn => {
      const visible = btn.dataset.yKind === activeYKind;
      btn.hidden = !visible;
      btn.setAttribute('aria-hidden', visible ? 'false' : 'true');
      const active = btn.dataset.yUnit === state.yUnit;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
    });
    const wpSelect = $('wp-reference-select') as HTMLSelectElement;
    const metalIndices = metalLayerIndices();
    const showWpSelect = state.yUnit === 'wp' && metalIndices.length > 0;
    if (showWpSelect && !metalIndices.includes(state.wpAxisLayerIndex)) {
      state.wpAxisLayerIndex = metalIndices[0];
    }
    wpSelect.hidden = !showWpSelect;
    wpSelect.setAttribute('aria-hidden', showWpSelect ? 'false' : 'true');
    wpSelect.innerHTML = metalIndices.map(index => {
      const layer = state.layers[index];
      return `<option value="${index}">Layer ${index + 1} (${fmt(layer.wpEv, 4)} eV)</option>`;
    }).join('');
    if (showWpSelect) wpSelect.value = String(state.wpAxisLayerIndex);
  }

  function syncDisplayButtons() {
    selectedLayerIndices();
  }

  function syncReferenceControls() {
    ($('show-light') as HTMLInputElement).checked = state.showLight;
    ($('show-tailored') as HTMLInputElement).checked = state.showTailored;
    ($('tailored-slope') as HTMLInputElement).value = fmt(state.tailoredSlope, 4);
    ($('tailored-slope-slider') as HTMLInputElement).value = fmt(clamp(state.tailoredSlope, 0, 2), 4);
  }

  function normalizeLayers() {
    state.layers.forEach((layer, index) => {
      layer.finite = index > 0 && index < state.layers.length - 1;
      layer.color = layer.color || palette[index % palette.length];
      layer.epsInf = Math.max(0.05, finiteNumber(layer.epsInf, 1));
      layer.wpEv = Math.max(0, finiteNumber(layer.wpEv, 0));
      layer.gammaEv = Math.max(0, finiteNumber(layer.gammaEv, 0));
      layer.thicknessNm = Math.max(0, finiteNumber(layer.thicknessNm, 0));
      layer.name = layer.finite ? filmName(layer.thicknessNm) : layer.name || `Layer ${index + 1}`;
    });
    state.activeInterface = clamp(state.activeInterface, 0, state.layers.length - 2);
    selectedLayerIndices();
  }

  function renderStack() {
    normalizeLayers();
    stackPreview.style.setProperty('--stack-count', String(state.layers.length));
    stackPreview.innerHTML = state.layers.map((layer, index) => {
      const safeName = layer.name.replace(/[<>&"]/g, '');
      const label = index === 0 ? 'top' : index === state.layers.length - 1 ? 'bot' : `${fmt(layer.thicknessNm, 3)} nm`;
      const materialLetter = layer.wpEv <= 0 ? 'D' : 'M';
      return `
        <div class="stack-layer" style="background:${layer.color}" title="${safeName}">
          <span class="stack-layer__index">${index + 1}</span>
          <span class="stack-layer__kind">${materialLetter}</span>
          <span class="stack-layer__label">${label}</span>
        </div>
      `;
    }).join('');

    $('layer-count').textContent = `${state.layers.length}`;
    ($('remove-layer') as HTMLButtonElement).disabled = state.layers.length <= MIN_LAYERS;
    ($('add-layer') as HTMLButtonElement).disabled = state.layers.length >= MAX_LAYERS;
  }

  function renderInterfaceTabs() {
    normalizeLayers();
    const selected = new Set(selectedLayerIndices());
    const allActive = state.showAllLayers;
    const allButton = `<button type="button" class="interface-btn interface-btn--all ${allActive ? 'active' : ''}" data-layer-all="true" role="checkbox" aria-checked="${allActive ? 'true' : 'false'}">All</button>`;
    const layerButtons = plottableLayerIndices().map(index => {
      const active = selected.has(index);
      const layer = state.layers[index];
      const label = `Layer ${index + 1}`.replace(/[<>&"]/g, '');
      return `<button type="button" class="interface-btn ${active ? 'active' : ''}" style="--layer-color:${layer.color}" data-layer="${index}" role="checkbox" aria-checked="${active ? 'true' : 'false'}" aria-label="${label}" title="${label}">${index + 1}</button>`;
    }).join('');
    interfaceTabs.innerHTML = allButton + layerButtons;
  }

  function renderLayerEditor() {
    normalizeLayers();
    layerEditor.innerHTML = state.layers.map((layer, index) => {
      const header = layer.finite
        ? `
          <label class="layer-thickness-inline">
            <span class="layer-chip"><span class="layer-swatch" style="background:${layer.color}"></span>Layer ${index + 1} thickness (nm)</span>
            <input type="number" class="layer-input" data-layer="${index}" data-key="thicknessNm" value="${fmt(layer.thicknessNm, 6)}" step="1" min="0">
          </label>
        `
        : `
          <span class="layer-chip"><span class="layer-swatch" style="background:${layer.color}"></span>Layer ${index + 1}</span>
          <span class="layer-boundary">semi-infinite</span>
        `;
      return `
        <div class="layer-row" data-layer-row="${index}">
          <div class="layer-row__header">
            ${header}
          </div>
          <div class="layer-fields layer-fields--compact">
            <div class="material-triplet">
              <label class="layer-field">
                <span>&epsilon;<sub>&infin;</sub></span>
                <input type="number" class="layer-input" data-layer="${index}" data-key="epsInf" value="${fmt(layer.epsInf, 6)}" step="0.1" min="0.05">
              </label>
              <label class="layer-field">
                <span>&omega;<sub>p</sub> (eV)</span>
                <input type="number" class="layer-input" data-layer="${index}" data-key="wpEv" value="${fmt(layer.wpEv, 6)}" step="0.05" min="0">
              </label>
              <label class="layer-field">
                <span>&gamma; (eV)</span>
                <input type="number" class="layer-input" data-layer="${index}" data-key="gammaEv" value="${fmt(layer.gammaEv, 6)}" step="0.01" min="0">
              </label>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  function addLayer() {
    if (state.layers.length >= MAX_LAYERS) return;
    const filmCount = state.layers.length - 1;
    const isMetal = filmCount % 2 === 1;
    state.layers.splice(state.layers.length - 1, 0, {
      name: filmName(25),
      epsInf: isMetal ? 1.0 : 2.25,
      wpEv: isMetal ? 8.5 : 0.0,
      gammaEv: isMetal ? 0.06 : 0.0,
      thicknessNm: 25,
      finite: true,
      color: palette[filmCount % palette.length],
    });
    state.activeInterface = Math.min(state.activeInterface, state.layers.length - 2);
    state.selectedLayerIndices = [plottableLayerIndices()[0] ?? 0];
    invalidateBranches();
    renderAll(true);
  }

  function removeLayer() {
    if (state.layers.length <= MIN_LAYERS) return;
    state.layers.splice(state.layers.length - 2, 1);
    state.activeInterface = clamp(state.activeInterface, 0, state.layers.length - 2);
    state.selectedLayerIndices = normalizeLayerSelection(state.selectedLayerIndices);
    invalidateBranches();
    renderAll(true);
  }

  function resetAxesAndReferences() {
    state.activeInterface = 0;
    state.selectedLayerIndices = [1];
    state.previousSelectedLayerIndices = [1];
    state.xUnit = 'nm';
    state.yUnit = 'ev';
    state.qMin = 0.0;
    state.qMax = 3.0;
    state.uMin = 0.0;
    state.uMax = 1.18;
    state.wpAxisLayerIndex = -1;
    state.tailoredSlope = 0.35;
    state.showLight = true;
    state.showSurfaceLimit = true;
    state.surfaceLimitDenominators = {};
    state.surfaceLimitKeys = [];
    state.showTailored = true;
    state.showAllLayers = false;
  }

  function applyPreset(layers: Layer[], showAllInterfaces = false) {
    state.layers = layers;
    resetAxesAndReferences();
    if (showAllInterfaces) {
      state.showAllLayers = true;
      state.selectedLayerIndices = plottableLayerIndices();
    } else {
      state.selectedLayerIndices = [plottableLayerIndices()[0] ?? 0];
    }
    normalizeLayers();
    invalidateBranches();
    renderAll(true);
  }

  function applyFigure2Preset() {
    state.layers = makeDefaultLayers();
    resetAxesAndReferences();
    state.xUnit = 'kp';
    state.yUnit = 'wp';
    state.qMin = 0;
    state.qMax = 1.5;
    state.uMin = 0;
    state.uMax = 1.25;
    normalizeLayers();
    state.selectedLayerIndices = [plottableLayerIndices()[0] ?? 0];
    invalidateBranches();
    renderAll(true);
  }

  function resetParameters() {
    applyPreset(makeDefaultLayers(), false);
  }

  function setLayerValue(input: HTMLInputElement) {
    const index = Number.parseInt(input.dataset.layer ?? '-1', 10);
    const key = input.dataset.key as keyof Layer | undefined;
    if (!Number.isInteger(index) || index < 0 || index >= state.layers.length || !key) return;
    if (key === 'name') {
      state.layers[index].name = input.value.trim() || `Layer ${index + 1}`;
    } else if (['epsInf', 'wpEv', 'gammaEv', 'thicknessNm'].includes(key)) {
      const value = Number.parseFloat(input.value);
      if (Number.isFinite(value)) {
        (state.layers[index][key] as number) = value;
      }
    }
    normalizeLayers();
    renderStack();
    renderInterfaceTabs();
    if (key === 'thicknessNm') renderLayerEditor();
    syncUnitButtons();
    syncRangeInputs();
    invalidateBranches();
    drawChart();
    updateOutputs();
  }

  function lineYFromX(xValue: number, slope: number): number {
    const q = xToQ(xValue);
    return uToY(slope * q);
  }

  function drawReferenceLine(
    ctx: CanvasRenderingContext2D,
    plot: { left: number; top: number; width: number; height: number; xMin: number; xMax: number; yMin: number; yMax: number },
    slope: number,
    color: string,
    label: string,
    dash: number[],
  ) {
    const xToPx = (x: number) => plot.left + (x - plot.xMin) / (plot.xMax - plot.xMin) * plot.width;
    const yToPx = (y: number) => plot.top + plot.height - (y - plot.yMin) / (plot.yMax - plot.yMin) * plot.height;
    ctx.save();
    ctx.beginPath();
    ctx.rect(plot.left, plot.top, plot.width, plot.height);
    ctx.clip();
    ctx.setLineDash(dash);
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    let started = false;
    for (let i = 0; i <= 180; i++) {
      const x = plot.xMin + (plot.xMax - plot.xMin) * i / 180;
      const y = lineYFromX(x, slope);
      if (!Number.isFinite(y)) {
        started = false;
        continue;
      }
      const px = xToPx(x);
      const py = yToPx(y);
      if (!started) {
        ctx.moveTo(px, py);
        started = true;
      } else {
        ctx.lineTo(px, py);
      }
    }
    ctx.stroke();
    ctx.setLineDash([]);
    const labelX = plot.left + plot.width - 8;
    const labelY = yToPx(lineYFromX(plot.xMax, slope));
    if (labelY > plot.top + 14 && labelY < plot.top + plot.height - 6) {
      ctx.fillStyle = color;
      ctx.font = '700 10px Inter, system-ui, sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText(label, labelX, labelY - 4);
    }
    ctx.restore();
  }

  function drawHorizontalReference(
    ctx: CanvasRenderingContext2D,
    plot: { left: number; top: number; width: number; height: number; yMin: number; yMax: number },
    yValue: number,
    color: string,
    label: string,
  ) {
    if (!Number.isFinite(yValue) || yValue < plot.yMin || yValue > plot.yMax) return;
    const y = plot.top + plot.height - (yValue - plot.yMin) / (plot.yMax - plot.yMin) * plot.height;
    ctx.save();
    ctx.setLineDash([3, 4]);
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(plot.left, y);
    ctx.lineTo(plot.left + plot.width, y);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = color;
    ctx.font = '700 10px Inter, system-ui, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText(label, plot.left + 8, y - 5);
    ctx.restore();
  }

  function surfaceLimitKeyForLayer(layerIndex: number): string {
    return `layer-${layerIndex}`;
  }

  function surfaceLimitDenominator(key: string): number {
    return Math.max(1e-6, state.surfaceLimitDenominators[key] ?? 2);
  }

  function layerLegendEntries(branches: BranchCurve[]): LayerLegendEntry[] {
    const entries = new Map<number, LayerLegendEntry>();
    branches.forEach(curve => {
      if (!curve.points.length || entries.has(curve.layerIndex)) return;
      const layer = state.layers[curve.layerIndex];
      entries.set(curve.layerIndex, {
        layerIndex: curve.layerIndex,
        label: `Layer ${curve.layerIndex + 1}`,
        color: layer?.color ?? curve.color,
        referenceWpEv: curve.referenceWpEv ?? (layer?.wpEv && layer.wpEv > 0 ? layer.wpEv : wpReferenceEv(curve.interfaceIndex)),
      });
    });
    return Array.from(entries.values()).sort((a, b) => a.layerIndex - b.layerIndex);
  }

  function syncSurfaceLimitKeys(entries: LayerLegendEntry[]) {
    const keys = entries.map(entry => surfaceLimitKeyForLayer(entry.layerIndex));
    const previous = state.surfaceLimitKeys.filter(key => keys.includes(key));
    if (state.showSurfaceLimit && !previous.length && keys.length) {
      state.surfaceLimitKeys = [keys[0]];
      return;
    }
    state.surfaceLimitKeys = previous;
  }

  function surfaceLimitY(entry: LayerLegendEntry): number {
    return energyToY(entry.referenceWpEv / Math.sqrt(surfaceLimitDenominator(surfaceLimitKeyForLayer(entry.layerIndex))));
  }

  function visibleBranchesFrom(branches: BranchCurve[]): BranchCurve[] {
    const visibleLayers = new Set(selectedLayerIndices());
    return branches.filter(curve => visibleLayers.has(curve.layerIndex));
  }

  function drawChart() {
    const theme = chartTheme();
    if (branchesDirty) {
      solvedBranches = computeBranches();
      solveCounter += 1;
      branchesDirty = false;
    }
    currentBranches = visibleBranchesFrom(solvedBranches);
    const visibleLayerEntries = layerLegendEntries(currentBranches);
    syncSurfaceLimitKeys(visibleLayerEntries);
    currentBranch = currentBranches.find(curve => curve.layerIndex === selectedLayerIndices()[0])?.points ?? currentBranches[0]?.points ?? [];

    const rect = chartWrap.getBoundingClientRect();
    const width = Math.max(320, rect.width || 760);
    const height = Math.max(320, canvas.clientHeight || 430);
    const dpr = window.devicePixelRatio || 1;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    canvas.style.height = `${height}px`;
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const margin = { top: 26, right: 28, bottom: 58, left: 72 };
    const ranges = rangeDisplay();
    const plot = {
      left: margin.left,
      top: margin.top,
      width: width - margin.left - margin.right,
      height: height - margin.top - margin.bottom,
      xMin: ranges.xMin,
      xMax: ranges.xMax,
      yMin: ranges.yMin,
      yMax: ranges.yMax,
    };
    lastPlot = plot;

    const xToPx = (x: number) => plot.left + (x - plot.xMin) / (plot.xMax - plot.xMin) * plot.width;
    const yToPx = (y: number) => plot.top + plot.height - (y - plot.yMin) / (plot.yMax - plot.yMin) * plot.height;

    ctx.clearRect(0, 0, width, height);
    ctx.fillStyle = theme.bg;
    ctx.fillRect(0, 0, width, height);
    ctx.fillStyle = theme.bg;
    ctx.fillRect(plot.left, plot.top, plot.width, plot.height);

    const xTicks = niceTicks(plot.xMin, plot.xMax, 6);
    const yTicks = niceTicks(plot.yMin, plot.yMax, 6);
    ctx.strokeStyle = theme.grid;
    ctx.lineWidth = 1;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillStyle = theme.textSoft;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (const tick of xTicks) {
      const x = xToPx(tick);
      ctx.beginPath();
      ctx.moveTo(x, plot.top);
      ctx.lineTo(x, plot.top + plot.height);
      ctx.stroke();
      ctx.fillText(fmt(tick, 4), x, plot.top + plot.height + 8);
    }
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    for (const tick of yTicks) {
      const y = yToPx(tick);
      ctx.beginPath();
      ctx.moveTo(plot.left, y);
      ctx.lineTo(plot.left + plot.width, y);
      ctx.stroke();
      ctx.fillText(fmt(tick, 4), plot.left - 10, y);
    }

    ctx.strokeStyle = theme.text;
    ctx.lineWidth = 1.2;
    ctx.strokeRect(plot.left, plot.top, plot.width, plot.height);

    ctx.fillStyle = theme.text;
    ctx.font = '700 12px Inter, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    ctx.fillText(xLabel(), plot.left + plot.width / 2, height - 10);
    ctx.save();
    ctx.translate(18, plot.top + plot.height / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textBaseline = 'top';
    ctx.fillText(yLabel(), 0, 0);
    ctx.restore();

    if (state.showLight) {
      drawReferenceLine(ctx, plot, 1.0, '#64748B', 'light', [5, 5]);
    }
    if (state.showTailored && state.tailoredSlope > 0) {
      drawReferenceLine(ctx, plot, state.tailoredSlope, '#F97316', `${fmt(state.tailoredSlope, 3)} c`, [2, 5]);
    }
    if (state.showSurfaceLimit) {
      visibleLayerEntries.forEach(entry => {
        const key = surfaceLimitKeyForLayer(entry.layerIndex);
        if (state.surfaceLimitKeys.includes(key)) {
          drawHorizontalReference(ctx, plot, surfaceLimitY(entry), entry.color, `wp/sqrt(${fmt(surfaceLimitDenominator(key), 3)})`);
        }
      });
    }

    for (const curve of currentBranches) {
      ctx.save();
      ctx.beginPath();
      ctx.rect(plot.left, plot.top, plot.width, plot.height);
      ctx.clip();
      ctx.strokeStyle = curve.color;
      ctx.lineWidth = curve.layerIndex === selectedLayerIndices()[0] ? 2.8 : 2.2;
      ctx.setLineDash(curve.dash ?? []);
      ctx.globalAlpha = 1;
      for (const segment of drawableSegments(curve.points)) {
        ctx.beginPath();
        let started = false;
        for (const point of segment) {
          const x = qToX(point.q);
          const y = energyToY(point.energyEv);
          if (!Number.isFinite(x) || !Number.isFinite(y)) {
            started = false;
            continue;
          }
          const px = xToPx(x);
          const py = yToPx(y);
          if (!started) {
            ctx.moveTo(px, py);
            started = true;
          } else {
            ctx.lineTo(px, py);
          }
        }
        if (started) ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.restore();
    }

    if (hoveredPoint) {
      ctx.save();
      ctx.beginPath();
      ctx.rect(plot.left, plot.top, plot.width, plot.height);
      ctx.clip();
      ctx.setLineDash([3, 4]);
      ctx.strokeStyle = hoveredPoint.curve.color;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(hoveredPoint.px, plot.top);
      ctx.lineTo(hoveredPoint.px, plot.top + plot.height);
      ctx.moveTo(plot.left, hoveredPoint.py);
      ctx.lineTo(plot.left + plot.width, hoveredPoint.py);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = hoveredPoint.curve.color;
      ctx.strokeStyle = theme.bg;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(hoveredPoint.px, hoveredPoint.py, 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.restore();
    }

    const branchLegend = visibleLayerEntries
      .map(entry => {
        const key = surfaceLimitKeyForLayer(entry.layerIndex);
        const checked = state.showSurfaceLimit && state.surfaceLimitKeys.includes(key);
        const safeLabel = entry.label.replace(/[<>&"]/g, '');
        return `
          <span class="legend-row">
            <span class="legend-item" style="color:${entry.color}">
              <span class="legend-swatch"></span>${safeLabel}
            </span>
            <label class="surface-limit-control" style="color:${entry.color}">
              <input type="checkbox" data-surface-limit-key="${key}" ${checked ? 'checked' : ''}>
              <span>&omega;<sub>p</sub>/sqrt(</span>
              <input type="number" class="surface-limit-input" data-surface-denominator="true" data-surface-limit-key="${key}" value="${fmt(surfaceLimitDenominator(key), 4)}" min="0.05" step="0.05">
              <span>)</span>
            </label>
          </span>
        `;
      })
      .filter(Boolean);
    chartLegend.innerHTML = branchLegend.join('');

    (window as Window & {
      surfacePlasmonDebug?: {
        getBranches: () => Array<{ label: string; layerIndex: number; color: string; dashed: boolean; referenceWpEv: number | null; points: BranchPoint[]; segments: BranchPoint[][] }>
        getAllBranches: () => Array<{ label: string; layerIndex: number; color: string; dashed: boolean; referenceWpEv: number | null; points: BranchPoint[]; segments: BranchPoint[][] }>
        getAxisState: () => { yUnit: AxisY; wpAxisLayerIndex: number; wpAxisReferenceEv: number; yLabel: string }
        getSolveCount: () => number
      }
    }).surfacePlasmonDebug = {
      getBranches: () => currentBranches.map(curve => ({
        label: curve.label,
        layerIndex: curve.layerIndex,
        color: curve.color,
        dashed: Boolean(curve.dash),
        referenceWpEv: curve.referenceWpEv ?? null,
        points: curve.points.map(point => ({ ...point })),
        segments: drawableSegments(curve.points).map(segment => segment.map(point => ({ ...point }))),
      })),
      getAllBranches: () => solvedBranches.map(curve => ({
        label: curve.label,
        layerIndex: curve.layerIndex,
        color: curve.color,
        dashed: Boolean(curve.dash),
        referenceWpEv: curve.referenceWpEv ?? null,
        points: curve.points.map(point => ({ ...point })),
        segments: drawableSegments(curve.points).map(segment => segment.map(point => ({ ...point }))),
      })),
      getAxisState: () => ({
        yUnit: state.yUnit,
        wpAxisLayerIndex: state.wpAxisLayerIndex,
        wpAxisReferenceEv: wpAxisReferenceEv(),
        yLabel: yLabel(),
      }),
      getSolveCount: () => solveCounter,
    };

    updateOutputs();
  }

  function xTooltipLabel(): string {
    if (state.xUnit === 'nm') return 'k (1/nm)';
    if (state.xUnit === 'cm') return 'k (1/cm)';
    return 'k/kp';
  }

  function yTooltipLabel(): string {
    if (state.yUnit === 'ev') return 'Photon energy &hbar;&omega; (eV)';
    if (state.yUnit === 'hz') return 'Frequency x 10^15 (Hz)';
    if (state.yUnit === 'lambda-nm') return 'Photon wavelength &lambda; (nm)';
    if (state.yUnit === 'lambda-um') return 'Photon wavelength &lambda; (&mu;m)';
    if (state.yUnit === 'lambda-lp') return 'Photon wavelength &lambda;/&lambda;<sub>p</sub>';
    return 'omega/omega_p';
  }

  function updateTooltip(mouseX: number, mouseY: number, hover: HoveredPoint) {
    const point = hover.point;
    const currentX = qToX(point.q);
    const currentY = energyToY(point.energyEv);
    chartTooltip.hidden = false;
    chartTooltip.innerHTML = `
      <span><strong>Title:</strong> <b style="color:${hover.curve.color}">${hover.curve.label}</b></span>
      <span><strong>X axis:</strong> ${xTooltipLabel()} = ${fmt(currentX, 5)}</span>
      <span><strong>Y axis:</strong> ${yTooltipLabel()} = ${fmt(currentY, 5)}</span>
    `;
    const wrapWidth = chartWrap.clientWidth;
    const wrapHeight = chartWrap.clientHeight;
    const tooltipWidth = chartTooltip.offsetWidth || 220;
    const tooltipHeight = chartTooltip.offsetHeight || 120;
    const left = clamp(mouseX + 14, 8, Math.max(8, wrapWidth - tooltipWidth - 8));
    const top = clamp(mouseY - tooltipHeight - 12, 8, Math.max(8, wrapHeight - tooltipHeight - 8));
    chartTooltip.style.left = `${left}px`;
    chartTooltip.style.top = `${top}px`;
  }

  function handleCanvasHover(event: MouseEvent) {
    if (!lastPlot || !currentBranches.length) return;
    const rect = canvas.getBoundingClientRect();
    const mouseX = event.clientX - rect.left;
    const mouseY = event.clientY - rect.top;
    const plot = lastPlot;
    if (mouseX < plot.left || mouseX > plot.left + plot.width || mouseY < plot.top || mouseY > plot.top + plot.height) {
      hoveredPoint = null;
      chartTooltip.hidden = true;
      drawChart();
      return;
    }

    const xToPx = (x: number) => plot.left + (x - plot.xMin) / (plot.xMax - plot.xMin) * plot.width;
    const yToPx = (y: number) => plot.top + plot.height - (y - plot.yMin) / (plot.yMax - plot.yMin) * plot.height;
    let best: HoveredPoint | null = null;
    let bestDistance = Infinity;

    for (const curve of currentBranches) {
      for (const segment of drawableSegments(curve.points)) {
        for (const point of segment) {
          const x = qToX(point.q);
          const y = energyToY(point.energyEv);
          if (x < plot.xMin || x > plot.xMax || y < plot.yMin || y > plot.yMax) continue;
          const px = xToPx(x);
          const py = yToPx(y);
          const distance = (px - mouseX) ** 2 + (py - mouseY) ** 2;
          if (distance < bestDistance) {
            bestDistance = distance;
            best = { curve, point, px, py };
          }
        }
      }
    }

    if (!best || bestDistance > 24 ** 2) {
      hoveredPoint = null;
      chartTooltip.hidden = true;
      drawChart();
      return;
    }

    hoveredPoint = best;
    updateTooltip(mouseX, mouseY, best);
    drawChart();
  }

  function updateOutputs() {
    const selectedLayers = selectedLayerIndices().map(index => index + 1).sort((a, b) => a - b);
    $('model-summary').textContent = state.showAllLayers
      ? `${state.layers.length} layers, all layers`
      : selectedLayers.length === 0
        ? `${state.layers.length} layers, no layer selected`
        : selectedLayers.length === 1
        ? `${state.layers.length} layers, layer ${selectedLayers[0]}`
        : `${state.layers.length} layers, layers ${selectedLayers.join(', ')}`;
  }

  function renderAll(renderEditor = false) {
    renderStack();
    renderInterfaceTabs();
    if (renderEditor) renderLayerEditor();
    syncUnitButtons();
    syncDisplayButtons();
    syncReferenceControls();
    syncRangeInputs();
    hoveredPoint = null;
    chartTooltip.hidden = true;
    drawChart();
  }

  function commitRangeFromInputs() {
    const xMin = Number.parseFloat(($('x-min') as HTMLInputElement).value);
    const xMax = Number.parseFloat(($('x-max') as HTMLInputElement).value);
    const yMin = Number.parseFloat(($('y-min') as HTMLInputElement).value);
    const yMax = Number.parseFloat(($('y-max') as HTMLInputElement).value);
    if (Number.isFinite(xMin) && Number.isFinite(xMax) && xMax > xMin) {
      state.qMin = Math.max(0, xToQ(xMin));
      state.qMax = Math.max(state.qMin + 1e-4, xToQ(xMax));
    }
    if (Number.isFinite(yMin) && Number.isFinite(yMax) && yMax > yMin) {
      if (isWavelengthUnit()) {
        state.uMin = Math.max(0, yToU(yMax));
        state.uMax = Math.max(state.uMin + 1e-4, yToU(yMin));
      } else {
        state.uMin = Math.max(0, yToU(yMin));
        state.uMax = Math.max(state.uMin + 1e-4, yToU(yMax));
      }
    }
    invalidateBranches();
    syncRangeInputs();
    drawChart();
  }

  function currentCsv(): string {
    const [a, b] = activePair();
    const lines = [
      '# Surface Plasmons Heterostructures Lab',
      `# interface=${a.name}/${b.name}, wp_ref_eV=${wpReferenceEv()}, kp_ref_nm^-1=${kpReferenceNm()}`,
      'q,k_nm^-1,k_cm^-1,u,energy_eV,epsilon_a_real,epsilon_b_real',
    ];
    for (const point of currentBranch) {
      lines.push([
        point.q,
        point.kNm,
        point.kNm * 1e7,
        point.u,
        point.energyEv,
        point.epsA,
        point.epsB,
      ].map(value => Number(value).toPrecision(9)).join(','));
    }
    return lines.join('\n') + '\n';
  }

  import { downloadBlob } from '../../../lib/download';

  const presetChipIds = [
    'preset-dmd', 'preset-mdm',
    'preset-fig1', 'preset-fig2', 'preset-fig3', 'preset-fig4',
    'preset-fig5', 'preset-fig6', 'preset-fig7', 'preset-fig8',
  ];
  function markActivePreset(activeId: string) {
    presetChipIds.forEach(id => {
      const chip = document.getElementById(id);
      if (chip) chip.classList.toggle('is-active', id === activeId);
    });
  }
  function bindPreset(id: string, run: () => void) {
    $(id).addEventListener('click', () => {
      markActivePreset(id);
      run();
    });
  }

  $('add-layer').addEventListener('click', () => { markActivePreset(''); addLayer(); });
  $('remove-layer').addEventListener('click', () => { markActivePreset(''); removeLayer(); });
  bindPreset('preset-dmd', () => applyPreset(makeDmdLayers(), true));
  bindPreset('preset-mdm', () => applyPreset(makeMdmLayers(), true));
  bindPreset('preset-fig1', () => applyPreset(makeDefaultLayers(), false));
  bindPreset('preset-fig2', applyFigure2Preset);
  bindPreset('preset-fig3', () => applyPreset(makeMdmLayers(), true));
  bindPreset('preset-fig4', () => applyPreset(makeDmdLayers(), true));
  bindPreset('preset-fig5', () => applyPreset(makeFigure5Layers(), true));
  bindPreset('preset-fig6', () => applyPreset(makeFigure6Layers(), true));
  bindPreset('preset-fig7', () => applyPreset(makeFigure7Layers(), true));
  bindPreset('preset-fig8', () => applyPreset(makeFigure8Layers(), true));
  $('reset-parameters').addEventListener('click', () => { markActivePreset(''); resetParameters(); });

  interfaceTabs.addEventListener('click', event => {
    const allButton = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-layer-all]');
    if (allButton) {
      selectAllLayers();
      renderAll(false);
      return;
    }
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-layer]');
    if (!button) return;
    selectLayer(Number.parseInt(button.dataset.layer ?? '0', 10));
    renderAll(false);
  });

  layerEditor.addEventListener('change', event => {
    const input = event.target as HTMLInputElement;
    if (input?.dataset?.layer) {
      markActivePreset('');
      setLayerValue(input);
    }
  });

  $('x-unit-tabs').addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-x-unit]');
    if (!button) return;
    state.xUnit = button.dataset.xUnit as AxisX;
    renderAll(false);
  });

  $('y-unit-tabs').addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-y-unit]');
    if (!button) return;
    state.yUnit = button.dataset.yUnit as AxisY;
    renderAll(false);
  });

  $('wp-reference-select').addEventListener('change', event => {
    const value = Number.parseInt((event.target as HTMLSelectElement).value, 10);
    if (Number.isInteger(value)) state.wpAxisLayerIndex = value;
    syncRangeInputs();
    drawChart();
  });

  $('y-axis-kind-tabs').addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-y-kind]');
    if (!button) return;
    const nextKind = button.dataset.yKind as AxisYKind;
    if (nextKind !== yAxisKind()) {
      state.yUnit = defaultYUnitForKind(nextKind);
    }
    renderAll(false);
  });

  ['x-min', 'x-max', 'y-min', 'y-max'].forEach(id => {
    $(id).addEventListener('change', commitRangeFromInputs);
    $(id).addEventListener('keydown', event => {
      if ((event as KeyboardEvent).key === 'Enter') {
        event.preventDefault();
        commitRangeFromInputs();
      }
    });
  });

  $('show-light').addEventListener('change', event => {
    state.showLight = (event.target as HTMLInputElement).checked;
    drawChart();
  });
  $('show-tailored').addEventListener('change', event => {
    state.showTailored = (event.target as HTMLInputElement).checked;
    drawChart();
  });
  $('tailored-slope-slider').addEventListener('input', event => {
    const value = Number.parseFloat((event.target as HTMLInputElement).value);
    state.tailoredSlope = Math.max(0, finiteNumber(value, state.tailoredSlope));
    ($('tailored-slope') as HTMLInputElement).value = fmt(state.tailoredSlope, 4);
    drawChart();
  });
  $('tailored-slope').addEventListener('change', event => {
    const value = Number.parseFloat((event.target as HTMLInputElement).value);
    state.tailoredSlope = Math.max(0, finiteNumber(value, state.tailoredSlope));
    (event.target as HTMLInputElement).value = fmt(state.tailoredSlope, 4);
    ($('tailored-slope-slider') as HTMLInputElement).value = fmt(clamp(state.tailoredSlope, 0, 2), 4);
    drawChart();
  });

  chartLegend.addEventListener('change', event => {
    const target = event.target as HTMLInputElement;
    if (target.matches('input[type="checkbox"][data-surface-limit-key]')) {
      const key = target.dataset.surfaceLimitKey ?? '';
      const selected = new Set(state.surfaceLimitKeys);
      if (target.checked) {
        selected.add(key);
      } else {
        selected.delete(key);
      }
      state.surfaceLimitKeys = Array.from(selected);
      state.showSurfaceLimit = state.surfaceLimitKeys.length > 0;
      drawChart();
      return;
    }
    if (target.matches('[data-surface-denominator]')) {
      const key = target.dataset.surfaceLimitKey ?? '';
      const value = Number.parseFloat(target.value);
      if (key && Number.isFinite(value) && value > 0) {
        state.surfaceLimitDenominators[key] = value;
      }
      drawChart();
    }
  });

  $('dl-png').addEventListener('click', () => {
    canvas.toBlob(blob => {
      if (blob) downloadBlob(blob, 'heterostructures_surface_plasmons.png');
    }, 'image/png');
  });

  $('dl-csv').addEventListener('click', () => {
    downloadBlob(new Blob([currentCsv()], { type: 'text/csv' }), 'heterostructures_surface_plasmons.csv');
  });

  canvas.addEventListener('mousemove', handleCanvasHover);
  canvas.addEventListener('mouseleave', () => {
    hoveredPoint = null;
    chartTooltip.hidden = true;
    drawChart();
  });

  new ResizeObserver(() => drawChart()).observe(chartWrap);
  onThemeChange(() => drawChart());

  // Allow the module switcher to force a redraw when this panel is revealed
  // (the canvas may have been sized while hidden / the window resized).
  window.addEventListener('heterostructures:show-surface-plasmons', () => drawChart());

  renderAll(true);
</script>

<script>
  // ===========================================================================
  // Layered structure module -- Transfer Matrix Method (TMM) for stratified media
  //
  // Faithful port of the Computational Photonics (Abbe School of Photonics,
  // FSU Jena, T. Pertsch 2015) MATLAB m-files / Python `tmm.py`:
  //   transfermatrix.m -> transferMatrix()   2x2 stack matrix M
  //   spectrum.m       -> spectrum()         rho, tau vs wavelength
  //   field.m          -> computeField()     complex field F(z) and n(z)
  //
  // Conventions: all lengths in nm; wavevectors in 1/nm; k0 = 2*pi/lambda.
  // exp(-i*omega*t) time convention; epsilon = (n + i*kappa)^2. The generalized
  // field pair (F, G): TE -> alpha = 1; TM -> alpha = 1/epsilon. The layer matrix
  //   m = [[ cos(kz d),            sin(kz d)/(kz alpha) ],
  //        [-kz alpha sin(kz d),   cos(kz d)            ]]
  // and M = m_N ... m_1 (each new layer multiplies on the LEFT).
  // ===========================================================================
  import { chartTheme, onThemeChange } from '../../../lib/chart-theme';

  type Cx = { re: number; im: number };
  const cx = (re: number, im = 0): Cx => ({ re, im });
  const cAdd = (a: Cx, b: Cx): Cx => ({ re: a.re + b.re, im: a.im + b.im });
  const cSub = (a: Cx, b: Cx): Cx => ({ re: a.re - b.re, im: a.im - b.im });
  const cMul = (a: Cx, b: Cx): Cx => ({ re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re });
  const cScale = (a: Cx, s: number): Cx => ({ re: a.re * s, im: a.im * s });
  const cDiv = (a: Cx, b: Cx): Cx => {
    const d = b.re * b.re + b.im * b.im;
    return { re: (a.re * b.re + a.im * b.im) / d, im: (a.im * b.re - a.re * b.im) / d };
  };
  const cAbs = (a: Cx): number => Math.hypot(a.re, a.im);
  const cAbs2 = (a: Cx): number => a.re * a.re + a.im * a.im;
  const cMulI = (z: Cx): Cx => ({ re: -z.im, im: z.re });          //  i * z
  const cMulNegI = (z: Cx): Cx => ({ re: z.im, im: -z.re });       // -i * z
  // principal complex square root
  const cSqrt = (z: Cx): Cx => {
    const r = Math.hypot(z.re, z.im);
    const re = Math.sqrt(Math.max(0, (r + z.re) / 2));
    let im = Math.sqrt(Math.max(0, (r - z.re) / 2));
    if (z.im < 0) im = -im;
    return { re, im };
  };
  const cCos = (z: Cx): Cx => ({ re: Math.cos(z.re) * Math.cosh(z.im), im: -Math.sin(z.re) * Math.sinh(z.im) });
  const cSin = (z: Cx): Cx => ({ re: Math.sin(z.re) * Math.cosh(z.im), im: Math.cos(z.re) * Math.sinh(z.im) });

  type Mat = [Cx, Cx, Cx, Cx];           // [m00, m01, m10, m11]
  const matMul = (a: Mat, b: Mat): Mat => [
    cAdd(cMul(a[0], b[0]), cMul(a[1], b[2])),
    cAdd(cMul(a[0], b[1]), cMul(a[1], b[3])),
    cAdd(cMul(a[2], b[0]), cMul(a[3], b[2])),
    cAdd(cMul(a[2], b[1]), cMul(a[3], b[3])),
  ];
  const matVec = (a: Mat, v: [Cx, Cx]): [Cx, Cx] => [
    cAdd(cMul(a[0], v[0]), cMul(a[1], v[1])),
    cAdd(cMul(a[2], v[0]), cMul(a[3], v[1])),
  ];

  type Pol = 'TE' | 'TM';
  type Mode = 'spectrum' | 'angles' | 'fields' | 'structure';
  type XUnit = 'nm' | 'ev';
  type StructQuantity = 'nk' | 'eps';

  const HC_EV_NM = 1239.8419843320026;   // h*c in eV*nm: E(eV) = HC_EV_NM / lambda(nm)

  type TmmLayer = { n: number; kappa: number; thicknessNm: number; color: string };

  const TMM_MIN_LAYERS = 1;
  const TMM_MAX_LAYERS = 60;
  const palette = ['#38BDF8', '#F59E0B', '#10B981', '#7C3AED', '#EF4444', '#0EA5E9', '#64748B'];
  const R_COLOR = '#6366F1';
  const T_COLOR = '#F97316';
  const FIELD_COLOR = '#0EA5E9';
  const RE_COLOR = '#EF4444';
  const INDEX_COLOR = '#64748B';
  const STRUCT_REAL_COLOR = '#6366F1';
  const STRUCT_IMAG_COLOR = '#F59E0B';

  const layerEps = (layer: { n: number; kappa: number }): Cx => {
    const nc = cx(layer.n, layer.kappa);
    return cMul(nc, nc);
  };

  // ---- core TMM -----------------------------------------------------------
  function transferMatrix(epsArr: Cx[], dArr: number[], pol: Pol, lam: number, kx: number): Mat {
    let M: Mat = [cx(1), cx(0), cx(0), cx(1)];
    const k0 = (2 * Math.PI) / lam;
    for (let i = 0; i < epsArr.length; i++) {
      const eps = epsArr[i];
      const alpha = pol === 'TE' ? cx(1) : cDiv(cx(1), eps);
      // kz = sqrt(k0^2 eps - kx^2)
      const kz = cSqrt(cSub(cScale(eps, k0 * k0), cx(kx * kx)));
      const kzd = cScale(kz, dArr[i]);
      const cosv = cCos(kzd);
      const sinv = cSin(kzd);
      const kza = cMul(kz, alpha);
      const m: Mat = [cosv, cDiv(sinv, kza), cScale(cMul(kza, sinv), -1), cosv];
      M = matMul(m, M);
    }
    return M;
  }

  type RT = { rho: number; tau: number; absR: number; absT: number };

  // Single-point reflection / transmission at one wavelength and angle.
  function rtAt(
    epsArr: Cx[], dArr: number[], pol: Pol, lam: number,
    angleDeg: number, nSub: number, nClad: number,
  ): RT {
    const epsS = nSub * nSub;
    const epsC = nClad * nClad;
    const alphaS = pol === 'TE' ? 1 : 1 / epsS;
    const alphaC = pol === 'TE' ? 1 : 1 / epsC;
    const EPS = Number.EPSILON;
    const k0 = (2 * Math.PI) / lam;
    // angle of incidence is measured inside the incidence (substrate) medium:
    // kx = n_sub k0 sinθ  (θ = θ_sub, not a vacuum-referenced angle)
    const kx = nSub * k0 * Math.sin((Math.PI * angleDeg) / 180);
    const M = transferMatrix(epsArr, dArr, pol, lam, kx);
    const kzS = cSqrt(cx(epsS * k0 * k0 - kx * kx));
    const kzC = cSqrt(cx(epsC * k0 * k0 - kx * kx));
    const aS = cScale(kzS, alphaS);
    const aC = cScale(kzC, alphaC);
    const aSaC = cMul(aS, aC);
    // N = aS*M22 + aC*M11 + i*(M21 - aS*aC*M12)
    const N = cAdd(
      cAdd(cMul(aS, M[3]), cMul(aC, M[0])),
      cMulI(cSub(M[2], cMul(aSaC, M[1]))),
    );
    // R = (aS*M22 - aC*M11 - i*(M21 + aS*aC*M12)) / N
    const R = cDiv(
      cSub(
        cSub(cMul(aS, M[3]), cMul(aC, M[0])),
        cMulI(cAdd(M[2], cMul(aSaC, M[1]))),
      ),
      N,
    );
    // T = 2*alphaS*kzS / N = 2*aS / N
    const T = cDiv(cScale(aS, 2), N);
    const rho = cAbs2(R);
    const tau = (alphaC / alphaS) * (kzC.re / (kzS.re + EPS)) * cAbs2(T);
    return { rho, tau, absR: cAbs(R), absT: cAbs(T) };
  }

  type SpectrumPoint = RT & { lam: number };
  function spectrum(
    epsArr: Cx[], dArr: number[], pol: Pol, lambdas: number[],
    angleDeg: number, nSub: number, nClad: number,
  ): SpectrumPoint[] {
    return lambdas.map(lam => ({ lam, ...rtAt(epsArr, dArr, pol, lam, angleDeg, nSub, nClad) }));
  }

  type AnglePoint = RT & { angleDeg: number };
  function angleScan(
    epsArr: Cx[], dArr: number[], pol: Pol, lam: number,
    angles: number[], nSub: number, nClad: number,
  ): AnglePoint[] {
    return angles.map(a => ({ angleDeg: a, ...rtAt(epsArr, dArr, pol, lam, a, nSub, nClad) }));
  }

  type FieldResult = { z: number[]; absF: number[]; reF: number[]; imF: number[]; index: number[]; total: number };

  function computeField(
    epsArr: Cx[], dArr: number[], pol: Pol, lam: number, angleDeg: number,
    nSub: number, nClad: number, Nz: number, lS: number, lC: number,
  ): FieldResult {
    const epsS = cx(nSub * nSub);
    const epsC = cx(nClad * nClad);
    // extend with substrate (front) and cladding (back) slabs
    let eps = [epsS, ...epsArr, epsC];
    let thick = [lS, ...dArr, lC];

    const alphaC = pol === 'TE' ? cx(1) : cDiv(cx(1), epsC);
    const k0 = (2 * Math.PI) / lam;
    // angle of incidence measured inside the incidence (substrate) medium: kx = n_sub k0 sinθ
    const kx = nSub * k0 * Math.sin((Math.PI * angleDeg) / 180);
    const kzC = cSqrt(cSub(cScale(epsC, k0 * k0), cx(kx * kx)));
    // known transmitted vector (unit transmitted amplitude): [1, -i alphaC kzC]
    const incident: [Cx, Cx] = [cx(1), cMulNegI(cMul(alphaC, kzC))];

    // reverse: propagate from cladding back toward substrate
    eps = eps.slice().reverse();
    thick = thick.slice().reverse();

    const total = thick.reduce((s, t) => s + t, 0);
    const dz = total / (Nz - 1);
    const position: number[] = [];
    let acc = 0;
    for (const t of thick) { acc += t; position.push(acc); }

    const fAbs = new Array<number>(Nz);
    const fRe = new Array<number>(Nz);
    const fIm = new Array<number>(Nz);
    const index = new Array<number>(Nz);
    let counter = 0;
    for (let n = 0; n < Nz; n++) {
      const zn = n * dz;
      while (counter < thick.length - 1 && zn > position[counter]) counter++;
      const d = counter > 0
        ? [...thick.slice(0, counter), zn - position[counter - 1]]
        : [zn];
      const epsSlice = eps.slice(0, counter + 1);
      const M = transferMatrix(epsSlice, d, pol, lam, kx);
      const vec = matVec(M, incident);
      fAbs[n] = cAbs(vec[0]);
      fRe[n] = vec[0].re;
      fIm[n] = vec[0].im;
      const nLocal = cSqrt(eps[counter]);
      index[n] = nLocal.re;
    }

    // flip back to physical orientation (substrate at z = 0)
    fAbs.reverse(); fRe.reverse(); fIm.reverse(); index.reverse();
    const z = Array.from({ length: Nz }, (_, i) => i * dz);
    return { z, absF: fAbs, reF: fRe, imF: fIm, index, total };
  }

  // ---- state --------------------------------------------------------------
  function makeBraggLayers(): TmmLayer[] {
    // Quarter-wave Bragg mirror at lambda0 = 600 nm: n1 d1 = n2 d2 = lambda0/4.
    const layers: TmmLayer[] = [];
    for (let i = 0; i < 15; i++) {
      layers.push({ n: 1.5, kappa: 0, thicknessNm: 100, color: palette[0] });
      layers.push({ n: 2.0, kappa: 0, thicknessNm: 75, color: palette[1] });
    }
    return layers;
  }

  function makeFabryPerotLayers(): TmmLayer[] {
    const layers = makeBraggLayers();
    layers[14] = { ...layers[14], thicknessNm: layers[14].thicknessNm * 2, color: palette[3] }; // half-wave defect
    return layers;
  }

  function makeArLayers(): TmmLayer[] {
    // Single quarter-wave MgF2 antireflection film (n=1.38) at 550 nm on glass.
    return [{ n: 1.38, kappa: 0, thicknessNm: 550 / (4 * 1.38), color: palette[2] }];
  }

  type Preset = 'bragg' | 'fp' | 'ar' | 'custom';

  const tmm = {
    layers: makeBraggLayers(),
    nSub: 1.0,
    nClad: 1.5,
    pol: 'TE' as Pol,
    angleDeg: 0,
    mode: 'spectrum' as Mode,
    xUnit: 'nm' as XUnit,
    lamMin: 400,
    lamMax: 800,
    fieldLam: 600,
    marginSub: 300,
    marginClad: 300,
    showR: true,
    showT: true,
    logScale: false,
    showAbs: true,
    showRe: false,
    showIndex: true,
    structQuantity: 'nk' as StructQuantity,
    preset: 'bragg' as Preset,
  };

  const $t = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  const tStackPreview = $t('tmm-stack-preview');
  const tLayerEditor = $t('tmm-layer-editor');
  const tChartWrap = $t('tmm-chart-wrap');
  const tChartLegend = $t('tmm-chart-legend');
  const tTooltip = $t('tmm-chart-tooltip');
  const tCanvas = $t('tmm-chart') as HTMLCanvasElement;

  function clamp(v: number, lo: number, hi: number): number { return Math.min(hi, Math.max(lo, v)); }
  function finiteOr(v: number, fb: number): number { return Number.isFinite(v) ? v : fb; }
  function tfmt(v: number, digits = 4): string {
    if (!Number.isFinite(v)) return '--';
    const a = Math.abs(v);
    if (a > 0 && (a < 1e-3 || a >= 1e5)) return v.toExponential(2);
    return Number.parseFloat(v.toPrecision(digits)).toString();
  }

  function isMetalLike(layer: TmmLayer): boolean { return layer.kappa > 0.05; }
  function layerLabel(layer: TmmLayer): string { return `n=${tfmt(layer.n, 3)}`; }

  // Colour layers by "group": identical (thickness, n, κ) → same colour; any
  // difference → a new colour. Assigned in first-appearance order so the palette
  // stays stable. Called before every stack/editor render (idempotent).
  const tmmGroupKey = (l: TmmLayer): string => `${l.thicknessNm}|${l.n}|${l.kappa}`;
  function assignTmmGroupColors() {
    const colorForKey = new Map<string, string>();
    let next = 0;
    for (const layer of tmm.layers) {
      const key = tmmGroupKey(layer);
      let col = colorForKey.get(key);
      if (col === undefined) { col = palette[next % palette.length]; next++; colorForKey.set(key, col); }
      layer.color = col;
    }
  }
  // Lightweight swatch refresh for the layer editor (avoids a full re-render that
  // would steal focus while the user is editing fields).
  function refreshTmmSwatches() {
    const swatches = tLayerEditor.querySelectorAll<HTMLElement>('.layer-swatch');
    tmm.layers.forEach((l, i) => { if (swatches[i]) swatches[i].style.background = l.color; });
  }

  // ---- rendering ----------------------------------------------------------
  function renderTmmStack() {
    assignTmmGroupColors();
    const total = tmm.layers.reduce((s, l) => s + Math.max(1e-6, l.thicknessNm), 0) || 1;
    const inner = tmm.layers.map(layer => {
      const pct = (Math.max(1e-6, layer.thicknessNm) / total) * 100;
      const safe = `${layer.n}+${layer.kappa}i, ${tfmt(layer.thicknessNm, 4)} nm`;
      const label = pct > 7 ? `${tfmt(layer.thicknessNm, 3)}` : '';
      return `<div class="tmm-stack__layer" style="flex:${pct} 1 0;background:${layer.color}" title="${safe}">${label}</div>`;
    }).join('');
    tStackPreview.innerHTML =
      `<div class="tmm-stack__end" title="Substrate (incidence)">n<sub>s</sub><br>${tfmt(tmm.nSub, 3)}</div>` +
      inner +
      `<div class="tmm-stack__end" title="Cladding (exit)">n<sub>c</sub><br>${tfmt(tmm.nClad, 3)}</div>`;

    $t('tmm-layer-count').textContent = `${tmm.layers.length}`;
    ($t('tmm-remove-layer') as HTMLButtonElement).disabled = tmm.layers.length <= TMM_MIN_LAYERS;
    ($t('tmm-add-layer') as HTMLButtonElement).disabled = tmm.layers.length >= TMM_MAX_LAYERS;
  }

  function renderTmmLayerEditor() {
    assignTmmGroupColors();
    const removable = tmm.layers.length > TMM_MIN_LAYERS;
    const canAdd = tmm.layers.length < TMM_MAX_LAYERS;
    const last = tmm.layers.length - 1;
    tLayerEditor.innerHTML = tmm.layers.map((layer, index) => `
      <div class="layer-row" data-tmm-row="${index}">
        <div class="layer-row__header">
          <span class="layer-chip"><button type="button" class="layer-swatch layer-swatch--btn${isTmmGroupSelected(index) ? ' layer-swatch--sel' : ''}" data-tmm-swatch="${index}" style="background:${layer.color}" title="Click to lock this group — edits then apply to all its layers" aria-label="Select layer group" aria-pressed="${isTmmGroupSelected(index)}"></button>Layer ${index + 1}</span>
          <span class="layer-row__actions">
            <button type="button" class="tmm-layer-btn" data-tmm-dup="${index}" title="Add a copy of this layer below" aria-label="Duplicate layer ${index + 1}"${canAdd ? '' : ' disabled'}>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            </button>
            <button type="button" class="tmm-layer-btn" data-tmm-up="${index}" title="Move layer up" aria-label="Move layer ${index + 1} up"${index === 0 ? ' disabled' : ''}>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
            </button>
            <button type="button" class="tmm-layer-btn" data-tmm-down="${index}" title="Move layer down" aria-label="Move layer ${index + 1} down"${index === last ? ' disabled' : ''}>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
            </button>
            <button type="button" class="tmm-layer-btn tmm-layer-remove" data-tmm-remove="${index}" title="Remove layer" aria-label="Remove layer ${index + 1}"${removable ? '' : ' disabled'}>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
          </span>
        </div>
        <div class="tmm-layer-fields">
          <label class="layer-field">
            <span>Thickness (nm)</span>
            <input type="number" class="layer-input" data-tmm-layer="${index}" data-key="thicknessNm" value="${tfmt(layer.thicknessNm, 6)}" step="5" min="0">
          </label>
          <label class="layer-field">
            <span>n</span>
            <input type="number" class="layer-input" data-tmm-layer="${index}" data-key="n" value="${tfmt(layer.n, 6)}" step="0.05" min="0.05">
          </label>
          <label class="layer-field">
            <span>&kappa;</span>
            <input type="number" class="layer-input" data-tmm-layer="${index}" data-key="kappa" value="${tfmt(layer.kappa, 6)}" step="0.01" min="0">
          </label>
        </div>
      </div>
    `).join('');
  }

  function syncTmmControls() {
    ($t('tmm-n-sub') as HTMLInputElement).value = tfmt(tmm.nSub, 6);
    ($t('tmm-n-clad') as HTMLInputElement).value = tfmt(tmm.nClad, 6);
    ($t('tmm-angle') as HTMLInputElement).value = tfmt(tmm.angleDeg, 4);
    ($t('tmm-angle-slider') as HTMLInputElement).value = `${clamp(tmm.angleDeg, 0, 90)}`;
    const lamMinInput = $t('tmm-lam-min') as HTMLInputElement;
    const lamMaxInput = $t('tmm-lam-max') as HTMLInputElement;
    if (tmm.xUnit === 'ev') {
      // min/max of the axis quantity: min energy <-> max wavelength, and vice versa
      lamMinInput.value = tfmt(HC_EV_NM / tmm.lamMax, 6);
      lamMaxInput.value = tfmt(HC_EV_NM / tmm.lamMin, 6);
      lamMinInput.step = '0.05'; lamMaxInput.step = '0.05'; lamMinInput.min = '0.05'; lamMaxInput.min = '0.05';
      $t('tmm-range-label').textContent = 'Photon energy (eV)';
    } else {
      lamMinInput.value = tfmt(tmm.lamMin, 6);
      lamMaxInput.value = tfmt(tmm.lamMax, 6);
      lamMinInput.step = '10'; lamMaxInput.step = '10'; lamMinInput.min = '10'; lamMaxInput.min = '10';
      $t('tmm-range-label').textContent = 'Wavelength (nm)';
    }
    ($t('tmm-field-lam') as HTMLInputElement).value = tfmt(tmm.fieldLam, 6);
    ($t('tmm-lam-slider') as HTMLInputElement).value = `${clamp(tmm.fieldLam, 200, 1200)}`;
    ($t('tmm-margin-sub') as HTMLInputElement).value = tfmt(tmm.marginSub, 6);
    ($t('tmm-margin-clad') as HTMLInputElement).value = tfmt(tmm.marginClad, 6);
    ($t('tmm-show-r') as HTMLInputElement).checked = tmm.showR;
    ($t('tmm-show-t') as HTMLInputElement).checked = tmm.showT;
    ($t('tmm-log') as HTMLInputElement).checked = tmm.logScale;
    ($t('tmm-show-abs') as HTMLInputElement).checked = tmm.showAbs;
    ($t('tmm-show-re') as HTMLInputElement).checked = tmm.showRe;
    ($t('tmm-show-index') as HTMLInputElement).checked = tmm.showIndex;

    document.querySelectorAll<HTMLButtonElement>('#tmm-pol-tabs [data-pol]').forEach(btn => {
      const active = btn.dataset.pol === tmm.pol;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
    });
    document.querySelectorAll<HTMLButtonElement>('#tmm-mode-tabs [data-mode]').forEach(btn => {
      const active = btn.dataset.mode === tmm.mode;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
    });
    document.querySelectorAll<HTMLButtonElement>('#tmm-xunit-tabs [data-xunit]').forEach(btn => {
      const active = btn.dataset.xunit === tmm.xUnit;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
    });
    document.querySelectorAll<HTMLButtonElement>('#tmm-quantity-tabs [data-quantity]').forEach(btn => {
      const active = btn.dataset.quantity === tmm.structQuantity;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
    });

    const isSpectrum = tmm.mode === 'spectrum';
    const isAngles = tmm.mode === 'angles';
    const isFields = tmm.mode === 'fields';
    const isStructure = tmm.mode === 'structure';

    // sidebar controls: wavelength range (spectrum) vs single wavelength (angles/fields);
    // sampling margin sets how much substrate/cladding to draw (fields + structure)
    $t('tmm-spectrum-controls').hidden = !isSpectrum;
    $t('tmm-wavelength-control').hidden = !(isAngles || isFields);
    $t('tmm-field-margins').hidden = !(isFields || isStructure);

    // in Angles mode the angle is the scan variable -> lock its inputs
    ($t('tmm-angle') as HTMLInputElement).disabled = isAngles;
    ($t('tmm-angle-slider') as HTMLInputElement).disabled = isAngles;
    $t('tmm-angle-control').classList.toggle('is-disabled', isAngles);
    $t('tmm-angle-label').innerHTML = isAngles
      ? 'Angle of incidence (&deg;) &mdash; scanned 0&ndash;90'
      : 'Angle of incidence (&deg;)';

    // chart option rows: R/T/log shared by spectrum + angles (eV toggle lives in the sidebar Stack panel)
    $t('tmm-spectrum-options').hidden = !(isSpectrum || isAngles);
    $t('tmm-field-options').hidden = !isFields;
    $t('tmm-structure-options').hidden = !isStructure;
  }

  function markActiveTmmPreset() {
    const map: Record<Preset, string> = { bragg: 'tmm-preset-bragg', fp: 'tmm-preset-fp', ar: 'tmm-preset-ar', custom: '' };
    ['tmm-preset-bragg', 'tmm-preset-fp', 'tmm-preset-ar'].forEach(id => {
      $t(id).classList.toggle('is-active', id === map[tmm.preset]);
    });
  }

  // ---- ticks / axes -------------------------------------------------------
  function niceTicks(min: number, max: number, count = 6): number[] {
    if (!Number.isFinite(min) || !Number.isFinite(max) || max <= min) return [];
    const span = max - min;
    const raw = span / Math.max(1, count);
    const power = Math.pow(10, Math.floor(Math.log10(raw)));
    const scaled = raw / power;
    const step = (scaled <= 1 ? 1 : scaled <= 2 ? 2 : scaled <= 5 ? 5 : 10) * power;
    const start = Math.ceil(min / step) * step;
    const ticks: number[] = [];
    // keep ticks inside [min, max] (a small float-epsilon tolerance, not a quarter
    // step) so a tick is never drawn beyond the plot frame on non-round ranges
    for (let v = start; v <= max + step * 1e-3; v += step) {
      if (v >= min - step * 1e-3) ticks.push(Math.abs(v) < step * 1e-9 ? 0 : v);
    }
    return ticks.slice(0, 12);
  }

  const LOG_FLOOR = 1e-12;

  type DrawnCurve = { label: string; color: string; dash?: number[]; pts: Array<{ dx: number; dy: number }> };
  let tLastPlot: { left: number; top: number; width: number; height: number; xMin: number; xMax: number; yMin: number; yMax: number; log: boolean } | null = null;
  let tDrawnCurves: DrawnCurve[] = [];
  let tHover: { color: string; label: string; px: number; py: number; dx: number; dy: number; xUnit: string; yUnit: string } | null = null;
  let tCsvRows: string[][] = [];
  let tCsvHeader: string[] = [];

  function setupCanvas(theme: ReturnType<typeof chartTheme>) {
    const rect = tChartWrap.getBoundingClientRect();
    const width = Math.max(320, rect.width || 760);
    const height = Math.max(320, tCanvas.clientHeight || 430);
    const dpr = window.devicePixelRatio || 1;
    tCanvas.width = width * dpr;
    tCanvas.height = height * dpr;
    tCanvas.style.height = `${height}px`;
    const ctx = tCanvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, width, height);
    ctx.fillStyle = theme.bg;
    ctx.fillRect(0, 0, width, height);
    return { ctx, width, height };
  }

  function drawAxes(
    ctx: CanvasRenderingContext2D, theme: ReturnType<typeof chartTheme>,
    plot: NonNullable<typeof tLastPlot>, xLabel: string, yLabel: string,
    width: number, height: number,
  ) {
    const xToPx = (x: number) => plot.left + (x - plot.xMin) / (plot.xMax - plot.xMin) * plot.width;
    const yToPx = (y: number) => plot.top + plot.height - (y - plot.yMin) / (plot.yMax - plot.yMin) * plot.height;

    ctx.fillStyle = theme.bg;
    ctx.fillRect(plot.left, plot.top, plot.width, plot.height);

    const xTicks = niceTicks(plot.xMin, plot.xMax, 6);
    ctx.strokeStyle = theme.grid;
    ctx.lineWidth = 1;
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillStyle = theme.textSoft;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (const tick of xTicks) {
      const x = xToPx(tick);
      ctx.beginPath();
      ctx.moveTo(x, plot.top);
      ctx.lineTo(x, plot.top + plot.height);
      ctx.stroke();
      ctx.fillText(tfmt(tick, 4), x, plot.top + plot.height + 8);
    }

    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    if (plot.log) {
      for (let e = Math.ceil(Math.log10(plot.yMin)); e <= Math.log10(plot.yMax) + 1e-9; e++) {
        const y = yToPx(e);
        ctx.beginPath();
        ctx.moveTo(plot.left, y);
        ctx.lineTo(plot.left + plot.width, y);
        ctx.stroke();
        ctx.fillText(`10^${e}`, plot.left - 10, y);
      }
    } else {
      const yTicks = niceTicks(plot.yMin, plot.yMax, 6);
      for (const tick of yTicks) {
        const y = yToPx(tick);
        ctx.beginPath();
        ctx.moveTo(plot.left, y);
        ctx.lineTo(plot.left + plot.width, y);
        ctx.stroke();
        ctx.fillText(tfmt(tick, 4), plot.left - 10, y);
      }
    }

    ctx.strokeStyle = theme.text;
    ctx.lineWidth = 1.2;
    ctx.strokeRect(plot.left, plot.top, plot.width, plot.height);

    ctx.fillStyle = theme.text;
    ctx.font = '700 12px Inter, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    ctx.fillText(xLabel, plot.left + plot.width / 2, height - 10);
    ctx.save();
    ctx.translate(18, plot.top + plot.height / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textBaseline = 'top';
    ctx.fillText(yLabel, 0, 0);
    ctx.restore();
  }

  function strokeCurve(
    ctx: CanvasRenderingContext2D, plot: NonNullable<typeof tLastPlot>,
    curve: DrawnCurve,
  ) {
    const xToPx = (x: number) => plot.left + (x - plot.xMin) / (plot.xMax - plot.xMin) * plot.width;
    const yToPxLin = (y: number) => plot.top + plot.height - (y - plot.yMin) / (plot.yMax - plot.yMin) * plot.height;
    const yToPx = (y: number) => plot.log
      ? plot.top + plot.height - (Math.log10(Math.max(LOG_FLOOR, y)) - plot.yMin) / (plot.yMax - plot.yMin) * plot.height
      : yToPxLin(y);
    ctx.save();
    ctx.beginPath();
    ctx.rect(plot.left, plot.top, plot.width, plot.height);
    ctx.clip();
    ctx.strokeStyle = curve.color;
    ctx.lineWidth = 2.4;
    ctx.setLineDash(curve.dash ?? []);
    ctx.beginPath();
    let started = false;
    for (const p of curve.pts) {
      if (!Number.isFinite(p.dx) || !Number.isFinite(p.dy)) { started = false; continue; }
      const px = xToPx(p.dx);
      const py = yToPx(p.dy);
      if (!started) { ctx.moveTo(px, py); started = true; } else { ctx.lineTo(px, py); }
    }
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.restore();
  }

  function renderLegend(entries: Array<{ label: string; color: string; dash?: number[] }>) {
    tChartLegend.innerHTML = entries.map(e => {
      const lineClass = e.dash ? 'legend-line legend-line--dash' : 'legend-line';
      return `<span class="legend-item" style="color:${e.color}"><span class="${lineClass}"></span>${e.label.replace(/[<>&"]/g, '')}</span>`;
    }).join('');
  }

  // ---- main draw ----------------------------------------------------------
  function buildEpsArrays(): { eps: Cx[]; d: number[] } {
    return { eps: tmm.layers.map(layerEps), d: tmm.layers.map(l => Math.max(0, l.thicknessNm)) };
  }

  function drawTmm() {
    syncTmmControls();
    renderTmmStack();
    if (tmm.mode === 'spectrum') drawSpectrum();
    else if (tmm.mode === 'angles') drawAngles();
    else if (tmm.mode === 'fields') drawFieldView();
    else drawStructure();
  }

  // Refractive-index / permittivity profile of the stack, drawn to scale vs z.
  // Left axis = real part (n or Re ε), right axis = imaginary part (κ or Im ε).
  function drawStructure() {
    const theme = chartTheme();
    const { ctx, width, height } = setupCanvas(theme);
    const mSub = Math.max(0, tmm.marginSub);
    const mClad = Math.max(0, tmm.marginClad);

    type Region = { z0: number; z1: number; n: number; k: number; color: string | null };
    const regions: Region[] = [];
    let z = 0;
    regions.push({ z0: 0, z1: mSub, n: tmm.nSub, k: 0, color: null });
    z = mSub;
    for (const L of tmm.layers) {
      const t = Math.max(1e-6, L.thicknessNm);
      regions.push({ z0: z, z1: z + t, n: L.n, k: L.kappa, color: L.color });
      z += t;
    }
    regions.push({ z0: z, z1: z + mClad, n: tmm.nClad, k: 0, color: null });
    z += mClad;
    const total = z || 1;

    const useEps = tmm.structQuantity === 'eps';
    const realOf = (n: number, k: number) => useEps ? n * n - k * k : n;
    const imagOf = (n: number, k: number) => useEps ? 2 * n * k : k;

    const reals = regions.map(r => realOf(r.n, r.k));
    const imags = regions.map(r => imagOf(r.n, r.k));
    let lMin = Math.min(...reals);
    let lMax = Math.max(...reals);
    if (lMin >= 0) lMin = 0;
    if (lMax - lMin < 1e-6) lMax = lMin + 1;
    const lpad = (lMax - lMin) * 0.12;
    lMax += lpad;
    if (lMin < 0) lMin -= lpad;
    const rMin = 0;
    let rMax = Math.max(...imags, 0);
    rMax = rMax < 1e-9 ? 1 : rMax * 1.15;

    const margin = { top: 26, right: 66, bottom: 58, left: 66 };
    const plot = {
      left: margin.left, top: margin.top,
      width: width - margin.left - margin.right,
      height: height - margin.top - margin.bottom,
      xMin: 0, xMax: total, yMin: lMin, yMax: lMax, log: false,
    };
    tLastPlot = plot;

    const xToPx = (x: number) => plot.left + (x - plot.xMin) / (plot.xMax - plot.xMin) * plot.width;
    const lYToPx = (v: number) => plot.top + plot.height - (v - lMin) / (lMax - lMin) * plot.height;
    const rYToPx = (v: number) => plot.top + plot.height - (v - rMin) / (rMax - rMin) * plot.height;

    ctx.fillStyle = theme.bg;
    ctx.fillRect(plot.left, plot.top, plot.width, plot.height);

    // layer region shading (shows the stack to scale)
    for (const r of regions) {
      if (!r.color) continue;
      ctx.fillStyle = r.color;
      ctx.globalAlpha = 0.12;
      ctx.fillRect(xToPx(r.z0), plot.top, Math.max(0.5, xToPx(r.z1) - xToPx(r.z0)), plot.height);
      ctx.globalAlpha = 1;
    }

    // x grid + ticks
    ctx.font = '11px Inter, system-ui, sans-serif';
    ctx.fillStyle = theme.textSoft;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (const t of niceTicks(0, total, 6)) {
      const x = xToPx(t);
      ctx.strokeStyle = theme.grid; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x, plot.top); ctx.lineTo(x, plot.top + plot.height); ctx.stroke();
      ctx.fillText(tfmt(t, 4), x, plot.top + plot.height + 8);
    }

    // left axis (gridlines + labels) in the real-part colour
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    for (const t of niceTicks(lMin, lMax, 6)) {
      const y = lYToPx(t);
      ctx.strokeStyle = theme.grid; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(plot.left, y); ctx.lineTo(plot.left + plot.width, y); ctx.stroke();
      ctx.fillStyle = STRUCT_REAL_COLOR;
      ctx.fillText(tfmt(t, 4), plot.left - 10, y);
    }

    // right axis (labels only) in the imaginary-part colour
    ctx.textAlign = 'left';
    ctx.fillStyle = STRUCT_IMAG_COLOR;
    for (const t of niceTicks(rMin, rMax, 6)) {
      ctx.fillText(tfmt(t, 4), plot.left + plot.width + 10, rYToPx(t));
    }

    ctx.strokeStyle = theme.text;
    ctx.lineWidth = 1.2;
    ctx.strokeRect(plot.left, plot.top, plot.width, plot.height);

    // axis titles
    ctx.font = '700 12px Inter, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    ctx.fillStyle = theme.text;
    ctx.fillText('Position z (nm)', plot.left + plot.width / 2, height - 10);
    ctx.save();
    ctx.translate(16, plot.top + plot.height / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textBaseline = 'top';
    ctx.fillStyle = STRUCT_REAL_COLOR;
    ctx.fillText(useEps ? 'Re(ε)' : 'Refractive index n', 0, 0);
    ctx.restore();
    ctx.save();
    ctx.translate(width - 14, plot.top + plot.height / 2);
    ctx.rotate(Math.PI / 2);
    ctx.textBaseline = 'top';
    ctx.fillStyle = STRUCT_IMAG_COLOR;
    ctx.fillText(useEps ? 'Im(ε)' : 'Extinction κ', 0, 0);
    ctx.restore();

    // step curves
    const drawStep = (mapY: (v: number) => number, valueOf: (r: Region) => number, color: string, dash: number[]) => {
      ctx.save();
      ctx.beginPath();
      ctx.rect(plot.left, plot.top, plot.width, plot.height);
      ctx.clip();
      ctx.strokeStyle = color;
      ctx.lineWidth = 2.4;
      ctx.setLineDash(dash);
      ctx.beginPath();
      let started = false;
      for (const r of regions) {
        const y = mapY(valueOf(r));
        const x0 = xToPx(r.z0);
        const x1 = xToPx(r.z1);
        if (!started) { ctx.moveTo(x0, y); started = true; } else { ctx.lineTo(x0, y); }
        ctx.lineTo(x1, y);
      }
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.restore();
    };
    drawStep(lYToPx, r => realOf(r.n, r.k), STRUCT_REAL_COLOR, []);
    drawStep(rYToPx, r => imagOf(r.n, r.k), STRUCT_IMAG_COLOR, [6, 4]);

    renderLegend([
      { label: useEps ? 'Re(ε) — left axis' : 'n (real index) — left axis', color: STRUCT_REAL_COLOR },
      { label: useEps ? 'Im(ε) — right axis' : 'κ (extinction) — right axis', color: STRUCT_IMAG_COLOR, dash: [6, 4] },
    ]);

    tDrawnCurves = [];   // dual-axis plot: hover disabled

    $t('tmm-model-summary').textContent = `${tmm.layers.length} layers · index profile`;
    $t('tmm-note-text').innerHTML =
      `Refractive-index profile of the stack drawn to scale versus position z. `
      + `The left axis is the ${useEps ? 'real part of the permittivity Re(&epsilon;)' : 'refractive index n'} `
      + `and the right axis the ${useEps ? 'imaginary part Im(&epsilon;)' : 'extinction coefficient &kappa;'}, with `
      + `&epsilon; = (n + i&kappa;)<sup>2</sup>. Shaded bands mark the finite layers; the flanking regions are the `
      + `semi-infinite substrate (n<sub>s</sub> = ${tfmt(tmm.nSub, 3)}) and cladding (n<sub>c</sub> = ${tfmt(tmm.nClad, 3)}).`;

    tCsvHeader = ['z_nm', 'n', 'kappa', 'eps_real', 'eps_imag'];
    tCsvRows = [];
    for (const r of regions) {
      const er = r.n * r.n - r.k * r.k;
      const ei = 2 * r.n * r.k;
      tCsvRows.push([r.z0, r.n, r.k, er, ei].map(v => Number(v).toPrecision(9)));
      tCsvRows.push([r.z1, r.n, r.k, er, ei].map(v => Number(v).toPrecision(9)));
    }
  }

  function drawSpectrum() {
    const theme = chartTheme();
    const { ctx, width, height } = setupCanvas(theme);
    const { eps, d } = buildEpsArrays();
    const lamMin = Math.min(tmm.lamMin, tmm.lamMax);
    const lamMax = Math.max(tmm.lamMin, tmm.lamMax);
    const samples = 600;
    const lambdas = Array.from({ length: samples }, (_, i) => lamMin + (lamMax - lamMin) * i / (samples - 1));
    const data = spectrum(eps, d, tmm.pol, lambdas, tmm.angleDeg, tmm.nSub, tmm.nClad);

    const useEv = tmm.xUnit === 'ev';
    const toX = (lam: number) => useEv ? HC_EV_NM / lam : lam;          // photon energy in eV, or wavelength in nm
    const xLo = Math.min(toX(lamMin), toX(lamMax));
    const xHi = Math.max(toX(lamMin), toX(lamMax));

    const margin = { top: 26, right: 28, bottom: 58, left: 72 };
    const log = tmm.logScale;
    const plot = {
      left: margin.left, top: margin.top,
      width: width - margin.left - margin.right,
      height: height - margin.top - margin.bottom,
      xMin: xLo, xMax: xHi,
      yMin: log ? Math.log10(LOG_FLOOR) : 0,
      yMax: log ? 0 : 1.02,
      log,
    };
    tLastPlot = plot;
    const xLabel = useEv ? 'Photon energy E (eV)' : 'Wavelength λ (nm)';
    drawAxes(ctx, theme, plot, xLabel, log ? 'Reflectance / transmittance (log)' : 'Reflectance / transmittance', width, height);

    tDrawnCurves = [];
    const legend: Array<{ label: string; color: string; dash?: number[] }> = [];
    if (tmm.showR) {
      const curve: DrawnCurve = { label: 'Reflectance ρ', color: R_COLOR, pts: data.map(p => ({ dx: toX(p.lam), dy: p.rho })) };
      tDrawnCurves.push(curve); strokeCurve(ctx, plot, curve);
      legend.push({ label: 'Reflectance ρ = |R|²', color: R_COLOR });
    }
    if (tmm.showT) {
      const curve: DrawnCurve = { label: 'Transmittance τ', color: T_COLOR, dash: [7, 5], pts: data.map(p => ({ dx: toX(p.lam), dy: p.tau })) };
      tDrawnCurves.push(curve); strokeCurve(ctx, plot, curve);
      legend.push({ label: 'Transmittance τ', color: T_COLOR, dash: [7, 5] });
    }
    renderLegend(legend);

    const maxDev = data.reduce((m, p) => Math.max(m, Math.abs(p.tau + p.rho - 1)), 0);
    const minTau = data.reduce((m, p) => Math.min(m, p.tau), Infinity);
    $t('tmm-model-summary').textContent = `${tmm.layers.length} layers · ${tmm.pol} · ${tfmt(tmm.angleDeg, 3)}°`;
    $t('tmm-note-text').innerHTML =
      `Reflectance &rho; and transmittance &tau; versus ${useEv ? 'photon energy' : 'wavelength'} for the ${tmm.layers.length}-layer stack `
      + `between n<sub>s</sub> = ${tfmt(tmm.nSub, 3)} and n<sub>c</sub> = ${tfmt(tmm.nClad, 3)} at ${tfmt(tmm.angleDeg, 3)}&deg; (${tmm.pol}). `
      + `Energy conservation: max|&tau; + &rho; &minus; 1| = ${maxDev.toExponential(2)}. `
      + `Minimum transmittance in range: &tau;<sub>min</sub> = ${minTau.toExponential(2)}.`;

    tCsvHeader = ['lambda_nm', 'energy_eV', 'reflectance_rho', 'transmittance_tau', 'abs_R', 'abs_T'];
    tCsvRows = data.map(p => [p.lam, HC_EV_NM / p.lam, p.rho, p.tau, p.absR, p.absT].map(v => Number(v).toPrecision(9)));

    if (tHover) drawHoverOverlay(ctx, plot);
  }

  function drawAngles() {
    const theme = chartTheme();
    const { ctx, width, height } = setupCanvas(theme);
    const { eps, d } = buildEpsArrays();
    const lam = Math.max(1, tmm.fieldLam);
    const samples = 600;
    const angles = Array.from({ length: samples }, (_, i) => 90 * i / (samples - 1));
    const data = angleScan(eps, d, tmm.pol, lam, angles, tmm.nSub, tmm.nClad);

    const margin = { top: 26, right: 28, bottom: 58, left: 72 };
    const log = tmm.logScale;
    const plot = {
      left: margin.left, top: margin.top,
      width: width - margin.left - margin.right,
      height: height - margin.top - margin.bottom,
      xMin: 0, xMax: 90,
      yMin: log ? Math.log10(LOG_FLOOR) : 0,
      yMax: log ? 0 : 1.02,
      log,
    };
    tLastPlot = plot;
    drawAxes(ctx, theme, plot, 'Angle of incidence θ (°)', log ? 'Reflectance / transmittance (log)' : 'Reflectance / transmittance', width, height);

    tDrawnCurves = [];
    const legend: Array<{ label: string; color: string; dash?: number[] }> = [];
    if (tmm.showR) {
      const curve: DrawnCurve = { label: 'Reflectance ρ', color: R_COLOR, pts: data.map(p => ({ dx: p.angleDeg, dy: p.rho })) };
      tDrawnCurves.push(curve); strokeCurve(ctx, plot, curve);
      legend.push({ label: 'Reflectance ρ = |R|²', color: R_COLOR });
    }
    if (tmm.showT) {
      const curve: DrawnCurve = { label: 'Transmittance τ', color: T_COLOR, dash: [7, 5], pts: data.map(p => ({ dx: p.angleDeg, dy: p.tau })) };
      tDrawnCurves.push(curve); strokeCurve(ctx, plot, curve);
      legend.push({ label: 'Transmittance τ', color: T_COLOR, dash: [7, 5] });
    }
    renderLegend(legend);

    const maxDev = data.reduce((m, p) => Math.max(m, Math.abs(p.tau + p.rho - 1)), 0);
    $t('tmm-model-summary').textContent = `${tmm.layers.length} layers · ${tmm.pol} · λ = ${tfmt(lam, 4)} nm`;
    $t('tmm-note-text').innerHTML =
      `Reflectance &rho; and transmittance &tau; versus angle of incidence (0&ndash;90&deg;) at fixed &lambda; = ${tfmt(lam, 4)} nm `
      + `for the ${tmm.layers.length}-layer stack between n<sub>s</sub> = ${tfmt(tmm.nSub, 3)} and n<sub>c</sub> = ${tfmt(tmm.nClad, 3)} (${tmm.pol}). `
      + `For TM, watch for the Brewster condition (&rho; &rarr; 0). `
      + `Energy conservation: max|&tau; + &rho; &minus; 1| = ${maxDev.toExponential(2)}.`;

    tCsvHeader = ['angle_deg', 'reflectance_rho', 'transmittance_tau', 'abs_R', 'abs_T'];
    tCsvRows = data.map(p => [p.angleDeg, p.rho, p.tau, p.absR, p.absT].map(v => Number(v).toPrecision(9)));

    if (tHover) drawHoverOverlay(ctx, plot);
  }

  function drawFieldView() {
    const theme = chartTheme();
    const { ctx, width, height } = setupCanvas(theme);
    const { eps, d } = buildEpsArrays();
    const Nz = 600;
    const res = computeField(eps, d, tmm.pol, tmm.fieldLam, tmm.angleDeg, tmm.nSub, tmm.nClad, Nz, Math.max(0, tmm.marginSub), Math.max(0, tmm.marginClad));

    const maxIndex = Math.max(...res.index, 1e-6);
    const maxAbs = Math.max(...res.absF, 1e-12);
    const scale = maxIndex / maxAbs;             // scale field into the index range
    const absScaled = res.absF.map(v => v * scale);
    const reScaled = res.reF.map(v => v * scale);

    const showRe = tmm.showRe;
    const margin = { top: 26, right: 28, bottom: 58, left: 72 };
    const yMax = 1.15 * maxIndex;
    const yMin = showRe ? -1.15 * maxIndex : 0;
    const plot = {
      left: margin.left, top: margin.top,
      width: width - margin.left - margin.right,
      height: height - margin.top - margin.bottom,
      xMin: 0, xMax: res.total,
      yMin, yMax, log: false,
    };
    tLastPlot = plot;
    drawAxes(ctx, theme, plot, 'Position z (nm)', 'Field amplitude / refractive index', width, height);

    tDrawnCurves = [];
    const legend: Array<{ label: string; color: string; dash?: number[] }> = [];

    if (tmm.showIndex) {
      const curve: DrawnCurve = { label: 'Refractive index n(z)', color: INDEX_COLOR, dash: [4, 4], pts: res.z.map((z, i) => ({ dx: z, dy: res.index[i] })) };
      strokeCurve(ctx, plot, curve);
      legend.push({ label: 'Refractive index n(z)', color: INDEX_COLOR, dash: [4, 4] });
    }
    if (showRe) {
      const curve: DrawnCurve = { label: 'Re[F(z)]', color: RE_COLOR, pts: res.z.map((z, i) => ({ dx: z, dy: reScaled[i] })) };
      strokeCurve(ctx, plot, curve);
      legend.push({ label: 'Re[F(z)] (scaled)', color: RE_COLOR });
    }
    if (tmm.showAbs) {
      const curve: DrawnCurve = { label: '|F(z)|', color: FIELD_COLOR, pts: res.z.map((z, i) => ({ dx: z, dy: absScaled[i] })) };
      tDrawnCurves.push(curve); strokeCurve(ctx, plot, curve);
      legend.push({ label: '|F(z)| (scaled to nₘₐₓ)', color: FIELD_COLOR });
    }
    renderLegend(legend);

    const enhancement = maxAbs / (res.absF.reduce((s, v) => s + v, 0) / res.absF.length);
    $t('tmm-model-summary').textContent = `field · ${tmm.pol} · λ = ${tfmt(tmm.fieldLam, 4)} nm`;
    $t('tmm-note-text').innerHTML =
      `Complex field F(z) at &lambda; = ${tfmt(tmm.fieldLam, 4)} nm, reconstructed by normalising the transmitted wave to unity and `
      + `propagating from the cladding back through the stack. |F(z)| is scaled so its peak matches the maximum refractive index. `
      + `Peak / mean |F| enhancement &asymp; ${tfmt(enhancement, 3)}.`;

    tCsvHeader = ['z_nm', 'abs_F', 'Re_F', 'Im_F', 'index_n'];
    tCsvRows = res.z.map((z, i) => [z, res.absF[i], res.reF[i], res.imF[i], res.index[i]].map(v => Number(v).toPrecision(9)));

    if (tHover) drawHoverOverlay(ctx, plot);
  }

  function drawHoverOverlay(ctx: CanvasRenderingContext2D, plot: NonNullable<typeof tLastPlot>) {
    if (!tHover) return;
    ctx.save();
    ctx.beginPath();
    ctx.rect(plot.left, plot.top, plot.width, plot.height);
    ctx.clip();
    ctx.setLineDash([3, 4]);
    ctx.strokeStyle = tHover.color;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(tHover.px, plot.top);
    ctx.lineTo(tHover.px, plot.top + plot.height);
    ctx.moveTo(plot.left, tHover.py);
    ctx.lineTo(plot.left + plot.width, tHover.py);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = tHover.color;
    ctx.strokeStyle = chartTheme().bg;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(tHover.px, tHover.py, 4.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    ctx.restore();
  }

  // ---- hover --------------------------------------------------------------
  function handleTmmHover(event: MouseEvent) {
    if (!tLastPlot || !tDrawnCurves.length) return;
    const plot = tLastPlot;
    const rect = tCanvas.getBoundingClientRect();
    const mx = event.clientX - rect.left;
    const my = event.clientY - rect.top;
    if (mx < plot.left || mx > plot.left + plot.width || my < plot.top || my > plot.top + plot.height) {
      if (tHover) { tHover = null; tTooltip.hidden = true; drawTmm(); }
      return;
    }
    const xToPx = (x: number) => plot.left + (x - plot.xMin) / (plot.xMax - plot.xMin) * plot.width;
    const yToPx = (y: number) => plot.log
      ? plot.top + plot.height - (Math.log10(Math.max(LOG_FLOOR, y)) - plot.yMin) / (plot.yMax - plot.yMin) * plot.height
      : plot.top + plot.height - (y - plot.yMin) / (plot.yMax - plot.yMin) * plot.height;

    let best: { color: string; label: string; px: number; py: number; dx: number; dy: number } | null = null;
    let bestDist = Infinity;
    for (const curve of tDrawnCurves) {
      for (const p of curve.pts) {
        if (!Number.isFinite(p.dx) || !Number.isFinite(p.dy)) continue;
        const px = xToPx(p.dx);
        const py = yToPx(p.dy);
        const dist = (px - mx) ** 2 + (py - my) ** 2;
        if (dist < bestDist) { bestDist = dist; best = { color: curve.color, label: curve.label, px, py, dx: p.dx, dy: p.dy }; }
      }
    }
    if (!best || bestDist > 26 ** 2) {
      if (tHover) { tHover = null; tTooltip.hidden = true; drawTmm(); }
      return;
    }
    const xUnitLabel = tmm.mode === 'spectrum' ? (tmm.xUnit === 'ev' ? 'E (eV)' : 'λ (nm)')
      : tmm.mode === 'angles' ? 'θ (°)' : 'z (nm)';
    const yUnitLabel = tmm.mode === 'fields' ? 'amplitude' : 'value';
    tHover = { ...best, xUnit: xUnitLabel, yUnit: yUnitLabel };
    tTooltip.hidden = false;
    tTooltip.innerHTML =
      `<span><strong>${best.label}</strong></span>`
      + `<span>${tHover.xUnit} = ${tfmt(best.dx, 5)}</span>`
      + `<span>${tHover.yUnit} = ${tfmt(best.dy, 5)}</span>`;
    const ww = tChartWrap.clientWidth;
    const wh = tChartWrap.clientHeight;
    const tw = tTooltip.offsetWidth || 200;
    const th = tTooltip.offsetHeight || 80;
    tTooltip.style.left = `${clamp(mx + 14, 8, Math.max(8, ww - tw - 8))}px`;
    tTooltip.style.top = `${clamp(my - th - 12, 8, Math.max(8, wh - th - 8))}px`;
    drawTmm();
  }

  // ---- mutations ----------------------------------------------------------
  function tmmAddLayer() {
    clearGroupSelection();
    if (tmm.layers.length >= TMM_MAX_LAYERS) return;
    const idx = tmm.layers.length;
    tmm.layers.push({ n: 2.0, kappa: 0, thicknessNm: 75, color: palette[idx % palette.length] });
    tmm.preset = 'custom';
    renderTmmLayerEditor();
    drawTmm();
    markActiveTmmPreset();
  }

  function tmmRemoveLayer() {
    clearGroupSelection();
    if (tmm.layers.length <= TMM_MIN_LAYERS) return;
    tmm.layers.pop();
    tmm.preset = 'custom';
    renderTmmLayerEditor();
    drawTmm();
    markActiveTmmPreset();
  }

  function tmmRemoveLayerAt(index: number) {
    clearGroupSelection();
    if (tmm.layers.length <= TMM_MIN_LAYERS) return;
    if (!Number.isInteger(index) || index < 0 || index >= tmm.layers.length) return;
    tmm.layers.splice(index, 1);          // re-enumeration is automatic on re-render
    tmm.preset = 'custom';
    renderTmmLayerEditor();
    drawTmm();
    markActiveTmmPreset();
  }

  function setTmmLayerValue(input: HTMLInputElement) {
    const index = Number.parseInt(input.dataset.tmmLayer ?? '-1', 10);
    const key = input.dataset.key as 'n' | 'kappa' | 'thicknessNm' | undefined;
    if (!Number.isInteger(index) || index < 0 || index >= tmm.layers.length || !key) return;
    const value = Number.parseFloat(input.value);
    if (!Number.isFinite(value)) return;
    const v = key === 'n' ? Math.max(0.05, value) : Math.max(0, value);
    // if this layer's group is locked (selected), the edit applies to the whole group
    const targets = isTmmGroupSelected(index) ? selectedGroup! : [index];
    for (const i of targets) {
      tmm.layers[i][key] = v;
      if (i !== index) {   // keep the other group members' inputs in sync
        const inp = tLayerEditor.querySelector<HTMLInputElement>(`input[data-tmm-layer="${i}"][data-key="${key}"]`);
        if (inp) inp.value = tfmt(v, 6);
      }
    }
    tmm.preset = 'custom';
    markActiveTmmPreset();
    renderTmmStack();
    refreshTmmSwatches();       // recolour editor dots if this edit changed the grouping
    refreshTmmSelectionRings(); // keep the black rings on the (still-locked) group
    drawTmm();
  }

  // ---- group selection ("lock") ------------------------------------------
  // Clicking a layer's colour swatch selects (black ring) every layer in that
  // group; while selected, editing any of its entries changes them all. Clicking
  // again deselects; clicking another group's swatch switches the selection.
  let selectedGroup: number[] | null = null;   // physical indices locked together
  function isTmmGroupSelected(i: number): boolean { return selectedGroup !== null && selectedGroup.includes(i); }
  function clearGroupSelection() { selectedGroup = null; }
  function refreshTmmSelectionRings() {
    tLayerEditor.querySelectorAll<HTMLElement>('[data-tmm-swatch]').forEach(el => {
      const i = Number.parseInt(el.dataset.tmmSwatch ?? '-1', 10);
      const on = isTmmGroupSelected(i);
      el.classList.toggle('layer-swatch--sel', on);
      el.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }
  function toggleGroupSelection(index: number) {
    if (!Number.isInteger(index) || index < 0 || index >= tmm.layers.length) return;
    if (isTmmGroupSelected(index)) {
      selectedGroup = null;                             // click same group → deselect
    } else {
      const key = tmmGroupKey(tmm.layers[index]);       // select (or switch to) this group
      selectedGroup = tmm.layers.reduce<number[]>((acc, l, i) => { if (tmmGroupKey(l) === key) acc.push(i); return acc; }, []);
    }
    refreshTmmSelectionRings();
  }

  function applyTmmPreset(preset: Preset) {
    clearGroupSelection();
    tmm.preset = preset;
    tmm.mode = 'spectrum';
    tmm.xUnit = 'nm';
    if (preset === 'bragg') {
      tmm.layers = makeBraggLayers();
      tmm.nSub = 1.0; tmm.nClad = 1.5; tmm.pol = 'TE'; tmm.angleDeg = 0;
      tmm.lamMin = 400; tmm.lamMax = 800; tmm.fieldLam = 600; tmm.logScale = false;
      tmm.marginSub = 300; tmm.marginClad = 300;
    } else if (preset === 'fp') {
      tmm.layers = makeFabryPerotLayers();
      tmm.nSub = 1.0; tmm.nClad = 1.5; tmm.pol = 'TE'; tmm.angleDeg = 0;
      tmm.lamMin = 400; tmm.lamMax = 800; tmm.fieldLam = 600; tmm.logScale = false;
      tmm.marginSub = 300; tmm.marginClad = 300;
    } else if (preset === 'ar') {
      tmm.layers = makeArLayers();
      tmm.nSub = 1.0; tmm.nClad = 1.5; tmm.pol = 'TE'; tmm.angleDeg = 0;
      tmm.lamMin = 380; tmm.lamMax = 780; tmm.fieldLam = 550; tmm.logScale = false;
      tmm.marginSub = 300; tmm.marginClad = 300;
    }
    tHover = null; tTooltip.hidden = true;
    renderTmmLayerEditor();
    drawTmm();
    markActiveTmmPreset();
  }

  function tmmDuplicateLayerAt(index: number) {
    clearGroupSelection();
    if (tmm.layers.length >= TMM_MAX_LAYERS) return;
    if (!Number.isInteger(index) || index < 0 || index >= tmm.layers.length) return;
    tmm.layers.splice(index + 1, 0, { ...tmm.layers[index] });   // copy inserted directly below
    tmm.preset = 'custom';
    renderTmmLayerEditor();
    drawTmm();
    markActiveTmmPreset();
  }

  function tmmMoveLayer(index: number, dir: -1 | 1) {
    clearGroupSelection();
    const j = index + dir;
    if (!Number.isInteger(index) || index < 0 || index >= tmm.layers.length) return;
    if (j < 0 || j >= tmm.layers.length) return;
    [tmm.layers[index], tmm.layers[j]] = [tmm.layers[j], tmm.layers[index]];   // swap with neighbour
    tmm.preset = 'custom';
    renderTmmLayerEditor();
    drawTmm();
    markActiveTmmPreset();
  }

  // ---- CSV / PNG ----------------------------------------------------------
  function tmmCsv(): string {
    let head: string[];
    if (tmm.mode === 'spectrum') {
      head = ['# Layered structure (TMM) -- spectrum', `# pol=${tmm.pol}, angle_deg=${tmm.angleDeg}, n_s=${tmm.nSub}, n_c=${tmm.nClad}`];
    } else if (tmm.mode === 'angles') {
      head = ['# Layered structure (TMM) -- angle scan', `# pol=${tmm.pol}, lambda_nm=${tmm.fieldLam}, n_s=${tmm.nSub}, n_c=${tmm.nClad}`];
    } else if (tmm.mode === 'structure') {
      head = ['# Layered structure (TMM) -- index profile', `# n_s=${tmm.nSub}, n_c=${tmm.nClad}, margin_sub_nm=${tmm.marginSub}, margin_clad_nm=${tmm.marginClad}`];
    } else {
      head = ['# Layered structure (TMM) -- field', `# pol=${tmm.pol}, lambda_nm=${tmm.fieldLam}, angle_deg=${tmm.angleDeg}, n_s=${tmm.nSub}, n_c=${tmm.nClad}`];
    }
    return [...head, tCsvHeader.join(','), ...tCsvRows.map(r => r.join(','))].join('\n') + '\n';
  }

  import { downloadBlob as downloadBlobTmm } from '../../../lib/download';

  // ---- events -------------------------------------------------------------
  $t('tmm-add-layer').addEventListener('click', tmmAddLayer);
  $t('tmm-remove-layer').addEventListener('click', tmmRemoveLayer);
  $t('tmm-preset-bragg').addEventListener('click', () => applyTmmPreset('bragg'));
  $t('tmm-preset-fp').addEventListener('click', () => applyTmmPreset('fp'));
  $t('tmm-preset-ar').addEventListener('click', () => applyTmmPreset('ar'));
  $t('tmm-reset').addEventListener('click', () => applyTmmPreset('bragg'));

  tLayerEditor.addEventListener('change', event => {
    const input = event.target as HTMLInputElement;
    if (input?.dataset?.tmmLayer) setTmmLayerValue(input);
  });

  tLayerEditor.addEventListener('click', event => {
    const target = event.target as HTMLElement;
    const sw = target.closest<HTMLButtonElement>('[data-tmm-swatch]');
    if (sw) { toggleGroupSelection(Number.parseInt(sw.dataset.tmmSwatch ?? '-1', 10)); return; }
    const dup = target.closest<HTMLButtonElement>('[data-tmm-dup]');
    if (dup) { tmmDuplicateLayerAt(Number.parseInt(dup.dataset.tmmDup ?? '-1', 10)); return; }
    const up = target.closest<HTMLButtonElement>('[data-tmm-up]');
    if (up) { tmmMoveLayer(Number.parseInt(up.dataset.tmmUp ?? '-1', 10), -1); return; }
    const down = target.closest<HTMLButtonElement>('[data-tmm-down]');
    if (down) { tmmMoveLayer(Number.parseInt(down.dataset.tmmDown ?? '-1', 10), 1); return; }
    const btn = target.closest<HTMLButtonElement>('[data-tmm-remove]');
    if (!btn) return;
    tmmRemoveLayerAt(Number.parseInt(btn.dataset.tmmRemove ?? '-1', 10));
  });

  $t('tmm-pol-tabs').addEventListener('click', event => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-pol]');
    if (!btn) return;
    tmm.pol = btn.dataset.pol as Pol;
    drawTmm();
  });

  $t('tmm-mode-tabs').addEventListener('click', event => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-mode]');
    if (!btn) return;
    tmm.mode = btn.dataset.mode as Mode;
    tHover = null; tTooltip.hidden = true;
    drawTmm();
  });

  $t('tmm-xunit-tabs').addEventListener('click', event => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-xunit]');
    if (!btn) return;
    tmm.xUnit = btn.dataset.xunit as XUnit;
    tHover = null; tTooltip.hidden = true;
    drawTmm();
  });

  $t('tmm-quantity-tabs').addEventListener('click', event => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-quantity]');
    if (!btn) return;
    tmm.structQuantity = btn.dataset.quantity as StructQuantity;
    drawTmm();
  });

  function bindNumber(id: string, apply: (v: number) => void) {
    const el = $t(id) as HTMLInputElement;
    const commit = () => {
      const v = Number.parseFloat(el.value);
      if (Number.isFinite(v)) { apply(v); tmm.preset = 'custom'; markActiveTmmPreset(); drawTmm(); }
    };
    el.addEventListener('change', commit);
    el.addEventListener('keydown', e => { if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); commit(); } });
  }
  bindNumber('tmm-n-sub', v => { tmm.nSub = Math.max(0.05, v); });
  bindNumber('tmm-n-clad', v => { tmm.nClad = Math.max(0.05, v); });
  bindNumber('tmm-angle', v => { tmm.angleDeg = clamp(v, 0, 90); });

  // Range Min/Max are unit-aware: in eV mode the entered value is a photon energy,
  // so min energy maps to the max wavelength and vice versa (E = HC / lambda).
  function commitRange(which: 'min' | 'max', raw: number) {
    if (!Number.isFinite(raw)) return;
    if (tmm.xUnit === 'ev') {
      const e = Math.max(1e-3, raw);
      if (which === 'min') tmm.lamMax = HC_EV_NM / e; else tmm.lamMin = HC_EV_NM / e;
    } else {
      const lam = Math.max(1, raw);
      if (which === 'min') tmm.lamMin = lam; else tmm.lamMax = lam;
    }
    tmm.preset = 'custom'; markActiveTmmPreset(); drawTmm();
  }
  (['min', 'max'] as const).forEach(which => {
    const el = $t(which === 'min' ? 'tmm-lam-min' : 'tmm-lam-max') as HTMLInputElement;
    const run = () => commitRange(which, Number.parseFloat(el.value));
    el.addEventListener('change', run);
    el.addEventListener('keydown', e => { if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); run(); } });
  });

  bindNumber('tmm-field-lam', v => { tmm.fieldLam = Math.max(1, v); });
  bindNumber('tmm-margin-sub', v => { tmm.marginSub = Math.max(0, v); });
  bindNumber('tmm-margin-clad', v => { tmm.marginClad = Math.max(0, v); });

  function bindSlider(id: string, apply: (v: number) => void) {
    $t(id).addEventListener('input', event => {
      const v = Number.parseFloat((event.target as HTMLInputElement).value);
      if (Number.isFinite(v)) { apply(v); tmm.preset = 'custom'; markActiveTmmPreset(); drawTmm(); }
    });
  }
  bindSlider('tmm-angle-slider', v => { tmm.angleDeg = clamp(v, 0, 90); });
  bindSlider('tmm-lam-slider', v => { tmm.fieldLam = Math.max(1, v); });

  function bindCheck(id: string, apply: (checked: boolean) => void) {
    $t(id).addEventListener('change', event => { apply((event.target as HTMLInputElement).checked); drawTmm(); });
  }
  bindCheck('tmm-show-r', c => { tmm.showR = c; });
  bindCheck('tmm-show-t', c => { tmm.showT = c; });
  bindCheck('tmm-log', c => { tmm.logScale = c; });
  bindCheck('tmm-show-abs', c => { tmm.showAbs = c; });
  bindCheck('tmm-show-re', c => { tmm.showRe = c; });
  bindCheck('tmm-show-index', c => { tmm.showIndex = c; });

  $t('tmm-dl-png').addEventListener('click', () => {
    tCanvas.toBlob(blob => { if (blob) downloadBlobTmm(blob, `heterostructures_tmm_${tmm.mode}.png`); }, 'image/png');
  });
  $t('tmm-dl-csv').addEventListener('click', () => {
    downloadBlobTmm(new Blob([tmmCsv()], { type: 'text/csv' }), `heterostructures_tmm_${tmm.mode}.csv`);
  });

  tCanvas.addEventListener('mousemove', handleTmmHover);
  tCanvas.addEventListener('mouseleave', () => { if (tHover) { tHover = null; tTooltip.hidden = true; drawTmm(); } });

  new ResizeObserver(() => { if (!$t('module-panel-layered-structure').hidden) drawTmm(); }).observe(tChartWrap);
  onThemeChange(() => { if (!$t('module-panel-layered-structure').hidden) drawTmm(); });
  window.addEventListener('heterostructures:show-layered-structure', () => drawTmm());

  // initial render (panel may be hidden; canvas is min-sized, redrawn on reveal)
  renderTmmLayerEditor();
  renderTmmStack();
  syncTmmControls();
  markActiveTmmPreset();
  drawTmm();
</script>

<script>
  // ===== Module switcher: toggle between the two heterostructure modules =====
  (() => {
    const panels: Record<string, string> = {
      'module-surface-plasmons': 'module-panel-surface-plasmons',
      'module-layered-structure': 'module-panel-layered-structure',
    };
    const revealEvents: Record<string, string> = {
      'module-surface-plasmons': 'heterostructures:show-surface-plasmons',
      'module-layered-structure': 'heterostructures:show-layered-structure',
    };
    const buttons = Object.keys(panels).map(id => document.getElementById(id)).filter(Boolean) as HTMLButtonElement[];

    function activate(buttonId: string) {
      buttons.forEach(btn => {
        const active = btn.id === buttonId;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
      });
      Object.entries(panels).forEach(([id, panelId]) => {
        const panel = document.getElementById(panelId);
        if (panel) panel.hidden = id !== buttonId;
      });
      window.dispatchEvent(new CustomEvent(revealEvents[buttonId]));
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => { if (!btn.disabled) activate(btn.id); });
    });
  })();
</script>
