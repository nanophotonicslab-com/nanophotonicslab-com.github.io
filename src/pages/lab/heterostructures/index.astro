  $p('pr-rosette-pop').addEventListener('click', e => e.stopPropagation());
  document.addEventListener('click', () => closePrRosettePop());
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePrRosettePop(); });

  // far-field display mode (pattern | rosette | spectrum | flux vs z)
  $p('pr-ff-mode').addEventListener('click', e => {
