  // ---- export / share ----------------------------------------------------
  /**
   * Provenance lines shared by every PyRAMIDS export. Without them the files
   * are anonymous: two views, or the same view at two wavelengths, produce
   * columns that look alike and carry no record of the stack they came from.
   */
  function prCsvHead(what: string): string[] {
    const chOn = PR_CH_ORDER.filter(k => pr.ch[k]).map(k => CH[k].label).join(' + ') || 'none';
    const layers = pr.layers.length
      ? pr.layers.map(l => `${l.thicknessNm}nm n=${l.n}+${l.kappa}i`).join('; ')
      : 'none (bare interface)';
    return [
      `# PyRAMIDS heterostructures lab — ${what}`,
      `# lambda_nm=${pr.lamNm}, substrate n=${pr.subN}+${pr.subK}i, superstrate n=${pr.cladN}+${pr.cladK}i`,
      `# layers=[${layers}]`,
      pr.exc === 'dip'
        ? `# excitation=dipole, z_emitter_nm=${pfmt(pr.zNm, 6)}, channels=${chOn}`
        : `# excitation=plane wave, polarization=${pr.pol}, angle_deg=${pr.angleDeg}`,
    ];
  }

  function prCsv(): string {
    const { nstack, dstack } = buildStack();
    const k0v = k0Of();
    if (pr.view === 'farfield' && (pr.ffMode === 'spectrum' || pr.ffMode === 'fluxz')) {
      const spec = getFfSpectrum();
      const isZ = spec.mode === 'z';
      const isEv = pr.ffXUnit === 'ev';
      const head = [isZ ? 'z_nm' : isEv ? 'energy_eV' : 'lambda_nm', ...spec.series.flatMap(s => [`${s.key}_up`, `${s.key}_down`])];
      const lines = [
        ...prCsvHead(isZ ? 'radiated flux vs emitter position' : 'radiated flux spectrum'),
        '# _up = flux into the superstrate, _down = into the substrate, per unit free-space dipole',
        head.join(','),
      ];
      spec.x.forEach((xv, i) => {
        const x0 = isZ ? xv : isEv ? EV_NM / xv : xv;
        lines.push([x0, ...spec.series.flatMap(s => [s.up[i], s.down[i]])].map(v => pfmt(v, 6)).join(','));
      });
      return lines.join('\n') + '\n';
    }
    if (pr.view === 'farfield' && pr.ffMode === 'rosette') {
      // Export what the rosette actually shows — Stokes parameters over both
      // hemispheres — rather than the theta-scan pattern below.
      const grid = computeRosette();
      if (!grid) return '# no dipole channel enabled\n';
      const lines = [
        ...prCsvHead('far-field Stokes polarimetry (rosette)'),
        '# theta_deg measured from the pole of each hemisphere (1..89), phi_deg anticlockwise from +x',
        '# S0 total, S1 = p-minus-s, S2 = +/-45deg, S3 = circular; incoherent sum over the enabled channels',
        `# S0_max=${pfmt(grid.s0max, 6)} (the chart normalizes S1..S3 by S0_max)`,
        'hemisphere,theta_deg,phi_deg,S0,S1,S2,S3',
      ];
      for (const hemi of grid.hemis) {
        for (let g = 0; g < grid.NG; g++) {
          const thDeg = hemi.th[g] * 180 / Math.PI;
          lines.push([
            hemi.tag,
            ...[thDeg, grid.phL[g] * 180 / Math.PI,
              hemi.g.S0[g], hemi.g.S1[g], hemi.g.S2[g], hemi.g.S3[g]].map(v => pfmt(v, 6)),
          ].join(','));
        }
      }
      return lines.join('\n') + '\n';
    }
    if (pr.view === 'farfield') {
      const NTH = 181;
      const th = Array.from({ length: NTH }, (_, i) => Math.PI * i / (NTH - 1));
      const phi0 = th.map(() => 0);
      const zeroV = [cx(0), cx(0), cx(0)];
      const cols: [string, Cx[], Cx[]][] = [
        ['P_epar', [cx(1), cx(0), cx(0)], zeroV],
        ['P_eperp', [cx(0), cx(0), cx(1)], zeroV],
        ['P_mpar', zeroV, [cx(1), cx(0), cx(0)]],
        ['P_mperp', zeroV, [cx(0), cx(0), cx(1)]],
      ];
      const data = cols.map(([, pu, mu]) => radiationPattern(k0v, pr.zNm, pu, mu, th, phi0, nstack, dstack));
      const lines = [
        ...prCsvHead('far-field radiation pattern'),
        '# power per solid angle at phi=0, normalized to the same dipole in free space;'
        + ' theta from +z, so theta>90 is into the substrate',
        'theta_deg,' + cols.map(c => c[0]).join(','),
      ];
      th.forEach((t, i) => lines.push([t * 180 / Math.PI, ...data.map(d => d[i])].map(v => pfmt(v, 6)).join(',')));
      return lines.join('\n') + '\n';
    }
    if (pr.view === 'pwspec' || pr.view === 'pwang') {
      const isSpec = pr.view === 'pwspec';
      const lines = [
        ...prCsvHead(isSpec ? 'plane-wave R/T/A spectrum' : 'plane-wave R/T/A angle scan'),
        '# both polarizations are tabulated regardless of the displayed one',
        (isSpec ? 'lambda_nm' : 'theta_deg') + ',R_s,T_s,A_s,R_p,T_p,A_p',
      ];
      const N = 240;
      for (let i = 0; i < N; i++) {
        let k0i = k0v, kp = 0, x = 0;
        if (isSpec) {
          const lmin = Math.min(pr.rng.lamMin, pr.rng.lamMax), lmax = Math.max(pr.rng.lamMin, pr.rng.lamMax);
          x = lmin + (lmax - lmin) * i / (N - 1); k0i = 2 * Math.PI / x;
          kp = pr.subN * k0i * Math.sin(pr.angleDeg * Math.PI / 180);
        } else {
          x = 89.5 * i / (N - 1);
          kp = pr.subN * k0v * Math.sin(x * Math.PI / 180);
        }
        const rta = intensityRT(k0i, kp, nstack, dstack);
        lines.push([x, rta.s.R, rta.s.T, rta.s.A, rta.p.R, rta.p.T, rta.p.A].map(v => pfmt(v, 6)).join(','));
      }
      return lines.join('\n') + '\n';
    }
    if (pr.view === 'pwfields') {
      const { zmin, zmax } = prZRange();
      const N = 280;
      const zGrid = Array.from({ length: N }, (_, i) => zmin + (zmax - zmin) * i / (N - 1));
      const f = planeWaveFieldsAtZ(k0v, pwKparAt(k0v), nstack, dstack, zGrid);
      const lines = [
        ...prCsvHead('plane-wave local fields vs position'),
        '# |E| for unit incident amplitude; absDensity is the absorbed-power density (arb. units)',
        'z_nm,absE_s,absE_p,absDensity_s,absDensity_p',
      ];
      zGrid.forEach((z, i) => lines.push([z, f.Es[i], f.Ep[i], f.As[i], f.Ap[i]].map(v => pfmt(v, 6)).join(',')));
      return lines.join('\n') + '\n';
    }
    if (pr.view === 'pwkmap') {
      const m = getKmap();
      const xName = pr.kmap.xUnit === 'inm' ? 'kpar_inv_nm' : 'theta_deg';
      const yName = pr.kmap.yUnit === 'nm' ? 'lambda_nm' : 'energy_eV';
      const lines = [
        ...prCsvHead('plane-wave reflection-coefficient map'),
        '# complex r for both polarizations at every grid node; the chart shows one of '
        + 'Re/Im/|r| for the selected polarization, optionally as log10',
        `# grid = ${m.NK} x-points x ${m.NL} y-rows`,
        `${xName},${yName},re_rs,im_rs,re_rp,im_rp`,
      ];
      for (let j = 0; j < m.NL; j++) {
        const yv = pr.kmap.yUnit === 'nm' ? m.lamRows[j] : EV_NM / m.lamRows[j];
        for (let i = 0; i < m.NK; i++) {
          const idx = j * m.NK + i;
          lines.push([m.xs[i], yv, m.rsRe[idx], m.rsIm[idx], m.rpRe[idx], m.rpIm[idx]].map(v => pfmt(v, 6)).join(','));
        }
      }
      return lines.join('\n') + '\n';
    }
    if (pr.view === 'pwkpar') {
      const qmax = Math.max(1.5, ...nstack.map(n => Math.abs(n.re))) + 0.4;
      const N = 500;
      const lines = [
        ...prCsvHead('plane-wave |r| vs in-plane wavevector'),
        '# |r| for both polarizations; poles beyond the light line are the guided modes',
        'kpar_over_k0,abs_rs,abs_rp',
      ];
      for (let i = 0; i < N; i++) {
        const q = qmax * (i + 0.5) / N;
        const a = fresnelAmplitudes(k0v, q * k0v, nstack, dstack);
        lines.push([q, Math.hypot(a.rs.re, a.rs.im), Math.hypot(a.rp.re, a.rp.im)].map(v => pfmt(v, 6)).join(','));
      }
      return lines.join('\n') + '\n';
    }
    if (pr.view === 'kpar') {
      // This view used to fall through to the LDOS-vs-z table below, so the
      // download bore no relation to the k-parallel map on screen.
      const { kparList, zList, trace } = getKparTrace();
      const lines = [
        ...prCsvHead('k-parallel LDOS integrand map'),
        '# the chart shows log10 of the selected channel; all four are tabulated here so the '
        + 'displayed "mean" = 0.5*((2*E_par + E_perp)/3 + (2*M_par + M_perp)/3) is reproducible',
        `# grid = ${kparList.length} k-parallel x ${zList.length} z points`,
        'kpar_over_k0,z_nm,integrand_E_par,integrand_E_perp,integrand_M_par,integrand_M_perp',
      ];
      for (let zi = 0; zi < zList.length; zi++) {
        for (let ki = 0; ki < kparList.length; ki++) {
          lines.push([
            kparList[ki], zList[zi],
            trace[0][zi][ki], trace[1][zi][ki], trace[2][zi][ki], trace[3][zi][ki],
          ].map(v => pfmt(v, 6)).join(','));
        }
      }
      return lines.join('\n') + '\n';
    }
    const { zGrid, r, iso } = getLdos();
    const lines = [
      ...prCsvHead('LDOS vs emitter position'),
      '# LDOS normalized to the vacuum value; iso = (2*E_par + E_perp)/3',
      'z_nm,LDOS_E_par,LDOS_E_perp,LDOS_M_par,LDOS_M_perp,LDOS_iso',
    ];
    for (let i = 0; i < zGrid.length; i++)
      lines.push([zGrid[i], r.E_par[i], r.E_perp[i], r.M_par[i], r.M_perp[i], iso[i]].map(v => pfmt(v, 6)).join(','));
    return lines.join('\n') + '\n';
  }
  function prSerialize(): string {
    const s = {
      sN: pr.subN, sK: pr.subK, cN: pr.cladN, cK: pr.cladK, lam: pr.lamNm, z: Math.round(pr.zNm),
      x: pr.exc, v: pr.view, kc: pr.kparCh, ch: pr.ch, pol: pr.pol, ang: pr.angleDeg,
      km: pr.kmap, ffm: pr.ffMode, fx: pr.ffXUnit, rng: pr.rng, L: pr.layers.map(l => [l.thicknessNm, l.n, l.kappa]),
    };
    return 'pyr=' + encodeURIComponent(btoa(JSON.stringify(s)));
  }
  const PR_ALL_VIEWS: PrView[] = ['ldos', 'kpar', 'farfield', 'pwspec', 'pwang', 'pwfields', 'pwkpar'];
  function prRestore(hash: string): boolean {
    const m = /(?:^|&)pyr=([^&]+)/.exec(hash); if (!m) return false;
    try {
      const s = JSON.parse(atob(decodeURIComponent(m[1])));
      pr.subN = +s.sN; pr.subK = +s.sK; pr.cladN = +s.cN; pr.cladK = +s.cK;
      pr.lamNm = clampP(+s.lam, LAM_MIN, LAM_MAX); pr.zNm = +s.z;
      pr.exc = s.x === 'pw' ? 'pw' : 'dip';
      pr.view = PR_ALL_VIEWS.includes(s.v) ? s.v : (pr.exc === 'pw' ? 'pwspec' : 'ldos');
      if ((pr.exc === 'pw') !== pr.view.startsWith('pw')) pr.view = pr.exc === 'pw' ? 'pwspec' : 'ldos';
      pr.kparCh = ['mean', 'epar', 'eperp'].includes(s.kc) ? s.kc : 'mean';
      if (s.ch) for (const k of PR_CH_ORDER) pr.ch[k] = !!s.ch[k];
      pr.pol = ['s', 'p', 'avg'].includes(s.pol) ? s.pol : 'avg';
      pr.angleDeg = clampP(+s.ang || 0, 0, 89);
      pr.ffMode = ['rosette', 'spectrum', 'fluxz'].includes(s.ffm) ? s.ffm : 'pattern';
      segPick('pr-ff-mode', 'prffm', pr.ffMode);
      pr.ffXUnit = s.fx === 'ev' ? 'ev' : 'nm';
      segPick('pr-ff-axis', 'prffx', pr.ffXUnit);
      if (s.km) {
        pr.kmap.q = ['re', 'im', 'abs'].includes(s.km.q) ? s.km.q : 'abs';
        pr.kmap.log = !!s.km.log;
        pr.kmap.yUnit = s.km.yUnit === 'ev' ? 'ev' : 'nm';
        pr.kmap.xUnit = s.km.xUnit === 'deg' ? 'deg' : 'inm';
        segPick('pr-kmap-q', 'prkq', pr.kmap.q);
        segPick('pr-kmap-y', 'prky', pr.kmap.yUnit);
        segPick('pr-kmap-x', 'prkx', pr.kmap.xUnit);
        const lg = $p('pr-kmap-log') as HTMLInputElement;
        lg.checked = pr.kmap.log; lg.disabled = pr.kmap.q !== 'abs';
      }
      if (s.rng) {
        pr.rng.zMin = Number.isFinite(+s.rng.zMin) && s.rng.zMin !== null ? +s.rng.zMin : null;
        pr.rng.zMax = Number.isFinite(+s.rng.zMax) && s.rng.zMax !== null ? +s.rng.zMax : null;
        pr.rng.yMax = Number.isFinite(+s.rng.yMax) && s.rng.yMax !== null ? +s.rng.yMax : null;
        pr.rng.lamMin = clampP(+s.rng.lamMin || 400, 200, 3000);
        pr.rng.lamMax = clampP(+s.rng.lamMax || 800, 200, 3000);
      }
      pr.layers = Array.isArray(s.L) ? s.L.map((a: number[]) => ({ thicknessNm: +a[0], n: +a[1], kappa: +a[2], color: '#000' })) : [];
      pr.preset = 'custom';
      ($p('pr-n-sub') as HTMLInputElement).value = String(pr.subN);
      ($p('pr-k-sub') as HTMLInputElement).value = String(pr.subK);
      ($p('pr-n-clad') as HTMLInputElement).value = String(pr.cladN);
      ($p('pr-k-clad') as HTMLInputElement).value = String(pr.cladK);
      lamNum.value = String(pr.lamNm); lamSl.value = String(pr.lamNm);
      angNum.value = String(pr.angleDeg); angSl.value = String(pr.angleDeg);
      ($p('pr-zmin') as HTMLInputElement).value = pr.rng.zMin === null ? '' : String(pr.rng.zMin);
      ($p('pr-zmax') as HTMLInputElement).value = pr.rng.zMax === null ? '' : String(pr.rng.zMax);
      ($p('pr-ymax') as HTMLInputElement).value = pr.rng.yMax === null ? '' : String(pr.rng.yMax);
      ($p('pr-lammin') as HTMLInputElement).value = String(pr.rng.lamMin);
      ($p('pr-lammax') as HTMLInputElement).value = String(pr.rng.lamMax);
      $p('pr-exc-tabs').querySelectorAll('[data-prexc]').forEach(btn => {
        const on = (btn as HTMLElement).dataset.prexc === pr.exc;
        btn.classList.toggle('active', on); btn.setAttribute('aria-checked', on ? 'true' : 'false');
      });
      $p('pr-pol-tabs').querySelectorAll('[data-prpol]').forEach(btn => {
        const on = (btn as HTMLElement).dataset.prpol === pr.pol;
        btn.classList.toggle('active', on); btn.setAttribute('aria-checked', on ? 'true' : 'false');
      });
      $p('pr-kpar-ch').querySelectorAll('[data-prch]').forEach(btn => {
        const on = (btn as HTMLElement).dataset.prch === pr.kparCh;
        btn.classList.toggle('active', on); btn.setAttribute('aria-checked', on ? 'true' : 'false');
      });
      return true;
    } catch { return false; }
  }
  $p('pr-dl-png').addEventListener('click', () => {
    const url = prCanvas.toDataURL('image/png');
    const a = document.createElement('a'); a.href = url; a.download = `pyramids-${pr.view}.png`; a.click();
  });
  $p('pr-dl-csv').addEventListener('click', () => {
    const blob = new Blob([prCsv()], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = `pyramids-${pr.view}.csv`; a.click(); URL.revokeObjectURL(url);
  });
  const prShareBtn = $p('pr-dl-share');
  prShareBtn.addEventListener('click', () => {
    const url = location.origin + location.pathname + '#' + prSerialize();
    navigator.clipboard.writeText(url).then(() => {
      const orig = prShareBtn.innerHTML;
      prShareBtn.textContent = 'Copied!';
      setTimeout(() => { prShareBtn.innerHTML = orig; }, 1500);
    });
  });

  // redraw hooks
  new ResizeObserver(() => { if (!$p('module-panel-pyramids').hidden) renderPrNow(); }).observe(prWrap);
  onThemeChange(() => { if (!$p('module-panel-pyramids').hidden) renderPrNow(); });
  window.addEventListener('heterostructures:show-pyramids', () => { syncPrZSlider(); schedulePr(); });

  // ---- init --------------------------------------------------------------
  const prHasShare = prRestore(location.hash.slice(1));
  (window as unknown as { __prHasShare?: boolean }).__prHasShare = prHasShare;
  renderPrEditor(); renderPrStack(); prMarkPreset(); syncPrZSlider();
  renderPrViewTabs(); renderPrChannelLegend(); updatePrViewChrome(); drawPrGeo();
  // (panel starts hidden; first compute happens on reveal)
</script>

<script>
  // ===== Module switcher: toggle between the two heterostructure modules =====
  (() => {
    const panels: Record<string, string> = {
      'module-surface-plasmons': 'module-panel-surface-plasmons',
      'module-layered-structure': 'module-panel-layered-structure',
      'module-pyramids': 'module-panel-pyramids',
    };
    const revealEvents: Record<string, string> = {
      'module-surface-plasmons': 'heterostructures:show-surface-plasmons',
      'module-layered-structure': 'heterostructures:show-layered-structure',
      'module-pyramids': 'heterostructures:show-pyramids',
    };
    const buttons = Object.keys(panels).map(id => document.getElementById(id)).filter(Boolean) as HTMLButtonElement[];

    function activate(buttonId: string) {
      buttons.forEach(btn => {
        const active = btn.id === buttonId;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-checked', active ? 'true' : 'false');
      });
      Object.entries(panels).forEach(([id, panelId]) => {
        const panel = document.getElementById(panelId);
        if (panel) panel.hidden = id !== buttonId;
      });
      // excitation slot: space is always reserved; visible only for PyRAMIDS
      const exc = document.getElementById('pr-excitation');
      if (exc) exc.classList.toggle('excitation-bar--hidden', buttonId !== 'module-pyramids');
      window.dispatchEvent(new CustomEvent(revealEvents[buttonId]));
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => { if (!btn.disabled) activate(btn.id); });
    });

    // A shared link opens directly on the relevant module.
    const h = location.hash.slice(1);
    if (/(?:^|&)pyr=/.test(h)) activate('module-pyramids');
    else if (/(?:^|&)tmm=/.test(h)) activate('module-layered-structure');
    else if (/(?:^|&)sp=/.test(h)) activate('module-surface-plasmons');
  })();
</script>
