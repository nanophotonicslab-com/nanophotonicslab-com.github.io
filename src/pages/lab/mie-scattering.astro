      } else {
        geoTabs.select('coreshell');
        setSelectValue(coreMaterialSelect, p.layers[0].mat);
        if (p.layers[0].mat === 'custom') { relaxStepSlider(document.getElementById('core-eps-slider') as HTMLInputElement); coreEpsParam.setValue(SILICA_EPS); }
        relaxRadiusSlider(document.getElementById('core-r-slider') as HTMLInputElement);
        coreRParam.setValue(p.layers[0].r);
        setSelectValue(materialSelect, p.layers[1].mat);
        if (p.layers[1].mat === 'custom') { relaxStepSlider(document.getElementById('eps-slider') as HTMLInputElement); epsParam.setValue(SILICA_EPS); }
        relaxRadiusSlider(document.getElementById('r-slider') as HTMLInputElement);
        rParam.setValue(p.layers[1].r);
        for (let i = 2; i < p.layers.length; i++) {
          const h = createShellSection(p.layers[i].r);
          setSelectValue(h.material, p.layers[i].mat);
          if (p.layers[i].mat === 'custom') { relaxStepSlider(h.el.querySelector('.sh-eps-slider') as HTMLInputElement); h.epsParam.setValue(SILICA_EPS); }
          relaxRadiusSlider(h.el.querySelector('.sh-r-slider') as HTMLInputElement);
          h.rParam.setValue(p.layers[i].r);
        }
      }
      viewTabs.select('thermal');
      updateExcitationUI();
      thermalLayerSig = '';   // force the per-layer panel to rebuild for the new stack
      resetAndUpdate();       // schedules rAF: recompute σabs sweep + rebuild layers w/ defaults
    } finally {
      radiusOrderNormalizing = false;
    }
    // The rebuild happens in a deferred rAF; override the heat-transport values after it.
    requestAnimationFrame(() => {
      applyThermalLayerParams(p.metal);
      render();
      applyingThermalPreset = false;
    });
  }

