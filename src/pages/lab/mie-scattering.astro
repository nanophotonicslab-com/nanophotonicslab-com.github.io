<script>
  import { MATERIALS, interpolateNK, nkToEpsilon } from '../../lib/materials';
  import { loadCatalog, fetchMaterialNK, searchCatalog, type RIIMaterial } from '../../data/refractiveindex';
  import { computeElectronSphereSpectrum, type ElectronSpectrum } from '../../lib/electron-sphere';
  import {
    computeMie, computeMieMultiShell, computeSphereCoeffs, computeShellCoeffsAtLambda,
    computeAngularPattern, computeNearField, csin, ccos, cdivN, cmul, cdiv, HC_EV_NM,
    type MieSpectrum as MieResult, type SphereCoeffs as MieCoeffs, type ShellLayer,
    type AngularPattern, type NearFieldResult,
  } from '../../lib/mie';
  import { decayRatesAt } from '../../lib/dipole-decay';
  import { insideDecay } from '../../lib/dipole-inside';
  import { spectrumToHex } from '../../lib/colorimetry';
  import { chartTheme, onThemeChange } from '../../lib/chart-theme';

  // === File-based optical constants ===

  /**
   * Parse a CSV/TSV file with columns: wavelength, n, k
   * Auto-detects: delimiter (comma/tab/space), wavelength unit (μm if max < 50, else nm).
   * Returns data in the same format as MATERIALS[x].data: [[λ_μm, n, k], ...]
   */
  function parseNKFile(text: string): { data: number[][]; unit: string } | { error: string } {
    const lines = text.split(/\r?\n/).map(l => l.trim()).filter(l => l && !l.startsWith('#') && !l.startsWith('%'));
    if (lines.length < 2) return { error: 'File must have at least 2 data rows' };

    // Detect delimiter: try tab, comma, then whitespace
    let delim = /\t/;
    if (lines[0].split(delim).length < 3) delim = /,/;
    if (lines[0].split(delim).length < 3) delim = /\s+/;

    // Skip header row if first field is not a number
    let startIdx = 0;
    if (isNaN(parseFloat(lines[0].split(delim)[0]))) startIdx = 1;

    const data: number[][] = [];
    for (let i = startIdx; i < lines.length; i++) {
      const parts = lines[i].split(delim).map(Number);
      if (parts.length < 2 || isNaN(parts[0]) || isNaN(parts[1])) continue;
      const lam = parts[0];
      const n = parts[1];
      const k = parts.length >= 3 && !isNaN(parts[2]) ? Math.abs(parts[2]) : 0;
      data.push([lam, n, k]);
    }
    if (data.length < 2) return { error: 'Could not parse at least 2 data rows' };

    // Sort by wavelength
    data.sort((a, b) => a[0] - b[0]);

    // Auto-detect unit: if max wavelength < 50, assume μm; else nm → convert to μm
    const maxLam = data[data.length - 1][0];
    let unit = 'μm';
    if (maxLam > 50) {
      unit = 'nm';
      for (const row of data) row[0] /= 1000;
    }
    return { data, unit };
  }

  type ImportAxisMode = 'wavelength-nm' | 'wavelength-um' | 'energy-ev';
  type ImportValueMode = 'nk' | 'epsilon';
  type RawOpticalRow = [number, number, number];
  interface ParsedOpticalFile { rows: RawOpticalRow[]; skipped: number; }
  interface ConvertedOpticalFile { data: number[][]; lambdaMinNm: number; lambdaMaxNm: number; nMin: number; nMax: number; kMin: number; kMax: number; }

  function parseOpticalFile(text: string): ParsedOpticalFile | { error: string } {
    const lines = text.split(/\r?\n/).map(l => l.trim()).filter(l => l && !l.startsWith('#') && !l.startsWith('%'));
    if (lines.length < 2) return { error: 'File must have at least 2 data rows' };
    let delim = /\t/;
    if (lines[0].split(delim).length < 3) delim = /,/;
    if (lines[0].split(delim).length < 3) delim = /\s+/;
    let startIdx = 0;
    if (isNaN(parseFloat(lines[0].split(delim)[0]))) startIdx = 1;

    const rows: RawOpticalRow[] = [];
    let skipped = 0;
    for (let i = startIdx; i < lines.length; i++) {
      const parts = lines[i].split(delim).map(Number);
      if (parts.length < 3 || !Number.isFinite(parts[0]) || !Number.isFinite(parts[1]) || !Number.isFinite(parts[2])) {
        skipped++;
        continue;
      }
      rows.push([parts[0], parts[1], parts[2]]);
    }
    if (rows.length < 2) return { error: 'Could not parse at least 2 data rows with 3 numeric columns' };
    return { rows, skipped };
  }

  function epsilonToNK(epsRe: number, epsIm: number): [number, number] {
    const epsAbs = Math.hypot(epsRe, epsIm);
    const n = Math.sqrt(Math.max(0, (epsAbs + epsRe) / 2));
    const k = Math.sqrt(Math.max(0, (epsAbs - epsRe) / 2));
    return [n, Math.abs(k)];
  }

  interface DrudeHandle {
    group: HTMLElement;
    epsB: HTMLInputElement;
    wp: HTMLInputElement;
    gamma: HTMLInputElement;
  }

  function clampFinite(value: number, min: number, max: number, fallback: number): number {
    if (!Number.isFinite(value)) return fallback;
    return Math.min(max, Math.max(min, value));
  }

  function readDrude(handle: DrudeHandle): { epsB: number; wp: number; gamma: number } {
    return {
      epsB: clampFinite(parseFloat(handle.epsB.value), -100, 100, 1),
      wp: clampFinite(parseFloat(handle.wp.value), 0.01, 50, 5),
      gamma: clampFinite(parseFloat(handle.gamma.value), 0, 10, 0.05),
    };
  }

  function setDrude(handle: DrudeHandle, epsB = 1, wp = 5, gamma = 0.05): void {
    handle.epsB.value = epsB.toString();
    handle.wp.value = wp.toString();
    handle.gamma.value = gamma.toString();
  }

  function drudeNK(lambdaNm: number, handle: DrudeHandle): [number, number] {
    const { epsB, wp, gamma } = readDrude(handle);
    const energyEv = HC_EV_NM / lambdaNm;
    const denomRe = energyEv * energyEv;
    const denomIm = energyEv * gamma;
    const denomAbs2 = denomRe * denomRe + denomIm * denomIm;
    const wp2 = wp * wp;
    const termRe = wp2 * denomRe / denomAbs2;
    const termIm = -wp2 * denomIm / denomAbs2;
    return epsilonToNK(epsB - termRe, -termIm);
  }

  function drudeRef(_: DrudeHandle): string {
    return '';
  }

  function convertOpticalRows(rows: RawOpticalRow[], axisMode: ImportAxisMode, valueMode: ImportValueMode): ConvertedOpticalFile | { error: string } {
    const data: number[][] = [];
    let nMin = Infinity, nMax = -Infinity, kMin = Infinity, kMax = -Infinity;
    for (const [x, a, b] of rows) {
      let lambdaUm: number;
      if (axisMode === 'energy-ev') {
        if (x <= 0) continue;
        lambdaUm = HC_EV_NM / x / 1000;
      } else if (axisMode === 'wavelength-nm') {
        if (x <= 0) continue;
        lambdaUm = x / 1000;
      } else {
        if (x <= 0) continue;
        lambdaUm = x;
      }
      const [n, k] = valueMode === 'epsilon' ? epsilonToNK(a, b) : [a, Math.abs(b)];
      if (!Number.isFinite(lambdaUm) || !Number.isFinite(n) || !Number.isFinite(k) || n < 0) continue;
      data.push([lambdaUm, n, k]);
      nMin = Math.min(nMin, n); nMax = Math.max(nMax, n);
      kMin = Math.min(kMin, k); kMax = Math.max(kMax, k);
    }
    if (data.length < 2) return { error: 'The selected settings do not produce at least 2 valid optical rows' };
    data.sort((a, b) => a[0] - b[0]);
    return {
      data,
      lambdaMinNm: data[0][0] * 1000,
      lambdaMaxNm: data[data.length - 1][0] * 1000,
      nMin, nMax, kMin, kMax,
    };
  }

  function inferImportModes(rows: RawOpticalRow[]): { axis: ImportAxisMode; values: ImportValueMode } {
    const xs = rows.map(r => r[0]).filter(Number.isFinite);
    const ys = rows.flatMap(r => [r[1], r[2]]).filter(Number.isFinite);
    const xMax = Math.max(...xs);
    const yMaxAbs = Math.max(...ys.map(Math.abs));
    const hasNegativeReal = rows.some(r => r[1] < 0);
    const values: ImportValueMode = hasNegativeReal || yMaxAbs > 25 ? 'epsilon' : 'nk';
    let axis: ImportAxisMode = 'wavelength-um';
    if (xMax > 50) axis = 'wavelength-nm';
    else if (values === 'epsilon' || xMax > 8) axis = 'energy-ev';
    return { axis, values };
  }

  function formatCompact(v: number): string {
    if (!Number.isFinite(v)) return '';
    const av = Math.abs(v);
    if (av >= 1000 || (av > 0 && av < 0.01)) return v.toExponential(3);
    return v.toPrecision(5);
  }

  function sampleRows<T>(rows: T[], maxRows: number): T[] {
    if (rows.length <= maxRows) return rows.slice();
    const sampled: T[] = [];
    for (let i = 0; i < maxRows; i++) sampled.push(rows[Math.round(i * (rows.length - 1) / (maxRows - 1))]);
    return sampled;
  }

  function previewSeries(rows: RawOpticalRow[], axisMode: ImportAxisMode, valueMode: ImportValueMode): { xArr: Float64Array; series: PlotSeries[]; xLabel: string; yLabel: string; yRange: [number, number] } | null {
    const parsed = rows
      .map(([x, a, b]) => Number.isFinite(x) && Number.isFinite(a) && Number.isFinite(b) ? { x, a, b } : null)
      .filter((r): r is { x: number; a: number; b: number } => !!r)
      .sort((a, b) => a.x - b.x);
    if (parsed.length < 2) return null;
    const sampled = sampleRows(parsed, 320);
    const xArr = new Float64Array(sampled.length);
    const y1 = new Float64Array(sampled.length);
    const y2 = new Float64Array(sampled.length);
    for (let i = 0; i < sampled.length; i++) {
      xArr[i] = sampled[i].x;
      y1[i] = sampled[i].a;
      y2[i] = valueMode === 'epsilon' ? sampled[i].b : Math.abs(sampled[i].b);
    }
    const series = valueMode === 'epsilon'
      ? [{ y: y1, color: '#6366F1', label: 'Re \u03B5' }, { y: y2, color: '#F59E0B', label: 'Im \u03B5' }]
      : [{ y: y1, color: '#6366F1', label: 'n' }, { y: y2, color: '#F59E0B', label: 'k' }];
    const xLabel = axisMode === 'energy-ev' ? 'Photon energy (eV)' : axisMode === 'wavelength-nm' ? 'Wavelength (nm)' : 'Wavelength (\u03BCm)';
    const yLabel = valueMode === 'epsilon' ? 'Dielectric function' : 'Refractive index';
    return { xArr, series, xLabel, yLabel, yRange: seriesRange(series) };
  }

  // Uploaded material data storage (main + core)
  let uploadedMaterial: number[][] | null = null;
  let uploadedCoreMaterial: number[][] | null = null;

  // === Mie Engine: see src/lib/mie.ts (computeMie & friends imported above) ===

  const ELECTRON_AU_EV = 27.2113834;
  const ELECTRON_C_AU = 137.03599971;
  const ELECTRON_DEFAULT_RADIUS_NM = 50;
  const ELECTRON_DEFAULT_IMPACT_NM = 60;
  const ELECTRON_DEFAULT_KINETIC_KEV = 30;
  const NUM_POINTS = 500;
  const MAX_SHELLS = 5;

  function betaToKineticKeV(beta: number): number {
    const b = clampFinite(beta, 1e-6, 0.999999, 0.33);
    return ELECTRON_AU_EV * ELECTRON_C_AU * ELECTRON_C_AU * (1 / Math.sqrt(1 - b * b) - 1) / 1000;
  }

  function kineticKeVToBeta(kineticKeV: number): number {
    const kineticEv = Math.max(0, kineticKeV * 1000);
    const gamma = kineticEv / (ELECTRON_AU_EV * ELECTRON_C_AU * ELECTRON_C_AU) + 1;
    return Math.sqrt(Math.max(0, 1 - 1 / (gamma * gamma)));
  }

  function formatKineticKeV(value: number): string {
    if (!Number.isFinite(value)) return '';
    if (value < 1) return value.toFixed(3);
    if (value < 100) return value.toFixed(2);
    return value.toFixed(1);
  }

  // === Chart Renderer ===

  const PAD = { top: 20, right: 25, bottom: 55, left: 70 };
  function niceNum(range: number, round: boolean): number {
    if (range <= 0) return 1;
    const exp = Math.floor(Math.log10(range));
    const frac = range / Math.pow(10, exp);
    let nice: number;
    if (round) { nice = frac < 1.5 ? 1 : frac < 3 ? 2 : frac < 7 ? 5 : 10; }
    else { nice = frac <= 1 ? 1 : frac <= 2 ? 2 : frac <= 5 ? 5 : 10; }
    return nice * Math.pow(10, exp);
  }
  function niceScale(min: number, max: number, ticks = 7) {
    if (max - min < 1e-10) max = min + 1;
    const range = niceNum(max - min, false);
    const step = niceNum(range / (ticks - 1), true);
    return { min: Math.floor(min / step) * step, max: Math.ceil(max / step) * step, step };
  }
  function fmtTick(v: number): string {
    if (v === 0) return '0';
    const a = Math.abs(v);
    if (a >= 1e6) return (v / 1e6).toFixed(0) + 'M';
    if (a >= 5000) return (v / 1e3).toFixed(0) + 'k';
    if (Number.isInteger(v)) return v.toString();
    if (a >= 1) return v.toFixed(1);
    return v.toFixed(2);
  }
  function fmtVal(v: number): string {
    const a = Math.abs(v);
    if (a === 0) return '0';
    if (a >= 1e5) return v.toLocaleString('en', { maximumFractionDigits: 0 });
    if (a >= 1) return v.toLocaleString('en', { maximumFractionDigits: 2 });
    if (a >= 0.01) return v.toFixed(4);
    return v.toExponential(2);
  }

  interface PlotSeries { y: Float64Array; color: string; label: string; dash?: number[]; hidden?: boolean; }
  interface ChartOpts { xRange?: [number, number]; yRange?: [number, number]; logY?: boolean; fontScale?: number; bands?: { x0: number; x1: number; color: string; label?: string }[]; }
  interface ChartLegendItem { x: number; y: number; w: number; h: number; label: string; }
  interface ChartRect { x: number; y: number; w: number; h: number; }
  interface ChartXforms { tx: (v: number) => number; ty: (v: number) => number; invTx: (px: number) => number; invTy: (py: number) => number; pL: number; pT: number; pW: number; pH: number; legendItems: ChartLegendItem[]; legendBox: ChartRect | null; }
  /**
   * Fixed slices assumed a six-digit hex, but `--bg` is `#FFF` in the light
   * theme, which gave `rgba(255,15,NaN,a)`. Canvas ignores an invalid fillStyle
   * without raising, silently keeping whatever colour was set before it, so the
   * chart legend was painted in the previous (dark) fill and its labels — drawn
   * in `--text` — became dark on dark. Only the light theme was affected, since
   * `--bg` is six digits in the dark one, which is why it read as the legend
   * being stuck in night mode. Expand the shorthand, as cylinder.astro does.
   */
  function hexToRgba(hex: string, a: number): string {
    const c = hex.replace('#', '').trim();
    const full = c.length === 3 ? c.split('').map(ch => ch + ch).join('') : c;
    const n = parseInt(full, 16);
    if (full.length !== 6 || !Number.isFinite(n)) return `rgba(0,0,0,${a})`;
    return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
  }

  function drawChart(canvas: HTMLCanvasElement, xArr: Float64Array, series: PlotSeries[], xLabel: string, yLabel: string, opts: ChartOpts = {}): ChartXforms {
    const ct = chartTheme();
    const visibleSeries = series.filter(s => !s.hidden);
    const legendItems: ChartLegendItem[] = [];
    let legendBox: ChartRect | null = null;
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr; canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!; ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height, pw = W - PAD.left - PAD.right, ph = H - PAD.top - PAD.bottom;
    ctx.fillStyle = ct.bg; ctx.fillRect(0, 0, W, H);
    let dxMin = xArr[0], dxMax = xArr[0], dyMin = Infinity, dyMax = 0;
    for (let i = 0; i < xArr.length; i++) { if (xArr[i] < dxMin) dxMin = xArr[i]; if (xArr[i] > dxMax) dxMax = xArr[i]; }
    for (const s of visibleSeries) for (let i = 0; i < s.y.length; i++) { if (s.y[i] > dyMax) dyMax = s.y[i]; if (s.y[i] > 0 && s.y[i] < dyMin) dyMin = s.y[i]; }
    if (dyMin === Infinity) dyMin = 1;
    const xMin = opts.xRange ? opts.xRange[0] : dxMin, xMax = opts.xRange ? opts.xRange[1] : dxMax;
    const xs = niceScale(xMin, xMax);
    const tx = (v: number) => PAD.left + ((v - xs.min) / (xs.max - xs.min)) * pw;
    const invTx = (px: number) => xs.min + ((px - PAD.left) / pw) * (xs.max - xs.min);
    let ty: (v: number) => number, invTy: (py: number) => number, yTicks: number[], yTickLabeler: (v: number) => boolean;
    if (opts.logY && dyMax > 0) {
      const lf = Math.floor(Math.log10(Math.max(opts.yRange ? opts.yRange[0] : dyMin * 0.5, 1e-10)));
      const lc = Math.ceil(Math.log10(opts.yRange ? opts.yRange[1] : dyMax * 1.5));
      ty = v => { const l = Math.log10(Math.max(v, 1e-10)); return PAD.top + ph - ((l - lf) / (lc - lf)) * ph; };
      invTy = py => Math.pow(10, lf + ((PAD.top + ph - py) / ph) * (lc - lf));
      yTicks = []; for (let p = lf; p <= lc; p++) for (const m of [1, 2, 5]) yTicks.push(Math.pow(10, p) * m);
      yTickLabeler = v => { const l = Math.log10(v); return Math.abs(l - Math.round(l)) < 0.01; };
    } else {
      const ys = opts.yRange ? niceScale(opts.yRange[0], opts.yRange[1]) : niceScale(0, dyMax * 1.05);
      ty = v => PAD.top + ph - ((v - ys.min) / (ys.max - ys.min)) * ph;
      invTy = py => ys.min + ((PAD.top + ph - py) / ph) * (ys.max - ys.min);
      yTicks = []; for (let v = ys.min; v <= ys.max + ys.step * 0.1; v += ys.step) yTicks.push(v);
      yTickLabeler = () => true;
    }
    const xTicks: number[] = []; for (let v = xs.min; v <= xs.max + xs.step * 0.1; v += xs.step) xTicks.push(v);
    ctx.strokeStyle = hexToRgba(ct.grid, 0.5); ctx.lineWidth = 1;
    for (const v of yTicks) { const y = Math.round(ty(v)) + 0.5; if (y < PAD.top || y > PAD.top + ph) continue; ctx.beginPath(); ctx.moveTo(PAD.left, y); ctx.lineTo(PAD.left + pw, y); ctx.stroke(); }
    for (const v of xTicks) { const x = Math.round(tx(v)) + 0.5; ctx.beginPath(); ctx.moveTo(x, PAD.top); ctx.lineTo(x, PAD.top + ph); ctx.stroke(); }
    ctx.strokeStyle = ct.grid; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(PAD.left, PAD.top); ctx.lineTo(PAD.left, PAD.top + ph); ctx.lineTo(PAD.left + pw, PAD.top + ph); ctx.stroke();
    const fs = opts.fontScale || 1;
    ctx.fillStyle = ct.textSoft; ctx.font = `${Math.round(11 * fs)}px Inter, system-ui, sans-serif`;
    ctx.textAlign = 'center'; ctx.textBaseline = 'top'; for (const v of xTicks) ctx.fillText(fmtTick(v), tx(v), PAD.top + ph + 6 * fs);
    ctx.textBaseline = 'middle';
    const baseFont = `${Math.round(11 * fs)}px Inter, system-ui, sans-serif`, expFont = `${Math.round(8 * fs)}px Inter, system-ui, sans-serif`;
    for (const v of yTicks) {
      const y = ty(v); if (y < PAD.top - 5 || y > PAD.top + ph + 5 || !yTickLabeler(v)) continue;
      if (opts.logY) {
        // powers of ten: "10" with a raised exponent, right-aligned at PAD.left − 8·fs
        const exp = String(Math.round(Math.log10(v)));
        ctx.font = baseFont; const baseW = ctx.measureText('10').width;
        ctx.font = expFont; const expW = ctx.measureText(exp).width;
        const x0 = PAD.left - 8 * fs - baseW - expW;
        ctx.textAlign = 'left';
        ctx.font = baseFont; ctx.fillText('10', x0, y);
        ctx.font = expFont; ctx.fillText(exp, x0 + baseW, y - Math.round(4 * fs));
      } else {
        ctx.font = baseFont; ctx.textAlign = 'right'; ctx.fillText(fmtTick(v), PAD.left - 8 * fs, y);
      }
    }
    ctx.fillStyle = ct.text; ctx.font = `${Math.round(14 * fs)}px Inter, system-ui, sans-serif`; ctx.textAlign = 'center'; ctx.textBaseline = 'top'; ctx.fillText(xLabel, PAD.left + pw / 2, H - 16 * fs);
    ctx.save(); ctx.translate(14 * fs, PAD.top + ph / 2); ctx.rotate(-Math.PI / 2); ctx.textAlign = 'center'; ctx.textBaseline = 'top'; ctx.fillText(yLabel, 0, 0); ctx.restore();
    ctx.save(); ctx.beginPath(); ctx.rect(PAD.left, PAD.top, pw, ph); ctx.clip();
    if (opts.bands) {
      for (const band of opts.bands) {
        const bx0 = tx(band.x0), bx1 = tx(band.x1);
        ctx.fillStyle = band.color;
        ctx.fillRect(bx0, PAD.top, bx1 - bx0, ph);
        if (band.label) {
          ctx.fillStyle = ct.textMuted; ctx.font = `${Math.round(10 * fs)}px Inter, system-ui, sans-serif`;
          ctx.textAlign = 'center'; ctx.textBaseline = 'top';
          ctx.fillText(band.label, (bx0 + bx1) / 2, PAD.top + 4);
        }
      }
    }
    // clamp pixel Y to a bounded band around the plot — points far off-screen (e.g. dipole
    // near-surface totals diverging to ~1e4 inside a [0,2] window) map to coordinates millions
    // of px away, which makes the canvas rasterizer crawl. Clipped by the plot rect anyway.
    const cty = (v: number) => { const p = ty(v); return p < PAD.top - 4 * ph ? PAD.top - 4 * ph : (p > PAD.top + 5 * ph ? PAD.top + 5 * ph : p); };
    if (visibleSeries.length === 1) {
      const fillSeries = visibleSeries[0];
      ctx.beginPath(); let first = true;
      for (let i = 0; i < xArr.length; i++) { const v = fillSeries.y[i]; if (opts.logY && v <= 0) continue; const px = tx(xArr[i]), py = cty(v); if (first) { ctx.moveTo(px, py); first = false; } else ctx.lineTo(px, py); }
      if (!first) { ctx.lineTo(tx(xArr[xArr.length - 1]), PAD.top + ph); ctx.lineTo(tx(xArr[0]), PAD.top + ph); ctx.closePath(); const g = ctx.createLinearGradient(0, PAD.top, 0, PAD.top + ph); g.addColorStop(0, hexToRgba(fillSeries.color, 0.10)); g.addColorStop(1, hexToRgba(fillSeries.color, 0.00)); ctx.fillStyle = g; ctx.fill(); }
    }
    for (const s of visibleSeries) {
      ctx.beginPath(); let first = true;
      for (let i = 0; i < xArr.length; i++) { const v = s.y[i]; if (opts.logY && v <= 0) continue; if (!Number.isFinite(v)) { first = true; continue; } const px = tx(xArr[i]), py = cty(v); if (first) { ctx.moveTo(px, py); first = false; } else ctx.lineTo(px, py); }
      ctx.setLineDash((s.dash ?? []).map(v => v * fs));
      ctx.strokeStyle = s.color; ctx.lineWidth = 2; ctx.lineJoin = 'round'; ctx.lineCap = 'round'; ctx.stroke();
      ctx.setLineDash([]);
    }
    ctx.restore();
    if (series.length > 1) {
      ctx.font = `${Math.round(11 * fs)}px Inter, system-ui, sans-serif`; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
      const lineW = 16, gap = 6, itemH = 18 * fs;
      const labelWidths = series.map(s => ctx.measureText(s.label).width);
      const legendW = lineW + gap + Math.max(...labelWidths) + 16;
      const legendH = series.length * itemH + 8;
      const lx = PAD.left + pw - legendW - 8, ly = PAD.top + 8;
      legendBox = { x: lx, y: ly, w: legendW, h: legendH };
      ctx.fillStyle = hexToRgba(ct.bg, 0.85); ctx.strokeStyle = hexToRgba(ct.text, 0.1); ctx.lineWidth = 1;
      ctx.beginPath(); ctx.roundRect(lx, ly, legendW, legendH, 4); ctx.fill(); ctx.stroke();
      for (let si = 0; si < series.length; si++) {
        const iy = ly + 4 + (si + 0.5) * itemH;
        legendItems.push({ x: lx, y: iy - itemH / 2, w: legendW, h: itemH, label: series[si].label });
        ctx.save();
        ctx.globalAlpha = series[si].hidden ? 0.35 : 1;
        ctx.strokeStyle = series[si].color; ctx.lineWidth = 2; ctx.setLineDash((series[si].dash ?? []).map(v => v * fs));
        ctx.beginPath(); ctx.moveTo(lx + 8, iy); ctx.lineTo(lx + 8 + lineW, iy); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = ct.text; ctx.fillText(series[si].label, lx + 8 + lineW + gap, iy);
        ctx.restore();
      }
    }
    return { tx, ty, invTx, invTy, pL: PAD.left, pT: PAD.top, pW: pw, pH: ph, legendItems, legendBox };
  }

  // === Polar Chart Renderer ===

  function drawPolarChart(canvas: HTMLCanvasElement, pattern: AngularPattern, polMode: string, lambdaNm: number, opts: { fontScale?: number } = {}): void {
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr; canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!; ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    ctx.fillStyle = ct.bg; ctx.fillRect(0, 0, W, H);
    const fs = opts.fontScale || 1;

    // Choose intensity data
    let intensity: Float64Array;
    if (polMode === 'perp') intensity = pattern.iPerp;
    else if (polMode === 'par') intensity = pattern.iPar;
    else { intensity = new Float64Array(pattern.theta.length); for (let i = 0; i < intensity.length; i++) intensity[i] = (pattern.iPerp[i] + pattern.iPar[i]) / 2; }

    // Log scale bounds
    let logMin = Infinity, logMax = -Infinity;
    for (let i = 0; i < intensity.length; i++) { if (intensity[i] > 0) { const l = Math.log10(intensity[i]); if (l < logMin) logMin = l; if (l > logMax) logMax = l; } }
    if (!isFinite(logMin)) { logMin = 0; logMax = 1; }
    if (logMax - logMin < 1) { logMin = logMax - 1; }
    const lf = Math.floor(logMin), lc = Math.ceil(logMax);

    const margin = 45 * fs;
    const plotR = Math.min(W, H) / 2 - margin;
    const cx = W / 2, cy = H / 2;
    const r = (logI: number) => Math.max(0, ((logI - lf) / (lc - lf)) * plotR);

    // Concentric grid circles
    ctx.strokeStyle = hexToRgba(ct.textMuted, 0.35); ctx.lineWidth = 1;
    ctx.font = `${Math.round(9 * fs)}px Inter, system-ui, sans-serif`; ctx.fillStyle = ct.textMuted; ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (let p = lf; p <= lc; p++) {
      const rr = r(p); if (rr <= 0) continue;
      ctx.beginPath(); ctx.arc(cx, cy, rr, 0, 2 * Math.PI); ctx.stroke();
      ctx.fillText(`10${p >= 0 ? '\u2070\u00B9\u00B2\u00B3\u2074\u2075\u2076\u2077\u2078\u2079'[p] || '^' + p : '\u207B' + '\u2070\u00B9\u00B2\u00B3\u2074\u2075\u2076\u2077\u2078\u2079'[-p] || '^' + p}`, cx + rr - 6 * fs, cy - 6 * fs);
    }

    // Radial gridlines + angle labels
    ctx.strokeStyle = hexToRgba(ct.textMuted, 0.3);
    ctx.font = `${Math.round(11 * fs)}px Inter, system-ui, sans-serif`; ctx.fillStyle = ct.textSoft; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    for (let deg = 0; deg < 360; deg += 30) {
      const a = deg * Math.PI / 180;
      ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + plotR * Math.sin(a), cy - plotR * Math.cos(a)); ctx.stroke();
      if (deg <= 180) {
        const lx = cx + (plotR + 14 * fs) * Math.sin(a), ly = cy - (plotR + 14 * fs) * Math.cos(a);
        ctx.fillText(`${deg}\u00B0`, lx, ly);
        if (deg > 0 && deg < 180) ctx.fillText(`${deg}\u00B0`, cx - (plotR + 14 * fs) * Math.sin(a), ly);
      }
    }

    // Draw scattering pattern (right half + mirror)
    const color = polMode === 'perp' ? '#10B981' : polMode === 'par' ? '#EC4899' : '#6366F1';
    ctx.beginPath();
    for (let i = 0; i < pattern.theta.length; i++) {
      const I = intensity[i]; if (I <= 0) continue;
      const rr = r(Math.log10(I)), th = pattern.theta[i];
      const px = cx + rr * Math.sin(th), py = cy - rr * Math.cos(th);
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    for (let i = pattern.theta.length - 1; i >= 0; i--) {
      const I = intensity[i]; if (I <= 0) continue;
      const rr = r(Math.log10(I)), th = pattern.theta[i];
      ctx.lineTo(cx - rr * Math.sin(th), cy - rr * Math.cos(th));
    }
    ctx.closePath();
    ctx.fillStyle = hexToRgba(color, 0.08); ctx.fill();
    ctx.strokeStyle = color; ctx.lineWidth = 2; ctx.lineJoin = 'round'; ctx.stroke();

    // Labels
    ctx.fillStyle = ct.text; ctx.font = `${Math.round(13 * fs)}px Inter, system-ui, sans-serif`; ctx.textAlign = 'left'; ctx.textBaseline = 'top';
    ctx.fillText(`\u03BB = ${lambdaNm.toFixed(1)} nm`, 8, 8);
    ctx.font = `${Math.round(10 * fs)}px Inter, system-ui, sans-serif`; ctx.fillStyle = ct.textMuted;
    ctx.fillText('0\u00B0 = forward', 8, 26 * fs);
  }

  // === Near-field Heatmap ===

  const INFERNO: [number, number, number][] = [[0,0,4],[40,11,84],[101,21,110],[159,42,99],[212,72,66],[245,125,21],[250,193,39],[252,255,164]];
  function inferno(t: number): [number, number, number] {
    t = Math.max(0, Math.min(1, t));
    const s = t * (INFERNO.length - 1), i = Math.floor(s), f = s - i;
    const a = INFERNO[Math.min(i, INFERNO.length - 1)], b = INFERNO[Math.min(i + 1, INFERNO.length - 1)];
    return [a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1]), a[2] + f * (b[2] - a[2])];
  }


  function drawHeatmap(canvas: HTMLCanvasElement, nf: NearFieldResult, radiusNm: number, lambdaNm: number, opts: { fontScale?: number } = {}): void {
    const ct = chartTheme();
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr; canvas.height = rect.height * dpr;
    const ctx = canvas.getContext('2d')!; ctx.scale(dpr, dpr);
    const W = rect.width, H = rect.height;
    const fs = opts.fontScale || 1;
    // Compute plot area (square, centered) with room for axis ticks and labels.
    const plotSide = Math.min(W - 110 * fs, H - 76 * fs);
    const ox = (W - plotSide) / 2, oy = 20 * fs;
    // Log scale
    const logMin = Math.log10(Math.max(nf.minVal, 1e-6)), logMax = Math.log10(nf.maxVal);
    const logRange = logMax - logMin || 1;
    // Render pixel by pixel
    const imgData = ctx.createImageData(Math.round(plotSide * dpr), Math.round(plotSide * dpr));
    const pxW = imgData.width, pxH = imgData.height;
    for (let py = 0; py < pxH; py++) {
      const iz = Math.round(py * (nf.gridSize - 1) / (pxH - 1));
      for (let px = 0; px < pxW; px++) {
        const ix = Math.round(px * (nf.gridSize - 1) / (pxW - 1));
        const val = nf.grid[iz * nf.gridSize + ix];
        let r: number, g: number, b: number;
        if (val < 0) { r = 80; g = 80; b = 90; } // inside particle (core-shell fallback)
        else { const t = (Math.log10(Math.max(val, 1e-10)) - logMin) / logRange; [r, g, b] = inferno(t); }
        const off = (py * pxW + px) * 4;
        imgData.data[off] = r; imgData.data[off + 1] = g; imgData.data[off + 2] = b; imgData.data[off + 3] = 255;
      }
    }
    ctx.putImageData(imgData, Math.round(ox * dpr), Math.round(oy * dpr));
    // Particle boundary circle
    const scale = plotSide / (2 * nf.extent);
    const cr = radiusNm * scale, ccx = ox + plotSide / 2, ccy = oy + plotSide / 2;
    ctx.strokeStyle = 'rgba(255,255,255,0.6)'; ctx.lineWidth = 1.5; ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.arc(ccx, ccy, cr, 0, 2 * Math.PI); ctx.stroke(); ctx.setLineDash([]);
    // Colorbar
    const cbW = 12 * fs, cbH = plotSide * 0.6, cbX = ox + plotSide + 10 * fs, cbY = oy + (plotSide - cbH) / 2;
    for (let i = 0; i < cbH; i++) {
      const t = 1 - i / cbH; const [cr2, cg, cb] = inferno(t);
      ctx.fillStyle = `rgb(${cr2},${cg},${cb})`; ctx.fillRect(cbX, cbY + i, cbW, 1);
    }
    ctx.strokeStyle = ct.grid; ctx.lineWidth = 1; ctx.strokeRect(cbX, cbY, cbW, cbH);
    ctx.fillStyle = ct.text; ctx.font = `${Math.round(9 * fs)}px Inter, system-ui, sans-serif`; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    ctx.fillText(`${nf.maxVal.toFixed(1)}`, cbX + cbW + 4, cbY);
    ctx.fillText(`${nf.minVal.toFixed(2)}`, cbX + cbW + 4, cbY + cbH);
    ctx.fillText('|E|²/|E₀|²', cbX + cbW + 4, cbY + cbH / 2);
    // Labels
    ctx.fillStyle = ct.text; ctx.font = `${Math.round(13 * fs)}px Inter, system-ui, sans-serif`; ctx.textAlign = 'left'; ctx.textBaseline = 'top';
    ctx.fillText(`\u03BB = ${lambdaNm.toFixed(1)} nm`, 8, 4);
    // Tick marks
    ctx.font = `${Math.round(9 * fs)}px Inter, system-ui, sans-serif`; ctx.fillStyle = ct.textMuted; ctx.textBaseline = 'top'; ctx.textAlign = 'center';
    const ticks = [-nf.extent, -nf.extent / 2, 0, nf.extent / 2, nf.extent];
    for (const v of ticks) {
      const px2 = ox + (v + nf.extent) / (2 * nf.extent) * plotSide;
      ctx.fillText(`${v.toFixed(0)}`, px2, oy + plotSide + 7 * fs);
    }
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (const v of ticks) {
      const py2 = oy + (nf.extent - v) / (2 * nf.extent) * plotSide;
      ctx.fillText(`${v.toFixed(0)}`, ox - 8 * fs, py2);
    }
    // Axis labels
    ctx.fillStyle = ct.textSoft; ctx.font = `600 ${Math.round(12 * fs)}px Inter, system-ui, sans-serif`;
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    ctx.fillText('x (nm)', ccx, oy + plotSide + 27 * fs);
    ctx.save(); ctx.translate(ox - 38 * fs, ccy); ctx.rotate(-Math.PI / 2); ctx.fillText('z (nm)', 0, 0); ctx.restore();
  }

  // === Param + Tab helpers ===

  interface ParamHandle { readonly value: number; setValue(v: number): void; }
  function setupParam(numId: string, sliderId: string, minId: string, maxId: string, fmt: (v: number) => string, onChange: () => void): ParamHandle {
    const num = document.getElementById(numId) as HTMLInputElement, slider = document.getElementById(sliderId) as HTMLInputElement;
    const minIn = document.getElementById(minId) as HTMLInputElement, maxIn = document.getElementById(maxId) as HTMLInputElement;
    function clamp(v: number) { return Math.max(parseFloat(slider.min), Math.min(parseFloat(slider.max), v)); }
    slider.addEventListener('input', () => { num.value = fmt(parseFloat(slider.value)); onChange(); });
    num.addEventListener('change', () => { const v = clamp(parseFloat(num.value) || 0); slider.value = v.toString(); num.value = fmt(v); onChange(); });
    function fl() { const lo = parseFloat(minIn.value), hi = parseFloat(maxIn.value); if (isNaN(lo) || isNaN(hi) || lo >= hi) return; slider.min = lo.toString(); slider.max = hi.toString(); const v = clamp(parseFloat(slider.value)); slider.value = v.toString(); num.value = fmt(v); onChange(); }
    minIn.addEventListener('change', fl); maxIn.addEventListener('change', fl);
    return { get value() { return parseFloat(slider.value); }, setValue(v: number) { const c = clamp(v); slider.value = c.toString(); num.value = fmt(c); onChange(); } };
  }
  function setupParamEl(num: HTMLInputElement, slider: HTMLInputElement, minIn: HTMLInputElement, maxIn: HTMLInputElement, fmt: (v: number) => string, onChange: () => void): ParamHandle {
    function clamp(v: number) { return Math.max(parseFloat(slider.min), Math.min(parseFloat(slider.max), v)); }
    slider.addEventListener('input', () => { num.value = fmt(parseFloat(slider.value)); onChange(); });
    num.addEventListener('change', () => { const v = clamp(parseFloat(num.value) || 0); slider.value = v.toString(); num.value = fmt(v); onChange(); });
    function fl() { const lo = parseFloat(minIn.value), hi = parseFloat(maxIn.value); if (isNaN(lo) || isNaN(hi) || lo >= hi) return; slider.min = lo.toString(); slider.max = hi.toString(); const v = clamp(parseFloat(slider.value)); slider.value = v.toString(); num.value = fmt(v); onChange(); }
    minIn.addEventListener('change', fl); maxIn.addEventListener('change', fl);
    return { get value() { return parseFloat(slider.value); }, setValue(v: number) { const c = clamp(v); slider.value = c.toString(); num.value = fmt(c); onChange(); } };
  }
  function setupTabs(cId: string, attr: string, init: string, onSel: (v: string) => void) {
    const tabs = document.getElementById(cId)!.querySelectorAll<HTMLButtonElement>('.plot-tab');
    let cur = init;
    tabs.forEach(t => t.addEventListener('click', () => {
      if (t.disabled || t.getAttribute('aria-disabled') === 'true') return;
      tabs.forEach(t2 => { t2.classList.remove('active'); t2.setAttribute('aria-checked', 'false'); });
      t.classList.add('active'); t.setAttribute('aria-checked', 'true'); cur = t.dataset[attr]!; onSel(cur);
    }));
    function select(v: string, silent = false) {
      for (const t of tabs) { if (t.dataset[attr] === v) { tabs.forEach(t2 => { t2.classList.remove('active'); t2.setAttribute('aria-checked', 'false'); }); t.classList.add('active'); t.setAttribute('aria-checked', 'true'); cur = v; if (!silent) onSel(v); return; } }
    }
    return { get value() { return cur; }, select };
  }

  // === UI Setup ===

  const canvas = document.getElementById('mie-chart') as HTMLCanvasElement;
  const overlay = document.getElementById('chart-overlay') as HTMLCanvasElement;
  const tooltip = document.getElementById('chart-tooltip')!;
  const chartWrap = document.getElementById('chart-wrap')!;
  const zoomHint = document.getElementById('zoom-hint')!;
  const logToggle = document.getElementById('log-toggle')!;
  const spectrumControls = document.getElementById('spectrum-controls')!;
  const electronControls = document.getElementById('electron-controls')!;
  const materialControls = document.getElementById('material-controls')!;
  const axisOverlay = document.getElementById('axis-overlay')!;
  const angularControls = document.getElementById('angular-controls')!;
  const angularPolWrap = document.getElementById('angular-pol-wrap')!;
  const angularLambdaInput = document.getElementById('angular-lambda') as HTMLInputElement;
  const materialSelect = document.getElementById('material-select') as HTMLSelectElement;
  const epsGroup = document.getElementById('eps-group')!;
  const drudeGroup = document.getElementById('drude-group')!;
  const materialRefEl = document.getElementById('material-ref')!;
