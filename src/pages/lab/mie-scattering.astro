      <div class="layer-body">
        <div class="param">
          <div class="param-header"><label>Material</label></div>
          <select class="param-select shell-mat-sel">
            <option value="custom" selected>Custom dielectric</option>
            <option value="drude">Drude model</option>
            <option value="au">Gold (Au)</option>
            <option value="ag">Silver (Ag)</option>
            <option value="si">Silicon (Si)</option>
            <option value="al">Aluminum (Al)</option>
