  // === Chart Renderer ===

  const PAD = { top: 20, right: 25, bottom: 55, left: 70 };
  function niceNum(range: number, round: boolean): number {
    if (range <= 0) return 1;
    const exp = Math.floor(Math.log10(range));
    const frac = range / Math.pow(10, exp);
    let nice: number;
    if (round) { nice = frac < 1.5 ? 1 : frac < 3 ? 2 : frac < 7 ? 5 : 10; }
    else { nice = frac <= 1 ? 1 : frac <= 2 ? 2 : frac <= 5 ? 5 : 10; }
    return nice * Math.pow(10, exp);
  }
  function niceScale(min: number, max: number, ticks = 7) {
    if (max - min < 1e-10) max = min + 1;
    const range = niceNum(max - min, false);
    const step = niceNum(range / (ticks - 1), true);
    return { min: Math.floor(min / step) * step, max: Math.ceil(max / step) * step, step };
  }
  function fmtTick(v: number): string {
    if (v === 0) return '0';
    const a = Math.abs(v);
    if (a >= 1e6) return (v / 1e6).toFixed(0) + 'M';
    if (a >= 5000) return (v / 1e3).toFixed(0) + 'k';
    if (Number.isInteger(v)) return v.toString();
    if (a >= 1) return v.toFixed(1);
    return v.toFixed(2);
  }
  function fmtVal(v: number): string {
    const a = Math.abs(v);
    if (a === 0) return '0';
    if (a >= 1e5) return v.toLocaleString('en', { maximumFractionDigits: 0 });
    if (a >= 1) return v.toLocaleString('en', { maximumFractionDigits: 2 });
    if (a >= 0.01) return v.toFixed(4);
    return v.toExponential(2);
  }

  interface PlotSeries { y: Float64Array; color: string; label: string; }
  interface ChartOpts { xRange?: [number, number]; yRange?: [number, number]; logY?: boolean; fontScale?: number; }
  interface ChartXforms { tx: (v: number) => number; ty: (v: number) => number; invTx: (px: number) => number; invTy: (py: number) => number; pL: number; pT: number; pW: number; pH: number; }
