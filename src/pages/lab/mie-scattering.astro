<script>
import { initPermalinks } from '../../lib/permalink';
initPermalinks({
  material: 'material-select',
  r: 'r-num',
  nh: 'nh-num',
  lam_min: 'lam-min',
  lam_max: 'lam-max',
});
</script>
</Layout>

<style>  /* header is exactly one h3-line tall in every mode; the (taller) region toggle is centered
     on that line via negative vertical margins so it never pushes the "Parameters" label or the
     controls below it down — keeping the dipole layout consistent with plane-wave / electron. */
  .params-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
  .params-head h3 { margin: 0; }
  .params-head__toggle { flex: 0 0 auto; margin: -0.6rem 0; }
  .params-head__toggle .plot-tab { padding: 0.22rem 0.6rem; font-size: 0.72rem; font-weight: 700; }
  .dipole-unit-toggle { flex: 0 0 auto; }
  .dipole-unit-toggle .plot-tab { padding: 0.12rem 0.5rem; font-size: 0.7rem; font-weight: 700; }
  .dipole-yrange-row { margin-top: 0.4rem; }
  .dipole-ref-sel { font-family: var(--font); font-size: inherit; font-weight: 700; color: var(--primary); background: transparent; border: none; border-bottom: 1px dotted var(--primary-light); padding: 0 0.1rem; margin: 0 0.05rem; cursor: pointer; }
  .dipole-ref-sel:focus { outline: none; border-bottom-style: solid; }
  .excitation-param { padding-bottom: var(--space-xs); border-bottom: 1px solid var(--bg-muted); }
  .param-number:focus { border-color: var(--primary-light); }
  .radius-threshold-marker {
    position: absolute;
    left: 0;
    top: 50%;
    z-index: 2;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--red);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px rgba(239, 68, 68, 0.45);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .param-slider::-moz-range-track { height: 5px; background: var(--bg-muted); border-radius: 3px; border: none; }
  /* illumination-λ thumb in rose, matching the dashed marker in the σabs chart */
  #thermal-lambda-slider::-webkit-slider-thumb { background: var(--rose); }
  #thermal-lambda-slider::-webkit-slider-thumb:hover { box-shadow: 0 0 0 5px rgba(244,63,94,0.18); }
  #thermal-lambda-slider::-moz-range-thumb { background: var(--rose); }
  .param-limits { display: flex; align-items: center; gap: 0.25rem; }
  .param-limit {
    -moz-appearance: textfield;
    width: 3.5rem; padding: 0.1rem 0.25rem; border: 1px solid transparent; border-radius: var(--radius-sm);
    font-family: var(--font); font-size: 0.6875rem; font-variant-numeric: tabular-nums; color: var(--text-muted);
    text-align: center; background: var(--bg-soft); outline: none; transition: border-color 0.15s, color 0.15s;
  }
  .param-limit:focus { border-color: var(--primary-light); color: var(--text-soft); }
  .param-limit::-webkit-inner-spin-button, .param-limit::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  #eps-group.hidden { display: none; }
  .shell-section { display: flex; flex-direction: column; gap: 0.4rem; border-top: 1px solid var(--bg-muted); padding-top: var(--space-sm); margin-top: var(--space-xs); }
  .shell-header { display: flex; justify-content: space-between; align-items: center; }
  .shell-header label { font-size: 0.8125rem; font-weight: 600; color: var(--text-soft); text-transform: uppercase; letter-spacing: 0.04em; }
  .remove-shell-btn { padding: 0.15rem 0.45rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-full); background: var(--bg); font-family: var(--font); font-size: 0.6875rem; font-weight: 500; color: var(--text-muted); cursor: pointer; transition: all 0.15s; }
  .remove-shell-btn:hover { border-color: var(--red); color: var(--red); }
  .shell-eps-group.hidden { display: none !important; }
  .plot-tabs--sm { padding: 3px; }
  .plot-tabs--sm .plot-tab { padding: 0.45rem 0.85rem; font-size: 0.8125rem; font-weight: 600; }
  .plot-tabs--toolbar { padding: 2px; }
  .plot-tabs--toolbar .plot-tab { padding: 0.25rem 0.5rem; font-size: 0.72rem; }
  .spectrum-controls,
  .material-controls,
  .dipole-controls,
  .electron-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .dipole-orient-key { font-size: 0.68rem; color: var(--text-muted); font-weight: 600; }
  .dipole-ev-echo { margin-top: 0.35rem; font-size: 0.72rem; color: var(--text-muted); }
  .dipole-ref { font-size: 0.72rem; line-height: 1.4; color: var(--text-soft); background: var(--bg-soft); border: 1px solid var(--bg-muted); border-radius: var(--radius-sm); padding: 0.4rem 0.55rem; }
  .dipole-ref b { color: var(--text); font-weight: 700; }
  :global(.dipole-fig-btn) { font-family: var(--font); font-size: 0.72rem; font-weight: 600; padding: 0.22rem 0.55rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm); background: var(--bg); color: var(--text-soft); cursor: pointer; transition: border-color 0.15s, color 0.15s, background 0.15s; }
  :global(.dipole-fig-btn:hover) { border-color: var(--primary-light); color: var(--primary); background: var(--bg-soft); }
  :global(.dipole-fig-btn.active) { border-color: var(--primary); color: white; background: var(--primary); box-shadow: 0 1px 3px rgba(99,102,241,0.4); }
  :global(.dipole-fig-grid) { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.4rem; }
  :global(.dipole-fig-label) { font-size: 0.7rem; font-weight: 700; color: var(--text-soft); margin: 0.6rem 0 0.35rem; }
  @media (max-width: 640px) {
    .material-import-dialog__grid { grid-template-columns: 1fr; }
  }
  .notes-card h4,
  .references h4 { font-size: 0.875rem; margin-bottom: var(--space-sm); }
  .notes-card :global(li)::marker {
    color: var(--text-soft);
  }
  .notes-card :global(strong) { color: var(--text); }
  .thermal-spectrum-wrap { margin-top: var(--space-sm); padding-top: var(--space-sm); border-top: 1px solid var(--bg-muted); }
  .thermal-spectrum-title { display: block; font-size: 0.72rem; font-weight: 600; color: var(--text-muted); }
  .thermal-spectrum-header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); flex-wrap: wrap; margin-bottom: 0.25rem; }
