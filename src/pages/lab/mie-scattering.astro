  const SILICA_EPS = 2.10;   // SiO₂, n ≈ 1.45 (lossless dielectric spacer)
  const THERMAL_PRESETS: Record<string, ThermalPreset> = {
    fig2:  { label: 'Fig. 2',  tip: 'Gold sphere R = 5 nm in water (small-sphere limit)', geometry: 'sphere',    metal: 'au', layers: [{ mat: 'au', r: 5 }], lambda: 522, lamMin: 400, lamMax: 750 },
    fig4a: { label: 'Fig. 4a', tip: 'Au nano-oven N=1 @ 690 nm — SiO₂(23)/Au(28)',        geometry: 'coreshell', metal: 'au', layers: [{ mat: 'custom', r: 23 }, { mat: 'au', r: 28 }], lambda: 690, lamMin: 450, lamMax: 950 },
    fig4b: { label: 'Fig. 4b', tip: 'Au nano-oven N=2 @ 690 nm — SiO₂/Au ×2',             geometry: 'coreshell', metal: 'au', layers: [{ mat: 'custom', r: 10 }, { mat: 'au', r: 13 }, { mat: 'custom', r: 36 }, { mat: 'au', r: 48 }], lambda: 690, lamMin: 450, lamMax: 950 },
    fig4c: { label: 'Fig. 4c', tip: 'Au nano-oven N=3 @ 690 nm — SiO₂/Au ×3',             geometry: 'coreshell', metal: 'au', layers: [{ mat: 'custom', r: 4 }, { mat: 'au', r: 7 }, { mat: 'custom', r: 10 }, { mat: 'au', r: 16 }, { mat: 'custom', r: 34 }, { mat: 'au', r: 42 }], lambda: 690, lamMin: 450, lamMax: 950 },
    fig4d: { label: 'Fig. 4d', tip: 'Al nano-oven N=1 @ 300 nm — SiO₂(13)/Al(17)',        geometry: 'coreshell', metal: 'al', layers: [{ mat: 'custom', r: 13 }, { mat: 'al', r: 17 }], lambda: 300, lamMin: 250, lamMax: 500 },
    fig4e: { label: 'Fig. 4e', tip: 'Al nano-oven N=2 @ 300 nm — SiO₂/Al ×2',             geometry: 'coreshell', metal: 'al', layers: [{ mat: 'custom', r: 8 }, { mat: 'al', r: 11 }, { mat: 'custom', r: 35 }, { mat: 'al', r: 41 }], lambda: 300, lamMin: 250, lamMax: 500 },
    fig4f: { label: 'Fig. 4f', tip: 'Al nano-oven N=3 @ 300 nm — SiO₂/Al ×3',             geometry: 'coreshell', metal: 'al', layers: [{ mat: 'custom', r: 7 }, { mat: 'al', r: 10 }, { mat: 'custom', r: 18 }, { mat: 'al', r: 21 }, { mat: 'custom', r: 42 }, { mat: 'al', r: 49 }], lambda: 300, lamMin: 250, lamMax: 500 },
  };

  function setSelectValue(sel: HTMLSelectElement, val: string) {
    sel.value = val;
    sel.dispatchEvent(new Event('change'));
  }
  function relaxRadiusSlider(slider: HTMLInputElement | null) {
    if (slider) { slider.min = '1'; slider.step = '1'; if (parseFloat(slider.max) < 520) slider.max = '520'; }
  }
  function relaxStepSlider(slider: HTMLInputElement | null) {   // allow fine values (e.g. SiO₂ ε = 2.10)
    if (slider) slider.step = '0.01';
  }
  function setTLInput(i: number, key: string, val: number) {
    const el = thermalLayersEl.querySelector(`input[data-tl="${i}"][data-tlk="${key}"]`) as HTMLInputElement | null;
    if (el) el.value = String(val);
  }
  // Heat-transport values from the paper for the active metal/dielectric stack.
  function applyThermalLayerParams(metal: 'au' | 'al') {
    const mats = thermalLayerMaterials();   // core → outer
    const L = mats.length;
    const isMetalMat = (m: string) => m === 'au' || m === 'al' || m === 'ag' || m === 'drude';
    const gMetal = metal === 'al' ? 30 : 3;          // ×10¹⁶ W/m³K  (Au 3e16, Al 3e17)
    const kMetal = metal === 'al' ? 237 : 314;       // W/mK (κ_metal ≫ ⇒ isothermal)
    const Gwater = metal === 'al' ? 753 : 105;       // MW/m²K  metal/water (outer interface)
    const Gsilica = metal === 'al' ? 750 : 141.5;    // MW/m²K  metal/SiO₂ lattice TBC (inner)
    for (let i = 0; i < L; i++) {
      const met = isMetalMat(mats[i]);
      setTLInput(i, 'kappa', met ? kMetal : 1.0);    // SiO₂ κ = 1.0
      setTLInput(i, 'g', met ? gMetal : 0);
      setTLInput(i, 'G', i === L - 1 ? Gwater : Gsilica);
    }
  }

  function applyThermalPreset(key: string) {
    const p = THERMAL_PRESETS[key];
    if (!p) return;
    activeThermalPreset = key;        // highlight this figure button
    applyingThermalPreset = true;     // keep it highlighted through the internal re-renders
    radiusOrderNormalizing = true;   // honour the paper's sub-5-nm shells / small gaps
    try {
      // environment: water, 300 K (= 26.85 °C), I₀ = 2 GW/m²
      nhParam.setValue(1.33);
      thermalKappaMed.value = '0.6';
      thermalT0Input.value = '26.85';
      thermalI0Num.value = '2'; thermalI0Slider.value = '2';
      thermalRmax.value = '';   // reset plotting range to this geometry's default
      // σabs sweep + illumination wavelength
      lamMinInput.value = String(p.lamMin); lamMaxInput.value = String(p.lamMax);
      thermalRangeMin.value = String(p.lamMin); thermalRangeMax.value = String(p.lamMax);
      thermalLambdaSlider.min = String(p.lamMin); thermalLambdaSlider.max = String(p.lamMax); thermalLambdaSlider.step = '1';
      thermalLambdaSlider.value = String(p.lambda); thermalLambdaNum.value = String(p.lambda);
      // geometry + materials
      while (extraShells.length > 0) removeShellSection(extraShells[0]);
      if (p.geometry === 'sphere') {
