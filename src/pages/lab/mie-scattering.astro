                <button class="plot-tab" data-material-prop="nk" role="radio" aria-checked="false">n, k</button>
              </div>
            </div>
            <span id="zoom-hint" class="chart-hint">Zoomed &mdash; double-click to reset</span>
            <span id="angular-controls" class="angular-controls" style="display:none">
