    }
    if (visibleSeries.length === 1) {
      const fillSeries = visibleSeries[0];
      ctx.beginPath(); let first = true;
      for (let i = 0; i < xArr.length; i++) { const v = fillSeries.y[i]; if (opts.logY && v <= 0) continue; const px = tx(xArr[i]), py = ty(v); if (first) { ctx.moveTo(px, py); first = false; } else ctx.lineTo(px, py); }
