    dipoleDistRef = dipoleRefSel.value as 'centre' | 'surface';
    if (Number.isFinite(daMin) && Number.isFinite(daMax)) {
      const a = dipoleDaCToEntry(daMin, R), b = dipoleDaCToEntry(daMax, R);
      const dp = dipoleDistUnit === 'abs' ? 1 : 2;
      dipoleDMinInput.value = Math.min(a, b).toFixed(dp); dipoleDMaxInput.value = Math.max(a, b).toFixed(dp);
