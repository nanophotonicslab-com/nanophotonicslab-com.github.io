                  <button class="plot-tab active" data-dchannel="total" role="radio" aria-checked="true">Total</button>
                  <button class="plot-tab" data-dchannel="rad" role="radio" aria-checked="false">Radiative</button>
                  <button class="plot-tab" data-dchannel="nr" role="radio" aria-checked="false">Non-rad.</button>
                  <button class="plot-tab" data-dchannel="all" role="radio" aria-checked="false">All</button>
