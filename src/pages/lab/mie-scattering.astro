  function getDielectric(lambdaNm: number): [number, number] {
    const mat = materialSelect.value;
    if (mat === 'custom') return [Math.sqrt(epsParam.value), 0];
    if ((mat === 'file' || mat === 'rii') && uploadedMaterial) return interpolateNK(uploadedMaterial, lambdaNm);
    if (mat === 'file' || mat === 'rii') return [1, 0];
    return interpolateNK(MATERIALS[mat].data, lambdaNm);
  }

  function getCoreDielectric(lambdaNm: number): [number, number] {
    const mat = coreMaterialSelect.value;
    if (mat === 'custom') return [Math.sqrt(coreEpsParam.value), 0];
    if ((mat === 'file' || mat === 'rii') && uploadedCoreMaterial) return interpolateNK(uploadedCoreMaterial, lambdaNm);
    if (mat === 'file' || mat === 'rii') return [1, 0];
    return interpolateNK(MATERIALS[mat].data, lambdaNm);
  }

  // Dynamic shell state
  interface ShellHandle {
    el: HTMLElement;
    material: HTMLSelectElement;
    epsParam: ParamHandle;
    epsGroup: HTMLElement;
    rParam: ParamHandle;
    refEl: HTMLElement;
    uploadedData: number[][] | null;
  }
  const extraShells: ShellHandle[] = [];

  function buildLayers(): ShellLayer[] {
    const layers: ShellLayer[] = [];
    // Core
    layers.push({ getDielectric: getCoreDielectric, radiusNm: coreRParam.value });
    // Shell 1 (always present in core-shell mode — uses main material/radius)
    const outerR = rParam.value;
    layers.push({ getDielectric: getDielectric, radiusNm: outerR });
    // Extra dynamic shells
    for (const sh of extraShells) {
      const mat = sh.material.value;
      const eps = sh.epsParam.value;
      const fileData = sh.uploadedData;
      const getDiel = mat === 'custom'
        ? (_: number): [number, number] => [Math.sqrt(eps), 0]
        : (mat === 'file' || mat === 'rii') && fileData
          ? (lnm: number): [number, number] => interpolateNK(fileData, lnm)
          : (mat === 'file' || mat === 'rii')
            ? (_: number): [number, number] => [1, 0]
            : (lnm: number): [number, number] => interpolateNK(MATERIALS[mat].data, lnm);
      layers.push({ getDielectric: getDiel, radiusNm: sh.rParam.value });
    }
    // Sort by radius (enforce r_core < r_shell1 < r_shell2 ...)
    layers.sort((a, b) => a.radiusNm - b.radiusNm);
    return layers;
  }

  function updateShellLimit() {
    // Shell 1 is always the main material/radius; extras add on top. Max total = MAX_SHELLS.
    const total = 1 + extraShells.length;
    const atMax = total >= MAX_SHELLS;
    addShellBtn.style.display = atMax ? 'none' : '';
    shellLimitNote.style.display = atMax ? '' : 'none';
    // Renumber shell headers
    for (let i = 0; i < extraShells.length; i++) {
      const lbl = extraShells[i].el.querySelector('.shell-label')!;
      lbl.textContent = `Shell ${i + 2}`;
    }
  }

  // Astro scopes CSS with data-astro-cid-* attributes. Dynamic elements need it too.
  const _scopeAttr = Array.from(document.querySelector('.controls')!.attributes)
    .find(a => a.name.startsWith('data-astro-cid-'))?.name || '';
  function applyScope(el: Element) {
    if (!_scopeAttr) return;
    el.setAttribute(_scopeAttr, '');
    el.querySelectorAll('*').forEach(c => c.setAttribute(_scopeAttr, ''));
  }

