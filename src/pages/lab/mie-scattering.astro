      sec.querySelector('.sh-r-num') as HTMLInputElement,
      sec.querySelector('.sh-r-slider') as HTMLInputElement,
      sec.querySelector('.sh-r-min') as HTMLInputElement,
      sec.querySelector('.sh-r-max') as HTMLInputElement,
      v => v.toFixed(0), () => radiusChanged(extraShells.indexOf(handle) + 2),
    );

