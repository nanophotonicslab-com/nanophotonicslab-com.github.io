          </div>
          <input type="range" class="param-slider sh-eps-slider" min="1" max="50" step="0.5" value="10">
          <div class="param-limits">
            <input type="number" class="param-limit sh-eps-min" value="1" step="0.5" min="0.1">
            <span class="param-limit-dash">&mdash;</span>
            <input type="number" class="param-limit sh-eps-max" value="50" step="0.5" min="0.1">
          </div>
        </div>
        <div class="param">
          <div class="param-header">
            <label>Outer radius (nm)</label>
            <input type="number" class="param-number sh-r-num" value="${outerR}" step="5" min="1">
          </div>
          <input type="range" class="param-slider sh-r-slider" min="10" max="${maxOuterR}" step="5" value="${outerR}">
          <div class="param-limits">
            <input type="number" class="param-limit sh-r-min" value="10" step="5" min="1">
            <span class="param-limit-dash">&mdash;</span>
            <input type="number" class="param-limit sh-r-max" value="${maxOuterR}" step="5" min="1">
          </div>
        </div>
      </div>`;
    applyScope(sec);
    extraShellsContainer.appendChild(sec);

    const matSel = sec.querySelector('.shell-mat-sel') as HTMLSelectElement;
    const epsGrp = sec.querySelector('.shell-eps-group') as HTMLElement;
    const refEl = sec.querySelector('.shell-ref') as HTMLElement;
    const shellDrudeHandle: DrudeHandle = {
      group: sec.querySelector('.sh-drude-group') as HTMLElement,
      epsB: sec.querySelector('.sh-drude-epsb') as HTMLInputElement,
      wp: sec.querySelector('.sh-drude-wp') as HTMLInputElement,
      gamma: sec.querySelector('.sh-drude-gamma') as HTMLInputElement,
    };
    const epsP = setupParamEl(
      sec.querySelector('.sh-eps-num') as HTMLInputElement,
      sec.querySelector('.sh-eps-slider') as HTMLInputElement,
      sec.querySelector('.sh-eps-min') as HTMLInputElement,
      sec.querySelector('.sh-eps-max') as HTMLInputElement,
