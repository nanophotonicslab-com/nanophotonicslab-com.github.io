  function removeShellSection(handle: ShellHandle) {
    const idx = extraShells.indexOf(handle);
    if (idx >= 0) extraShells.splice(idx, 1);
    handle.el.remove();
    updateShellLimit();
    resetAndUpdate();
  }

  addShellBtn.addEventListener('click', () => {
    // Default outer radius: 20 nm larger than current outermost
    const lastR = extraShells.length > 0 ? extraShells[extraShells.length - 1].rParam.value : rParam.value;
    createShellSection(lastR + 20);
  });

  function electronEnergyRange(): [number, number] {
    let eMin = parseFloat(electronEminInput.value);
    let eMax = parseFloat(electronEmaxInput.value);
    eMin = clampFinite(eMin, 0.05, 50, 1.5);
    eMax = clampFinite(eMax, 0.06, 60, 5.5);
    if (eMin >= eMax) eMax = eMin + 0.1;
    return [eMin, eMax];
  }

  function recompute() {
    try {
      let lMin = parseFloat(lamMinInput.value) || 300, lMax = parseFloat(lamMaxInput.value) || 1200;
      if (lMin >= lMax) { lMin = 300; lMax = 1200; }
      const [eMin, eMax] = electronEnergyRange();
      if (excitation === 'electron') {
        lMin = HC_EV_NM / eMax;
        lMax = HC_EV_NM / eMin;
      }
      if (geometry === 'coreshell') {
        data = computeMieMultiShell(buildLayers(), nhParam.value, lMin, lMax);
      } else {
        data = computeMie(getDielectric, rParam.value, nhParam.value, lMin, lMax);
      }
      if (excitation === 'electron') {
        electronData = computeElectronSphereSpectrum(getDielectric, {
          radiusNm: rParam.value,
          beta: electronBetaParam.value,
          impactNm: electronBParam.value,
          lmax: Math.round(clampFinite(electronLmaxParam.value, 1, 14, 6)),
          qCutNm: electronQcParam.value,
          nz: Math.round(clampFinite(electronNzParam.value, 8, 160, 64)),
        }, eMin, eMax, 96);
      } else {
        electronData = null;
      }
    } catch (e) {
      console.error('Mie recompute error:', e);
      theoryNote.textContent = 'Error: ' + (e instanceof Error ? e.message : String(e));
    }
  }

  const PLOT_COLORS = {
    csca: '#6366F1', cext: '#EC4899', cabs: '#F59E0B',
    electric: '#6366F1', magnetic: '#EC4899',
    eels: '#2563EB', cl: '#D97706', surface: '#10B981', bulk: '#EC4899', begrenzung: '#8B5CF6',
    mp: ['#6366F1', '#EC4899', '#10B981', '#F59E0B'] as const,
  };
  const MP_LABELS = ['Dipole (n=1)', 'Quadrupole (n=2)', 'Octupole (n=3)', 'n \u2265 4'];

  function getPlotData(): { xArr: Float64Array; series: PlotSeries[]; xLabel: string; yLabel: string } {
    const qty = qtyTabs.value;
    const decomp = decompTabs.value;
    const isEnergy = axisTabs.value === 'energy';
    const n = data.lambda.length;

    const xLabel = isEnergy ? 'Photon energy (eV)' : 'Wavelength (nm)';
    let xArr: Float64Array;
    if (isEnergy) {
      xArr = new Float64Array(n);
      for (let i = 0; i < n; i++) xArr[i] = data.energy[n - 1 - i];
    } else { xArr = data.lambda; }

    function rev(a: Float64Array): Float64Array {
      if (!isEnergy) return a;
      const r = new Float64Array(n);
      for (let i = 0; i < n; i++) r[i] = a[n - 1 - i];
      return r;
    }

    const outerR = geometry === 'coreshell'
      ? Math.max(coreRParam.value, rParam.value, ...extraShells.map(s => s.rParam.value))
      : rParam.value;
    const geo = Math.PI * outerR * outerR;

    function qtyArrays(q: string): { total: Float64Array; e: Float64Array; m: Float64Array; mp: [Float64Array, Float64Array, Float64Array, Float64Array]; label: string; unit: string } {
      switch (q) {
        case 'cext': return { total: data.cext, e: data.cext_e, m: data.cext_m, mp: data.cext_mp, label: 'Cext', unit: '(nm\u00B2)' };
        case 'cabs': {
          const ae = new Float64Array(n), am = new Float64Array(n);
          const amp: [Float64Array, Float64Array, Float64Array, Float64Array] = [new Float64Array(n), new Float64Array(n), new Float64Array(n), new Float64Array(n)];
          for (let i = 0; i < n; i++) { ae[i] = Math.max(0, data.cext_e[i] - data.csca_e[i]); am[i] = Math.max(0, data.cext_m[i] - data.csca_m[i]); for (let k = 0; k < 4; k++) amp[k][i] = Math.max(0, data.cext_mp[k][i] - data.csca_mp[k][i]); }
          return { total: data.cabs, e: ae, m: am, mp: amp, label: 'Cabs', unit: '(nm\u00B2)' };
        }
        case 'qsca': {
          const qe = new Float64Array(n), qm = new Float64Array(n);
          const qmp: [Float64Array, Float64Array, Float64Array, Float64Array] = [new Float64Array(n), new Float64Array(n), new Float64Array(n), new Float64Array(n)];
          for (let i = 0; i < n; i++) { qe[i] = data.csca_e[i] / geo; qm[i] = data.csca_m[i] / geo; for (let k = 0; k < 4; k++) qmp[k][i] = data.csca_mp[k][i] / geo; }
          return { total: data.qsca, e: qe, m: qm, mp: qmp, label: 'Qsca', unit: '' };
        }
        default: return { total: data.csca, e: data.csca_e, m: data.csca_m, mp: data.csca_mp, label: 'Csca', unit: '(nm\u00B2)' };
      }
    }

    const series: PlotSeries[] = [];
    let yLabel: string;

    if (qty === 'all') {
      yLabel = 'Cross section (nm\u00B2)';
      for (const q of ['csca', 'cext', 'cabs'] as const) {
        const d = qtyArrays(q);
        series.push({ y: rev(d.total), color: PLOT_COLORS[q], label: d.label });
      }
    } else {
      const d = qtyArrays(qty);
      yLabel = d.unit ? `${d.label} ${d.unit}` : d.label;
      if (decomp === 'em') {
        series.push({ y: rev(d.e), color: PLOT_COLORS.electric, label: `${d.label} (E)` });
        series.push({ y: rev(d.m), color: PLOT_COLORS.magnetic, label: `${d.label} (M)` });
      } else if (decomp === 'multipole') {
        for (let k = 0; k < 4; k++) series.push({ y: rev(d.mp[k]), color: PLOT_COLORS.mp[k], label: MP_LABELS[k] });
      } else {
        series.push({ y: rev(d.total), color: PLOT_COLORS.csca, label: d.label });
      }
    }

    return { xArr, series, xLabel, yLabel };
  }

  function getElectronPlotData(): { xArr: Float64Array; series: PlotSeries[]; xLabel: string; yLabel: string } {
    if (!electronData) return { xArr: new Float64Array(0), series: [], xLabel: 'Energy loss (eV)', yLabel: 'Probability (1/eV)' };
    const signal = electronSignalTabs.value;
    const decomp = electronDecompTabs.value;
    const useLambda = axisTabs.value === 'lambda';
    const n = electronData.energy.length;
    const xArr = new Float64Array(n);
    if (useLambda) {
      for (let i = 0; i < n; i++) xArr[i] = HC_EV_NM / electronData.energy[n - 1 - i];
    } else {
      xArr.set(electronData.energy);
    }
    const orient = (a: Float64Array): Float64Array => {
      if (!useLambda) return a;
      const r = new Float64Array(n);
      for (let i = 0; i < n; i++) r[i] = a[n - 1 - i];
      return r;
    };
    const xLabel = useLambda ? 'Equivalent wavelength (nm)' : 'Energy loss (eV)';
    const series: PlotSeries[] = [];

    if (signal === 'both') {
      series.push({ y: orient(electronData.eelsTotal), color: PLOT_COLORS.eels, label: 'EELS total' });
      series.push({ y: orient(electronData.clTotal), color: PLOT_COLORS.cl, label: 'CL total' });
      return { xArr, series, xLabel, yLabel: 'Probability (1/eV)' };
    }

    if (signal === 'cl') {
      if (decomp === 'em') {
        series.push({ y: orient(electronData.clElectric), color: PLOT_COLORS.electric, label: 'CL electric' });
        series.push({ y: orient(electronData.clMagnetic), color: PLOT_COLORS.magnetic, label: 'CL magnetic' });
      } else if (decomp === 'multipole') {
        for (let i = 0; i < Math.min(4, electronData.clMultipoles.length); i++) {
          series.push({ y: orient(electronData.clMultipoles[i]), color: PLOT_COLORS.mp[i], label: MP_LABELS[i] ?? `l = ${i + 1}` });
        }
      } else {
        series.push({ y: orient(electronData.clTotal), color: PLOT_COLORS.cl, label: 'CL total' });
      }
      return { xArr, series, xLabel, yLabel: 'CL probability (1/eV)' };
    }

    if (decomp === 'terms') {
      series.push({ y: orient(electronData.eelsSurface), color: PLOT_COLORS.surface, label: 'surface' });
      series.push({ y: orient(electronData.eelsBulk), color: PLOT_COLORS.bulk, label: 'bulk' });
      series.push({ y: orient(electronData.eelsBegrenzung), color: PLOT_COLORS.begrenzung, label: 'Begrenzung' });
    } else if (decomp === 'em') {
      series.push({ y: orient(electronData.eelsElectric), color: PLOT_COLORS.electric, label: 'EELS electric' });
      series.push({ y: orient(electronData.eelsMagnetic), color: PLOT_COLORS.magnetic, label: 'EELS magnetic' });
      series.push({ y: orient(electronData.eelsBulk), color: PLOT_COLORS.bulk, label: 'bulk' });
    } else if (decomp === 'multipole') {
      for (let i = 0; i < Math.min(4, electronData.eelsMultipoles.length); i++) {
        series.push({ y: orient(electronData.eelsMultipoles[i]), color: PLOT_COLORS.mp[i], label: MP_LABELS[i] ?? `l = ${i + 1}` });
      }
      series.push({ y: orient(electronData.eelsBulk), color: PLOT_COLORS.bulk, label: 'bulk' });
    } else {
      series.push({ y: orient(electronData.eelsTotal), color: PLOT_COLORS.eels, label: 'EELS total' });
    }
    return { xArr, series, xLabel, yLabel: 'EELS probability (1/eV)' };
  }

  function seriesRange(series: PlotSeries[], zeroFloor = false): [number, number] {
    let min = Number.POSITIVE_INFINITY;
    let max = Number.NEGATIVE_INFINITY;
    for (const s of series) {
      if (s.hidden) continue;
      for (let i = 0; i < s.y.length; i++) {
        const v = s.y[i];
        if (!Number.isFinite(v)) continue;
        min = Math.min(min, v);
        max = Math.max(max, v);
      }
    }
    if (!Number.isFinite(min) || !Number.isFinite(max)) return [0, 1];
    if (zeroFloor) min = Math.min(0, min);
    if (max <= min) {
      const span = Math.max(1, Math.abs(max) * 0.1);
      min -= span;
      max += span;
    }
    const pad = (max - min) * 0.08;
    return [min - pad, max + pad];
  }

  const MATERIAL_LAYER_COLORS = ['#6366F1', '#10B981', '#F59E0B', '#EC4899', '#14B8A6', '#8B5CF6'] as const;
  const hiddenMaterialSeries = new Set<string>();
  function materialEntries(): { label: string; getDielectric: (lambdaNm: number) => [number, number] }[] {
    if (geometry !== 'coreshell') return [{ label: 'Particle', getDielectric }];
    const entries = [
      { label: 'Core', getDielectric: getCoreDielectric },
      { label: 'Shell 1', getDielectric },
    ];
    for (let i = 0; i < extraShells.length; i++) {
      const sh = extraShells[i];
      const mat = sh.material.value;
      const eps = sh.epsParam.value;
      const fileData = sh.uploadedData;
      const getDiel = mat === 'custom'
        ? (_: number): [number, number] => [Math.sqrt(eps), 0]
        : mat === 'drude'
          ? (lnm: number): [number, number] => drudeNK(lnm, sh.drudeHandle)
        : (mat === 'file' || mat === 'rii') && fileData
          ? (lnm: number): [number, number] => interpolateNK(fileData, lnm)
          : (mat === 'file' || mat === 'rii')
            ? (_: number): [number, number] => [1, 0]
            : (lnm: number): [number, number] => interpolateNK(MATERIALS[mat].data, lnm);
      entries.push({ label: `Shell ${i + 2}`, getDielectric: getDiel });
    }
    return entries;
  }

  function getMaterialPlotData(): { xArr: Float64Array; series: PlotSeries[]; xLabel: string; yLabel: string; yRange: [number, number] } {
    const n = data.lambda.length;
    const isEnergy = axisTabs.value === 'energy';
    const xArr = new Float64Array(n);
    if (isEnergy) {
      for (let i = 0; i < n; i++) xArr[i] = data.energy[n - 1 - i];
    } else {
      xArr.set(data.lambda);
    }
    const orient = (a: Float64Array): Float64Array => {
      if (!isEnergy) return a;
      const r = new Float64Array(n);
      for (let i = 0; i < n; i++) r[i] = a[n - 1 - i];
      return r;
    };

    const series: PlotSeries[] = [];
    const materialSeries = (y: Float64Array, color: string, label: string, dash?: number[]): PlotSeries => ({
      y,
      color,
      label,
      dash,
      hidden: hiddenMaterialSeries.has(label),
    });
    const entries = materialEntries();
    if (materialPropTabs.value === 'nk') {
      for (let mi = 0; mi < entries.length; mi++) {
        const color = MATERIAL_LAYER_COLORS[mi % MATERIAL_LAYER_COLORS.length];
        const nArr = new Float64Array(n);
        const kArr = new Float64Array(n);
        for (let i = 0; i < n; i++) {
          const [nr, ki] = entries[mi].getDielectric(data.lambda[i]);
          nArr[i] = nr;
          kArr[i] = ki;
        }
        series.push(materialSeries(orient(nArr), color, `${entries[mi].label} n`));
        series.push(materialSeries(orient(kArr), color, `${entries[mi].label} k`, [5, 4]));
      }
      return {
        xArr,
        series,
        xLabel: isEnergy ? 'Photon energy (eV)' : 'Wavelength (nm)',
        yLabel: 'Refractive index',
        yRange: seriesRange(series, true),
      };
    }

    for (let mi = 0; mi < entries.length; mi++) {
      const color = MATERIAL_LAYER_COLORS[mi % MATERIAL_LAYER_COLORS.length];
      const realEps = new Float64Array(n);
      const imagEps = new Float64Array(n);
      for (let i = 0; i < n; i++) {
        const [nr, ki] = entries[mi].getDielectric(data.lambda[i]);
        realEps[i] = nr * nr - ki * ki;
        imagEps[i] = 2 * nr * ki;
      }
      series.push(materialSeries(orient(realEps), color, `${entries[mi].label} Re \u03B5`));
      series.push(materialSeries(orient(imagEps), color, `${entries[mi].label} Im \u03B5`, [5, 4]));
    }
    return {
      xArr,
      series,
      xLabel: isEnergy ? 'Photon energy (eV)' : 'Wavelength (nm)',
      yLabel: 'Dielectric function',
      yRange: seriesRange(series),
    };
  }

  const swatchSca = document.getElementById('swatch-sca') as HTMLElement;
  const swatchTrans = document.getElementById('swatch-trans') as HTMLElement;

  function updateSwatches() {
    if (!data) return;
    const n = data.lambda.length;
    // Scattered color: weight by σ_sca(λ)
    const scaMax = Math.max(...data.csca);
    if (scaMax > 0) {
      const R = new Float64Array(n);
      for (let i = 0; i < n; i++) R[i] = data.csca[i] / scaMax;
      swatchSca.style.background = spectrumToHex(data.lambda, R);
    } else {
      swatchSca.style.background = '#222';
    }
    // Transmitted color: Beer-Lambert attenuation (thin slab, arbitrary optical depth)
    const extMax = Math.max(...data.cext);
    if (extMax > 0) {
      const T = new Float64Array(n);
      for (let i = 0; i < n; i++) T[i] = Math.exp(-2 * data.cext[i] / extMax);
      swatchTrans.style.background = spectrumToHex(data.lambda, T);
    } else {
      swatchTrans.style.background = '#222';
    }
  }

  function render() {
    if (!data) return;
    updateExcitationUI();
    if (viewTabs.value === 'angular') { renderAngular(); return; }
    if (viewTabs.value === 'nearfield') { renderNearField(); return; }
    if (viewTabs.value === 'thermal') { renderThermal(); return; }
    if (viewTabs.value === 'material') { renderMaterial(); return; }
    if (excitation === 'electron') { renderElectron(); return; }
    const { xArr, series, xLabel, yLabel } = getPlotData();
    currentXArr = xArr; currentSeries = series;
    const opts: ChartOpts = { logY };
    if (zoomBounds) { opts.xRange = zoomBounds.xRange; opts.yRange = zoomBounds.yRange; }
    chartXforms = drawChart(canvas, xArr, series, xLabel, yLabel, opts);
    zoomHint.classList.toggle('visible', !!zoomBounds);
    clearOverlay();
    updateSwatches();
  }

  function renderElectron() {
    if (!electronData) return;
    const { xArr, series, xLabel, yLabel } = getElectronPlotData();
    currentXArr = xArr; currentSeries = series;
    const opts: ChartOpts = { logY };
    if (!logY) opts.yRange = seriesRange(series);
    if (zoomBounds) { opts.xRange = zoomBounds.xRange; opts.yRange = zoomBounds.yRange; }
    chartXforms = drawChart(canvas, xArr, series, xLabel, yLabel, opts);
