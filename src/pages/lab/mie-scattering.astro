---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Mie Scattering Calculator" description="Interactive Mie scattering calculator for spherical nanoparticles — exact solutions in your browser.">
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Mie Scattering <span class="gradient-text">Calculator</span></h1>
      <p class="widget-hero__subtitle">
        Compute scattering, extinction, and absorption cross-sections for spherical
        nanoparticles using exact Mie theory. Adjust parameters and see results in real time.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="widget-layout">
        <div class="controls card">
          <h3>Parameters</h3>

          <!-- Geometry type -->
          <div class="param">
            <div class="param-header"><label>Geometry</label></div>
            <div class="plot-tabs" id="geo-tabs" role="radiogroup">
              <button class="plot-tab active" data-geo="sphere" role="radio" aria-checked="true">Sphere</button>
              <button class="plot-tab" data-geo="coreshell" role="radio" aria-checked="false">Core-Shell</button>
            </div>
          </div>

          <!-- Shell / particle material -->
          <div class="param">
            <div class="param-header"><label id="material-label">Material</label></div>
            <select id="material-select" class="param-select">
              <option value="custom" selected>Custom dielectric</option>
              <option value="au">Gold (Au)</option>
              <option value="ag">Silver (Ag)</option>
              <option value="si">Silicon (Si)</option>
              <option value="al">Aluminum (Al)</option>
              <option value="tio2">TiO&sub2;</option>
              <option value="file">Upload file&hellip;</option>
              <option value="rii">Search database&hellip;</option>
            </select>
            <span class="material-ref" id="material-ref"></span>
            <div class="file-upload-row" id="file-upload-group" style="display:none">
              <input type="file" id="file-upload" accept=".csv,.tsv,.txt,.dat" class="file-input">
              <span class="file-name" id="file-name"></span>
            </div>
            <div class="rii-search" id="rii-search-group" style="display:none">
              <input type="text" id="rii-search" class="param-number rii-input" placeholder="Search materials&hellip;">
              <div class="rii-results" id="rii-results"></div>
              <span class="material-ref" id="rii-status"></span>
            </div>
          </div>

          <!-- Custom epsilon for shell/particle -->
          <div class="param" id="eps-group">
            <div class="param-header">
              <label>&epsilon;<sub>r</sub></label>
              <input type="number" class="param-number" id="eps-num" value="10" step="0.5" min="1">
            </div>
            <input type="range" class="param-slider" id="eps-slider" min="1" max="50" step="0.5" value="10">
            <div class="param-limits">
              <input type="number" class="param-limit" id="eps-min" value="1" step="0.5" min="0.1">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-limit" id="eps-max" value="50" step="0.5" min="0.1">
            </div>
          </div>

          <!-- Core section (core-shell only, collapsible) -->
          <details class="layer-details cs-only" id="core-section" style="display:none" open>
            <summary>Core</summary>
            <div class="layer-body">
              <div class="param" id="core-mat-group">
                <div class="param-header"><label>Material</label></div>
                <select id="core-material-select" class="param-select">
                  <option value="au" selected>Gold (Au)</option>
                  <option value="ag">Silver (Ag)</option>
                  <option value="si">Silicon (Si)</option>
                  <option value="al">Aluminum (Al)</option>
                  <option value="tio2">TiO&sub2;</option>
                  <option value="custom">Custom dielectric</option>
                  <option value="file">Upload file&hellip;</option>
                  <option value="rii">Search database&hellip;</option>
                </select>
                <span class="material-ref" id="core-material-ref"></span>
                <div class="file-upload-row" id="core-file-upload-group" style="display:none">
                  <input type="file" id="core-file-upload" accept=".csv,.tsv,.txt,.dat" class="file-input">
                  <span class="file-name" id="core-file-name"></span>
                </div>
                <div class="rii-search" id="core-rii-search-group" style="display:none">
                  <input type="text" id="core-rii-search" class="param-number rii-input" placeholder="Search materials&hellip;">
                  <div class="rii-results" id="core-rii-results"></div>
                  <span class="material-ref" id="core-rii-status"></span>
                </div>
              </div>
              <div class="param" id="core-eps-group" style="display:none">
                <div class="param-header">
                  <label>&epsilon;<sub>r</sub></label>
                  <input type="number" class="param-number" id="core-eps-num" value="10" step="0.5" min="1">
                </div>
                <input type="range" class="param-slider" id="core-eps-slider" min="1" max="50" step="0.5" value="10">
                <div class="param-limits">
                  <input type="number" class="param-limit" id="core-eps-min" value="1" step="0.5" min="0.1">
                  <span class="param-limit-dash">&mdash;</span>
                  <input type="number" class="param-limit" id="core-eps-max" value="50" step="0.5" min="0.1">
                </div>
              </div>
              <div class="param" id="core-r-group">
                <div class="param-header">
                  <label>Radius (nm)</label>
                  <input type="number" class="param-number" id="core-r-num" value="60" step="5" min="1">
                </div>
                <input type="range" class="param-slider" id="core-r-slider" min="5" max="400" step="5" value="60">
                <div class="param-limits">
                  <input type="number" class="param-limit" id="core-r-min" value="5" step="5" min="1">
                  <span class="param-limit-dash">&mdash;</span>
                  <input type="number" class="param-limit" id="core-r-max" value="400" step="5" min="1">
                </div>
              </div>
            </div>
          </details>

          <div class="param">
            <div class="param-header">
              <label id="radius-label">Radius (nm)</label>
              <input type="number" class="param-number" id="r-num" value="100" step="5" min="1">
            </div>
            <input type="range" class="param-slider" id="r-slider" min="10" max="500" step="5" value="100">
            <div class="param-limits">
              <input type="number" class="param-limit" id="r-min" value="10" step="5" min="1">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-limit" id="r-max" value="500" step="5" min="1">
            </div>
          </div>

          <!-- Dynamic extra shells container -->
          <div id="extra-shells" class="cs-only" style="display:none"></div>

          <!-- Add shell button -->
          <div class="param cs-only" id="add-shell-wrap" style="display:none">
            <button id="add-shell-btn" class="chart-tool-btn" style="width:100%">+ Add shell</button>
            <span id="shell-limit-note" class="material-ref" style="display:none">Maximum 5 shells reached. Need more? <a href="mailto:info@nanophotonicslab.com">Contact us</a>.</span>
          </div>

          <div class="param">
            <div class="param-header">
              <label>n<sub>host</sub></label>
              <input type="number" class="param-number" id="nh-num" value="1.00" step="0.01" min="1">
            </div>
            <input type="range" class="param-slider" id="nh-slider" min="1.0" max="2.5" step="0.01" value="1.0">
            <div class="param-limits">
              <input type="number" class="param-limit" id="nh-min" value="1.0" step="0.01" min="1">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-limit" id="nh-max" value="2.5" step="0.01" min="1">
            </div>
            <div class="param-presets" id="nh-presets">
              <button class="preset-btn active" data-val="1.00">Air</button>
              <button class="preset-btn" data-val="1.33">Water</button>
              <button class="preset-btn" data-val="1.46">Oil</button>
              <button class="preset-btn" data-val="1.50">Glass</button>
            </div>
          </div>

          <div class="param">
            <div class="param-header"><label>&lambda; range (nm)</label></div>
            <div class="param-range-row">
              <input type="number" class="param-number param-number--sm" id="lam-min" value="300" step="10" min="100">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-number param-number--sm" id="lam-max" value="1200" step="10" min="100">
            </div>
          </div>

          <div class="param">
            <div class="param-header"><label>Quantity</label></div>
            <div class="plot-tabs" id="qty-tabs" role="radiogroup">
              <button class="plot-tab active" data-qty="csca" role="radio" aria-checked="true">C<sub>sca</sub></button>
              <button class="plot-tab" data-qty="cext" role="radio" aria-checked="false">C<sub>ext</sub></button>
              <button class="plot-tab" data-qty="cabs" role="radio" aria-checked="false">C<sub>abs</sub></button>
              <button class="plot-tab" data-qty="qsca" role="radio" aria-checked="false">Q<sub>sca</sub></button>
              <button class="plot-tab" data-qty="all" role="radio" aria-checked="false">All</button>
            </div>
          </div>

          <div class="param">
            <div class="param-header"><label>Decomposition</label></div>
            <div class="plot-tabs" id="decomp-tabs" role="radiogroup">
              <button class="plot-tab active" data-decomp="total" role="radio" aria-checked="true">Total</button>
              <button class="plot-tab" data-decomp="em" role="radio" aria-checked="false">E / M</button>
              <button class="plot-tab" data-decomp="multipole" role="radio" aria-checked="false">Multipoles</button>
            </div>
          </div>

          <div class="param">
            <div class="param-header"><label>X axis</label></div>
            <div class="plot-tabs" id="axis-tabs" role="radiogroup">
              <button class="plot-tab active" data-axis="lambda" role="radio" aria-checked="true">&lambda; (nm)</button>
              <button class="plot-tab" data-axis="energy" role="radio" aria-checked="false">E (eV)</button>
            </div>
          </div>

          <button id="reset-btn" class="chart-tool-btn reset-btn" title="Reset all parameters to defaults">Reset defaults</button>

          <div class="config-check" id="config-check"></div>

          <p class="theory-note" id="theory-note">
            <strong>Mie theory</strong> gives exact solutions for light scattering by
            spherical particles. C<sub>ext</sub>&nbsp;=&nbsp;C<sub>sca</sub>&nbsp;+&nbsp;C<sub>abs</sub>.
            Metals have complex&nbsp;&epsilon;, giving C<sub>abs</sub>&nbsp;&gt;&nbsp;0.
          </p>
        </div>

        <div class="chart-panel card">
          <div class="chart-toolbar">
            <div class="plot-tabs plot-tabs--sm" id="view-tabs" role="radiogroup">
              <button class="plot-tab active" data-view="spectrum" role="radio" aria-checked="true">Spectrum</button>
              <button class="plot-tab" data-view="angular" role="radio" aria-checked="false">Angular</button>
              <button class="plot-tab" data-view="nearfield" role="radio" aria-checked="false">Near-field</button>
            </div>
            <button id="log-toggle" class="chart-tool-btn" title="Toggle logarithmic Y axis">Log Y</button>
            <span id="zoom-hint" class="chart-hint">Zoomed &mdash; double-click to reset</span>
            <span id="angular-controls" class="angular-controls" style="display:none">
              <label class="angular-label">&lambda; =</label>
              <input type="number" class="param-number param-number--sm" id="angular-lambda" value="550" step="10" min="100">
              <span class="angular-label">nm</span>
            </span>
          </div>
          <div id="angular-pol-wrap" class="angular-pol-wrap" style="display:none">
            <div class="plot-tabs" id="pol-tabs" role="radiogroup">
              <button class="plot-tab active" data-pol="total" role="radio" aria-checked="true">Unpolarized</button>
              <button class="plot-tab" data-pol="perp" role="radio" aria-checked="false">&perp; (S&#x2081;)</button>
              <button class="plot-tab" data-pol="par" role="radio" aria-checked="false">&#x2016; (S&#x2082;)</button>
            </div>
          </div>
          <div class="chart-wrap" id="chart-wrap">
            <canvas id="mie-chart" aria-label="Mie scattering cross-section spectrum"></canvas>
            <canvas id="chart-overlay" aria-hidden="true"></canvas>
            <div class="chart-tooltip" id="chart-tooltip"></div>
          </div>
          <div class="color-swatches" id="color-swatches">
            <span class="swatch-label">Apparent color</span>
            <div class="swatch-item">
              <div class="swatch-box" id="swatch-sca"></div>
              <span class="swatch-name">scattered</span>
            </div>
            <div class="swatch-item">
              <div class="swatch-box" id="swatch-trans"></div>
              <span class="swatch-name">transmitted</span>
            </div>
          </div>
          <div class="download-bar">
            <span class="download-label">Export</span>
            <button id="dl-png" class="dl-btn" title="Download chart as PNG image">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              PNG
            </button>
            <button id="dl-csv" class="dl-btn" title="Download all data as CSV">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
              CSV
            </button>
            <button id="dl-share" class="dl-btn" title="Copy shareable link to clipboard">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              Share
            </button>
          </div>
        </div>
      </div>

      <div class="references card">
        <h4>References &amp; data sources</h4>
        <ul>
          <li>C. F. Bohren &amp; D. R. Huffman, <em>Absorption and Scattering of Light by Small Particles</em> (Wiley, 1983). Algorithm: BHCOAT for coated spheres, generalized to N concentric shells.</li>
          <li>Optical constants: <a href="https://refractiveindex.info" target="_blank" rel="noopener">refractiveindex.info</a> &mdash;
            Au, Ag: Johnson &amp; Christy (1972);
            Si: Aspnes &amp; Studna (1983);
            Al: Raki&cacute; (1995);
            TiO<sub>2</sub>: Sarkar et al. (2019).</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .widget-hero { padding: calc(var(--space-3xl) + var(--space-lg)) 0 var(--space-xl); background: var(--bg-soft); }
  .widget-hero h1 { margin-bottom: var(--space-sm); }
  .widget-hero__subtitle { font-size: 1.125rem; max-width: 600px; }
  .gradient-text { background: var(--spectrum); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .back-link { display: inline-block; margin-bottom: var(--space-md); font-size: 0.875rem; font-weight: 500; color: var(--text-soft); }
  .back-link:hover { color: var(--primary); }
  .widget-layout { display: grid; grid-template-columns: 300px 1fr; gap: var(--space-lg); align-items: start; }
  .controls { display: flex; flex-direction: column; gap: var(--space-lg); position: sticky; top: calc(var(--nav-height) + var(--lab-bar-height) + var(--space-lg)); }
  .controls h3 { font-size: 1rem; margin-bottom: calc(-0.5 * var(--space-sm)); }
  .param { display: flex; flex-direction: column; gap: 0.4rem; }
  .param-header { display: flex; justify-content: space-between; align-items: center; }
  .param-header label { font-size: 0.875rem; font-weight: 500; color: var(--text); }
  .param-number {
    width: 5rem; padding: 0.2rem 0.4rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm);
    font-family: var(--font); font-size: 0.875rem; font-weight: 600; font-variant-numeric: tabular-nums;
    color: var(--primary); text-align: right; outline: none; background: var(--bg); transition: border-color 0.15s;
  }
  .param-number:focus { border-color: var(--primary-light); }
  .param-number--sm { width: 4.2rem; font-size: 0.8125rem; }
  .param-range-row { display: flex; align-items: center; gap: 0.35rem; }
  .param-number::-webkit-inner-spin-button, .param-number::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .param-number { -moz-appearance: textfield; }
  .param-slider {
    -webkit-appearance: none; appearance: none; width: 100%; height: 6px;
    background: var(--bg-muted); border-radius: 3px; outline: none; cursor: pointer;
  }
  .param-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%; background: var(--primary); cursor: pointer; transition: box-shadow 0.15s; }
  .param-slider::-webkit-slider-thumb:hover { box-shadow: 0 0 0 5px rgba(99,102,241,0.15); }
  .param-slider::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--primary); border: none; cursor: pointer; }
  .param-slider::-moz-range-track { height: 6px; background: var(--bg-muted); border-radius: 3px; border: none; }
  .param-limits { display: flex; align-items: center; gap: 0.25rem; }
  .param-limit-dash { flex: 1; text-align: center; color: var(--bg-muted); font-size: 0.75rem; }
  .param-limit {
    width: 3.5rem; padding: 0.15rem 0.3rem; border: 1px solid transparent; border-radius: var(--radius-sm);
    font-family: var(--font); font-size: 0.6875rem; font-variant-numeric: tabular-nums; color: var(--text-muted);
    text-align: center; background: var(--bg-soft); outline: none; transition: border-color 0.15s, color 0.15s;
  }
  .param-limit:focus { border-color: var(--primary-light); color: var(--text-soft); }
  .param-limit::-webkit-inner-spin-button, .param-limit::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .param-limit { -moz-appearance: textfield; }
  .param-presets { display: flex; gap: var(--space-xs); flex-wrap: wrap; }
  .preset-btn { padding: 0.2rem 0.55rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-full); background: var(--bg); font-family: var(--font); font-size: 0.6875rem; font-weight: 500; color: var(--text-muted); cursor: pointer; transition: all 0.15s; }
  .preset-btn:hover { border-color: var(--primary-light); color: var(--primary); }
  .preset-btn.active { border-color: var(--primary-light); background: rgba(99,102,241,0.06); color: var(--primary); }
  .param-select {
    width: 100%; padding: 0.35rem 0.5rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm);
    font-family: var(--font); font-size: 0.8125rem; font-weight: 500; color: var(--text);
    background: var(--bg); outline: none; cursor: pointer; transition: border-color 0.15s;
  }
  .param-select:focus { border-color: var(--primary-light); }
  .material-ref { font-size: 0.6875rem; color: var(--text-muted); font-style: italic; }
  #eps-group.hidden { display: none; }
  .shell-section { display: flex; flex-direction: column; gap: 0.4rem; border-top: 1px solid var(--bg-muted); padding-top: var(--space-sm); margin-top: var(--space-xs); }
  .shell-header { display: flex; justify-content: space-between; align-items: center; }
  .shell-header label { font-size: 0.8125rem; font-weight: 600; color: var(--text-soft); text-transform: uppercase; letter-spacing: 0.04em; }
  .remove-shell-btn { padding: 0.15rem 0.45rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-full); background: var(--bg); font-family: var(--font); font-size: 0.6875rem; font-weight: 500; color: var(--text-muted); cursor: pointer; transition: all 0.15s; }
  .remove-shell-btn:hover { border-color: #ef4444; color: #ef4444; }
  .shell-eps-group.hidden { display: none !important; }
  .reset-btn { width: 100%; color: var(--text-muted) !important; }
  .file-upload-row { display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.25rem; }
  .file-input { font-size: 0.75rem; font-family: var(--font); color: var(--text-soft); }
  .file-input::file-selector-button { padding: 0.2rem 0.5rem; border: 1px solid var(--bg-muted); border-radius: var(--radius-full); background: var(--bg); font-family: var(--font); font-size: 0.6875rem; font-weight: 500; color: var(--text-soft); cursor: pointer; margin-right: 0.4rem; transition: all 0.15s; }
  .file-input::file-selector-button:hover { border-color: var(--primary-light); color: var(--primary); }
  .file-name { font-size: 0.6875rem; color: var(--text-muted); font-style: italic; }
  .file-error { font-size: 0.6875rem; color: var(--rose); }
  .rii-search { display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.25rem; }
  .rii-input { width: 100% !important; text-align: left !important; font-weight: 500 !important; color: var(--text) !important; }
  .rii-results { max-height: 200px; overflow-y: auto; border: 1px solid var(--bg-muted); border-radius: var(--radius-sm); background: var(--bg); }
  .rii-results:empty { display: none; }
  .rii-result { padding: 0.3rem 0.5rem; font-size: 0.75rem; cursor: pointer; line-height: 1.4; border-bottom: 1px solid var(--bg-soft); }
  .rii-result:last-child { border-bottom: none; }
  .rii-result:hover { background: rgba(99,102,241,0.06); }
  .rii-result-book { font-weight: 600; color: var(--text); }
  .rii-result-page { color: var(--text-muted); font-size: 0.6875rem; }
  .plot-tabs--sm { padding: 2px; }
  .plot-tabs--sm .plot-tab { padding: 0.25rem 0.5rem; font-size: 0.6875rem; }
  .angular-controls { display: inline-flex; align-items: center; gap: 0.25rem; margin-left: auto; }
  .angular-label { font-size: 0.75rem; font-weight: 500; color: var(--text-soft); }
  .angular-pol-wrap { margin-bottom: var(--space-sm); }
  .config-check { border-top: 1px solid var(--bg-muted); padding-top: var(--space-sm); margin-top: var(--space-xs); }
  .config-check svg { width: 100%; height: auto; border-radius: var(--radius-sm); }
  .references { margin-top: var(--space-lg); grid-column: 1 / -1; }
  .references h4 { font-size: 0.875rem; margin-bottom: var(--space-sm); }
  .references ul { list-style: none; display: flex; flex-direction: column; gap: var(--space-xs); }
  .references li { font-size: 0.8125rem; color: var(--text-soft); line-height: 1.5; }
  .references a { color: var(--primary); }
  .plot-tabs { display: flex; background: var(--bg-muted); border-radius: var(--radius-full); padding: 3px; }
