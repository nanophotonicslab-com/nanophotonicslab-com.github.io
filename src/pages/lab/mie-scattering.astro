      shFileGrp.style.display = v === 'file' ? '' : 'none';
      shRiiGrp.style.display = v === 'rii' ? '' : 'none';
      refEl.textContent = v === 'drude' ? drudeRef(shellDrudeHandle) : (v === 'custom' || v === 'file' || v === 'rii') ? '' : MATERIALS[v].ref;
      if (v === 'rii') { shRiiHandle.ensureCatalog(); return; }
      if (v === 'file' && !handle.uploadedData) return;
      resetAndUpdate();
    });

    bindDrudeInputs(shellDrudeHandle, () => {
      if (matSel.value === 'drude') refEl.textContent = drudeRef(shellDrudeHandle);
      resetAndUpdate();
    });

    handle = { el: sec, material: matSel, epsParam: epsP, epsGroup: epsGrp, drudeHandle: shellDrudeHandle, rParam: rP, refEl, uploadedData: null };

    shFileInput.addEventListener('change', () => {
      const file = shFileInput.files?.[0];
