              <button class="plot-tab" data-pol="perp" role="radio" aria-checked="false">&perp; (S&#x2081;)</button>
              <button class="plot-tab" data-pol="par" role="radio" aria-checked="false">&#x2016; (S&#x2082;)</button>
            </div>
          </div>
          <div class="thermal-result-header" id="thermal-result-header" style="display:none">
            <span class="thermal-spectrum-title">Temperature profile T(r)</span>
            <div class="thermal-lambda-control">
              <label for="thermal-i0-slider">Intensity I<sub>0</sub></label>
              <input type="range" class="param-slider" id="thermal-i0-slider" min="0" max="20" step="0.1" value="1">
              <input type="number" class="param-number param-number--sm" id="thermal-i0-num" value="1" step="0.1" min="0">
              <span class="thermal-lambda-unit">GW/m&sup2;</span>
            </div>
          </div>
          <div class="chart-wrap" id="chart-wrap">
