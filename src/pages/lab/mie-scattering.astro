    if (a >= 5000) return (v / 1e3).toFixed(0) + 'k';
    if (Number.isInteger(v)) return v.toString();
    if (a >= 1) return v.toFixed(1);
    return v.toFixed(2);
  }
  function fmtVal(v: number): string {
    const a = Math.abs(v);
