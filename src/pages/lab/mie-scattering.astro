  function renderAngular() {
    chartXforms = null;
    const lambdaNm = parseFloat(angularLambdaInput.value) || 550;
    let coeffs: MieCoeffs;
    if (geometry === 'coreshell') {
      coeffs = computeShellCoeffsAtLambda(buildLayers(), nhParam.value, lambdaNm);
    } else {
      coeffs = computeSphereCoeffs(getDielectric, rParam.value, nhParam.value, lambdaNm);
    }
    const pattern = computeAngularPattern(coeffs);
    drawPolarChart(canvas, pattern, polTabs.value, lambdaNm);
    clearOverlay();
  }

  function renderNearField() {
    chartXforms = null;
    const lambdaNm = parseFloat(angularLambdaInput.value) || 550;
    const outerR = geometry === 'coreshell'
      ? Math.max(coreRParam.value, rParam.value, ...extraShells.map(s => s.rParam.value))
      : rParam.value;
    let coeffs: MieCoeffs;
    if (geometry === 'coreshell') {
      coeffs = computeShellCoeffsAtLambda(buildLayers(), nhParam.value, lambdaNm);
    } else {
      coeffs = computeSphereCoeffs(getDielectric, rParam.value, nhParam.value, lambdaNm);
    }
    const k = 2 * Math.PI * nhParam.value / (lambdaNm * 1e-9);
    const extent = outerR * 3;
    const nf = computeNearField(coeffs, k, outerR, 150, extent);
    drawHeatmap(canvas, nf, outerR, lambdaNm);
    clearOverlay();
  }

  // Absorption cross section (m²) from NPLab's Mie coefficients at one wavelength.
  // Cabs = Cext − Csca = (2π/k0²) Σ (2n+1)[Re(aₙ+bₙ) − (|aₙ|²+|bₙ|²)]
  function cabsFromCoeffs(coeffs: MieCoeffs, k0: number): number {
    let s = 0;
    for (let i = 0; i < coeffs.nmax; i++) {
      const n = i + 1;
      const aR = coeffs.aRe[i], aI = coeffs.aIm[i], bR = coeffs.bRe[i], bI = coeffs.bIm[i];
      s += (2 * n + 1) * ((aR + bR) - (aR * aR + aI * aI + bR * bR + bI * bI));
    }
    return (2 * Math.PI / (k0 * k0)) * Math.max(0, s);
  }

  function matBandLabel(mat: string): string {
    return mat === 'tio2' ? 'TiO₂'
      : mat === 'drude' ? 'Drude'
      : mat === 'custom' ? 'Custom'
      : (mat === 'file' || mat === 'rii') ? 'File'
      : mat.charAt(0).toUpperCase() + mat.slice(1);
  }

  // Dense linear solve A·x = b (Gaussian elimination with partial pivoting).
  function solveLinearSystem(A: number[][], b: number[]): number[] {
    const n = b.length;
    const M = A.map((row, i) => [...row, b[i]]);
    for (let col = 0; col < n; col++) {
      let piv = col;
      for (let r = col + 1; r < n; r++) if (Math.abs(M[r][col]) > Math.abs(M[piv][col])) piv = r;
      if (Math.abs(M[piv][col]) < 1e-300) continue;
      [M[col], M[piv]] = [M[piv], M[col]];
      const d = M[col][col];
      for (let c = col; c <= n; c++) M[col][c] /= d;
      for (let r = 0; r < n; r++) {
        if (r === col) continue;
        const f = M[r][col];
        if (f === 0) continue;
        for (let c = col; c <= n; c++) M[r][c] -= f * M[col][c];
      }
    }
    return M.map(row => row[n]);
  }

  // ── Multilayer internal-field solver (continuity-matching), ported from the
  // reproduction package (multishell_mie.field_coefficients + nearfield.py).
  // Yields the per-shell absorbed-power split ∫Im(ε)|E|² that the scattering
  // coefficients alone cannot provide — needed for the nano-oven cascade.
  type Cx = [number, number];
  const cAdd = (a: Cx, b: Cx): Cx => [a[0] + b[0], a[1] + b[1]];
  const cSub = (a: Cx, b: Cx): Cx => [a[0] - b[0], a[1] - b[1]];
  const cMul = (a: Cx, b: Cx): Cx => cmul(a[0], a[1], b[0], b[1]);
  const cDiv = (a: Cx, b: Cx): Cx => cdiv(a[0], a[1], b[0], b[1]);
  const cNeg = (a: Cx): Cx => [-a[0], -a[1]];

  function riccatiDeriv(z: Cx, nstop: number) {
    const psi: Cx[] = [], chi: Cx[] = [];
    const s = csin(z[0], z[1]), c = ccos(z[0], z[1]);
    psi[0] = s; chi[0] = c;
    if (nstop >= 1) { psi[1] = cSub(cDiv(s, z), c); chi[1] = cAdd(cDiv(c, z), s); }
    for (let k = 1; k < nstop; k++) {
      const f = cdivN(2 * k + 1, z[0], z[1]);
      psi[k + 1] = cSub(cMul(f, psi[k]), psi[k - 1]);
      chi[k + 1] = cSub(cMul(f, chi[k]), chi[k - 1]);
    }
    const xi: Cx[] = psi.map((p, i) => [p[0] + chi[i][1], p[1] - chi[i][0]]);   // ψ − iχ
    const jn: Cx[] = psi.map(p => cDiv(p, z));
    const hn: Cx[] = xi.map(x => cDiv(x, z));
    const dpsi: Cx[] = [], dxi: Cx[] = [];
    dpsi[0] = c;                                  // cos z
    dxi[0] = [c[0] - s[1], c[1] + s[0]];          // cos z + i sin z
    for (let k = 1; k <= nstop; k++) {
      const koz = cdivN(k, z[0], z[1]);
      dpsi[k] = cSub(psi[k - 1], cMul(koz, psi[k]));
      dxi[k] = cSub(xi[k - 1], cMul(koz, xi[k]));
    }
    return { jn, hn, psi, xi, dpsi, dxi };
  }

  function piTau(theta: number, nstop: number) {
    const mu = Math.cos(theta);
    const pin = new Array<number>(nstop + 1).fill(0), taun = new Array<number>(nstop + 1).fill(0);
    if (nstop >= 1) pin[1] = 1;
    for (let n = 2; n <= nstop; n++) pin[n] = ((2 * n - 1) / (n - 1)) * mu * pin[n - 1] - (n / (n - 1)) * pin[n - 2];
    for (let n = 1; n <= nstop; n++) taun[n] = n * mu * pin[n] - (n + 1) * pin[n - 1];
    return { pin, taun };
  }

  function solveComplexSystem(A: Cx[][], b: Cx[]): Cx[] {
    const n = b.length;
    const M: Cx[][] = A.map((row, i) => [...row.map(c => [c[0], c[1]] as Cx), [b[i][0], b[i][1]] as Cx]);
    for (let col = 0; col < n; col++) {
      let piv = col, best = Math.hypot(M[col][col][0], M[col][col][1]);
      for (let r = col + 1; r < n; r++) { const m = Math.hypot(M[r][col][0], M[r][col][1]); if (m > best) { best = m; piv = r; } }
      if (best < 1e-300) continue;
      [M[col], M[piv]] = [M[piv], M[col]];
      const d = M[col][col];
      for (let cc = col; cc <= n; cc++) M[col][cc] = cDiv(M[col][cc], d);
      for (let r = 0; r < n; r++) {
        if (r === col) continue;
        const f = M[r][col];
        if (f[0] === 0 && f[1] === 0) continue;
        for (let cc = col; cc <= n; cc++) M[r][cc] = cSub(M[r][cc], cMul(f, M[col][cc]));
      }
    }
    return M.map(row => row[n]);
  }

  interface FieldCoeffs { c: Cx[][]; d: Cx[][]; a: Cx[][]; b: Cx[][]; k: Cx[]; nstop: number; }
  function fieldCoefficients(lam0nm: number, nHost: number, radiiNm: number[], idx: Cx[]): FieldCoeffs {
    const L = radiiNm.length, k0 = 2 * Math.PI / lam0nm;
    const k: Cx[] = [];
    for (let l = 0; l < L; l++) k[l] = [k0 * idx[l][0], k0 * idx[l][1]];
    k[L] = [k0 * nHost, 0];
    const xL = k0 * nHost * radiiNm[L - 1];
    const nstop = Math.max(1, Math.round(xL + 4 * Math.cbrt(xL) + 2));
    const fnsIn: ReturnType<typeof riccatiDeriv>[] = [], fnsOut: ReturnType<typeof riccatiDeriv>[] = [];
    for (let p = 0; p < L; p++) {
      fnsIn[p] = riccatiDeriv([k[p][0] * radiiNm[p], k[p][1] * radiiNm[p]], nstop);
      fnsOut[p] = riccatiDeriv([k[p + 1][0] * radiiNm[p], k[p + 1][1] * radiiNm[p]], nstop);
    }
    const c: Cx[][] = [], d: Cx[][] = [], a: Cx[][] = [], b: Cx[][] = [];
    for (let reg = 0; reg <= L; reg++) { c[reg] = []; d[reg] = []; a[reg] = []; b[reg] = []; }
    const nun = 2 * L + 1;
    for (let n = 1; n <= nstop; n++) {
      // TE: unknowns [c_0..c_{L-1}, a_0..a_{L-1}, a_host]
      {
        const A: Cx[][] = Array.from({ length: nun }, () => Array.from({ length: nun }, () => [0, 0] as Cx));
        const rhs: Cx[] = Array.from({ length: nun }, () => [0, 0] as Cx);
        let row = 0;
        for (let p = 0; p < L; p++) {
          const fi = fnsIn[p], fo = fnsOut[p];
          const put = (rw: number, reg: number, cval: Cx, aval: Cx) => {
            if (reg < L) { A[rw][reg] = cAdd(A[rw][reg], cval); A[rw][L + reg] = cAdd(A[rw][L + reg], aval); }
            else { rhs[rw] = cSub(rhs[rw], cval); A[rw][2 * L] = cAdd(A[rw][2 * L], aval); }
          };
          put(row, p, fi.jn[n], fi.hn[n]); put(row, p + 1, cNeg(fo.jn[n]), cNeg(fo.hn[n])); row++;
          put(row, p, fi.dpsi[n], fi.dxi[n]); put(row, p + 1, cNeg(fo.dpsi[n]), cNeg(fo.dxi[n])); row++;
        }
        A[row][L] = [1, 0];                       // a_0 = 0 (regular at origin)
        const x = solveComplexSystem(A, rhs);
        for (let l = 0; l < L; l++) { c[l][n] = x[l]; a[l][n] = x[L + l]; }
        c[L][n] = [1, 0]; a[L][n] = x[2 * L];
      }
      // TM: unknowns [d_0..d_{L-1}, b_0..b_{L-1}, b_host]
      {
        const A: Cx[][] = Array.from({ length: nun }, () => Array.from({ length: nun }, () => [0, 0] as Cx));
        const rhs: Cx[] = Array.from({ length: nun }, () => [0, 0] as Cx);
        let row = 0;
        for (let p = 0; p < L; p++) {
          const fi = fnsIn[p], fo = fnsOut[p], kin = k[p], kout = k[p + 1];
          const putd = (rw: number, reg: number, dval: Cx, bval: Cx) => {
            if (reg < L) { A[rw][reg] = cAdd(A[rw][reg], dval); A[rw][L + reg] = cAdd(A[rw][L + reg], bval); }
            else { rhs[rw] = cSub(rhs[rw], dval); A[rw][2 * L] = cAdd(A[rw][2 * L], bval); }
          };
          putd(row, p, cDiv(fi.dpsi[n], kin), cDiv(fi.dxi[n], kin));
          putd(row, p + 1, cNeg(cDiv(fo.dpsi[n], kout)), cNeg(cDiv(fo.dxi[n], kout))); row++;
          putd(row, p, fi.psi[n], fi.xi[n]);
          putd(row, p + 1, cNeg(fo.psi[n]), cNeg(fo.xi[n])); row++;
        }
        A[row][L] = [1, 0];                       // b_0 = 0
        const x = solveComplexSystem(A, rhs);
        for (let l = 0; l < L; l++) { d[l][n] = x[l]; b[l][n] = x[L + l]; }
        d[L][n] = [1, 0]; b[L][n] = x[2 * L];
      }
    }
    return { c, d, a, b, k, nstop };
  }

  const IPOW: Cx[] = [[1, 0], [0, 1], [-1, 0], [0, -1]];
  function fieldAmplitudeSq(co: FieldCoeffs, layer: number, rNm: number, theta: number, pt: { pin: number[]; taun: number[] }): number {
    const z: Cx = [co.k[layer][0] * rNm, co.k[layer][1] * rNm];
    const f = riccatiDeriv(z, co.nstop), zz = cMul(z, z), sinT = Math.sin(theta);
    const { pin, taun } = pt;
    let Er: Cx = [0, 0], Eth: Cx = [0, 0], Eph: Cx = [0, 0];
    for (let n = 1; n <= co.nstop; n++) {
      const s = (2 * n + 1) / (n * (n + 1)), ip = IPOW[n % 4];
      const En: Cx = [s * ip[0], s * ip[1]];
      const cN = co.c[layer][n], dN = co.d[layer][n], aN = co.a[layer][n], bN = co.b[layer][n];
      const Mc = cAdd(cMul(cN, f.jn[n]), cMul(aN, f.hn[n]));
      const inn = cAdd(cMul(dN, cDiv(f.dpsi[n], z)), cMul(bN, cDiv(f.dxi[n], z)));
      const Nd: Cx = [inn[1], -inn[0]];                                  // −i·inn
      const nn1 = n * (n + 1);
      const in2 = cAdd(cMul(dN, cDiv(f.psi[n], zz)), cMul(bN, cDiv(f.xi[n], zz)));
      const Nr: Cx = [in2[1] * nn1, -in2[0] * nn1];                      // −i·(…)·n(n+1)
      const er = cMul(En, Nr); Er = cAdd(Er, [er[0] * pin[n] * sinT, er[1] * pin[n] * sinT]);
      Eth = cAdd(Eth, cMul(En, [Mc[0] * pin[n] + Nd[0] * taun[n], Mc[1] * pin[n] + Nd[1] * taun[n]]));
      Eph = cAdd(Eph, cMul(En, [-Mc[0] * taun[n] - Nd[0] * pin[n], -Mc[1] * taun[n] - Nd[1] * pin[n]]));
    }
    return Er[0] * Er[0] + Er[1] * Er[1] + Eth[0] * Eth[0] + Eth[1] * Eth[1] + Eph[0] * Eph[0] + Eph[1] * Eph[1];
  }

  // Per-layer absorbed-power weights (∫Im(ε)|E|²), normalised over metal layers;
  // 0 for non-metal layers. Returns null on any numerical failure.
  function perShellAbsorbedSplit(lam0nm: number, nHost: number, radiiNm: number[], idx: Cx[], metalMask: boolean[], nr = 18, ntheta = 36): number[] | null {
    try {
      const L = radiiNm.length;
      const co = fieldCoefficients(lam0nm, nHost, radiiNm, idx);
      const innerR = radiiNm.map((_, l) => l === 0 ? 0 : radiiNm[l - 1]);
      const theta: number[] = [], wth: number[] = [];
      for (let j = 0; j < ntheta; j++) { const t = 1e-4 + (Math.PI - 2e-4) * j / (ntheta - 1); theta.push(t); wth.push(Math.sin(t)); }
      const pts = theta.map(t => piTau(t, co.nstop));
      const trapz = (y: number[], x: number[]) => { let s = 0; for (let i = 1; i < y.length; i++) s += (x[i] - x[i - 1]) * (y[i] + y[i - 1]) / 2; return s; };
      const P = new Array<number>(L).fill(0);
      for (let l = 0; l < L; l++) {
        if (!metalMask[l]) continue;
        const r0 = innerR[l], rs: number[] = [];
        for (let i = 0; i < nr; i++) rs.push(r0 + (radiiNm[l] - r0) * (i + 1) / nr);
        const rad = new Array<number>(ntheta);
        for (let j = 0; j < ntheta; j++) {
          const col = rs.map(rr => fieldAmplitudeSq(co, l, rr, theta[j], pts[j]) * rr * rr);
          rad[j] = trapz(col, rs);
        }
        P[l] = 2 * idx[l][0] * idx[l][1] * Math.PI * trapz(rad.map((v, j) => v * wth[j]), theta);
      }
      let tot = 0; for (let l = 0; l < L; l++) tot += P[l];
      if (!(tot > 0) || !Number.isFinite(tot)) return null;
      return P.map(p => p / tot);
    } catch { return null; }
  }

  function renderThermal() {
    chartXforms = null;
    rebuildThermalLayers();
    // sync the slider range to the current spectrum sweep so the marker stays on it
    if (data && data.lambda.length) {
      const lo = Math.min(data.lambda[0], data.lambda[data.lambda.length - 1]);
      const hi = Math.max(data.lambda[0], data.lambda[data.lambda.length - 1]);
      thermalLambdaSlider.min = String(Math.round(lo));
      thermalLambdaSlider.max = String(Math.round(hi));
      let cur = parseFloat(thermalLambdaSlider.value);
      if (!Number.isFinite(cur) || cur < lo || cur > hi) {
        cur = Math.max(lo, Math.min(hi, Number.isFinite(cur) ? cur : (lo + hi) / 2));
        thermalLambdaSlider.value = String(Math.round(cur));
        thermalLambdaNum.value = thermalLambdaSlider.value;
      }
    }
    const lambdaNm = parseFloat(thermalLambdaSlider.value) || 550;
    const I0 = Math.max(0, parseFloat(thermalI0Num.value) || 0) * 1e9;        // GW/m² → W/m²
    const T0c = Number.isFinite(parseFloat(thermalT0Input.value)) ? parseFloat(thermalT0Input.value) : 25;
    const kappaMed = Math.max(1e-6, parseFloat(thermalKappaMed.value) || 0.6); // W/m/K

    // Layer stack (core → outer), sorted by outer radius, paired with materials.
    let mats: string[], dielFns: ((l: number) => [number, number])[], radiiNm: number[];
    if (geometry === 'coreshell') {
      const matsRaw = [coreMaterialSelect.value, materialSelect.value, ...extraShells.map(s => s.material.value)];
      const pairs = buildLayers().map((l, i) => ({ getD: l.getDielectric, r: l.radiusNm, mat: matsRaw[i] ?? 'custom' }))
        .sort((a, b) => a.r - b.r);
      mats = pairs.map(p => p.mat); dielFns = pairs.map(p => p.getD); radiiNm = pairs.map(p => p.r);
    } else {
      mats = [materialSelect.value]; dielFns = [getDielectric]; radiiNm = [rParam.value];
    }
    const L = radiiNm.length;
    const outerRnm = radiiNm[L - 1];
    const R = outerRnm * 1e-9;

    // σ_abs from NPLab Mie at this single wavelength (sphere or core-shell)
    const coeffs: MieCoeffs = geometry === 'coreshell'
      ? computeShellCoeffsAtLambda(buildLayers(), nhParam.value, lambdaNm)
      : computeSphereCoeffs(getDielectric, rParam.value, nhParam.value, lambdaNm);
    const k0 = 2 * Math.PI * nhParam.value / (lambdaNm * 1e-9);   // 1/m
    const Cabs = cabsFromCoeffs(coeffs, k0);                       // m²
    const Pabs = Cabs * I0;                                        // W

    // Per-layer geometry and (user-defined) thermal properties, SI units.
    const rOut = radiiNm.map(rn => rn * 1e-9);
    const rIn = rOut.map((_, i) => i === 0 ? 0 : rOut[i - 1]);
    const Vol = rOut.map((ro, i) => 4 / 3 * Math.PI * (ro ** 3 - rIn[i] ** 3));
    const ImEps = dielFns.map(f => { const [n, kk] = f(lambdaNm); return Math.max(0, 2 * n * kk); });
    const kappa = radiiNm.map((_, i) => Math.max(1e-6, tlVal(i, 'kappa', 1)));
    const gEl = radiiNm.map((_, i) => Math.max(0, tlVal(i, 'g', 0)) * 1e16);
    const Gtbc = radiiNm.map((_, i) => Math.max(1, tlVal(i, 'G', 100)) * 1e6);
    const isMetal = radiiNm.map((_, i) => gEl[i] > 0 && ImEps[i] > 0.2);

    // Absorbed power per layer. For layered particles use the true internal-field
    // integral ∫Im(ε)|E|² (continuity-matching solver) so the nano-oven cascade
    // is captured; fall back to the Im(ε)·V proxy if the field solve fails or for
    // a homogeneous sphere. Normalised to the total σ_abs.
    let wsum = 0; for (let i = 0; i < L; i++) wsum += ImEps[i] * Vol[i];
    let split: number[] | null = null;
    if (geometry === 'coreshell' && L >= 2 && isMetal.some(Boolean)) {
      const idxC: Cx[] = dielFns.map(f => { const [n, kk] = f(lambdaNm); return [n, kk] as Cx; });
      // the split depends only on λ/host/radii/indices — memoise so I₀/T₀/κ edits stay instant
      const sig = lambdaNm + '|' + nhParam.value + '|' + radiiNm.join(',') + '|' +
        idxC.map(c => c[0].toFixed(5) + '_' + c[1].toFixed(5)).join(';') + '|' + isMetal.join(',');
      if (thermalSplitCache && thermalSplitCache.sig === sig) split = thermalSplitCache.split;
      else { split = perShellAbsorbedSplit(lambdaNm, nhParam.value, radiiNm, idxC, isMetal); thermalSplitCache = { sig, split }; }
    }
    const Pn = radiiNm.map((_, i) => split ? Pabs * split[i]
      : wsum > 0 ? Pabs * (ImEps[i] * Vol[i]) / wsum
      : (i === L - 1 ? Pabs : 0));
    const fluxAt: number[] = []; { let acc = 0; for (let i = 0; i < L; i++) { acc += Pn[i]; fluxAt.push(acc); } }

    // Per-layer surface temperatures (°C): tOut/tInn are the lattice temperatures
    // at each layer's outer/inner boundary, tElec the metal electron temperature.
    const tOut = new Array<number>(L), tInn = new Array<number>(L), tElec = new Array<number>(L);

    // Coupled two-temperature steady state (Meng et al. eqs 4–9) for a metal shell
    // stack: per metal shell, electron Te / lattice Tl, and the dielectric interface
    // temperatures Tdi (inner) / Tdo (outer). Each dielectric interface couples to
    // BOTH the electron and lattice baths, so the core floats between Tl and Te and
    // ends up hotter than the metal lattice. Gᵉˡ uses the paper's T-dependence (eq 3).
    function solveOvenTemps() {
      const mIdx: number[] = [];
      for (let i = 0; i < L; i++) if (isMetal[i]) mIdx.push(i);
      const N = mIdx.length;
      const T0K = T0c + 273.15;
      const sh = mIdx.map(i => ({
        Ri: rIn[i], Ro: rOut[i], V: Vol[i],
        Si: 4 * Math.PI * rIn[i] * rIn[i], So: 4 * Math.PI * rOut[i] * rOut[i],
        g: gEl[i], P: Pn[i], GllI: Gtbc[i - 1], GllO: Gtbc[i],
        kappaAbove: i + 1 < L ? Math.max(1e-6, kappa[i + 1]) : 0,
      }));
      const Gelf = (T: number) => (96.12 + 0.189 * T) * 1e6;   // eq 3, W/m²K
      const ix = (j: number, w: number) => 4 * j + w;          // 0=Te 1=Tl 2=Tdi 3=Tdo
      let Te = new Array<number>(N).fill(T0K);
      let X = new Array<number>(4 * N).fill(T0K);
      for (let iter = 0; iter < 80; iter++) {
        const A: number[][] = Array.from({ length: 4 * N }, () => new Array<number>(4 * N).fill(0));
        const b = new Array<number>(4 * N).fill(0);
        const Gel = Te.map(t => Gelf(t));
        let row = 0;
        for (let j = 0; j < N; j++) {
          const s = sh[j], GelI = Gel[j], GelO = j === N - 1 ? 0 : Gel[j];
          // eq4 electron balance
          A[row][ix(j, 0)] = s.g * s.V + GelI * s.Si + GelO * s.So;
          A[row][ix(j, 1)] = -s.g * s.V;
          A[row][ix(j, 2)] = -GelI * s.Si;
          A[row][ix(j, 3)] = -GelO * s.So;
          b[row] = s.P; row++;
          // eq5 lattice balance
          A[row][ix(j, 0)] = s.g * s.V;
          A[row][ix(j, 1)] = -s.g * s.V - s.GllI * s.Si - s.GllO * s.So;
          A[row][ix(j, 2)] = s.GllI * s.Si;
          A[row][ix(j, 3)] = s.GllO * s.So;
          b[row] = 0; row++;
        }
        // eq9 core interface (zero net flux into the dielectric core)
        A[row][ix(0, 0)] = Gel[0]; A[row][ix(0, 1)] = sh[0].GllI; A[row][ix(0, 2)] = -(Gel[0] + sh[0].GllI);
        b[row] = 0; row++;
        // spacers k = 0..N-2
        let Pcum = 0;
        for (let k = 0; k < N - 1; k++) {
          const sk = sh[k], sk1 = sh[k + 1];
          // eq6 flux balance across the spacer
          A[row][ix(k, 0)] += sk.So * Gel[k];
          A[row][ix(k, 1)] += sk.So * sk.GllO;
          A[row][ix(k, 3)] += -sk.So * (Gel[k] + sk.GllO);
          A[row][ix(k + 1, 0)] += sk1.Si * Gel[k + 1];
          A[row][ix(k + 1, 1)] += sk1.Si * sk1.GllI;
          A[row][ix(k + 1, 2)] += -sk1.Si * (Gel[k + 1] + sk1.GllI);
          b[row] = 0; row++;
          // eq7 conduction through the spacer dielectric
          const Gcond = 4 * Math.PI * sk.kappaAbove * sk.Ro * sk1.Ri / Math.max(sk1.Ri - sk.Ro, 1e-18);
          A[row][ix(k, 3)] += Gcond; A[row][ix(k + 1, 2)] += -Gcond;
          Pcum += sk.P; b[row] = Pcum; row++;
        }
        // eq8 water: all absorbed power conducts out through the outer shell
        const Gw = 4 * Math.PI * kappaMed * sh[N - 1].Ro;
        let Ptot = 0; for (const s of sh) Ptot += s.P;
        A[row][ix(N - 1, 3)] = Gw; b[row] = Ptot + Gw * T0K; row++;

        X = solveLinearSystem(A, b);
        const newTe = Array.from({ length: N }, (_, j) => X[ix(j, 0)]);
        let maxd = 0; for (let j = 0; j < N; j++) maxd = Math.max(maxd, Math.abs(newTe[j] - Te[j]));
        Te = newTe;
        if (maxd < 1e-7) break;
      }
      return {
        Te: Array.from({ length: N }, (_, j) => X[ix(j, 0)]),
        Tl: Array.from({ length: N }, (_, j) => X[ix(j, 1)]),
        Tdi: Array.from({ length: N }, (_, j) => X[ix(j, 2)]),
        Tdo: Array.from({ length: N }, (_, j) => X[ix(j, 3)]),
      };
    }

    // Nano-oven topology: dielectric core, strictly alternating dielectric/metal,
    // outermost layer metal — only then is the coupled solve well-posed.
    const isNanoOven = L >= 2 && !isMetal[0] && isMetal[L - 1] && isMetal.every((m, i) => m === (i % 2 === 1));
    const oven = isNanoOven ? solveOvenTemps() : null;

    if (oven) {
      for (let i = 0; i < L; i++) {
        if (isMetal[i]) {
          const s = (i - 1) / 2;                          // metal-shell index
          tOut[i] = tInn[i] = oven.Tl[s] - 273.15;
          tElec[i] = oven.Te[s] - 273.15;
        } else if (i === 0) {
          tOut[0] = tInn[0] = oven.Tdi[0] - 273.15;        // isothermal core
          tElec[0] = NaN;
        } else {
          tInn[i] = oven.Tdo[(i - 2) / 2] - 273.15;        // inner boundary ← metal below
          tOut[i] = oven.Tdi[i / 2] - 273.15;              // outer boundary ← metal above
          tElec[i] = NaN;
        }
      }
    } else {
      // Steady-state outward conduction (dielectric core is a thermal dead-end, so
      // all P_abs flows outward): medium 1/r tail, per-interface Kapitza jumps,
      // per-dielectric A+B/r conduction, per-metal electron–lattice split.
      let tBoundary = T0c + Pabs / (4 * Math.PI * kappaMed * R)
                    + Pabs / (4 * Math.PI * R * R * Gtbc[L - 1]);
      for (let k = L - 1; k >= 0; k--) {
        tOut[k] = tBoundary;
        if (isMetal[k]) {
          tInn[k] = tBoundary;
          tElec[k] = tBoundary + (Vol[k] > 0 ? Pn[k] / (gEl[k] * Vol[k]) : 0);
        } else {
          const fluxIn = k > 0 ? fluxAt[k - 1] : 0;
          tInn[k] = tBoundary + (rIn[k] > 0 ? fluxIn / (4 * Math.PI * kappa[k]) * (1 / rIn[k] - 1 / rOut[k]) : 0);
          tElec[k] = NaN;
        }
        if (k > 0) tBoundary = tInn[k] + fluxAt[k - 1] / (4 * Math.PI * rIn[k] * rIn[k] * Gtbc[k - 1]);
      }
    }

    const npts = 400;
    // Plotting range: user-set "max r" (bottom-right of the result box), else 3×outer radius.
    const defRmax = Math.max(outerRnm * 3, outerRnm + 1);
    let rmaxVal = parseFloat(thermalRmax.value);
    if (!Number.isFinite(rmaxVal) || rmaxVal <= outerRnm) { rmaxVal = defRmax; thermalRmax.value = String(Math.round(defRmax)); }
    const Rmax = rmaxVal;
    const r = new Float64Array(npts);
    const Te = new Float64Array(npts), Tl = new Float64Array(npts), Tw = new Float64Array(npts);
    for (let i = 0; i < npts; i++) {
      const rn = (i / (npts - 1)) * Rmax; r[i] = rn; const rm = rn * 1e-9;
      if (rm > R) { Te[i] = NaN; Tl[i] = NaN; Tw[i] = T0c + Pabs / (4 * Math.PI * kappaMed * rm); continue; }
      let kk = 0; while (kk < L - 1 && rm > rOut[kk]) kk++;
      Tw[i] = NaN;
      if (isMetal[kk]) { Tl[i] = tOut[kk]; Te[i] = tElec[kk]; }
      else {
        if (rIn[kk] <= 0 || rOut[kk] - rIn[kk] < 1e-18) { Tl[i] = tOut[kk]; }
        else { const B = (tOut[kk] - tInn[kk]) / (1 / rOut[kk] - 1 / rIn[kk]); Tl[i] = (tOut[kk] - B / rOut[kk]) + B / Math.max(rm, 1e-18); }
        Te[i] = NaN;
      }
    }
    // Only show the electron temperature where there are free electrons (a metal
    // layer with g > 0); a purely dielectric particle (all g = 0) has none.
    const hasElectrons = isMetal.some(Boolean);
    const series: PlotSeries[] = [
      ...(hasElectrons ? [{ y: Te, color: '#EF4444', label: 'Tₑ (electron)' }] : []),
      { y: Tl, color: '#111827', label: 'Tₗ (lattice)' },
      { y: Tw, color: '#3B82F6', label: 'host (1/r)' },
    ];

    // Coloured layer bands + the surrounding host medium.
    const bands: { x0: number; x1: number; color: string; label?: string }[] = [];
    let prev = 0;
    for (let i = 0; i < L; i++) {
      if (radiiNm[i] > prev) { bands.push({ x0: prev, x1: radiiNm[i], color: hexToRgba(MAT_COLORS[mats[i]] ?? '#CBD5E1', 0.18), label: matBandLabel(mats[i]) }); prev = radiiNm[i]; }
    }
    bands.push({ x0: outerRnm, x1: Rmax, color: hexToRgba('#3B82F6', 0.06), label: 'host' });

    thermalExport = {
      xArr: r, series, bands, Te, Tl, Tw, T0c,
      params: {
        lambdaNm, I0gw: Math.max(0, parseFloat(thermalI0Num.value) || 0), kappaMed, nHost: nhParam.value,
        mats: mats.slice(), radiiNm: radiiNm.slice(), kappa: kappa.slice(), gEl: gEl.slice(), Gtbc: Gtbc.slice(), Cabs, Pabs,
      },
    };
    currentXArr = r; currentSeries = series;           // enable hover read-out
    chartXforms = drawChart(canvas, r, series, 'r (nm)', 'Temperature (°C)', { bands });
    // Dashed baseline at the ambient temperature T₀.
    {
      const tctx = canvas.getContext('2d')!;
      const yT0 = chartXforms.ty(T0c);
      if (yT0 >= chartXforms.pT && yT0 <= chartXforms.pT + chartXforms.pH) {
        tctx.save();
        tctx.setLineDash([4, 4]); tctx.strokeStyle = 'rgba(107,114,128,0.7)'; tctx.lineWidth = 1.5;
        tctx.beginPath(); tctx.moveTo(chartXforms.pL, yT0); tctx.lineTo(chartXforms.pL + chartXforms.pW, yT0); tctx.stroke();
        tctx.setLineDash([]); tctx.fillStyle = 'rgba(107,114,128,0.95)'; tctx.font = '600 10px Inter, system-ui, sans-serif';
        tctx.textAlign = 'right'; tctx.textBaseline = 'bottom';
        tctx.fillText('T₀', chartXforms.pL + chartXforms.pW - 3, yT0 - 2);
        tctx.restore();
      }
    }
    clearOverlay();
    // keep the range inputs in sync with the active sweep
    thermalRangeMin.value = lamMinInput.value;
    thermalRangeMax.value = lamMaxInput.value;

    // ── Absorption cross-section spectrum with the illumination-wavelength marker ──
    if (data) {
      const specXf = drawChart(thermalSpectrumCanvas, data.lambda, [{ y: data.cabs, color: '#6366F1', label: 'σabs (nm²)' }], 'λ (nm)', 'σabs (nm²)', { fontScale: 0.82 });
      const sctx = thermalSpectrumCanvas.getContext('2d')!;
      const mx = specXf.tx(lambdaNm);
      sctx.save();
      sctx.setLineDash([4, 4]); sctx.strokeStyle = '#F43F5E'; sctx.lineWidth = 1.5;
      sctx.beginPath(); sctx.moveTo(mx, specXf.pT); sctx.lineTo(mx, specXf.pT + specXf.pH); sctx.stroke();
      sctx.restore();
    }

    notesBody.innerHTML = `<ul>
      <li><strong>&lambda;</strong> — illumination wavelength of the incident plane wave, set with the λ slider or the nm entry in the σ<sub>abs</sub> box (a single value). σ<sub>abs</sub>(&lambda;) comes from NPLab's Mie theory and sets P<sub>abs</sub> = σ<sub>abs</sub>·I₀.</li>
      <li><strong>I₀</strong> — incident irradiance (plane-wave intensity, GW/m²); scales the whole temperature rise linearly.</li>
      <li><strong>T₀</strong> &amp; <strong>host &kappa;</strong> — environment temperature and the surrounding host's thermal conductivity (water ≈ 0.6, silica ≈ 1.0 W/m·K); the host sets the 1/r tail.</li>
      <li><strong>Per-layer &kappa;</strong> — thermal conductivity inside each layer (metals ≫ ⇒ ~isothermal; dielectrics give an A+B/r drop).</li>
      <li><strong>Per-layer g</strong> — electron–lattice coupling of each metal (10¹⁶ W/m³·K; gold ≈ 3, Al ≈ 30), giving T<sub>e</sub> − T<sub>l</sub> = P<sub>n</sub>/(g V<sub>n</sub>).</li>
      <li><strong>Per-layer G</strong> — Kapitza boundary conductance at each layer's outer interface (MW/m²·K; Au/water ≈ 105), giving the jump P/(4&pi;r²G).</li>
      <li>Coupled two-temperature steady state (eqs 4–9) after Meng <em>et al.</em>, ACS Nano 2017. Per-shell absorbed power from the multilayer internal-field integral ∫Im(ε)|E|² (a homogeneous sphere uses Im(ε)·V).</li>
    </ul>
    <div class="thermal-presets">
      <div class="thermal-presets-label">Reproduce paper figures (I₀ = 2 GW/m²)</div>
      <div class="thermal-preset-grid">
        ${Object.entries(THERMAL_PRESETS).map(([k, p]) => `<button type="button" class="thermal-preset-btn${k === activeThermalPreset ? ' active' : ''}" data-preset="${k}" title="${p.tip}" aria-pressed="${k === activeThermalPreset ? 'true' : 'false'}">${p.label}</button>`).join('')}
      </div>
    </div>`;
  }

  // === Chart Interactions ===

  function sizeOverlay() { const dpr = window.devicePixelRatio || 1; const r = overlay.getBoundingClientRect(); overlay.width = r.width * dpr; overlay.height = r.height * dpr; const c = overlay.getContext('2d')!; c.scale(dpr, dpr); return c; }
  function clearOverlay() { const c = sizeOverlay(); c.clearRect(0, 0, overlay.width, overlay.height); tooltip.classList.remove('visible'); }
  function nearestIdx(xArr: Float64Array, xVal: number): number { let lo = 0, hi = xArr.length - 1; while (lo < hi) { const m = (lo + hi) >> 1; if (xArr[m] < xVal) lo = m + 1; else hi = m; } if (lo > 0 && Math.abs(xArr[lo - 1] - xVal) < Math.abs(xArr[lo] - xVal)) lo--; return lo; }
  function rectsOverlap(a: ChartRect, b: ChartRect): boolean { return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y; }
  function materialLegendHit(mx: number, my: number): ChartLegendItem | null {
    if (viewTabs.value !== 'material' || !chartXforms) return null;
    return chartXforms.legendItems.find(item => mx >= item.x && mx <= item.x + item.w && my >= item.y && my <= item.y + item.h) ?? null;
  }

  let dragStart: { x: number; y: number } | null = null, isDragging = false;
  chartWrap.addEventListener('mousedown', (e: MouseEvent) => {
    if (e.button !== 0) return;
    const hit = materialLegendHit(e.offsetX, e.offsetY);
    if (hit) {
      if (hiddenMaterialSeries.has(hit.label)) hiddenMaterialSeries.delete(hit.label);
      else hiddenMaterialSeries.add(hit.label);
      dragStart = null;
      isDragging = false;
      clearOverlay();
      render();
      return;
    }
    if (viewTabs.value === 'thermal') return;   // no zoom-drag on the temperature profile
    dragStart = { x: e.offsetX, y: e.offsetY };
    isDragging = false;
  });
  chartWrap.addEventListener('mousemove', (e: MouseEvent) => {
    if (!chartXforms || !data) return;
    const { tx, ty, invTx, pL, pT, pW, pH } = chartXforms;
    const mx = e.offsetX, my = e.offsetY;
    if (materialLegendHit(mx, my)) {
      chartWrap.style.cursor = 'pointer';
      clearOverlay();
      return;
    }
    chartWrap.style.cursor = 'crosshair';
    if (dragStart) {
      if (Math.abs(mx - dragStart.x) > 5 || Math.abs(my - dragStart.y) > 5) isDragging = true;
      if (isDragging) {
        const c = sizeOverlay(); c.clearRect(0, 0, overlay.width, overlay.height);
        const x0 = Math.max(pL, Math.min(dragStart.x, mx)), x1 = Math.min(pL + pW, Math.max(dragStart.x, mx));
        const y0 = Math.max(pT, Math.min(dragStart.y, my)), y1 = Math.min(pT + pH, Math.max(dragStart.y, my));
        c.fillStyle = 'rgba(99,102,241,0.08)'; c.strokeStyle = 'rgba(99,102,241,0.4)'; c.setLineDash([4, 4]);
        c.fillRect(x0, y0, x1 - x0, y1 - y0); c.strokeRect(x0, y0, x1 - x0, y1 - y0);
        tooltip.classList.remove('visible'); return;
      }
    }
    if (mx < pL || mx > pL + pW || my < pT || my > pT + pH) { chartWrap.style.cursor = ''; clearOverlay(); return; }
    const visibleSeries = currentSeries.filter(s => !s.hidden);
    if (!visibleSeries.length) { clearOverlay(); return; }
    const xVal = invTx(mx);
    const idx = nearestIdx(currentXArr, xVal);
    const dX = currentXArr[idx], px = tx(dX);
    const c = sizeOverlay(); c.clearRect(0, 0, overlay.width, overlay.height);
    c.strokeStyle = 'rgba(99,102,241,0.4)'; c.setLineDash([4, 4]); c.lineWidth = 1;
    c.beginPath(); c.moveTo(px, pT); c.lineTo(px, pT + pH); c.stroke();
    c.setLineDash([]);
    const usesLogForTooltip = viewTabs.value !== 'material' && logY;
    for (const s of visibleSeries) {
      const dY = s.y[idx], py = ty(dY);
      if (!Number.isFinite(dY) || (usesLogForTooltip && dY <= 0)) continue;
      c.fillStyle = s.color; c.beginPath(); c.arc(px, py, 4, 0, Math.PI * 2); c.fill();
      c.strokeStyle = '#fff'; c.lineWidth = 1.5; c.beginPath(); c.arc(px, py, 4, 0, Math.PI * 2); c.stroke();
    }
    const isElectronSpectrum = excitation === 'electron' && viewTabs.value === 'spectrum';
    const xS = viewTabs.value === 'thermal'
      ? `r = ${dX.toFixed(1)} nm`
      : isElectronSpectrum && axisTabs.value === 'lambda'
      ? `\u03BB = ${dX.toFixed(1)} nm`
      : isElectronSpectrum
      ? `E_loss = ${dX.toFixed(3)} eV`
      : axisTabs.value === 'lambda'
      ? `\u03BB = ${dX.toFixed(1)} nm`
      : `E = ${dX.toFixed(3)} eV`;
    let ttHtml = xS;
    for (const s of visibleSeries) { const v = s.y[idx]; if (!Number.isFinite(v)) continue; ttHtml += `<br><span style="color:${s.color}">\u25CF</span> ${s.label} = ${fmtVal(v)}`; }
    tooltip.innerHTML = ttHtml;
    tooltip.classList.add('visible');
    const pointYs = visibleSeries.map(s => ty(s.y[idx])).filter(v => Number.isFinite(v));
    const topPy = pointYs.length ? Math.min(...pointYs) : pT + pH / 2;
    let tL = px + 12, tT = topPy - 36;
    const wrapRect = chartWrap.getBoundingClientRect();
    if (viewTabs.value === 'material') {
      tL = pL + 10;
      tT = pT + 10;
      const proposed = { x: tL, y: tT, w: tooltip.offsetWidth, h: tooltip.offsetHeight };
      if (chartXforms.legendBox && rectsOverlap(proposed, chartXforms.legendBox)) {
        tL = Math.max(4, chartXforms.legendBox.x - tooltip.offsetWidth - 12);
      }
    } else {
      if (tL + tooltip.offsetWidth > wrapRect.width - 4) tL = px - tooltip.offsetWidth - 12;
      if (tT < 4) tT = topPy + 12;
    }
    tL = Math.max(4, Math.min(tL, wrapRect.width - tooltip.offsetWidth - 4));
    tT = Math.max(4, Math.min(tT, wrapRect.height - tooltip.offsetHeight - 4));
    tooltip.style.left = tL + 'px'; tooltip.style.top = tT + 'px';
  });
  chartWrap.addEventListener('mouseup', (e: MouseEvent) => {
    if (isDragging && dragStart && chartXforms) {
      const { invTx, invTy, pL, pT, pW, pH } = chartXforms;
      const x0 = Math.max(pL, Math.min(dragStart.x, e.offsetX)), x1 = Math.min(pL + pW, Math.max(dragStart.x, e.offsetX));
      const y0 = Math.max(pT, Math.min(dragStart.y, e.offsetY)), y1 = Math.min(pT + pH, Math.max(dragStart.y, e.offsetY));
      if (x1 - x0 > 10 && y1 - y0 > 10) { zoomBounds = { xRange: [invTx(x0), invTx(x1)], yRange: [invTy(y1), invTy(y0)] }; render(); }
    }
    dragStart = null; isDragging = false;
  });
  chartWrap.addEventListener('mouseleave', () => { dragStart = null; isDragging = false; chartWrap.style.cursor = ''; clearOverlay(); });
  chartWrap.addEventListener('dblclick', () => { if (zoomBounds) { zoomBounds = null; render(); } });

  // === Config Check ===

  const MAT_COLORS: Record<string, string> = { au:'#FFD700', ag:'#C0C0C0', si:'#7B68EE', al:'#87CEEB', tio2:'#DDA0DD', drude:'#60A5FA', custom:'#90EE90', file:'#FFA07A', rii:'#FFA07A' };
  const MAT_NAMES: Record<string, string> = { au:'Au', ag:'Ag', si:'Si', al:'Al', tio2:'TiO\u2082', drude:'Drude', custom:'Custom \u03B5', file:'File', rii:'Database' };

  function withSvgMarkerId(svg: string, markerId: string): string {
    return svg.replace('id="arr"', `id="${markerId}"`).replace(/url\(#arr\)/g, `url(#${markerId})`);
  }

  function updateConfigCheck() {
    interface CLayer { r: number; mat: string; eps: number; ref: string; name: string; }
    const layers: CLayer[] = [];
    if (geometry === 'coreshell') {
      layers.push({ r: coreRParam.value, mat: coreMaterialSelect.value, eps: coreEpsParam.value, ref: coreMaterialRefEl.textContent || '', name: 'Core' });
      layers.push({ r: rParam.value, mat: materialSelect.value, eps: epsParam.value, ref: materialRefEl.textContent || '', name: 'Shell 1' });
      for (let i = 0; i < extraShells.length; i++) {
        const sh = extraShells[i];
        layers.push({ r: sh.rParam.value, mat: sh.material.value, eps: sh.epsParam.value, ref: sh.refEl.textContent || '', name: `Shell ${i+2}` });
      }
    } else {
      layers.push({ r: rParam.value, mat: materialSelect.value, eps: epsParam.value, ref: materialRefEl.textContent || '', name: 'Particle' });
    }

    const maxR = layers[layers.length - 1].r;
    const hostPresets: Record<string, string> = { '1.00':'Air', '1.33':'Water', '1.46':'Oil', '1.50':'Glass' };
    const nhStr = nhParam.value.toFixed(2);
    const hostLabel = hostPresets[nhStr] ? `${hostPresets[nhStr]} (n=${nhStr})` : `n\u2095 = ${nhStr}`;
    const spectralLabel = excitation === 'electron'
      ? `E_loss ${electronEminInput.value}\u2013${electronEmaxInput.value} eV`
      : `\u03BB ${lamMinInput.value}\u2013${lamMaxInput.value} nm`;

    // Full-width annotated cross-section SVG
    const W = 280, circR = 44, cx = 68;
    const labelX = cx + circR + (excitation === 'electron' ? 34 : 14);
    const rowH = layers.length > 3 ? 18 : 22;
    const H = Math.max(circR * 2 + 74, layers.length * rowH + 70);
    const cy = 24 + circR;
    const ct = chartTheme();
    let s = `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg">`;
    // Background
    s += `<rect width="${W}" height="${H}" fill="${ct.grid}" rx="6"/>`;
    // Spectral and host labels
    s += `<text x="${cx}" y="${H-8}" text-anchor="middle" fill="${ct.textMuted}" font-size="7" font-family="Inter,system-ui">${spectralLabel}</text>`;
    s += `<text x="${W - 8}" y="${H-8}" text-anchor="end" fill="${ct.textMuted}" font-size="7.5" font-family="Inter,system-ui">${hostLabel}</text>`;
    // Concentric circles (outer to inner)
    for (let i = layers.length - 1; i >= 0; i--) {
      const r = Math.max(5, (layers[i].r / maxR) * circR);
      s += `<circle cx="${cx}" cy="${cy}" r="${r}" fill="${MAT_COLORS[layers[i].mat] || '#ddd'}" stroke="rgba(0,0,0,0.25)" stroke-width="0.7"/>`;
    }
    if (excitation === 'electron') {
      const trajX = cx + Math.min(circR + 12, (electronBParam.value / maxR) * circR);
      const y1 = cy - circR - 16;
      const y2 = cy + circR + 18;
      s += `<text x="8" y="14" fill="${ct.textMuted}" font-size="7.5" font-weight="700" font-family="Inter,system-ui">R=${maxR} nm</text>`;
      s += `<line x1="${trajX}" y1="${y1}" x2="${trajX}" y2="${y2}" stroke="#2563EB" stroke-width="1.5" stroke-linecap="round" marker-end="url(#arr)"/>`;
      s += `<text x="${trajX + 4}" y="${y1 + 21}" fill="#2563EB" font-size="7.5" font-family="Inter,system-ui">b=${electronBParam.value.toFixed(0)} nm</text>`;
      s += `<text x="${trajX + 4}" y="${y1 + 10}" fill="#2563EB" font-size="8" font-weight="700" font-family="Inter,system-ui">e<tspan baseline-shift="super" font-size="6">-</tspan></text>`;
    }
    // Dimension lines and labels
    const labStartY = cy - (layers.length - 1) * rowH / 2;
    for (let i = 0; i < layers.length; i++) {
      const r = Math.max(5, (layers[i].r / maxR) * circR);
      const ly = labStartY + i * rowH;
      const edgeX = cx + r;
      // Leader line
      s += `<line x1="${edgeX}" y1="${cy}" x2="${labelX - 2}" y2="${ly}" stroke="${ct.textMuted}" stroke-width="0.6" stroke-dasharray="2,2"/>`;
      s += `<circle cx="${edgeX}" cy="${cy}" r="1.5" fill="${MAT_COLORS[layers[i].mat] || '#ddd'}" stroke="rgba(0,0,0,0.3)" stroke-width="0.5"/>`;
      // Layer name + material
      const matLabel = layers[i].mat === 'custom' ? `\u03B5=${layers[i].eps}` : (MAT_NAMES[layers[i].mat] || layers[i].mat);
      const refParts = layers[i].ref ? layers[i].ref.split(':')[0].split(' ').slice(0, 2).join(' ') : '';
      const detail = refParts ? `${matLabel} (${refParts})` : matLabel;
      s += `<text x="${labelX}" y="${ly - 1}" fill="${ct.text}" font-size="8.5" font-weight="600" font-family="Inter,system-ui">${layers[i].name}</text>`;
      s += `<text x="${labelX}" y="${ly + 9}" fill="${ct.textSoft}" font-size="7.5" font-family="Inter,system-ui">${detail} \u00B7 R=${layers[i].r} nm</text>`;
    }
    // Radius dimension arrow (bottom)
    const arrowY = cy + circR + 10;
    s += `<line x1="${cx}" y1="${arrowY}" x2="${cx + circR}" y2="${arrowY}" stroke="${ct.textMuted}" stroke-width="0.7" marker-end="url(#arr)"/>`;
    s += `<line x1="${cx}" y1="${arrowY-3}" x2="${cx}" y2="${arrowY+3}" stroke="${ct.textMuted}" stroke-width="0.7"/>`;
    s += `<defs><marker id="arr" markerWidth="4" markerHeight="4" refX="3" refY="2" orient="auto"><path d="M0,0 L4,2 L0,4" fill="none" stroke="${ct.textMuted}" stroke-width="0.7"/></marker></defs>`;
    if (excitation !== 'electron') {
      s += `<text x="${cx + circR/2}" y="${arrowY + 9}" text-anchor="middle" fill="${ct.textMuted}" font-size="7" font-family="Inter,system-ui">${maxR} nm</text>`;
    }
    s += '</svg>';
    configCheckEl.innerHTML = withSvgMarkerId(s, 'mie-config-radius-arrow');
    configCheckEl.setAttribute('aria-label', `Open enlarged structure drawing for ${geometry === 'coreshell' ? 'core-shell particle' : 'sphere'}`);
    structureDialogArt.innerHTML = withSvgMarkerId(s, 'mie-config-radius-arrow-modal');
  }

  configCheckEl.addEventListener('click', () => {
    if (typeof structureDialog.showModal === 'function') structureDialog.showModal();
    else structureDialog.setAttribute('open', '');
  });
  structureDialogClose.addEventListener('click', () => structureDialog.close());
  structureDialog.addEventListener('click', (e: MouseEvent) => {
    if (e.target === structureDialog) structureDialog.close();
  });

  // === Downloads ===

  function downloadBlob(blob: Blob, fn: string) { const u = URL.createObjectURL(blob); const a = document.createElement('a'); a.href = u; a.download = fn; a.click(); URL.revokeObjectURL(u); }
  function filenameStem() {
    const m = materialSelect.value;
    const matPart = m === 'custom' ? 'eps' + epsParam.value : m === 'drude' ? `drude_wp${readDrude(drudeHandle).wp}` : m;
    if (excitation === 'electron') return `electron_sphere_${matPart}_R${rParam.value}nm_b${electronBParam.value}nm`;
    if (geometry === 'coreshell') {
      const nLayers = 1 + 1 + extraShells.length; // core + shell1 + extras
      return `mie_${nLayers}layer_n${nhParam.value}`;
    }
    return `mie_${matPart}_R${rParam.value}nm_n${nhParam.value}`;
  }

  function materialLabelForExport(mat: string, eps: number, handle: DrudeHandle, ref = ''): string {
    if (mat === 'custom') return `eps_r=${eps}`;
    if (mat === 'drude') {
      const { epsB, wp, gamma } = readDrude(handle);
      return `drude(eps_b=${epsB},wp_eV=${wp},gamma_eV=${gamma})`;
    }
    if (mat === 'file' || mat === 'rii') return ref || mat;
    return `material=${mat} (${MATERIALS[mat].ref})`;
  }

  function exportStructurePng() {
    const svg = structureDialogArt.querySelector('svg') as SVGSVGElement | null;
    if (!svg) return;
    const copy = svg.cloneNode(true) as SVGSVGElement;
    const viewBox = (copy.getAttribute('viewBox') || '').split(/\s+/).map(Number);
    const width = viewBox.length === 4 && Number.isFinite(viewBox[2]) ? viewBox[2] : 780;
    const height = viewBox.length === 4 && Number.isFinite(viewBox[3]) ? viewBox[3] : 360;
    copy.setAttribute('width', width.toString());
    copy.setAttribute('height', height.toString());
    const svgBlob = new Blob([new XMLSerializer().serializeToString(copy)], { type: 'image/svg+xml;charset=utf-8' });
    const url = URL.createObjectURL(svgBlob);
    const img = new Image();
    img.onload = () => {
      const scale = 4;
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(width * scale);
      canvas.height = Math.round(height * scale);
      const ctx = canvas.getContext('2d')!;
      ctx.scale(scale, scale);
      ctx.fillStyle = chartTheme().bg;
      ctx.fillRect(0, 0, width, height);
      ctx.drawImage(img, 0, 0, width, height);
      URL.revokeObjectURL(url);
      canvas.toBlob(blob => { if (blob) downloadBlob(blob, filenameStem() + '_structure.png'); }, 'image/png');
    };
    img.onerror = () => URL.revokeObjectURL(url);
    img.src = url;
  }

  function csvCell(value: string | number): string {
    const s = String(value).replace(/\s+/g, ' ').trim();
    return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  }

  function exportStructureCsv() {
    const spectralRange = excitation === 'electron'
      ? `E_loss=${electronEminInput.value}-${electronEmaxInput.value} eV`
      : `lambda=${lamMinInput.value}-${lamMaxInput.value} nm`;
    const rows: Array<Array<string | number>> = [
      [`# Mie structure drawing, excitation=${excitation}, geometry=${geometry}, n_host=${nhParam.value}, ${spectralRange}`],
      ['# Generated by NanophotonicsLab (nanophotonicslab.com)'],
      ['layer', 'material', 'epsilon_r', 'outer_radius_nm', 'reference'],
    ];
    const addRow = (layer: string, mat: string, eps: number, radius: number, ref: string) => {
      rows.push([layer, MAT_NAMES[mat] || mat, mat === 'custom' ? eps : '', radius, ref]);
    };
    if (geometry === 'coreshell') {
      addRow('Core', coreMaterialSelect.value, coreEpsParam.value, coreRParam.value, coreMaterialRefEl.textContent || '');
      addRow('Shell 1', materialSelect.value, epsParam.value, rParam.value, materialRefEl.textContent || '');
      for (let i = 0; i < extraShells.length; i++) {
        const sh = extraShells[i];
        addRow(`Shell ${i + 2}`, sh.material.value, sh.epsParam.value, sh.rParam.value, sh.refEl.textContent || '');
      }
    } else {
      addRow('Particle', materialSelect.value, epsParam.value, rParam.value, materialRefEl.textContent || '');
    }
    if (excitation === 'electron') {
      rows.push([]);
      rows.push(['electron_trajectory', 'impact_parameter_nm', electronBParam.value, 'beta', electronBetaParam.value]);
      rows.push(['electron_numerics', 'lmax', electronLmaxParam.value, 'q_c_nm^-1', electronQcParam.value, 'z_quadrature', electronNzParam.value]);
    }
    const lines = rows.map(row => row.map(csvCell).join(','));
    downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), filenameStem() + '_structure.csv');
  }

  structureExportPng.addEventListener('click', exportStructurePng);
  structureExportCsv.addEventListener('click', exportStructureCsv);

  document.getElementById('dl-png')!.addEventListener('click', () => {
    const ec = document.createElement('canvas'); const s = 2, w = 1200, h = 720;
    ec.width = w * s; ec.height = h * s; const cx = ec.getContext('2d')!; cx.scale(s, s);
    const or = ec.getBoundingClientRect.bind(ec);
    ec.getBoundingClientRect = () => ({ ...or(), width: w, height: h, top: 0, left: 0, right: w, bottom: h, x: 0, y: 0, toJSON() { return this; } });
    if (viewTabs.value === 'thermal' && thermalExport) {
      const opts: ChartOpts = { bands: thermalExport.bands, fontScale: w / canvas.getBoundingClientRect().width };
      const sd = window.devicePixelRatio;
      Object.defineProperty(window, 'devicePixelRatio', { value: 1, writable: true, configurable: true });
      const xf = drawChart(ec, thermalExport.xArr, thermalExport.series, 'r (nm)', 'Temperature (°C)', opts);
      const tctx = ec.getContext('2d')!;
      const yT0 = xf.ty(thermalExport.T0c);
      if (yT0 >= xf.pT && yT0 <= xf.pT + xf.pH) {
        tctx.save();
        tctx.setLineDash([4 * opts.fontScale!, 4 * opts.fontScale!]); tctx.strokeStyle = 'rgba(107,114,128,0.7)'; tctx.lineWidth = 1.5;
        tctx.beginPath(); tctx.moveTo(xf.pL, yT0); tctx.lineTo(xf.pL + xf.pW, yT0); tctx.stroke();
        tctx.setLineDash([]); tctx.fillStyle = 'rgba(107,114,128,0.95)'; tctx.font = `600 ${Math.round(10 * opts.fontScale!)}px Inter, system-ui, sans-serif`;
        tctx.textAlign = 'right'; tctx.textBaseline = 'bottom';
        tctx.fillText('T₀', xf.pL + xf.pW - 3, yT0 - 2);
        tctx.restore();
      }
      Object.defineProperty(window, 'devicePixelRatio', { value: sd, writable: true, configurable: true });
      ec.toBlob(b => { if (b) downloadBlob(b, filenameStem() + '_thermal.png'); }, 'image/png');
      return;
    }
    const materialPlot = viewTabs.value === 'material' ? getMaterialPlotData() : null;
    const electronPlot = !materialPlot && excitation === 'electron' ? getElectronPlotData() : null;
    const spectrumPlot = materialPlot || electronPlot ? null : getPlotData();
    const xArr = materialPlot?.xArr ?? electronPlot?.xArr ?? spectrumPlot!.xArr;
    const series = materialPlot?.series ?? electronPlot?.series ?? spectrumPlot!.series;
    const xLabel = materialPlot?.xLabel ?? electronPlot?.xLabel ?? spectrumPlot!.xLabel;
    const yLabel = materialPlot?.yLabel ?? electronPlot?.yLabel ?? spectrumPlot!.yLabel;
    const opts: ChartOpts = { logY: materialPlot ? false : logY, fontScale: w / canvas.getBoundingClientRect().width };
    if (materialPlot) opts.yRange = materialPlot.yRange;
    if (electronPlot && !logY) opts.yRange = seriesRange(electronPlot.series);
    if (zoomBounds) { opts.xRange = zoomBounds.xRange; opts.yRange = zoomBounds.yRange; }
    const sd = window.devicePixelRatio;
    Object.defineProperty(window, 'devicePixelRatio', { value: 1, writable: true, configurable: true });
    drawChart(ec, xArr, series, xLabel, yLabel, opts);
    Object.defineProperty(window, 'devicePixelRatio', { value: sd, writable: true, configurable: true });
    ec.toBlob(b => { if (b) downloadBlob(b, filenameStem() + '.png'); }, 'image/png');
  });

  document.getElementById('dl-csv')!.addEventListener('click', () => {
    if (viewTabs.value === 'thermal' && thermalExport) {
      const p = thermalExport.params;
      const layerDesc = p.mats.map((m, i) =>
        `${matBandLabel(m)} r=${p.radiiNm[i]}nm kappa=${p.kappa[i]}W/mK g=${(p.gEl[i] / 1e16)}e16W/m3K G=${(p.Gtbc[i] / 1e6)}MW/m2K`).join(' | ');
      const lines = [
        '# Photothermal radial temperature profile (two-temperature model, Meng et al., ACS Nano 2017)',
        `# lambda=${p.lambdaNm} nm, I0=${p.I0gw} GW/m^2, T0=${thermalExport.T0c} C, host kappa=${p.kappaMed} W/mK, n_host=${p.nHost}`,
        `# Cabs=${(p.Cabs * 1e18).toFixed(3)} nm^2, Pabs=${(p.Pabs * 1e6).toFixed(5)} uW`,
        `# Layers (core->out): ${layerDesc}`,
        '# Generated by NanophotonicsLab (nanophotonicslab.com)',
        'r_nm,T_electron_C,T_lattice_C,T_host_C',
      ];
      const { xArr, Te, Tl, Tw } = thermalExport;
      const f = (v: number) => Number.isFinite(v) ? v.toFixed(4) : '';
      for (let i = 0; i < xArr.length; i++)
        lines.push([xArr[i].toFixed(4), f(Te[i]), f(Tl[i]), f(Tw[i])].join(','));
      downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), filenameStem() + '_thermal.csv');
      return;
    }
    if (viewTabs.value === 'material') {
      const lines = [
        `# Mie material function, lambda=${lamMinInput.value}-${lamMaxInput.value} nm`,
        '# Generated by NanophotonicsLab (nanophotonicslab.com)',
        'wavelength_nm,n,k,epsilon_re,epsilon_im',
      ];
      for (let i = 0; i < data.lambda.length; i++) {
        const [nr, ki] = getDielectric(data.lambda[i]);
        lines.push([
          data.lambda[i].toFixed(4),
          nr.toFixed(8),
          ki.toFixed(8),
          (nr * nr - ki * ki).toFixed(8),
          (2 * nr * ki).toFixed(8),
        ].join(','));
      }
      downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), filenameStem() + '_material.csv');
      return;
    }

    if (excitation === 'electron' && electronData) {
      const lines = [
        `# Electron-sphere EELS/CL, R=${rParam.value} nm, b=${electronBParam.value} nm, beta=${electronBetaParam.value}, lmax=${electronLmaxParam.value}, q_c=${electronQcParam.value} nm^-1`,
        '# Generated by NanophotonicsLab (nanophotonicslab.com)',
        '# References: Garcia de Abajo, Phys. Rev. B 59, 3095 (1999); Stamatopoulou et al., Phys. Rev. Research 6, 013239 (2024).',
        'energy_eV,eels_total,eels_surface,eels_bulk,eels_begrenzung,eels_electric,eels_magnetic,cl_total,cl_electric,cl_magnetic',
      ];
      for (let i = 0; i < electronData.energy.length; i++) {
        lines.push([
          electronData.energy[i].toFixed(6),
          electronData.eelsTotal[i].toExponential(8),
          electronData.eelsSurface[i].toExponential(8),
          electronData.eelsBulk[i].toExponential(8),
          electronData.eelsBegrenzung[i].toExponential(8),
          electronData.eelsElectric[i].toExponential(8),
          electronData.eelsMagnetic[i].toExponential(8),
          electronData.clTotal[i].toExponential(8),
          electronData.clElectric[i].toExponential(8),
          electronData.clMagnetic[i].toExponential(8),
        ].join(','));
      }
      downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), filenameStem() + '_electron.csv');
      return;
    }

    const mat = materialSelect.value;
    const matS = materialLabelForExport(mat, epsParam.value, drudeHandle, materialRefEl.textContent || '');
    let headerLine: string;
    if (geometry === 'coreshell') {
      const nLayers = 1 + 1 + extraShells.length;
      headerLine = `# Multi-shell Mie (${nLayers} layers), n_host=${nhParam.value}, lambda=${lamMinInput.value}-${lamMaxInput.value} nm`;
    } else {
      headerLine = `# Mie scattering — ${matS}, R=${rParam.value} nm, n_host=${nhParam.value}, lambda=${lamMinInput.value}-${lamMaxInput.value} nm`;
    }
    const lines = [
      headerLine,
      '# Generated by NanophotonicsLab (nanophotonicslab.com)',
      'wavelength_nm,energy_eV,Csca_nm2,Cext_nm2,Cabs_nm2,Qsca',
    ];
    for (let i = 0; i < data.lambda.length; i++)
      lines.push([data.lambda[i].toFixed(4), data.energy[i].toFixed(6), data.csca[i].toFixed(6), data.cext[i].toFixed(6), data.cabs[i].toFixed(6), data.qsca[i].toFixed(8)].join(','));
    downloadBlob(new Blob([lines.join('\n') + '\n'], { type: 'text/csv' }), filenameStem() + '.csv');
  });

  // === Share / URL State ===

  function serializeState(): string {
    const p = new URLSearchParams();
    p.set('exc', excitation);
    p.set('geo', geometry);
    p.set('mat', materialSelect.value);
    if (materialSelect.value === 'custom') p.set('eps', epsParam.value.toString());
    p.set('r', rParam.value.toString());
    p.set('nh', nhParam.value.toString());
    p.set('lmin', lamMinInput.value);
    p.set('lmax', lamMaxInput.value);
    p.set('view', viewTabs.value);
    p.set('qty', qtyTabs.value);
    p.set('decomp', decompTabs.value);
    p.set('axis', axisTabs.value);
    p.set('mprop', materialPropTabs.value);
    if (materialSelect.value === 'drude') {
      const d = readDrude(drudeHandle);
      p.set('depsb', d.epsB.toString());
      p.set('dwp', d.wp.toString());
      p.set('dgamma', d.gamma.toString());
    }
    p.set('esig', electronSignalTabs.value);
    p.set('edec', electronDecompTabs.value);
    p.set('eb', electronBParam.value.toString());
    p.set('ebeta', electronBetaParam.value.toString());
    p.set('emin', electronEminInput.value);
    p.set('emax', electronEmaxInput.value);
    p.set('elmax', electronLmaxParam.value.toString());
    p.set('eqc', electronQcParam.value.toString());
    p.set('enz', electronNzParam.value.toString());
    p.set('pol', polTabs.value);
    p.set('al', angularLambdaInput.value);
    if (logY) p.set('logY', '1');
    if (geometry === 'coreshell') {
      p.set('cmat', coreMaterialSelect.value);
      if (coreMaterialSelect.value === 'custom') p.set('ceps', coreEpsParam.value.toString());
      if (coreMaterialSelect.value === 'drude') {
        const d = readDrude(coreDrudeHandle);
        p.set('cdepsb', d.epsB.toString());
        p.set('cdwp', d.wp.toString());
        p.set('cdgamma', d.gamma.toString());
      }
      p.set('cr', coreRParam.value.toString());
      for (let i = 0; i < extraShells.length; i++) {
        const sh = extraShells[i];
        p.set(`s${i + 2}mat`, sh.material.value);
        if (sh.material.value === 'custom') p.set(`s${i + 2}eps`, sh.epsParam.value.toString());
        if (sh.material.value === 'drude') {
          const d = readDrude(sh.drudeHandle);
          p.set(`s${i + 2}depsb`, d.epsB.toString());
          p.set(`s${i + 2}dwp`, d.wp.toString());
          p.set(`s${i + 2}dgamma`, d.gamma.toString());
        }
        p.set(`s${i + 2}r`, sh.rParam.value.toString());
      }
    }
    return p.toString();
  }

  function restoreState() {
    const hash = location.hash.slice(1);
    if (!hash) return;
    const p = new URLSearchParams(hash);
    const ex = p.get('exc');
    if (ex === 'electron') { excitation = 'electron'; excitationTabs.select('electron', true); }
    const g = p.get('geo');
    if (g === 'coreshell') geoTabs.select('coreshell');
    const mat = p.get('mat');
    if (mat && !['file', 'rii'].includes(mat)) { materialSelect.value = mat; materialSelect.dispatchEvent(new Event('change')); }
    if (mat === 'custom' && p.has('eps')) epsParam.setValue(parseFloat(p.get('eps')!));
    if (mat === 'drude') {
      setDrude(
        drudeHandle,
        p.has('depsb') ? parseFloat(p.get('depsb')!) : readDrude(drudeHandle).epsB,
        p.has('dwp') ? parseFloat(p.get('dwp')!) : readDrude(drudeHandle).wp,
        p.has('dgamma') ? parseFloat(p.get('dgamma')!) : readDrude(drudeHandle).gamma,
      );
      materialRefEl.textContent = drudeRef(drudeHandle);
    }
    if (p.has('r')) rParam.setValue(parseFloat(p.get('r')!));
    if (p.has('nh')) nhParam.setValue(parseFloat(p.get('nh')!));
    if (p.has('lmin')) { lamMinInput.value = p.get('lmin')!; lamMinInput.dispatchEvent(new Event('change')); }
    if (p.has('lmax')) { lamMaxInput.value = p.get('lmax')!; lamMaxInput.dispatchEvent(new Event('change')); }
    if (p.has('al')) angularLambdaInput.value = p.get('al')!;
    if (p.has('eb')) electronBParam.setValue(parseFloat(p.get('eb')!));
    if (p.has('ebeta')) electronBetaParam.setValue(parseFloat(p.get('ebeta')!));
    if (p.has('emin')) electronEminInput.value = p.get('emin')!;
    if (p.has('emax')) electronEmaxInput.value = p.get('emax')!;
    if (p.has('elmax')) electronLmaxParam.setValue(parseFloat(p.get('elmax')!));
    if (p.has('eqc')) electronQcParam.setValue(parseFloat(p.get('eqc')!));
    if (p.has('enz')) electronNzParam.setValue(parseFloat(p.get('enz')!));
    if (p.get('logY') === '1') { logY = true; logToggle.classList.add('active'); }
    if (g === 'coreshell') {
      const cm = p.get('cmat');
      if (cm && !['file', 'rii'].includes(cm)) { coreMaterialSelect.value = cm; coreMaterialSelect.dispatchEvent(new Event('change')); }
      if (cm === 'custom' && p.has('ceps')) coreEpsParam.setValue(parseFloat(p.get('ceps')!));
      if (cm === 'drude') {
        setDrude(
          coreDrudeHandle,
          p.has('cdepsb') ? parseFloat(p.get('cdepsb')!) : readDrude(coreDrudeHandle).epsB,
          p.has('cdwp') ? parseFloat(p.get('cdwp')!) : readDrude(coreDrudeHandle).wp,
          p.has('cdgamma') ? parseFloat(p.get('cdgamma')!) : readDrude(coreDrudeHandle).gamma,
        );
        coreMaterialRefEl.textContent = drudeRef(coreDrudeHandle);
      }
      if (p.has('cr')) coreRParam.setValue(parseFloat(p.get('cr')!));
    }
    // Restore tab selections (silent to avoid intermediate renders)
    if (p.has('qty')) qtyTabs.select(p.get('qty')!, true);
    if (p.has('decomp')) decompTabs.select(p.get('decomp')!, true);
    if (p.has('axis')) axisTabs.select(p.get('axis')!, true);
    if (p.has('mprop')) materialPropTabs.select(p.get('mprop')!, true);
    if (p.has('esig')) electronSignalTabs.select(p.get('esig')!, true);
    if (p.has('edec')) electronDecompTabs.select(p.get('edec')!, true);
    if (p.has('pol')) polTabs.select(p.get('pol')!, true);
    if (p.has('view')) viewTabs.select(p.get('view')!);
    updateExcitationUI();
  }

  const shareBtn = document.getElementById('dl-share')!;
  shareBtn.addEventListener('click', () => {
    const url = location.origin + location.pathname + '#' + serializeState();
    navigator.clipboard.writeText(url).then(() => {
      const orig = shareBtn.textContent;
      shareBtn.textContent = 'Copied!';
      setTimeout(() => { shareBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> Share'; }, 1500);
    });
  });

  if (location.hash.slice(1)) restoreState();
  updateDecompAvailability();
  updateElectronDecompAvailability();
  updateExcitationUI();
  updateElectronRadiusMarker();
  new ResizeObserver(() => render()).observe(canvas);
  onThemeChange(() => render());
  recompute(); render(); updateConfigCheck();
</script>
