            </div>
          </div>
          <div class="structure-dialog__art" id="structure-dialog-art"></div>
        </div>
      </dialog>

      <dialog class="material-import-dialog" id="material-import-dialog" aria-labelledby="material-import-title">
        <div class="material-import-dialog__panel">
          <div class="material-import-dialog__header">
            <div>
              <h3 id="material-import-title">Confirm Material Import</h3>
              <p id="material-import-file">No file selected</p>
            </div>
            <button type="button" class="structure-dialog__close" id="material-import-close" aria-label="Cancel material import">&times;</button>
          </div>
          <div class="material-import-dialog__grid">
            <label>
              <span>First column</span>
              <select id="material-import-axis" class="param-select">
                <option value="energy-ev">Photon energy (eV)</option>
                <option value="wavelength-nm">Wavelength (nm)</option>
