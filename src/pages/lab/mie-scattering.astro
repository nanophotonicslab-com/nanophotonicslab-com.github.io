    for (let i = 0; i < xArr.length; i++) { if (xArr[i] < dxMin) dxMin = xArr[i]; if (xArr[i] > dxMax) dxMax = xArr[i]; }
    for (const s of series) for (let i = 0; i < s.y.length; i++) { if (s.y[i] > dyMax) dyMax = s.y[i]; if (s.y[i] > 0 && s.y[i] < dyMin) dyMin = s.y[i]; }
