  function setupRIISearch(
    searchGroup: HTMLElement, searchInput: HTMLInputElement,
    resultsList: HTMLElement, statusEl: HTMLElement, refEl: HTMLElement,
    onLoaded: (data: number[][]) => void,
  ) {
    let catalog: RIIMaterial[] | null = null;
    let debounce: ReturnType<typeof setTimeout>;

    function showResults(q: string) {
      if (!catalog) return;
      const hits = searchCatalog(catalog, q);
      resultsList.innerHTML = hits.map((m, i) =>
        `<div class="rii-result" data-idx="${i}"><span class="rii-result-book">${m.bookName}</span><br><span class="rii-result-page">${m.pageName}</span></div>`
      ).join('');
      (resultsList as any)._hits = hits;
    }

    async function ensureCatalog() {
      if (catalog) { showResults(searchInput.value); return; }
      statusEl.textContent = 'Loading catalog\u2026';
      try {
        catalog = await loadCatalog();
        statusEl.textContent = `${catalog.length} materials available`;
        showResults(searchInput.value);
      } catch { statusEl.textContent = 'Failed to load catalog'; }
    }

    searchInput.addEventListener('input', () => { clearTimeout(debounce); debounce = setTimeout(() => showResults(searchInput.value), 150); });
    searchInput.addEventListener('focus', () => { if (catalog) showResults(searchInput.value); });

    resultsList.addEventListener('click', async (e) => {
      const el = (e.target as HTMLElement).closest('.rii-result') as HTMLElement;
      if (!el) return;
      const hits = (resultsList as any)._hits as RIIMaterial[];
      const mat = hits[parseInt(el.dataset.idx!)];
      statusEl.textContent = 'Loading\u2026';
      resultsList.innerHTML = '';
      try {
        const d = await fetchMaterialNK(mat.dataPath);
        refEl.textContent = mat.pageName;
        statusEl.textContent = `${d.length} points loaded`;
        searchInput.value = mat.bookName;
        onLoaded(d);
      } catch { statusEl.textContent = 'Failed to load material'; }
    });

    return { ensureCatalog };
  }

