        s2Re += w * (coeffs.aRe[n-1] * tau + coeffs.bRe[n-1] * piCur);
        s2Im += w * (coeffs.aIm[n-1] * tau + coeffs.bIm[n-1] * piCur);
        const piNext = ((2 * n + 1) / n) * mu * piCur - ((n + 1) / n) * piPrev;
        piPrev = piCur; piCur = piNext;
