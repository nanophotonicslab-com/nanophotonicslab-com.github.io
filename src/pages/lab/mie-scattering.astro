  // ── dipole figure-reproduction presets (Kim 1988 + Carella thesis) ──
  interface DipolePreset { label: string; tip: string; region: 'outside' | 'inside'; cavity?: boolean; eps: { re: number; im: number }; mat: string; customEps?: number; lambda: number; aNm: number; dMin: number; dMax: number; lmax: number; f?: number; logY: boolean; yBot?: number; yTop?: number; }
  const DIPOLE_PRESETS: Record<string, DipolePreset> = {
    kim1: { label: 'Fig. 1 · outside Ag', tip: 'Kim et al. 1988, Fig. 1 — dipole outside a 10 nm Ag sphere (ε = −4.42 + 0.73i), λ = 413.3 nm, ℓmax = 20',
            region: 'outside', eps: { re: -4.42, im: 0.73 }, mat: 'ag', lambda: 413.3, aNm: 10, dMin: 1.02, dMax: 9, lmax: 20, logY: false, yTop: 2 },
    kim2: { label: 'Fig. 2 · cavity', tip: 'Kim et al. 1988, Fig. 2 — dipole in a 400 nm vacuum cavity in a dielectric (ε = 2.16), λ = 413.3 nm, ℓmax = 30',
            region: 'inside', cavity: true, eps: { re: 2.16, im: 0 }, mat: 'custom', customEps: 2.16, lambda: 413.3, aNm: 400, dMin: 0, dMax: 1, lmax: 30, logY: false, yBot: 0.8, yTop: 2.2 },
    kim4: { label: 'Fig. 4 · inside (transparent)', tip: 'Kim et al. 1988, Fig. 4 — dipole inside a 400 nm transparent sphere (ε = 2.16), λ = 413.3 nm, ℓmax = 30',
            region: 'inside', eps: { re: 2.16, im: 0 }, mat: 'custom', customEps: 2.16, lambda: 413.3, aNm: 400, dMin: 0, dMax: 1, lmax: 30, logY: false, yTop: 1.25 },
    kim5: { label: 'Fig. 5 · inside (dissipative)', tip: 'Kim et al. 1988, Fig. 5 — dipole inside a 100 nm Ag sphere (ε = −4.42 + 0.73i), f(ω) = 6.88×10⁻⁸, ℓmax = 10',
            region: 'inside', eps: { re: -4.42, im: 0.73 }, mat: 'ag', lambda: 413.3, aNm: 100, dMin: 0, dMax: 1, lmax: 10, f: 6.88e-8, logY: false },
  };

  function applyDipolePreset(key: string): void {
    const p = DIPOLE_PRESETS[key];
    if (!p) return;
    applyingDipolePreset = true;
    activeDipolePreset = key;
    try {
      excitationTabs.select('dipole', true);
      excitation = 'dipole';
      document.querySelector<HTMLButtonElement>('#view-tabs [data-view="spectrum"]')?.click();
      dipoleEpsOverride = { ...p.eps };            // exact reference permittivity (used for the curve)
      dipoleCavity = p.cavity === true;            // Fig. 2 = vacuum cavity in a dielectric
      dipoleRegionTabs.select(p.region, true);
      dipoleRegion = p.region;
      // pick a matching material so the Material view shows a coherent ε(λ)
      setSelectValue(materialSelect, p.mat);
      if (p.mat === 'custom' && p.customEps !== undefined) {
        relaxStepSlider(document.getElementById('eps-slider') as HTMLInputElement);
        epsParam.setValue(p.customEps);
      }
      relaxRadiusSlider(document.getElementById('r-slider') as HTMLInputElement);
      rParam.setValue(p.aNm);
      nhParam.setValue(1.0);                        // all reference figures use a vacuum host
      dipoleLambdaParam.setValue(p.lambda);
      dipoleDMinInput.value = String(p.dMin);
      dipoleDMaxInput.value = String(p.dMax);
      dipoleLmaxParam.setValue(p.lmax);
      if (p.f !== undefined) dipoleFInput.value = String(p.f);
      // fill the manual y-window to the figure's paper window (blank = auto for figures without one)
      dipoleYMinInput.value = p.yTop !== undefined ? String(p.yBot ?? 0) : '';
      dipoleYMaxInput.value = p.yTop !== undefined ? String(p.yTop) : '';
      logY = p.logY; logToggle.classList.toggle('active', logY);
      dipoleChannelTabs.select('total', true);
      dipoleXUnitTabs.select('norm', true); dipoleDistUnit = 'norm';   // reference figures are in normalized units
      dipoleDistRef = 'centre'; dipoleRefSel.value = 'centre';         // …measured from the centre
      dipoleDMinInput.step = '0.05'; dipoleDMaxInput.step = '0.1';
      dipoleYUnitTabs.select('norm', true); dipoleYUnitPrev = 'norm';
      updateExcitationUI();
    } finally {
      applyingDipolePreset = false;
    }
    zoomBounds = null;
    // the setValue calls above already scheduled one rAF update; coalesce into it instead of
    // recomputing synchronously (which would do the whole compute+draw twice).
    scheduleUpdate();
  }

