          <div class="file-upload-row sh-file-group" style="display:none">
            <input type="file" accept=".csv,.tsv,.txt,.dat" class="file-input sh-file-input">
            <span class="file-name sh-file-name"></span>
          </div>
          <div class="rii-search sh-rii-group" style="display:none">
            <input type="text" class="param-number rii-input sh-rii-search" placeholder="Search materials\u2026">
            <div class="rii-results sh-rii-results"></div>
            <span class="material-ref sh-rii-status"></span>
          </div>
        </div>
        <div class="param drude-panel sh-drude-group" style="display:none">
          <span class="drude-formula">&epsilon; = &epsilon;<sub>b</sub> - &omega;<sub>p</sub><sup>2</sup> / [&omega;(&omega; + i&gamma;)]</span>
          <div class="drude-grid">
            <label>
              <span>&epsilon;<sub>b</sub></span>
              <input type="number" class="param-number sh-drude-epsb" value="1" step="0.1">
            </label>
            <label>
              <span>&omega;<sub>p</sub> (eV)</span>
              <input type="number" class="param-number sh-drude-wp" value="5" step="0.01" min="0.01">
