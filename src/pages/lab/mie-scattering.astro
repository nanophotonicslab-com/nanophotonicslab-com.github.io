              </select>
            </label>
            <label>
              <span>Columns 2 and 3</span>
              <select id="material-import-values" class="param-select">
                <option value="epsilon">Re &epsilon;, Im &epsilon;</option>
                <option value="nk">n, k</option>
              </select>
            </label>
          </div>
          <div class="material-import-dialog__preview">
            <canvas id="material-import-preview" aria-label="Material preview"></canvas>
          </div>
          <div class="material-import-dialog__table-wrap">
            <table class="material-import-dialog__table">
              <thead>
                <tr><th>Column 1</th><th>Column 2</th><th>Column 3</th></tr>
              </thead>
              <tbody id="material-import-rows"></tbody>
            </table>
          </div>
          <p class="material-import-dialog__status" id="material-import-status"></p>
          <div class="material-import-dialog__actions">
            <button type="button" class="chart-tool-btn" id="material-import-cancel">Cancel</button>
            <button type="button" class="chart-tool-btn active" id="material-import-accept">Use material</button>
          </div>
        </div>
      </dialog>

    </div>
  </section>
<script>
import { initPermalinks } from '../../lib/permalink';
