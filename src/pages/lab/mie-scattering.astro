            <div id="notes-body"></div>
            <PresetStrip presets={miePresets} showCopy={false} />
          </div>
        </div>
      </div>

      <div class="references card">
        <h4>References</h4>
        <ul class="reference-list">
          <li><span class="ref-index">[1]</span><span>C. F. Bohren &amp; D. R. Huffman, <em>Absorption and Scattering of Light by Small Particles</em> (Wiley, 1983).</span></li>
          <li><span class="ref-index">[2]</span><span>F. J. Garc&iacute;a de Abajo, <em>Relativistic energy loss and induced photon emission in the interaction of a dielectric sphere with an external electron beam</em>, Phys. Rev. B <strong>59</strong>, 3095 (1999), <a href="https://doi.org/10.1103/PhysRevB.59.3095" target="_blank" rel="noopener">doi:10.1103/PhysRevB.59.3095</a>.</span></li>
          <li><span class="ref-index">[3]</span><span>P. E. Stamatopoulou, W. Zhao, A. Rodr&iacute;guez Echarri, N. A. Mortensen, K. Busch, C. Tserkezis &amp; C. Wolff, <em>Electron beams traversing spherical nanoparticles: analytic and numerical treatment</em>, Phys. Rev. Research <strong>6</strong>, 013239 (2024), <a href="https://doi.org/10.1103/PhysRevResearch.6.013239" target="_blank" rel="noopener">doi:10.1103/PhysRevResearch.6.013239</a>.</span></li>
          <li><span class="ref-index">[4]</span><span>Optical constants: <a href="https://refractiveindex.info" target="_blank" rel="noopener">refractiveindex.info</a>. Au, Ag: Johnson &amp; Christy (1972); Si: Aspnes &amp; Studna (1983); Al: Raki&cacute; (1995); TiO<sub>2</sub>: Sarkar et al. (2019).</span></li>
          <li><span class="ref-index">[5]</span><span>L. Meng, R. Yu, M. Qiu &amp; F. J. Garc&iacute;a de Abajo, <em>Plasmonic nano-oven by concatenation of multishell photothermal enhancement</em> (Thermal view), ACS Nano <strong>11</strong>, 7915&ndash;7924 (2017), <a href="https://doi.org/10.1021/acsnano.7b02426" target="_blank" rel="noopener">doi:10.1021/acsnano.7b02426</a>.</span></li>
        </ul>
      </div>

      <dialog class="structure-dialog" id="structure-dialog" aria-labelledby="structure-dialog-title">
        <div class="structure-dialog__panel">
          <div class="structure-dialog__header">
            <h3 id="structure-dialog-title">Structure Drawing</h3>
            <div class="structure-dialog__actions">
              <button type="button" class="chart-tool-btn" id="structure-export-png" title="Download structure drawing as PNG">Export PNG</button>
