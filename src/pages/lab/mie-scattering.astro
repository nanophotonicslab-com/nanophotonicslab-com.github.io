    }
    for (const s of visibleSeries) {
      ctx.beginPath(); let first = true;
      for (let i = 0; i < xArr.length; i++) { const v = s.y[i]; if (opts.logY && v <= 0) continue; if (!Number.isFinite(v)) { first = true; continue; } const px = tx(xArr[i]), py = ty(v); if (first) { ctx.moveTo(px, py); first = false; } else ctx.lineTo(px, py); }
