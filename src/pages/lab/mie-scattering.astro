  // Distance-entry conversions between the on-screen frame (unit d/a|nm × reference centre|surface)
  // and the d_c/a the physics uses (d_c = distance from the sphere centre).
  //   from surface:  d_c = R + d_surface (outside)  or  R − d_surface (inside).
  function dipoleEntryToDaC(v: number, R: number): number {
    const distNm = dipoleDistUnit === 'abs' ? v : v * R;                 // d_c or d_surface, in nm
    const dc = dipoleDistRef === 'centre' ? distNm : (dipoleRegion === 'outside' ? R + distNm : R - distNm);
    return dc / R;
  }
  function dipoleDaCToEntry(daC: number, R: number): number {
    const dc = daC * R;
    const distNm = dipoleDistRef === 'centre' ? dc : (dipoleRegion === 'outside' ? dc - R : R - dc);
    return dipoleDistUnit === 'abs' ? distNm : distNm / R;
  }

  function clearDipolePreset() { if (!applyingDipolePreset) { activeDipolePreset = null; dipoleEpsOverride = null; dipoleCavity = false; } }
  function dipoleParamChanged() { clearDipolePreset(); resetAndUpdate(); }
