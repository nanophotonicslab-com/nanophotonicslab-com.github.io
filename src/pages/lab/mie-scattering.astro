  }
  let thermalLayerSig = '';
  let thermalSplitCache: { sig: string; split: number[] | null } | null = null;   // memoised per-shell field split
  interface ThermalExport {
    xArr: Float64Array; series: PlotSeries[]; bands: { x0: number; x1: number; color: string; label?: string }[];
    Te: Float64Array; Tl: Float64Array; Tw: Float64Array; T0c: number;
    params: { lambdaNm: number; I0gw: number; kappaMed: number; nHost: number; mats: string[]; radiiNm: number[]; kappa: number[]; gEl: number[]; Gtbc: number[]; Cabs: number; Pabs: number };
  }
  let thermalExport: ThermalExport | null = null;   // last thermal profile, for PNG/CSV export
  function rebuildThermalLayers() {
    const mats = thermalLayerMaterials();
    const sig = geometry + '|' + mats.join(',');
    if (sig === thermalLayerSig) return;   // only rebuild when the layer stack changes
    thermalLayerSig = sig;
    thermalLayersEl.innerHTML = mats.map((mat, i) => {
      const d = THERMAL_MAT[mat] ?? THERMAL_MAT.custom;
      const color = MAT_COLORS[mat] ?? '#CBD5E1';
      const isOuter = i === mats.length - 1;
      const name = mats.length === 1 ? 'Particle' : i === 0 ? 'Core' : isOuter ? 'Outer shell' : `Shell ${i}`;
      return `<div class="thermal-layer-row">
        <span class="thermal-layer-name"><span class="thermal-layer-swatch" style="background:${color}"></span>${name} · ${matBandLabel(mat)}</span>
        <div class="thermal-layer-inputs">
          <label><span>κ<small>W/mK</small></span><input type="number" class="param-number" data-tl="${i}" data-tlk="kappa" value="${d.kappa}" step="1" min="0.01"></label>
          <label class="${d.metal ? '' : 'is-disabled'}"><span>g<small>10¹⁶ W/m³K</small></span><input type="number" class="param-number" data-tl="${i}" data-tlk="g" value="${d.g}" step="0.5" min="0" ${d.metal ? '' : 'disabled'}></label>
          <label><span>${isOuter ? 'G→med' : 'G'}<small>MW/m²K</small></span><input type="number" class="param-number" data-tl="${i}" data-tlk="G" value="${d.G}" step="5" min="1"></label>
