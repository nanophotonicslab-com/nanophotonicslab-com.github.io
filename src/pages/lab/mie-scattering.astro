  let applyingThermalPreset = false;               // suppress highlight-clearing while a preset loads
  // ── dipole-emitter (decay-rate) mode state ──
  interface DipoleCurves { dOverA: Float64Array; radTot: Float64Array; radRad: Float64Array; radNr: Float64Array; tanTot: Float64Array; tanRad: Float64Array; tanNr: Float64Array; }
  let dipoleData: DipoleCurves | null = null;
  let dipoleRegion: 'outside' | 'inside' = 'outside';
  let dipoleDistUnit: 'norm' | 'abs' = 'norm';     // unit of the distance-range entries (d/a or nm)
  let dipoleDistRef: 'centre' | 'surface' = 'centre';   // reference point for the distance entries/axis
  let dipoleEpsOverride: { re: number; im: number } | null = null;   // reference ε set by a figure preset (else use the material selector)
