  // Default thermal properties per material (κ W/mK, g 10¹⁶ W/m³K, G MW/m²K).
  const THERMAL_MAT: Record<string, { kappa: number; g: number; G: number; metal: boolean }> = {
    au:    { kappa: 314, g: 3,  G: 105, metal: true },
    ag:    { kappa: 429, g: 2.8, G: 100, metal: true },
    al:    { kappa: 237, g: 30, G: 753, metal: true },
    drude: { kappa: 100, g: 3,  G: 105, metal: true },
    si:    { kappa: 150, g: 0,  G: 100, metal: false },
    tio2:  { kappa: 8,   g: 0,  G: 60,  metal: false },
    custom:{ kappa: 1.0, g: 0,  G: 100, metal: false },
    file:  { kappa: 1.0, g: 0,  G: 100, metal: false },
    rii:   { kappa: 1.0, g: 0,  G: 100, metal: false },
  };
  function thermalLayerMaterials(): string[] {
    if (geometry === 'coreshell') {
      return [
        { mat: coreMaterialSelect.value, r: coreRParam.value },
        { mat: materialSelect.value, r: rParam.value },
        ...extraShells.map(sh => ({ mat: sh.material.value, r: sh.rParam.value })),
      ].sort((a, b) => a.r - b.r).map(x => x.mat);
    }
    return [materialSelect.value];
  }
  let thermalLayerSig = '';
  let thermalSplitCache: { sig: string; split: number[] | null } | null = null;   // memoised per-shell field split
  interface ThermalExport {
    xArr: Float64Array; series: PlotSeries[]; bands: { x0: number; x1: number; color: string; label?: string }[];
    Te: Float64Array; Tl: Float64Array; Tw: Float64Array; T0c: number;
    params: { lambdaNm: number; I0gw: number; kappaMed: number; nHost: number; mats: string[]; radiiNm: number[]; kappa: number[]; gEl: number[]; Gtbc: number[]; Cabs: number; Pabs: number };
  }
  let thermalExport: ThermalExport | null = null;   // last thermal profile, for PNG/CSV export
  function rebuildThermalLayers() {
    const mats = thermalLayerMaterials();
    const sig = geometry + '|' + mats.join(',');
    if (sig === thermalLayerSig) return;   // only rebuild when the layer stack changes
    thermalLayerSig = sig;
    thermalLayersEl.innerHTML = mats.map((mat, i) => {
      const d = THERMAL_MAT[mat] ?? THERMAL_MAT.custom;
      const color = MAT_COLORS[mat] ?? '#CBD5E1';
      const isOuter = i === mats.length - 1;
      const name = mats.length === 1 ? 'Particle' : i === 0 ? 'Core' : isOuter ? 'Outer shell' : `Shell ${i}`;
      return `<div class="thermal-layer-row">
        <span class="thermal-layer-name"><span class="thermal-layer-swatch" style="background:${color}"></span>${name} · ${matBandLabel(mat)}</span>
        <div class="thermal-layer-inputs">
          <label><span>κ<small>W/mK</small></span><input type="number" class="param-number" data-tl="${i}" data-tlk="kappa" value="${d.kappa}" step="1" min="0.01"></label>
          <label class="${d.metal ? '' : 'is-disabled'}"><span>g<small>10¹⁶ W/m³K</small></span><input type="number" class="param-number" data-tl="${i}" data-tlk="g" value="${d.g}" step="0.5" min="0" ${d.metal ? '' : 'disabled'}></label>
          <label><span>${isOuter ? 'G→med' : 'G'}<small>MW/m²K</small></span><input type="number" class="param-number" data-tl="${i}" data-tlk="G" value="${d.G}" step="5" min="1"></label>
        </div>
      </div>`;
    }).join('');
  }
  const tlVal = (i: number, key: string, def: number): number => {
    const el = thermalLayersEl.querySelector(`input[data-tl="${i}"][data-tlk="${key}"]`) as HTMLInputElement | null;
    const v = el ? parseFloat(el.value) : NaN;
    return Number.isFinite(v) ? v : def;
  };

  // ── Paper-figure presets (Meng et al., ACS Nano 2017), all at I₀ = 2 GW/m² ──
  interface ThermalPreset {
    label: string; tip: string;
    geometry: 'sphere' | 'coreshell';
    metal: 'au' | 'al';
    layers: { mat: string; r: number }[];   // core → outermost
    lambda: number; lamMin: number; lamMax: number;
  }
  const SILICA_EPS = 2.10;   // SiO₂, n ≈ 1.45 (lossless dielectric spacer)
  const THERMAL_PRESETS: Record<string, ThermalPreset> = {
    fig2:  { label: 'Fig. 2',  tip: 'Gold sphere R = 5 nm in water (small-sphere limit)', geometry: 'sphere',    metal: 'au', layers: [{ mat: 'au', r: 5 }], lambda: 522, lamMin: 400, lamMax: 750 },
    fig4a: { label: 'Fig. 4a', tip: 'Au nano-oven N=1 @ 690 nm — SiO₂(23)/Au(28)',        geometry: 'coreshell', metal: 'au', layers: [{ mat: 'custom', r: 23 }, { mat: 'au', r: 28 }], lambda: 690, lamMin: 450, lamMax: 950 },
    fig4b: { label: 'Fig. 4b', tip: 'Au nano-oven N=2 @ 690 nm — SiO₂/Au ×2',             geometry: 'coreshell', metal: 'au', layers: [{ mat: 'custom', r: 10 }, { mat: 'au', r: 13 }, { mat: 'custom', r: 36 }, { mat: 'au', r: 48 }], lambda: 690, lamMin: 450, lamMax: 950 },
    fig4c: { label: 'Fig. 4c', tip: 'Au nano-oven N=3 @ 690 nm — SiO₂/Au ×3',             geometry: 'coreshell', metal: 'au', layers: [{ mat: 'custom', r: 4 }, { mat: 'au', r: 7 }, { mat: 'custom', r: 10 }, { mat: 'au', r: 16 }, { mat: 'custom', r: 34 }, { mat: 'au', r: 42 }], lambda: 690, lamMin: 450, lamMax: 950 },
    fig4d: { label: 'Fig. 4d', tip: 'Al nano-oven N=1 @ 300 nm — SiO₂(13)/Al(17)',        geometry: 'coreshell', metal: 'al', layers: [{ mat: 'custom', r: 13 }, { mat: 'al', r: 17 }], lambda: 300, lamMin: 250, lamMax: 500 },
    fig4e: { label: 'Fig. 4e', tip: 'Al nano-oven N=2 @ 300 nm — SiO₂/Al ×2',             geometry: 'coreshell', metal: 'al', layers: [{ mat: 'custom', r: 8 }, { mat: 'al', r: 11 }, { mat: 'custom', r: 35 }, { mat: 'al', r: 41 }], lambda: 300, lamMin: 250, lamMax: 500 },
    fig4f: { label: 'Fig. 4f', tip: 'Al nano-oven N=3 @ 300 nm — SiO₂/Al ×3',             geometry: 'coreshell', metal: 'al', layers: [{ mat: 'custom', r: 7 }, { mat: 'al', r: 10 }, { mat: 'custom', r: 18 }, { mat: 'al', r: 21 }, { mat: 'custom', r: 42 }, { mat: 'al', r: 49 }], lambda: 300, lamMin: 250, lamMax: 500 },
  };

  function setSelectValue(sel: HTMLSelectElement, val: string) {
    sel.value = val;
    sel.dispatchEvent(new Event('change'));
  }
  function relaxRadiusSlider(slider: HTMLInputElement | null) {
    if (slider) { slider.min = '1'; slider.step = '1'; if (parseFloat(slider.max) < 520) slider.max = '520'; }
  }
  function relaxStepSlider(slider: HTMLInputElement | null) {   // allow fine values (e.g. SiO₂ ε = 2.10)
    if (slider) slider.step = '0.01';
  }
  function setTLInput(i: number, key: string, val: number) {
    const el = thermalLayersEl.querySelector(`input[data-tl="${i}"][data-tlk="${key}"]`) as HTMLInputElement | null;
    if (el) el.value = String(val);
  }
  // Heat-transport values from the paper for the active metal/dielectric stack.
  function applyThermalLayerParams(metal: 'au' | 'al') {
    const mats = thermalLayerMaterials();   // core → outer
    const L = mats.length;
    const isMetalMat = (m: string) => m === 'au' || m === 'al' || m === 'ag' || m === 'drude';
    const gMetal = metal === 'al' ? 30 : 3;          // ×10¹⁶ W/m³K  (Au 3e16, Al 3e17)
    const kMetal = metal === 'al' ? 237 : 314;       // W/mK (κ_metal ≫ ⇒ isothermal)
    const Gwater = metal === 'al' ? 753 : 105;       // MW/m²K  metal/water (outer interface)
    const Gsilica = metal === 'al' ? 750 : 141.5;    // MW/m²K  metal/SiO₂ lattice TBC (inner)
    for (let i = 0; i < L; i++) {
      const met = isMetalMat(mats[i]);
      setTLInput(i, 'kappa', met ? kMetal : 1.0);    // SiO₂ κ = 1.0
      setTLInput(i, 'g', met ? gMetal : 0);
      setTLInput(i, 'G', i === L - 1 ? Gwater : Gsilica);
    }
  }

  function applyThermalPreset(key: string) {
    const p = THERMAL_PRESETS[key];
    if (!p) return;
    activeThermalPreset = key;        // highlight this figure button
    applyingThermalPreset = true;     // keep it highlighted through the internal re-renders
    radiusOrderNormalizing = true;   // honour the paper's sub-5-nm shells / small gaps
    try {
      // environment: water, 300 K (= 26.85 °C), I₀ = 2 GW/m²
      nhParam.setValue(1.33);
      thermalKappaMed.value = '0.6';
      thermalT0Input.value = '26.85';
      thermalI0Num.value = '2'; thermalI0Slider.value = '2';
      thermalRmax.value = '';   // reset plotting range to this geometry's default
      // σabs sweep + illumination wavelength
      lamMinInput.value = String(p.lamMin); lamMaxInput.value = String(p.lamMax);
      thermalRangeMin.value = String(p.lamMin); thermalRangeMax.value = String(p.lamMax);
      thermalLambdaSlider.min = String(p.lamMin); thermalLambdaSlider.max = String(p.lamMax); thermalLambdaSlider.step = '1';
      thermalLambdaSlider.value = String(p.lambda); thermalLambdaNum.value = String(p.lambda);
      // geometry + materials
      while (extraShells.length > 0) removeShellSection(extraShells[0]);
      if (p.geometry === 'sphere') {
        geoTabs.select('sphere');
        setSelectValue(materialSelect, p.layers[0].mat);
        relaxRadiusSlider(document.getElementById('r-slider') as HTMLInputElement);
        rParam.setValue(p.layers[0].r);
      } else {
        geoTabs.select('coreshell');
        setSelectValue(coreMaterialSelect, p.layers[0].mat);
        if (p.layers[0].mat === 'custom') { relaxStepSlider(document.getElementById('core-eps-slider') as HTMLInputElement); coreEpsParam.setValue(SILICA_EPS); }
        relaxRadiusSlider(document.getElementById('core-r-slider') as HTMLInputElement);
        coreRParam.setValue(p.layers[0].r);
        setSelectValue(materialSelect, p.layers[1].mat);
        if (p.layers[1].mat === 'custom') { relaxStepSlider(document.getElementById('eps-slider') as HTMLInputElement); epsParam.setValue(SILICA_EPS); }
        relaxRadiusSlider(document.getElementById('r-slider') as HTMLInputElement);
        rParam.setValue(p.layers[1].r);
        for (let i = 2; i < p.layers.length; i++) {
          const h = createShellSection(p.layers[i].r);
          setSelectValue(h.material, p.layers[i].mat);
          if (p.layers[i].mat === 'custom') { relaxStepSlider(h.el.querySelector('.sh-eps-slider') as HTMLInputElement); h.epsParam.setValue(SILICA_EPS); }
          relaxRadiusSlider(h.el.querySelector('.sh-r-slider') as HTMLInputElement);
          h.rParam.setValue(p.layers[i].r);
        }
      }
      viewTabs.select('thermal');
      updateExcitationUI();
      thermalLayerSig = '';   // force the per-layer panel to rebuild for the new stack
      resetAndUpdate();       // schedules rAF: recompute σabs sweep + rebuild layers w/ defaults
    } finally {
      radiusOrderNormalizing = false;
    }
    // The rebuild happens in a deferred rAF; override the heat-transport values after it.
    requestAnimationFrame(() => {
      applyThermalLayerParams(p.metal);
      render();
      applyingThermalPreset = false;
    });
  }

  notesBody.addEventListener('click', (e) => {
    const thermalBtn = (e.target as HTMLElement).closest('.thermal-preset-btn') as HTMLElement | null;
    if (thermalBtn && thermalBtn.dataset.preset) { applyThermalPreset(thermalBtn.dataset.preset); return; }
    const dipoleBtn = (e.target as HTMLElement).closest('.dipole-fig-btn') as HTMLElement | null;
    if (dipoleBtn && dipoleBtn.dataset.preset) applyDipolePreset(dipoleBtn.dataset.preset);
  });

  // write d/a values into the two range entries, honouring the current unit (d/a or nm)
  // loDa/hiDa are d_c/a (from centre); written into the entries honouring the current unit + reference
  // (the surface reference reverses direction for the inside region, so keep min ≤ max).
  function setDipoleRangeEntries(loDa: number, hiDa: number): void {
    const R = rParam.value || 1;
    const a = dipoleDaCToEntry(loDa, R), b = dipoleDaCToEntry(hiDa, R);
    const dp = dipoleDistUnit === 'abs' ? 1 : 2;
    dipoleDMinInput.value = Math.min(a, b).toFixed(dp); dipoleDMaxInput.value = Math.max(a, b).toFixed(dp);
  }
  const dipoleRegionTabs = setupTabs('dipole-region-tabs', 'dregion', 'outside', (v: string) => {
    // Move the dipole in/out but KEEP the current material, radius and wavelength — only reset
    // the scan window to the region's sensible default. (The figure buttons remain the way to
    // load a full reference figure, including its material.)
    dipoleRegion = v as 'outside' | 'inside';
    if (dipoleRegion === 'outside') setDipoleRangeEntries(1.02, 9);
    else setDipoleRangeEntries(0, 1);
    clearDipolePreset();          // switching region deviates from the exact figure; keep the user's material
    updateDipoleControlVis();
    resetAndUpdate();
  });
  const dipoleChannelTabs = setupTabs('dipole-channel-tabs', 'dchannel', 'total', () => { zoomBounds = null; render(); });
  // axis-unit toggles are pure display transforms → no recompute, just redraw
  // Distance-unit toggle: converts the two range entries between d/a and nm (physical
  // range preserved) and relabels the x-axis. No recompute — the d/a grid is unchanged.
  const dipoleXUnitTabs = setupTabs('dipole-xunit-tabs', 'dxunit', 'norm', (v: string) => {
    if (v === dipoleDistUnit) return;
    const R = rParam.value || 1;
    const dmin = parseFloat(dipoleDMinInput.value), dmax = parseFloat(dipoleDMaxInput.value);
    if (v === 'abs') {   // d/a → nm
      if (Number.isFinite(dmin)) dipoleDMinInput.value = (dmin * R).toFixed(1);
      if (Number.isFinite(dmax)) dipoleDMaxInput.value = (dmax * R).toFixed(1);
      dipoleDMinInput.step = '1'; dipoleDMaxInput.step = '1';
    } else {             // nm → d/a
      if (Number.isFinite(dmin)) dipoleDMinInput.value = (dmin / R).toFixed(3);
      if (Number.isFinite(dmax)) dipoleDMaxInput.value = (dmax / R).toFixed(3);
      dipoleDMinInput.step = '0.05'; dipoleDMaxInput.step = '0.1';
    }
    dipoleDistUnit = v as 'norm' | 'abs';
    zoomBounds = null;
    if (excitation === 'dipole') render();
  });
  const fmtYVal = (val: number, unit: string) => unit === 'norm' ? String(+val.toPrecision(6)) : val.toExponential(3);
  const dipoleYUnitTabs = setupTabs('dipole-yunit-tabs', 'dyunit', 'norm', (v: string) => {
    // convert any manual y-range so the physical window is preserved across unit changes
    const ratio = dipoleYScale(v) / dipoleYScale(dipoleYUnitPrev);
    const ymin = parseFloat(dipoleYMinInput.value), ymax = parseFloat(dipoleYMaxInput.value);
    if (Number.isFinite(ymin)) dipoleYMinInput.value = fmtYVal(ymin * ratio, v);
    if (Number.isFinite(ymax)) dipoleYMaxInput.value = fmtYVal(ymax * ratio, v);
    dipoleYUnitPrev = v;
    zoomBounds = null; updateDipoleControlVis(); if (excitation === 'dipole') render();
  });

  const polTabs = setupTabs('pol-tabs', 'pol', 'total', () => render());
  const excitationTabs = setupTabs('excitation-tabs', 'excitation', 'plane', (v: string) => {
    excitation = v as 'plane' | 'electron' | 'dipole';
    if (excitation === 'electron') {
      axisTabs.select('energy', true);
      if (geometry === 'coreshell') geoTabs.select('sphere');
    }
    if (excitation === 'dipole') {
      if (geometry === 'coreshell') geoTabs.select('sphere');
      if (!dipoleInitialized) { dipoleInitialized = true; applyDipoleDefaultState(); return; }
    }
    updateExcitationUI();
    zoomBounds = null;
    scheduleUpdate();
  });
  angularLambdaInput.addEventListener('change', () => render());

  // Geometry tabs (Sphere / Core-Shell)
  const geoTabs = setupTabs('geo-tabs', 'geo', 'sphere', (v: string) => {
    if (excitation === 'electron' && v === 'coreshell') {
      geoTabs.select('sphere');
      return;
    }
    geometry = v as 'sphere' | 'coreshell';
    const cs = geometry === 'coreshell';
    // Toggle core-shell-only controls
    coreSection.style.display = cs ? '' : 'none';
    coreEpsGroup.style.display = coreMaterialSelect.value === 'custom' ? '' : 'none';
    coreDrudeGroup.style.display = cs && coreMaterialSelect.value === 'drude' ? '' : 'none';
    extraShellsContainer.style.display = cs ? '' : 'none';
    addShellWrap.style.display = cs ? '' : 'none';
    // Update labels for shell/particle context
    materialLabel.textContent = cs ? 'Shell 1 material' : 'Material';
    radiusLabel.textContent = cs ? 'Shell 1 outer radius (nm)' : 'Radius (nm)';
    // In core-shell mode, epsilon group tracks shell material
    epsGroup.classList.toggle('hidden', materialSelect.value !== 'custom');
    updateTheoryNote();
    resetAndUpdate();
  });

  let _theoryNoteKey = '', _notesKey = '';
  function updateTheoryNote() {
    const key = excitation + '|' + geometry;               // content only depends on mode + geometry
    if (key === _theoryNoteKey) return;                    // skip the innerHTML rebuild on every recompute
    _theoryNoteKey = key;
    if (excitation === 'dipole') {
      theoryNote.innerHTML = '<strong>Dipole excitation</strong> gives the normalized decay rate &gamma;/&gamma;<sub>0</sub> of a point electric dipole near (or inside) the sphere, from the Mie multipole expansion&nbsp;[6]. <strong>Solid = radial</strong>, <strong>dashed = tangential</strong>; the total splits into radiative and non-radiative channels.';
      return;
    }
    if (excitation === 'electron') {
      theoryNote.innerHTML = '<strong>Electron excitation</strong> uses the analytical sphere formalism for EELS and CL&nbsp;[2]. The total EELS signal is split into surface, bulk, and Begrenzung terms; CL can be inspected by multipole order.';
      return;
    }
    theoryNote.innerHTML = geometry === 'coreshell'
      ? '<strong>Multi-shell Mie</strong> extends Mie theory to layered spheres with up to ' + MAX_SHELLS + ' concentric shells&nbsp;[1]. C<sub>ext</sub>&nbsp;=&nbsp;C<sub>sca</sub>&nbsp;+&nbsp;C<sub>abs</sub>.'
      : '<strong>Mie theory</strong> gives exact solutions for light scattering by spherical particles&nbsp;[1]. C<sub>ext</sub>&nbsp;=&nbsp;C<sub>sca</sub>&nbsp;+&nbsp;C<sub>abs</sub>. Metals have complex&nbsp;&epsilon;, giving C<sub>abs</sub>&nbsp;&gt;&nbsp;0.';
  }

  function updateNotes() {
    // notes only change with mode, geometry, view, and (dipole) the highlighted figure button —
    // not on every recompute; skip the innerHTML rebuild when nothing relevant changed. (The
    // thermal view overwrites notesBody itself, so the view is part of the key.)
    const key = excitation + '|' + geometry + '|' + viewTabs.value + '|' + (activeDipolePreset || '');
    if (key === _notesKey) return;
    _notesKey = key;
    if (excitation === 'dipole') {
      notesBody.innerHTML = `
        <ul>
          <li><strong>Dipole decay rates</strong> &gamma;/&gamma;<sub>0</sub> for a point electric dipole near a sphere [6]. <strong>Radial</strong> (solid) and <strong>tangential</strong> (dashed) orientations; Total, Radiative, Non-radiative channels.</li>
          <li>Near the surface the <em>totals</em> diverge (a truncated near-field sum) &mdash; use <strong>Log&nbsp;Y</strong> to see them. The radiative curves are &ell;-converged.</li>
        </ul>
        <div class="dipole-fig-label">Reproduce reference figures from Ref. [6]</div>
        <div class="dipole-fig-grid">
          ${Object.entries(DIPOLE_PRESETS).map(([k, p]) => `<button type="button" class="dipole-fig-btn${k === activeDipolePreset ? ' active' : ''}" data-preset="${k}" title="${p.tip}" aria-pressed="${k === activeDipolePreset ? 'true' : 'false'}">${p.label}</button>`).join('')}
        </div>`;
      return;
    }
    if (excitation === 'electron') {
      notesBody.innerHTML = `
        <ul>
          <li><strong>Electron EELS/CL currently uses the analytical homogeneous-sphere model.</strong></li>
          <li>For penetrating trajectories, b &lt; R, the bulk and Begrenzung terms depend on q<sub>c</sub> and on the path quadrature. Increase z quadrature and l<sub>max</sub> when checking convergence for small b, large radius, or broad energy ranges.</li>
          <li>q<sub>c</sub> is the bulk momentum cut-off used by the analytical local-response model. Aloof trajectories, b &ge; R, do not use the inside-path bulk contribution.</li>
        </ul>`;
      return;
    }
    notesBody.innerHTML = geometry === 'coreshell'
      ? '<ul><li><strong>Core-shell mode</strong> uses concentric layers ordered from core to outer shell. Keep outer radii increasing outward.</li></ul>'
      : '<ul><li><strong>Plane-wave mode</strong> uses the standard homogeneous-sphere Mie solution for the selected material and host index.</li></ul>';
  }

  const fmtEps = (e: { re: number; im: number }): string =>
    `${e.re.toFixed(2)} ${e.im >= 0 ? '+' : '−'} ${Math.abs(e.im).toFixed(2)}i`;


  /** ε of the sphere for the dipole calculation: reference override (preset) or the live material. */
  function currentDipoleEps(): { re: number; im: number } {
    if (dipoleEpsOverride) return { ...dipoleEpsOverride };
    const [n, k] = getDielectric(dipoleLambdaParam.value);
    return nkToEpsilon(n, k);
  }

  // free-space decay rate γ₀ = 1/τ₀ from the emitter lifetime, and the y-axis scale factor
  // (multiply the normalized γ/γ₀ curves by this to get absolute rates).
  const dipoleTau0Ns = (): number => { const v = parseFloat(dipoleTau0Input.value); return Number.isFinite(v) && v > 0 ? v : 1; };
  function dipoleYScale(unit: string): number {
    const tau0 = dipoleTau0Ns();
    if (unit === 'inv_s') return 1e9 / tau0;     // γ₀ in s⁻¹
    if (unit === 'inv_fs') return 1e-6 / tau0;   // γ₀ in fs⁻¹
    return 1;                                    // normalized (γ/γ₀)
  }

  function updateDipoleControlVis(): void {
    const eps = currentDipoleEps();
    const lossyInside = dipoleRegion === 'inside' && Math.abs(eps.im) > 1e-9;
    dipoleFGroup.style.display = lossyInside ? '' : 'none';
    dipoleRefGroup.style.display = dipoleEpsOverride ? '' : 'none';
    const lam = dipoleLambdaParam.value;
    dipoleEvEcho.innerHTML = dipoleCavity
      ? `&#8462;&omega; = <b>${(HC_EV_NM / lam).toFixed(3)} eV</b> &middot; vacuum cavity in &epsilon; = <b>${fmtEps(eps)}</b>`
      : `&#8462;&omega; = <b>${(HC_EV_NM / lam).toFixed(3)} eV</b> &middot; &epsilon; = <b>${fmtEps(eps)}</b>`;
    if (dipoleEpsOverride) dipoleRefEl.innerHTML = `${dipoleCavity ? 'cavity — outer' : 'reference'} &epsilon; = <b>${fmtEps(dipoleEpsOverride)}</b> &middot; &lambda; = <b>${lam.toFixed(1)} nm</b>`;
    const yUnit = dipoleYUnitTabs.value;
    dipoleTau0Group.style.display = yUnit === 'norm' ? 'none' : '';
    if (yUnit !== 'norm') {
      const g0s = 1e9 / dipoleTau0Ns();
      dipoleGamma0Echo.innerHTML = `&gamma;<sub>0</sub> = <b>${g0s.toExponential(2)} s⁻¹</b> = ${(g0s * 1e-15).toExponential(2)} fs⁻¹`;
    }
  }

  function updateExcitationUI() {
    const electronMode = excitation === 'electron';
    const dipoleMode = excitation === 'dipole';
    const restrict = electronMode || dipoleMode;    // homogeneous-sphere, spectrum-only modes
    document.querySelectorAll<HTMLElement>('.electron-only').forEach(el => { el.style.display = electronMode ? '' : 'none'; });
    document.querySelectorAll<HTMLElement>('.dipole-only').forEach(el => { el.style.display = dipoleMode ? '' : 'none'; });
    planeRangeGroup.style.display = (restrict || viewTabs.value === 'thermal') ? 'none' : '';
    const coreShellBtn = document.querySelector<HTMLButtonElement>('#geo-tabs [data-geo="coreshell"]');
    if (coreShellBtn) {
      coreShellBtn.disabled = restrict;
      coreShellBtn.setAttribute('aria-disabled', restrict ? 'true' : 'false');
      coreShellBtn.title = restrict ? 'Electron and dipole modes currently support homogeneous spheres.' : '';
    }
    // angular / near-field / thermal disabled for electron & dipole; Material stays enabled everywhere
    document.querySelectorAll<HTMLButtonElement>('#view-tabs [data-view="angular"], #view-tabs [data-view="nearfield"], #view-tabs [data-view="thermal"]').forEach(btn => {
      btn.disabled = restrict;
      btn.setAttribute('aria-disabled', restrict ? 'true' : 'false');
    });
    if (restrict && (viewTabs.value === 'angular' || viewTabs.value === 'nearfield' || viewTabs.value === 'thermal')) viewTabs.select('spectrum', true);
    const spectrum = viewTabs.value === 'spectrum';
    spectrumControls.style.display = spectrum && excitation === 'plane' ? '' : 'none';
    electronControls.style.display = spectrum && electronMode ? '' : 'none';
    dipoleControls.style.display = spectrum && dipoleMode ? '' : 'none';
    colorSwatches.style.display = spectrum && excitation === 'plane' ? '' : 'none';
    // the λ/E x-axis toggle is meaningless for the dipole d/a axis
    axisOverlay.style.display = ((spectrum && !dipoleMode) || viewTabs.value === 'material') ? '' : 'none';
    angularControls.style.display = !restrict && (viewTabs.value === 'angular' || viewTabs.value === 'nearfield') ? '' : 'none';
    angularPolWrap.style.display = !restrict && viewTabs.value === 'angular' ? '' : 'none';
    thermalParams.style.display = !restrict && viewTabs.value === 'thermal' ? '' : 'none';
    thermalSpectrumWrap.style.display = !restrict && viewTabs.value === 'thermal' ? '' : 'none';
    thermalResultHeader.style.display = !restrict && viewTabs.value === 'thermal' ? '' : 'none';
    thermalResultFooter.style.display = !restrict && viewTabs.value === 'thermal' ? '' : 'none';
    if (dipoleMode) updateDipoleControlVis();
    updateTheoryNote();
    updateNotes();
  }

  // === RII search helper (reusable for any material selector) ===

  function setupRIISearch(
    searchGroup: HTMLElement, searchInput: HTMLInputElement,
    resultsList: HTMLElement, statusEl: HTMLElement, refEl: HTMLElement,
    onLoaded: (data: number[][]) => void,
  ) {
    let catalog: RIIMaterial[] | null = null;
    let debounce: ReturnType<typeof setTimeout>;

    function showResults(q: string) {
      if (!catalog) return;
      const hits = searchCatalog(catalog, q);
      resultsList.innerHTML = hits.map((m, i) =>
        `<div class="rii-result" data-idx="${i}"><span class="rii-result-book">${m.bookName}</span><br><span class="rii-result-page">${m.pageName}</span></div>`
      ).join('');
      (resultsList as any)._hits = hits;
    }

    async function ensureCatalog() {
      if (catalog) { showResults(searchInput.value); return; }
      statusEl.textContent = 'Loading catalog\u2026';
      try {
        catalog = await loadCatalog();
        statusEl.textContent = `${catalog.length} materials available`;
        showResults(searchInput.value);
      } catch { statusEl.textContent = 'Failed to load catalog'; }
    }

    searchInput.addEventListener('input', () => { clearTimeout(debounce); debounce = setTimeout(() => showResults(searchInput.value), 150); });
    searchInput.addEventListener('focus', () => { if (catalog) showResults(searchInput.value); });

