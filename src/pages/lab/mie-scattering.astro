  let activeDipolePreset: string | null = null;
  let applyingDipolePreset = false;
  let dipoleInitialized = false;                    // apply sensible defaults the first time dipole mode is opened
  const RADIUS_GAP_NM = 5;
  // Loading rim on the result box while a slow calculation runs (electron
  // penetrating trajectories, b < R, are much heavier than aloof ones).
  const setMieComputing = (on: boolean) => document.querySelector('.chart-panel')?.classList.toggle('is-computing', on);
  function isPenetratingElectron(): boolean {
    if (excitation !== 'electron') return false;
    const radii = radiusParams().map(p => p.value).filter(v => Number.isFinite(v) && v > 0);
    if (!radii.length) return false;
    return electronBParam.value < Math.max(...radii);
  }
  function runScheduledUpdate() {
    if (rafPending) return;
    rafPending = true;
    requestAnimationFrame(() => {
      rafPending = false;
      recompute();
      render();
      updateConfigCheck();
      setMieComputing(false);   // clear the loading rim once the (possibly slow) compute finishes
    });
  }
  function scheduleUpdate() {
    if (updateTimer !== null) {
      window.clearTimeout(updateTimer);
      updateTimer = null;
    }
    // Electron EELS/CL is genuinely expensive → debounce. Plane wave and the dipole
    // decay-rate solver are both fast (~tens of ms) → update immediately (rAF-coalesced).
    if (excitation === 'electron') {
      // Penetrating trajectories (b < R) are slow — show the loading rim right away
      // (set synchronously so it paints during the debounce + compute).
      if (isPenetratingElectron()) setMieComputing(true);
      updateTimer = window.setTimeout(() => {
        updateTimer = null;
        runScheduledUpdate();
      }, 140);
      return;
    }
    runScheduledUpdate();
  }
  function radiusParams(): ParamHandle[] { return [coreRParam, rParam, ...extraShells.map(s => s.rParam)]; }
  function normalizeRadiusOrder(preferredIndex?: number) {
    if (geometry !== 'coreshell' || radiusOrderNormalizing) return;
    radiusOrderNormalizing = true;
    try {
      const params = radiusParams();
      if (params.length < 2) return;
      const values = params.map(p => p.value);

      if (preferredIndex !== undefined && preferredIndex >= 0 && preferredIndex < values.length) {
        const lo = preferredIndex === 0 ? RADIUS_GAP_NM : values[preferredIndex - 1] + RADIUS_GAP_NM;
        const hi = preferredIndex === values.length - 1 ? Number.POSITIVE_INFINITY : values[preferredIndex + 1] - RADIUS_GAP_NM;
        values[preferredIndex] = Math.max(lo, values[preferredIndex]);
        if (Number.isFinite(hi)) values[preferredIndex] = Math.min(hi, values[preferredIndex]);
      }

      values[0] = Math.max(RADIUS_GAP_NM, values[0]);
      for (let i = 1; i < values.length; i++) {
        if (values[i] < values[i - 1] + RADIUS_GAP_NM) values[i] = values[i - 1] + RADIUS_GAP_NM;
      }
      for (let i = values.length - 2; i >= 0; i--) {
        if (values[i] > values[i + 1] - RADIUS_GAP_NM) values[i] = values[i + 1] - RADIUS_GAP_NM;
      }
      values[0] = Math.max(RADIUS_GAP_NM, values[0]);

      for (let i = 0; i < params.length; i++) {
        if (Math.abs(params[i].value - values[i]) > 1e-6) params[i].setValue(values[i]);
      }
    } finally {
      radiusOrderNormalizing = false;
    }
  }
  function resetAndUpdate() { if (!applyingThermalPreset) activeThermalPreset = null; if (!applyingDipolePreset) clearDipolePreset(); zoomBounds = null; normalizeRadiusOrder(); updateElectronRadiusMarker(); scheduleUpdate(); }
  function radiusChanged(layerIndex: number) { zoomBounds = null; normalizeRadiusOrder(layerIndex); updateElectronRadiusMarker(); scheduleUpdate(); }

