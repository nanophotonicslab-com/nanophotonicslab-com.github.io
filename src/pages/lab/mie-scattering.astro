---
import Layout from '../../layouts/Layout.astro';
import ModelInfo from '../../components/ModelInfo.astro';
import PresetStrip from '../../components/PresetStrip.astro';
import ToolMeta from '../../components/ToolMeta.astro';
import ParamsDrawer from '../../components/ParamsDrawer.astro';
import '../../styles/lab.css';

const miePresets = [
  { label: 'Au in water', values: { 'material-select': 'au', 'r-num': 50, 'r-slider': 50, 'nh-num': 1.33, 'nh-slider': 1.33, 'lam-min': 300, 'lam-max': 900 } },
  { label: 'Ag in air', values: { 'material-select': 'ag', 'r-num': 30, 'r-slider': 30, 'nh-num': 1.00, 'nh-slider': 1.00, 'lam-min': 300, 'lam-max': 700 } },
  { label: 'Si in air (Mie resonances)', values: { 'material-select': 'si', 'r-num': 100, 'r-slider': 100, 'nh-num': 1.00, 'nh-slider': 1.00, 'lam-min': 400, 'lam-max': 1200 } },
];
---

<Layout title="Mie Scattering Calculator" description="Interactive Mie scattering calculator for spherical nanoparticles — exact solutions in your browser.">
  <section class="widget-hero">
    <div class="container">
      <a href="/lab/" class="back-link">&larr; Back to Lab</a>
      <h1>Mie Scattering <span class="gradient-text">Calculator</span></h1>
      <p class="widget-hero__subtitle">
        Compute scattering, extinction, and absorption cross-sections for spherical
        nanoparticles using exact Mie theory. Adjust parameters and see results in real time.
      </p>
      <ToolMeta slug="mie-scattering" name="Mie Scattering Calculator" />
    </div>
  </section>

  <ModelInfo status="Stable">
    <dl>
      <dt>Model</dt>
      <dd>Exact Mie theory — analytical solution to Maxwell's equations for a homogeneous sphere in a uniform host medium.</dd>
      <dt>Assumptions</dt>
      <dd>Spherical geometry, isotropic and local dielectric functions, plane-wave or electron-beam excitation, no substrate or inter-particle coupling.</dd>
      <dt>Validity</dt>
      <dd>Valid for any sphere size relative to wavelength. Optical constants from tabulated experimental data (Johnson &amp; Christy, Palik, etc.) via cubic-spline interpolation.</dd>
      <dt>Limitations</dt>
      <dd>No non-local or quantum-size corrections. EELS uses the non-retarded analytical model for the homogeneous sphere (retardation effects missing for large particles or high energies).</dd>
      <dt>References</dt>
      <dd>
        <ol class="ref-list">
          <li>C. F. Bohren &amp; D. R. Huffman, <em>Absorption and Scattering of Light by Small Particles</em> (Wiley, 1983).</li>
          <li>F. J. García de Abajo, <em>Optical excitations in electron microscopy</em>, Rev. Mod. Phys. <strong>82</strong>, 209 (2010).</li>
          <li>Y. S. Kim, P. T. Leung &amp; T. F. George, <em>Classical decay rates for molecules in the presence of a spherical surface: A complete treatment</em>, Surf. Sci. <strong>195</strong>, 1 (1988).</li>
        </ol>
      </dd>
    </dl>
  </ModelInfo>

  <section class="section">
    <div class="container">
      <div class="excitation-bar">
        <div class="param excitation-param excitation-above">
          <div class="param-header"><label>Excitation</label></div>
          <div class="plot-tabs" id="excitation-tabs" role="radiogroup">
            <button class="plot-tab active" data-excitation="plane" role="radio" aria-checked="true">Plane wave</button>
            <button class="plot-tab" data-excitation="electron" role="radio" aria-checked="false">Electrons</button>
            <button class="plot-tab" data-excitation="dipole" role="radio" aria-checked="false">Dipoles</button>
          </div>
        </div>
      </div>
      <div class="widget-layout">
        <div class="widget-column widget-column--controls">
          <ParamsDrawer>
          <div class="controls card">
          <div class="params-head">
            <h3>Parameters</h3>
            <div class="plot-tabs plot-tabs--sm params-head__toggle dipole-only" id="dipole-region-tabs" role="radiogroup" aria-label="Dipole position" style="display:none">
              <button class="plot-tab active" data-dregion="outside" role="radio" aria-checked="true">Outside</button>
              <button class="plot-tab" data-dregion="inside" role="radio" aria-checked="false">Inside</button>
            </div>
          </div>

          <!-- Geometry type -->
          <div class="param">
            <div class="param-header"><label>Geometry</label></div>
            <div class="plot-tabs" id="geo-tabs" role="radiogroup">
              <button class="plot-tab active" data-geo="sphere" role="radio" aria-checked="true">Sphere</button>
              <button class="plot-tab" data-geo="coreshell" role="radio" aria-checked="false">Core-Shell</button>
            </div>
          </div>

          <!-- Shell / particle material -->
          <div class="param">
            <div class="param-header"><label id="material-label">Material</label></div>
            <select id="material-select" class="param-select">
              <option value="custom">Custom dielectric</option>
              <option value="drude">Drude model</option>
              <option value="au" selected>Gold (Au)</option>
              <option value="ag">Silver (Ag)</option>
              <option value="si">Silicon (Si)</option>
              <option value="al">Aluminum (Al)</option>
              <option value="tio2">TiO&sub2;</option>
              <option value="file">Upload file&hellip;</option>
              <option value="rii">Search database&hellip;</option>
            </select>
            <span class="material-ref" id="material-ref"></span>
            <div class="file-upload-row" id="file-upload-group" style="display:none">
              <input type="file" id="file-upload" accept=".csv,.tsv,.txt,.dat" class="file-input">
              <span class="file-name" id="file-name"></span>
            </div>
            <div class="rii-search" id="rii-search-group" style="display:none">
              <input type="text" id="rii-search" class="param-number rii-input" placeholder="Search materials&hellip;">
              <div class="rii-results" id="rii-results"></div>
              <span class="material-ref" id="rii-status"></span>
            </div>
          </div>

          <div class="param drude-panel" id="drude-group" style="display:none">
            <span class="drude-formula">&epsilon; = &epsilon;<sub>b</sub> - &omega;<sub>p</sub><sup>2</sup> / [&omega;(&omega; + i&gamma;)]</span>
            <div class="drude-grid">
              <label>
                <span>&epsilon;<sub>b</sub></span>
                <input type="number" class="param-number" id="drude-epsb" value="1" step="0.1">
              </label>
              <label>
                <span>&omega;<sub>p</sub> (eV)</span>
                <input type="number" class="param-number" id="drude-wp" value="5" step="0.01" min="0.01">
              </label>
              <label>
                <span>&gamma; (eV)</span>
                <input type="number" class="param-number" id="drude-gamma" value="0.05" step="0.001" min="0">
              </label>
            </div>
          </div>

          <!-- Custom epsilon for shell/particle -->
          <div class="param hidden" id="eps-group">
            <div class="param-header">
              <label>&epsilon;<sub>r</sub></label>
              <input type="number" class="param-number" id="eps-num" value="10" step="0.5" min="1">
            </div>
            <input type="range" class="param-slider" id="eps-slider" aria-label="Relative permittivity" min="1" max="50" step="0.5" value="10">
            <div class="param-limits">
              <input type="number" class="param-limit" id="eps-min" value="1" step="0.5" min="0.1">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-limit" id="eps-max" value="50" step="0.5" min="0.1">
            </div>
          </div>

          <!-- Core section (core-shell only, collapsible) -->
          <details class="layer-details cs-only" id="core-section" style="display:none" open>
            <summary>Core</summary>
            <div class="layer-body">
              <div class="param" id="core-mat-group">
                <div class="param-header"><label>Material</label></div>
                <select id="core-material-select" class="param-select">
                  <option value="drude">Drude model</option>
                  <option value="au" selected>Gold (Au)</option>
                  <option value="ag">Silver (Ag)</option>
                  <option value="si">Silicon (Si)</option>
                  <option value="al">Aluminum (Al)</option>
                  <option value="tio2">TiO&sub2;</option>
                  <option value="custom">Custom dielectric</option>
                  <option value="file">Upload file&hellip;</option>
                  <option value="rii">Search database&hellip;</option>
                </select>
                <span class="material-ref" id="core-material-ref"></span>
                <div class="file-upload-row" id="core-file-upload-group" style="display:none">
                  <input type="file" id="core-file-upload" accept=".csv,.tsv,.txt,.dat" class="file-input">
                  <span class="file-name" id="core-file-name"></span>
                </div>
                <div class="rii-search" id="core-rii-search-group" style="display:none">
                  <input type="text" id="core-rii-search" class="param-number rii-input" placeholder="Search materials&hellip;">
                  <div class="rii-results" id="core-rii-results"></div>
                  <span class="material-ref" id="core-rii-status"></span>
                </div>
              </div>
              <div class="param drude-panel" id="core-drude-group" style="display:none">
                <span class="drude-formula">&epsilon; = &epsilon;<sub>b</sub> - &omega;<sub>p</sub><sup>2</sup> / [&omega;(&omega; + i&gamma;)]</span>
                <div class="drude-grid">
                  <label>
                    <span>&epsilon;<sub>b</sub></span>
                    <input type="number" class="param-number" id="core-drude-epsb" value="1" step="0.1">
                  </label>
                  <label>
                    <span>&omega;<sub>p</sub> (eV)</span>
                    <input type="number" class="param-number" id="core-drude-wp" value="5" step="0.01" min="0.01">
                  </label>
                  <label>
                    <span>&gamma; (eV)</span>
                    <input type="number" class="param-number" id="core-drude-gamma" value="0.05" step="0.001" min="0">
                  </label>
                </div>
              </div>
              <div class="param" id="core-eps-group" style="display:none">
                <div class="param-header">
                  <label>&epsilon;<sub>r</sub></label>
                  <input type="number" class="param-number" id="core-eps-num" value="10" step="0.5" min="1">
                </div>
                <input type="range" class="param-slider" id="core-eps-slider" aria-label="Core relative permittivity" min="1" max="50" step="0.5" value="10">
                <div class="param-limits">
                  <input type="number" class="param-limit" id="core-eps-min" value="1" step="0.5" min="0.1">
                  <span class="param-limit-dash">&mdash;</span>
                  <input type="number" class="param-limit" id="core-eps-max" value="50" step="0.5" min="0.1">
                </div>
              </div>
              <div class="param" id="core-r-group">
                <div class="param-header">
                  <label>Radius (nm)</label>
                  <input type="number" class="param-number" id="core-r-num" value="60" step="1" min="1">
                </div>
                <input type="range" class="param-slider" id="core-r-slider" aria-label="Core radius (nm)" min="5" max="400" step="1" value="60">
                <div class="param-limits">
                  <input type="number" class="param-limit" id="core-r-min" value="5" step="5" min="1">
                  <span class="param-limit-dash">&mdash;</span>
                  <input type="number" class="param-limit" id="core-r-max" value="400" step="5" min="1">
                </div>
              </div>
            </div>
          </details>

          <div class="param">
            <div class="param-header">
              <label id="radius-label">Radius (nm)</label>
              <input type="number" class="param-number" id="r-num" value="50" step="1" min="1">
            </div>
            <input type="range" class="param-slider" id="r-slider" aria-labelledby="radius-label" min="10" max="500" step="1" value="50">
            <div class="param-limits">
              <input type="number" class="param-limit" id="r-min" value="10" step="5" min="1">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-limit" id="r-max" value="500" step="5" min="1">
            </div>
          </div>

          <!-- Dynamic extra shells container -->
          <div id="extra-shells" class="cs-only" style="display:none"></div>

          <!-- Add shell button -->
          <div class="param cs-only" id="add-shell-wrap" style="display:none">
            <button id="add-shell-btn" class="chart-tool-btn" style="width:100%">+ Add shell</button>
            <span id="shell-limit-note" class="material-ref" style="display:none">Maximum 5 shells reached. Need more? <a href="mailto:info@nanophotonicslab.com">Contact us</a>.</span>
          </div>

          <div class="param">
            <div class="param-header">
              <label>n<sub>host</sub></label>
              <input type="number" class="param-number" id="nh-num" value="1.33" step="0.01" min="1">
            </div>
            <input type="range" class="param-slider" id="nh-slider" aria-label="Host refractive index" min="1.0" max="2.5" step="0.01" value="1.33">
            <div class="param-limits">
              <input type="number" class="param-limit" id="nh-min" value="1.0" step="0.01" min="1">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-limit" id="nh-max" value="2.5" step="0.01" min="1">
            </div>
            <div class="param-presets" id="nh-presets">
              <button class="preset-btn" data-val="1.00">Air</button>
              <button class="preset-btn active" data-val="1.33">Water</button>
              <button class="preset-btn" data-val="1.46">Oil</button>
              <button class="preset-btn" data-val="1.50">Glass</button>
            </div>
          </div>

          <div class="param" id="plane-range-group">
            <div class="param-header"><label>&lambda; range (nm)</label></div>
            <div class="param-range-row">
              <input type="number" class="param-number param-number--sm" id="lam-min" value="300" step="10" min="100">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-number param-number--sm" id="lam-max" value="900" step="10" min="100">
            </div>
          </div>

          <div id="thermal-params" style="display:none">
            <div class="param">
              <div class="param-header"><label>Environment</label></div>
              <div class="param-dual-row">
                <label><span>T<sub>0</sub> (&deg;C)</span><input type="number" class="param-number" id="thermal-t0" value="25" step="1"></label>
                <label><span>host &kappa; (W/mK)</span><input type="number" class="param-number" id="thermal-kappa-med" value="0.6" step="0.05" min="0.01"></label>
              </div>
            </div>
            <div class="param">
              <div class="param-header"><label>Layer thermal properties</label></div>
              <div class="thermal-layers" id="thermal-layers"></div>
            </div>
          </div>

          <!-- ============ Electron-beam source controls (after geometry + material) ============ -->
          <div class="param electron-only" id="electron-impact-group" style="display:none">
            <div class="param-header">
              <label>Impact parameter b (nm)</label>
              <input type="number" class="param-number" id="electron-b-num" value="60" step="5" min="0.1">
            </div>
            <div class="slider-marker-wrap">
              <input type="range" class="param-slider" id="electron-b-slider" aria-label="Impact parameter b (nm)" min="1" max="250" step="1" value="60">
              <span class="radius-threshold-marker" id="electron-radius-marker" title="Particle radius threshold"></span>
            </div>
            <div class="param-limits">
              <input type="number" class="param-limit" id="electron-b-min" value="1" step="1" min="0.1">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-limit" id="electron-b-max" value="250" step="5" min="1">
            </div>
          </div>

          <div class="param electron-only" id="electron-beta-group" style="display:none">
            <div class="param-header">
              <label>Electron energy</label>
            </div>
            <div class="param-dual-row">
              <label>
                <span>&beta; = v/c</span>
                <input type="number" class="param-number" id="electron-beta-num" value="0.33" step="0.01" min="0.02" max="0.95">
              </label>
              <label>
                <span>K (keV)</span>
                <input type="number" class="param-number" id="electron-kev-num" value="30.00" step="0.1" min="0.001">
              </label>
            </div>
            <input type="range" class="param-slider" id="electron-beta-slider" aria-label="Electron speed β = v/c" min="0.02" max="0.95" step="0.01" value="0.33">
            <div class="param-limits">
              <input type="number" class="param-limit" id="electron-beta-min" value="0.02" step="0.01" min="0.01">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-limit" id="electron-beta-max" value="0.95" step="0.01" min="0.02">
            </div>
          </div>

          <div class="param electron-only" id="electron-energy-group" style="display:none">
            <div class="param-header"><label>Energy loss range (eV)</label></div>
            <div class="param-range-row">
              <input type="number" class="param-number param-number--sm" id="electron-emin" value="1.5" step="0.1" min="0.1">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-number param-number--sm" id="electron-emax" value="5.5" step="0.1" min="0.2">
            </div>
          </div>

          <details class="layer-details electron-only" id="electron-numerics" style="display:none">
            <summary>Electron numerics</summary>
            <div class="layer-body">
              <div class="param">
                <div class="param-header">
                  <label>l<sub>max</sub></label>
                  <input type="number" class="param-number" id="electron-lmax-num" value="6" step="1" min="1" max="14">
                </div>
                <input type="range" class="param-slider" id="electron-lmax-slider" aria-label="Multipole cutoff lmax" min="1" max="14" step="1" value="6">
                <div class="param-limits">
                  <input type="number" class="param-limit" id="electron-lmax-min" value="1" step="1" min="1">
                  <span class="param-limit-dash">&mdash;</span>
                  <input type="number" class="param-limit" id="electron-lmax-max" value="14" step="1" min="1">
                </div>
              </div>
              <div class="param">
                <div class="param-header">
                  <label>q<sub>c</sub> (nm<sup>-1</sup>)</label>
                  <input type="number" class="param-number" id="electron-qc-num" value="0.71" step="0.01" min="0.01">
                </div>
                <input type="range" class="param-slider" id="electron-qc-slider" aria-label="Momentum cutoff qc (nm⁻¹)" min="0.05" max="20" step="0.01" value="0.71">
                <div class="param-limits">
                  <input type="number" class="param-limit" id="electron-qc-min" value="0.05" step="0.01" min="0.001">
                  <span class="param-limit-dash">&mdash;</span>
                  <input type="number" class="param-limit" id="electron-qc-max" value="20" step="0.1" min="0.01">
                </div>
              </div>
              <div class="param">
                <div class="param-header">
                  <label>z quadrature</label>
                  <input type="number" class="param-number" id="electron-nz-num" value="64" step="8" min="8" max="160">
                </div>
                <input type="range" class="param-slider" id="electron-nz-slider" aria-label="z quadrature points" min="8" max="160" step="8" value="64">
                <div class="param-limits">
                  <input type="number" class="param-limit" id="electron-nz-min" value="8" step="8" min="8">
                  <span class="param-limit-dash">&mdash;</span>
                  <input type="number" class="param-limit" id="electron-nz-max" value="160" step="8" min="8">
                </div>
              </div>
            </div>
          </details>

          <!-- ============ Dipole-emitter controls ============ -->
          <div class="param dipole-only" id="dipole-lambda-group" style="display:none">
            <div class="param-header">
              <label>Emission wavelength (nm)</label>
              <input type="number" class="param-number" id="dipole-lambda-num" value="413.3" step="1" min="100">
            </div>
            <input type="range" class="param-slider" id="dipole-lambda-slider" aria-label="Emission wavelength (nm)" min="300" max="900" step="0.1" value="413.3">
            <div class="param-limits">
              <input type="number" class="param-limit" id="dipole-lambda-min" value="300" step="10" min="100">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-limit" id="dipole-lambda-max" value="900" step="10" min="120">
            </div>
            <div class="dipole-ev-echo" id="dipole-ev-echo"></div>
          </div>

          <!-- Range / axis controls -->
          <div class="param dipole-only" id="dipole-range-group" style="display:none">
            <div class="param-header">
              <label>Distance range (from
                <select id="dipole-ref-sel" class="dipole-ref-sel" aria-label="Distance reference point">
                  <option value="centre">centre</option>
                  <option value="surface">surface</option>
                </select>)</label>
              <div class="plot-tabs plot-tabs--sm dipole-unit-toggle" id="dipole-xunit-tabs" role="radiogroup" aria-label="Distance unit">
                <button class="plot-tab active" data-dxunit="norm" role="radio" aria-checked="true">d/a</button>
                <button class="plot-tab" data-dxunit="abs" role="radio" aria-checked="false">nm</button>
              </div>
            </div>
            <div class="param-range-row">
              <input type="number" class="param-number param-number--sm" id="dipole-dmin" value="1.02" step="0.05" min="0">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-number param-number--sm" id="dipole-dmax" value="9" step="0.1" min="0.01">
            </div>
          </div>

          <div class="param dipole-only" id="dipole-yunit-group" style="display:none">
            <div class="param-header"><label>Rate axis (y)</label></div>
            <div class="plot-tabs" id="dipole-yunit-tabs" role="radiogroup">
              <button class="plot-tab active" data-dyunit="norm" role="radio" aria-checked="true">&gamma;/&gamma;<sub>0</sub></button>
              <button class="plot-tab" data-dyunit="inv_s" role="radio" aria-checked="false">1/s</button>
              <button class="plot-tab" data-dyunit="inv_fs" role="radio" aria-checked="false">1/fs</button>
            </div>
            <div class="param-range-row dipole-yrange-row">
              <input type="number" class="param-number param-number--sm" id="dipole-ymin" placeholder="auto" step="any" title="y-axis minimum (blank = auto)">
              <span class="param-limit-dash">&mdash;</span>
              <input type="number" class="param-number param-number--sm" id="dipole-ymax" placeholder="auto" step="any" title="y-axis maximum (blank = auto)">
            </div>
          </div>

          <div class="param dipole-only" id="dipole-tau0-group" style="display:none">
            <div class="param-header">
              <label title="Free-space radiative lifetime of the emitter; sets the absolute scale γ₀ = 1/τ₀">Free-space lifetime &tau;<sub>0</sub> (ns)</label>
              <input type="number" class="param-number" id="dipole-tau0-num" value="1" step="0.1" min="0.001">
            </div>
            <div class="dipole-ev-echo" id="dipole-gamma0-echo"></div>
          </div>

          <div class="param dipole-only" id="dipole-ref-group" style="display:none">
            <div class="dipole-ref" id="dipole-ref"></div>
          </div>

          <details class="layer-details dipole-only" id="dipole-numerics" style="display:none">
            <summary>Numerics</summary>
            <div class="param">
              <div class="param-header">
                <label>Multipole cutoff &ell;<sub>max</sub></label>
                <input type="number" class="param-number" id="dipole-lmax-num" value="20" step="1" min="1" max="60">
              </div>
              <input type="range" class="param-slider" id="dipole-lmax-slider" aria-label="Multipole cutoff ℓmax" min="1" max="60" step="1" value="20">
              <div class="param-limits">
                <input type="number" class="param-limit" id="dipole-lmax-min" value="1" step="1" min="1">
                <span class="param-limit-dash">&mdash;</span>
                <input type="number" class="param-limit" id="dipole-lmax-max" value="60" step="1" min="2">
              </div>
            </div>
            <div class="param" id="dipole-f-group">
              <div class="param-header">
                <label title="γ_sp/γ₀ scale for a dissipative sphere (Kim Eq. 28); ignored for a lossless sphere">f(&omega;) &mdash; dissipative scale</label>
                <input type="number" class="param-number" id="dipole-f-num" value="6.88e-8" step="1e-8" min="0">
              </div>
            </div>
          </details>

          <button id="reset-btn" class="chart-tool-btn reset-btn" title="Reset all parameters to defaults">Reset defaults</button>

          <button type="button" class="config-check" id="config-check" aria-haspopup="dialog" aria-controls="structure-dialog" title="Open structure drawing"></button>

          <p class="theory-note" id="theory-note">
            <strong>Mie theory</strong> gives exact solutions for light scattering by
            spherical particles. C<sub>ext</sub>&nbsp;=&nbsp;C<sub>sca</sub>&nbsp;+&nbsp;C<sub>abs</sub>.
            Metals have complex&nbsp;&epsilon;, giving C<sub>abs</sub>&nbsp;&gt;&nbsp;0.
          </p>
          </div>
          </ParamsDrawer>

        </div>

        <div class="widget-column widget-column--results">
          <div class="chart-panel card">
          <div class="chart-toolbar">
            <div class="plot-tabs plot-tabs--sm" id="view-tabs" role="radiogroup">
